---
import Base from '../layouts/Base.astro';
---

<Base title="A-U.SUPPLY — Audio Units Division">
  <aside class="image-strip" id="image-strip" aria-hidden="true">
    <div class="image-strip__inner" id="image-strip-inner"></div>
  </aside>
  <main class="back-cover">
    <div class="back-cover__content">
      <div class="back-cover__image">
        <a href="/catalog"
          ><img
            src="/assets/aedas-800.jpg"
            alt="An Electronically Deduced Aural Syllomis"
          /></a
        >
      </div>

      <div class="back-cover__brand">
        <h1 class="back-cover__title">A-U.SUPPLY</h1>
        <p class="back-cover__subtitle">Audio Units Division</p>
      </div>

      <div class="back-cover__contact">
        ausupply000@gmail.com<br />
        https://a-u.supply
      </div>

      <p class="back-cover__quote">
        "Your only choice will be between a goat's ass and the face of god."
      </p>

      <div class="back-cover__doc">
        Document No: AU-REF-2026-001 &nbsp;|&nbsp; Revision 01 &nbsp;|&nbsp;
        2026-03-23
      </div>
    </div>
  </main>
</Base>

<style>
  /* Image strip */
  .image-strip {
    position: fixed;
    left: 0;
    top: 0;
    width: 72px;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.5s ease;
    z-index: 0;
  }

  .image-strip.visible {
    opacity: 1;
  }

  .image-strip__inner {
    display: flex;
    flex-direction: column;
    will-change: transform;
  }

  .image-strip__inner img {
    width: 72px;
    height: auto;
    display: block;
    filter: grayscale(100%) brightness(0.45);
  }

  @keyframes strip-scroll {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }

  @media (max-width: 640px) {
    .image-strip {
      display: none;
    }
  }

  /* Back cover */
  .back-cover {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: calc(100vh - 7rem);
    padding: var(--space-md) var(--space-md);
  }

  .back-cover__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .back-cover__image img {
    max-height: min(35vh, 280px);
    width: auto;
    border: 1px solid var(--color-border);
  }

  .back-cover__title {
    font-size: var(--text-xl);
    font-weight: bold;
    letter-spacing: 2pt;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
    display: inline-block;
    transform: rotateX(180deg);
    transition: transform 0.5s ease;
    cursor: default;
  }

  .back-cover__brand {
    perspective: 400px;
  }

  .back-cover__title:hover {
    transform: rotateX(0deg);
  }

  .back-cover__subtitle {
    font-size: var(--text-base);
    letter-spacing: 1pt;
    color: var(--color-muted);
  }

  .back-cover__contact {
    font-size: var(--text-sm);
    line-height: 2;
    color: var(--color-muted);
  }

  .back-cover__quote {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-muted);
  }

  .back-cover__doc {
    font-size: 0.5rem;
    color: var(--color-border);
  }
</style>

<script>
  async function initImageStrip() {
    const strip = document.getElementById('image-strip');
    const inner = document.getElementById('image-strip-inner');
    if (!strip || !inner) return;

    // Clear any previous run (e.g. navigating back via ViewTransitions)
    inner.innerHTML = '';
    strip.classList.remove('visible');
    inner.style.animation = 'none';

    let data;
    try {
      const res = await fetch(
        '/api/public/outputs?media_type=image&output_index=outputs&limit=50',
      );
      if (!res.ok) return;
      data = await res.json();
    } catch {
      return;
    }

    const items = data.items;
    if (!items || items.length === 0) return;

    const makeImg = (item: { thumbnail_url: string }) => {
      const img = document.createElement('img');
      img.src = item.thumbnail_url;
      img.alt = '';
      img.loading = 'lazy';
      return img;
    };

    // Two copies for seamless loop
    items.forEach((item: { thumbnail_url: string }) =>
      inner.appendChild(makeImg(item)),
    );
    items.forEach((item: { thumbnail_url: string }) =>
      inner.appendChild(makeImg(item)),
    );

    // Duration scales with number of images so speed stays consistent (~3s per image)
    const duration = items.length * 3;
    inner.style.animation = `strip-scroll ${duration}s linear infinite`;

    strip.classList.add('visible');
  }

  document.addEventListener('astro:page-load', initImageStrip);
</script>
