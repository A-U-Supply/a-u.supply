---
import Admin from '../../layouts/Admin.astro';
---

<Admin title="Inbox" current="notifications">
  <div class="page-header">
    <h1>Inbox</h1>
    <p class="page-header__subtitle">
      Fold replies, fallen items, midden, acclaim. All in one place.
    </p>
  </div>

  <div class="status-tabs" role="tablist" id="notif-tabs">
    <button class="tab active" role="tab" data-tab="inbox" aria-selected="true"
      >Inbox</button
    >
    <button class="tab" role="tab" data-tab="sources" aria-selected="false"
      >Sources</button
    >
  </div>

  <!-- ───────── Inbox tab ───────── -->
  <section
    class="tab-panel"
    id="tab-inbox"
    role="tabpanel"
    aria-labelledby="tab-inbox-trigger"
  >
    <div class="inbox-toolbar">
      <div class="inbox-toolbar__count" id="inbox-count" hidden>
        <span id="inbox-count-num">0</span> unread
      </div>
      <button class="action-btn" id="mark-all-read" type="button" disabled
        >Mark All Read</button
      >
    </div>

    <div id="inbox-loading" class="muted-line">
      <span class="loading-dots">Drawing the omens</span>
    </div>
    <div id="inbox-empty" class="empty-state" hidden>
      <div class="empty-state__icon">&#10003;</div>
      Nothing new. The omens are quiet.
    </div>
    <table class="notif-table" id="notif-list" hidden>
      <thead>
        <tr>
          <th class="notif-col-type">Type</th>
          <th class="notif-col-user">User</th>
          <th class="notif-col-preview">Preview</th>
          <th class="notif-col-community">Community</th>
          <th class="notif-col-actions">Act</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </section>

  <!-- ───────── Sources tab ───────── -->
  <section
    class="tab-panel"
    id="tab-sources"
    role="tabpanel"
    aria-labelledby="tab-sources-trigger"
    hidden
  >
    <div id="fold-unconfigured" class="empty-state" hidden>
      <div class="empty-state__icon">&#9888;</div>
      Fold linkage isn't configured on this server yet. Internal sources (fallen,
      midden, acclaim) still surface in your Inbox; ask whoever handles ops to run
      the
      <code>dokku postgres:link &mdash;alias FOLD_DATABASE</code> step.
    </div>

    <div class="sources-section">
      <h2 class="sources-section__title">Muted sources</h2>
      <p class="sources-section__hint">
        Notifications from muted sources won't appear in your Inbox.
      </p>
      <div class="mute-list" id="mute-list">
        <span class="loading-dots">Loading sources</span>
      </div>
    </div>

    <div class="sources-section">
      <h2 class="sources-section__title">Communities</h2>
      <p class="sources-section__hint">
        All fold communities — mute any you don't want notifications from.
      </p>
      <ul class="sub-list" id="community-list" hidden></ul>
      <div class="sub-empty" id="community-empty">
        No communities on Fold yet.
      </div>
    </div>

    <div class="sources-section">
      <h2 class="sources-section__title">Watched threads</h2>
      <p class="sources-section__hint">
        Get notified on every new comment in these specific threads.
      </p>
      <ul class="sub-list" id="thread-list" hidden></ul>
      <div class="sub-empty" id="thread-empty">
        No thread subscriptions yet.
      </div>

      <details class="picker" id="thread-picker">
        <summary class="picker__summary">Find threads</summary>
        <div class="picker__search">
          <input
            type="search"
            id="thread-search"
            class="filter-input"
            placeholder="search post titles…"
            autocomplete="off"
          />
        </div>
        <ul class="picker__results" id="thread-picker-list"></ul>
      </details>
    </div>
  </section>
</Admin>

<style>
  .page-header__subtitle {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-style: italic;
    margin-top: calc(var(--space-xs) * -1);
    margin-bottom: var(--space-md);
  }

  .muted-line {
    color: var(--color-muted);
    padding: var(--space-md) 0;
  }

  .tab-panel[hidden] {
    display: none;
  }

  /* ───── Inbox tab ───── */
  .inbox-toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: var(--space-sm) 0 var(--space-md);
  }
  .inbox-toolbar__count {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .inbox-toolbar__count[hidden] {
    display: none;
  }
  .inbox-toolbar #mark-all-read {
    margin-left: auto;
  }

  .notif-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    border: 2px solid var(--color-fg);
    table-layout: fixed;
  }
  .notif-table[hidden] {
    display: none;
  }
  .notif-table thead {
    border-bottom: 2px solid var(--color-fg);
    background: var(--color-surface);
  }
  .notif-table th {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
    color: var(--color-muted);
    padding: var(--space-sm);
    text-align: left;
    white-space: nowrap;
  }
  .notif-table th:last-child {
    border-right: none;
  }
  .notif-table td {
    padding: var(--space-sm);
    vertical-align: middle;
  }
  .notif-col-type {
    width: 10%;
  }
  .notif-col-user {
    width: 12%;
  }
  .notif-col-preview {
    width: 48%;
  }
  .notif-col-community {
    width: 15%;
  }
  .notif-col-actions {
    width: 15%;
  }

  :global(.notif-table th) {
    border-right: 2px solid var(--color-fg);
  }
  :global(.notif-table td) {
    border-right: 2px solid var(--color-fg);
  }
  :global(.notif-table td:last-child) {
    border-right: none;
  }
  :global(.notif-table tbody tr) {
    border-bottom: 2px solid var(--color-fg);
  }
  :global(.notif-table tbody tr:last-child) {
    border-bottom: none;
  }
  :global(.notif-table tbody tr:hover td) {
    background: var(--color-surface);
  }

  .notif-table__source {
    display: inline-block;
    padding: 2px 8px;
    border: 2px solid var(--color-fg);
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.8pt;
    white-space: nowrap;
    font-family: var(--font-mono);
  }
  .notif-table__source[data-source^='fold_'] {
    color: var(--color-bg);
    background: var(--color-fg);
  }
  .notif-table__actor {
    font-weight: 600;
    font-size: var(--text-sm);
    white-space: nowrap;
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: inline-block;
    vertical-align: middle;
  }
  .notif-table__actor a {
    color: var(--color-fg);
    text-decoration: none;
  }
  .notif-table__actor a:hover {
    color: var(--color-accent);
  }
  .notif-table__preview-link {
    color: inherit;
    text-decoration: none;
  }
  .notif-table__preview-link:hover {
    color: var(--color-accent);
  }
  .notif-table__preview-link:hover .notif-table__preview {
    color: var(--color-accent);
  }
  .notif-table__preview {
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.4;
    word-break: break-word;
    max-width: 300px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .notif-table__time {
    display: none;
  }
  .notif-table__community {
    font-size: 0.6rem;
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .notif-table__community a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .notif-table__community a:hover {
    color: var(--color-fg);
  }

  @media (max-width: 640px) {
    .notif-table {
      border: none;
    }
    .notif-table thead {
      background: none;
    }
    .notif-col-preview,
    .notif-col-community {
      display: none;
    }
    .notif-table td:nth-child(3),
    .notif-table td:nth-child(4) {
      display: none;
    }
    .notif-table td {
      border-right: none;
      padding: var(--space-xs) var(--space-sm);
    }
    .notif-table__actor {
      max-width: 80px;
    }
  }

  /* ───── Sources tab ───── */
  .sources-section {
    margin-bottom: var(--space-lg);
  }
  .sources-section__title {
    font-size: var(--text-base);
    text-transform: uppercase;
    letter-spacing: 1pt;
    margin: var(--space-md) 0 var(--space-xs);
    padding-bottom: var(--space-xs);
    border-bottom: 1px dotted var(--color-border);
  }
  .sources-section__hint {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-style: italic;
    margin-bottom: var(--space-sm);
  }
  .sources-section__actions {
    margin-bottom: var(--space-sm);
  }
  .sub-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .sub-list[hidden] {
    display: none;
  }
  .sub-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-fg);
    background: var(--color-bg);
  }
  .sub-row__name {
    flex: 1;
    min-width: 0;
    font-size: var(--text-sm);
    word-break: break-word;
  }
  .sub-empty {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-style: italic;
    margin-bottom: var(--space-sm);
  }
  .sub-empty[hidden] {
    display: none;
  }

  .mute-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mute-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-fg);
    background: var(--color-bg);
  }
  .mute-row__info {
    flex: 1;
    min-width: 0;
  }
  .mute-row__name {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .mute-row__desc {
    display: block;
    font-size: 0.7rem;
    color: var(--color-muted);
    font-style: italic;
  }
  .mute-toggle.muted {
    background: var(--color-fg);
    color: var(--color-bg);
  }

  .picker {
    border: 2px solid var(--color-fg);
    background: var(--color-bg);
    margin-top: var(--space-sm);
  }
  .picker__summary {
    cursor: pointer;
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    border-bottom: 1px solid var(--color-fg);
  }
  .picker[open] .picker__summary {
    background: var(--color-surface);
  }
  .picker__search {
    padding: var(--space-xs) var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }
  .picker__search .filter-input {
    width: 100%;
  }
  .picker__results {
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 50vh;
    overflow-y: auto;
  }
  .picker__row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }
  .picker__row:last-child {
    border-bottom: none;
  }
  .picker__row__label {
    flex: 1;
    min-width: 0;
    word-break: break-word;
  }
  .picker__row__sub {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  #fold-unconfigured code {
    background: var(--color-surface);
    padding: 1px 4px;
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
</style>

<script>
  document.addEventListener('astro:page-load', async () => {
    // Only bind if we're on the notifications page (Admin layout reuses
    // this script across pages via ViewTransitions).
    if (!document.getElementById('notif-tabs')) return;

    const user = await (window as any).__authReady;
    if (!user) return;

    // ───────── Sources lazy state (must precede showTab reference) ─────────
    let sourcesLoaded = false;

    // ───────── Tabs ─────────
    const tabs =
      document.querySelectorAll<HTMLButtonElement>('#notif-tabs .tab');
    const panels: Record<string, HTMLElement> = {
      inbox: document.getElementById('tab-inbox')!,
      sources: document.getElementById('tab-sources')!,
    };
    function showTab(name: string) {
      tabs.forEach((t) => {
        const active = t.dataset.tab === name;
        t.classList.toggle('active', active);
        t.setAttribute('aria-selected', String(active));
      });
      Object.entries(panels).forEach(([key, el]) => {
        if (key === name) el.removeAttribute('hidden');
        else el.setAttribute('hidden', '');
      });
      // Lazy-load sources data on first open.
      if (name === 'sources' && !sourcesLoaded) {
        loadSources();
        sourcesLoaded = true;
      }
      // Persist tab choice in the hash so reload + share-link works.
      history.replaceState(null, '', `#${name}`);
    }
    tabs.forEach((t) =>
      t.addEventListener('click', () => showTab(t.dataset.tab!)),
    );
    if (location.hash === '#sources') showTab('sources');

    // ───────── Inbox ─────────
    const inboxLoading = document.getElementById('inbox-loading')!;
    const inboxEmpty = document.getElementById('inbox-empty')!;
    const listEl = document.getElementById('notif-list') as HTMLTableElement;
    const countWrap = document.getElementById('inbox-count')!;
    const countNum = document.getElementById('inbox-count-num')!;
    const markAllBtn = document.getElementById(
      'mark-all-read',
    ) as HTMLButtonElement;

    type Notif = {
      id: number;
      source: string;
      source_ref: string;
      title: string;
      snippet: string | null;
      url: string;
      actor: string | null;
      community: string | null;
      created_at: string | null;
      dismissed_at: string | null;
    };

    let allNotifs: Notif[] = [];

    function escapeHtml(s: string): string {
      return (s ?? '').replace(/[&<>"']/g, (c) => {
        return (
          (
            {
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            } as Record<string, string>
          )[c] || c
        );
      });
    }

    function formatTimestamp(iso: string | null): string {
      if (!iso) return '';
      const d = new Date(iso);
      return d.toLocaleString();
    }

    function renderInbox() {
      const unread = allNotifs.filter((n) => !n.dismissed_at);
      if (unread.length === 0) {
        listEl.hidden = true;
        countWrap.hidden = true;
        markAllBtn.disabled = true;
        inboxEmpty.removeAttribute('hidden');
        return;
      }
      inboxEmpty.setAttribute('hidden', '');
      countWrap.hidden = false;
      countNum.textContent = String(unread.length);
      markAllBtn.disabled = false;

      const tbody = listEl.querySelector('tbody')!;
      tbody.innerHTML = unread
        .map((n) => {
          const url = n.url ? escapeHtml(n.url) : '#';
          const isExternal = url.startsWith('http');
          const linkAttrs = isExternal
            ? 'target="_blank" rel="noopener noreferrer"'
            : '';
          const isFold = n.source.startsWith('fold_');
          const sourceLabel = isFold
            ? 'THE FOLD'
            : escapeHtml(n.source.replace(/_/g, ' '));
          const actor = n.actor ? escapeHtml(n.actor) : '—';
          const actorCell =
            n.actor && (isFold || n.source === 'fold_inbox')
              ? `<a href="https://fold.a-u.supply/u/${escapeHtml(n.actor)}" target="_blank" rel="noopener noreferrer">${actor}</a>`
              : actor;
          const preview = n.snippet ? escapeHtml(n.snippet) : '';
          const community = n.community
            ? `<a href="https://fold.a-u.supply/c/${escapeHtml(n.community)}" target="_blank" rel="noopener noreferrer">/c/${escapeHtml(n.community)}</a>`
            : '—';
          const time = escapeHtml(formatTimestamp(n.created_at));
          return `
            <tr data-id="${n.id}">
              <td><span class="notif-table__source" data-source="${escapeHtml(n.source)}">${sourceLabel}</span></td>
              <td><span class="notif-table__actor" title="${actor}">${actorCell}</span></td>
              <td><a href="${url}" ${linkAttrs} class="notif-table__preview-link"><span class="notif-table__preview">${preview}</span></a></td>
              <td><span class="notif-table__community">${community}</span></td>
              <td><button class="action-btn" data-dismiss="${n.id}">Dismiss</button></td>
            </tr>`;
        })
        .join('');
      listEl.hidden = false;
    }

    async function loadInbox() {
      inboxLoading.removeAttribute('hidden');
      try {
        const res = await fetch('/api/admin/notifications', {
          credentials: 'include',
        });
        if (!res.ok) throw new Error('Failed to load notifications');
        const data = await res.json();
        allNotifs = data.items || [];
      } catch (err) {
        (window as any).toast.error('Failed to load notifications');
        allNotifs = [];
      }
      inboxLoading.setAttribute('hidden', '');
      renderInbox();
      // Nudge the sidebar badge in case materialization picked up new
      // events.
      (window as any).__inbox?.refresh?.();
    }

    listEl.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest(
        '[data-dismiss]',
      ) as HTMLButtonElement | null;
      if (!btn) return;
      const id = Number(btn.dataset.dismiss);
      btn.disabled = true;
      try {
        const res = await fetch(`/api/admin/notifications/${id}/dismiss`, {
          method: 'POST',
          credentials: 'include',
        });
        if (!res.ok) throw new Error('dismiss failed');
        const row = allNotifs.find((n) => n.id === id);
        if (row) row.dismissed_at = new Date().toISOString();
        renderInbox();
        (window as any).__inbox?.refresh?.();
      } catch {
        btn.disabled = false;
        (window as any).toast.error('Dismiss failed');
      }
    });

    markAllBtn.addEventListener('click', async () => {
      if (markAllBtn.disabled) return;
      const confirmed = await (window as any).confirmDialog(
        'Mark every notification as read?',
        'Mark All Read',
      );
      if (!confirmed) return;
      markAllBtn.disabled = true;
      try {
        const res = await fetch('/api/admin/notifications/dismiss-all', {
          method: 'POST',
          credentials: 'include',
        });
        if (!res.ok) throw new Error('dismiss-all failed');
        const now = new Date().toISOString();
        allNotifs.forEach((n) => {
          if (!n.dismissed_at) n.dismissed_at = now;
        });
        renderInbox();
        (window as any).__inbox?.refresh?.();
      } catch {
        markAllBtn.disabled = false;
        (window as any).toast.error('Mark-all-read failed');
      }
    });

    loadInbox();

    // ───────── Mute sources ─────────
    const muteList = document.getElementById('mute-list')!;
    const ALL_SOURCES = [
      {
        key: 'fold_inbox',
        label: 'Fold Inbox',
        desc: 'replies and @-mentions',
      },
      {
        key: 'fold_community',
        label: 'Fold Community',
        desc: 'posts and comments in subscribed communities',
      },
      {
        key: 'fold_thread',
        label: 'Fold Thread',
        desc: 'comments on watched threads',
      },
      { key: 'acclaim', label: 'Acclaim', desc: 'votes on your uploads' },
      { key: 'fallen', label: 'Fallen', desc: 'extraction failures' },
      { key: 'midden', label: 'Midden', desc: 'discarded items' },
    ];

    let mutedSet: Set<string> = new Set();

    async function loadMuted() {
      try {
        const res = await fetch('/api/admin/notifications/muted', {
          credentials: 'include',
        });
        if (!res.ok) throw new Error('muted');
        const data = await res.json();
        mutedSet = new Set(data.muted || []);
      } catch {
        mutedSet = new Set();
      }
      renderMuted();
    }

    async function toggleMute(source: string) {
      const newMuted = mutedSet.has(source)
        ? [...mutedSet].filter((s) => s !== source)
        : [...mutedSet, source];
      try {
        const res = await fetch('/api/admin/notifications/muted', {
          method: 'PUT',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ muted: newMuted }),
        });
        if (!res.ok) throw new Error('save');
        mutedSet = new Set(newMuted);
        renderMuted();
      } catch {
        (window as any).toast.error('Failed to update mute setting');
      }
    }

    function renderMuted() {
      muteList.innerHTML = ALL_SOURCES.map((s) => {
        const muted = mutedSet.has(s.key);
        return `
          <div class="mute-row">
            <div class="mute-row__info">
              <span class="mute-row__name">${escapeHtml(s.label)}</span>
              <span class="mute-row__desc">${escapeHtml(s.desc)}</span>
            </div>
            <button class="action-btn mute-toggle ${muted ? 'muted' : ''}" data-mute="${s.key}">
              ${muted ? 'Unmute' : 'Mute'}
            </button>
          </div>`;
      }).join('');
    }

    muteList.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest(
        '[data-mute]',
      ) as HTMLButtonElement | null;
      if (btn) {
        btn.disabled = true;
        await toggleMute(btn.dataset.mute!);
        btn.disabled = false;
      }
    });

    loadMuted();

    // ───────── Sources ─────────
    const foldUnconfigured = document.getElementById('fold-unconfigured')!;
    const communityList = document.getElementById(
      'community-list',
    ) as HTMLUListElement;
    const communityEmpty = document.getElementById('community-empty')!;
    const threadList = document.getElementById(
      'thread-list',
    ) as HTMLUListElement;
    const threadEmpty = document.getElementById('thread-empty')!;
    const threadSearch = document.getElementById(
      'thread-search',
    ) as HTMLInputElement;
    const threadPickerList = document.getElementById(
      'thread-picker-list',
    ) as HTMLUListElement;

    type CommunitySub = {
      lemmy_community_id: number;
      name: string;
      muted: boolean;
      created_at: string | null;
    };
    type ThreadSub = {
      lemmy_post_id: number;
      title: string;
      created_at: string | null;
    };
    type SubsResponse = {
      communities: CommunitySub[];
      threads: ThreadSub[];
      fold_configured: boolean;
    };

    let mySubs: SubsResponse = {
      communities: [],
      threads: [],
      fold_configured: false,
    };

    function renderSubs() {
      if (mySubs.communities.length === 0) {
        communityList.hidden = true;
        communityEmpty.removeAttribute('hidden');
      } else {
        communityEmpty.setAttribute('hidden', '');
        communityList.hidden = false;
        communityList.innerHTML = mySubs.communities
          .map(
            (c) => `
            <li class="sub-row" data-cid="${c.lemmy_community_id}">
              <span class="sub-row__name">/c/${escapeHtml(c.name)}</span>
              <button class="action-btn ${c.muted ? 'muted' : ''}" data-mute-community="${c.lemmy_community_id}">
                ${c.muted ? 'Unmute' : 'Mute'}
              </button>
            </li>`,
          )
          .join('');
      }
      // Threads
      if (mySubs.threads.length === 0) {
        threadList.hidden = true;
        threadEmpty.removeAttribute('hidden');
      } else {
        threadEmpty.setAttribute('hidden', '');
        threadList.hidden = false;
        threadList.innerHTML = mySubs.threads
          .map(
            (t) => `
            <li class="sub-row" data-pid="${t.lemmy_post_id}">
              <span class="sub-row__name">${escapeHtml(t.title)}</span>
              <button class="action-btn" data-remove-thread="${t.lemmy_post_id}">Remove</button>
            </li>`,
          )
          .join('');
      }
    }

    async function loadSources() {
      try {
        const res = await fetch('/api/admin/fold/subscriptions', {
          credentials: 'include',
        });
        if (!res.ok) throw new Error('subs');
        mySubs = await res.json();
      } catch {
        mySubs = { communities: [], threads: [], fold_configured: false };
      }
      if (!mySubs.fold_configured) {
        foldUnconfigured.removeAttribute('hidden');
      }
      renderSubs();
      if (mySubs.fold_configured) {
        runThreadSearch('');
      } else {
        threadPickerList.innerHTML = `<li class="muted-line">Fold DB unavailable.</li>`;
      }
    }

    let threadSearchTimer: number | undefined;
    threadSearch.addEventListener('input', () => {
      window.clearTimeout(threadSearchTimer);
      threadSearchTimer = window.setTimeout(
        () => runThreadSearch(threadSearch.value),
        200,
      );
    });

    async function runThreadSearch(q: string) {
      threadPickerList.innerHTML = `<li class="muted-line"><span class="loading-dots">Searching</span></li>`;
      try {
        const res = await fetch(
          `/api/admin/fold/threads?q=${encodeURIComponent(q)}`,
          { credentials: 'include' },
        );
        if (!res.ok) throw new Error('search');
        const data = await res.json();
        const subscribed = new Set(mySubs.threads.map((t) => t.lemmy_post_id));
        const rows = (data.posts || []) as {
          id: number;
          title: string;
          community_name: string;
          published: string | null;
        }[];
        if (rows.length === 0) {
          threadPickerList.innerHTML = `<li class="muted-line">No posts match.</li>`;
          return;
        }
        threadPickerList.innerHTML = rows
          .map((p) => {
            const isSub = subscribed.has(p.id);
            return `
              <li class="picker__row">
                <span class="picker__row__label">
                  ${escapeHtml(p.title)}
                  <span class="picker__row__sub">in /c/${escapeHtml(p.community_name)}</span>
                </span>
                <button class="action-btn" data-add-thread="${p.id}" ${isSub ? 'disabled' : ''}>
                  ${isSub ? 'Watching' : 'Watch'}
                </button>
              </li>`;
          })
          .join('');
      } catch {
        threadPickerList.innerHTML = `<li class="muted-line">Search failed.</li>`;
      }
    }

    // Subscription mutations — event-delegate from the section root.
    panels.sources.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;

      const muteC = target.closest(
        '[data-mute-community]',
      ) as HTMLButtonElement | null;
      if (muteC) {
        muteC.disabled = true;
        const cid = Number(muteC.dataset.muteCommunity);
        const c = mySubs.communities.find((c) => c.lemmy_community_id === cid);
        if (!c) {
          muteC.disabled = false;
          return;
        }
        const newMuted = !c.muted;
        try {
          const res = await fetch('/api/admin/fold/communities/muted', {
            method: 'PUT',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ community_id: cid, muted: newMuted }),
          });
          if (!res.ok) throw new Error('mute');
          c.muted = newMuted;
          renderSubs();
        } catch {
          (window as any).toast.error('Mute toggle failed');
        }
        muteC.disabled = false;
        return;
      }

      const addT = target.closest(
        '[data-add-thread]',
      ) as HTMLButtonElement | null;
      if (addT) {
        addT.disabled = true;
        const pid = Number(addT.dataset.addThread);
        try {
          const res = await fetch('/api/admin/fold/subscriptions/thread', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lemmy_post_id: pid }),
          });
          if (!res.ok) throw new Error('add');
          const t = await res.json();
          mySubs.threads = [t, ...mySubs.threads];
          renderSubs();
          addT.textContent = 'Watching';
        } catch {
          addT.disabled = false;
          (window as any).toast.error('Watch failed');
        }
        return;
      }

      const removeT = target.closest(
        '[data-remove-thread]',
      ) as HTMLButtonElement | null;
      if (removeT) {
        removeT.disabled = true;
        const pid = Number(removeT.dataset.removeThread);
        try {
          const res = await fetch(
            `/api/admin/fold/subscriptions/thread/${pid}`,
            { method: 'DELETE', credentials: 'include' },
          );
          if (!res.ok) throw new Error('rm');
          mySubs.threads = mySubs.threads.filter(
            (t) => t.lemmy_post_id !== pid,
          );
          renderSubs();
          runThreadSearch(threadSearch.value);
        } catch {
          removeT.disabled = false;
          (window as any).toast.error('Remove failed');
        }
        return;
      }
    });
  });
</script>
