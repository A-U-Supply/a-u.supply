        </div>
        <div class="pt-field">
          <label class="pt-label" for="bh-effect">Effect</label>
          <select class="pt-select" id="bh-effect">
            <option value="rotate">Rotate</option>
            <option value="invert">Invert</option>
            <option value="blur">Blur</option>
            <option value="grayscale">Grayscale</option>
            <option value="pixelate">Pixelate</option>
            <option value="fill_black">Fill Black</option>
            <option value="fill_white">Fill White</option>
          </select>
        </div>
        <div class="pt-field" id="bh-jitter-field">
          <label class="pt-label" for="bh-jitter">Jitter <span class="pt-val" id="bh-jitter-val">0.00</span></label>
          <input class="pt-range" type="range" id="bh-jitter" min="0" max="1" step="0.01" value="0" />
        </div>
        <div class="pt-field pt-check-field">
          <label class="pt-check-label">
            <input type="checkbox" id="bh-no-overlap" />
            No Overlap
          </label>
        </div>`;

      const chaosEl       = document.getElementById('bh-chaos') as HTMLInputElement;
      const chaosValEl    = document.getElementById('bh-chaos-val') as HTMLSpanElement;
      const placementEl   = document.getElementById('bh-placement') as HTMLSelectElement;
      const effectEl      = document.getElementById('bh-effect') as HTMLSelectElement;
      const jitterEl      = document.getElementById('bh-jitter') as HTMLInputElement;
      const jitterValEl   = document.getElementById('bh-jitter-val') as HTMLSpanElement;
      const jitterField   = document.getElementById('bh-jitter-field') as HTMLDivElement;

      function updateJitter() {
        const disabled = placementEl.value === 'random';
        jitterField.classList.toggle('disabled', disabled);
        jitterEl.disabled = disabled;
      }

      let t: ReturnType<typeof setTimeout>;
      chaosEl.addEventListener('input', () => {
        chaosValEl.textContent = parseFloat(chaosEl.value).toFixed(2);
        clearTimeout(t); t = setTimeout(doReroll, 150);
      });
      jitterEl.addEventListener('input', () => {
        jitterValEl.textContent = parseFloat(jitterEl.value).toFixed(2);
        clearTimeout(t); t = setTimeout(doReroll, 150);
      });
      placementEl.addEventListener('change', () => { updateJitter(); doReroll(); });
      (document.getElementById('bh-no-overlap') as HTMLInputElement)
        .addEventListener('change', doReroll);
      effectEl.addEventListener('change', doRender);
      updateJitter();
    }

    function getBulletholeParams(): Record<string, any> {
      return {
        chaos:      parseFloat((document.getElementById('bh-chaos') as HTMLInputElement)?.value ?? '0.5'),
        placement:  (document.getElementById('bh-placement') as HTMLSelectElement)?.value ?? 'random',
        effect:     (document.getElementById('bh-effect') as HTMLSelectElement)?.value ?? 'rotate',
        jitter:     parseFloat((document.getElementById('bh-jitter') as HTMLInputElement)?.value ?? '0'),
        no_overlap: (document.getElementById('bh-no-overlap') as HTMLInputElement)?.checked ?? false,
      };
    }

    function setBulletholeParams(p: Record<string, any>) {
      const set = (id: string, v: any) => {
        const el = document.getElementById(id) as any;
        if (!el) return;
        if (el.type === 'checkbox') el.checked = v;
        else el.value = String(v);
      };
      if (p.chaos      !== undefined) { set('bh-chaos', p.chaos); const el = document.getElementById('bh-chaos-val'); if (el) el.textContent = parseFloat(p.chaos).toFixed(2); }
      if (p.placement  !== undefined) set('bh-placement', p.placement);
      if (p.effect     !== undefined) set('bh-effect', p.effect);
      if (p.jitter     !== undefined) { set('bh-jitter', p.jitter); const el = document.getElementById('bh-jitter-val'); if (el) el.textContent = parseFloat(p.jitter).toFixed(2); }
      if (p.no_overlap !== undefined) set('bh-no-overlap', p.no_overlap);
      // Re-trigger jitter state
      const placementEl = document.getElementById('bh-placement') as HTMLSelectElement | null;
      const jitterField = document.getElementById('bh-jitter-field') as HTMLDivElement | null;
      const jitterEl    = document.getElementById('bh-jitter') as HTMLInputElement | null;
      if (placementEl && jitterField && jitterEl) {
        const disabled = placementEl.value === 'random';
        jitterField.classList.toggle('disabled', disabled);
        jitterEl.disabled = disabled;
      }
    }

    // ─── Wobble Eye params ─────────────────────────────────────────────────────

    function buildWobbleeyeParams() {
      paramsEl.innerHTML = `
        <div class="pt-field">
          <label class="pt-label" for="we-rings">Rings</label>
          <input class="pt-range" type="range" id="we-rings" min="2" max="10" step="1" value="5" />
          <div class="pt-range-hints"><span>2</span><span>10</span></div>
        </div>`;
      document.getElementById('we-rings')!
        .addEventListener('input', doReroll);
    }

    function getWobbleeyeParams(): Record<string, any> {
      return { rings: parseInt((document.getElementById('we-rings') as HTMLInputElement)?.value ?? '5', 10) };
    }

    function setWobbleeyeParams(p: Record<string, any>) {
      if (p.rings !== undefined) {
        const el = document.getElementById('we-rings') as HTMLInputElement | null;
        if (el) el.value = String(p.rings);
      }
    }

    // ─── Lathe params ──────────────────────────────────────────────────────────

    function buildLatheParams() {
      paramsEl.innerHTML = `
        <div class="pt-field">
          <label class="pt-label" for="lt-rings">Rings <span class="pt-val" id="lt-rings-val">80</span></label>
          <input class="pt-range" type="range" id="lt-rings" min="5" max="120" step="1" value="80" />
          <div class="pt-range-hints"><span>5</span><span>120</span></div>
        </div>`;
      const el = document.getElementById('lt-rings') as HTMLInputElement;
      const val = document.getElementById('lt-rings-val') as HTMLSpanElement;
      let t: ReturnType<typeof setTimeout>;
      el.addEventListener('input', () => {
        val.textContent = el.value;
        clearTimeout(t); t = setTimeout(doReroll, 150);
      });
    }

    function getLatheParams(): Record<string, any> {
      return { rings: parseInt((document.getElementById('lt-rings') as HTMLInputElement)?.value ?? '80', 10) };
    }

    function setLatheParams(p: Record<string, any>) {
      if (p.rings !== undefined) {
        const el = document.getElementById('lt-rings') as HTMLInputElement | null;
        if (el) { el.value = String(p.rings); const v = document.getElementById('lt-rings-val'); if (v) v.textContent = String(p.rings); }
      }
    }

    // ─── Lattice params ────────────────────────────────────────────────────────

    function buildLatticeParams() {
      paramsEl.innerHTML = `
        <div class="pt-field">
          <label class="pt-label" for="lat-strips">Strips <span class="pt-val" id="lat-strips-val">20</span></label>
          <input class="pt-range" type="range" id="lat-strips" min="3" max="40" step="1" value="20" />
          <div class="pt-range-hints"><span>3</span><span>40</span></div>
        </div>
        <div class="pt-field">
          <label class="pt-label" for="lat-gap">Gap <span class="pt-val" id="lat-gap-val">6</span></label>
          <input class="pt-range" type="range" id="lat-gap" min="0" max="20" step="1" value="6" />
          <div class="pt-range-hints"><span>0</span><span>20</span></div>
        </div>`;
      const stripsEl = document.getElementById('lat-strips') as HTMLInputElement;
      const stripsVal = document.getElementById('lat-strips-val') as HTMLSpanElement;
      const gapEl = document.getElementById('lat-gap') as HTMLInputElement;
      const gapVal = document.getElementById('lat-gap-val') as HTMLSpanElement;
      let t: ReturnType<typeof setTimeout>;
      stripsEl.addEventListener('input', () => {
        stripsVal.textContent = stripsEl.value;
        clearTimeout(t); t = setTimeout(doRender, 200);
      });
      gapEl.addEventListener('input', () => {
        gapVal.textContent = gapEl.value;
        clearTimeout(t); t = setTimeout(doRender, 200);
      });
    }

    function getLatticeParams(): Record<string, any> {
      return {
        n_strips: parseInt((document.getElementById('lat-strips') as HTMLInputElement)?.value ?? '20', 10),
        gap:      parseInt((document.getElementById('lat-gap')    as HTMLInputElement)?.value ?? '6',  10),
      };
    }

    function setLatticeParams(p: Record<string, any>) {
      const set = (id: string, valId: string, v: any) => {
        const el = document.getElementById(id) as HTMLInputElement | null;
        const ve = document.getElementById(valId) as HTMLElement | null;
        if (el) { el.value = String(v); if (ve) ve.textContent = String(v); }
      };
      if (p.n_strips !== undefined) set('lat-strips', 'lat-strips-val', p.n_strips);
      if (p.gap      !== undefined) set('lat-gap',    'lat-gap-val',    p.gap);
    }

    // ─── Slot building ─────────────────────────────────────────────────────────

    async function applyTransformAndUpdate(slotIdx: number): Promise<void> {
      const img = sourceImgs[slotIdx];
      if (!img) { effectiveImgs[slotIdx] = null; return; }

      const { rot, flip } = slotTransforms[slotIdx];

      if (rot === 0 && !flip) {
        effectiveImgs[slotIdx] = img;
      } else {
        const nW = img.naturalWidth, nH = img.naturalHeight;
        const swapped = rot === 90 || rot === 270;
        const outW = swapped ? nH : nW, outH = swapped ? nW : nH;

        const c = document.createElement('canvas');
        c.width = outW; c.height = outH;
        const ctx = c.getContext('2d')!;
        ctx.translate(outW / 2, outH / 2);
        ctx.rotate(rot * Math.PI / 180);
        if (flip) ctx.scale(-1, 1);
        ctx.drawImage(img, -nW / 2, -nH / 2);

        await new Promise<void>(resolve => {
          c.toBlob(blob => {
            const url = URL.createObjectURL(blob!);
            const result = new Image();
            result.onload = () => { effectiveImgs[slotIdx] = result; resolve(); };
            result.src = url;
          });
        });
      }

      const thumb = document.getElementById(`slot-thumb-${slotIdx}`) as HTMLImageElement | null;
      const empty = document.getElementById(`slot-empty-${slotIdx}`);
      if (thumb && effectiveImgs[slotIdx]) {
        thumb.src = effectiveImgs[slotIdx]!.src;
        thumb.style.display = 'block';
        if (empty) empty.style.display = 'none';
      }
    }

    function updateXformButtons(slotIdx: number) {
      const loaded = sourceImgs[slotIdx] !== null;
      slotsEl.querySelectorAll(`[data-slot-xform="${slotIdx}"]`).forEach(btn => {
        (btn as HTMLButtonElement).disabled = !loaded;
      });
    }

    function buildSlots(bot: BotDef) {
      slotsEl.innerHTML = bot.inputLabels.map((label, i) => `
        <div class="pt-slot" data-slot="${i}">
          <div class="pt-slot__drop" id="slot-drop-${i}" tabindex="0">
            <img class="pt-slot__thumb" id="slot-thumb-${i}" alt="${label}" />
            <div class="pt-slot__empty-icon" id="slot-empty-${i}">+</div>
            <input type="file" accept="image/*" style="display:none" id="slot-file-${i}" />
          </div>
          <div class="pt-slot__label">${label}</div>
          <div class="pt-slot__controls">
            <button class="pt-slot__lib" data-slot-lib="${i}">IMG</button>
            <button class="pt-slot__xform" data-slot-xform="${i}" data-xform="rotl" disabled title="Rotate left">↺</button>
            <button class="pt-slot__xform" data-slot-xform="${i}" data-xform="rotr" disabled title="Rotate right">↻</button>
            <button class="pt-slot__xform" data-slot-xform="${i}" data-xform="flip" disabled title="Mirror">⇔</button>
          </div>
        </div>
      `).join('');

      for (let i = 0; i < bot.inputs; i++) {
        const drop  = document.getElementById(`slot-drop-${i}`)!;
        const thumb = document.getElementById(`slot-thumb-${i}`) as HTMLImageElement;
        const empty = document.getElementById(`slot-empty-${i}`)!;
        const file  = document.getElementById(`slot-file-${i}`) as HTMLInputElement;
        const libBtn = slotsEl.querySelector(`[data-slot-lib="${i}"]`) as HTMLButtonElement;

        drop.addEventListener('click', (e) => {
          if ((e.target as Element).closest('button')) return;
          file.click();
        });
        drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('drag-over'); });
        drop.addEventListener('dragleave', () => drop.classList.remove('drag-over'));
        drop.addEventListener('drop', (e) => {
          e.preventDefault();
          drop.classList.remove('drag-over');
          const f = e.dataTransfer?.files[0];
          if (f && f.type.startsWith('image/')) loadSlotFromBlob(i, f);
        });
        file.addEventListener('change', () => {
          if (file.files?.[0]) loadSlotFromBlob(i, file.files[0]);
        });

        const slotIdx = i;
        libBtn.addEventListener('click', () => openLibrary(slotIdx));

        slotsEl.querySelectorAll(`[data-slot-xform="${i}"]`).forEach(btn => {
          btn.addEventListener('click', () => {
            const xform = (btn as HTMLElement).dataset.xform!;
            const t = slotTransforms[slotIdx];
            if (xform === 'rotl') t.rot = (t.rot + 270) % 360;
            if (xform === 'rotr') t.rot = (t.rot + 90) % 360;
            if (xform === 'flip') t.flip = !t.flip;
            applyTransformAndUpdate(slotIdx).then(() => {
              if (allSlotsReady()) doRender();
            });
          });
        });

        // Restore any already-loaded image for this slot (after bot switch with same n)
        if (sourceImgs[i]) {
          thumb.src = effectiveImgs[i]?.src ?? sourceImgs[i]!.src;
          thumb.style.display = 'block';
          empty.style.display = 'none';
          updateXformButtons(i);
        }
      }
    }

    // ─── Core flow ─────────────────────────────────────────────────────────────

    function allSlotsReady(): boolean {
      const n = BOTS[currentBot].inputs;
      return effectiveImgs.slice(0, n).every(img => img !== null);
    }

    function doReroll(seed?: number) {
      if (!allSlotsReady()) return;
      const bot = BOTS[currentBot];
      if (bot.hasRandomness) {
        currentSeed = seed !== undefined ? seed : (Math.random() * 2**31 | 0) || 1;
        rng = mulberry32(currentSeed);
      }
      const params = bot.getParams?.() ?? {};
      outputs = bot.render(effectiveImgs, params, rng);
      appendStencilOutputs();
      activeOutputIdx = 0;
      renderStrip();
      setActiveOutput(0);
      enableActions(true);
    }

    function doRender() {
      if (!allSlotsReady()) return;
      const bot = BOTS[currentBot];
      // Re-render with same seed (only changes that don't affect layout, e.g. effect)
      if (bot.hasRandomness) rng = mulberry32(currentSeed);
      const params = bot.getParams?.() ?? {};
      outputs = bot.render(effectiveImgs, params, rng);
      appendStencilOutputs();
      renderStrip();
      setActiveOutput(activeOutputIdx < outputs.length ? activeOutputIdx : 0);
    }

    function setActiveOutput(idx: number) {
      if (outputs.length === 0) return;
      activeOutputIdx = idx;

      const out = outputs[idx];
      stageCanvas.width  = out.canvas.width;
      stageCanvas.height = out.canvas.height;
      stageCanvas.getContext('2d')!.drawImage(out.canvas, 0, 0);
      stageCanvas.style.display = 'block';
      emptyEl.style.display = 'none';

      // Update strip active highlight
      stripEl.querySelectorAll('.pt-thumb').forEach((el, i) => {
        el.classList.toggle('pt-thumb--active', i === idx);
      });
    }

    function renderStrip() {
      if (outputs.length <= 1) {
        stripEl.style.display = 'none';
        return;
      }
      stripEl.style.display = 'flex';
      stripEl.innerHTML = '';

      outputs.forEach((o, i) => {
        const wrapper = document.createElement('div');
        wrapper.className = `pt-thumb${i === activeOutputIdx ? ' pt-thumb--active' : ''}`;
        wrapper.dataset.idx = String(i);

        const tc = document.createElement('canvas');
        tc.className = 'pt-thumb__canvas';
        tc.width = 90; tc.height = 90;
        const aspect = o.canvas.width / o.canvas.height;
        let sw = 90, sh = 90;
        if (aspect > 1) sh = Math.round(90 / aspect);
        else sw = Math.round(90 * aspect);
        const ox = Math.round((90 - sw) / 2), oy = Math.round((90 - sh) / 2);
        tc.getContext('2d')!.drawImage(o.canvas, ox, oy, sw, sh);

        const lbl = document.createElement('div');
        lbl.className = 'pt-thumb__label';
        lbl.textContent = o.label;

        wrapper.appendChild(tc);
        wrapper.appendChild(lbl);
        wrapper.addEventListener('click', () => setActiveOutput(i));
        stripEl.appendChild(wrapper);
      });
    }

    function enableActions(on: boolean) {
      rerollBtn.disabled   = !on || !BOTS[currentBot].hasRandomness;
      downloadBtn.disabled = !on;
      saveBtn.disabled     = !on;
      savePngBtn.disabled  = !on;
    }

    // ─── Switch bot ────────────────────────────────────────────────────────────

    function switchBot(id: string) {
      currentBot = id;
      const bot = BOTS[id];

      const descEl = document.getElementById('pt-bot-desc');
      if (descEl) descEl.textContent = bot?.desc ?? '';

      // Reset state
      sourceImgs = [null, null, null, null];
      sourceIds  = [null, null, null, null];
      slotTransforms = [{rot:0,flip:false},{rot:0,flip:false},{rot:0,flip:false},{rot:0,flip:false}];
      effectiveImgs  = [null, null, null, null];
      outputs = [];
      activeOutputIdx = 0;
      stageCanvas.style.display = 'none';
      emptyEl.style.display = '';
      emptyText.textContent = `Load ${bot.inputs > 1 ? bot.inputs + ' images' : 'an image'} to begin`;
      stripEl.style.display = 'none';
      enableActions(false);

      buildSlots(bot);

      paramsEl.innerHTML = '';
      bot.buildParams?.();
      enhanceSliders();

      stencilParamsEl.style.display = bot.isStencil ? '' : 'none';

      // re-roll only makes sense for randomness bots
      rerollBtn.disabled = !bot.hasRandomness;
    }

    // ─── Slider number-input enhancement ──────────────────────────────────────

    function enhanceSliders(container: HTMLElement = paramsEl) {
      container.querySelectorAll<HTMLInputElement>('input.pt-range').forEach(range => {
        const num = document.createElement('input');
        num.type = 'number';
        num.className = 'pt-num-input';
        num.min = range.min;
        num.max = range.max;
        num.step = range.step;
        num.value = range.value;

        const row = document.createElement('div');
        row.className = 'pt-range-row';
        range.parentNode!.insertBefore(row, range);
        row.appendChild(range);
        row.appendChild(num);

        range.addEventListener('input', () => { num.value = range.value; });

        num.addEventListener('change', () => {
          let v = parseFloat(num.value);
          if (isNaN(v)) { num.value = range.value; return; }
          const mn = parseFloat(range.min), mx = parseFloat(range.max);
          const st = parseFloat(range.step) || 1;
          v = Math.max(mn, Math.min(mx, Math.round(v / st) * st));
          num.value = String(v);
          range.value = String(v);
          range.dispatchEvent(new Event('input', { bubbles: true }));
        });
      });
    }

    // ─── Load image into slot ──────────────────────────────────────────────────

    function onSlotLoaded(slotIdx: number) {
      slotTransforms[slotIdx] = { rot: 0, flip: false };
      applyTransformAndUpdate(slotIdx).then(() => {
        updateXformButtons(slotIdx);
        if (allSlotsReady()) doReroll();
      });
    }

    function loadSlotFromBlob(slotIdx: number, blob: Blob) {
      sourceIds[slotIdx] = null;
      const url = URL.createObjectURL(blob);
      const img = new Image();
      img.onload = () => {
        sourceImgs[slotIdx] = img;
        onSlotLoaded(slotIdx);
        URL.revokeObjectURL(url);
      };
      img.src = url;
    }

    function loadSlotFromUrl(slotIdx: number, url: string, sourceId: string | null, onReady?: () => void) {
      sourceIds[slotIdx] = sourceId;
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        sourceImgs[slotIdx] = img;
        onSlotLoaded(slotIdx);
        onReady?.();
      };
      img.onerror = () => (window as any).toast?.error('Failed to load image');
      img.src = url;
    }

    // ─── atelier metadata ──────────────────────────────────────────────────────

    function atelierMeta(): string {
      const bot = BOTS[currentBot];
      const ids = sourceIds.slice(0, bot.inputs);
      if (!ids[0]) return '';
      return JSON.stringify({
        atelier: 'punctum',
        v: 1,
        bot: currentBot,
        source_ids: ids,
        seed: currentSeed,
        output_idx: activeOutputIdx,
        params: bot.getParams?.() ?? {},
      });
    }

    // ─── Save / download ───────────────────────────────────────────────────────

    async function saveToOutputs(mimeType: string, filename: string, btn: HTMLButtonElement, label: string): Promise<string | null> {
      if (outputs.length === 0) return null;
      const out = outputs[activeOutputIdx];
      btn.disabled = true; btn.textContent = 'Saving…';
      return new Promise((resolve) => {
        out.canvas.toBlob(async (blob) => {
          if (!blob) { (window as any).toast?.error('Export failed'); btn.disabled = false; btn.textContent = label; resolve(null); return; }
          try {
            const fd = new FormData();
            fd.append('file', blob, filename);
            fd.append('tags', `${currentBot},atelier,punctum`);
            fd.append('output_index', 'outputs');
            const meta = atelierMeta();
            if (meta) fd.append('description', meta);
            const res = await fetch('/api/media/upload', { method: 'POST', body: fd, credentials: 'include' });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();
            (window as any).toast?.success('Saved to outputs');
            resolve(data.id || null);
          } catch (err: any) {
            (window as any).toast?.error(`Save failed: ${err.message}`);
            resolve(null);
          } finally { btn.disabled = false; btn.textContent = label; }
        }, mimeType, mimeType === 'image/jpeg' ? 0.85 : undefined);
      });
    }

    rerollBtn.addEventListener('click', () => doReroll());
    downloadBtn.addEventListener('click', () => {
      if (outputs.length === 0) return;
      const link = document.createElement('a');
      link.download = `${currentBot}.jpg`;
      link.href = outputs[activeOutputIdx].canvas.toDataURL('image/jpeg', 0.85);
      link.click();
    });
    saveBtn.addEventListener('click', () =>
      saveToOutputs('image/jpeg', `${currentBot}.jpg`, saveBtn, '☁ Save'));
    savePngBtn.addEventListener('click', () =>
      saveToOutputs('image/png', `${currentBot}.png`, savePngBtn, '☁ HD PNG'));

    // ─── Library modal ─────────────────────────────────────────────────────────

    const ALL_LIB_TABS = [libTabInputs, libTabOutputs, libTabWorkspace, libTabRandInputs, libTabRandOutputs];

    function setLibTab(tab: LibTab) {
      activeLibTab = tab;
      ALL_LIB_TABS.forEach(b => b.classList.remove('pt-modal__tab--active'));
      ({ inputs: libTabInputs, outputs: libTabOutputs, workspace: libTabWorkspace,
         'rand-inputs': libTabRandInputs, 'rand-outputs': libTabRandOutputs } as Record<LibTab, HTMLButtonElement>)[tab]
        .classList.add('pt-modal__tab--active');
      librarySearch.style.display     = tab === 'inputs' ? '' : 'none';
      libraryShuffleBtn.style.display = (tab === 'rand-inputs' || tab === 'rand-outputs') ? '' : 'none';
    }

    function openLibrary(slotIdx: number) {
      pendingSlot = slotIdx;
      setLibTab('inputs');
      libraryOverlay.style.display = 'flex';
      librarySearch.value = '';
      loadInputs('');
    }

    function renderGrid(items: { id: string; filename?: string }[]) {
      if (items.length === 0) {
        libraryGrid.innerHTML = '<div class="pt-modal__loading">No images found</div>';
        return;
      }
      libraryGrid.innerHTML = '';
      for (const item of items) {
        const img = document.createElement('img');
        img.className = 'pt-lib-thumb';
        img.src = `/api/media/${item.id}/thumbnail`;
        img.alt = item.filename || '';
        img.loading = 'lazy';
        img.addEventListener('click', () => {
          libraryOverlay.style.display = 'none';
          loadSlotFromUrl(pendingSlot, `/api/media/${item.id}/file`, item.id);
        });
        libraryGrid.appendChild(img);
      }
    }

    async function loadInputs(q: string) {
      libraryGrid.innerHTML = '<div class="pt-modal__loading loading-dots">Loading</div>';
      try {
        const res = await fetch('/api/search', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: q, media_types: ['image'], sort: 'created_at:desc',
                                 page: 1, per_page: 48, filters: { output_index: '__inputs__' } }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        renderGrid(data.results || data.hits || []);
      } catch (err: any) {
        libraryGrid.innerHTML = `<div class="pt-modal__loading">Error: ${err.message}</div>`;
      }
    }

    async function loadOutputs() {
      libraryGrid.innerHTML = '<div class="pt-modal__loading loading-dots">Loading</div>';
      try {
        const res = await fetch('/api/search', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: '', media_types: ['image'], sort: 'created_at:desc',
                                 page: 1, per_page: 48, filters: { output_index: '__outputs__' } }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        renderGrid(data.results || data.hits || []);
      } catch (err: any) {
        libraryGrid.innerHTML = `<div class="pt-modal__loading">Error: ${err.message}</div>`;
      }
    }

    async function loadWorkspace() {
      libraryGrid.innerHTML = '<div class="pt-modal__loading loading-dots">Loading</div>';
      const wsId = localStorage.getItem('active_workspace_id');
      if (!wsId) {
        libraryGrid.innerHTML = '<div class="pt-modal__loading">No active workspace</div>';
        return;
      }
      try {
        const res = await fetch(`/api/workspaces/${wsId}/items?per_page=100`, { credentials: 'include' });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const images = (data.items || []).filter((i: any) => i.media_type === 'image');
        if (images.length === 0) {
          libraryGrid.innerHTML = '<div class="pt-modal__loading">No images in workspace</div>';
          return;
        }
        libraryGrid.innerHTML = '';
        for (const item of images) {
          const img = document.createElement('img');
          img.className = 'pt-lib-thumb';
          img.src = `/api/media/${item.media_item_id}/thumbnail`;
          img.alt = item.filename || '';
          img.loading = 'lazy';
          img.addEventListener('click', () => {
            libraryOverlay.style.display = 'none';
            loadSlotFromUrl(pendingSlot, `/api/media/${item.media_item_id}/file`, item.media_item_id);
          });
          libraryGrid.appendChild(img);
        }
      } catch (err: any) {
        libraryGrid.innerHTML = `<div class="pt-modal__loading">Error: ${err.message}</div>`;
      }
    }

    async function loadRandInputs() {
      if (randInputsPool.length === 0) {
        libraryGrid.innerHTML = '<div class="pt-modal__loading loading-dots">Loading</div>';
        try {
          const res = await fetch('/api/search', {
            method: 'POST', credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: '', media_types: ['image'], sort: 'created_at:desc',
                                   page: 1, per_page: 200, filters: { output_index: '__inputs__' } }),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          randInputsPool = (data.results || data.hits || []).slice(48);
        } catch (err: any) {
          libraryGrid.innerHTML = `<div class="pt-modal__loading">Error: ${err.message}</div>`;
          return;
        }
      }
      const pool = [...randInputsPool];
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      renderGrid(pool.slice(0, 48));
    }

    async function loadRandOutputs() {
      if (randOutputsPool.length === 0) {
        libraryGrid.innerHTML = '<div class="pt-modal__loading loading-dots">Loading</div>';
        try {
          const res = await fetch('/api/search', {
            method: 'POST', credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: '', media_types: ['image'], sort: 'created_at:desc',
                                   page: 1, per_page: 200, filters: { output_index: '__outputs__' } }),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          randOutputsPool = (data.results || data.hits || []).slice(48);
        } catch (err: any) {
          libraryGrid.innerHTML = `<div class="pt-modal__loading">Error: ${err.message}</div>`;
          return;
        }
      }
      const pool = [...randOutputsPool];
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      renderGrid(pool.slice(0, 48));
    }

    libraryClose.addEventListener('click', () => { libraryOverlay.style.display = 'none'; });
    libraryOverlay.addEventListener('click', (e) => { if (e.target === libraryOverlay) libraryOverlay.style.display = 'none'; });
    libTabInputs.addEventListener('click',      () => { setLibTab('inputs');       loadInputs(librarySearch.value); });
    libTabOutputs.addEventListener('click',     () => { setLibTab('outputs');      loadOutputs(); });
    libTabWorkspace.addEventListener('click',   () => { setLibTab('workspace');    loadWorkspace(); });
    libTabRandInputs.addEventListener('click',  () => { setLibTab('rand-inputs');  loadRandInputs(); });
    libTabRandOutputs.addEventListener('click', () => { setLibTab('rand-outputs'); loadRandOutputs(); });
    libraryShuffleBtn.addEventListener('click', () => {
      if (activeLibTab === 'rand-inputs')  loadRandInputs();
      if (activeLibTab === 'rand-outputs') loadRandOutputs();
    });
    librarySearch.addEventListener('input', () => {
      clearTimeout(librarySearchTimer);
      librarySearchTimer = setTimeout(() => loadInputs(librarySearch.value), 300);
    });

    // ─── Stencil controls ──────────────────────────────────────────────────────

    enhanceSliders(stencilParamsEl);
    let stencilDebounce: ReturnType<typeof setTimeout>;
    document.getElementById('st-bias')?.addEventListener('input', (e) => {
      document.getElementById('st-bias-val')!.textContent = (e.target as HTMLInputElement).value;
      clearTimeout(stencilDebounce); stencilDebounce = setTimeout(doRender, 150);
    });
    document.getElementById('st-contrast')?.addEventListener('input', (e) => {
      document.getElementById('st-contrast-val')!.textContent = parseFloat((e.target as HTMLInputElement).value).toFixed(2);
      clearTimeout(stencilDebounce); stencilDebounce = setTimeout(doRender, 150);
    });
    document.getElementById('st-invert')?.addEventListener('change', () => doRender());

    // ─── Bot selector ──────────────────────────────────────────────────────────

    botSelect.addEventListener('change', () => switchBot(botSelect.value));

    // ─── URL param auto-export ─────────────────────────────────────────────────

    const urlParams = new URLSearchParams(window.location.search);
    const botParam  = urlParams.get('bot');
    const autoExport = urlParams.get('autoexport');

    // Set bot from URL
    if (botParam && BOTS[botParam]) {
      botSelect.value = botParam;
    }

    // Initialize with correct bot (builds slots + params)
    switchBot(botSelect.value);

    if (autoExport) {
      // Restore params before loading images
      BOTS[currentBot].setParams?.(Object.fromEntries(urlParams.entries()));

      const seedParam = urlParams.get('seed');
      const seed = seedParam ? parseInt(seedParam, 10) : undefined;

      // Load all source images then save
      const bot = BOTS[currentBot];
      let loadCount = 0;
      const sourceCount = bot.inputs;

      const outputIdx = parseInt(urlParams.get('output_idx') ?? '0', 10);

      function onAllLoaded() {
        const mimeType = autoExport === 'png' ? 'image/png' : 'image/jpeg';
        const filename  = autoExport === 'png' ? `${currentBot}.png` : `${currentBot}.jpg`;
        doReroll(seed);
        // doReroll resets activeOutputIdx to 0; restore the saved index
        if (outputIdx > 0 && outputIdx < outputs.length) {
          setActiveOutput(outputIdx);
        }
        saveToOutputs(mimeType, filename, savePngBtn, '☁ HD PNG').then((newId) => {
          if (newId) window.location.href = `/admin/search/detail?id=${newId}`;
        });
      }

      for (let i = 0; i < sourceCount; i++) {
        const sid = urlParams.get(`source${i}`);
        if (sid) {
          loadSlotFromUrl(i, `/api/media/${sid}/file`, sid, () => {
            loadCount++;
            if (loadCount === sourceCount) onAllLoaded();
          });
        } else {
          loadCount++;
          if (loadCount === sourceCount) onAllLoaded();
        }
      }
    }

    // Cleanup on Astro view transitions
    document.addEventListener('astro:before-swap', () => {
      clearTimeout(librarySearchTimer);
    }, { once: true });

  });
</script>
