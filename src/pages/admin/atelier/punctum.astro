    // ─── Palette Swap ─────────────────────────────────────────────────────────

    function renderPaletteSwap(imgs: (HTMLImageElement | null)[], params: Record<string, any>, rng: () => number): Output[] {
      const imgA = imgs[0]; const imgB = imgs[1];
      if (!imgA || !imgB) return [];

      const N: number       = params['ps-n']      ?? 8;
      const dither: boolean = !!(params['ps-dither'] ?? false);

      function getPixelData(img: HTMLImageElement): Uint8ClampedArray {
        const c = document.createElement('canvas');
        c.width = img.naturalWidth; c.height = img.naturalHeight;
        c.getContext('2d')!.drawImage(img, 0, 0);
        return c.getContext('2d')!.getImageData(0, 0, c.width, c.height).data;
      }

      function extractPalette(data: Uint8ClampedArray, pixels: number): [number, number, number][] {
        const step = Math.max(1, Math.floor(pixels / Math.min(1000, pixels)));
        const samples: [number, number, number][] = [];
        for (let i = 0; i < pixels; i += step) {
          if (data[i * 4 + 3] < 128) continue;
          samples.push([data[i*4], data[i*4+1], data[i*4+2]]);
        }
        let centroids: [number, number, number][] = [];
        const used = new Set<number>();
        while (centroids.length < N && centroids.length < samples.length) {
          const idx = Math.floor(rng() * samples.length);
          if (!used.has(idx)) { used.add(idx); centroids.push([...samples[idx]] as [number, number, number]); }
        }
        for (let iter = 0; iter < 20; iter++) {
          const sums: [number, number, number, number][] = centroids.map(() => [0, 0, 0, 0]);
          for (const [r, g, b] of samples) {
            let best = 0, bestDist = Infinity;
            for (let k = 0; k < centroids.length; k++) {
              const dr = r - centroids[k][0], dg = g - centroids[k][1], db = b - centroids[k][2];
              const dist = dr*dr + dg*dg + db*db;
              if (dist < bestDist) { bestDist = dist; best = k; }
            }
            sums[best][0] += r; sums[best][1] += g; sums[best][2] += b; sums[best][3]++;
          }
          for (let k = 0; k < centroids.length; k++) {
            if (sums[k][3] > 0) centroids[k] = [sums[k][0]/sums[k][3], sums[k][1]/sums[k][3], sums[k][2]/sums[k][3]];
          }
        }
        return centroids;
      }

      function applyPalette(srcData: Uint8ClampedArray, W: number, H: number, centroids: [number,number,number][]): HTMLCanvasElement {
        const dst = document.createElement('canvas'); dst.width = W; dst.height = H;
        const ctx = dst.getContext('2d')!;
        const out = ctx.createImageData(W, H);
        const d   = new Float32Array(W * H * 3);
        for (let i = 0; i < W * H; i++) {
          d[i*3] = srcData[i*4]; d[i*3+1] = srcData[i*4+1]; d[i*3+2] = srcData[i*4+2];
        }
        for (let y = 0; y < H; y++) {
          for (let x = 0; x < W; x++) {
            const i = y * W + x;
            const pr = d[i*3], pg = d[i*3+1], pb = d[i*3+2];
            let best = 0, bestDist = Infinity;
            for (let k = 0; k < centroids.length; k++) {
              const dr = pr - centroids[k][0], dg = pg - centroids[k][1], db = pb - centroids[k][2];
              const dist = dr*dr + dg*dg + db*db;
              if (dist < bestDist) { bestDist = dist; best = k; }
            }
            const [cr, cg, cb] = centroids[best];
            const pi = i * 4;
            out.data[pi] = Math.round(cr); out.data[pi+1] = Math.round(cg);
            out.data[pi+2] = Math.round(cb); out.data[pi+3] = srcData[pi+3];
            if (dither) {
              const er = pr - cr, eg = pg - cg, eb = pb - cb;
              for (const [nx, ny, w] of [[x+1,y,7/16],[x-1,y+1,3/16],[x,y+1,5/16],[x+1,y+1,1/16]] as [number,number,number][]) {
                if (nx < 0 || nx >= W || ny >= H) continue;
                const ni = ny * W + nx;
                d[ni*3] += er*w; d[ni*3+1] += eg*w; d[ni*3+2] += eb*w;
              }
            }
          }
        }
        ctx.putImageData(out, 0, 0);
        return dst;
      }

      const dataA = getPixelData(imgA);
      const dataB = getPixelData(imgB);
      const palA  = extractPalette(dataA, imgA.naturalWidth * imgA.naturalHeight);
      const palB  = extractPalette(dataB, imgB.naturalWidth * imgB.naturalHeight);

      return [
        { canvas: applyPalette(dataB, imgB.naturalWidth, imgB.naturalHeight, palA), label: 'B → A palette' },
        { canvas: applyPalette(dataA, imgA.naturalWidth, imgA.naturalHeight, palB), label: 'A → B palette' },
      ];
    }

    function buildPaletteSwapParams() {
      paramsEl.innerHTML = `
        <div class="pt-field">
          <label class="pt-label" for="ps-n">Colors <span class="pt-val" id="ps-n-val">8</span></label>
          <input class="pt-range" type="range" id="ps-n" min="2" max="16" step="1" value="8" />
        </div>
        <div class="pt-field pt-check-field">
          <label class="pt-check-label">
            <input type="checkbox" id="ps-dither" />
            Floyd-Steinberg Dither
          </label>
        </div>
      `;
      document.getElementById('ps-n')!.addEventListener('input', (e) => {
        document.getElementById('ps-n-val')!.textContent = (e.target as HTMLInputElement).value;
        doReroll();
      });
      document.getElementById('ps-dither')!.addEventListener('change', () => doReroll());
    }
    function getPaletteSwapParams(): Record<string, any> {
      return {
        'ps-n':      parseInt((document.getElementById('ps-n') as HTMLInputElement).value, 10),
        'ps-dither': (document.getElementById('ps-dither') as HTMLInputElement).checked,
      };
    }
    function setPaletteSwapParams(p: Record<string, any>) {
      if (p['ps-n']      != null) { (document.getElementById('ps-n') as HTMLInputElement).value = String(p['ps-n']); document.getElementById('ps-n-val')!.textContent = String(p['ps-n']); }
      if (p['ps-dither'] != null) { (document.getElementById('ps-dither') as HTMLInputElement).checked = !!p['ps-dither']; }
    }

    // ─── Reaction Diffusion ────────────────────────────────────────────────────

    function renderReactionDiffusion(imgs: (HTMLImageElement | null)[], params: Record<string, any>, rng: () => number): Output[] {
      const img = imgs[0]; if (!img) return [];
      const W = img.naturalWidth, H = img.naturalHeight;

      const f: number    = params['rd-f']    ?? 0.055;
      const k: number    = params['rd-k']    ?? 0.062;
      const iters: number = params['rd-iter'] ?? 500;
      const res: number  = params['rd-res']  ?? 128;

      // Scale working resolution
      const aspect = W / H;
      const RW = aspect >= 1 ? res : Math.round(res * aspect);
      const RH = aspect >= 1 ? Math.round(res / aspect) : res;

      // Sample image brightness to seed B field
      const seedSrc = document.createElement('canvas'); seedSrc.width = RW; seedSrc.height = RH;
      seedSrc.getContext('2d')!.drawImage(img, 0, 0, RW, RH);
      const seedData = seedSrc.getContext('2d')!.getImageData(0, 0, RW, RH).data;

      // Gray-Scott fields: A (activator), B (inhibitor)
      let A = new Float32Array(RW * RH);
      let B = new Float32Array(RW * RH);
      let nA = new Float32Array(RW * RH);
      let nB = new Float32Array(RW * RH);

      // Initialize: A=1 everywhere, seed B from bright pixels
      for (let i = 0; i < RW * RH; i++) {
        A[i] = 1.0;
        const pi = i * 4;
        const bright = (seedData[pi] * 0.299 + seedData[pi+1] * 0.587 + seedData[pi+2] * 0.114) / 255;
        B[i] = bright > 0.5 ? 1.0 : 0.0;
        // Also seed random spots
        if (rng() < 0.002) B[i] = 1.0;
      }

      const dA = 1.0, dB = 0.5;

      for (let iter = 0; iter < iters; iter++) {
        for (let y = 0; y < RH; y++) {
          for (let x = 0; x < RW; x++) {
            const i = y * RW + x;
            const xp = (x + 1) % RW, xm = (x - 1 + RW) % RW;
            const yp = (y + 1) % RH, ym = (y - 1 + RH) % RH;
            const lapA = A[y*RW+xp] + A[y*RW+xm] + A[yp*RW+x] + A[ym*RW+x] - 4*A[i];
            const lapB = B[y*RW+xp] + B[y*RW+xm] + B[yp*RW+x] + B[ym*RW+x] - 4*B[i];
            const a = A[i], b = B[i];
            const abb = a * b * b;
            nA[i] = Math.max(0, Math.min(1, a + dA * lapA - abb + f * (1 - a)));
            nB[i] = Math.max(0, Math.min(1, b + dB * lapB + abb - (k + f) * b));
          }
        }
        [A, nA] = [nA, A];
        [B, nB] = [nB, B];
      }

      // Render: A-B → grayscale, scale up to original size
      const dst = document.createElement('canvas'); dst.width = W; dst.height = H;
      const ctx = dst.getContext('2d')!;
      const small = document.createElement('canvas'); small.width = RW; small.height = RH;
      const sCtx = small.getContext('2d')!;
      const sOut = sCtx.createImageData(RW, RH);
      for (let i = 0; i < RW * RH; i++) {
        const v = Math.max(0, Math.min(255, Math.round((A[i] - B[i]) * 255)));
        sOut.data[i*4]   = v;
        sOut.data[i*4+1] = v;
        sOut.data[i*4+2] = v;
        sOut.data[i*4+3] = 255;
      }
      sCtx.putImageData(sOut, 0, 0);
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(small, 0, 0, W, H);
      return [{ canvas: dst, label: 'Reaction Diffusion' }];
    }

