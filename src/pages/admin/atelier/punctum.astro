          <div class="pt-range-hints"><span>0°</span><span>180°</span></div>
        </div>`;
      const debounce = (fn: () => void, ms: number) => { let t: ReturnType<typeof setTimeout>; return () => { clearTimeout(t); t = setTimeout(fn, ms); }; };
