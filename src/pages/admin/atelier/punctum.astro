---
import Admin from '../../../layouts/Admin.astro';
---

<Admin title="Punctum" current="punctum">
  <div class="page-header">
    <div class="pt-header-row">
      <h1>Punctum</h1>
      <div class="pt-bot-wrap">
        <span class="pt-bot-label">Bot</span>
        <button class="pt-bot-trigger" id="bot-trigger">Bullet Hole ▾</button>
        <select id="bot-select" style="display:none" aria-hidden="true">
          <option value="bullethole">Bullet Hole</option>
          <option value="stencil">Stencil</option>
          <option value="bw">BW</option>
          <option value="cyanotype">Cyanotype</option>
          <option value="wobbleeye">Wobble Eye</option>
          <option value="lathe">Lathe</option>
          <option value="bullseye">Bullseye</option>
          <option value="sixshooter">Six Shooter</option>
          <option value="lattice">Lattice</option>
          <option value="stencilburn">Stencil Burn</option>
          <option value="zellij">Zellij</option>
          <option value="zellij_medium">Zellij Medium</option>
          <option value="halftone">Halftone</option>
          <option value="linescreen">Line Screen</option>
          <option value="penrose">Penrose</option>
          <option value="monochrome">Monochrome</option>
          <option value="silver">Silver</option>
          <option value="quad">Quad</option>
          <option value="kaleidoscope">Kaleidoscope</option>
          <option value="displacement">Displacement</option>
          <option value="joukowski">Joukowski</option>
          <option value="oilspiral">Oil Spiral</option>
          <option value="soapyspiral">Soapy Spiral</option>
          <option value="halationedge">Halation Edge</option>
          <option value="curvylines">Curvy Lines</option>
          <option value="spiralscreen">Spiral Screen</option>
          <option value="sinewarp">Sine Warp</option>
          <option value="sinephase">Sine Phase</option>
          <option value="circlelimit">Circle Limit</option>
          <option value="curlnoise">Curl Noise</option>
          <option value="chromaticab">Chromatic Aberration</option>
          <option value="paletteswap">Palette Swap</option>
          <option value="reactiondiffusion">Reaction Diffusion</option>
        </select>
        <div class="pt-bot-picker" id="bot-picker" style="display:none">
          <div class="pt-picker-tabs" id="bot-picker-tabs">
            <button class="pt-picker-tab active" data-tab="0">Collage Bot</button>
            <button class="pt-picker-tab" data-tab="1">Protease Bots</button>
            <button class="pt-picker-tab" data-tab="2">Sparagmos</button>
          </div>
          <input class="pt-picker-search" id="bot-picker-search" type="text" placeholder="Search bots…" autocomplete="off" spellcheck="false" />
          <div class="pt-picker-body" id="bot-picker-body"></div>
        </div>
      </div>
    </div>
    <p class="pt-bot-desc" id="pt-bot-desc">Circular crop rotations from random positions across the image</p>
    <div id="pt-bot-params-wrap" class="collapsed">
      <button class="pt-params-toggle" id="pt-bot-params-toggle">▼ Bot Parameters</button>
      <div id="pt-params"></div>
    </div>
    <div id="pt-stencil-params-wrap" class="collapsed">
      <button class="pt-params-toggle" id="pt-stencil-params-toggle">▼ Stencil Parameters</button>
      <div id="pt-stencil-params">
        <div class="pt-field pt-stencil-field">
          <label class="pt-label" for="st-bias">Threshold Bias <span class="pt-val" id="st-bias-val">0</span></label>
          <input class="pt-range" type="range" id="st-bias" min="-64" max="64" step="1" value="0" />
        </div>
        <div class="pt-field pt-stencil-field">
          <label class="pt-label" for="st-contrast">Contrast <span class="pt-val" id="st-contrast-val">1.00</span></label>
          <input class="pt-range" type="range" id="st-contrast" min="0.25" max="3" step="0.05" value="1" />
        </div>
        <div class="pt-field pt-stencil-field pt-check-field">
          <label class="pt-check-label">
            <input type="checkbox" id="st-invert" />
            Invert
          </label>
        </div>
      </div>
    </div>
    <div class="pt-actions">
      <div class="pt-reroll-wrap">
        <button class="btn btn--secondary" id="reroll-btn" disabled>⟳<span class="pt-reroll-label"> RE-ROLL</span></button>
        <button class="btn btn--secondary" id="run-btn" style="display:none" disabled>▶ RUN</button>
      </div>
      <button class="btn btn--secondary" id="download-btn" disabled>↓ Download</button>
      <button class="btn btn--primary"   id="save-btn"     disabled>☁ Save</button>
      <button class="btn btn--secondary" id="save-all-btn" disabled>☁ All</button>
      <button class="btn btn--secondary" id="save-png-btn" disabled>☁ HD PNG</button>
      <input type="number" id="seed-input" class="pt-seed-input" style="display:none" placeholder="seed" min="1" max="2147483647" step="1" />
    </div>
  </div>

  <div class="pt-tabs" id="pt-tabs">
    <button class="pt-tab-add" id="pt-tab-add" title="New tab">+</button>
  </div>

  <div class="pt-shell">
    <div class="pt-left">
      <!-- Output stage -->
      <div class="pt-stage" id="pt-stage">
        <canvas id="pt-canvas" style="display:none"></canvas>
        <div class="pt-processing" id="pt-processing" style="display:none">
          <span id="pt-processing-status" class="loading-dots">Processing</span>
          <a id="pt-processing-job-link" class="pt-processing-job-link" style="display:none" target="_blank"></a>
          <button id="pt-processing-cancel" class="pt-processing-cancel">✕ Cancel</button>
        </div>
        <div class="pt-empty" id="pt-empty">
          <div class="pt-empty__icon">⬡</div>
          <div id="pt-empty-text">Load an image to begin</div>
        </div>
        <button class="pt-chain-btn" id="pt-chain-btn" style="display:none" title="Send active output to a new tab">⊕ Chain</button>
      </div>

      <!-- Thumbnail strip (multi-output bots) -->
      <div class="pt-strip" id="pt-strip" style="display:none"></div>

      <!-- Input slots -->
      <div class="pt-slots" id="pt-slots"></div>
    </div>
  </div>

  <!-- Library modal -->
  <div class="pt-modal-overlay" id="library-overlay" style="display:none">
    <div class="pt-modal">
      <div class="pt-modal__header">
        <h2>Pick an Image</h2>
        <input type="file" accept="image/*" id="library-upload-file" style="display:none" />
        <button class="pt-modal__import" id="library-upload-btn">↑ Import</button>
        <button class="pt-modal__close" id="library-close">✕</button>
      </div>
      <div class="pt-modal__tabs">
        <button class="pt-modal__tab pt-modal__tab--active" id="lib-tab-inputs">Inputs</button>
        <button class="pt-modal__tab" id="lib-tab-outputs">Outputs</button>
        <button class="pt-modal__tab" id="lib-tab-workspace">Workspace</button>
        <button class="pt-modal__tab" id="lib-tab-rand-inputs">⟳ In</button>
        <button class="pt-modal__tab" id="lib-tab-rand-outputs">⟳ Out</button>
      </div>
      <div class="pt-modal__toolbar">
        <input class="pt-modal__search" type="text" id="library-search" placeholder="Search…" />
        <button class="pt-modal__shuffle" id="library-shuffle" style="display:none">↻ Shuffle</button>
      </div>
      <div class="pt-modal__grid" id="library-grid">
        <div class="pt-modal__loading loading-dots">Loading</div>
      </div>
    </div>
  </div>
</Admin>

<style is:global>
  body {
    background: #221c00;
    --color-bg:      #1a1600;
    --color-text:    #ddd;
    --color-muted:   #aaa;
    --color-border:  #3a3500;
    --color-accent:  #e07b54;
    --color-surface: #111;
  }

  .pt-header-row {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .pt-header-row h1 { margin: 0; }

  .pt-bot-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .pt-bot-label {
    font-size: var(--text-sm, 0.8rem);
    color: var(--color-muted);
  }

  .pt-bot-wrap { position: relative; }

  .pt-bot-trigger {
    background: var(--color-surface);
    color: #fff;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 5px 10px;
    font-size: var(--text-sm, 0.85rem);
    cursor: pointer;
    white-space: nowrap;
  }
  .pt-bot-trigger:hover { border-color: #888; }
  .pt-bot-trigger.open   { border-color: var(--color-accent); }

  /* ── Bot picker popover ── */
  .pt-bot-picker {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    z-index: 200;
    background: #181818;
    border: 1px solid #484848;
    border-radius: 4px;
    width: 440px;
    max-width: calc(100vw - 24px);
    max-height: 62vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 28px rgba(0,0,0,0.7);
  }
  .pt-picker-search {
    background: #111;
    border: none;
    border-bottom: 1px solid #333;
    color: #ddd;
    padding: 8px 12px;
    font-size: 0.82rem;
    width: 100%;
    outline: none;
    border-radius: 4px 4px 0 0;
    box-sizing: border-box;
  }
  .pt-picker-search::placeholder { color: #555; }
  .pt-picker-body {
    overflow-y: auto;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pt-picker-tabs {
    display: flex;
    border-bottom: 1px solid #484848;
    flex-shrink: 0;
  }
  .pt-picker-tab {
    flex: 1;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: #aaa;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    padding: 8px 4px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    transition: color 0.15s;
  }
  .pt-picker-tab:hover { color: #ddd; }
  .pt-picker-tab.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
  .pt-picker-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }
  .pt-picker-card {
    background: #222;
    border: 1px solid #333;
    border-radius: 3px;
    padding: 7px 8px;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.08s;
  }
  .pt-picker-card:hover { background: #2c2c2c; border-color: #666; }
  .pt-picker-card--active { border-color: var(--color-accent) !important; }
  .pt-picker-card--hidden { display: none; }
  .pt-picker-card__name {
    font-size: 0.73rem;
    color: #ddd;
    font-weight: 600;
    margin-bottom: 3px;
    line-height: 1.2;
  }
  .pt-picker-card--active .pt-picker-card__name { color: var(--color-accent); }
  .pt-picker-card__desc {
    font-size: 0.6rem;
    color: #888;
    line-height: 1.4;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .pt-picker-empty {
    font-size: 0.75rem;
    color: #555;
    text-align: center;
    padding: 20px 0;
    display: none;
  }
  .pt-picker-section-label {
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #666;
    padding: 8px 2px 2px;
    margin-top: 4px;
  }

  .pt-shell {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .pt-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .pt-tabs {
    display: flex;
    gap: 4px;
    align-items: center;
    padding: 0 0 var(--space-sm);
    flex-wrap: wrap;
  }
  .pt-tab {
    background: #2a2a2a;
    color: #aaa;
    border: 1px solid #444;
    border-radius: 3px 3px 0 0;
    padding: 4px 10px;
    font-size: 0.75rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .pt-tab--active { background: #3a3a3a; color: #fff; border-color: #666; }
  .pt-tab__close {
    background: none;
    border: none;
    color: #999;
    cursor: pointer;
    padding: 0;
    font-size: 0.7rem;
    line-height: 1;
  }
  .pt-tab__close:hover { color: #ff6b6b; }
  .pt-tab-add {
    background: none;
    border: 1px solid #444;
    border-radius: 3px;
    color: #aaa;
    width: 22px;
    height: 22px;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pt-tab-add:hover { border-color: #aaa; color: #fff; }

  .pt-params-toggle {
    background: none; border: none; color: #999;
    font-size: 0.7rem; cursor: pointer; padding: 2px 0 6px;
    display: block; width: 100%; text-align: left;
    letter-spacing: 0.05em;
  }
  .pt-params-toggle:hover { color: #ddd; }
  #pt-bot-params-wrap.collapsed .pt-params-toggle,
  #pt-stencil-params-wrap.collapsed .pt-params-toggle { padding-bottom: 2px; }
  #pt-bot-params-wrap.collapsed #pt-params { display: none !important; }
  #pt-stencil-params-wrap.collapsed #pt-stencil-params { display: none !important; }

  .pt-stage {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .pt-chain-btn {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(0,0,0,0.7);
    color: #e07b54;
    border: 1px solid #e07b54;
    border-radius: 3px;
    padding: 4px 10px;
    font-size: 0.7rem;
    cursor: pointer;
    z-index: 2;
  }
  .pt-chain-btn:hover { background: rgba(224,123,84,0.2); }

  #pt-canvas {
    max-width: 100%;
    max-height: 65vh;
  }

  .pt-processing {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    background: rgba(0,0,0,0.6);
    color: #ddd;
    font-size: var(--text-lg);
    letter-spacing: 2pt;
    z-index: 10;
  }
  .pt-processing-cancel {
    background: none;
    border: 1px solid #666;
    color: #999;
    font-family: var(--font-mono);
    font-size: var(--text-sm, 0.8rem);
    padding: 4px 14px;
    border-radius: 3px;
    cursor: pointer;
    letter-spacing: 0.5pt;
  }
  .pt-processing-cancel:hover { border-color: #ddd; color: #ddd; }
  .pt-processing-job-link {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #555;
    text-decoration: none;
    letter-spacing: 0.3pt;
  }
  .pt-processing-job-link:hover { color: #888; }

  .pt-empty {
    text-align: center;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .pt-empty__icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-sm);
    opacity: 0.4;
  }

  /* Input slots */
  /* ── Slot grid ── */
  .pt-slots {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    align-items: flex-start;
  }

  /* ── Card ── */
  .pt-slot {
    display: flex;
    flex-direction: column;
    min-width: 110px;
    flex: 1 1 110px;
    max-width: 180px;
    background: var(--color-surface);
    border: 1px solid #444;
    border-radius: 4px;
    position: relative;
  }
  .pt-slot.locked {
    border-left: 3px solid #e07b54;
  }

  /* ── Header ── */
  .pt-slot__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 6px;
    border-bottom: 1px solid var(--color-border);
    min-height: 26px;
  }
  .pt-slot__label {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .pt-slot__label-slot {
    color: #ccc;
  }

  /* ── Lock button ── */
  .pt-slot__lock-btn {
    display: flex;
    align-items: center;
    gap: 2px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px 3px;
    border-radius: 2px;
    color: var(--color-muted);
    line-height: 1;
  }
  .pt-slot__lock-icon { font-size: 0.8rem; }
  .pt-slot__lock-btn .pt-slot__btn-lbl {
    font-size: 0.52rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .pt-slot__lock-btn:hover { color: #aaa; }
  .pt-slot.locked .pt-slot__lock-btn { color: #e07b54; }

  /* ── Drop area ── */
  .pt-slot__drop {
    width: 100%;
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
  }
  .pt-slot__drop:hover,
  .pt-slot__drop.drag-over { outline: 1px solid var(--color-accent); }
  .pt-slot__thumb {
    width: 100%;
    height: auto;
    display: none;
  }
  .pt-slot__empty-icon {
    font-size: 1.5rem; opacity: 0.25; pointer-events: none;
  }
  .pt-slot__kept-badge {
    position: absolute;
    top: 4px; right: 4px;
    background: rgba(224,123,84,0.88);
    color: #fff;
    font-size: 0.5rem;
    padding: 1px 5px;
    border-radius: 2px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    pointer-events: none;
  }

  /* ── Controls row ── */
  .pt-slot__controls {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border-top: 1px solid var(--color-border);
    position: relative;
  }
  .pt-slot__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 5px 2px;
    background: none;
    border: none;
    border-right: 1px solid var(--color-border);
    color: var(--color-muted);
    cursor: pointer;
    min-height: 44px;
    position: relative;
  }
  .pt-slot__btn:last-child { border-right: none; }
  .pt-slot__btn:hover:not(:disabled) {
    background: rgba(255,255,255,0.04);
    color: var(--color-text);
  }
  .pt-slot__btn:disabled { opacity: 0.28; cursor: not-allowed; }
  .pt-slot__btn-icon { font-size: 0.95rem; line-height: 1; }
  .pt-slot__btn-lbl {
    font-size: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  /* ── Fit sub-panel ── */
  .pt-slot__fit-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    padding: 5px;
    border: 1px solid #444;
    border-top: none;
    border-radius: 0 0 4px 4px;
    background: #1a1a1a;
  }
  .pt-slot__fit-opt {
    flex: 1 1 auto;
    font-size: 0.6rem;
    padding: 4px 6px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    color: var(--color-muted);
    cursor: pointer;
    text-align: center;
    white-space: nowrap;
  }
  .pt-slot__fit-opt:hover { color: #fff; border-color: var(--color-accent); }

  /* ── CSS tooltips (mouse hover only) ── */
  [data-tooltip] { position: relative; }
  [data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 5px);
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.88);
    color: #fff;
    font-size: 0.62rem;
    padding: 3px 7px;
    border-radius: 3px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.12s;
    z-index: 200;
  }
  [data-tooltip]:hover::after { opacity: 1; }

  /* ── Mobile: full-width stacked slots ── */
  /* ── RATIO button active state ── */
  .pt-slot__btn--fit.ratio-active {
    color: #e07b54;
  }
  /* ── BACK button active state ── */
  .pt-slot__btn--back:not([disabled]) {
    color: #7bbce0;
  }

  /* ── Mobile: full-width stacked slots ── */
  @media (max-width: 540px) {
    .pt-slots { flex-direction: column; }
    .pt-slot { max-width: 100%; flex: 1 1 100%; }
  }

  /* Params bar (above canvas) */
  #pt-params {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    align-items: flex-end;
    width: 100%;
    margin-top: var(--space-xs);
  }

  #pt-params .pt-field {
    flex: 0 0 160px;
    min-width: 120px;
  }

  #pt-params .pt-check-field {
    flex: 0 0 auto;
    padding-bottom: 2px;
  }

  #pt-params .pt-divider {
    display: none;
  }

  /* Slider + number input row */
  .pt-range-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pt-range-row .pt-range {
    flex: 1;
    min-width: 0;
  }

  .pt-num-input {
    width: 48px;
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 2px 4px;
    font-size: 0.72rem;
    font-family: var(--font-mono, monospace);
    text-align: right;
    flex-shrink: 0;
  }

  .pt-num-input::-webkit-inner-spin-button,
  .pt-num-input::-webkit-outer-spin-button { -webkit-appearance: none; }
  .pt-num-input { -moz-appearance: textfield; }

  #pt-stencil-params {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
