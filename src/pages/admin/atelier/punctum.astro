        }, buildParams: buildHalftoneCurvyscreenParams, getParams: getHalftoneCurvyscreenParams, setParams: setHalftoneCurvyscreenParams, onReroll: onRerollHalftoneCurvyscreen },
      'kaleidoscope-halftone': { label: 'Kaleidoscope Halftone', desc: "Two images kaleidoscoped into mandala patterns — radial symmetry folding their surfaces into repeating wedges — then a third image's halftone dot screen composites them.", inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
