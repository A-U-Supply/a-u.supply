    }

    // ─── Displacement ─────────────────────────────────────────────────────────

    function renderDisplacement(imgs: (HTMLImageElement | null)[], params: Record<string, any>, _rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2]) return [];
      const W = imgs[0].naturalWidth, H = imgs[0].naturalHeight;
      const strength = params['disp-strength'] ?? 80;
      const blurSigma = params['disp-blur'] ?? 2;
      const { bias, contrast, invert } = getStencilParams();

      const pixelData = [imgs[0]!, imgs[1]!, imgs[2]!].map(img => {
        const tmp = new OffscreenCanvas(W, H);
        tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
        return tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
      });

      const gradFields = pixelData.map(pd => {
        const blurred = blurSigma > 0 ? applyBlur(pd as Uint8ClampedArray, W, H, blurSigma) : pd as Uint8ClampedArray;
        const { gx, gy, mag } = sobelGradients(blurred, W, H);
        const p99 = histPercentile(mag, 0.99) + 1e-6;
        const gxN = new Float32Array(W * H), gyN = new Float32Array(W * H);
        for (let i = 0; i < W * H; i++) { gxN[i] = gx[i] / p99; gyN[i] = gy[i] / p99; }
        return { gxN, gyN };
      });

      return STENCIL_PERMS.map(([s, a, b]) => {
        const { gxN, gyN } = gradFields[s];
        const sData = pixelData[s], aData = pixelData[a], bData = pixelData[b];
        // Warp stencil at 0.5× strength, apply contrast
        const dispGray = new Float32Array(W * H);
        for (let j = 0; j < W * H; j++) {
          const x = j % W, y = Math.floor(j / W);
          const [rv, gv, bv2] = bilinearSample(sData, W, H, x + gxN[j]*strength*0.5, y + gyN[j]*strength*0.5, false);
          const raw = 0.299*rv + 0.587*gv + 0.114*bv2;
          dispGray[j] = Math.max(0, Math.min(255, 128 + (raw - 128) * contrast));
        }
        // Inline Otsu on dispGray + bias shift
        const hist = new Float32Array(256);
        for (let j = 0; j < W * H; j++) hist[Math.round(dispGray[j])]++;
        const total = W * H;
        let sum = 0; for (let t = 0; t < 256; t++) sum += t * hist[t];
        let sumB = 0, wB = 0, thresh = 128, maxVar = 0;
        for (let t = 0; t < 256; t++) {
          wB += hist[t]; if (wB === 0) continue;
          const wF = total - wB; if (wF === 0) break;
          sumB += t * hist[t];
          const v = wB * wF * ((sumB / wB) - (sum - sumB) / wF) ** 2;
          if (v > maxVar) { maxVar = v; thresh = t; }
        }
        thresh = Math.max(0, Math.min(255, thresh + bias));
        // Composite fills displaced at 1.5× strength
        const oc = new OffscreenCanvas(W, H);
        const od = oc.getContext('2d')!.createImageData(W, H);
        for (let j = 0; j < W * H; j++) {
          const x = j % W, y = Math.floor(j / W);
          const sx = gxN[j]*strength*1.5, sy = gyN[j]*strength*1.5;
          const [rA, gA, bA] = bilinearSample(aData, W, H, x - sx, y - sy, false);
          const [rB, gB, bB] = bilinearSample(bData, W, H, x + sx, y + sy, false);
          const above = dispGray[j] >= thresh;
          const useFillA = invert ? !above : above;
          od.data[j*4]   = useFillA ? rA : rB;
          od.data[j*4+1] = useFillA ? gA : gB;
          od.data[j*4+2] = useFillA ? bA : bB;
          od.data[j*4+3] = 255;
        }
        oc.getContext('2d')!.putImageData(od, 0, 0);
        return { canvas: ocToCanvas(oc), label: `S${s}·A${a}·B${b}`, mimeType: 'image/jpeg' };
      });
    }

    function buildDisplacementParams() {
      paramsEl.innerHTML = `
        <div class="pt-field">
          <label class="pt-label" for="disp-strength">Strength <span class="pt-val" id="disp-strength-val">80</span></label>
          <input class="pt-range" type="range" id="disp-strength" min="0" max="200" step="1" value="80" />
          <div class="pt-range-hints"><span>0</span><span>200</span></div>
