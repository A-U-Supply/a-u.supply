              <span class="pt-slot__lock-icon">🔓</span>
              <span class="pt-slot__btn-lbl">KEEP</span>
            </button>
          </div>
          <div class="pt-slot__drop" id="slot-drop-${i}" tabindex="0">
            <img class="pt-slot__thumb" id="slot-thumb-${i}" alt="${label}" />
            <div class="pt-slot__empty-icon" id="slot-empty-${i}">+</div>
            <input type="file" accept="image/*" style="display:none" id="slot-file-${i}" />
            <div class="pt-slot__kept-badge" id="slot-kept-badge-${i}" style="display:none">KEPT</div>
            <div class="pt-slot__spinner" id="slot-spinner-${i}" style="display:none"></div>
          </div>
          <div class="pt-slot__controls" id="slot-controls-${i}">
            <button class="pt-slot__btn pt-slot__btn--back" data-slot-back="${i}" disabled
              data-tooltip="Go back to previous image">
              <span class="pt-slot__btn-icon">←</span>
              <span class="pt-slot__btn-lbl">BACK</span>
            </button>
            <button class="pt-slot__btn" data-slot-lib="${i}"
              data-tooltip="Load from library">
              <span class="pt-slot__btn-icon">⊞</span>
              <span class="pt-slot__btn-lbl">IMG</span>
            </button>
            <button class="pt-slot__btn" data-slot-xform="${i}" data-xform="rotl" disabled
              data-tooltip="Rotate left 90°">
              <span class="pt-slot__btn-icon">↺</span>
              <span class="pt-slot__btn-lbl">ROTL</span>
            </button>
            <button class="pt-slot__btn" data-slot-xform="${i}" data-xform="rotr" disabled
              data-tooltip="Rotate right 90°">
              <span class="pt-slot__btn-icon">↻</span>
              <span class="pt-slot__btn-lbl">ROTR</span>
            </button>
            <button class="pt-slot__btn" data-slot-xform="${i}" data-xform="flip" disabled
              data-tooltip="Mirror horizontally">
              <span class="pt-slot__btn-icon">⇔</span>
              <span class="pt-slot__btn-lbl">FLIP</span>
            </button>
            <button class="pt-slot__btn pt-slot__btn--fit" data-slot-fit="${i}" disabled
              data-tooltip="Crop image to a fixed aspect ratio">
              <span class="pt-slot__btn-icon">⊡</span>
              <span class="pt-slot__btn-lbl">RATIO</span>
            </button>
          </div>
          <div class="pt-slot__fit-panel" id="slot-fit-panel-${i}" style="display:none"></div>
        </div>${swapBtn}`;
      }).join('');

      for (let i = 0; i < bot.inputs; i++) {
        const drop  = document.getElementById(`slot-drop-${i}`)!;
        const thumb = document.getElementById(`slot-thumb-${i}`) as HTMLImageElement;
        const empty = document.getElementById(`slot-empty-${i}`)!;
        const file  = document.getElementById(`slot-file-${i}`) as HTMLInputElement;
        const libBtn = slotsEl.querySelector(`[data-slot-lib="${i}"]`) as HTMLButtonElement;

        drop.addEventListener('click', (e) => {
          if ((e.target as Element).closest('button')) return;
          file.click();
        });
        drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('drag-over'); });
        drop.addEventListener('dragleave', () => drop.classList.remove('drag-over'));
        drop.addEventListener('drop', (e) => {
          e.preventDefault();
          drop.classList.remove('drag-over');
          const f = e.dataTransfer?.files[0];
          if (f && f.type.startsWith('image/')) loadSlotFromBlob(i, f);
        });
        file.addEventListener('change', () => {
          if (file.files?.[0]) loadSlotFromBlob(i, file.files[0]);
        });

        const slotIdx = i;
        const backBtn = slotsEl.querySelector(`[data-slot-back="${i}"]`) as HTMLButtonElement;
        backBtn.addEventListener('click', () => goSlotBack(slotIdx));
        updateSlotBackBtn(slotIdx);
        libBtn.addEventListener('click', () => openLibrary(slotIdx));

        slotsEl.querySelectorAll(`[data-slot-xform="${i}"]`).forEach(btn => {
          btn.addEventListener('click', () => {
            const xform = (btn as HTMLElement).dataset.xform!;
            const t = slotTransforms[slotIdx];
            if (xform === 'rotl') t.rot = (t.rot + 270) % 360;
            if (xform === 'rotr') t.rot = (t.rot + 90) % 360;
            if (xform === 'flip') t.flip = !t.flip;
            applyTransformAndUpdate(slotIdx).then(() => {
              if (allSlotsReady()) doRender();
            });
          });
        });

        // Lock button
        const lockBtn = slotsEl.querySelector(`[data-slot-lock="${i}"]`) as HTMLButtonElement;
        lockBtn.addEventListener('click', () => {
          slotLocked[slotIdx] = !slotLocked[slotIdx];
          const card = document.getElementById(`slot-card-${slotIdx}`)!;
          card.classList.toggle('locked', slotLocked[slotIdx]);
          const badge = document.getElementById(`slot-kept-badge-${slotIdx}`)!;
          badge.style.display = slotLocked[slotIdx] && sourceImgs[slotIdx] ? 'block' : 'none';
          lockBtn.querySelector('.pt-slot__btn-lbl')!.textContent = slotLocked[slotIdx] ? 'KEPT' : 'KEEP';
          lockBtn.querySelector('.pt-slot__lock-icon')!.textContent = slotLocked[slotIdx] ? '🔒' : '🔓';
        });

        // RATIO button
        function gcd(a: number, b: number): number { return b === 0 ? a : gcd(b, a % b); }
        function approxRatio(w: number, h: number): string {
          const d = gcd(w, h);
          const rw = w / d, rh = h / d;
          if (rw <= 16 && rh <= 16) return `${rw}:${rh}`;
          return `${(w / h).toFixed(2)}`;
        }
        const fitBtn = slotsEl.querySelector(`[data-slot-fit="${i}"]`) as HTMLButtonElement;
        fitBtn.addEventListener('click', () => {
          const panel = document.getElementById(`slot-fit-panel-${slotIdx}`)!;
          if (panel.style.display !== 'none') { panel.style.display = 'none'; return; }
          panel.innerHTML = '';

          // Off — clears ratio
          const offBtn = document.createElement('button');
          offBtn.className = 'pt-slot__fit-opt';
          offBtn.textContent = 'Off';
          offBtn.addEventListener('click', () => {
            delete slotTransforms[slotIdx].aspect;
            applyTransformAndUpdate(slotIdx).then(() => { if (allSlotsReady()) doRender(); });
            fitBtn.classList.remove('ratio-active');
            fitBtn.querySelector('.pt-slot__btn-lbl')!.textContent = 'RATIO';
            panel.style.display = 'none';
          });
          panel.appendChild(offBtn);

          // Square · 1:1
          const squareBtn = document.createElement('button');
          squareBtn.className = 'pt-slot__fit-opt';
          squareBtn.textContent = 'Square · 1:1';
          squareBtn.addEventListener('click', () => {
            slotTransforms[slotIdx].aspect = 1;
            applyTransformAndUpdate(slotIdx).then(() => { if (allSlotsReady()) doRender(); });
            fitBtn.classList.add('ratio-active');
            fitBtn.querySelector('.pt-slot__btn-lbl')!.textContent = 'RATIO·ON';
            panel.style.display = 'none';
          });
          panel.appendChild(squareBtn);

          // Match other loaded slots
          for (let j = 0; j < BOTS[currentBot].inputs; j++) {
            if (j === slotIdx || !effectiveImgs[j]) continue;
            const img = effectiveImgs[j]!;
            const ratio = img.naturalWidth / img.naturalHeight;
            const matchBtn = document.createElement('button');
            matchBtn.className = 'pt-slot__fit-opt';
            matchBtn.textContent = `Slot ${j + 1} · ${approxRatio(img.naturalWidth, img.naturalHeight)}`;
            matchBtn.addEventListener('click', () => {
              slotTransforms[slotIdx].aspect = ratio;
              applyTransformAndUpdate(slotIdx).then(() => { if (allSlotsReady()) doRender(); });
              fitBtn.classList.add('ratio-active');
              fitBtn.querySelector('.pt-slot__btn-lbl')!.textContent = 'RATIO·ON';
              panel.style.display = 'none';
            });
            panel.appendChild(matchBtn);
          }
          panel.style.display = 'flex';
        });

        // Restore any already-loaded image for this slot (after bot switch with same n)
        if (sourceImgs[i]) {
          thumb.src = effectiveImgs[i]?.src ?? sourceImgs[i]!.src;
          thumb.style.display = 'block';
          empty.style.display = 'none';
          updateXformButtons(i);
        }
        // Restore lock visual if slot was locked before bot switch
        if (slotLocked[i]) {
          const card = document.getElementById(`slot-card-${i}`)!;
          card.classList.add('locked');
          document.getElementById(`slot-kept-badge-${i}`)!.style.display = sourceImgs[i] ? 'block' : 'none';
          lockBtn.querySelector('.pt-slot__btn-lbl')!.textContent = 'KEPT';
          lockBtn.querySelector('.pt-slot__lock-icon')!.textContent = '🔒';
        }
      }

      // Wire swap buttons (between adjacent slots)
      slotsEl.querySelectorAll('.pt-slot-swap').forEach(btn => {
        const a = parseInt((btn as HTMLElement).dataset.swapA!);
        const b = parseInt((btn as HTMLElement).dataset.swapB!);
        btn.addEventListener('click', () => swapSlots(a, b));
      });
    }

