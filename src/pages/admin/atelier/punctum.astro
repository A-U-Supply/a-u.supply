      if (p['jou-scale'] != null) { (document.getElementById('jou-scale') as HTMLInputElement).value = String(p['jou-scale']); document.getElementById('jou-scale-val')!.textContent = parseFloat(p['jou-scale']).toFixed(1); }
      if (p['jou-shift-r'] != null) { (document.getElementById('jou-shift-r') as HTMLInputElement).value = String(p['jou-shift-r']); document.getElementById('jou-shift-r-val')!.textContent = parseFloat(p['jou-shift-r']).toFixed(2); }
      if (p['jou-shift-i'] != null) { (document.getElementById('jou-shift-i') as HTMLInputElement).value = String(p['jou-shift-i']); document.getElementById('jou-shift-i-val')!.textContent = parseFloat(p['jou-shift-i']).toFixed(2); }
