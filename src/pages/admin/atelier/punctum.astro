<script>
  document.addEventListener('astro:page-load', () => {

    // ─── Elements ─────────────────────────────────────────────────────────────
    const botSelect   = document.getElementById('bot-select') as HTMLSelectElement;
    const stageCanvas = document.getElementById('pt-canvas') as HTMLCanvasElement;
    const emptyEl     = document.getElementById('pt-empty') as HTMLDivElement;
    const emptyText   = document.getElementById('pt-empty-text') as HTMLDivElement;
    const slotsEl     = document.getElementById('pt-slots') as HTMLDivElement;
    const paramsEl        = document.getElementById('pt-params') as HTMLDivElement;
    const stencilParamsEl = document.getElementById('pt-stencil-params') as HTMLDivElement;
    const processingEl       = document.getElementById('pt-processing') as HTMLDivElement;
    const processingStatusEl = document.getElementById('pt-processing-status') as HTMLSpanElement;
    const processingJobLinkEl = document.getElementById('pt-processing-job-link') as HTMLAnchorElement;
    const processingCancelEl = document.getElementById('pt-processing-cancel') as HTMLButtonElement;
    const runBtn             = document.getElementById('run-btn') as HTMLButtonElement;
    let cancelCurrentJob: (() => Promise<void>) | null = null;
    const stripEl     = document.getElementById('pt-strip') as HTMLDivElement;
    const rerollBtn   = document.getElementById('reroll-btn') as HTMLButtonElement;
    const seedInput   = document.getElementById('seed-input') as HTMLInputElement;
    const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
    const saveBtn     = document.getElementById('save-btn') as HTMLButtonElement;
    const saveAllBtn  = document.getElementById('save-all-btn') as HTMLButtonElement;
    const savePngBtn  = document.getElementById('save-png-btn') as HTMLButtonElement;
    const libraryOverlay    = document.getElementById('library-overlay')     as HTMLDivElement;
    const libraryClose      = document.getElementById('library-close')        as HTMLButtonElement;
    const librarySearch     = document.getElementById('library-search')       as HTMLInputElement;
    const libraryGrid       = document.getElementById('library-grid')         as HTMLDivElement;
    const libTabInputs      = document.getElementById('lib-tab-inputs')       as HTMLButtonElement;
    const libTabOutputs     = document.getElementById('lib-tab-outputs')      as HTMLButtonElement;
    const libTabWorkspace   = document.getElementById('lib-tab-workspace')    as HTMLButtonElement;
    const libTabRandInputs  = document.getElementById('lib-tab-rand-inputs')  as HTMLButtonElement;
    const libTabRandOutputs = document.getElementById('lib-tab-rand-outputs') as HTMLButtonElement;
    const libraryShuffleBtn = document.getElementById('library-shuffle')      as HTMLButtonElement;
    const libraryUploadBtn  = document.getElementById('library-upload-btn')   as HTMLButtonElement;
    const libraryUploadFile = document.getElementById('library-upload-file')  as HTMLInputElement;

    // ─── Seeded PRNG (mulberry32) ──────────────────────────────────────────────
    function mulberry32(seed: number): () => number {
      return function() {
        seed |= 0; seed = seed + 0x6D2B79F5 | 0;
        let t = Math.imul(seed ^ seed >>> 15, 1 | seed);
        t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
        return ((t ^ t >>> 14) >>> 0) / 4294967296;
      };
    }

    // ─── Canvas helpers ────────────────────────────────────────────────────────

    function otsuThreshold(imgData: ImageData): number {
      const hist = new Int32Array(256);
      const total = imgData.width * imgData.height;
      for (let i = 0; i < imgData.data.length; i += 4) {
        const g = Math.round(0.299 * imgData.data[i] + 0.587 * imgData.data[i+1] + 0.114 * imgData.data[i+2]);
        hist[g]++;
      }
      let sum = 0;
      for (let i = 0; i < 256; i++) sum += i * hist[i];
      let sumB = 0, wB = 0, maxVar = 0, thresh = 128;
      for (let t = 0; t < 256; t++) {
        wB += hist[t];
        if (wB === 0) continue;
        const wF = total - wB;
        if (wF === 0) break;
        sumB += t * hist[t];
        const mB = sumB / wB;
        const mF = (sum - sumB) / wF;
        const v = wB * wF * (mB - mF) ** 2;
        if (v > maxVar) { maxVar = v; thresh = t; }
      }
      return thresh;
    }

    function stencilCompose(
      dest: OffscreenCanvas,
      stencil: HTMLImageElement | OffscreenCanvas,
      fillA: OffscreenCanvas | HTMLImageElement,
      fillB: OffscreenCanvas | HTMLImageElement,
    ) {
      const W = dest.width, H = dest.height;
      const ctx = dest.getContext('2d')!;
      const { bias, contrast, invert } = getStencilParams();

      // Get stencil pixel data
      const sc = new OffscreenCanvas(W, H);
      sc.getContext('2d')!.drawImage(stencil as any, 0, 0, W, H);
      const stencilData = sc.getContext('2d')!.getImageData(0, 0, W, H);

      // Apply contrast around mid-grey and compute adjusted grayscale
      const adjGray = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) {
        const j = i * 4;
        const g = 0.299 * stencilData.data[j] + 0.587 * stencilData.data[j+1] + 0.114 * stencilData.data[j+2];
        adjGray[i] = Math.max(0, Math.min(255, 128 + (g - 128) * contrast));
      }

      // Build Otsu threshold on contrast-adjusted values + apply bias
      const adjId = new ImageData(W, H);
      for (let i = 0; i < W * H; i++) {
        adjId.data[i*4] = adjId.data[i*4+1] = adjId.data[i*4+2] = adjGray[i]; adjId.data[i*4+3] = 255;
      }
      const thresh = Math.max(0, Math.min(255, otsuThreshold(adjId) + bias));

      // Get fillA pixel data
      const ac = new OffscreenCanvas(W, H);
      ac.getContext('2d')!.drawImage(fillA as any, 0, 0, W, H);
      const aData = ac.getContext('2d')!.getImageData(0, 0, W, H);

      // Get fillB pixel data
      const bc = new OffscreenCanvas(W, H);
      bc.getContext('2d')!.drawImage(fillB as any, 0, 0, W, H);
      const bData = bc.getContext('2d')!.getImageData(0, 0, W, H);

      const out = ctx.createImageData(W, H);
      const ad = aData.data, bd = bData.data, od = out.data;
      for (let i = 0; i < W * H; i++) {
        const g = adjGray[i];
        const useA = invert ? g < thresh : g >= thresh;
        const src = useA ? ad : bd;
        const j = i * 4;
        od[j] = src[j]; od[j+1] = src[j+1]; od[j+2] = src[j+2]; od[j+3] = 255;
      }
      ctx.putImageData(out, 0, 0);
    }

    // ─── Stencil adjustment helpers ────────────────────────────────────────────

    function getStencilParams() {
      return {
        bias:     parseInt((document.getElementById('st-bias') as HTMLInputElement)?.value ?? '0', 10),
        contrast: parseFloat((document.getElementById('st-contrast') as HTMLInputElement)?.value ?? '1'),
        invert:   (document.getElementById('st-invert') as HTMLInputElement)?.checked ?? false,
      };
    }

    function stencilBinarize(img: HTMLImageElement | OffscreenCanvas | HTMLCanvasElement, W: number, H: number): OffscreenCanvas {
      const { bias, contrast, invert } = getStencilParams();
      const oc = new OffscreenCanvas(W, H);
      const ctx = oc.getContext('2d')!;
      ctx.drawImage(img as any, 0, 0, W, H);
      const id = ctx.getImageData(0, 0, W, H);
      const adj = new Uint8ClampedArray(id.data.length);
      for (let i = 0; i < id.data.length; i += 4) {
        const g = Math.max(0, Math.min(255, 128 + (0.299*id.data[i] + 0.587*id.data[i+1] + 0.114*id.data[i+2] - 128) * contrast));
        adj[i] = adj[i+1] = adj[i+2] = g; adj[i+3] = 255;
      }
      const thresh = Math.max(0, Math.min(255, otsuThreshold(new ImageData(adj, W, H)) + bias));
      for (let i = 0; i < id.data.length; i += 4) {
        let v = adj[i] >= thresh ? 255 : 0;
        if (invert) v = 255 - v;
        id.data[i] = id.data[i+1] = id.data[i+2] = v; id.data[i+3] = 255;
      }
      ctx.putImageData(id, 0, 0);
      return oc;
    }

    function appendStencilOutputs() {
      const bot = BOTS[currentBot];
      const labels = ['A', 'B', 'C', 'D'];

      // BW output versions: non-stencil bots without native BW outputs
      if (!bot.isStencil && !bot.hasNativeBW) {
        const baseOutputs = outputs.slice();
        for (const out of baseOutputs) {
          const W = out.canvas.width, H = out.canvas.height;
          outputs.push({ canvas: ocToCanvas(stencilBinarize(out.canvas, W, H)), label: `BW·${out.label}`, mimeType: 'image/png' });
        }
      }

      // Source stencils: isStencil bots only — binarize each input slot image
      if (bot.isStencil) {
        for (let i = 0; i < bot.inputs; i++) {
          const img = effectiveImgs[i];
          if (!img) continue;
          const W = img.naturalWidth, H = img.naturalHeight;
          outputs.push({ canvas: ocToCanvas(stencilBinarize(img, W, H)), label: `Stencil ${labels[i]}`, mimeType: 'image/png' });
        }
      }
    }

    function mapPixels(
      oc: OffscreenCanvas,
      fn: (r: number, g: number, b: number, a: number) => [number, number, number, number],
    ) {
      const ctx = oc.getContext('2d')!;
      const id = ctx.getImageData(0, 0, oc.width, oc.height);
      const d = id.data;
      for (let i = 0; i < d.length; i += 4) {
        const [r, g, b, a] = fn(d[i], d[i+1], d[i+2], d[i+3]);
        d[i] = r; d[i+1] = g; d[i+2] = b; d[i+3] = a;
      }
      ctx.putImageData(id, 0, 0);
    }

    function buildLUT(points: [number, number][]): Uint8Array {
      const lut = new Uint8Array(256);
      for (let x = 0; x < 256; x++) {
        if (x <= points[0][0]) { lut[x] = points[0][1]; continue; }
        if (x >= points[points.length - 1][0]) { lut[x] = points[points.length - 1][1]; continue; }
        let i = 0;
        while (i < points.length - 2 && points[i + 1][0] <= x) i++;
        const [x0, y0] = points[i], [x1, y1] = points[i + 1];
        lut[x] = Math.round(y0 + (y1 - y0) * (x - x0) / (x1 - x0));
      }
      return lut;
    }

    function ocToCanvas(oc: OffscreenCanvas): HTMLCanvasElement {
      const c = document.createElement('canvas');
      c.width = oc.width; c.height = oc.height;
      c.getContext('2d')!.drawImage(oc, 0, 0);
      return c;
    }

    function otsuBinary(src: OffscreenCanvas, W: number, H: number): HTMLCanvasElement {
      const tmp = new OffscreenCanvas(W, H);
      tmp.getContext('2d')!.drawImage(src, 0, 0, W, H);
      const id = tmp.getContext('2d')!.getImageData(0, 0, W, H);
      const thresh = otsuThreshold(id);
      const out = tmp.getContext('2d')!.createImageData(W, H);
      for (let i = 0; i < id.data.length; i += 4) {
        const g = Math.round(0.299 * id.data[i] + 0.587 * id.data[i+1] + 0.114 * id.data[i+2]);
        const v = g >= thresh ? 255 : 0;
        out.data[i] = out.data[i+1] = out.data[i+2] = v; out.data[i+3] = 255;
      }
      tmp.getContext('2d')!.putImageData(out, 0, 0);
      return ocToCanvas(tmp);
    }

    function bullseyeCenters(W: number, H: number, r1: number, rng: () => number): [number, number][] {
      const short = Math.min(W, H), longDim = Math.max(W, H);
      const cell = short, margin = Math.floor(short / 2) - r1;
      const n = Math.max(1, Math.floor(longDim / cell));
      const first = rng() < 0.5
        ? r1 + margin
        : (longDim - r1 - margin) - (n - 1) * cell;
      const centers: [number, number][] = [];
      for (let i = 0; i < n; i++) {
        const longPos = first + i * cell;
        centers.push(W <= H ? [Math.floor(W / 2), longPos] : [longPos, Math.floor(H / 2)]);
      }
      return centers;
    }

    function piecewiseLerp(xs: number[], ys: number[], v: number): number {
      if (v <= xs[0]) return ys[0];
      if (v >= xs[xs.length-1]) return ys[ys.length-1];
      let i = 0;
      while (i < xs.length-2 && xs[i+1] <= v) i++;
      return ys[i] + (ys[i+1]-ys[i]) * (v-xs[i]) / (xs[i+1]-xs[i]);
    }

    // O(n) percentile via 256-bucket histogram.
    // Replaces Array.from(data).sort() for single-percentile lookups — O(n log n) → O(n).
    // Accurate to within (max-min)/256 of the true value, which is imperceptible for
    // normalisation thresholds. Revert to the sort-based version if output changes.
    function histPercentile(data: Float32Array | Uint8Array, p: number): number {
      const n = data.length;
      if (n === 0) return 0;
      let lo = data[0], hi = data[0];
      for (let i = 1; i < n; i++) {
        if (data[i] < lo) lo = data[i];
        if (data[i] > hi) hi = data[i];
      }
      if (hi === lo) return lo;
      const range = hi - lo;
      const buckets = new Int32Array(256);
      const scale = 255 / range;
      for (let i = 0; i < n; i++) buckets[((data[i] - lo) * scale + 0.5) | 0]++;
      const target = Math.floor(n * p);
      let cum = 0;
      for (let b = 0; b < 256; b++) {
        cum += buckets[b];
        if (cum > target) return lo + (b / 255) * range;
      }
      return hi;
    }

    function applyBlur(pixels: Uint8ClampedArray, W: number, H: number, sigma: number): Uint8ClampedArray {
      const src = new OffscreenCanvas(W, H);
      const id = src.getContext('2d')!.createImageData(W, H);
      id.data.set(pixels);
      src.getContext('2d')!.putImageData(id, 0, 0);
      const dst = new OffscreenCanvas(W, H);
      const ctx = dst.getContext('2d')!;
      ctx.filter = `blur(${sigma}px)`;
      ctx.drawImage(src, 0, 0);
      return dst.getContext('2d')!.getImageData(0, 0, W, H).data;
    }

    // ─── Shared pixel helpers ────────────────────────────────────────────────────

    function bilinearSample(data: Uint8ClampedArray, W: number, H: number, x: number, y: number, wrap = false): [number, number, number] {
      if (wrap) { x = ((x % W) + W) % W; y = ((y % H) + H) % H; }
      else { x = Math.max(0, Math.min(W - 1.001, x)); y = Math.max(0, Math.min(H - 1.001, y)); }
      const x0 = Math.floor(x), y0 = Math.floor(y);
      const x1 = wrap ? (x0 + 1) % W : Math.min(x0 + 1, W - 1);
      const y1 = wrap ? (y0 + 1) % H : Math.min(y0 + 1, H - 1);
      const fx = x - x0, fy = y - y0;
      const w00 = (1-fx)*(1-fy), w10 = fx*(1-fy), w01 = (1-fx)*fy, w11 = fx*fy;
      const i00=(y0*W+x0)*4, i10=(y0*W+x1)*4, i01=(y1*W+x0)*4, i11=(y1*W+x1)*4;
      return [
        data[i00]*w00+data[i10]*w10+data[i01]*w01+data[i11]*w11,
        data[i00+1]*w00+data[i10+1]*w10+data[i01+1]*w01+data[i11+1]*w11,
        data[i00+2]*w00+data[i10+2]*w10+data[i01+2]*w01+data[i11+2]*w11,
      ];
    }

    function sobelGradients(data: Uint8ClampedArray, W: number, H: number): { gx: Float32Array; gy: Float32Array; mag: Float32Array } {
      const n = W * H;
      const gray = new Float32Array(n);
      for (let i = 0; i < n; i++) gray[i] = 0.299*data[i*4] + 0.587*data[i*4+1] + 0.114*data[i*4+2];
      const gx = new Float32Array(n), gy = new Float32Array(n), mag = new Float32Array(n);
      for (let y = 1; y < H-1; y++) {
        for (let x = 1; x < W-1; x++) {
          const tl=gray[(y-1)*W+(x-1)], tc=gray[(y-1)*W+x], tr=gray[(y-1)*W+(x+1)];
          const ml=gray[y*W+(x-1)],                          mr=gray[y*W+(x+1)];
          const bl=gray[(y+1)*W+(x-1)], bc2=gray[(y+1)*W+x], br=gray[(y+1)*W+(x+1)];
          const sx = -tl+tr - 2*ml+2*mr - bl+br;
          const sy = -tl-2*tc-tr + bl+2*bc2+br;
          const idx = y*W+x;
          gx[idx] = sx; gy[idx] = sy; mag[idx] = Math.sqrt(sx*sx+sy*sy);
        }
      }
      return { gx, gy, mag };
    }

    // Reuse OffscreenCanvas pair across applyBlur calls — creating two OffscreenCanvases
    // per call was causing 12+ canvas-pair allocations per render in multi-blur bots
    // (Oil Spiral 4×, Soapy Spiral 4×, Curvy Lines 2×, Spiral Screen 2×).
    // Revert this block if blur output looks wrong across different-sized renders.
    let _blurSrc: OffscreenCanvas | null = null;
    let _blurDst: OffscreenCanvas | null = null;
    let _blurCW = 0, _blurCH = 0;
    // Reuse input pixel scratch buffer across blurFloat calls (avoids ~8MB alloc × 12/render).
    let _blurScratch: Uint8ClampedArray | null = null;

    function applyBlur(pixels: Uint8ClampedArray, W: number, H: number, sigma: number): Uint8ClampedArray {
      if (!_blurSrc || _blurCW !== W || _blurCH !== H) {
        _blurSrc = new OffscreenCanvas(W, H);
        _blurDst = new OffscreenCanvas(W, H);
        _blurCW = W; _blurCH = H;
      }
      _blurSrc.getContext('2d')!.putImageData(new ImageData(pixels, W, H), 0, 0);
      const ctx = _blurDst!.getContext('2d')!;
      ctx.clearRect(0, 0, W, H);
      ctx.filter = `blur(${sigma}px)`;
      ctx.drawImage(_blurSrc, 0, 0);
      ctx.filter = 'none';
      return ctx.getImageData(0, 0, W, H).data;
    }

    function blurFloat(data: Float32Array, W: number, H: number, sigma: number): Float32Array {
      const n = W * H;
      let minVal = data[0], maxVal = data[0];
      for (let i = 1; i < n; i++) { if (data[i] < minVal) minVal = data[i]; if (data[i] > maxVal) maxVal = data[i]; }
      const range = maxVal - minVal;
      if (range < 1e-10) { const r = new Float32Array(n); r.fill(minVal); return r; }
      if (!_blurScratch || _blurScratch.length < n * 4) _blurScratch = new Uint8ClampedArray(n * 4);
      const px = _blurScratch;
      for (let i = 0; i < n; i++) {
        const v = Math.round((data[i] - minVal) / range * 255);
        px[i*4] = px[i*4+1] = px[i*4+2] = v; px[i*4+3] = 255;
      }
      const bl = applyBlur(px, W, H, sigma);
      const result = new Float32Array(n);
      for (let i = 0; i < n; i++) result[i] = minVal + (bl[i*4] / 255) * range;
      return result;
    }

    // ─── Bot render functions ──────────────────────────────────────────────────

    type Output = { canvas: HTMLCanvasElement; label: string; mimeType: string };

    function renderBullethole(imgs: (HTMLImageElement | null)[], params: Record<string, any>, rng: () => number): Output[] {
      const img = imgs[0];
      if (!img) return [];
      const W = img.naturalWidth, H = img.naturalHeight;
      const chaos     = params.chaos     ?? 0.5;
      const placement = params.placement ?? 'random';
      const effect    = params.effect    ?? 'rotate';
      const jitter    = params.jitter    ?? 0;
      const noOverlap = params.no_overlap ?? false;

      function removeOverlap(centers: [number,number][], r: number): [number,number][] {
        const kept: [number,number][] = [];
        const d2 = (r * 2) ** 2;
        for (const [cx,cy] of centers) {
          if (!kept.some(([ox,oy]) => (cx-ox)**2+(cy-oy)**2 < d2)) kept.push([cx,cy]);
        }
        return kept;
      }

      function placeRandom(n: number, w: number, h: number, r: number): [number,number][] {
        const cs: [number,number][] = [];
        const d2 = (r * 2) ** 2;
        for (let i = 0; i < n; i++) {
          if (noOverlap) {
            for (let a = 0; a < 100; a++) {
              const cx = r + rng() * (w - r * 2);
              const cy = r + rng() * (h - r * 2);
              if (!cs.some(([ox,oy]) => (cx-ox)**2+(cy-oy)**2 < d2)) { cs.push([cx,cy]); break; }
            }
          } else {
            cs.push([r + rng() * (w - r * 2), r + rng() * (h - r * 2)]);
          }
        }
        return cs;
      }

      function placeGrid(n: number, w: number, h: number, r: number, hex: boolean): [number,number][] {
        const cols = Math.max(1, Math.round(Math.sqrt(n * w / h)));
        const rows = Math.max(1, Math.ceil(n / cols));
        const cw = w / cols, ch = h / rows;
        const cs: [number,number][] = [];
        for (let row = 0; row < rows; row++) {
          for (let col = 0; col < cols; col++) {
            if (cs.length >= n) break;
            let cx = cw * (col + 0.5), cy = ch * (row + 0.5);
            if (hex && row % 2 === 1) cx += cw * 0.5;
            if (jitter > 0) {
              cx += (rng() * 2 - 1) * cw * jitter * 0.5;
              cy += (rng() * 2 - 1) * ch * jitter * 0.5;
            }
            cs.push([Math.max(r, Math.min(w - r, cx)), Math.max(r, Math.min(h - r, cy))]);
          }
        }
        return cs;
      }

      function placeRadial(n: number, w: number, h: number, r: number): [number,number][] {
        const cx0 = w / 2, cy0 = h / 2;
        const maxD = Math.min(cx0, cy0) - r;
        if (maxD <= 0 || n <= 1) return Array(n).fill([cx0, cy0]);
        const numRings = Math.max(1, Math.round(Math.sqrt(n)));
        const ringR = Array.from({length: numRings}, (_, i) => maxD * (i + 1) / numRings);
        const totalR = ringR.reduce((a, b) => a + b, 0);
        const counts: number[] = [];
        let rem = n;
        for (let i = 0; i < numRings; i++) {
          if (i === numRings - 1) { counts.push(rem); break; }
          const c = Math.max(1, Math.round(n * ringR[i] / totalR));
          counts.push(c); rem -= c;
        }
        const cs: [number,number][] = [];
        for (let i = 0; i < numRings; i++) {
          for (let k = 0; k < counts[i]; k++) {
            let angle = 2 * Math.PI * k / counts[i];
            let dist = ringR[i];
            if (jitter > 0) {
              angle += (rng() * 2 - 1) * Math.PI / counts[i] * jitter;
              dist += (rng() * 2 - 1) * (maxD / numRings) * jitter * 0.5;
              dist = Math.max(r, Math.min(maxD, dist));
            }
            cs.push([
              Math.max(r, Math.min(w - r, cx0 + dist * Math.cos(angle))),
              Math.max(r, Math.min(h - r, cy0 + dist * Math.sin(angle))),
            ]);
          }
        }
        return cs.slice(0, n);
      }

      const n = Math.max(2, Math.round(2 + chaos * 84 + (rng() * 2 - 1)));
      const frac = 0.33 + (0.05 - 0.33) * chaos;
      const maxR = Math.max(4, Math.round(W * frac));
      const minR = Math.max(2, Math.round(maxR * 0.6));
      const radius = minR + Math.floor(rng() * (maxR - minR + 1));

      let centers: [number,number][];
      if (placement === 'grid')        centers = placeGrid(n, W, H, radius, false);
      else if (placement === 'hex')    centers = placeGrid(n, W, H, radius, true);
      else if (placement === 'radial') centers = placeRadial(n, W, H, radius);
      else                             centers = placeRandom(n, W, H, radius);
      if (noOverlap && placement !== 'random') centers = removeOverlap(centers, radius);

      const holes = centers.map(([cx, cy]) => ({ cx, cy, angle: rng() * 300 + 30 }));

      const oc = new OffscreenCanvas(W, H);
      const ctx = oc.getContext('2d')!;
      ctx.drawImage(img, 0, 0, W, H);

      for (const { cx, cy, angle } of holes) {
        ctx.save();
        ctx.beginPath();
        ctx.arc(cx, cy, radius, 0, Math.PI * 2);
        ctx.clip();
        switch (effect) {
          case 'rotate':
            ctx.translate(cx, cy); ctx.rotate(angle * Math.PI / 180); ctx.translate(-cx, -cy);
            ctx.drawImage(img, 0, 0, W, H); break;
          case 'invert':
            ctx.filter = 'invert(1)'; ctx.drawImage(img, 0, 0, W, H); ctx.filter = 'none'; break;
          case 'blur':
            ctx.filter = `blur(${Math.max(2, Math.floor(radius / 6))}px)`;
            ctx.drawImage(img, 0, 0, W, H); ctx.filter = 'none'; break;
          case 'grayscale':
            ctx.filter = 'grayscale(1)'; ctx.drawImage(img, 0, 0, W, H); ctx.filter = 'none'; break;
          case 'pixelate': {
            const block = Math.max(4, Math.floor(radius / 8));
            const tw = Math.max(1, Math.floor(W / block)), th = Math.max(1, Math.floor(H / block));
            const tmp = new OffscreenCanvas(tw, th);
            tmp.getContext('2d')!.drawImage(img, 0, 0, tw, th);
            ctx.imageSmoothingEnabled = false;
            ctx.drawImage(tmp, 0, 0, tw, th, 0, 0, W, H);
            ctx.imageSmoothingEnabled = true; break;
          }
          case 'fill_black': ctx.fillStyle = '#000'; ctx.fill(); break;
          case 'fill_white': ctx.fillStyle = '#fff'; ctx.fill(); break;
        }
        ctx.restore();
      }

      return [{ canvas: ocToCanvas(oc), label: 'Bullet Hole', mimeType: 'image/jpeg' }];
    }

    const STENCIL_PERMS: [number, number, number][] = [
      [0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0],
    ];

    function renderStencil(imgs: (HTMLImageElement | null)[], _params: Record<string, any>, _rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2]) return [];
      const W = imgs[0].naturalWidth, H = imgs[0].naturalHeight;
      return STENCIL_PERMS.map(([s, a, b]) => {
        const dest = new OffscreenCanvas(W, H);
        stencilCompose(dest, imgs[s]!, imgs[a]!, imgs[b]!);
        return { canvas: ocToCanvas(dest), label: `S${s}·A${a}·B${b}`, mimeType: 'image/jpeg' };
      });
    }

    function binarize(img: HTMLImageElement, W: number, H: number): OffscreenCanvas {
      return stencilBinarize(img, W, H);
    }

    function renderBW(imgs: (HTMLImageElement | null)[], _params: Record<string, any>, _rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2]) return [];
      const W = imgs[0].naturalWidth, H = imgs[0].naturalHeight;
      const bi = imgs.map(img => img ? binarize(img, W, H) : null) as OffscreenCanvas[];
      // For BW we treat each binarized image as a canvas that can be used as stencil/fill
      return STENCIL_PERMS.map(([s, a, b]) => {
        const dest = new OffscreenCanvas(W, H);
        // stencilCompose expects HTMLImageElement for stencil, but bi[s] is OffscreenCanvas
        // Use bi[s] as stencil by drawing it to a temp img-like canvas
        const ctx = dest.getContext('2d')!;
        ctx.drawImage(bi[s], 0, 0);
        const stencilData = ctx.getImageData(0, 0, W, H);
        const thresh = otsuThreshold(stencilData);
        const aData = bi[a].getContext('2d')!.getImageData(0, 0, W, H);
        const bData = bi[b].getContext('2d')!.getImageData(0, 0, W, H);
        const out = ctx.createImageData(W, H);
        const sd = stencilData.data, ad = aData.data, bd = bData.data, od = out.data;
        for (let i = 0; i < sd.length; i += 4) {
          const g = 0.299 * sd[i] + 0.587 * sd[i+1] + 0.114 * sd[i+2];
          const src = g >= thresh ? ad : bd;
          od[i] = src[i]; od[i+1] = src[i+1]; od[i+2] = src[i+2]; od[i+3] = 255;
        }
        ctx.putImageData(out, 0, 0);
        return { canvas: ocToCanvas(dest), label: `S${s}·A${a}·B${b}`, mimeType: 'image/jpeg' };
      });
    }

    function cyanotypeProcess(img: HTMLImageElement, W: number, H: number, rng: () => number): OffscreenCanvas {
      const tonalLUT = buildLUT([[0,0],[40,20],[128,120],[200,230],[255,255]]);
      const rLUT = buildLUT([[0,5],[64,20],[128,50],[200,130],[255,200]]);
      const gLUT = buildLUT([[0,30],[64,60],[128,120],[200,180],[255,220]]);
      const bLUT = buildLUT([[0,60],[64,110],[128,165],[200,210],[255,240]]);

      const oc = new OffscreenCanvas(W, H);
      const ctx = oc.getContext('2d')!;
      ctx.drawImage(img, 0, 0, W, H);

      // Grayscale + tonal curve
      mapPixels(oc, (r, g, b, a) => {
        const gray = tonalLUT[Math.round(0.299 * r + 0.587 * g + 0.114 * b)];
        return [gray, gray, gray, a];
      });

      // Highlight bloom: extract pixels > 180, blur, screen blend
      const bloom = new OffscreenCanvas(W, H);
      const bctx = bloom.getContext('2d')!;
      bctx.drawImage(oc, 0, 0);
      mapPixels(bloom, (r, g, b, a) => {
        return r > 180 ? [r, g, b, a] : [0, 0, 0, 0];
      });
      const bloomed = new OffscreenCanvas(W, H);
      const blmctx = bloomed.getContext('2d')!;
      blmctx.filter = 'blur(18px)';
      blmctx.drawImage(bloom, 0, 0);
      blmctx.filter = 'none';

      // Screen blend bloomed onto base
      const baseData = ctx.getImageData(0, 0, W, H);
      const bloomData = bloomed.getContext('2d')!.getImageData(0, 0, W, H);
      for (let i = 0; i < baseData.data.length; i += 4) {
        const ba = baseData.data[i] / 255;
        const bb = bloomData.data[i] / 255;
        baseData.data[i] = baseData.data[i+1] = baseData.data[i+2] =
          Math.round((1 - (1 - ba) * (1 - bb)) * 255);
      }
      ctx.putImageData(baseData, 0, 0);

      // Map gray to Prussian blue + grain
      mapPixels(oc, (r, _g, _b, a) => {
        const noiseR = (rng() - 0.5) * 20;
        const noiseG = (rng() - 0.5) * 20;
        const noiseB = (rng() - 0.5) * 10;
        return [
          Math.max(0, Math.min(255, rLUT[r] + noiseR)),
          Math.max(0, Math.min(255, gLUT[r] + noiseG)),
          Math.max(0, Math.min(255, bLUT[r] + noiseB)),
          a,
        ];
      });

      return oc;
    }

    function renderCyanotype(imgs: (HTMLImageElement | null)[], _params: Record<string, any>, rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2]) return [];
      const W = imgs[0].naturalWidth, H = imgs[0].naturalHeight;
      return STENCIL_PERMS.map(([s, a, b]) => {
        const processedA = cyanotypeProcess(imgs[a]!, W, H, rng);
        const processedB = cyanotypeProcess(imgs[b]!, W, H, rng);
        const dest = new OffscreenCanvas(W, H);
        stencilCompose(dest, imgs[s]!, processedA, processedB);
        return { canvas: ocToCanvas(dest), label: `S${s}·A${a}·B${b}`, mimeType: 'image/jpeg' };
      });
    }

    function renderWobbleeye(imgs: (HTMLImageElement | null)[], params: Record<string, any>, rng: () => number): Output[] {
      const img = imgs[0];
      if (!img) return [];
      const W = img.naturalWidth, H = img.naturalHeight;
      const N = Math.max(2, Math.min(10, params.rings ?? 5));

      const shortDim = Math.min(W, H);
      const outerRadius = shortDim * 0.46;
      const bandWidth = outerRadius / N;
      const isLandscape = W >= H;

      // Ring radii: index 0 = outermost
      const ringRadii = Array.from({ length: N }, (_, i) => outerRadius - i * bandWidth);

      // Outermost center: midpoint on short axis, random on long axis
      let cx0: number, cy0: number;
      if (isLandscape) {
        cy0 = H / 2;
        cx0 = outerRadius + rng() * (W - 2 * outerRadius);
      } else {
        cx0 = W / 2;
        cy0 = outerRadius + rng() * (H - 2 * outerRadius);
      }

      // Drifting centers
      const centers: [number, number][] = [[cx0, cy0]];
      for (let i = 1; i < N; i++) {
        const [px, py] = centers[i - 1];
        const drift = (0.85 + rng() * 0.10) * bandWidth;
        const angle = rng() * Math.PI * 2;
        centers.push([px + drift * Math.cos(angle), py + drift * Math.sin(angle)]);
      }

      const oc = new OffscreenCanvas(W, H);
      const ctx = oc.getContext('2d')!;
      ctx.drawImage(img, 0, 0, W, H);

      for (let i = 0; i < N; i++) {
        const r = ringRadii[i];
        const [cx, cy] = centers[i];
        const angle = (rng() * 300 + 30) * Math.PI / 180;

        const cap = new OffscreenCanvas(W, H);
        cap.getContext('2d')!.drawImage(oc, 0, 0);

        ctx.save();
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.clip();
        ctx.translate(cx, cy);
        ctx.rotate(angle);
        ctx.translate(-cx, -cy);
        ctx.drawImage(cap, 0, 0);
        ctx.restore();
      }

      return [{ canvas: ocToCanvas(oc), label: 'Wobble Eye', mimeType: 'image/jpeg' }];
    }

    function renderLathe(imgs: (HTMLImageElement | null)[], params: Record<string, any>, rng: () => number): Output[] {
      const img = imgs[0]; if (!img) return [];
      const W = img.naturalWidth, H = img.naturalHeight;
      const rings: number = params.rings ?? 80;
      const r1 = Math.floor(Math.max(W, H) * 0.46);
      const radii = Array.from({ length: rings }, (_, i) => Math.max(1, Math.floor(r1 * (rings - i) / rings)));
      const centers = bullseyeCenters(W, H, r1, rng);

      const oc = new OffscreenCanvas(W, H);
      const ctx = oc.getContext('2d')!;
      ctx.drawImage(img, 0, 0);

      for (const [cx, cy] of centers) {
        for (let i = 0; i < radii.length; i++) {
          const rOuter = radii[i];
          const rInner = i + 1 < radii.length ? radii[i + 1] : 0;
          const angle = rng() * (300 * Math.PI / 180) + (30 * Math.PI / 180);
          ctx.save();
          ctx.beginPath();
          ctx.arc(cx, cy, rOuter, 0, Math.PI * 2, false);
          if (rInner > 0) ctx.arc(cx, cy, rInner, 0, Math.PI * 2, true);
          ctx.clip('evenodd');
          ctx.translate(cx, cy);
          ctx.rotate(angle);
          ctx.drawImage(img, -cx, -cy);
          ctx.restore();
        }
      }

      return [
        { canvas: ocToCanvas(oc), label: 'Color', mimeType: 'image/png' },
        { canvas: otsuBinary(oc, W, H), label: 'BW', mimeType: 'image/png' },
      ];
    }

    function renderBullseye(imgs: (HTMLImageElement | null)[], params: Record<string, any>, rng: () => number): Output[] {
      const img = imgs[0]; if (!img) return [];
      const W = img.naturalWidth, H = img.naturalHeight;
      const short = Math.min(W, H);
      const r1 = Math.floor(short * 0.46);
      const radii = [r1, Math.floor(r1 * 2 / 3), Math.floor(r1 / 3)];
      const centers = bullseyeCenters(W, H, r1, rng);

      const oc = new OffscreenCanvas(W, H);
      const ctx = oc.getContext('2d')!;
      ctx.drawImage(img, 0, 0);

      for (const [cx, cy] of centers) {
        for (const r of radii) {
          const angle = rng() * (300 * Math.PI / 180) + (30 * Math.PI / 180);
          ctx.save();
          ctx.beginPath();
          ctx.arc(cx, cy, r, 0, Math.PI * 2);
          ctx.clip();
          ctx.translate(cx, cy);
          ctx.rotate(angle);
          ctx.drawImage(img, -cx, -cy);
          ctx.restore();
        }
      }

      return [
        { canvas: ocToCanvas(oc), label: 'Color', mimeType: 'image/png' },
        { canvas: otsuBinary(oc, W, H), label: 'BW', mimeType: 'image/png' },
      ];
    }

    function renderSixShooter(imgs: (HTMLImageElement | null)[], _params: Record<string, any>, rng: () => number): Output[] {
      const img = imgs[0]; if (!img) return [];
      const W = img.naturalWidth, H = img.naturalHeight;
      const aspect = W / H;
      const circles: [number, number, number][] = [];

      if (aspect > 1.25) {
        const cw = Math.floor(W / 3), ch = Math.floor(H / 2);
        const r = Math.floor(Math.min(cw, ch) / 2);
        for (let row = 0; row < 2; row++) for (let col = 0; col < 3; col++)
          circles.push([col * cw + Math.floor(cw / 2), row * ch + Math.floor(ch / 2), r]);
      } else if (aspect < 0.80) {
        const cw = Math.floor(W / 2), ch = Math.floor(H / 3);
        const r = Math.floor(Math.min(cw, ch) / 2);
        for (let row = 0; row < 3; row++) for (let col = 0; col < 2; col++)
          circles.push([col * cw + Math.floor(cw / 2), row * ch + Math.floor(ch / 2), r]);
      } else {
        const R = Math.floor(Math.min(W, H) / 2 / 1.42);
        const r = Math.max(4, Math.floor(R * 0.42));
        for (let i = 0; i < 6; i++) {
          const a = (90 + i * 60) * Math.PI / 180;
          circles.push([Math.floor(W / 2) + Math.round(R * Math.cos(a)), Math.floor(H / 2) - Math.round(R * Math.sin(a)), r]);
        }
      }

      const srcIdx = [0, 1, 2, 3, 4, 5];
      for (let i = 5; i > 0; i--) {
        const j = Math.floor(rng() * (i + 1));
        [srcIdx[i], srcIdx[j]] = [srcIdx[j], srcIdx[i]];
      }

      const oc = new OffscreenCanvas(W, H);
      const ctx = oc.getContext('2d')!;
      ctx.drawImage(img, 0, 0);

      for (let dest = 0; dest < 6; dest++) {
        const [dCx, dCy, dR] = circles[dest];
        const [sCx, sCy] = [circles[srcIdx[dest]][0], circles[srcIdx[dest]][1]];
        const angle = rng() * (300 * Math.PI / 180) + (30 * Math.PI / 180);
        // Rotate dest disk around dest center; fill from source region centered at (sCx, sCy)
        ctx.save();
        ctx.beginPath();
        ctx.arc(dCx, dCy, dR, 0, Math.PI * 2);
        ctx.clip();
        ctx.translate(dCx, dCy);
        ctx.rotate(angle);
        ctx.drawImage(img, -sCx, -sCy);
        ctx.restore();
      }

      return [
        { canvas: ocToCanvas(oc), label: 'Color', mimeType: 'image/png' },
        { canvas: otsuBinary(oc, W, H), label: 'BW', mimeType: 'image/png' },
      ];
    }

    function renderLattice(imgs: (HTMLImageElement | null)[], params: Record<string, any>, _rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2]) return [];
      const n_strips: number = params.n_strips ?? 20;
      const gap_raw: number = params.gap ?? 6;

      const sizes = [imgs[0], imgs[1], imgs[2]].map(i => [i!.naturalWidth, i!.naturalHeight]);
      const [W, H] = sizes.reduce((best, s) => s[0] * s[1] > best[0] * best[1] ? s : best);

      const resScale = Math.min(W, H) / 1024.0;
      const gap = Math.max(2, Math.round(gap_raw * resScale));

      const toData = (img: HTMLImageElement) => {
        const tmp = new OffscreenCanvas(W, H);
        tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
        return tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
      };
      const dA = toData(imgs[0]!), dB = toData(imgs[1]!), dC = toData(imgs[2]!);

      const col_pitch = W / n_strips;
      const row_pitch = H / n_strips;
      const strip_half_w = (col_pitch - gap) / 2.0;
      const strip_half_h = (row_pitch - gap) / 2.0;
      if (strip_half_w < 1 || strip_half_h < 1) return [];

      const undulate_amp_col = strip_half_w * 0.25;
      const undulate_amp_row = strip_half_h * 0.25;
      const undulate_period_col = 2.0 * row_pitch;
      const undulate_period_row = 2.0 * col_pitch;

      const col_idx  = new Int32Array(W * H);
      const row_idx  = new Int32Array(W * H);
      const in_col   = new Uint8Array(W * H);
      const in_row   = new Uint8Array(W * H);
      const dist_col = new Float32Array(W * H);
      const dist_row = new Float32Array(W * H);

      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          const p = y * W + x;
          const j  = Math.min(Math.floor(x / col_pitch), n_strips - 1);
          const j1 = Math.min(j + 1, n_strips - 1);
          const col_c_j  = (j  + 0.5) * col_pitch + undulate_amp_col * Math.sin(2 * Math.PI * y / undulate_period_col + Math.PI * j);
          const col_c_j1 = (j1 + 0.5) * col_pitch + undulate_amp_col * Math.sin(2 * Math.PI * y / undulate_period_col + Math.PI * j1);
          const dj  = Math.abs(x - col_c_j);
          const dj1 = Math.abs(x - col_c_j1);
          const inJ  = dj  <= strip_half_w;
          const inJ1 = dj1 <= strip_half_w;
          if (inJ && inJ1) {
            if (dj <= dj1) { col_idx[p] = j;  dist_col[p] = dj;  in_col[p] = 1; }
            else           { col_idx[p] = j1; dist_col[p] = dj1; in_col[p] = 1; }
          } else if (inJ)  { col_idx[p] = j;  dist_col[p] = dj;  in_col[p] = 1; }
          else if (inJ1)   { col_idx[p] = j1; dist_col[p] = dj1; in_col[p] = 1; }

          const i  = Math.min(Math.floor(y / row_pitch), n_strips - 1);
          const i1 = Math.min(i + 1, n_strips - 1);
          const row_c_i  = (i  + 0.5) * row_pitch + undulate_amp_row * Math.sin(2 * Math.PI * x / undulate_period_row + Math.PI * i);
          const row_c_i1 = (i1 + 0.5) * row_pitch + undulate_amp_row * Math.sin(2 * Math.PI * x / undulate_period_row + Math.PI * i1);
          const di  = Math.abs(y - row_c_i);
          const di1 = Math.abs(y - row_c_i1);
          const inI  = di  <= strip_half_h;
          const inI1 = di1 <= strip_half_h;
          if (inI && inI1) {
            if (di <= di1) { row_idx[p] = i;  dist_row[p] = di;  in_row[p] = 1; }
            else           { row_idx[p] = i1; dist_row[p] = di1; in_row[p] = 1; }
          } else if (inI)  { row_idx[p] = i;  dist_row[p] = di;  in_row[p] = 1; }
          else if (inI1)   { row_idx[p] = i1; dist_row[p] = di1; in_row[p] = 1; }
        }
      }

      const weaves = ['plain', 'basket', 'twill', 'herringbone', 'satin'];
      const wLabels = ['Plain', 'Basket', 'Twill', 'Herringbone', 'Satin'];
      const shadow_decay = Math.max(gap * 2.5, 4.0);
      const outputs: Output[] = [];

      for (let wi = 0; wi < 5; wi++) {
        const weave = weaves[wi];
        const tmp = new OffscreenCanvas(W, H);
        const outData = tmp.getContext('2d')!.createImageData(W, H);
        const od = outData.data;
        const n = n_strips;

        for (let p = 0; p < W * H; p++) {
          const ic = in_col[p], ir = in_row[p];
          if (!ic && !ir) { od[p*4+3] = 255; continue; }

          const ci = col_idx[p], ri = row_idx[p];
          let use_col: boolean;
          if      (weave === 'plain')       use_col = (ri + ci) % 2 === 0;
          else if (weave === 'basket')      use_col = (Math.floor(ri/2) + Math.floor(ci/2)) % 2 === 0;
          else if (weave === 'twill')       use_col = (ri + ci) % 4 >= 2;
          else if (weave === 'herringbone') use_col = ci < Math.floor(n/2) ? (ri + ci) % 4 >= 2 : (ri + (n - 1 - ci)) % 4 >= 2;
          else                              use_col = (ci - ri * 2) % 5 !== 0;

          const col_src = ci % 3 === 0 ? dA : ci % 3 === 1 ? dB : dC;
          const row_src = ri % 3 === 0 ? dB : ri % 3 === 1 ? dC : dA;
          const src = !ir ? col_src : !ic ? row_src : (use_col ? col_src : row_src);

          od[p*4]   = src[p*4];
          od[p*4+1] = src[p*4+1];
          od[p*4+2] = src[p*4+2];
          od[p*4+3] = 255;

          if (ic && ir) {
            const dist = use_col ? dist_row[p] : dist_col[p];
            const half = use_col ? strip_half_h : strip_half_w;
            const shadow = Math.exp(-(half - Math.min(dist, half)) / shadow_decay) * 0.45;
            od[p*4]   = Math.round(od[p*4]   * (1 - shadow));
            od[p*4+1] = Math.round(od[p*4+1] * (1 - shadow));
            od[p*4+2] = Math.round(od[p*4+2] * (1 - shadow));
          }
        }

        tmp.getContext('2d')!.putImageData(outData, 0, 0);
        outputs.push({ canvas: ocToCanvas(tmp), label: wLabels[wi], mimeType: 'image/png' });
      }

      return outputs;
    }

    function colorBurn(base: Uint8ClampedArray, blend: Uint8ClampedArray): Uint8ClampedArray {
      const out = new Uint8ClampedArray(base.length);
      for (let i = 0; i < base.length; i += 4) {
        for (let c = 0; c < 3; c++) {
          const b = base[i+c] / 255, s = blend[i+c] / 255;
          out[i+c] = Math.round(Math.max(0, Math.min(1, 1 - (1 - b) / Math.max(s, 1e-6))) * 255);
        }
        out[i+3] = 255;
      }
      return out;
    }

    function colorDodge(base: Uint8ClampedArray, blend: Uint8ClampedArray): Uint8ClampedArray {
      const out = new Uint8ClampedArray(base.length);
      for (let i = 0; i < base.length; i += 4) {
        for (let c = 0; c < 3; c++) {
          const b = base[i+c] / 255, s = blend[i+c] / 255;
          out[i+c] = Math.round(Math.min(1, b / Math.max(1 - s, 1e-6)) * 255);
        }
        out[i+3] = 255;
      }
      return out;
    }

    function renderStencilBurn(imgs: (HTMLImageElement | null)[], _params: Record<string, any>, _rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2] || !imgs[3]) return [];
      const sizes = (imgs as HTMLImageElement[]).slice(0, 4).map(i => [i.naturalWidth, i.naturalHeight]);
      const [W, H] = sizes.reduce((best, s) => s[0] * s[1] > best[0] * best[1] ? s : best);

      const getPixels = (img: HTMLImageElement) => {
        const tmp = new OffscreenCanvas(W, H);
        tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
        return tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
      };
      const dA = getPixels(imgs[0]!), dB = getPixels(imgs[1]!), dC = getPixels(imgs[2]!), dD = getPixels(imgs[3]!);
      const dataByIdx = [dA, dB, dC];

      const toOC = (pixels: Uint8ClampedArray) => {
        const oc = new OffscreenCanvas(W, H);
        const id = oc.getContext('2d')!.createImageData(W, H);
        id.data.set(pixels);
        oc.getContext('2d')!.putImageData(id, 0, 0);
        return oc;
      };

      const outputs: Output[] = [];
      const triples: [number, number, number][] = [[0,1,2],[1,0,2],[2,0,1]];
      for (const [s, p, q] of triples) {
        const b2 = colorBurn(dataByIdx[p], dD);
        const c2 = colorDodge(dataByIdx[q], dD);
        const ocB2 = toOC(b2), ocC2 = toOC(c2);

        for (const [fillA, fillB, variant] of [[ocB2, ocC2, '1'], [ocC2, ocB2, '2']] as [OffscreenCanvas, OffscreenCanvas, string][]) {
          const dest = new OffscreenCanvas(W, H);
          stencilCompose(dest, imgs[s]!, fillA, fillB);
          outputs.push({ canvas: ocToCanvas(dest), label: `S${s+1}v${variant}`, mimeType: 'image/png' });
        }
      }
      return outputs;
    }

    function renderZellij(imgs: (HTMLImageElement | null)[], _params: Record<string, any>, rng: () => number, scale = 1/6): Output[] {
      const img = imgs[0]; if (!img) return [];
      const W = img.naturalWidth, H = img.naturalHeight;
      const S = Math.max(60, Math.floor(Math.min(W, H) * scale));
      const R_out = S * 0.42, R_in = R_out * 0.50;
      const SQRT3 = Math.sqrt(3);

      const cx_img = W / 2, cy_img = H / 2;
      const margin = 2 * S;
      const steps = Math.floor(Math.max(W, H) / S) + 4;
      const latticeKeys: [number, number][] = [];
      const latticePos = new Map<string, [number, number]>();
      for (let r = -steps; r <= steps; r++) {
        for (let q = -steps; q <= steps; q++) {
          const px = cx_img + S * q + S * 0.5 * r;
          const py = cy_img + S * SQRT3 / 2 * r;
          if (px > -margin && px < W + margin && py > -margin && py < H + margin) {
            latticeKeys.push([q, r]);
            latticePos.set(`${q},${r}`, [px, py]);
          }
        }
      }

      // Star mask (centered at origin)
      const starPath = new Path2D();
      for (let i = 0; i < 12; i++) {
        const a = i * Math.PI / 6;
        const r = i % 2 === 0 ? R_out : R_in;
        if (i === 0) starPath.moveTo(r * Math.cos(a), r * Math.sin(a));
        else         starPath.lineTo(r * Math.cos(a), r * Math.sin(a));
      }
      starPath.closePath();

      // Shuffle star src positions
      const starDest: [number, number][] = [...latticePos.values()];
      const starSrc = starDest.map((_, i) => i);
      for (let i = starSrc.length - 1; i > 0; i--) {
        const j = Math.floor(rng() * (i + 1));
        [starSrc[i], starSrc[j]] = [starSrc[j], starSrc[i]];
      }

      // Shield groups: 3 neighbor directions × 2 signs = 6 groups
      type ShieldItem = { destRef: [number, number]; pts: number[]; srcRef: [number, number] };
      const shieldGroups: ShieldItem[][] = Array.from({ length: 6 }, () => []);
      const neighborDirs: [number, number, number][] = [[1,0,0],[0,1,60],[-1,1,120]];

      for (let di = 0; di < 3; di++) {
        const [dq, dr, theta_deg] = neighborDirs[di];
        const theta = theta_deg * Math.PI / 180;
        for (const [q, r] of latticeKeys) {
          const nbKey = `${q+dq},${r+dr}`;
          if (!latticePos.has(nbKey)) continue;
          const [ax, ay] = latticePos.get(`${q},${r}`)!;
          const [bx, by] = latticePos.get(nbKey)!;
          for (const [sign, gOff] of [[1, 0], [-1, 3]] as [number, number][]) {
            const pts = [
              ax + R_out * Math.cos(theta),                      ay + R_out * Math.sin(theta),
              ax + R_in  * Math.cos(theta + sign * Math.PI/6),   ay + R_in  * Math.sin(theta + sign * Math.PI/6),
              ax + R_out * Math.cos(theta + sign * Math.PI/3),   ay + R_out * Math.sin(theta + sign * Math.PI/3),
              bx + R_out * Math.cos(theta + sign * 2*Math.PI/3), by + R_out * Math.sin(theta + sign * 2*Math.PI/3),
              bx + R_in  * Math.cos(theta + sign * 5*Math.PI/6), by + R_in  * Math.sin(theta + sign * 5*Math.PI/6),
              bx + R_out * Math.cos(theta + Math.PI),            by + R_out * Math.sin(theta + Math.PI),
            ];
            shieldGroups[di + gOff].push({ destRef: [ax, ay], pts, srcRef: [ax, ay] });
          }
        }
      }

      // Shuffle src within each shield group
      for (const group of shieldGroups) {
        const srcs = group.map(item => item.srcRef);
        for (let i = srcs.length - 1; i > 0; i--) {
          const j = Math.floor(rng() * (i + 1));
          [srcs[i], srcs[j]] = [srcs[j], srcs[i]];
        }
        group.forEach((item, k) => { item.srcRef = srcs[k]; });
      }

      const oc = new OffscreenCanvas(W, H);
      const ctx = oc.getContext('2d')!;
      ctx.drawImage(img, 0, 0);

      // Paste shields first (clip polygon in image coords, draw shifted to read from src region)
      for (const group of shieldGroups) {
        for (const { destRef, pts, srcRef } of group) {
          const [dx, dy] = destRef, [sx, sy] = srcRef;
          const path = new Path2D();
          for (let i = 0; i < 6; i++) {
            if (i === 0) path.moveTo(pts[i*2], pts[i*2+1]);
            else         path.lineTo(pts[i*2], pts[i*2+1]);
          }
          path.closePath();
          ctx.save();
          ctx.clip(path);
          // drawImage(img, dx-sx, dy-sy): at canvas (cx,cy) reads image (cx-(dx-sx), cy-(dy-sy)) = (cx+sx-dx, cy+sy-dy)
          // which is the corresponding point in the src shield (shifted by sx-dx, sy-dy)
          ctx.drawImage(img, dx - sx, dy - sy);
          ctx.restore();
        }
      }

      // Paste stars on top (star path centered at origin, translate to dest, read from src)
      for (let destIdx = 0; destIdx < starDest.length; destIdx++) {
        const [dx, dy] = starDest[destIdx];
        const [sx, sy] = starDest[starSrc[destIdx]];
        ctx.save();
        ctx.translate(dx, dy);
        ctx.clip(starPath);
        ctx.drawImage(img, -sx, -sy);  // src center (sx,sy) → local origin → canvas (dx,dy)
        ctx.restore();
      }

      return [
        { canvas: ocToCanvas(oc), label: 'Color', mimeType: 'image/png' },
        { canvas: otsuBinary(oc, W, H), label: 'BW', mimeType: 'image/png' },
      ];
    }

    // ─── Halftone ──────────────────────────────────────────────────────────────

    function renderHalftone(imgs: (HTMLImageElement | null)[], params: Record<string, any>, _rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2]) return [];
      const W = imgs[0].naturalWidth, H = imgs[0].naturalHeight;
      const freq: number = params.freq ?? 14;
      const angle: number = params.angle ?? 45;
      const rad = angle * Math.PI / 180;
      const cosA = Math.cos(rad), sinA = Math.sin(rad);
      const sCurveIn  = [0, 64, 128, 192, 255];
      const sCurveOut = [0, 40, 128, 215, 255];

      const makeHalftoneMask = (img: HTMLImageElement): OffscreenCanvas => {
        const { bias, contrast, invert } = getStencilParams();
        const tmp = new OffscreenCanvas(W, H);
        tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
        const src = tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
        const out = new OffscreenCanvas(W, H);
        const od = out.getContext('2d')!.createImageData(W, H);
        for (let y = 0; y < H; y++) {
          for (let x = 0; x < W; x++) {
            const i = (y * W + x) * 4;
            const gRaw = piecewiseLerp(sCurveIn, sCurveOut, Math.round(0.299 * src[i] + 0.587 * src[i+1] + 0.114 * src[i+2]));
            const gAdj = Math.max(0, Math.min(255, 128 + (gRaw - 128) * contrast + bias));
            const xr = x * cosA + y * sinA;
            const yr = -x * sinA + y * cosA;
            const screen = (Math.cos(2 * Math.PI * xr / freq) * Math.cos(2 * Math.PI * yr / freq) + 1) / 2;
            const lit = (gAdj / 255) > screen;
            const v = invert ? (lit ? 0 : 255) : (lit ? 255 : 0);
            od.data[i] = od.data[i+1] = od.data[i+2] = v; od.data[i+3] = 255;
          }
        }
        out.getContext('2d')!.putImageData(od, 0, 0);
        return out;
      };

      const masks = [makeHalftoneMask(imgs[0]!), makeHalftoneMask(imgs[1]!), makeHalftoneMask(imgs[2]!)];
      const outputs: Output[] = [];
      for (const [s, a, b] of [[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]] as [number,number,number][]) {
        const dest = new OffscreenCanvas(W, H);
        const maskCtx = masks[s].getContext('2d')!;
        const sd = maskCtx.getImageData(0, 0, W, H).data;
        const ac = new OffscreenCanvas(W, H); ac.getContext('2d')!.drawImage(imgs[a]!, 0, 0, W, H);
        const ad = ac.getContext('2d')!.getImageData(0, 0, W, H).data;
        const bc = new OffscreenCanvas(W, H); bc.getContext('2d')!.drawImage(imgs[b]!, 0, 0, W, H);
        const bd = bc.getContext('2d')!.getImageData(0, 0, W, H).data;
        const ctx = dest.getContext('2d')!;
        const od = ctx.createImageData(W, H);
        for (let i = 0; i < sd.length; i += 4) {
          const src = sd[i] >= 128 ? ad : bd;
          od.data[i] = src[i]; od.data[i+1] = src[i+1]; od.data[i+2] = src[i+2]; od.data[i+3] = 255;
        }
        ctx.putImageData(od, 0, 0);
        outputs.push({ canvas: ocToCanvas(dest), label: `S${s+1} ${a+1}/${b+1}`, mimeType: 'image/png' });
      }
      return outputs;
    }

