      'cyanotype-bullethole-mask': { label: 'Cyanotype Bullet Hole Mask', desc: 'Four images: two riddled with bullet holes, then cyanotype-stenciled. The result is edge-masked against a fourth image — the bullet-punched cyanotype filtered through structure.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const holes = Math.round(params.holes ?? 20);
