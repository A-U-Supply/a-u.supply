      'lathe-kaleidoscope-stencil': { label: 'Lathe Kaleidoscope Stencil', desc: 'Double geometric destruction: one image lathe-turned into agate rings, another kaleidoscoped into mandala symmetry, a third wobble-eyed into drifting rings.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
