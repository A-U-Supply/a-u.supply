      'kaleidoscope-dream-displacement': { label: 'Kaleidoscope Dream Displacement', desc: "Four images: two kaleidoscoped into mandala symmetry, one deepdreamed. The fourth image's gradient displacement tears the dreamed kaleidoscope surface.", inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: false, renderAsync: (imgs, _p, seed) => runSparagmosRecipe('kaleidoscope-dream-displacement', imgs, seed), buildParams: () => {}, getParams: () => ({}), setParams: () => {} },
      'neural-mask-cascade': { label: 'Neural Mask Cascade', desc: 'Four images each deepdreamed independently, then chained through a cascade of dream-as-mask operations. Each dreamed surface cuts into the next.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: false, renderAsync: (imgs, _p, seed) => runSparagmosRecipe('neural-mask-cascade', imgs, seed), buildParams: () => {}, getParams: () => ({}), setParams: () => {} },
      'noise-cathedral': { label: 'Noise Cathedral', desc: 'Three noise masks at escalating thresholds cut random windows between four images, building layered stochastic revelation. Each mask threshold is higher than the last.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
