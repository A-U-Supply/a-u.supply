    // ─── Line Screen ───────────────────────────────────────────────────────────

    function renderLinescreen(imgs: (HTMLImageElement | null)[], params: Record<string, any>, _rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2]) return [];
      const W = imgs[0].naturalWidth, H = imgs[0].naturalHeight;
      const freq: number = params.freq ?? 30;
      const angle: number = params.angle ?? 0;
      const rad = angle * Math.PI / 180;
      const cosA = Math.cos(rad), sinA = Math.sin(rad);
      const sCurveIn  = [0, 64, 128, 192, 255];
      const sCurveOut = [0, 25, 128, 230, 255];
      const MIN_LINE = 0.10;

      const makeLinescreenMask = (img: HTMLImageElement): OffscreenCanvas => {
        const { bias, contrast, invert } = getStencilParams();
        const tmp = new OffscreenCanvas(W, H);
        tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
        const rawData = tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
        const grayRaw = new Uint8ClampedArray(W * H * 4);
        for (let i = 0; i < W * H * 4; i += 4) {
          const g = Math.round(0.299 * rawData[i] + 0.587 * rawData[i+1] + 0.114 * rawData[i+2]);
          const v = Math.round(piecewiseLerp(sCurveIn, sCurveOut, g));
          grayRaw[i] = grayRaw[i+1] = grayRaw[i+2] = v; grayRaw[i+3] = 255;
        }
        const blurred = applyBlur(grayRaw, W, H, 1.5);
        const out = new OffscreenCanvas(W, H);
        const od = out.getContext('2d')!.createImageData(W, H);
        for (let y = 0; y < H; y++) {
          for (let x = 0; x < W; x++) {
            const i = (y * W + x) * 4;
            const gAdj = Math.max(0, Math.min(255, 128 + (blurred[i] - 128) * contrast + bias));
            let g01 = gAdj / 255;
            g01 = Math.max(MIN_LINE, Math.min(1 - MIN_LINE, g01));
            const phase = x * cosA + y * sinA;
            const screen = (((phase % freq) + freq) % freq) / freq;
            const lit = g01 > screen;
            const v = invert ? (lit ? 0 : 255) : (lit ? 255 : 0);
            od.data[i] = od.data[i+1] = od.data[i+2] = v; od.data[i+3] = 255;
          }
        }
        out.getContext('2d')!.putImageData(od, 0, 0);
        return out;
      };

      const masks = [makeLinescreenMask(imgs[0]!), makeLinescreenMask(imgs[1]!), makeLinescreenMask(imgs[2]!)];
      const outputs: Output[] = [];
      for (const [s, a, b] of [[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]] as [number,number,number][]) {
        const dest = new OffscreenCanvas(W, H);
        const maskCtx = masks[s].getContext('2d')!;
        const sd = maskCtx.getImageData(0, 0, W, H).data;
        const ac = new OffscreenCanvas(W, H); ac.getContext('2d')!.drawImage(imgs[a]!, 0, 0, W, H);
        const ad = ac.getContext('2d')!.getImageData(0, 0, W, H).data;
        const bc = new OffscreenCanvas(W, H); bc.getContext('2d')!.drawImage(imgs[b]!, 0, 0, W, H);
        const bd = bc.getContext('2d')!.getImageData(0, 0, W, H).data;
        const ctx = dest.getContext('2d')!;
        const od = ctx.createImageData(W, H);
        for (let i = 0; i < sd.length; i += 4) {
          const src = sd[i] >= 128 ? ad : bd;
          od.data[i] = src[i]; od.data[i+1] = src[i+1]; od.data[i+2] = src[i+2]; od.data[i+3] = 255;
        }
        ctx.putImageData(od, 0, 0);
        outputs.push({ canvas: ocToCanvas(dest), label: `S${s+1} ${a+1}/${b+1}`, mimeType: 'image/png' });
      }
      return outputs;
    }

    function buildLinescreenParams() {
      paramsEl.innerHTML = `
