    // ─── Oil Spiral ───────────────────────────────────────────────────────────

    function makeOilSpiralMask(img: HTMLImageElement, W: number, H: number, freq: number, warpStr: number, nPeaks: number, bias = 0, contrast = 1, power = 3): OffscreenCanvas {
      const tmp = new OffscreenCanvas(W, H);
      tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
      const rawData = tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
      const gray = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) gray[i] = 0.299*rawData[i*4] + 0.587*rawData[i*4+1] + 0.114*rawData[i*4+2];
      const tone = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) tone[i] = Math.max(0.1, Math.min(0.9, piecewiseLerp([0,64,128,192,255],[0,25,128,230,255], gray[i]) / 255));
      const toneAdj = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) toneAdj[i] = Math.max(0.01, Math.min(0.99, (tone[i] - 0.5) * contrast + 0.5 + bias));
      // Peak detection via heavy blur
      const grayPx = new Uint8ClampedArray(W * H * 4);
      for (let i = 0; i < W * H; i++) { grayPx[i*4]=grayPx[i*4+1]=grayPx[i*4+2]=gray[i]; grayPx[i*4+3]=255; }
      const blurPx = applyBlur(grayPx, W, H, Math.min(W, H) * 0.06);
      const blurGray = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) blurGray[i] = blurPx[i*4];
      const blurSorted = Array.from(blurGray).sort((a, b) => a - b);
      const p70 = blurSorted[Math.floor(blurSorted.length * 0.70)];
      const minDist2 = (Math.min(W, H) * 0.15) ** 2;
      const candidates: [number, number, number][] = [];
      for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
        const v = blurGray[y*W+x]; if (v > p70) candidates.push([x, y, v]);
      }
      candidates.sort((a, b) => b[2] - a[2]);
      const peaks: [number, number][] = [];
      for (const [px, py] of candidates) {
        if (peaks.length >= nPeaks) break;
        let ok = true;
        for (const [qx, qy] of peaks) if ((px-qx)**2+(py-qy)**2 < minDist2) { ok = false; break; }
        if (ok) peaks.push([px, py]);
      }
      while (peaks.length < 2) peaks.push([Math.floor(W * (peaks.length + 1) / 3), Math.floor(H / 2)]);
      // Edge direction field
      const { gx, gy, mag } = sobelGradients(applyBlur(grayPx, W, H, 2.0), W, H);
      const lineAngle = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) lineAngle[i] = Math.atan2(gy[i], gx[i]) + Math.PI / 2;
      const cos2 = new Float32Array(W * H), sin2 = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) { cos2[i] = Math.cos(2*lineAngle[i]); sin2[i] = Math.sin(2*lineAngle[i]); }
      const bcos = blurFloat(cos2, W, H, 50), bsin = blurFloat(sin2, W, H, 50);
      const smoothAngle = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) smoothAngle[i] = Math.atan2(bsin[i], bcos[i]) / 2;
      const magArr = Array.from(mag).sort((a, b) => a - b);
      const mag99 = magArr[Math.floor(magArr.length * 0.99)] + 1e-6;
      const ewRaw = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) ewRaw[i] = Math.min(mag[i] / mag99, 1);
      const ewBlur = blurFloat(ewRaw, W, H, 30);
      const ew = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) ew[i] = Math.max(0, Math.min(1, ewBlur[i] * 3));
      // Warp coordinates
      const warpPx = freq * warpStr;
      const xw = new Float32Array(W * H), yw = new Float32Array(W * H);
      for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
        const i = y*W+x; xw[i] = x + ew[i]*warpPx*Math.cos(smoothAngle[i]); yw[i] = y + ew[i]*warpPx*Math.sin(smoothAngle[i]);
      }
      // Voronoi: assign each pixel to nearest peak
      const cellIdx = new Int32Array(W * H);
      const rMap = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) {
        let minD2 = Infinity, minK = 0;
        for (let k = 0; k < peaks.length; k++) {
          const dx = xw[i]-peaks[k][0], dy = yw[i]-peaks[k][1], d2 = dx*dx+dy*dy;
          if (d2 < minD2) { minD2 = d2; minK = k; }
        }
        cellIdx[i] = minK; rMap[i] = Math.sqrt(minD2);
      }
      // r_max for each peak = max distance to any image corner
      const corners: [number, number][] = [[0,0],[W,0],[0,H],[W,H]];
      const peakRMax = peaks.map(([px, py]) => {
        let rMax = 0;
        for (const [cx, cy] of corners) { const d = Math.sqrt((cx-px)**2+(cy-py)**2); if (d > rMax) rMax = d; }
        return Math.max(rMax, 1.0);
      });
      // Spiral coord → binary mask
      const oc = new OffscreenCanvas(W, H);
      const od = oc.getContext('2d')!.createImageData(W, H);
      for (let i = 0; i < W * H; i++) {
        const k = cellIdx[i], [px, py] = peaks[k];
        const sc = rMap[i]**power / (freq * peakRMax[k]**(power-1) + 1e-6) - Math.atan2(yw[i]-py, xw[i]-px) / (2*Math.PI);
        const screen = ((sc % 1) + 1) % 1;
        const v = toneAdj[i] > screen ? 255 : 0;
        od.data[i*4] = od.data[i*4+1] = od.data[i*4+2] = v; od.data[i*4+3] = 255;
      }
      oc.getContext('2d')!.putImageData(od, 0, 0);
      return oc;
    }

    function renderOilSpiral(imgs: (HTMLImageElement | null)[], params: Record<string, any>, _rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2]) return [];
      const W = imgs[0].naturalWidth, H = imgs[0].naturalHeight;
      const freq = params['oil-freq'] ?? 20;
      const warpStr = params['oil-warp'] ?? 4;
      const nPeaks = params['oil-peaks'] ?? 6;
      const bias = params['oil-bias'] ?? 0;
      const contrast = params['oil-contrast'] ?? 1;
      const power = params['oil-power-exp'] ?? 3;
      const masks = [imgs[0]!, imgs[1]!, imgs[2]!].map(img => makeOilSpiralMask(img, W, H, freq, warpStr, nPeaks, bias, contrast, power));
      const pixelData = [imgs[0]!, imgs[1]!, imgs[2]!].map(img => {
        const tmp = new OffscreenCanvas(W, H); tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
        return tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
      });
      const out: Output[] = [];
      for (const [s, a, b] of STENCIL_PERMS) {
        const sd = masks[s].getContext('2d')!.getImageData(0, 0, W, H).data;
        const ad = pixelData[a], bd = pixelData[b];
        const oc = new OffscreenCanvas(W, H);
        const od = oc.getContext('2d')!.createImageData(W, H);
        for (let i = 0; i < W * H; i++) {
          const src = sd[i*4] >= 128 ? ad : bd;
          od.data[i*4]=src[i*4]; od.data[i*4+1]=src[i*4+1]; od.data[i*4+2]=src[i*4+2]; od.data[i*4+3]=255;
        }
        oc.getContext('2d')!.putImageData(od, 0, 0);
        out.push({ canvas: ocToCanvas(oc), label: `S${s}·A${a}·B${b}`, mimeType: 'image/jpeg' });
      }
      ['A','B','C'].forEach((lbl, i) => out.push({ canvas: ocToCanvas(masks[i]), label: `Spiral ${lbl}`, mimeType: 'image/png' }));
      return out;
    }

