    // ─── Chromatic Aberration ─────────────────────────────────────────────────

    function renderChromaticAb(imgs: (HTMLImageElement | null)[], params: Record<string, any>, _rng: () => number): Output[] {
      const img = imgs[0]; if (!img) return [];
      const W = img.naturalWidth, H = img.naturalHeight;
      const src = document.createElement('canvas'); src.width = W; src.height = H;
      src.getContext('2d')!.drawImage(img, 0, 0);
      const srcData = src.getContext('2d')!.getImageData(0, 0, W, H).data;

      const strength: number = params['ca-strength'] ?? 16;
      const angle: number    = (params['ca-angle']   ?? 0) * Math.PI / 180;
      const mode: string     = params['ca-mode']     ?? 'linear';

      const dst = document.createElement('canvas'); dst.width = W; dst.height = H;
      const ctx = dst.getContext('2d')!;
      const out = ctx.createImageData(W, H);
      const d   = out.data;

      const cxF = (W - 1) / 2, cyF = (H - 1) / 2;

      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          let rdx: number, rdy: number, bdx: number, bdy: number;
          if (mode === 'radial') {
            const dx = (x - cxF) / Math.max(W, H);
            const dy = (y - cyF) / Math.max(W, H);
            const dist = Math.sqrt(dx * dx + dy * dy);
            const s = dist * strength * 2;
            rdx = dx * s; rdy = dy * s;
            bdx = -rdx;   bdy = -rdy;
          } else {
            rdx = Math.cos(angle) * strength;
            rdy = Math.sin(angle) * strength;
            bdx = -rdx; bdy = -rdy;
          }

          const [r] = bilinearSample(srcData, W, H, x + rdx, y + rdy);
          const [, g] = bilinearSample(srcData, W, H, x, y);
          const [,, b] = bilinearSample(srcData, W, H, x + bdx, y + bdy);
          const pi = (y * W + x) * 4;
          const alpha = srcData[(y * W + x) * 4 + 3];
          d[pi] = r; d[pi+1] = g; d[pi+2] = b; d[pi+3] = alpha;
        }
      }
      ctx.putImageData(out, 0, 0);
      return [{ canvas: dst, label: 'Chromatic Aberration' }];
    }

