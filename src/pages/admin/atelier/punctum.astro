        buildParams: buildLinescreenParams, getParams: getLinescreenParams, setParams: setLinescreenParams,
      },
      penrose: {
        label: 'Penrose', desc: 'Aperiodic Penrose P3 tiling with shuffled crops',
        inputs: 1, inputLabels: ['Image'], hasRandomness: true,
        render: renderPenrose,
      },
      monochrome: {
        label: 'Monochrome', desc: 'Silver gelatin grayscale fills composited with stencil',
        inputs: 3, inputLabels: ['Stencil', 'Fill A', 'Fill B'], hasRandomness: false, isStencil: true,
        render: renderMonochrome,
      },
      silver: {
        label: 'Silver', desc: 'Tonal curve + halation glow applied to fills before stencil composite',
        inputs: 3, inputLabels: ['Stencil', 'Fill A', 'Fill B'], hasRandomness: true, isStencil: true,
        render: renderSilver,
      },
      quad: {
        label: 'Quad', desc: 'Three-level (black/grey/white) stencil — 24 fill permutations',
        inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: false, isStencil: true,
        render: renderQuad,
      },
    };

    // ─── State ─────────────────────────────────────────────────────────────────

    let currentBot = 'bullethole';
    let sourceImgs: (HTMLImageElement | null)[] = [null, null, null, null];
    let sourceIds: (string | null)[] = [null, null, null, null];
    let slotTransforms: { rot: number; flip: boolean }[] = [
      {rot:0,flip:false},{rot:0,flip:false},{rot:0,flip:false},{rot:0,flip:false}
    ];
    let effectiveImgs: (HTMLImageElement | null)[] = [null, null, null, null];
    let currentSeed = 0;
    let rng: () => number = Math.random.bind(Math);
    let outputs: Output[] = [];
    let activeOutputIdx = 0;
    let pendingSlot = 0;
    type LibTab = 'inputs' | 'outputs' | 'workspace' | 'rand-inputs' | 'rand-outputs';
    let activeLibTab: LibTab = 'inputs';
    let librarySearchTimer: ReturnType<typeof setTimeout>;
    let randInputsPool: any[] = [];
    let randOutputsPool: any[] = [];

    // ─── Bullethole params ─────────────────────────────────────────────────────

    function buildBulletholeParams() {
      paramsEl.innerHTML = `
        <div class="pt-field">
          <label class="pt-label" for="bh-chaos">Chaos <span class="pt-val" id="bh-chaos-val">0.50</span></label>
          <input class="pt-range" type="range" id="bh-chaos" min="0" max="1" step="0.01" value="0.5" />
          <div class="pt-range-hints"><span>few large</span><span>many small</span></div>
        </div>
        <div class="pt-field">
          <label class="pt-label" for="bh-placement">Placement</label>
          <select class="pt-select" id="bh-placement">
            <option value="random">Random</option>
            <option value="grid">Grid</option>
            <option value="hex">Hex</option>
            <option value="radial">Radial</option>
