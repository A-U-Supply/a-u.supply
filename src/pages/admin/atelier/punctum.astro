    // ─── Native canvas effect helpers ──────────────────────────────────────────

    function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }

    function getPixels(img: HTMLImageElement): { d: Uint8ClampedArray; w: number; h: number } {
      const c = document.createElement('canvas');
      c.width = img.naturalWidth; c.height = img.naturalHeight;
      c.getContext('2d')!.drawImage(img, 0, 0);
      const id = c.getContext('2d')!.getImageData(0, 0, c.width, c.height);
      return { d: id.data, w: c.width, h: c.height };
    }

    function pixelsToCanvas(d: Uint8ClampedArray, w: number, h: number): HTMLCanvasElement {
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      c.getContext('2d')!.putImageData(new ImageData(new Uint8ClampedArray(d), w, h), 0, 0);
      return c;
    }

    // Resize source pixels to target dimensions using an offscreen canvas
    function resizeToMatch(dSrc: Uint8ClampedArray, wSrc: number, hSrc: number, wDst: number, hDst: number): Uint8ClampedArray {
      if (wSrc === wDst && hSrc === hDst) return dSrc;
      const src = document.createElement('canvas');
      src.width = wSrc; src.height = hSrc;
      src.getContext('2d')!.putImageData(new ImageData(new Uint8ClampedArray(dSrc), wSrc, hSrc), 0, 0);
      const dst = document.createElement('canvas');
      dst.width = wDst; dst.height = hDst;
      dst.getContext('2d')!.drawImage(src, 0, 0, wDst, hDst);
      return dst.getContext('2d')!.getImageData(0, 0, wDst, hDst).data;
    }

    // Sobel edge magnitude, normalised 0–255
    function sobelEdges(d: Uint8ClampedArray, w: number, h: number): Float32Array {
      const gray = new Float32Array(w * h);
      for (let i = 0; i < w * h; i++) gray[i] = 0.299*d[i*4] + 0.587*d[i*4+1] + 0.114*d[i*4+2];
      const mag = new Float32Array(w * h);
      let maxM = 0;
      for (let y = 1; y < h-1; y++) {
        for (let x = 1; x < w-1; x++) {
          const gx = -gray[(y-1)*w+(x-1)] + gray[(y-1)*w+(x+1)]
                     -2*gray[y*w+(x-1)]   + 2*gray[y*w+(x+1)]
                     -gray[(y+1)*w+(x-1)] + gray[(y+1)*w+(x+1)];
          const gy = -gray[(y-1)*w+(x-1)] - 2*gray[(y-1)*w+x] - gray[(y-1)*w+(x+1)]
                     +gray[(y+1)*w+(x-1)] + 2*gray[(y+1)*w+x] + gray[(y+1)*w+(x+1)];
          const m = Math.sqrt(gx*gx + gy*gy);
          mag[y*w+x] = m;
          if (m > maxM) maxM = m;
        }
      }
      if (maxM > 0) for (let i = 0; i < mag.length; i++) mag[i] = mag[i] / maxM * 255;
      return mag;
    }

    // Box blur (single-channel Float32Array), radius in pixels
    function boxBlur1ch(src: Float32Array, w: number, h: number, r: number): Float32Array {
      const rr = Math.max(1, Math.round(r));
      const tmp = new Float32Array(w * h);
      const out = new Float32Array(w * h);
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          let s = 0, n = 0;
          for (let dx = -rr; dx <= rr; dx++) { const nx = x+dx; if (nx >= 0 && nx < w) { s += src[y*w+nx]; n++; } }
          tmp[y*w+x] = s/n;
        }
      }
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          let s = 0, n = 0;
          for (let dy = -rr; dy <= rr; dy++) { const ny = y+dy; if (ny >= 0 && ny < h) { s += tmp[ny*w+x]; n++; } }
          out[y*w+x] = s/n;
        }
      }
      return out;
    }

    // Composite two pixel arrays using an edge-derived mask from dA.
    // feather blurs the binary edge mask for soft transitions.
    function edgeMaskComposite(
      dA: Uint8ClampedArray, dB: Uint8ClampedArray,
      w: number, h: number,
      threshold: number, feather: number, invert: boolean,
    ): Uint8ClampedArray {
      const edges = sobelEdges(dA, w, h);
      const mask  = feather > 0 ? boxBlur1ch(edges, w, h, feather) : edges;
      const out   = new Uint8ClampedArray(w * h * 4);
      for (let i = 0; i < w * h; i++) {
        let alpha = Math.min(255, Math.max(0, mask[i])) >= threshold ? 1 : 0;
        if (invert) alpha = 1 - alpha;
        const si = i * 4;
        // Where alpha=1 (edge), reveal dB; where alpha=0 (no edge), show dA
        out[si]   = dB[si]   * alpha + dA[si]   * (1 - alpha);
        out[si+1] = dB[si+1] * alpha + dA[si+1] * (1 - alpha);
        out[si+2] = dB[si+2] * alpha + dA[si+2] * (1 - alpha);
        out[si+3] = 255;
      }
      return out;
    }

    // Screen / multiply / overlay / difference blend modes
    function blendPixels(
      dA: Uint8ClampedArray, dB: Uint8ClampedArray,
      w: number, h: number,
      mode: 'screen'|'multiply'|'overlay'|'difference', strength: number,
    ): Uint8ClampedArray {
      const out = new Uint8ClampedArray(w * h * 4);
      for (let i = 0; i < w * h * 4; i += 4) {
        for (let c = 0; c < 3; c++) {
          const a = dA[i+c] / 255, b = dB[i+c] / 255;
          let v: number;
          if      (mode === 'screen')      v = 1 - (1-a)*(1-b);
          else if (mode === 'multiply')    v = a * b;
          else if (mode === 'overlay')     v = a < 0.5 ? 2*a*b : 1 - 2*(1-a)*(1-b);
          else                             v = Math.abs(a - b);
          out[i+c] = Math.round(dA[i+c] + strength * (v * 255 - dA[i+c]));
        }
        out[i+3] = 255;
      }
      return out;
    }

    // Shift R and B channels independently by pixel offsets along X
    function channelShift(d: Uint8ClampedArray, w: number, h: number, offR: number, offB: number): Uint8ClampedArray {
      const out = new Uint8ClampedArray(d);
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const i = (y * w + x) * 4;
          const rx = Math.min(w-1, Math.max(0, x + Math.round(offR)));
          out[i]   = d[(y * w + rx) * 4];
          const bx = Math.min(w-1, Math.max(0, x + Math.round(offB)));
          out[i+2] = d[(y * w + bx) * 4 + 2];
        }
      }
      return out;
    }

    // Re-encode a canvas through JPEG at low quality N times for block-artifact destruction.
    // Data URLs decode synchronously in modern browsers — no async needed.
    function jpegDestroy(canvas: HTMLCanvasElement, quality: number, iterations: number): HTMLCanvasElement {
      let c = canvas;
      const q = Math.max(0.01, Math.min(1, quality / 100));
      for (let i = 0; i < Math.round(iterations); i++) {
        const url = c.toDataURL('image/jpeg', q);
        const img = new Image();
        img.src = url;                          // data URLs decode synchronously
        const c2 = document.createElement('canvas');
        c2.width = c.width; c2.height = c.height;
        c2.getContext('2d')!.drawImage(img, 0, 0);
        c = c2;
      }
      return c;
    }

    // ─── Sparagmos async helpers ─────────────────────────────────────────────────

    async function uploadImgToLibrary(img: HTMLImageElement): Promise<string> {
      const c = document.createElement('canvas');
      c.width = img.naturalWidth; c.height = img.naturalHeight;
      c.getContext('2d')!.drawImage(img, 0, 0);
      const blob = await new Promise<Blob>(res => c.toBlob(b => res(b!), 'image/png'));
      const fd = new FormData();
      fd.append('file', blob, 'punctum-slot.png');
      const res = await fetch('/api/media/upload', { method: 'POST', credentials: 'include', body: fd });
      if (!res.ok) throw new Error('Upload failed: ' + await res.text());
      return (await res.json()).id as string;
    }

    async function runSparagmosRecipe(recipe: string, imgs: (HTMLImageElement | null)[], seed?: number): Promise<Output[]> {
      // Phase 1: resolve or upload each slot image.
      // Reuse the existing media item ID when the slot came from the library
      // and no transform has been applied — avoids polluting The Stacks with
      // redundant copies. Any image that must be uploaded is marked temp and
      // deleted from the library once the job finishes.
      processingStatusEl.classList.add('loading-dots');
      processingStatusEl.textContent = 'Uploading';
      const tempIds: string[] = [];
      const ids = await Promise.all(imgs.map(async (img, i) => {
        if (!img) return '';
        const sid = sourceIds[i];
        if (sid && effectiveImgs[i] === sourceImgs[i]) return sid;  // already in library, untransformed
        const newId = await uploadImgToLibrary(img);
        tempIds.push(newId);
        return newId;
      }));

      try {
        // Phase 2: submit job
        processingStatusEl.textContent = 'Submitting';
        const jobParams: Record<string, any> = { processing_mode: 'recipe', recipe };
        if (seed !== undefined) jobParams.seed = seed;
        const jobRes = await fetch('/api/jobs', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ app_name: 'sparagmos', media_item_ids: ids, params: jobParams }),
        });
        if (!jobRes.ok) throw new Error(await jobRes.text());
        const { id: jobId } = await jobRes.json();

        // Show job ID link for debugging
        processingJobLinkEl.href = `/admin/jobs?id=${jobId}`;
        processingJobLinkEl.textContent = `job:${jobId.slice(0, 8)}`;
        processingJobLinkEl.style.display = '';

        // Wire cancel button to this job
        let cancelled = false;
        cancelCurrentJob = async () => {
          cancelled = true;
          await fetch(`/api/jobs/${jobId}/cancel`, { method: 'POST', credentials: 'include' });
        };

        // Phase 3: poll — 16-min deadline matches server timeout_seconds=900
        processingStatusEl.textContent = 'Queued';
        const deadline = Date.now() + 16 * 60 * 1000;
        let timedOut = true;
        while (Date.now() < deadline) {
          if (cancelled) throw new Error('Job was cancelled');
          await new Promise(r => setTimeout(r, 2000));
          const job = await (await fetch(`/api/jobs/${jobId}`, { credentials: 'include' })).json();
          if (job.status === 'completed') { timedOut = false; break; }
          if (job.status === 'failed')    throw new Error(job.error_message ?? 'Job failed');
          if (job.status === 'cancelled') throw new Error('Job was cancelled');
          processingStatusEl.textContent = job.started_at ? 'Running' : 'Queued';
        }
        if (timedOut) throw new Error('Job timed out after 16 minutes');

        cancelCurrentJob = null;
        const outs: any[] = await (await fetch(`/api/jobs/${jobId}/outputs`, { credentials: 'include' })).json();
        if (!outs.length) throw new Error('Job completed but produced no outputs');
        return await Promise.all(outs.map(async (out, i) => {
          const blob = await (await fetch(`/api/jobs/${jobId}/outputs/${out.id}/download`, { credentials: 'include' })).blob();
          const url = URL.createObjectURL(blob);
          const img = await new Promise<HTMLImageElement>(res => { const el = new Image(); el.onload = () => res(el); el.src = url; });
          const canvas = document.createElement('canvas');
          canvas.width = img.naturalWidth; canvas.height = img.naturalHeight;
          canvas.getContext('2d')!.drawImage(img, 0, 0);
          URL.revokeObjectURL(url);
          return { canvas, label: outs.length > 1 ? `Output ${i + 1}` : recipe, mimeType: 'image/png' } as Output;
        }));
      } finally {
        // Delete any images we uploaded temporarily (not sourced from the library).
        // Fire-and-forget — failures don't matter here.
        for (const id of tempIds) {
          fetch(`/api/media/${id}`, { method: 'DELETE', credentials: 'include' }).catch(() => {});
        }
      }
    }

    // ─── Core flow ─────────────────────────────────────────────────────────────

    function allSlotsReady(): boolean {
      const n = BOTS[currentBot].inputs;
      return effectiveImgs.slice(0, n).every(img => img !== null);
    }

    function maybeAutoRun() {
      if (!allSlotsReady()) return;
      if (BOTS[currentBot].renderAsync) {
        runBtn.disabled = false;
      } else {
        doReroll();
      }
    }

    async function doReroll(seed?: number) {
      if (!allSlotsReady()) return;
      const bot = BOTS[currentBot];
      if (bot.renderAsync) {
        setAsyncLoading(true);
        const rawSeed = parseInt(seedInput.value, 10);
        const asyncSeed = isNaN(rawSeed) ? undefined : rawSeed;
        try {
          outputs = await bot.renderAsync(effectiveImgs.slice(0, bot.inputs), bot.getParams?.() ?? {}, asyncSeed);
        } catch (e: any) {
          setAsyncLoading(false);
          (window as any).toast?.error('Sparagmos job failed: ' + (e?.message ?? String(e)));
          return;
        }
        setAsyncLoading(false);
      } else {
        if (bot.hasRandomness) {
          currentSeed = seed !== undefined ? seed : (Math.random() * 2**31 | 0) || 1;
          rng = mulberry32(currentSeed);
          seedInput.value = String(currentSeed);
          bot.onReroll?.(mulberry32(currentSeed));
        }
        const params = bot.getParams?.() ?? {};
        outputs = bot.render!(effectiveImgs, params, rng);
        appendStencilOutputs();
      }
      activeOutputIdx = 0;
      renderStrip();
      setActiveOutput(0);
      enableActions(true);
    }

    function doRender() {
      if (!allSlotsReady()) return;
      const bot = BOTS[currentBot];
      if (bot.renderAsync) return; // async bots don't re-render on param change
      if (bot.hasRandomness) rng = mulberry32(currentSeed);
      const params = bot.getParams?.() ?? {};
      outputs = bot.render!(effectiveImgs, params, rng);
      appendStencilOutputs();
      renderStrip();
      setActiveOutput(activeOutputIdx < outputs.length ? activeOutputIdx : 0);
    }

    function setActiveOutput(idx: number) {
      if (outputs.length === 0) return;
      activeOutputIdx = idx;

      const out = outputs[idx];
      stageCanvas.width  = out.canvas.width;
      stageCanvas.height = out.canvas.height;
      stageCanvas.getContext('2d')!.drawImage(out.canvas, 0, 0);
      stageCanvas.style.display = 'block';
      emptyEl.style.display = 'none';

      // Update strip active highlight
      stripEl.querySelectorAll('.pt-thumb').forEach((el, i) => {
        el.classList.toggle('pt-thumb--active', i === idx);
      });
    }

    function renderStrip() {
      if (outputs.length <= 1) {
        stripEl.style.display = 'none';
        return;
      }
      stripEl.style.display = 'flex';
      stripEl.innerHTML = '';

      outputs.forEach((o, i) => {
        const wrapper = document.createElement('div');
        wrapper.className = `pt-thumb${i === activeOutputIdx ? ' pt-thumb--active' : ''}`;
        wrapper.dataset.idx = String(i);

        const tc = document.createElement('canvas');
        tc.className = 'pt-thumb__canvas';
        tc.width = 90; tc.height = 90;
        const aspect = o.canvas.width / o.canvas.height;
        let sw = 90, sh = 90;
        if (aspect > 1) sh = Math.round(90 / aspect);
        else sw = Math.round(90 * aspect);
        const ox = Math.round((90 - sw) / 2), oy = Math.round((90 - sh) / 2);
        tc.getContext('2d')!.drawImage(o.canvas, ox, oy, sw, sh);

        const lbl = document.createElement('div');
        lbl.className = 'pt-thumb__label';
        lbl.textContent = o.label;

        wrapper.appendChild(tc);
        wrapper.appendChild(lbl);

        const bot = BOTS[currentBot];
        const sendWrap = document.createElement('div');
        sendWrap.className = 'pt-thumb__send';
        for (let s = 0; s < bot.inputs; s++) {
          const sb = document.createElement('button');
          sb.className = 'pt-thumb__send-btn';
          sb.textContent = `→SLOT${s + 1}`;
          sb.title = `Use as ${bot.inputLabels[s] ?? `Slot ${s + 1}`}`;
          const oIdx = i, sIdx = s;
          sb.addEventListener('click', (e) => {
            e.stopPropagation();
            loadSlotFromCanvas(sIdx, outputs[oIdx].canvas);
          });
          sendWrap.appendChild(sb);
        }
        wrapper.appendChild(sendWrap);

        wrapper.addEventListener('click', () => setActiveOutput(i));
        stripEl.appendChild(wrapper);
      });
    }

    function enableActions(on: boolean) {
      const bot = BOTS[currentBot];
      rerollBtn.disabled   = !on || !bot.hasRandomness;
      runBtn.disabled      = !on && !bot.renderAsync;
      downloadBtn.disabled = !on;
      saveBtn.disabled     = !on;
      saveAllBtn.disabled  = !on;
      savePngBtn.disabled  = !on;
      const chainBtn = document.getElementById('pt-chain-btn');
      if (chainBtn) chainBtn.style.display = on ? 'block' : 'none';
    }

    // ─── Switch bot ────────────────────────────────────────────────────────────

    function switchBot(id: string, { skipClear = false }: { skipClear?: boolean } = {}) {
      currentBot = id;
      botSelect.value = id;
      const bot = BOTS[id];

      const triggerBtn = document.getElementById('bot-trigger');
      if (triggerBtn) triggerBtn.textContent = (bot?.label ?? id) + ' ▾';

      const descEl = document.getElementById('pt-bot-desc');
      if (descEl) descEl.textContent = bot?.desc ?? '';

      if (!skipClear) {
        // Reset state — preserve locked slots
        for (let i = 0; i < 4; i++) {
          if (!slotLocked[i]) {
            sourceImgs[i] = null;
            sourceIds[i] = null;
            slotTransforms[i] = { rot: 0, flip: false };
            effectiveImgs[i] = null;
            if (effectiveBlobUrls[i]) { URL.revokeObjectURL(effectiveBlobUrls[i]!); effectiveBlobUrls[i] = null; }
            slotHistory[i] = [];
          }
        }
        outputs = [];
        activeOutputIdx = 0;
        stageCanvas.style.display = 'none';
        emptyEl.style.display = '';
        emptyText.textContent = `Load ${bot.inputs > 1 ? bot.inputs + ' images' : 'an image'} to begin`;
        stripEl.style.display = 'none';
        enableActions(false);
      }

      buildSlots(bot);

      paramsEl.innerHTML = '';
      bot.buildParams?.();
      enhanceSliders();

      stencilParamsEl.style.display = bot.renderAsync ? 'none' : 'flex';
      seedInput.style.display = (bot.hasRandomness || bot.renderAsync) ? '' : 'none';
      seedInput.placeholder   = bot.renderAsync ? 'seed (opt.)' : 'seed';

      // Async bots use Run button; sync bots use Re-roll
      rerollBtn.style.display = bot.renderAsync ? 'none' : '';
      runBtn.style.display    = bot.renderAsync ? '' : 'none';
      rerollBtn.disabled = !bot.hasRandomness;
      runBtn.disabled    = true; // enabled once slots are ready
    }

    // ─── Slider number-input enhancement ──────────────────────────────────────

    function enhanceSliders(container: HTMLElement = paramsEl) {
      container.querySelectorAll<HTMLInputElement>('input.pt-range').forEach(range => {
        const num = document.createElement('input');
        num.type = 'number';
        num.className = 'pt-num-input';
        num.min = range.min;
        num.max = range.max;
        num.step = range.step;
        num.value = range.value;

        const row = document.createElement('div');
        row.className = 'pt-range-row';
        range.parentNode!.insertBefore(row, range);
        row.appendChild(range);
        row.appendChild(num);

        range.addEventListener('input', () => { num.value = range.value; });

        num.addEventListener('change', () => {
          let v = parseFloat(num.value);
          if (isNaN(v)) { num.value = range.value; return; }
          const mn = parseFloat(range.min), mx = parseFloat(range.max);
          const st = parseFloat(range.step) || 1;
          v = Math.max(mn, Math.min(mx, Math.round(v / st) * st));
          num.value = String(v);
          range.value = String(v);
          range.dispatchEvent(new Event('input', { bubbles: true }));
        });
      });
    }

    // ─── Load image into slot ──────────────────────────────────────────────────

    function onSlotLoaded(slotIdx: number) {
      slotTransforms[slotIdx] = { rot: 0, flip: false }; // aspect intentionally absent — cleared on new image load
      const fitBtn = slotsEl.querySelector(`[data-slot-fit="${slotIdx}"]`) as HTMLButtonElement | null;
      if (fitBtn) {
        fitBtn.classList.remove('ratio-active');
        fitBtn.querySelector('.pt-slot__btn-lbl')!.textContent = 'RATIO';
      }
      applyTransformAndUpdate(slotIdx).then(() => {
        updateXformButtons(slotIdx);
        maybeAutoRun();
      });
    }

    function pushSlotHistory(slotIdx: number) {
      const prev = sourceImgs[slotIdx];
      if (!prev) return;
      slotHistory[slotIdx].push({
        img: prev,
        id: sourceIds[slotIdx],
        transform: { ...slotTransforms[slotIdx] },
      });
      if (slotHistory[slotIdx].length > 20) slotHistory[slotIdx].shift();
      updateSlotBackBtn(slotIdx);
    }

    function updateSlotBackBtn(slotIdx: number) {
      const btn = slotsEl.querySelector(`[data-slot-back="${slotIdx}"]`) as HTMLButtonElement | null;
      if (btn) btn.disabled = slotHistory[slotIdx].length === 0;
    }

    function goSlotBack(slotIdx: number) {
      const entry = slotHistory[slotIdx].pop();
      if (!entry) return;
      sourceImgs[slotIdx] = entry.img;
      sourceIds[slotIdx] = entry.id;
      slotTransforms[slotIdx] = entry.transform;
      const fitBtn = slotsEl.querySelector(`[data-slot-fit="${slotIdx}"]`) as HTMLButtonElement | null;
      if (fitBtn) {
        const isRatioActive = !!entry.transform.aspect;
        fitBtn.classList.toggle('ratio-active', isRatioActive);
        fitBtn.querySelector('.pt-slot__btn-lbl')!.textContent = isRatioActive ? 'RATIO·ON' : 'RATIO';
      }
      applyTransformAndUpdate(slotIdx).then(() => {
        updateXformButtons(slotIdx);
        updateSlotBackBtn(slotIdx);
        maybeAutoRun();
      });
    }

    function loadSlotFromBlob(slotIdx: number, blob: Blob) {
      pushSlotHistory(slotIdx);
      sourceIds[slotIdx] = null;
      const url = URL.createObjectURL(blob);
      // Keep blob URL alive — revoking it before all async thumbnail restores
      // complete causes drawImage failures and blank thumbnails on bot switch.
      const img = new Image();
      img.onload = () => {
        sourceImgs[slotIdx] = img;
        onSlotLoaded(slotIdx);
      };
      img.src = url;
    }

    function loadSlotFromUrl(slotIdx: number, url: string, sourceId: string | null, onReady?: () => void) {
      pushSlotHistory(slotIdx);
      sourceIds[slotIdx] = sourceId;
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        sourceImgs[slotIdx] = img;
        onSlotLoaded(slotIdx);
        onReady?.();
      };
      img.onerror = () => (window as any).toast?.error('Failed to load image');
      img.src = url;
    }

    function loadSlotFromCanvas(slotIdx: number, canvas: HTMLCanvasElement) {
      pushSlotHistory(slotIdx);
      canvas.toBlob((blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        // Keep blob URL alive — same reason as loadSlotFromBlob.
        sourceIds[slotIdx] = null;
        const img = new Image();
        img.onload = () => {
          sourceImgs[slotIdx] = img;
          onSlotLoaded(slotIdx);
        };
        img.src = url;
      }, 'image/png');
    }

    // ─── atelier metadata ──────────────────────────────────────────────────────

    function atelierMeta(): string {
      const bot = BOTS[currentBot];
      const ids = sourceIds.slice(0, bot.inputs);
      if (!ids[0]) return '';
      return JSON.stringify({
        atelier: 'punctum',
        v: 1,
        bot: currentBot,
        source_ids: ids,
        seed: currentSeed,
        output_idx: activeOutputIdx,
        params: bot.getParams?.() ?? {},
      });
    }

    // ─── Save / download ───────────────────────────────────────────────────────

    async function saveToOutputs(mimeType: string, filename: string, btn: HTMLButtonElement, label: string): Promise<string | null> {
      if (outputs.length === 0) return null;
      const out = outputs[activeOutputIdx];
      btn.disabled = true; btn.textContent = 'Saving…';
      return new Promise((resolve) => {
        out.canvas.toBlob(async (blob) => {
          if (!blob) { (window as any).toast?.error('Export failed'); btn.disabled = false; btn.textContent = label; resolve(null); return; }
          try {
            const fd = new FormData();
            fd.append('file', blob, filename);
            fd.append('tags', `${currentBot},atelier,punctum`);
            fd.append('output_index', 'outputs');
            const meta = atelierMeta();
            if (meta) fd.append('description', meta);
            const res = await fetch('/api/media/upload', { method: 'POST', body: fd, credentials: 'include' });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();
            (window as any).toast?.success('Saved to outputs');
            resolve(data.id || null);
          } catch (err: any) {
            (window as any).toast?.error(`Save failed: ${err.message}`);
            resolve(null);
          } finally { btn.disabled = false; btn.textContent = label; }
        }, mimeType, mimeType === 'image/jpeg' ? 0.85 : undefined);
      });
    }

    rerollBtn.addEventListener('click', () => doReroll());
    runBtn.addEventListener('click', () => doReroll());
    processingCancelEl.addEventListener('click', async () => {
      if (cancelCurrentJob) await cancelCurrentJob();
    });
    seedInput.addEventListener('change', () => {
      const v = parseInt(seedInput.value);
      if (v >= 1) doReroll(v);
    });
    downloadBtn.addEventListener('click', () => {
      if (outputs.length === 0) return;
      const link = document.createElement('a');
      link.download = `${currentBot}.jpg`;
      link.href = outputs[activeOutputIdx].canvas.toDataURL('image/jpeg', 0.85);
      link.click();
    });
    saveBtn.addEventListener('click', () =>
      saveToOutputs('image/jpeg', `${currentBot}.jpg`, saveBtn, '☁ Save'));
    savePngBtn.addEventListener('click', () =>
      saveToOutputs('image/png', `${currentBot}.png`, savePngBtn, '☁ HD PNG'));
    saveAllBtn.addEventListener('click', async () => {
      if (outputs.length === 0) return;
      saveAllBtn.disabled = true;
      const orig = saveAllBtn.textContent!;
      let saved = 0;
      for (let i = 0; i < outputs.length; i++) {
        saveAllBtn.textContent = `${i + 1}/${outputs.length}`;
        const out = outputs[i];
        await new Promise<void>((resolve) => {
          out.canvas.toBlob(async (blob) => {
            if (!blob) { resolve(); return; }
            try {
              const ext = out.mimeType === 'image/png' ? 'png' : 'jpg';
              const fd = new FormData();
              fd.append('file', blob, `${currentBot}-${i}.${ext}`);
              fd.append('tags', `${currentBot},atelier,punctum`);
              fd.append('output_index', 'outputs');
              fd.append('description', JSON.stringify({ atelier: 'punctum', v: 1, bot: currentBot, source_ids: sourceIds.slice(0, BOTS[currentBot].inputs), seed: currentSeed, output_idx: i, params: BOTS[currentBot].getParams?.() ?? {} }));
              await fetch('/api/media/upload', { method: 'POST', body: fd, credentials: 'include' });
              saved++;
            } catch {}
            resolve();
          }, out.mimeType, out.mimeType === 'image/jpeg' ? 0.85 : undefined);
        });
      }
      saveAllBtn.disabled = false;
      saveAllBtn.textContent = orig;
      (window as any).toast?.success(`Saved ${saved} of ${outputs.length}`);
    });

    // ─── Library modal ─────────────────────────────────────────────────────────

    const ALL_LIB_TABS = [libTabInputs, libTabOutputs, libTabWorkspace, libTabRandInputs, libTabRandOutputs];

    function setLibTab(tab: LibTab) {
      activeLibTab = tab;
      ALL_LIB_TABS.forEach(b => b.classList.remove('pt-modal__tab--active'));
      ({ inputs: libTabInputs, outputs: libTabOutputs, workspace: libTabWorkspace,
         'rand-inputs': libTabRandInputs, 'rand-outputs': libTabRandOutputs } as Record<LibTab, HTMLButtonElement>)[tab]
        .classList.add('pt-modal__tab--active');
      librarySearch.style.display     = tab === 'inputs' ? '' : 'none';
      libraryShuffleBtn.style.display = (tab === 'rand-inputs' || tab === 'rand-outputs') ? '' : 'none';
    }

    function openLibrary(slotIdx: number) {
      pendingSlot = slotIdx;
      setLibTab('inputs');
      libraryOverlay.style.display = 'flex';
      librarySearch.value = '';
      loadInputs('');
    }

    function renderGrid(items: { id: string; filename?: string }[]) {
      if (items.length === 0) {
        libraryGrid.innerHTML = '<div class="pt-modal__loading">No images found</div>';
        return;
      }
      libraryGrid.innerHTML = '';
      for (const item of items) {
        const img = document.createElement('img');
        img.className = 'pt-lib-thumb';
        img.src = `/api/media/${item.id}/thumbnail`;
        img.alt = item.filename || '';
        img.loading = 'lazy';
        img.addEventListener('click', () => {
          libraryOverlay.style.display = 'none';
          loadSlotFromUrl(pendingSlot, `/api/media/${item.id}/file`, item.id);
        });
        libraryGrid.appendChild(img);
      }
    }

    async function loadInputs(q: string) {
      libraryGrid.innerHTML = '<div class="pt-modal__loading loading-dots">Loading</div>';
      try {
        const res = await fetch('/api/search', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: q, media_types: ['image'], sort: 'created_at:desc',
                                 page: 1, per_page: 48, filters: { output_index: '__inputs__' } }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        renderGrid(data.results || data.hits || []);
      } catch (err: any) {
        libraryGrid.innerHTML = `<div class="pt-modal__loading">Error: ${err.message}</div>`;
      }
    }

    async function loadOutputs() {
      libraryGrid.innerHTML = '<div class="pt-modal__loading loading-dots">Loading</div>';
      try {
        const res = await fetch('/api/search', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: '', media_types: ['image'], sort: 'created_at:desc',
                                 page: 1, per_page: 48, filters: { output_index: '__outputs__' } }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        renderGrid(data.results || data.hits || []);
      } catch (err: any) {
        libraryGrid.innerHTML = `<div class="pt-modal__loading">Error: ${err.message}</div>`;
      }
    }

    async function loadWorkspace() {
      libraryGrid.innerHTML = '<div class="pt-modal__loading loading-dots">Loading</div>';
      const wsId = localStorage.getItem('active_workspace_id');
      if (!wsId) {
        libraryGrid.innerHTML = '<div class="pt-modal__loading">No active workspace</div>';
        return;
      }
      try {
        const res = await fetch(`/api/workspaces/${wsId}/items?per_page=100`, { credentials: 'include' });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const images = (data.items || []).filter((i: any) => i.media_type === 'image');
        if (images.length === 0) {
          libraryGrid.innerHTML = '<div class="pt-modal__loading">No images in workspace</div>';
          return;
        }
        libraryGrid.innerHTML = '';
        for (const item of images) {
          const img = document.createElement('img');
          img.className = 'pt-lib-thumb';
          img.src = `/api/media/${item.media_item_id}/thumbnail`;
          img.alt = item.filename || '';
          img.loading = 'lazy';
          img.addEventListener('click', () => {
            libraryOverlay.style.display = 'none';
            loadSlotFromUrl(pendingSlot, `/api/media/${item.media_item_id}/file`, item.media_item_id);
          });
          libraryGrid.appendChild(img);
        }
      } catch (err: any) {
        libraryGrid.innerHTML = `<div class="pt-modal__loading">Error: ${err.message}</div>`;
      }
    }

    async function loadRandInputs() {
      if (randInputsPool.length === 0) {
        libraryGrid.innerHTML = '<div class="pt-modal__loading loading-dots">Loading</div>';
        try {
          const res = await fetch('/api/search', {
            method: 'POST', credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: '', media_types: ['image'], sort: 'created_at:desc',
                                   page: 1, per_page: 200, filters: { output_index: '__inputs__' } }),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          randInputsPool = (data.results || data.hits || []).slice(48);
        } catch (err: any) {
          libraryGrid.innerHTML = `<div class="pt-modal__loading">Error: ${err.message}</div>`;
          return;
        }
      }
      const pool = [...randInputsPool];
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      renderGrid(pool.slice(0, 48));
    }

    async function loadRandOutputs() {
      if (randOutputsPool.length === 0) {
        libraryGrid.innerHTML = '<div class="pt-modal__loading loading-dots">Loading</div>';
        try {
          const res = await fetch('/api/search', {
            method: 'POST', credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: '', media_types: ['image'], sort: 'created_at:desc',
                                   page: 1, per_page: 200, filters: { output_index: '__outputs__' } }),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          randOutputsPool = (data.results || data.hits || []).slice(48);
        } catch (err: any) {
          libraryGrid.innerHTML = `<div class="pt-modal__loading">Error: ${err.message}</div>`;
          return;
        }
      }
      const pool = [...randOutputsPool];
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      renderGrid(pool.slice(0, 48));
    }

    libraryClose.addEventListener('click', () => { libraryOverlay.style.display = 'none'; });
    libraryOverlay.addEventListener('click', (e) => { if (e.target === libraryOverlay) libraryOverlay.style.display = 'none'; });
    libTabInputs.addEventListener('click',      () => { setLibTab('inputs');       loadInputs(librarySearch.value); });
    libTabOutputs.addEventListener('click',     () => { setLibTab('outputs');      loadOutputs(); });
    libTabWorkspace.addEventListener('click',   () => { setLibTab('workspace');    loadWorkspace(); });
    libTabRandInputs.addEventListener('click',  () => { setLibTab('rand-inputs');  loadRandInputs(); });
    libTabRandOutputs.addEventListener('click', () => { setLibTab('rand-outputs'); loadRandOutputs(); });
    libraryShuffleBtn.addEventListener('click', () => {
      if (activeLibTab === 'rand-inputs')  loadRandInputs();
      if (activeLibTab === 'rand-outputs') loadRandOutputs();
    });
    libraryUploadBtn.addEventListener('click', () => libraryUploadFile.click());
    libraryUploadFile.addEventListener('change', () => {
      const f = libraryUploadFile.files?.[0];
      if (!f) return;
      libraryUploadFile.value = '';
      libraryOverlay.style.display = 'none';
      loadSlotFromBlob(pendingSlot, f);
    });
    librarySearch.addEventListener('input', () => {
      clearTimeout(librarySearchTimer);
      librarySearchTimer = setTimeout(() => loadInputs(librarySearch.value), 300);
    });

    // ─── Stencil controls ──────────────────────────────────────────────────────

    enhanceSliders(stencilParamsEl);
    let stencilDebounce: ReturnType<typeof setTimeout>;
    document.getElementById('st-bias')?.addEventListener('input', (e) => {
      document.getElementById('st-bias-val')!.textContent = (e.target as HTMLInputElement).value;
      clearTimeout(stencilDebounce); stencilDebounce = setTimeout(doRender, 150);
    });
    document.getElementById('st-contrast')?.addEventListener('input', (e) => {
      document.getElementById('st-contrast-val')!.textContent = parseFloat((e.target as HTMLInputElement).value).toFixed(2);
      clearTimeout(stencilDebounce); stencilDebounce = setTimeout(doRender, 150);
    });
    document.getElementById('st-invert')?.addEventListener('change', () => doRender());

    // ─── Params collapse ───────────────────────────────────────────────────────
    function wireParamsToggle(wrapId: string, btnId: string, label: string) {
      document.getElementById(btnId)?.addEventListener('click', () => {
        const wrap = document.getElementById(wrapId);
        const btn  = document.getElementById(btnId)!;
        const collapsed = wrap?.classList.toggle('collapsed');
        btn.textContent = (collapsed ? '▼ ' : '▲ ') + label;
      });
    }
    wireParamsToggle('pt-bot-params-wrap',     'pt-bot-params-toggle',     'Bot Parameters');
    wireParamsToggle('pt-stencil-params-wrap', 'pt-stencil-params-toggle', 'Stencil Parameters');

    // ─── Tab management ────────────────────────────────────────────────────────

    function makeEmptyTabState(): TabState {
      return {
        id: nextTabId++,
        currentBot: botSelect.value || 'bullethole',
        sourceImgs: [null, null, null, null],
        sourceIds: [null, null, null, null],
        slotTransforms: [{rot:0,flip:false},{rot:0,flip:false},{rot:0,flip:false},{rot:0,flip:false}],
        slotLocked: [false, false, false, false],
        effectiveImgs: [null, null, null, null],
        effectiveBlobUrls: [null, null, null, null],
        currentSeed: 0,
        rng: Math.random.bind(Math),
        outputs: [],
        activeOutputIdx: 0,
        botParams: {},
        stencilParams: { bias: 0, contrast: 1, invert: false },
        slotHistory: [[], [], [], []],
      };
    }

    function saveCurrentTabState() {
      if (!tabs[activeTabIdx]) return;
      const tab = tabs[activeTabIdx];
      tab.currentBot      = currentBot;
      tab.sourceImgs      = [...sourceImgs];
      tab.sourceIds       = [...sourceIds];
      tab.slotTransforms  = slotTransforms.map(t => ({...t}));
      tab.slotLocked      = [...slotLocked];
      tab.effectiveImgs   = [...effectiveImgs];
      tab.effectiveBlobUrls = [...effectiveBlobUrls];
      tab.currentSeed     = currentSeed;
      tab.rng             = rng;
      tab.outputs         = [...outputs];
      tab.activeOutputIdx = activeOutputIdx;
      tab.botParams       = BOTS[currentBot].getParams?.() ?? {};
      tab.stencilParams   = getStencilParams();
      tab.slotHistory     = slotHistory.map(h => [...h]);
    }

    function restoreTabState(tab: TabState) {
      // Set globals BEFORE switchBot so buildSlots sees the restored images/locks
      currentBot        = tab.currentBot;
      sourceImgs        = [...tab.sourceImgs];
      sourceIds         = [...tab.sourceIds];
      slotTransforms    = tab.slotTransforms.map(t => ({...t}));
      slotLocked        = [...tab.slotLocked];
      effectiveImgs     = [...tab.effectiveImgs];
      effectiveBlobUrls = [...tab.effectiveBlobUrls];
      currentSeed       = tab.currentSeed;
      rng               = tab.rng;
      outputs           = [...tab.outputs];
      activeOutputIdx   = tab.activeOutputIdx;
      slotHistory       = tab.slotHistory.map(h => [...h]);

      botSelect.value = tab.currentBot;
      switchBot(tab.currentBot, { skipClear: true });
      BOTS[tab.currentBot].setParams?.(tab.botParams);

      // Restore stencil params
      const biasEl = document.getElementById('st-bias')     as HTMLInputElement;
      const contEl = document.getElementById('st-contrast') as HTMLInputElement;
      const invEl  = document.getElementById('st-invert')   as HTMLInputElement;
      if (biasEl) { biasEl.value = String(tab.stencilParams.bias);     document.getElementById('st-bias-val')!.textContent     = String(tab.stencilParams.bias); }
      if (contEl) { contEl.value = String(tab.stencilParams.contrast); document.getElementById('st-contrast-val')!.textContent = tab.stencilParams.contrast.toFixed(2); }
      if (invEl)  invEl.checked  = tab.stencilParams.invert;

      if (currentSeed > 0) seedInput.value = String(currentSeed);

      const bot = BOTS[tab.currentBot];
      if (outputs.length > 0) {
        renderStrip();
        setActiveOutput(activeOutputIdx < outputs.length ? activeOutputIdx : 0);
        enableActions(true);
        rerollBtn.disabled = !bot.hasRandomness;
      } else {
        stageCanvas.style.display = 'none';
        emptyEl.style.display = '';
        emptyText.textContent = `Load ${bot.inputs > 1 ? bot.inputs + ' images' : 'an image'} to begin`;
        stripEl.style.display = 'none';
        enableActions(false);
        rerollBtn.disabled = true;
      }
    }

    function renderTabBar() {
      const tabsEl = document.getElementById('pt-tabs')!;
      tabsEl.querySelectorAll('.pt-tab').forEach(el => el.remove());
      const addBtn = document.getElementById('pt-tab-add')!;
      tabs.forEach((tab, idx) => {
        const btn = document.createElement('button');
        btn.className = `pt-tab${idx === activeTabIdx ? ' pt-tab--active' : ''}`;
        btn.title = BOTS[tab.currentBot]?.label ?? tab.currentBot;
        const lbl = document.createElement('span');
        lbl.textContent = `T${tab.id}`;
        btn.appendChild(lbl);
        if (tabs.length > 1) {
          const x = document.createElement('button');
          x.className = 'pt-tab__close';
          x.textContent = '×';
          x.title = 'Close tab';
          x.addEventListener('click', e => { e.stopPropagation(); closeTab(idx); });
          btn.appendChild(x);
        }
        btn.addEventListener('click', () => switchToTab(idx));
        tabsEl.insertBefore(btn, addBtn);
      });
    }

    function switchToTab(idx: number) {
      if (idx === activeTabIdx) return;
      saveCurrentTabState();
      activeTabIdx = idx;
      restoreTabState(tabs[activeTabIdx]);
      renderTabBar();
    }

    function newTab(chainCanvas?: HTMLCanvasElement) {
      saveCurrentTabState();
      const tab = makeEmptyTabState();
      tabs.push(tab);
      activeTabIdx = tabs.length - 1;
      restoreTabState(tab);
      if (chainCanvas) loadSlotFromCanvas(0, chainCanvas);
      renderTabBar();
    }

    function closeTab(idx: number) {
      if (tabs.length <= 1) return;
      tabs[idx].effectiveBlobUrls.forEach(url => { if (url) URL.revokeObjectURL(url); });
      tabs.splice(idx, 1);
      if (activeTabIdx >= tabs.length) activeTabIdx = tabs.length - 1;
      else if (activeTabIdx > idx) activeTabIdx--;
      restoreTabState(tabs[activeTabIdx]);
      renderTabBar();
    }

    document.getElementById('pt-chain-btn')?.addEventListener('click', () => {
      if (outputs.length === 0) return;
      newTab(outputs[activeOutputIdx].canvas);
    });
    document.getElementById('pt-tab-add')?.addEventListener('click', () => newTab());

    // ─── Bot picker ────────────────────────────────────────────────────────────

    type BotOriginFlat = { label: string; bots: string[] };
    type BotOriginCategorized = { label: string; categories: { label: string; bots: string[] }[] };
    type BotOrigin = BotOriginFlat | BotOriginCategorized;

    const BOT_ORIGINS: BotOrigin[] = [
      {
        label: 'Collage Bot',
        bots: ['bullethole','stencil','bw','cyanotype','wobbleeye','lathe','bullseye',
               'sixshooter','lattice','stencilburn','zellij','zellij_medium','halftone',
               'linescreen','penrose','monochrome','silver','quad','kaleidoscope',
               'displacement','oilspiral','soapyspiral','halationedge','curvylines'],
      },
      {
        label: 'Protease Bots',
        bots: ['joukowski','spiralscreen','sinewarp','sinephase','circlelimit','curlnoise'],
      },
      {
        label: 'Sparagmos',
        categories: [
          {
            label: '2 Images',
            bots: ['dream-dissolve','double-exposure','feedback-loop','ghost-overlay',
                   'phantom-limb','simple-cutout','spectral-merge','two-face','x-ray-composite'],
          },
          {
            label: '3 Images',
            bots: ['dream-cutout','dream-halftone','dream-within-dream','neural-chimera',
                   'voronoi-chimera','wax-museum','acid-wash','broadcast-static','data-rot',
                   'edge-ghosts','exquisite-corpse','fossil-record','holographic-interference',
                   'mask-and-glitch','sediment-core','signal-bleed','sorted-mask',
                   'spectral-stencil','triple-mask','bullseye-cyanotype','curvy-corruption',
                   'cyanotype-corruption','reducedscreen-datamosh','shifted-linescreen',
                   'sixshooter-linescreen','sorted-displacement','spectral-silver',
                   'vhs-halation','bullethole-silver','bullseye-wobble-displacement',
                   'halftone-curvyscreen','kaleidoscope-halftone','lathe-displacement',
                   'lathe-kaleidoscope-stencil','wobble-halation'],
          },
          {
            label: '4 Images',
            bots: ['dream-erosion','dream-mask','dream-mask-dream','dream-quad','dream-stencil',
                   'kaleidoscope-dream-displacement','neural-mask-cascade','noise-cathedral',
                   'phantom-dream','silver-displacement-dream','tectonic-overlap',
                   'binary-archaeology','collage-mask-collage','collage-surgery',
                   'collage-through-glass','contrast-surgery','datum-shift',
                   'displacement-blend-spectral','dissolve-cascade','double-masked-collage',
                   'fracture-and-mask','gradient-reveal','interference-mask','layered-cutwork',
                   'letterpress','luminance-layers','mask-cascade','mask-erosion',
                   'negative-space','palimpsest','photogram','silhouette-collage',
                   'signal-reconstruction','spectral-mask','stencil-burn','stratum-shift',
                   'structural-echo','surveillance-decay','text-ghost','threshold-cascade',
                   'torn-collage','wobble-curvyscreen-dither','pca-quad','quad-sort-destroy',
                   'stencil-into-displacement'],
          },
          {
            label: 'Native',
            bots: ['chromaticab','paletteswap','reactiondiffusion'],
          },
        ],
      },
    ];

    function originAllBots(o: BotOrigin): string[] {
      if ('bots' in o) return o.bots;
      return o.categories.flatMap(c => c.bots);
    }

    let activePickerTab = 0;

    const pickerEl    = document.getElementById('bot-picker')!;
    const pickerBody  = document.getElementById('bot-picker-body')!;
    const pickerSearch = document.getElementById('bot-picker-search') as HTMLInputElement;
    const triggerBtn  = document.getElementById('bot-trigger')!;

    function makePickerCard(id: string): HTMLButtonElement {
      const bot = BOTS[id];
      const card = document.createElement('button');
      card.className = 'pt-picker-card' + (id === currentBot ? ' pt-picker-card--active' : '');
      card.dataset.botId = id;
      card.innerHTML = `<div class="pt-picker-card__name">${bot.label}</div><div class="pt-picker-card__desc">${bot.desc ?? ''}</div>`;
      card.addEventListener('click', () => {
        switchBot(id);
        closePicker();
        if (allSlotsReady()) {
          if (BOTS[id].renderAsync) runBtn.disabled = false;
          else doReroll();
        }
      });
      return card;
    }

    function buildPickerCards(searchTerm = '') {
      const q = searchTerm.toLowerCase().trim();
      pickerBody.innerHTML = '';

      if (q) {
        // When searching, scan all origins flat
        const candidates = BOT_ORIGINS.flatMap(o => originAllBots(o));
        const filtered = candidates.filter(id => {
          const bot = BOTS[id];
          if (!bot) return false;
          return bot.label.toLowerCase().includes(q) || (bot.desc ?? '').toLowerCase().includes(q);
        });
        if (filtered.length === 0) {
          pickerBody.innerHTML = '<div class="pt-picker-empty" style="display:block">No bots match</div>';
          return;
        }
        const grid = document.createElement('div');
        grid.className = 'pt-picker-grid';
        for (const id of filtered) grid.appendChild(makePickerCard(id));
        pickerBody.appendChild(grid);
        return;
      }

      // Browsing mode: show active tab, with optional sub-categories
      const origin = BOT_ORIGINS[activePickerTab];
      if ('bots' in origin) {
        if (origin.bots.length === 0) {
          pickerBody.innerHTML = '<div class="pt-picker-empty" style="display:block">No bots</div>';
          return;
        }
        const grid = document.createElement('div');
        grid.className = 'pt-picker-grid';
        for (const id of origin.bots) {
          if (BOTS[id]) grid.appendChild(makePickerCard(id));
        }
        pickerBody.appendChild(grid);
      } else {
        for (const cat of origin.categories) {
          const label = document.createElement('div');
          label.className = 'pt-picker-section-label';
          label.textContent = cat.label;
          pickerBody.appendChild(label);
          const grid = document.createElement('div');
          grid.className = 'pt-picker-grid';
          for (const id of cat.bots) {
            if (BOTS[id]) grid.appendChild(makePickerCard(id));
          }
          pickerBody.appendChild(grid);
        }
      }
    }

    function setPickerTab(idx: number) {
      activePickerTab = idx;
      document.querySelectorAll('.pt-picker-tab').forEach((t, i) =>
        t.classList.toggle('active', i === idx)
      );
    }

    function openPicker() {
      // Jump to the tab that contains the currently-active bot
      const tabIdx = BOT_ORIGINS.findIndex(o => originAllBots(o).includes(currentBot));
      if (tabIdx >= 0) setPickerTab(tabIdx);
      pickerSearch.value = '';
      buildPickerCards();
      // On mobile the picker is position:fixed — set top from trigger's viewport position
      const triggerRect = triggerBtn.getBoundingClientRect();
      pickerEl.style.top = (triggerRect.bottom + 4) + 'px';
      pickerEl.style.display = 'flex';
      triggerBtn.classList.add('open');
      pickerSearch.focus();
      // Scroll active card into view
      const active = pickerBody.querySelector('.pt-picker-card--active');
      active?.scrollIntoView({ block: 'nearest' });
    }

    function closePicker() {
      pickerEl.style.display = 'none';
      triggerBtn.classList.remove('open');
    }

    triggerBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      pickerEl.style.display === 'none' ? openPicker() : closePicker();
    });

    pickerSearch.addEventListener('input', () => buildPickerCards(pickerSearch.value));

    document.getElementById('bot-picker-tabs')?.addEventListener('click', (e) => {
      const tab = (e.target as HTMLElement).closest('[data-tab]') as HTMLElement | null;
      if (!tab) return;
      setPickerTab(parseInt(tab.dataset.tab!));
      pickerSearch.value = '';
      buildPickerCards();
    });
    pickerSearch.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { closePicker(); triggerBtn.focus(); }
    });

    document.addEventListener('click', (e) => {
      if (!pickerEl.contains(e.target as Node) && e.target !== triggerBtn) closePicker();
    });

    // ─── URL param auto-export ─────────────────────────────────────────────────

    const urlParams = new URLSearchParams(window.location.search);
    const botParam  = urlParams.get('bot');
    const autoExport = urlParams.get('autoexport');

    // Set bot from URL — recipe bots (e.g. 'dream-dissolve') have no <option> in the
    // hidden select, so bypass botSelect for those and store the ID directly.
    if (botParam && BOTS[botParam] && botSelect.querySelector(`option[value="${botParam}"]`)) {
      botSelect.value = botParam;
    }

    // Initialize first tab and build slots + params
    const _firstTab = makeEmptyTabState();
    _firstTab.currentBot = (botParam && BOTS[botParam]) ? botParam : botSelect.value;
    tabs.push(_firstTab);
    activeTabIdx = 0;
    switchBot(_firstTab.currentBot);
    renderTabBar();

    if (autoExport) {
      // Restore params before loading images
      BOTS[currentBot].setParams?.(Object.fromEntries(urlParams.entries()));

      const seedParam = urlParams.get('seed');
      const seed = seedParam ? parseInt(seedParam, 10) : undefined;

      // Load all source images then save
      const bot = BOTS[currentBot];
      let loadCount = 0;
      const sourceCount = bot.inputs;

      const outputIdx = parseInt(urlParams.get('output_idx') ?? '0', 10);

      function onAllLoaded() {
        const mimeType = autoExport === 'png' ? 'image/png' : 'image/jpeg';
        const filename  = autoExport === 'png' ? `${currentBot}.png` : `${currentBot}.jpg`;
        doReroll(seed);
        // Re-apply explicitly saved params — onReroll inside doReroll may have
        // overwritten manually-adjusted slider values with seed-derived values.
        BOTS[currentBot].setParams?.(Object.fromEntries(urlParams.entries()));
        doRender();
        // doReroll resets activeOutputIdx to 0; restore the saved index
        if (outputIdx > 0 && outputIdx < outputs.length) {
          setActiveOutput(outputIdx);
        }
        saveToOutputs(mimeType, filename, savePngBtn, '☁ HD PNG').then((newId) => {
          if (newId) window.location.href = `/admin/search/detail?id=${newId}`;
        });
      }

      for (let i = 0; i < sourceCount; i++) {
        const sid = urlParams.get(`source${i}`);
        if (sid) {
          loadSlotFromUrl(i, `/api/media/${sid}/file`, sid, () => {
            loadCount++;
            if (loadCount === sourceCount) onAllLoaded();
          });
        } else {
          loadCount++;
          if (loadCount === sourceCount) onAllLoaded();
        }
      }
    }

    // Cleanup on Astro view transitions
    document.addEventListener('astro:before-swap', () => {
      clearTimeout(librarySearchTimer);
    }, { once: true });

  });
</script>
