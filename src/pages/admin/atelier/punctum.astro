          const src = sd[i*4] >= 128 ? ad : bd;
          od.data[i*4]=src[i*4]; od.data[i*4+1]=src[i*4+1]; od.data[i*4+2]=src[i*4+2]; od.data[i*4+3]=255;
        }
        oc.getContext('2d')!.putImageData(od, 0, 0);
        out.push({ canvas: ocToCanvas(oc), label: `S${s+1} ${a+1}/${b+1}`, mimeType: 'image/jpeg' });
      }
      ['A','B','C'].forEach((lbl, i) => out.push({ canvas: ocToCanvas(masks[i]), label: `Mask ${lbl}`, mimeType: 'image/png' }));
      return out;
    }

