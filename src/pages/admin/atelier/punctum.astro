        }, buildParams: buildCyanotypeBulletholeParams, getParams: getCyanotypeBulletholeParams, setParams: setCyanotypeBulletholeParams, onReroll: onRerollCyanotypeBullethole },
      'displacement-blend-spectral': { label: 'Displacement Blend Spectral', desc: 'Four images: displacement-stenciled, then screen-blended with a fourth. The blended surface is spectral-filtered to strip frequencies. Warped stencil meets spectral void.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          // Stage 1: swirl-displace A, stencil vs B
          let d = swirlDistort(dA, w, h, params.swirl ?? 1.0);
          d = edgeMaskComposite(d, dB, w, h, params.thresh ?? 110, params.feather ?? 10, false);
          // Stage 2: screen blend with C
          d = blendPixels(d, dC, w, h, 'screen', 0.55);
          // Stage 3: spectral filter (highpass strips low frequencies, leaving structure)
          const r = Math.round(params.hp_radius ?? 5);
          const hp = highpassRGB(d, w, h, r);
          d = blendPixels(d, hp, w, h, 'overlay', 0.6);
          // Final: overlay D
          d = blendPixels(d, dD, w, h, 'overlay', 0.35);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildDisplacementBlendSpectralParams, getParams: getDisplacementBlendSpectralParams, setParams: setDisplacementBlendSpectralParams, onReroll: onRerollDisplacementBlendSpectral },
      'dissolve-cascade': { label: 'Dissolve Cascade', desc: 'Four images dissolved in waves: screen blend accumulates the light, gradient masking carves the excess, multiply blend deepens the shadows, luminance masking cuts the final form.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
