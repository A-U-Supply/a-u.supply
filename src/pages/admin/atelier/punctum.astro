      'wobble-halation': { label: 'Wobble Halation', desc: 'Two images wobble-eyed — off-axis concentric rings drifting from center — then composited through halation edge stencil. The organic grain boundary meets the drifting rings.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
