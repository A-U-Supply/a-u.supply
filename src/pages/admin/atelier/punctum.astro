    // ─── Halation Edge ────────────────────────────────────────────────────────

    function makeHalationMask(img: HTMLImageElement, W: number, H: number, params: Record<string, any>, rng: () => number): OffscreenCanvas {
      const width: number = params['he-width'] ?? 10;
      const freq: number  = params['he-freq']  ?? 6;
      const angle: number = params['he-angle'] ?? 45;
      const { bias, contrast, invert } = getStencilParams();
      const tmp = new OffscreenCanvas(W, H);
      tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
      const raw = tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
      // Grayscale + bias/contrast → binary pixels
      const maskPx = new Uint8ClampedArray(W * H * 4);
      const gray = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) {
        const g = 0.299*raw[i*4] + 0.587*raw[i*4+1] + 0.114*raw[i*4+2];
        gray[i] = Math.max(0, Math.min(255, 128 + (g - 128) * contrast + bias));
        const v = gray[i] >= 128 ? 255 : 0;
        maskPx[i*4] = maskPx[i*4+1] = maskPx[i*4+2] = v; maskPx[i*4+3] = 255;
      }
      // Soft blur of binary mask — approximates dilate+erode edge zone
      const blurred = applyBlur(maskPx, W, H, width);
      // Halftone noise pattern
      const rad = angle * Math.PI / 180;
      const cosA = Math.cos(rad), sinA = Math.sin(rad);
      const noise = new Float32Array(W * H);
      for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
        const xr = x*cosA + y*sinA, yr = -x*sinA + y*cosA;
        const pattern = (Math.cos(2*Math.PI*xr/freq) * Math.cos(2*Math.PI*yr/freq) + 1) / 2;
        noise[y*W+x] = Math.min(1, pattern + rng()*0.08);
      }
      // Blend noise into edge zone
      const oc = new OffscreenCanvas(W, H);
      const od = oc.getContext('2d')!.createImageData(W, H);
      for (let i = 0; i < W * H; i++) {
        const softVal = blurred[i*4] / 255;
        const origBin = gray[i] >= 128 ? 1 : 0;
        const edgeStr = Math.min(softVal, 1 - softVal) * 2;
        const mixed = origBin*(1-edgeStr) + noise[i]*edgeStr;
        let v = mixed >= 0.5 ? 255 : 0;
        if (invert) v = 255 - v;
        od.data[i*4] = od.data[i*4+1] = od.data[i*4+2] = v; od.data[i*4+3] = 255;
      }
      oc.getContext('2d')!.putImageData(od, 0, 0);
      return oc;
    }

    function renderHalationEdge(imgs: (HTMLImageElement | null)[], params: Record<string, any>, rng: () => number): Output[] {
