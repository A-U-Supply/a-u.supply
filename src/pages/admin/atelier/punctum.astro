    // ─── Spiral Screen ────────────────────────────────────────────────────────

    function makeSpiralScreenMask(img: HTMLImageElement, W: number, H: number, params: Record<string, any>): OffscreenCanvas {
      const freq: number    = params['ss-freq'] ?? 80;
      const warpStr: number = params['ss-warp'] ?? 0.3;
      const MIN_LINE = 0.10;
      const sCurveIn  = [0, 64, 128, 192, 255];
      const sCurveOut = [0, 25, 128, 230, 255];
      const { bias, contrast, invert } = getStencilParams();
      const tmp = new OffscreenCanvas(W, H);
      tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
      const raw = tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
      const grayPx = new Uint8ClampedArray(W * H * 4);
      for (let i = 0; i < W * H; i++) {
        const g = 0.299*raw[i*4] + 0.587*raw[i*4+1] + 0.114*raw[i*4+2];
        const v = Math.round(piecewiseLerp(sCurveIn, sCurveOut, g));
        grayPx[i*4]=grayPx[i*4+1]=grayPx[i*4+2]=v; grayPx[i*4+3]=255;
      }
      const blurredPx = applyBlur(grayPx, W, H, 2.0);
      const { gx, gy, mag } = sobelGradients(blurredPx, W, H);
      const lineAngle = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) lineAngle[i] = Math.atan2(gy[i], gx[i]) + Math.PI/2;
      const cos2 = new Float32Array(W * H), sin2 = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) { cos2[i]=Math.cos(2*lineAngle[i]); sin2[i]=Math.sin(2*lineAngle[i]); }
      const bcos = blurFloat(cos2, W, H, 50), bsin = blurFloat(sin2, W, H, 50);
      const smoothAngle = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) smoothAngle[i] = Math.atan2(bsin[i], bcos[i]) / 2;
      const mag85 = histPercentile(mag, 0.85) + 1e-6;
      const ewRaw = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) ewRaw[i] = Math.min(mag[i] / mag85, 1);
      const ewBlur = blurFloat(ewRaw, W, H, 30);
      const ew = new Float32Array(W * H);
      for (let i = 0; i < W * H; i++) ew[i] = Math.min(1, ewBlur[i] * 3);
      const toneBlur = applyBlur(grayPx, W, H, 1.5);
      const warpPx = freq * warpStr;
      const cx = W / 2, cy = H / 2;
      const oc = new OffscreenCanvas(W, H);
      const od = oc.getContext('2d')!.createImageData(W, H);
      for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
        const i = y*W+x;
        const xw = x + ew[i]*warpPx*Math.cos(smoothAngle[i]);
        const yw = y + ew[i]*warpPx*Math.sin(smoothAngle[i]);
        const dx = xw-cx, dy = yw-cy;
        const r = Math.sqrt(dx*dx+dy*dy);
        const theta = Math.atan2(dy, dx);
        const sc = r - (freq/(2*Math.PI))*theta;
        const screen = (((sc % freq) + freq) % freq) / freq;
        const gAdj = Math.max(0, Math.min(255, 128 + (toneBlur[i*4] - 128) * contrast + bias));
        const g01 = Math.max(MIN_LINE, Math.min(1-MIN_LINE, gAdj/255));
        const lit = g01 > screen;
        const v = invert ? (lit ? 0 : 255) : (lit ? 255 : 0);
        od.data[i*4]=od.data[i*4+1]=od.data[i*4+2]=v; od.data[i*4+3]=255;
      }
      oc.getContext('2d')!.putImageData(od, 0, 0);
      return oc;
    }

    function renderSpiralScreen(imgs: (HTMLImageElement | null)[], params: Record<string, any>, _rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2]) return [];
      const W = imgs[0].naturalWidth, H = imgs[0].naturalHeight;
      const masks = (imgs as HTMLImageElement[]).map(img => makeSpiralScreenMask(img, W, H, params));
      const pixelData = (imgs as HTMLImageElement[]).map(img => {
