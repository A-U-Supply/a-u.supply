          let d = lumaMask(dA, dB, w, h, params.threshold ?? 128, params.feather ?? 10, false);
          d = pixelSort(d, w, h, params.sort_threshold ?? 110, 'up');
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildTwoFaceParams, getParams: getTwoFaceParams, setParams: setTwoFaceParams, onReroll: onRerollTwoFace },
      'x-ray-composite': { label: 'X-Ray Composite', desc: "One image is decomposed to its principal components — stripped to structural essentials. Its edge skeleton is then masked over the second image.", inputs: 2, inputLabels: ['Image A', 'Image B'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!);
          const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          let d = edgeMaskComposite(dA, dB, w, h, params.threshold ?? 120, params.feather ?? 10, false);
          d = blendPixels(d, dA, w, h, 'overlay', params.overlay_str ?? 0.55);
          if ((params.hp_radius ?? 0) > 0) d = highpassRGB(d, w, h, params.hp_radius);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildXRayCompositeParams, getParams: getXRayCompositeParams, setParams: setXRayCompositeParams, onReroll: onRerollXRayComposite },

      // ── Sparagmos recipes (3 images) ────────────────────────────────────────
      'dream-cutout': { label: 'Dream Cutout', desc: "Image A is deepdreamed heavily. The dreamed A's edge skeleton then cuts into B: the neural hallucination becomes a stencil.", inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: false, renderAsync: (imgs, _p, seed) => runSparagmosRecipe('dream-cutout', imgs, seed), buildParams: () => {}, getParams: () => ({}), setParams: () => {} },
      'dream-halftone': { label: 'Dream Halftone', desc: 'Three images deepdreamed until dense with neural hallucinations, then composited through AM halftone dot screens.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: false, renderAsync: (imgs, _p, seed) => runSparagmosRecipe('dream-halftone', imgs, seed), buildParams: () => {}, getParams: () => ({}), setParams: () => {} },
      'dream-within-dream': { label: 'Dream Within Dream', desc: "Recursive hallucination in three passes. A is deepdreamed until the network's preferred forms fully colonize its surface.", inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: false, renderAsync: (imgs, _p, seed) => runSparagmosRecipe('dream-within-dream', imgs, seed), buildParams: () => {}, getParams: () => ({}), setParams: () => {} },
      'neural-chimera': { label: 'Neural Chimera', desc: 'Three images deepdreamed at different neural layers then Voronoi-fragmented together. Style transfer re-hallucinates the composite.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: false, renderAsync: (imgs, _p, seed) => runSparagmosRecipe('neural-chimera', imgs, seed), buildParams: () => {}, getParams: () => ({}), setParams: () => {} },
      'voronoi-chimera': { label: 'Voronoi Chimera', desc: 'Faces and forms fused at Voronoi cell boundaries. Each image gets a different neural/glitch treatment before being fragmented together.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: false, renderAsync: (imgs, _p, seed) => runSparagmosRecipe('voronoi-chimera', imgs, seed), buildParams: () => {}, getParams: () => ({}), setParams: () => {} },
      'wax-museum': { label: 'Wax Museum', desc: 'Three images each passed through style transfer — their surfaces repainted in the manner of some other image, some other logic.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: false, renderAsync: (imgs, _p, seed) => runSparagmosRecipe('wax-museum', imgs, seed), buildParams: () => {}, getParams: () => ({}), setParams: () => {} },
      'acid-wash': { label: 'Acid Wash', desc: 'Three images run through spectral transformation — their frequencies scrambled and redistributed — before being multiplied together.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const r  = Math.max(1, Math.round(params.hp_radius ?? 5));
          const sh = Math.round(params.shift ?? 20);
          let gA = highpassRGB(dA, w, h, r);
          let gB = highpassRGB(dB, w, h, r + 3);
          let gC = highpassRGB(dC, w, h, Math.max(1, r - 2));
          gA = channelShift(gA, w, h,  sh, -sh);
          gB = channelShift(gB, w, h, -Math.round(sh * 0.7), Math.round(sh * 1.3));
          gC = channelShift(gC, w, h,  Math.round(sh * 0.5), Math.round(sh * -0.5));
          let d = blendPixels(gA, gB, w, h, 'multiply', 1.0);
          d     = blendPixels(d,  gC, w, h, 'multiply', 1.0);
          d     = blendPixels(d,  dA, w, h, 'screen', params.screen_str ?? 0.4);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildAcidWashParams, getParams: getAcidWashParams, setParams: setAcidWashParams, onReroll: onRerollAcidWash },
      'broadcast-static': { label: 'Broadcast Static', desc: 'Three images converted to sound and back — each through a different acoustic treatment, each emerging distorted in its own frequency range.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const sp = Math.round(params.scan_spacing ?? 4);
          const so = params.scan_opacity ?? 0.35;
          const sh = Math.round(params.shift ?? 25);
          let tA = pixelSort(dA, w, h, Math.round(params.sort_thresh ?? 80), 'down');
          tA = scanLines(tA, w, h, sp, so);
          let tB = channelShift(dB, w, h, sh, -sh);
          tB = scanLines(tB, w, h, sp + 1, so * 0.7);
          let tC = highpassRGB(dC, w, h, Math.max(1, Math.round(params.hp_r ?? 4)));
          tC = channelShift(tC, w, h, -Math.round(sh * 0.5), Math.round(sh * 0.5));
          let d = blendPixels(tA, tB, w, h, 'screen', 0.7);
          d     = blendPixels(d,  tC, w, h, 'overlay', 0.5);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildBroadcastStaticParams, getParams: getBroadcastStaticParams, setParams: setBroadcastStaticParams, onReroll: onRerollBroadcastStatic },
      'data-rot': { label: 'Data Rot', desc: 'Three images subjected to byte-level corruption before any composition — the damage is baked in from the start, not applied as finish.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: async (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const q = params.quality ?? 3;
          const it = Math.round(params.iterations ?? 6);
          const sh = Math.round(params.shift ?? 20);
          // Corrupt each source at slightly different quality levels baked in from the start
          const [rA, rB, rC] = await Promise.all([
            jpegDestroy(pixelsToCanvas(channelShift(dA, w, h,  sh,           -Math.round(sh*0.6)), w, h), q,     it),
            jpegDestroy(pixelsToCanvas(channelShift(dB, w, h, -Math.round(sh*0.7), Math.round(sh*0.5)), w, h), Math.max(1, q-1), Math.round(it*0.8)),
            jpegDestroy(pixelsToCanvas(channelShift(dC, w, h,  Math.round(sh*0.4), -sh),            w, h), Math.min(20, q+2), Math.round(it*1.2)),
          ]);
          // Compose: screen A over B, then difference with C to amplify damage artifacts
          const pA = getPixels(rA); const pB = getPixels(rB); const pC = getPixels(rC);
          const dBr = resizeToMatch(pB.d, pB.w, pB.h, pA.w, pA.h);
          const dCr = resizeToMatch(pC.d, pC.w, pC.h, pA.w, pA.h);
          let d = blendPixels(pA.d, dBr, pA.w, pA.h, 'screen', 0.6);
          d = blendPixels(d, dCr, pA.w, pA.h, 'difference', 0.4);
          return [{ canvas: pixelsToCanvas(d, pA.w, pA.h), mimeType: 'image/jpeg' }];
        }, buildParams: buildDataRotParams, getParams: getDataRotParams, setParams: setDataRotParams, onReroll: onRerollDataRot },
      'edge-ghosts': { label: 'Edge Ghosts', desc: 'Phantom outlines from one image haunting another. Edge detection extracts the structural skeleton of each source. Two rounds of edge-masking create layered hauntings.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!);
          const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!);
          const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const hpA = highpassRGB(dA, w, h, params.hp_radius ?? 4);
          let d = edgeMaskComposite(hpA, dB, w, h, params.thresh1 ?? 120, params.feather ?? 12, false);
          const shiftedC = channelShift(dC, w, h, params.shift_r ?? 25, params.shift_b ?? -20);
          d = edgeMaskComposite(d, shiftedC, w, h, params.thresh2 ?? 100, params.feather ?? 12, true);
          d = channelShift(d, w, h, Math.round((params.shift_r ?? 25) * 0.5), Math.round((params.shift_b ?? -20) * 0.5));
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildEdgeGhostsParams, getParams: getEdgeGhostsParams, setParams: setEdgeGhostsParams, onReroll: onRerollEdgeGhosts },
      'exquisite-corpse': { label: 'Exquisite Corpse', desc: 'The surrealist parlor game. Three images divided into horizontal strips. Each source gets different pre-processing to heighten the disjunction. Seam carving warps the fault lines.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!);
          const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!);
          const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          // Pre-process each source differently
          const pA = pixelSort(dA, w, h, params.sort_thresh ?? 70, 'up');
          const shiftAmt = Math.round(params.shift ?? 20);
          const pB = channelShift(dB, w, h, shiftAmt, -shiftAmt);
          const pC = highpassRGB(dC, w, h, 5);
          // Assign horizontal strips to sources via rng-shuffled order
          const pieces = Math.max(3, Math.round(params.pieces ?? 9));
          const stripH = Math.max(1, Math.floor(h / pieces));
          const sources = [pA, pB, pC];
          // Shuffle source assignment per strip
          const out = new Uint8ClampedArray(w * h * 4);
          for (let strip = 0; strip < pieces; strip++) {
            const srcIdx = Math.floor(rng() * 3);
            const src = sources[srcIdx];
            const yStart = strip * stripH;
            const yEnd = strip === pieces - 1 ? h : Math.min(h, yStart + stripH);
            for (let y = yStart; y < yEnd; y++) {
              for (let x = 0; x < w; x++) {
                const i = (y * w + x) * 4;
                out[i]   = src[i];
                out[i+1] = src[i+1];
                out[i+2] = src[i+2];
                out[i+3] = 255;
              }
            }
          }
          return [{ canvas: pixelsToCanvas(out, w, h), mimeType: 'image/png' }];
        }, buildParams: buildExquisiteCorpseParams, getParams: getExquisiteCorpseParams, setParams: setExquisiteCorpseParams, onReroll: onRerollExquisiteCorpse },
      'fossil-record': { label: 'Fossil Record', desc: 'Geological strata. Each image PCA-decomposed to different component counts. Opacity-blended as layers like sedimentary rock. Dithering creates stone textures.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const r = Math.round(params.hp_radius ?? 5);
          const bs = params.blend_str ?? 0.55;
          const dt = params.dither_thresh ?? 128;
          // Approximate PCA decomposition: highpass at different radii extracts structural components
          const compA = highpassRGB(dA, w, h, r);          // most components
          const compB = highpassRGB(dB, w, h, r * 2);      // fewer components
          const compC = highpassRGB(dC, w, h, r * 3);      // fewest (ghost)
          // Opacity-blend as geological layers
          let d = blendPixels(compA, compB, w, h, 'overlay', bs);
          d = blendPixels(d, compC, w, h, 'screen', bs * 0.6);
          // Bayer dither to create stone/sediment texture
          const bayer4 = [[0,8,2,10],[12,4,14,6],[3,11,1,9],[15,7,13,5]];
          const stone = new Uint8ClampedArray(w * h * 4);
          for (let y = 0; y < h; y++) {
            for (let x = 0; x < w; x++) {
              const i = (y * w + x) * 4;
              const luma = 0.299 * d[i] + 0.587 * d[i+1] + 0.114 * d[i+2];
              const bv = (bayer4[y % 4][x % 4] / 16) * 255;
              const v = luma + bv - 128 > dt ? 255 : 0;
              stone[i] = stone[i+1] = stone[i+2] = v; stone[i+3] = 255;
            }
          }
          // Blend stone texture over the layer composite
          d = blendPixels(d, stone, w, h, 'multiply', bs * 0.5);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildFossilRecordParams, getParams: getFossilRecordParams, setParams: setFossilRecordParams, onReroll: onRerollFossilRecord },
      'holographic-interference': { label: 'Holographic Interference', desc: 'Three images processed through spectral decomposition and channel aberration, then stacked via difference and screen blending to simulate holographic interference.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const r = Math.round(params.hp_radius ?? 5);
          const sh = Math.round(params.shift ?? 25);
          // Highpass each at slightly different radii (spectral decomp)
          const hpA = highpassRGB(dA, w, h, r);
          const hpB = highpassRGB(dB, w, h, r + 2);
          const hpC = highpassRGB(dC, w, h, Math.max(1, r - 2));
          // Channel aberration: each source shifted in opposite directions
          const abA = channelShift(hpA, w, h,  sh,              -Math.round(sh * 0.5));
          const abB = channelShift(hpB, w, h, -Math.round(sh * 0.7), Math.round(sh * 0.8));
          const abC = channelShift(hpC, w, h,  Math.round(sh * 0.4), -Math.round(sh * 0.6));
          // Stack: difference A+B for interference fringe, then screen C over it
          let d = blendPixels(abA, abB, w, h, 'difference', 0.75);
          d = blendPixels(d, abC, w, h, 'screen', params.screen_str ?? 0.55);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildHolographicInterferenceParams, getParams: getHolographicInterferenceParams, setParams: setHolographicInterferenceParams, onReroll: onRerollHolographicInterference },
      'mask-and-glitch': { label: 'Mask and Glitch', desc: "Image A is edge-masked onto B, producing a clean structural composite. That composite is then run through CRT/VHS processing — scan lines, color bleed.", inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!);
          const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!);
          const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          let d = edgeMaskComposite(dA, dB, w, h, params.thresh1 ?? 120, params.feather ?? 10, false);
          d = scanLines(d, w, h, params.scan_spacing ?? 4, params.scan_opacity ?? 0.45);
          d = channelShift(d, w, h, params.shift_r ?? 30, params.shift_b ?? -25);
          d = edgeMaskComposite(d, dC, w, h, params.thresh2 ?? 110, params.feather ?? 10, true);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildMaskAndGlitchParams, getParams: getMaskAndGlitchParams, setParams: setMaskAndGlitchParams, onReroll: onRerollMaskAndGlitch },
      'sediment-core': { label: 'Sediment Core', desc: 'Three images arranged as horizontal strata — the slow accumulation of time rendered as a geological cross-section pulled from the earth. Seam carving warps the layers.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const sh = Math.round(params.shift ?? 20);
          const sp = params.scan_spacing ?? 4;
          const so = params.scan_opacity ?? 0.30;
          // Apply tape artifacts per stratum before compositing
          const tA = channelShift(scanLines(dA, w, h, sp,   so),       w, h,  sh,              -Math.round(sh * 0.6));
          const tB = channelShift(scanLines(dB, w, h, sp+1, so * 0.9), w, h, -Math.round(sh * 0.7), Math.round(sh * 0.5));
          const tC = channelShift(scanLines(dC, w, h, sp,   so * 0.8), w, h,  Math.round(sh * 0.4), -sh);
          // Three equal horizontal strata
          const out = new Uint8ClampedArray(w * h * 4);
          const sources = [tA, tB, tC];
          const bandH = Math.floor(h / 3);
          for (let y = 0; y < h; y++) {
            const band = y < bandH ? 0 : y < bandH * 2 ? 1 : 2;
            const src = sources[band];
            for (let x = 0; x < w; x++) {
              const i = (y * w + x) * 4;
              out[i] = src[i]; out[i+1] = src[i+1]; out[i+2] = src[i+2]; out[i+3] = 255;
            }
          }
          return [{ canvas: pixelsToCanvas(out, w, h), mimeType: 'image/png' }];
        }, buildParams: buildSedimentCoreParams, getParams: getSedimentCoreParams, setParams: setSedimentCoreParams, onReroll: onRerollSedimentCore },
      'signal-bleed': { label: 'Signal Bleed', desc: 'Three VHS signals bleeding into each other on a bad splitter. Each source gets its own flavor of analog decay. Vertical strip collage interleaves the damaged feeds.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!);
          const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!);
          const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const ss = Math.round(params.shift_strength ?? 30);
          // Each source gets its own analog decay
          const pA = channelShift(scanLines(dA, w, h, 3, params.scan_opacity ?? 0.4), w, h, ss, -Math.round(ss * 0.7));
          const pB = channelShift(scanLines(dB, w, h, 4, params.scan_opacity ?? 0.4), w, h, -Math.round(ss * 0.8), Math.round(ss * 0.6));
          const pC = scanLines(channelShift(dC, w, h, Math.round(ss * 0.5), -Math.round(ss * 0.4)), w, h, 5, params.scan_opacity ?? 0.4);
          // Vertical strip interleave with rng-determined widths
          const strips = Math.max(4, Math.round(params.strip_count ?? 12));
          const sources = [pA, pB, pC];
          const stripW = Math.max(1, Math.floor(w / strips));
          const out = new Uint8ClampedArray(w * h * 4);
          for (let strip = 0; strip < strips; strip++) {
            const srcIdx = Math.floor(rng() * 3);
            const src = sources[srcIdx];
            const xStart = strip * stripW;
            const xEnd = strip === strips - 1 ? w : Math.min(w, xStart + stripW);
            for (let y = 0; y < h; y++) {
              for (let x = xStart; x < xEnd; x++) {
                const i = (y * w + x) * 4;
                out[i]   = src[i];
                out[i+1] = src[i+1];
                out[i+2] = src[i+2];
                out[i+3] = 255;
              }
            }
          }
          const finalShift = Math.round(params.final_shift ?? 15);
          const result = channelShift(out, w, h, finalShift, -finalShift);
          return [{ canvas: pixelsToCanvas(result, w, h), mimeType: 'image/png' }];
        }, buildParams: buildSignalBleedParams, getParams: getSignalBleedParams, setParams: setSignalBleedParams, onReroll: onRerollSignalBleed },
      'sorted-mask': { label: 'Sorted Mask', desc: "Image A is pixel-sorted by brightness, generating long streaks. A luminance mask then uses the sorted A's own brightness to composite against B.", inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!);
          const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!);
          const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const sortedA = pixelSort(dA, w, h, params.sort_thresh ?? 70, 'up');
          // Luma mask: sorted A bright areas → show C; dark areas → show B
          let d = lumaMask(sortedA, dB, w, h, params.luma_thresh ?? 110, 8, false);
          // Rng-based column interleave with C
          const colStep = Math.max(4, Math.round(w / 20));
          for (let x = 0; x < w; x += colStep) {
            if (rng() < 0.3) {
              const xEnd = Math.min(w, x + colStep);
              for (let y = 0; y < h; y++) {
                for (let cx = x; cx < xEnd; cx++) {
                  const i = (y * w + cx) * 4;
                  d[i]   = dC[i];
                  d[i+1] = dC[i+1];
                  d[i+2] = dC[i+2];
                }
              }
            }
          }
          // Edge mask final pass — A's edges reclaim some territory
          d = edgeMaskComposite(dA, d, w, h, params.edge_thresh ?? 100, params.feather ?? 10, true);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildSortedMaskParams, getParams: getSortedMaskParams, setParams: setSortedMaskParams, onReroll: onRerollSortedMask },
      'spectral-stencil': { label: 'Spectral Stencil', desc: 'Image A is bandpass-filtered in frequency space, stripping its low and high frequencies to leave only the mid-range structure — a ghost of the original used as stencil.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const r = Math.round(params.hp_radius ?? 5);
          // Bandpass approximation: highpass at r (removes low) gives mid+high;
          // highpass at 2r then subtracted gives just mid-range structure
          const hp1 = highpassRGB(dA, w, h, r);
          const hp2 = highpassRGB(dA, w, h, r * 2);
          // Bandpass ≈ hp1 - hp2 (mid structure as ghost)
          const ghost = new Uint8ClampedArray(w * h * 4);
          for (let i = 0; i < w * h * 4; i += 4) {
            for (let c = 0; c < 3; c++) ghost[i+c] = Math.min(255, Math.abs(hp1[i+c] - hp2[i+c]) * 2);
            ghost[i+3] = 255;
          }
          // Use ghost luma as stencil cutting into B; screen C over
          let d = lumaComposite(ghost, dB, dA, w, h, 40, params.feather ?? 8, false);
          d = blendPixels(d, dC, w, h, 'screen', params.screen_str ?? 0.40);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildSpectralStencilParams, getParams: getSpectralStencilParams, setParams: setSpectralStencilParams, onReroll: onRerollSpectralStencil },
      'triple-mask': { label: 'Triple Mask', desc: "Three images, two mask operations. First A's edges cut into B, producing a composite. Then that composite's own edges cut into C.", inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!);
          const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!);
          const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          // First mask: A's edges → composite against B
          let d = edgeMaskComposite(dA, dB, w, h, params.thresh1 ?? 125, params.feather ?? 10, false);
          // Second mask: composite's own luma → composite against C
          d = lumaMask(d, dC, w, h, params.thresh2 ?? 130, params.feather ?? 10, false);
          d = channelShift(d, w, h, params.shift_r ?? 25, params.shift_b ?? -20);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildTripleMaskParams, getParams: getTripleMaskParams, setParams: setTripleMaskParams, onReroll: onRerollTripleMask },
      'bullseye-cyanotype': { label: 'Bullseye Cyanotype', desc: 'Two images bullseyed — concentric rings cut and independently rotated — then all three composited through cyanotype stencil. The ring patterns get prussian blue toning.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const rings = Math.round(params.rings ?? 12);
          const rot = params.rotate ?? 0.5;
          // Bullseye both A and B with independent per-ring rotations
          const bA = ringRotate(dA, w, h, rings, 0, rot, 0, rng);
          const bB = ringRotate(dB, w, h, rings, 0, rot * 0.7, 0, rng);
          // Edge-stencil A into B, then C overlay
          let d = edgeMaskComposite(bA, bB, w, h, 90, 8, false);
          d = blendPixels(d, dC, w, h, 'screen', 0.35);
          // Prussian blue toning
          const prussian = solidColor(w, h, 10, 36, 106);
          d = blendPixels(d, prussian, w, h, 'screen', params.blue_str ?? 0.55);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildBullseyeCyanotypeParams, getParams: getBullseyeCyanotypeParams, setParams: setBullseyeCyanotypeParams, onReroll: onRerollBullseyeCyanotype },
      'curvy-corruption': { label: 'Curvy Corruption', desc: 'Three images composited through edge-following curvy line screens, then the result is byte-corrupted and CRT/VHS filtered.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: async (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const sp = params.scan_spacing ?? 3;
          const sh = Math.round(params.shift ?? 20);
          // Edge-following curvy line screen approximation: scanLines + edgeMaskComposite
          const sA = scanLines(dA, w, h, sp,   0.5);
          const sB = scanLines(dB, w, h, sp+1, 0.5);
          let d = edgeMaskComposite(sA, sB, w, h, 90, 8, false);
          // Three-way composite with C
          d = blendPixels(d, dC, w, h, 'screen', 0.4);
          // Channel shift for CRT bleed
          d = channelShift(d, w, h, sh, -Math.round(sh * 0.6));
          // Byte corruption via jpeg destroy
          return [{ canvas: await jpegDestroy(pixelsToCanvas(d, w, h), params.quality ?? 4, 4), mimeType: 'image/jpeg' }];
        }, buildParams: buildCurvyCorruptionParams, getParams: getCurvyCorruptionParams, setParams: setCurvyCorruptionParams, onReroll: onRerollCurvyCorruption },
      'cyanotype-corruption': { label: 'Cyanotype Corruption', desc: 'Three images composited through cyanotype stencil — prussian blue toning with highlight bloom — then the composite is byte-corrupted and channel-shifted.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: async (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const bs = params.blue_str ?? 0.65;
          // Step 1: edge-stencil A → B (dark areas of A reveal B)
          let d = edgeMaskComposite(dA, dB, w, h, params.thresh ?? 110, params.feather ?? 10, false);
          // Step 2: prussian blue toning — blend toward (10, 36, 106) prussian blue
          const prussian = solidColor(w, h, 10, 36, 106);
          d = blendPixels(d, prussian, w, h, 'screen', bs * 0.5);
          // Step 3: overlay C for highlight bloom (C brightens the highlights)
          d = blendPixels(d, dC, w, h, 'overlay', 0.35);
          // Step 4: channelShift for corruption
          const sr = Math.round(params.shift_r ?? 25);
          d = channelShift(d, w, h, sr, -Math.round(sr * 0.6));
          // Step 5: jpegDestroy for cyanotype grain texture
          const q = params.quality ?? 5;
          return [{ canvas: await jpegDestroy(pixelsToCanvas(d, w, h), q, 3), mimeType: 'image/jpeg' }];
        }, buildParams: buildCyanotypeCorruptionParams, getParams: getCyanotypeCorruptionParams, setParams: setCyanotypeCorruptionParams, onReroll: onRerollCyanotypeCorruption },
      'reducedscreen-datamosh': { label: 'Reduced Screen Datamosh', desc: 'Three images composited through adaptive-frequency line screens — finer lines in detail regions, coarser in flat areas — then datamoshed.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: async (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dt = params.thresh ?? 128;
          // Adaptive-frequency line screen approximation: Bayer dither at different scales per source
          const bayer4 = [[0,8,2,10],[12,4,14,6],[3,11,1,9],[15,7,13,5]];
          const bayer8 = [[0,32,8,40,2,34,10,42],[48,16,56,24,50,18,58,26],[12,44,4,36,14,46,6,38],[60,28,52,20,62,30,54,22],[3,35,11,43,1,33,9,41],[51,19,59,27,49,17,57,25],[15,47,7,39,13,45,5,37],[63,31,55,23,61,29,53,21]];
          function dth(d: Uint8ClampedArray, mat: number[][], sz: number, thr: number): Uint8ClampedArray {
            const out = new Uint8ClampedArray(w * h * 4);
            const sc = 255 / (sz * sz);
            for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
              const i = (y*w+x)*4;
              const lm = 0.299*d[i]+0.587*d[i+1]+0.114*d[i+2];
              const bv = mat[y%sz][x%sz]*sc;
              const v = lm+bv-128 > thr ? 255 : 0;
              out[i]=out[i+1]=out[i+2]=v; out[i+3]=255;
            }
            return out;
          }
          const dA4 = dth(dA, bayer4, 4, dt);
          const dB8 = dth(dB, bayer8, 8, dt - 20);
          const dC4 = dth(dC, bayer4, 4, dt + 20);
          let d = lumaComposite(dA4, dA, dB, w, h, 128, 8, false);
          d = lumaComposite(dB8, d, dC, w, h, 128, 8, false);
          d = blendPixels(d, dC4, w, h, 'screen', 0.35);
          return [{ canvas: await jpegDestroy(pixelsToCanvas(d, w, h), params.quality ?? 3, Math.round(params.iterations ?? 5)), mimeType: 'image/jpeg' }];
        }, buildParams: buildReducedscreenDatamoshParams, getParams: getReducedscreenDatamoshParams, setParams: setReducedscreenDatamoshParams, onReroll: onRerollReducedscreenDatamosh },
      'shifted-linescreen': { label: 'Shifted Line Screen', desc: 'Three images channel-shifted until their color registers separate, then composited through parallel line screen stencils. The misregistered colors show through.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const sh = Math.round(params.shift ?? 30);
          // Each source gets a distinct misregistration
          const pA = channelShift(dA, w, h,  sh,              -Math.round(sh * 0.5));
          const pB = channelShift(dB, w, h, -Math.round(sh * 0.7), Math.round(sh * 0.8));
          const pC = channelShift(dC, w, h,  Math.round(sh * 0.4), -sh);
          // 1px horizontal strip interleave across 3 sources
          const out = new Uint8ClampedArray(w * h * 4);
          for (let y = 0; y < h; y++) {
            const src = y % 3 === 0 ? pA : y % 3 === 1 ? pB : pC;
            for (let x = 0; x < w; x++) {
              const i = (y * w + x) * 4;
              out[i] = src[i]; out[i+1] = src[i+1]; out[i+2] = src[i+2]; out[i+3] = 255;
            }
          }
          // Screen blend original A back to restore image density
          const ss = params.screen_str ?? 0.40;
          const d = blendPixels(out, dA, w, h, 'screen', ss);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildShiftedLinescreenParams, getParams: getShiftedLinescreenParams, setParams: setShiftedLinescreenParams, onReroll: onRerollShiftedLinescreen },
      'sixshooter-linescreen': { label: 'Six Shooter Line Screen', desc: 'Two images six-shootered — six circular regions cut, shuffled, and rotated — then composited through parallel line screen stencil. The scattered circular displacements show through.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const rad = params.radius ?? 0.18;
          const sh = Math.round(params.shift ?? 20);
          // Six-shooter: punch 6 circles of B into A, then 6 circles of A into B
          let sA = circlePunch(dA, dB, w, h, 6, rad, rng);
          let sB = circlePunch(dB, dA, w, h, 6, rad, rng);
          // Channel-shift each scattered version
          sA = channelShift(sA, w, h,  sh,              -Math.round(sh * 0.6));
          sB = channelShift(sB, w, h, -Math.round(sh * 0.7), Math.round(sh * 0.5));
          // Line screen: horizontal strip interleave of A, B, C
          const out = new Uint8ClampedArray(w * h * 4);
          for (let y = 0; y < h; y++) {
            const src = y % 3 === 0 ? sA : y % 3 === 1 ? sB : dC;
            for (let x = 0; x < w; x++) {
              const i = (y * w + x) * 4;
              out[i] = src[i]; out[i+1] = src[i+1]; out[i+2] = src[i+2]; out[i+3] = 255;
            }
          }
          const d = blendPixels(out, dC, w, h, 'screen', params.screen_str ?? 0.40);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildSixshooterLinescreenParams, getParams: getSixshooterLinescreenParams, setParams: setSixshooterLinescreenParams, onReroll: onRerollSixshooterLinescreen },
      'sorted-displacement': { label: 'Sorted Displacement', desc: 'Two images pixel-sorted to extreme thresholds — their surfaces sheared into vertical streaks — then displacement-stenciled against a third.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const st = params.sort_thresh ?? 40;
          // Sort both sources
          const sA = pixelSort(dA, w, h, st, false);
          const sB = pixelSort(dB, w, h, Math.min(st + 20, 120), false);
          // Screen the two sorted layers together
          let d = blendPixels(sA, sB, w, h, 'screen', 0.6);
          // Swirl the composite
          d = swirlDistort(d, w, h, params.swirl ?? 1.2);
          // Edge stencil: where the swirled composite has edges, show C; otherwise keep it
          d = edgeMaskComposite(d, dC, w, h, params.thresh ?? 110, params.feather ?? 10, false);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildSortedDisplacementParams, getParams: getSortedDisplacementParams, setParams: setSortedDisplacementParams, onReroll: onRerollSortedDisplacement },
      'spectral-silver': { label: 'Spectral Silver', desc: 'Three images bandpass-filtered in frequency space — stripped to their mid-range structure, ghostly spectral remnants — then composited through silver gelatin stencil.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const r = Math.round(params.hp_radius ?? 5);
          // Bandpass each source at slightly different radii
          const ghostA = highpassRGB(dA, w, h, r);
          const ghostB = highpassRGB(dB, w, h, r + 2);
          const ghostC = highpassRGB(dC, w, h, Math.max(1, r - 1));
          // Silver gelatin: screen ghosts together, then blend with cool silver tone
          let d = blendPixels(ghostA, ghostB, w, h, 'screen', 0.7);
          d = blendPixels(d, ghostC, w, h, 'screen', 0.5);
          // Silver toning: blend toward light silver-gray (192, 192, 200)
          const silver = solidColor(w, h, 192, 192, 200);
          d = blendPixels(d, silver, w, h, 'screen', params.silver_str ?? 0.45);
          // Edge stencil for structure
          d = edgeMaskComposite(dA, d, w, h, 80, params.feather ?? 8, true);
          // Screen C for depth
          d = blendPixels(d, dC, w, h, 'screen', params.screen_str ?? 0.40);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildSpectralSilverParams, getParams: getSpectralSilverParams, setParams: setSpectralSilverParams, onReroll: onRerollSpectralSilver },
      'vhs-halation': { label: 'VHS Halation', desc: 'Three images CRT/VHS filtered — scan lines, color bleed, tracking errors — then composited through halation edge stencil. The organic grain boundary glows.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const sh = Math.round(params.shift ?? 20);
          const sp = params.scan_spacing ?? 4;
          const so = params.scan_opacity ?? 0.35;
          const pA = channelShift(scanLines(dA, w, h, sp,   so),           w, h,  sh,            -Math.round(sh * 0.7));
          const pB = channelShift(scanLines(dB, w, h, sp+1, so),           w, h, -Math.round(sh * 0.8), Math.round(sh * 0.6));
          const pC = channelShift(scanLines(dC, w, h, sp+2, so * 0.8),     w, h,  Math.round(sh * 0.5), -Math.round(sh * 0.4));
          // Wide-feather edge composite: where A has edges, show B; otherwise keep A
          let d = edgeMaskComposite(pA, pB, w, h, params.thresh ?? 100, params.feather ?? 25, false);
          // Screen C lightly over the composite for halation glow
          d = blendPixels(d, pC, w, h, 'screen', 0.35);
          // Final light scan line pass to unify
          d = scanLines(d, w, h, sp, so * 0.4);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildVhsHalationParams, getParams: getVhsHalationParams, setParams: setVhsHalationParams, onReroll: onRerollVhsHalation },
      'bullethole-silver': { label: 'Bullet Hole Silver', desc: 'Two images riddled with circular punch holes at high chaos — perforated surfaces — then composited through silver gelatin stencil.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const holes = Math.round(params.holes ?? 20);
          const rad = params.radius ?? 0.08;
          // Riddle both at high chaos (more holes per image)
          const pA = circlePunch(dA, dB, w, h, holes, rad, rng);
          const pB = circlePunch(dB, dA, w, h, holes, rad, rng);
          // Silver gelatin: screen both perforated surfaces
          let d = blendPixels(pA, pB, w, h, 'screen', 0.65);
          // Silver toning via light gray (192, 192, 200)
          const silver = solidColor(w, h, 192, 192, 200);
          d = blendPixels(d, silver, w, h, 'screen', params.silver_str ?? 0.50);
          // Edge stencil vs C for gelatin structure
          d = edgeMaskComposite(dA, d, w, h, 80, params.feather ?? 10, true);
          d = blendPixels(d, dC, w, h, 'screen', 0.30);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildBulletholesSilverParams, getParams: getBulletholesSilverParams, setParams: setBulletholesSilverParams, onReroll: onRerollBulletholesSilver },
      'bullseye-wobble-displacement': { label: 'Bullseye Wobble Displacement', desc: "Double concentric destruction: one image bullseyed into clean rings, another wobble-eyed into drifting off-axis rings. The third image's gradient field displaces the composite.", inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const rings = Math.round(params.rings ?? 10);
          const rot = params.rotate ?? 0.6;
          const wob = params.wobble ?? 20;
          // A: clean bullseye; B: wobbled rings (off-axis centres)
          const bA = ringRotate(dA, w, h, rings, 0, rot, 0,   rng);
          const bB = ringRotate(dB, w, h, rings, 0, rot, wob, rng);
          // Screen the two together, then swirl-displace vs C
          let d = blendPixels(bA, bB, w, h, 'screen', 0.65);
          d = swirlDistort(d, w, h, params.swirl ?? 0.8);
          d = blendPixels(d, dC, w, h, 'overlay', 0.35);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildBullseyeWobbleDisplacementParams, getParams: getBullseyeWobbleDisplacementParams, setParams: setBullseyeWobbleDisplacementParams, onReroll: onRerollBullseyeWobbleDisplacement },
      'halftone-curvyscreen': { label: 'Halftone Curvy Screen', desc: 'Two-pass screen compositing: first halftone dot screen composites two images, then the result and a third image are composited through curvy line screen.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dt = params.dither_thresh ?? 128;
          const sp = params.scan_spacing ?? 4;
          // Pass 1: halftone dot screen composites A and B
          const bayer4 = [[0,8,2,10],[12,4,14,6],[3,11,1,9],[15,7,13,5]];
          const halftone = new Uint8ClampedArray(w * h * 4);
          for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
            const i = (y*w+x)*4;
            const lm = 0.299*dA[i]+0.587*dA[i+1]+0.114*dA[i+2];
            const bv = (bayer4[y%4][x%4]/16)*255;
            const v = lm+bv-128 > dt ? 255 : 0;
            halftone[i]=halftone[i+1]=halftone[i+2]=v; halftone[i+3]=255;
          }
          let d = lumaComposite(halftone, dA, dB, w, h, 128, 6, false);
          // Pass 2: curvy screen (scanLines approximation) composites result with C
