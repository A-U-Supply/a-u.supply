    // ─── Circle Limit ─────────────────────────────────────────────────────────

    function renderCircleLimit(imgs: (HTMLImageElement | null)[], params: Record<string, any>, _rng: () => number): Output[] {
      const radius: number = params['circ-radius'] ?? 0.95;
      const zoom: number   = params['circ-zoom']   ?? 6.0;
      const tile: boolean  = params['circ-tile']   ?? true;
      return [imgs[0], imgs[1], imgs[2]].map((img, idx) => {
        if (!img) return null;
        const W = img.naturalWidth, H = img.naturalHeight;
        const tmp = new OffscreenCanvas(W, H);
        tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
        const srcData = tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
        const cx = W/2, cy = H/2;
        const norm = Math.min(W, H) / 2;
        const r2Bound = radius*radius;
        const oc = new OffscreenCanvas(W, H);
        const od = oc.getContext('2d')!.createImageData(W, H);
        for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
          let zr = (x-cx)/norm, zi = (y-cy)/norm;
          const r2 = zr*zr + zi*zi;
          if (r2 > r2Bound) { const inv = r2Bound/r2; zr *= inv; zi *= inv; }
          const rEff = Math.sqrt(zr*zr + zi*zi);
          const rClamped = Math.min(rEff, radius*(1-1e-7));
          const rSafe = Math.max(rClamped, 1e-10);
          const hypR = 2 * Math.atanh(rClamped/radius);
          const factor = hypR/rSafe * (norm/(2*Math.PI)*zoom);
          const xIn = cx + factor*zr, yIn = cy + factor*zi;
          const [rv,gv,bv] = bilinearSample(srcData, W, H, xIn, yIn, tile);
          const i = (y*W+x)*4;
          od.data[i]=rv; od.data[i+1]=gv; od.data[i+2]=bv; od.data[i+3]=255;
        }
        oc.getContext('2d')!.putImageData(od, 0, 0);
        return { canvas: ocToCanvas(oc), label: `Image ${idx+1}`, mimeType: 'image/jpeg' as const };
      }).filter(Boolean) as Output[];
    }

