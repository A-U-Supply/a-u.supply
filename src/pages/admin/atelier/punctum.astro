        const libBtn = slotsEl.querySelector(`[data-slot-lib="${i}"]`) as HTMLButtonElement;

        drop.addEventListener('click', (e) => {
          if ((e.target as Element).closest('button')) return;
          file.click();
        });
        drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('drag-over'); });
        drop.addEventListener('dragleave', () => drop.classList.remove('drag-over'));
        drop.addEventListener('drop', (e) => {
          e.preventDefault();
          drop.classList.remove('drag-over');
          const f = e.dataTransfer?.files[0];
          if (f && f.type.startsWith('image/')) loadSlotFromBlob(i, f);
        });
        file.addEventListener('change', () => {
          if (file.files?.[0]) loadSlotFromBlob(i, file.files[0]);
        });

        const slotIdx = i;
        libBtn.addEventListener('click', () => openLibrary(slotIdx));

        // Restore any already-loaded image for this slot (after bot switch with same n)
        if (sourceImgs[i]) {
          thumb.src = sourceImgs[i]!.src;
          thumb.style.display = 'block';
          empty.style.display = 'none';
        }
      }
    }

    // ─── Core flow ─────────────────────────────────────────────────────────────

    function allSlotsReady(): boolean {
      const n = BOTS[currentBot].inputs;
      return sourceImgs.slice(0, n).every(img => img !== null);
    }

    function doReroll(seed?: number) {
      if (!allSlotsReady()) return;
      const bot = BOTS[currentBot];
      if (bot.hasRandomness) {
        currentSeed = seed !== undefined ? seed : (Math.random() * 2**31 | 0) || 1;
        rng = mulberry32(currentSeed);
      }
      const params = bot.getParams?.() ?? {};
      outputs = bot.render(sourceImgs, params, rng);
      activeOutputIdx = 0;
      renderStrip();
      setActiveOutput(0);
      enableActions(true);
    }

    function doRender() {
      if (!allSlotsReady()) return;
      const bot = BOTS[currentBot];
      // Re-render with same seed (only changes that don't affect layout, e.g. effect)
      if (bot.hasRandomness) rng = mulberry32(currentSeed);
      const params = bot.getParams?.() ?? {};
      outputs = bot.render(sourceImgs, params, rng);
      renderStrip();
      setActiveOutput(activeOutputIdx < outputs.length ? activeOutputIdx : 0);
    }

    function setActiveOutput(idx: number) {
      if (outputs.length === 0) return;
      activeOutputIdx = idx;

      const out = outputs[idx];
      stageCanvas.width  = out.canvas.width;
      stageCanvas.height = out.canvas.height;
      stageCanvas.getContext('2d')!.drawImage(out.canvas, 0, 0);
      stageCanvas.style.display = 'block';
      emptyEl.style.display = 'none';

      // Update strip active highlight
      stripEl.querySelectorAll('.pt-thumb').forEach((el, i) => {
        el.classList.toggle('pt-thumb--active', i === idx);
      });
    }

    function renderStrip() {
      if (outputs.length <= 1) {
        stripEl.style.display = 'none';
        return;
      }
      stripEl.style.display = 'flex';
      stripEl.innerHTML = '';

      outputs.forEach((o, i) => {
        const wrapper = document.createElement('div');
        wrapper.className = `pt-thumb${i === activeOutputIdx ? ' pt-thumb--active' : ''}`;
        wrapper.dataset.idx = String(i);

        const tc = document.createElement('canvas');
        tc.className = 'pt-thumb__canvas';
        tc.width = 90; tc.height = 90;
        const aspect = o.canvas.width / o.canvas.height;
        let sw = 90, sh = 90;
        if (aspect > 1) sh = Math.round(90 / aspect);
        else sw = Math.round(90 * aspect);
        const ox = Math.round((90 - sw) / 2), oy = Math.round((90 - sh) / 2);
        tc.getContext('2d')!.drawImage(o.canvas, ox, oy, sw, sh);

        const lbl = document.createElement('div');
        lbl.className = 'pt-thumb__label';
        lbl.textContent = o.label;

        wrapper.appendChild(tc);
        wrapper.appendChild(lbl);
        wrapper.addEventListener('click', () => setActiveOutput(i));
        stripEl.appendChild(wrapper);
      });
    }

    function enableActions(on: boolean) {
      rerollBtn.disabled   = !on || !BOTS[currentBot].hasRandomness;
      downloadBtn.disabled = !on;
      saveBtn.disabled     = !on;
      savePngBtn.disabled  = !on;
    }

    // ─── Switch bot ────────────────────────────────────────────────────────────

    function switchBot(id: string) {
      currentBot = id;
      const bot = BOTS[id];

      const descEl = document.getElementById('pt-bot-desc');
      if (descEl) descEl.textContent = bot?.desc ?? '';

      // Reset state
      sourceImgs = [null, null, null, null];
      sourceIds  = [null, null, null, null];
      outputs = [];
      activeOutputIdx = 0;
      stageCanvas.style.display = 'none';
      emptyEl.style.display = '';
      emptyText.textContent = `Load ${bot.inputs > 1 ? bot.inputs + ' images' : 'an image'} to begin`;
      stripEl.style.display = 'none';
      enableActions(false);

      buildSlots(bot);

      paramsEl.innerHTML = '';
      bot.buildParams?.();

      // re-roll only makes sense for randomness bots
      rerollBtn.disabled = !bot.hasRandomness;
    }

    // ─── Load image into slot ──────────────────────────────────────────────────

    function onSlotLoaded(slotIdx: number) {
      const thumb = document.getElementById(`slot-thumb-${slotIdx}`) as HTMLImageElement | null;
      const empty = document.getElementById(`slot-empty-${slotIdx}`);
      if (thumb && sourceImgs[slotIdx]) {
        thumb.src = sourceImgs[slotIdx]!.src;
        thumb.style.display = 'block';
        if (empty) empty.style.display = 'none';
      }
      if (allSlotsReady()) doReroll();
    }

    function loadSlotFromBlob(slotIdx: number, blob: Blob) {
      sourceIds[slotIdx] = null;
      const url = URL.createObjectURL(blob);
      const img = new Image();
      img.onload = () => {
        sourceImgs[slotIdx] = img;
        onSlotLoaded(slotIdx);
        URL.revokeObjectURL(url);
      };
      img.src = url;
    }

    function loadSlotFromUrl(slotIdx: number, url: string, sourceId: string | null, onReady?: () => void) {
      sourceIds[slotIdx] = sourceId;
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        sourceImgs[slotIdx] = img;
        onSlotLoaded(slotIdx);
        onReady?.();
      };
      img.onerror = () => (window as any).toast?.error('Failed to load image');
      img.src = url;
    }

    // ─── atelier metadata ──────────────────────────────────────────────────────

    function atelierMeta(): string {
      const bot = BOTS[currentBot];
      const ids = sourceIds.slice(0, bot.inputs);
      if (!ids[0]) return '';
      return JSON.stringify({
        atelier: 'punctum',
        v: 1,
        bot: currentBot,
        source_ids: ids,
        seed: currentSeed,
        output_idx: activeOutputIdx,
        params: bot.getParams?.() ?? {},
      });
    }

    // ─── Save / download ───────────────────────────────────────────────────────

    async function saveToOutputs(mimeType: string, filename: string, btn: HTMLButtonElement, label: string): Promise<string | null> {
      if (outputs.length === 0) return null;
      const out = outputs[activeOutputIdx];
      btn.disabled = true; btn.textContent = 'Saving…';
      return new Promise((resolve) => {
        out.canvas.toBlob(async (blob) => {
          if (!blob) { (window as any).toast?.error('Export failed'); btn.disabled = false; btn.textContent = label; resolve(null); return; }
          try {
            const fd = new FormData();
            fd.append('file', blob, filename);
            fd.append('tags', `${currentBot},atelier,punctum`);
            fd.append('output_index', 'outputs');
            const meta = atelierMeta();
            if (meta) fd.append('description', meta);
            const res = await fetch('/api/media/upload', { method: 'POST', body: fd, credentials: 'include' });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();
            (window as any).toast?.success('Saved to outputs');
            resolve(data.id || null);
          } catch (err: any) {
            (window as any).toast?.error(`Save failed: ${err.message}`);
            resolve(null);
          } finally { btn.disabled = false; btn.textContent = label; }
        }, mimeType, mimeType === 'image/jpeg' ? 0.85 : undefined);
      });
    }

    rerollBtn.addEventListener('click', () => doReroll());
    downloadBtn.addEventListener('click', () => {
      if (outputs.length === 0) return;
      const link = document.createElement('a');
      link.download = `${currentBot}.jpg`;
      link.href = outputs[activeOutputIdx].canvas.toDataURL('image/jpeg', 0.85);
      link.click();
    });
    saveBtn.addEventListener('click', () =>
      saveToOutputs('image/jpeg', `${currentBot}.jpg`, saveBtn, '☁ Save'));
    savePngBtn.addEventListener('click', () =>
      saveToOutputs('image/png', `${currentBot}.png`, savePngBtn, '☁ HD PNG'));

    // ─── Library modal ─────────────────────────────────────────────────────────

    function setLibTab(tab: 'library' | 'workspace') {
      activeLibTab = tab;
      libTabLibrary.classList.toggle('pt-modal__tab--active', tab === 'library');
      libTabWorkspace.classList.toggle('pt-modal__tab--active', tab === 'workspace');
      librarySearch.style.display = tab === 'library' ? '' : 'none';
    }

    function openLibrary(slotIdx: number) {
      pendingSlot = slotIdx;
      setLibTab('library');
      libraryOverlay.style.display = 'flex';
      librarySearch.value = '';
      loadLibrary('');
    }

    async function loadWorkspace() {
      libraryGrid.innerHTML = '<div class="pt-modal__loading loading-dots">Loading</div>';
      const wsId = localStorage.getItem('active_workspace_id');
      if (!wsId) {
        libraryGrid.innerHTML = '<div class="pt-modal__loading">No active workspace</div>';
        return;
      }
      try {
        const res = await fetch(`/api/workspaces/${wsId}/items?per_page=100`, { credentials: 'include' });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const images = (data.items || []).filter((i: any) => i.media_type === 'image');
        if (images.length === 0) {
          libraryGrid.innerHTML = '<div class="pt-modal__loading">No images in workspace</div>';
          return;
        }
        libraryGrid.innerHTML = '';
        for (const item of images) {
          const img = document.createElement('img');
          img.className = 'pt-lib-thumb';
          img.src = `/api/media/${item.media_item_id}/thumbnail`;
          img.alt = item.filename || '';
          img.loading = 'lazy';
          img.addEventListener('click', () => {
            libraryOverlay.style.display = 'none';
            loadSlotFromUrl(pendingSlot, `/api/media/${item.media_item_id}/file`, item.media_item_id);
          });
          libraryGrid.appendChild(img);
        }
      } catch (err: any) {
        libraryGrid.innerHTML = `<div class="pt-modal__loading">Error: ${err.message}</div>`;
      }
    }

    async function loadLibrary(q: string) {
      libraryGrid.innerHTML = '<div class="pt-modal__loading loading-dots">Loading</div>';
      try {
        const res = await fetch('/api/search', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query: q, media_types: ['image'], sort: 'created_at:desc', page: 1, per_page: 48, filters: {} }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const results: any[] = data.results || data.hits || [];
        if (results.length === 0) {
          libraryGrid.innerHTML = '<div class="pt-modal__loading">No images found</div>';
          return;
        }
        libraryGrid.innerHTML = '';
        for (const item of results) {
          const img = document.createElement('img');
          img.className = 'pt-lib-thumb';
          img.src = `/api/media/${item.id}/thumbnail`;
          img.alt = item.filename || '';
          img.loading = 'lazy';
          img.addEventListener('click', () => {
            libraryOverlay.style.display = 'none';
            loadSlotFromUrl(pendingSlot, `/api/media/${item.id}/file`, item.id);
          });
          libraryGrid.appendChild(img);
        }
      } catch (err: any) {
        libraryGrid.innerHTML = `<div class="pt-modal__loading">Error: ${err.message}</div>`;
      }
    }

    libraryClose.addEventListener('click', () => { libraryOverlay.style.display = 'none'; });
    libraryOverlay.addEventListener('click', (e) => { if (e.target === libraryOverlay) libraryOverlay.style.display = 'none'; });
    libTabLibrary.addEventListener('click', () => { setLibTab('library'); loadLibrary(librarySearch.value); });
    libTabWorkspace.addEventListener('click', () => { setLibTab('workspace'); loadWorkspace(); });
    librarySearch.addEventListener('input', () => {
      clearTimeout(librarySearchTimer);
      librarySearchTimer = setTimeout(() => loadLibrary(librarySearch.value), 300);
    });

    // ─── Bot selector ──────────────────────────────────────────────────────────

    botSelect.addEventListener('change', () => switchBot(botSelect.value));

    // ─── URL param auto-export ─────────────────────────────────────────────────

    const urlParams = new URLSearchParams(window.location.search);
    const botParam  = urlParams.get('bot');
    const autoExport = urlParams.get('autoexport');

    // Set bot from URL
    if (botParam && BOTS[botParam]) {
      botSelect.value = botParam;
    }

    // Initialize with correct bot (builds slots + params)
    switchBot(botSelect.value);

    if (autoExport) {
      // Restore params before loading images
      BOTS[currentBot].setParams?.(Object.fromEntries(urlParams.entries()));

      const seedParam = urlParams.get('seed');
      const seed = seedParam ? parseInt(seedParam, 10) : undefined;

      // Load all source images then save
      const bot = BOTS[currentBot];
      let loadCount = 0;
      const sourceCount = bot.inputs;

      const outputIdx = parseInt(urlParams.get('output_idx') ?? '0', 10);

      function onAllLoaded() {
        const mimeType = autoExport === 'png' ? 'image/png' : 'image/jpeg';
        const filename  = autoExport === 'png' ? `${currentBot}.png` : `${currentBot}.jpg`;
        doReroll(seed);
        // doReroll resets activeOutputIdx to 0; restore the saved index
        if (outputIdx > 0 && outputIdx < outputs.length) {
          setActiveOutput(outputIdx);
        }
        saveToOutputs(mimeType, filename, savePngBtn, '☁ HD PNG').then((newId) => {
          if (newId) window.location.href = `/admin/search/detail?id=${newId}`;
        });
      }

      for (let i = 0; i < sourceCount; i++) {
        const sid = urlParams.get(`source${i}`);
        if (sid) {
          loadSlotFromUrl(i, `/api/media/${sid}/file`, sid, () => {
            loadCount++;
            if (loadCount === sourceCount) onAllLoaded();
          });
        } else {
          loadCount++;
          if (loadCount === sourceCount) onAllLoaded();
        }
      }
    }

    // Cleanup on Astro view transitions
    document.addEventListener('astro:before-swap', () => {
      clearTimeout(librarySearchTimer);
    }, { once: true });

  });
</script>
