      'silver-displacement-dream': { label: 'Silver Displacement Dream', desc: 'Four images: one deepdreamed heavily, silver-stenciled with two others. The silver-toned hallucinated surface is then displacement-warped against the fourth.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: false, renderAsync: (imgs, _p, seed) => runSparagmosRecipe('silver-displacement-dream', imgs, seed), buildParams: () => {}, getParams: () => ({}), setParams: () => {} },
      'tectonic-overlap': { label: 'Tectonic Overlap', desc: 'Continental plates of image data, shifted and overlapping. Four images shattered into irregular polygons, scatter-collaged with rotation. Seam carving warps the fault lines.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const pieces = Math.round(params.pieces ?? 25);
          const mr = params.mix_ratio ?? 0.50;
          const sh = Math.round(params.shift ?? 25);
          // Progressive tectonic fragmentation: each layer shears into the next
          let d = gridFragment(dA, dA, dB, w, h, pieces, mr, rng);
          d = gridFragment(d, d, dC, w, h, pieces, mr * 0.8, rng);
          d = gridFragment(d, d, dD, w, h, pieces, mr * 0.6, rng);
          // Channel shift to simulate fault line aberration
          d = channelShift(d, w, h, sh, -Math.round(sh * 0.7));
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildTectonicOverlapParams, getParams: getTectonicOverlapParams, setParams: setTectonicOverlapParams, onReroll: onRerollTectonicOverlap },
      'binary-archaeology': { label: 'Binary Archaeology', desc: 'Each of the four images is dithered to a different binary palette — different dithering algorithms reducing each to its own distinct pattern of black and white.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const base = params.threshold ?? 128;
          const bs = params.blend_str ?? 0.55;
          // Four Bayer matrices at different scales — each "algorithm" for the 4 layers
          const bayer2 = [[0,2],[3,1]];
          const bayer4 = [[0,8,2,10],[12,4,14,6],[3,11,1,9],[15,7,13,5]];
          const bayer8 = [[0,32,8,40,2,34,10,42],[48,16,56,24,50,18,58,26],[12,44,4,36,14,46,6,38],[60,28,52,20,62,30,54,22],[3,35,11,43,1,33,9,41],[51,19,59,27,49,17,57,25],[15,47,7,39,13,45,5,37],[63,31,55,23,61,29,53,21]];
          function dither(d: Uint8ClampedArray, mat: number[][], size: number, thresh: number): Uint8ClampedArray {
            const out = new Uint8ClampedArray(w * h * 4);
            const scale = 255 / (size * size);
            for (let y = 0; y < h; y++) {
              for (let x = 0; x < w; x++) {
                const i = (y * w + x) * 4;
                const luma = 0.299 * d[i] + 0.587 * d[i+1] + 0.114 * d[i+2];
                const bv = mat[y % size][x % size] * scale;
                const v = luma + bv - 128 > thresh ? 255 : 0;
                out[i] = out[i+1] = out[i+2] = v; out[i+3] = 255;
              }
            }
            return out;
          }
          // Each image dithered with a different matrix/threshold offset
          const dA2 = dither(dA, bayer2, 2, base);
          const dB4 = dither(dB, bayer4, 4, base - 20);
          const dC8 = dither(dC, bayer8, 8, base + 20);
          const dD4 = dither(dD, bayer4, 4, base + 40);
          // Layer them via screen/difference blends
          let d = blendPixels(dA2, dB4, w, h, 'screen', bs);
          d = blendPixels(d,   dC8, w, h, 'difference', bs * 0.7);
          d = blendPixels(d,   dD4, w, h, 'screen', bs * 0.5);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildBinaryArchaeologyParams, getParams: getBinaryArchaeologyParams, setParams: setBinaryArchaeologyParams, onReroll: onRerollBinaryArchaeology },
      'collage-mask-collage': { label: 'Collage Mask Collage', desc: "Two images collaged into a mosaic grid, then a third used as an edge stencil to cut through the grid — the mosaic surfaces revealed only where C's structure allows.", inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          // A+B mosaic grid
          const grid = gridFragment(dA, dA, dB, w, h, Math.round(params.pieces ?? 16), params.mix ?? 0.5, rng);
          // C's edges as stencil: where C has edges → show grid; elsewhere → show D
          const cEdges = edgeMap(dC, w, h, params.feather ?? 12);
          const d = lumaComposite(cEdges, grid, dD, w, h, params.thresh ?? 80, 0, false);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildCollageMaskCollageParams, getParams: getCollageMaskCollageParams, setParams: setCollageMaskCollageParams, onReroll: onRerollCollageMaskCollage },
      'collage-surgery': { label: 'Collage Surgery', desc: 'Four images cut into strips and edge-masked three times in alternating rounds — each pass strips away context to reveal what lies beneath the surface.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          // Horizontal strip collage: assign each strip round-robin A→B→C→D
          const strips = Math.max(4, Math.round(params.strips ?? 12));
          const stripH = Math.max(1, Math.floor(h / strips));
          const sources = [dA, dB, dC, dD];
          const collage  = new Uint8ClampedArray(w * h * 4);
          for (let s = 0; s < strips; s++) {
            const src  = sources[s % 4];
            const yStart = s * stripH;
            const yEnd   = s === strips - 1 ? h : Math.min(h, yStart + stripH);
            for (let y = yStart; y < yEnd; y++) {
              for (let x = 0; x < w; x++) {
                const i = (y * w + x) * 4;
                collage[i] = src[i]; collage[i+1] = src[i+1]; collage[i+2] = src[i+2]; collage[i+3] = 255;
              }
            }
          }
          const f = params.feather ?? 8;
          const th = params.thresh ?? 110;
          // Three alternating edge masks progressively cutting deeper
          let d = edgeMaskComposite(dA, collage, w, h, th, f, false);
          d     = edgeMaskComposite(dB, d,       w, h, th, f + 4, false);
          d     = edgeMaskComposite(dC, d,       w, h, th, f + 8, false);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildCollageSurgeryParams, getParams: getCollageSurgeryParams, setParams: setCollageSurgeryParams, onReroll: onRerollCollageSurgery },
      'collage-through-glass': { label: 'Collage Through Glass', desc: "Three images are mosaiced into a composite grid. Image D, PCA-reduced to a single structural component, provides a ghostly lens over the mosaic surface.", inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          // Mosaic A, B, C into composite grid
          let mosaic = gridFragment(dA, dA, dB, w, h, Math.round(params.pieces ?? 25), params.mix_ratio ?? 0.55, rng);
          mosaic = gridFragment(mosaic, mosaic, dC, w, h, Math.round(params.pieces ?? 25), (params.mix_ratio ?? 0.55) * 0.7, rng);
          // D provides PCA ghost lens: highpass extracts structural component
          const ghost = highpassRGB(dD, w, h, Math.round(params.hp_radius ?? 8));
          // Screen ghost over mosaic
          const d = blendPixels(mosaic, ghost, w, h, 'screen', params.ghost_str ?? 0.50);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildCollageGlassParams, getParams: getCollageGlassParams, setParams: setCollageGlassParams, onReroll: onRerollCollageGlass },
      'contrast-surgery': { label: 'Contrast Surgery', desc: 'Image A undergoes extreme channel surgery — massive RGB offsets pull its color registers apart until the content nearly dissolves into chromatic aberration.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
