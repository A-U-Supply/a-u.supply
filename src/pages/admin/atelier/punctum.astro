      'lathe-displacement': { label: 'Lathe Displacement', desc: 'Two images lathe-turned — dozens of thin concentric rings each independently rotated into agate-like surfaces — then displacement-stenciled against a third.', inputs: 3, inputLabels: ['Image A', 'Image B', 'Image C'], hasRandomness: true,
        render: (imgs, params, rng) => {
