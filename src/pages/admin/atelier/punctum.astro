    // ─── Joukowski ────────────────────────────────────────────────────────────

    function renderJoukowski(imgs: (HTMLImageElement | null)[], params: Record<string, any>, _rng: () => number): Output[] {
      const scale = params['jou-scale'] ?? 1.5;
      const shiftR = params['jou-shift-r'] ?? 0.3;
      const shiftI = params['jou-shift-i'] ?? 0.0;
      return [imgs[0], imgs[1], imgs[2]].map((img, idx) => {
        if (!img) return null;
        const W = img.naturalWidth, H = img.naturalHeight;
        const tmp = new OffscreenCanvas(W, H);
        tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
        const srcData = tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
        const cx = W / 2, cy = H / 2;
        const norm = Math.min(W, H) / 2 / scale;
        const oc = new OffscreenCanvas(W, H);
        const od = oc.getContext('2d')!.createImageData(W, H);
        for (let y = 0; y < H; y++) {
          for (let x = 0; x < W; x++) {
            const zr = (x - cx) / norm + shiftR;
            const zi = (y - cy) / norm + shiftI;
            const r2 = Math.max(zr*zr + zi*zi, 1e-6);
            const xIn = cx + (zr + zr/r2 - shiftR) * norm;
            const yIn = cy + (zi - zi/r2 - shiftI) * norm;
            const [rv, gv, bv] = bilinearSample(srcData, W, H, xIn, yIn, true);
            const i = (y * W + x) * 4;
            od.data[i] = rv; od.data[i+1] = gv; od.data[i+2] = bv; od.data[i+3] = 255;
          }
        }
        oc.getContext('2d')!.putImageData(od, 0, 0);
        return { canvas: ocToCanvas(oc), label: `Image ${idx + 1}`, mimeType: 'image/jpeg' };
      }).filter(Boolean) as Output[];
    }

