    // ─── Curl Noise ───────────────────────────────────────────────────────────

    function renderCurlNoise(imgs: (HTMLImageElement | null)[], params: Record<string, any>, rng: () => number): Output[] {
      const strength: number = params['cn-strength'] ?? 120;
      const scale: number    = params['cn-scale']    ?? 0.20;
      const octaves: number  = params['cn-octaves']  ?? 4;
      const tile: boolean    = params['cn-tile']     ?? false;
      return [imgs[0], imgs[1], imgs[2]].map((img, idx) => {
        if (!img) return null;
        const W = img.naturalWidth, H = img.naturalHeight;
        // Build fBm potential
        const potential = new Float32Array(W * H);
        let totalAmp = 0;
        for (let oct = 0; oct < octaves; oct++) {
          const amp = Math.pow(0.5, oct);
          const sigma = Math.max(1, scale * Math.min(W, H) * Math.pow(0.5, oct));
          totalAmp += amp;
          const noiseRaw = new Uint8ClampedArray(W * H * 4);
          for (let i = 0; i < W * H; i++) {
            const u1 = Math.max(rng(), 1e-10), u2 = rng();
            const g = Math.sqrt(-2*Math.log(u1)) * Math.cos(2*Math.PI*u2);
            const v = Math.max(0, Math.min(255, Math.round(g*40+128)));
            noiseRaw[i*4]=noiseRaw[i*4+1]=noiseRaw[i*4+2]=v; noiseRaw[i*4+3]=255;
          }
          const blurNoise = applyBlur(noiseRaw, W, H, sigma);
          for (let i = 0; i < W * H; i++) potential[i] += amp * (blurNoise[i*4]/128 - 1);
        }
        for (let i = 0; i < W * H; i++) potential[i] /= totalAmp;
        // 2D curl: vx = ∂φ/∂y, vy = -∂φ/∂x
        const vx = new Float32Array(W * H), vy = new Float32Array(W * H);
        for (let y = 1; y < H-1; y++) for (let x = 1; x < W-1; x++) {
          const i = y*W+x;
          vx[i] = (potential[(y+1)*W+x] - potential[(y-1)*W+x]) / 2;
          vy[i] = -(potential[y*W+(x+1)] - potential[y*W+(x-1)]) / 2;
        }
        // Normalize by p99 magnitude
        const mag = new Float32Array(W * H);
        for (let i = 0; i < W * H; i++) mag[i] = Math.sqrt(vx[i]*vx[i]+vy[i]*vy[i]);
        const magSorted = Array.from(mag).sort((a,b)=>a-b);
        const p99 = magSorted[Math.floor(magSorted.length*0.99)] + 1e-6;
        for (let i = 0; i < W * H; i++) { vx[i] = vx[i]/p99*strength; vy[i] = vy[i]/p99*strength; }
        // Backward map
        const tmp = new OffscreenCanvas(W, H);
        tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
        const srcData = tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
        const oc = new OffscreenCanvas(W, H);
        const od = oc.getContext('2d')!.createImageData(W, H);
        for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
          const i = y*W+x;
          const [rv,gv,bv] = bilinearSample(srcData, W, H, x-vx[i], y-vy[i], tile);
          od.data[i*4]=rv; od.data[i*4+1]=gv; od.data[i*4+2]=bv; od.data[i*4+3]=255;
        }
        oc.getContext('2d')!.putImageData(od, 0, 0);
        return { canvas: ocToCanvas(oc), label: `Image ${idx+1}`, mimeType: 'image/jpeg' as const };
      }).filter(Boolean) as Output[];
    }

