          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildDissolveCascadeParams, getParams: getDissolveCascadeParams, setParams: setDissolveCascadeParams, onReroll: onRerollDissolveCascade },
      'double-masked-collage': { label: 'Double Masked Collage', desc: 'A double masking sandwich: fragment, edge-mask, scatter-collage, luminance-mask again. Images A and B are Voronoi-fragmented — broken into organic cells.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const pieces = Math.round(params.pieces ?? 36);
          const mr = params.mix_ratio ?? 0.55;
          const f = params.feather ?? 10;
          // Fragment A and B (simulates Voronoi-like cell fragmentation)
          let d = gridFragment(dA, dA, dB, w, h, pieces, mr, rng);
          // Edge-mask the fragment vs C
          d = edgeMaskComposite(d, dC, w, h, params.thresh ?? 110, f, false);
          // Scatter-collage the result with C
          d = gridFragment(d, d, dC, w, h, pieces, mr * 0.7, rng);
          // Second masking: luma-mask vs D
          d = lumaComposite(dA, d, dD, w, h, params.thresh ?? 110, f, false);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildDoubleMaskedCollageParams, getParams: getDoubleMaskedCollageParams, setParams: setDoubleMaskedCollageParams, onReroll: onRerollDoubleMaskedCollage },
      'fracture-and-mask': { label: 'Fracture and Mask', desc: 'A shatter-fragment sandwich with edge and luminance masking on either side. Images A and B are shatter-fragmented together — broken into irregular shards.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const pieces = Math.round(params.pieces ?? 36);
          const mr = params.mix_ratio ?? 0.55;
          const f = params.feather ?? 10;
          // Fragment A and B together into a shattered composite
          let d = gridFragment(dA, dA, dB, w, h, pieces, mr, rng);
          // Edge mask the fragment using its own structure → reveal C
          d = edgeMaskComposite(d, dC, w, h, params.thresh ?? 110, f, false);
          // Luma mask the result against D for the second masking layer
          d = lumaComposite(dA, d, dD, w, h, params.thresh ?? 110, f * 1.5, false);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildFractureAndMaskParams, getParams: getFractureAndMaskParams, setParams: setFractureAndMaskParams, onReroll: onRerollFractureAndMask },
      'gradient-reveal': { label: 'Gradient Reveal', desc: 'A three-stage revelation where each step peels back a different layer. Images A and B are blended at overlay mode, their tonal geometries multiplied together.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          let d = blendPixels(dA, dB, w, h, 'overlay', 1.0);
          d = lumaComposite(d, d, dC, w, h, params.thresh ?? 120, params.feather ?? 10, false);
          d = blendPixels(d, dD, w, h, 'multiply', params.mult_str ?? 0.55);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildGradientRevealParams, getParams: getGradientRevealParams, setParams: setGradientRevealParams, onReroll: onRerollGradientReveal },
      'interference-mask': { label: 'Interference Mask', desc: 'Images A and B are blended at difference mode — each pixel becomes the absolute distance between the two images, a map of where they diverge. That divergence becomes a mask.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const interfere = blendPixels(dA, dB, w, h, 'difference', 1.0);
          // Where A and B diverge (bright interference) → show C; where they agree → show D
          let d = lumaComposite(interfere, dC, dD, w, h, params.thresh ?? 100, params.feather ?? 12, false);
          d = blendPixels(d, interfere, w, h, 'screen', params.screen_str ?? 0.4);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildInterferenceMaskParams, getParams: getInterferenceMaskParams, setParams: setInterferenceMaskParams, onReroll: onRerollInterferenceMask },
      'layered-cutwork': { label: 'Layered Cutwork', desc: "Three sequential rounds of mask then collage then mask: the image accumulates wounds with each pass. First, A's luminance cuts into B — bright areas reveal B beneath A.", inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const f = params.feather ?? 10;
          // Round 1: A's luma cuts into B (bright A → B shows through)
          let d = lumaComposite(dA, dB, dA, w, h, params.t1 ?? 120, f, false);
          // Round 2: edge mask the result vs C
          d     = edgeMaskComposite(d, dC, w, h, params.thresh ?? 110, f, false);
          // Round 3: A's luma again cuts into D (lower threshold → wider reveal)
          d     = lumaComposite(dA, dD, d, w, h, params.t2 ?? 80, f, false);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildLayeredCutworkParams, getParams: getLayeredCutworkParams, setParams: setLayeredCutworkParams, onReroll: onRerollLayeredCutwork },
      'letterpress': { label: 'Letterpress', desc: 'Image A is dithered with Atkinson, which creates the tight, typographic dot-and-space pattern that letterpress printing once left in paper. The dither stencil cuts into B.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const thresh = params.threshold ?? 128;
          // Bayer 4x4 ordered dither — simulates letterpress dot pattern
          const bayer = [[ 0, 8, 2,10],[ 12,4,14, 6],[ 3,11, 1, 9],[15, 7,13, 5]];
          const dithered = new Uint8ClampedArray(w * h * 4);
          for (let y = 0; y < h; y++) {
            for (let x = 0; x < w; x++) {
              const i = (y * w + x) * 4;
              const luma = 0.299 * dA[i] + 0.587 * dA[i+1] + 0.114 * dA[i+2];
              const bv = (bayer[y % 4][x % 4] / 16) * 255;
              const v = luma + bv - 128 > thresh ? 255 : 0;
              dithered[i] = dithered[i+1] = dithered[i+2] = v; dithered[i+3] = 255;
            }
          }
          // The dither stencil (dark = 0) cuts A into B: dark areas of dithered → show B
          let d = lumaMask(dithered, dB, w, h, 128, params.feather ?? 3, true);
          // C and D provide background depth: screen C lightly, multiply D
          d = blendPixels(d, dC, w, h, 'screen', params.screen_str ?? 0.35);
          d = blendPixels(d, dD, w, h, 'multiply', 0.25);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildLetterpressParams, getParams: getLetterpressParams, setParams: setLetterpressParams, onReroll: onRerollLetterpress },
      'luminance-layers': { label: 'Luminance Layers', desc: 'Four images revealed through four different luminance thresholds of the same reference source. Image A is processed and used as the mask for all four revelations.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const f = params.feather ?? 10;
          // A is reference mask only: luma<t1→B, t1-t2→C, >t2→D; then screen A back as 4th layer
          let d = lumaComposite(dA, dC, dB, w, h, params.t1 ?? 80, f, false);  // >t1 → C
          d     = lumaComposite(dA, dD, d,  w, h, params.t2 ?? 160, f, false); // >t2 → D
          d     = blendPixels(d, dA, w, h, 'screen', params.screen_str ?? 0.35);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildLuminanceLayersParams, getParams: getLuminanceLayersParams, setParams: setLuminanceLayersParams, onReroll: onRerollLuminanceLayers },
      'mask-cascade': { label: 'Mask Cascade', desc: 'Four images layered through four successive mask operations, each using a different mask source — luminance, then edges, then noise, then a gradient — in cascading passes.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const f = params.feather ?? 10;
          // Pass 1: luminance — A's luma → A or B
          let d = lumaComposite(dA, dA, dB, w, h, params.luma_thresh ?? 120, f, false);
          // Pass 2: edges — result's edges cut in C
          d     = edgeMaskComposite(d, dC, w, h, params.edge_thresh ?? 110, f, false);
          // Pass 3: noise mask → D fills random regions
          const noise = noisePixels(w, h, rng);
          d     = lumaComposite(noise, d, dD, w, h, params.noise_thresh ?? 128, f, false);
          // Pass 4: top-to-bottom gradient tints the whole thing
          const grad = new Uint8ClampedArray(w * h * 4);
          for (let y = 0; y < h; y++) {
            const v = Math.round(255 * (1 - y / h));
            for (let x = 0; x < w; x++) { const i = (y*w+x)*4; grad[i]=grad[i+1]=grad[i+2]=v; grad[i+3]=255; }
          }
          d = blendPixels(d, grad, w, h, 'multiply', 0.25);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildMaskCascadeParams, getParams: getMaskCascadeParams, setParams: setMaskCascadeParams, onReroll: onRerollMaskCascade },
      'mask-erosion': { label: 'Mask Erosion', desc: 'Three sequential edge masks with increasing feather — a progressive erosion where each pass softens the structural cuts further and further.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          let d = edgeMaskComposite(dA, dB, w, h, params.thresh ?? 110, params.feather1 ?? 5,  false);
          d     = edgeMaskComposite(d,  dC, w, h, params.thresh ?? 110, params.feather2 ?? 14, false);
          d     = edgeMaskComposite(d,  dD, w, h, params.thresh ?? 110, params.feather3 ?? 28, false);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildMaskErosionParams, getParams: getMaskErosionParams, setParams: setMaskErosionParams, onReroll: onRerollMaskErosion },
      'negative-space': { label: 'Negative Space', desc: "Two masking operations, each using the opposite of what the other reveals. Image A's dark regions cut out shapes and fill them with B: the negative space becomes positive content.", inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          // Dark A → B (inverted: dark regions become positive content)
          let d = lumaMask(dA, dB, w, h, params.thresh ?? 110, params.feather ?? 10, true);
          // Then bright A reveals C over the result
          d = lumaMask(dA, dC, d, w, h, params.thresh ?? 110, params.feather ?? 10, false);
          d = blendPixels(d, dD, w, h, 'screen', params.screen_str ?? 0.45);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildNegativeSpaceParams, getParams: getNegativeSpaceParams, setParams: setNegativeSpaceParams, onReroll: onRerollNegativeSpace },
      'palimpsest': { label: 'Palimpsest', desc: 'A manuscript overwritten and overwritten again. Each layer bleeds through based on luminance. Four images layered through progressively lower thresholds — each layer more revealed.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const f = params.feather ?? 10;
          // Layer from bottom up: luma<t1→D, t1-t2→C, t2-t3→B, >t3→A
          let d = lumaComposite(dA, dC, dD, w, h, params.t1 ?? 50,  f, false); // >t1 → C
          d     = lumaComposite(dA, dB, d,  w, h, params.t2 ?? 110, f, false); // >t2 → B
          d     = lumaComposite(dA, dA, d,  w, h, params.t3 ?? 170, f, false); // >t3 → A itself
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildPalimpsestParams, getParams: getPalimpsestParams, setParams: setPalimpsestParams, onReroll: onRerollPalimpsest },
      'photogram': { label: 'Photogram', desc: "In the darkroom, a photogram is made by placing objects directly on light-sensitive paper. The object's silhouette burns into the emulsion. Here that process is simulated digitally.", inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          // Bright A (exposed paper) → B; dark A (silhouette) → D
          let d = lumaComposite(dA, dB, dD, w, h, params.thresh ?? 128, params.feather ?? 4, false);
          // C bleeds at screen for paper grain / texture
          d = blendPixels(d, dC, w, h, 'screen', params.screen_str ?? 0.35);
          const sh = Math.round(params.shift ?? 15);
          d = channelShift(d, w, h, sh, -Math.round(sh * 0.8));
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildPhotogramParams, getParams: getPhotogramParams, setParams: setPhotogramParams, onReroll: onRerollPhotogram },
      'silhouette-collage': { label: 'Silhouette Collage', desc: "Image A is PCA-decomposed to 2 principal components — stripped to the barest structural silhouette. That silhouette is imposed over a collage of the remaining images.", inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          // Approximate PCA silhouette: extreme contrast reduction via highpass + threshold
          const hp = highpassRGB(dA, w, h, 8);
          const silhouette = new Uint8ClampedArray(w * h * 4);
          for (let i = 0; i < w * h * 4; i += 4) {
            const luma = 0.299 * hp[i] + 0.587 * hp[i+1] + 0.114 * hp[i+2];
            const v = luma > (params.threshold ?? 110) ? 255 : 0;
            silhouette[i] = silhouette[i+1] = silhouette[i+2] = v; silhouette[i+3] = 255;
          }
          // Collage of B, C, D as background
          let bg = gridFragment(dB, dB, dC, w, h, 25, 0.55, rng);
          bg = gridFragment(bg, bg, dD, w, h, 25, 0.4, rng);
          // Impose silhouette over collage: bright silhouette → keep bg; dark → show A
          const d = lumaComposite(silhouette, bg, dA, w, h, 128, params.feather ?? 8, false);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildSilhouetteCollageParams, getParams: getSilhouetteCollageParams, setParams: setSilhouetteCollageParams, onReroll: onRerollSilhouetteCollage },
      'sixshooter-halation-corrupt': { label: 'Six Shooter Halation Corrupt', desc: 'Four images: two six-shootered into scattered circular displacements, halation-edge composited through the third. The organic grain boundary dissolves into byte corruption.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: async (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const rad = params.radius ?? 0.18;
          // Six-shoot A and B
          const sA = circlePunch(dA, dB, w, h, 6, rad, rng);
          const sB = circlePunch(dB, dA, w, h, 6, rad, rng);
          // Wide-feather halation edge composite
          let d = edgeMaskComposite(sA, sB, w, h, 80, params.feather ?? 20, false);
          // Screen C for third-image presence
          d = blendPixels(d, dC, w, h, 'screen', 0.35);
          // D as overlay
          d = blendPixels(d, dD, w, h, 'overlay', 0.25);
          // JPEG corruption
          return [{ canvas: await jpegDestroy(pixelsToCanvas(d, w, h), params.quality ?? 4, 4), mimeType: 'image/jpeg' }];
        }, buildParams: buildSixshooterHalationCorruptParams, getParams: getSixshooterHalationCorruptParams, setParams: setSixshooterHalationCorruptParams, onReroll: onRerollSixshooterHalationCorrupt },
      'spectral-mask': { label: 'Spectral Mask', desc: 'Four images processed spectrally and then masked in pairs. Image A is spectrally shifted to emphasize its mid-range structure. The shifted and raw versions mask against each other.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const r = Math.round(params.hp_radius ?? 5);
          // Spectrally shift A: highpass extracts mid-range structure
          const hpA = highpassRGB(dA, w, h, r);
          // Shifted A masks against raw A to reveal B
          let d = lumaComposite(hpA, dA, dB, w, h, 80, params.feather ?? 10, false);
          // Same process for B vs C
          const hpB = highpassRGB(dB, w, h, r + 2);
          d = lumaComposite(hpB, d, dC, w, h, 80, params.feather ?? 10, false);
          // D provides final spectral screen
          d = blendPixels(d, highpassRGB(dD, w, h, r), w, h, 'screen', params.screen_str ?? 0.45);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildSpectralMaskParams, getParams: getSpectralMaskParams, setParams: setSpectralMaskParams, onReroll: onRerollSpectralMask },
      'stencil-burn': { label: 'Stencil Burn', desc: 'Image A is dithered to a near-binary stencil — its shapes reduced to stark positive and negative space. That stencil is used as a hard luminance mask cutting into B, C, and D.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const thresh = params.thresh ?? 128;
          const f      = params.feather ?? 2;
          // Low band → B; mid band → C; high band → D
          let d = lumaComposite(dA, dC, dB, w, h, Math.round(thresh * 0.5), f, false);
          d     = lumaComposite(dA, dD, d,  w, h, thresh, f, false);
          // Burn A back via multiply for dark plate quality
          d = blendPixels(d, dA, w, h, 'multiply', params.mult_str ?? 0.3);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildStencilBurnParams, getParams: getStencilBurnParams, setParams: setStencilBurnParams, onReroll: onRerollStencilBurn },
      'stratum-shift': { label: 'Stratum Shift', desc: 'Four images built into geological strata through strip collage, then seam-carved to warp the fault lines. Luminance masking cuts the first geological layer.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          // Build 4 horizontal strata, each shifted by a different amount
          const sources = [dA, dB, dC, dD];
          const stripH  = Math.max(1, Math.floor(h / 4));
          const maxShift = Math.round(params.shift ?? 40);
          const strata  = new Uint8ClampedArray(w * h * 4);
          for (let i = 0; i < 4; i++) {
            const src    = sources[i];
            const xShift = Math.round(lerp(-maxShift, maxShift, i / 3));
            const yStart = i * stripH;
            const yEnd   = i === 3 ? h : Math.min(h, yStart + stripH);
            for (let y = yStart; y < yEnd; y++) {
              for (let x = 0; x < w; x++) {
                const srcX = Math.min(w - 1, Math.max(0, x + xShift));
                const oi = (y * w + x) * 4;
                const si = (y * w + srcX) * 4;
                strata[oi]     = src[si];
                strata[oi + 1] = src[si + 1];
                strata[oi + 2] = src[si + 2];
                strata[oi + 3] = 255;
              }
            }
          }
          // Luma mask using A to cut through strata
          const d = lumaComposite(dA, strata, dB, w, h, params.luma_thresh ?? 110, params.feather ?? 10, false);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildStratumShiftParams, getParams: getStratumShiftParams, setParams: setStratumShiftParams, onReroll: onRerollStratumShift },
      'structural-echo': { label: 'Structural Echo', desc: "Image A's edge structure is applied three times to create a progressive echo effect. Each application uses a wider feather, creating a ghost that softens with each pass.", inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          // Start with B; A's edges progressively reveal C then D with widening feather
          let d = edgeMaskComposite(dA, dB, w, h, params.thresh ?? 110, params.feather1 ?? 4,  false);
          d     = edgeMaskComposite(dA, dC, w, h, params.thresh ?? 110, params.feather2 ?? 14, false);
          d     = edgeMaskComposite(dA, dD, w, h, params.thresh ?? 110, params.feather3 ?? 30, false);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildStructuralEchoParams, getParams: getStructuralEchoParams, setParams: setStructuralEchoParams, onReroll: onRerollStructuralEcho },
      'surveillance-decay': { label: 'Surveillance Decay', desc: 'Four feeds arranged in the classic CCTV quad-view. Each feed has already been corrupted by its own accumulation of errors — byte corruption, CRT noise, VHS bleed.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          // Determine output size from first image
          const { w: wA, h: hA } = getPixels(imgs[0]!);
          const W = wA, H = hA;
          const hw = Math.floor(W / 2), hh = Math.floor(H / 2);
          const sp = params.scan_spacing ?? 3;
          const so = params.scan_opacity ?? 0.40;
          const sh = Math.round(params.shift ?? 15);
          // Process each feed: scanLines + channelShift with slightly different params per quadrant
          const feeds = imgs.map((img, i) => {
            const px = getPixels(img!);
            const d = resizeToMatch(px.d, px.w, px.h, hw, hh);
            const offsets = [[sh, -Math.round(sh*0.6)], [-Math.round(sh*0.7), Math.round(sh*0.5)], [Math.round(sh*0.4), -sh], [-Math.round(sh*0.5), Math.round(sh*0.8)]];
            const [oR, oB] = offsets[i % 4];
            return channelShift(scanLines(d, hw, hh, sp + (i % 2), so + i * 0.05), hw, hh, oR, oB);
          });
          // Composite quad into full canvas
          const out = new Uint8ClampedArray(W * H * 4);
          const place = (src: Uint8ClampedArray, ox: number, oy: number) => {
            for (let y = 0; y < hh; y++) {
              for (let x = 0; x < hw; x++) {
                const si = (y * hw + x) * 4;
                const di = ((oy + y) * W + (ox + x)) * 4;
                out[di] = src[si]; out[di+1] = src[si+1]; out[di+2] = src[si+2]; out[di+3] = 255;
              }
            }
          };
          place(feeds[0]!, 0,  0);
          place(feeds[1]!, hw, 0);
          place(feeds[2]!, 0,  hh);
          place(feeds[3]!, hw, hh);
          return [{ canvas: pixelsToCanvas(out, W, H), mimeType: 'image/png' }];
        }, buildParams: buildSurveillanceDecayParams, getParams: getSurveillanceDecayParams, setParams: setSurveillanceDecayParams, onReroll: onRerollSurveillanceDecay },
      'text-ghost': { label: 'Text Ghost', desc: "Image A is PCA-decomposed to just 1-2 principal components — its texture and color stripped away until only the structural ghost remains. That ghost is screened over a collage.", inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          // Approximate PCA ghost: high-radius highpass strips texture, leaving structural outline
          const ghost = highpassRGB(dA, w, h, 12);
          // Further soften — threshold to silhouette-like ghost
          const thresh = params.threshold ?? 110;
          const ghostSoft = new Uint8ClampedArray(w * h * 4);
          for (let i = 0; i < w * h * 4; i += 4) {
            const luma = 0.299 * ghost[i] + 0.587 * ghost[i+1] + 0.114 * ghost[i+2];
            const alpha = Math.min(1, Math.max(0, (luma - thresh + (params.feather ?? 12)) / Math.max(1, params.feather ?? 12)));
            ghostSoft[i] = ghostSoft[i+1] = ghostSoft[i+2] = Math.round(luma * alpha); ghostSoft[i+3] = 255;
          }
          // Collage of B, C, D
          let bg = gridFragment(dB, dB, dC, w, h, 25, 0.55, rng);
          bg = gridFragment(bg, bg, dD, w, h, 20, 0.4, rng);
          // Screen ghost over collage
          const d = blendPixels(bg, ghostSoft, w, h, 'screen', params.screen_str ?? 0.45);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildTextGhostParams, getParams: getTextGhostParams, setParams: setTextGhostParams, onReroll: onRerollTextGhost },
      'threshold-cascade': { label: 'Threshold Cascade', desc: 'Four mask_composite operations at four ascending threshold bands — 40, 80, 150, and 200 — each cutting a different pair of images at a different tonal level.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const f = params.feather ?? 8;
          // Each pass uses the NEXT image's luma as the mask — cascading structure
          let d = lumaComposite(dA, dA, dB, w, h, params.t1 ?? 40,  f, false); // A's luma: bright→A, dark→B
          d     = lumaComposite(dB, d,  dC, w, h, params.t2 ?? 80,  f, false); // B's luma: bright→prev, dark→C
          d     = lumaComposite(dC, d,  dD, w, h, params.t3 ?? 150, f, false); // C's luma: bright→prev, dark→D
          // Final edge crunch using A's structure
          d     = edgeMaskComposite(dA, d, w, h, params.edge_thresh ?? 120, f, false);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildThresholdCascadeParams, getParams: getThresholdCascadeParams, setParams: setThresholdCascadeParams, onReroll: onRerollThresholdCascade },
      'torn-collage': { label: 'Torn Collage', desc: 'Four images shattered like a mirror dropped on concrete. Each fragment gets the sickly hum of magnetic tape artifacts before being scattered into a loosely tiled mosaic.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const pieces = Math.round(params.pieces ?? 30);
          const mr = params.mix_ratio ?? 0.55;
          const sh = Math.round(params.shift ?? 18);
          const sp = params.scan_spacing ?? 4;
          const so = params.scan_opacity ?? 0.35;
          // Each source gets its own tape artifact treatment before fragmentation
          const tA = channelShift(scanLines(dA, w, h, sp,   so),       w, h,  sh,              -Math.round(sh * 0.6));
          const tB = channelShift(scanLines(dB, w, h, sp+1, so * 0.9), w, h, -Math.round(sh * 0.8), Math.round(sh * 0.5));
          const tC = channelShift(scanLines(dC, w, h, sp,   so * 1.1), w, h,  Math.round(sh * 0.4), -sh);
          const tD = channelShift(scanLines(dD, w, h, sp-1, so * 0.8), w, h, -Math.round(sh * 0.5), Math.round(sh * 0.7));
          // Scatter all four into a shattered mosaic
          let d = gridFragment(tA, tA, tB, w, h, pieces, mr, rng);
          d = gridFragment(d, tC, tD, w, h, pieces, mr * 0.75, rng);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildTornCollageParams, getParams: getTornCollageParams, setParams: setTornCollageParams, onReroll: onRerollTornCollage },
      'wobble-curvyscreen-dither': { label: 'Wobble Curvy Screen Dither', desc: 'Four images: two wobble-eyed into drifting off-axis rings, then curvy-line-screened against a third. The fourth image provides an edge mask over the result.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: (imgs, params, rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const rings = Math.round(params.rings ?? 10);
          const wob = params.wobble ?? 25;
          const sp = params.scan_spacing ?? 4;
          const dt = params.dither_thresh ?? 128;
          // Wobble A and B (off-axis rings)
          const wA = ringRotate(dA, w, h, rings, 0, 0.5, wob, rng);
          const wB = ringRotate(dB, w, h, rings, 0, 0.5, wob * 1.2, rng);
          // Curvy screen approximation: scanLines composite
          let d = edgeMaskComposite(scanLines(wA, w, h, sp, 0.5), scanLines(wB, w, h, sp+1, 0.5), w, h, 90, 8, false);
          d = blendPixels(d, dC, w, h, 'screen', 0.4);
          // Bayer dither overlay
          const bayer4 = [[0,8,2,10],[12,4,14,6],[3,11,1,9],[15,7,13,5]];
          const ht = new Uint8ClampedArray(w * h * 4);
          for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
            const i = (y*w+x)*4;
            const lm = 0.299*d[i]+0.587*d[i+1]+0.114*d[i+2];
            const bv = (bayer4[y%4][x%4]/16)*255;
            const v = lm+bv-128 > dt ? 255 : 0;
            ht[i]=ht[i+1]=ht[i+2]=v; ht[i+3]=255;
          }
          d = blendPixels(d, ht, w, h, 'multiply', 0.5);
          // D edge mask
          d = edgeMaskComposite(d, dD, w, h, 80, 10, false);
          return [{ canvas: pixelsToCanvas(d, w, h), mimeType: 'image/png' }];
        }, buildParams: buildWobbleCurvyscreenDitherParams, getParams: getWobbleCurvyscreenDitherParams, setParams: setWobbleCurvyscreenDitherParams, onReroll: onRerollWobbleCurvyscreenDither },
      'pca-quad': { label: 'PCA Quad', desc: 'Four images PCA-decomposed to varying depths — stripped to structural ghosts — then composited through three-level stencil. The brightness bands fill with different ghost images.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: false, renderAsync: (imgs, _p, seed) => runSparagmosRecipe('pca-quad', imgs, seed), buildParams: () => {}, getParams: () => ({}), setParams: () => {} },
      'quad-sort-destroy': { label: 'Quad Sort Destroy', desc: 'Four images three-level stenciled — brightness bands filling with different sources — then the composite is pixel-sorted and byte-corrupted. Three-source stencil meets total annihilation.', inputs: 4, inputLabels: ['Image A', 'Image B', 'Image C', 'Image D'], hasRandomness: true,
        render: async (imgs, params, _rng) => {
          const { d: dA, w, h } = getPixels(imgs[0]!);
          const bPx = getPixels(imgs[1]!); const dB = resizeToMatch(bPx.d, bPx.w, bPx.h, w, h);
          const cPx = getPixels(imgs[2]!); const dC = resizeToMatch(cPx.d, cPx.w, cPx.h, w, h);
          const dPx = getPixels(imgs[3]!); const dD = resizeToMatch(dPx.d, dPx.w, dPx.h, w, h);
          const f = params.feather ?? 6;
          // 3-level stencil using A as reference: luma<t1→D, t1-t2→C, >t2→B
