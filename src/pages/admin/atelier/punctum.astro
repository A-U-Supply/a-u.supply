      if (p.angle != null) { (document.getElementById('ls-angle') as HTMLInputElement).value = String(p.angle); document.getElementById('ls-angle-val')!.textContent = p.angle + '°'; }
    }

    // ─── Penrose ───────────────────────────────────────────────────────────────

    function renderPenrose(imgs: (HTMLImageElement | null)[], _params: Record<string, any>, rng: () => number): Output[] {
      const img = imgs[0]; if (!img) return [];
      const W = img.naturalWidth, H = img.naturalHeight;
      const PHI = (1 + Math.sqrt(5)) / 2;

      type C = { re: number; im: number };
      const cadd   = (a: C, b: C): C => ({ re: a.re + b.re, im: a.im + b.im });
      const csub   = (a: C, b: C): C => ({ re: a.re - b.re, im: a.im - b.im });
      const cscale = (a: C, s: number): C => ({ re: a.re * s, im: a.im * s });
      const cpolar = (r: number, θ: number): C => ({ re: r * Math.cos(θ), im: r * Math.sin(θ) });

      function inflate(tris: [number, C, C, C][]): [number, C, C, C][] {
        const out: [number, C, C, C][] = [];
        for (const [k, A, B, Cv] of tris) {
          if (k === 0) {
            const P = cadd(A, cscale(csub(B, A), 1 / PHI));
            out.push([0, Cv, P, B], [1, P, Cv, A]);
          } else {
            const Q = cadd(B, cscale(csub(Cv, B), 1 / PHI));
            const R = cadd(B, cscale(csub(A, B), 1 / PHI));
            out.push([1, R, Cv, A], [1, Q, R, B], [0, R, Q, A]);
          }
        }
        return out;
      }

      const diag = Math.sqrt(W * W + H * H) / 2 * 1.3;
      const targetTile = Math.min(W, H) * 0.06;
      const N = Math.max(3, Math.round(Math.log(diag / targetTile) / Math.log(PHI)));

      let tris: [number, C, C, C][] = [];
      for (let i = 0; i < 10; i++) {
        let B = cpolar(1, (2 * i - 1) * Math.PI / 10);
        let Cv = cpolar(1, (2 * i + 1) * Math.PI / 10);
        if (i % 2 === 0) [B, Cv] = [Cv, B];
        tris.push([0, { re: 0, im: 0 }, B, Cv]);
      }
      for (let n = 0; n < N; n++) tris = inflate(tris);

      const cx = W / 2, cy = H / 2;
      const toPx = (z: C): [number, number] => [cx + z.re * diag, cy + z.im * diag];
      const tileHalf = Math.max(4, Math.floor(diag / PHI ** N * 1.2));

      type Tile = { destCx: number; destCy: number; pts: [number, number][] };
      const thick: Tile[] = [], thin: Tile[] = [];

      for (const [k, A, B, Cv] of tris) {
        const [ax, ay] = toPx(A), [bx, by] = toPx(B), [cx2, cy2] = toPx(Cv);
        const dcx = (ax + bx + cx2) / 3, dcy = (ay + by + cy2) / 3;
        if (dcx + tileHalf < 0 || dcx - tileHalf > W || dcy + tileHalf < 0 || dcy - tileHalf > H) continue;
        const tile: Tile = { destCx: dcx, destCy: dcy, pts: [[ax, ay], [bx, by], [cx2, cy2]] };
        (k === 0 ? thick : thin).push(tile);
      }

      const shuffleSrcs = (tiles: Tile[]) => {
        const srcs = tiles.map(t => ({ srcCx: t.destCx, srcCy: t.destCy }));
        for (let i = srcs.length - 1; i > 0; i--) {
          const j = Math.floor(rng() * (i + 1));
          [srcs[i], srcs[j]] = [srcs[j], srcs[i]];
        }
        return srcs;
      };
      const thickSrcs = shuffleSrcs(thick);
      const thinSrcs  = shuffleSrcs(thin);

      const oc = new OffscreenCanvas(W, H);
      const ctx = oc.getContext('2d')!;
      ctx.drawImage(img, 0, 0);

      for (const [tiles, srcs] of [[thick, thickSrcs], [thin, thinSrcs]] as [Tile[], {srcCx:number,srcCy:number}[]][]) {
        for (let i = 0; i < tiles.length; i++) {
          const { destCx, destCy, pts } = tiles[i];
          const { srcCx, srcCy } = srcs[i];
          ctx.save();
          ctx.beginPath();
          ctx.moveTo(pts[0][0], pts[0][1]);
          ctx.lineTo(pts[1][0], pts[1][1]);
          ctx.lineTo(pts[2][0], pts[2][1]);
          ctx.closePath();
          ctx.clip();
          ctx.drawImage(img, destCx - srcCx, destCy - srcCy);
          ctx.restore();
        }
      }

      return [
        { canvas: ocToCanvas(oc), label: 'Color', mimeType: 'image/png' },
        { canvas: otsuBinary(oc, W, H), label: 'BW', mimeType: 'image/png' },
      ];
    }

    // ─── Monochrome ────────────────────────────────────────────────────────────

    function toSilverGelatin(img: HTMLImageElement, W: number, H: number): OffscreenCanvas {
      const tmp = new OffscreenCanvas(W, H);
      tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
      const src = tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
      const gray = new Uint8ClampedArray(W * H * 4);
      for (let i = 0; i < W * H * 4; i += 4) {
        const g = Math.round(0.299 * src[i] + 0.587 * src[i+1] + 0.114 * src[i+2]);
        gray[i] = gray[i+1] = gray[i+2] = g; gray[i+3] = 255;
      }
      const blurred = applyBlur(gray, W, H, 1.5);
      const out = new OffscreenCanvas(W, H);
      const od = out.getContext('2d')!.createImageData(W, H);
      for (let i = 0; i < W * H * 4; i += 4) {
        const diff = gray[i] - blurred[i];
        const v = Math.max(0, Math.min(255, Math.round(gray[i] + (Math.abs(diff) > 3 ? diff * 1.2 : 0))));
        od.data[i] = od.data[i+1] = od.data[i+2] = v; od.data[i+3] = 255;
      }
      out.getContext('2d')!.putImageData(od, 0, 0);
      return out;
    }

    function renderMonochrome(imgs: (HTMLImageElement | null)[], _params: Record<string, any>, _rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2]) return [];
      const W = imgs[0].naturalWidth, H = imgs[0].naturalHeight;
      const mono = [toSilverGelatin(imgs[0]!, W, H), toSilverGelatin(imgs[1]!, W, H), toSilverGelatin(imgs[2]!, W, H)];
      const outputs: Output[] = [];
      for (const [s, a, b] of [[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]] as [number,number,number][]) {
        const dest = new OffscreenCanvas(W, H);
        stencilCompose(dest, imgs[s]!, mono[a], mono[b]);
        outputs.push({ canvas: ocToCanvas(dest), label: `S${s+1} ${a+1}/${b+1}`, mimeType: 'image/png' });
      }
      return outputs;
    }

    // ─── Silver ────────────────────────────────────────────────────────────────

    function toSilverHalation(img: HTMLImageElement, W: number, H: number, rng: () => number): OffscreenCanvas {
      const tmp = new OffscreenCanvas(W, H);
      tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
      const src = tmp.getContext('2d')!.getImageData(0, 0, W, H).data;

      const curveIn  = [0, 30, 128, 210, 255];
      const curveOut = [0,  5, 140, 248, 255];

      const curved = new Uint8ClampedArray(W * H * 4);
      for (let i = 0; i < W * H * 4; i += 4) {
        const g = Math.round(0.299 * src[i] + 0.587 * src[i+1] + 0.114 * src[i+2]);
        const v = Math.round(piecewiseLerp(curveIn, curveOut, g));
        curved[i] = curved[i+1] = curved[i+2] = v; curved[i+3] = 255;
      }

      const highlights = new Uint8ClampedArray(W * H * 4);
      for (let i = 0; i < W * H * 4; i += 4) {
        const v = curved[i] > 170 ? curved[i] : 0;
        highlights[i] = highlights[i+1] = highlights[i+2] = v; highlights[i+3] = 255;
      }
      const halo = applyBlur(highlights, W, H, 26);

      const screened = new Uint8ClampedArray(W * H * 4);
      for (let i = 0; i < W * H * 4; i += 4) {
        const a = curved[i], h = halo[i];
        screened[i] = screened[i+1] = screened[i+2] = Math.round(255 - (255 - a) * (255 - h) / 255);
        screened[i+3] = 255;
      }

      const afterBlur = applyBlur(screened, W, H, 1.2);
      const result = new Uint8ClampedArray(W * H * 4);
      for (let i = 0; i < W * H * 4; i += 4) {
        const u1 = rng() || 1e-10, u2 = rng();
        const grain = Math.round(9 * Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2));
        const diff = screened[i] - afterBlur[i];
        let v = screened[i] + (Math.abs(diff) > 2 ? diff * 1.5 : 0) + grain;
        v = Math.max(0, Math.min(255, v));
        result[i]   = Math.round(v * 0.95);
        result[i+1] = v;
        result[i+2] = Math.min(255, Math.round(v * 1.06));
        result[i+3] = 255;
      }

      const out = new OffscreenCanvas(W, H);
      const od = out.getContext('2d')!.createImageData(W, H);
      od.data.set(result);
      out.getContext('2d')!.putImageData(od, 0, 0);
      return out;
    }

    function renderSilver(imgs: (HTMLImageElement | null)[], _params: Record<string, any>, rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2]) return [];
      const W = imgs[0].naturalWidth, H = imgs[0].naturalHeight;
      const silver = [
        toSilverHalation(imgs[0]!, W, H, rng),
        toSilverHalation(imgs[1]!, W, H, rng),
        toSilverHalation(imgs[2]!, W, H, rng),
      ];
      const outputs: Output[] = [];
      for (const [s, a, b] of [[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]] as [number,number,number][]) {
        const dest = new OffscreenCanvas(W, H);
        stencilCompose(dest, imgs[s]!, silver[a], silver[b]);
        outputs.push({ canvas: ocToCanvas(dest), label: `S${s+1} ${a+1}/${b+1}`, mimeType: 'image/png' });
      }
      return outputs;
    }

    // ─── Quad ──────────────────────────────────────────────────────────────────

    function renderQuad(imgs: (HTMLImageElement | null)[], _params: Record<string, any>, _rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2] || !imgs[3]) return [];
      const sizes = ([imgs[0], imgs[1], imgs[2], imgs[3]] as HTMLImageElement[]).map(i => [i.naturalWidth, i.naturalHeight]);
      const [W, H] = sizes.reduce((b, s) => s[0] * s[1] > b[0] * b[1] ? s : b);

      const getGray = (img: HTMLImageElement): Uint8Array => {
        const { bias, contrast } = getStencilParams();
        const tmp = new OffscreenCanvas(W, H);
        tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
        const d = tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
        const g = new Uint8Array(W * H);
        for (let i = 0; i < W * H; i++) {
          const raw = Math.round(0.299 * d[i*4] + 0.587 * d[i*4+1] + 0.114 * d[i*4+2]);
          g[i] = Math.max(0, Math.min(255, Math.round(128 + (raw - 128) * contrast + bias)));
        }
        return g;
      };
      const getPixels = (img: HTMLImageElement): Uint8ClampedArray => {
        const tmp = new OffscreenCanvas(W, H);
        tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
        return tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
      };
      const make3Level = (gray: Uint8Array): Uint8Array => {
        const sorted = Array.from(gray).sort((a, b) => a - b);
        const p33 = sorted[Math.floor(sorted.length * 0.33)];
        const p67 = sorted[Math.floor(sorted.length * 0.67)];
        const mask = new Uint8Array(W * H);
        for (let i = 0; i < W * H; i++) mask[i] = gray[i] < p33 ? 0 : gray[i] < p67 ? 128 : 255;
        return mask;
      };

      const grays  = [0, 1, 2, 3].map(i => getGray(imgs[i]!));
      const pixels = [0, 1, 2, 3].map(i => getPixels(imgs[i]!));
      const masks  = grays.map(make3Level);

      const outputs: Output[] = [];
      const perms: [number,number,number][] = [[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]];
      for (let s = 0; s < 4; s++) {
        const mask = masks[s];
        const others = [0, 1, 2, 3].filter(i => i !== s);
        for (const [pa, pb, pc] of perms) {
          const dA = pixels[others[pa]], dB = pixels[others[pb]], dC = pixels[others[pc]];
          const oc = new OffscreenCanvas(W, H);
          const od = oc.getContext('2d')!.createImageData(W, H);
          for (let i = 0; i < W * H; i++) {
            const src = mask[i] < 64 ? dA : mask[i] < 192 ? dB : dC;
            od.data[i*4] = src[i*4]; od.data[i*4+1] = src[i*4+1];
            od.data[i*4+2] = src[i*4+2]; od.data[i*4+3] = 255;
          }
          oc.getContext('2d')!.putImageData(od, 0, 0);
          outputs.push({ canvas: ocToCanvas(oc), label: `S${s+1} ${others[pa]+1}/${others[pb]+1}/${others[pc]+1}`, mimeType: 'image/png' });
        }
      }
      return outputs;
    }

    // ─── Kaleidoscope ────────────────────────────────────────────────────────────

    function renderKaleidoscope(imgs: (HTMLImageElement | null)[], params: Record<string, any>, rng: () => number): Output[] {
      const img = imgs[0]; if (!img) return [];
      const W = img.naturalWidth, H = img.naturalHeight;
      const folds = params['kal-folds'] ?? 6;
      const short = Math.min(W, H);
      const r1 = Math.floor(short * 0.46);
      const radii = [r1, Math.floor(r1 * 2 / 3), Math.floor(r1 / 3)];
      const centers = bullseyeCenters(W, H, r1, rng);
      const oc = new OffscreenCanvas(W, H);
      const ctx = oc.getContext('2d')!;
      ctx.drawImage(img, 0, 0);
      const srcData = ctx.getImageData(0, 0, W, H).data;
      const wedge = (2 * Math.PI) / folds;
      for (const [cx, cy] of centers) {
        for (const r of radii) {
          const size = r * 2;
          const koc = new OffscreenCanvas(size, size);
          const kd = koc.getContext('2d')!.createImageData(size, size);
          for (let py = 0; py < size; py++) {
            for (let px = 0; px < size; px++) {
              const dx = px - r, dy = py - r;
              const dist = Math.sqrt(dx*dx + dy*dy);
              const thetaPos = ((Math.atan2(dy, dx) % (2*Math.PI)) + 2*Math.PI) % (2*Math.PI);
              let tf = thetaPos % wedge;
              if (Math.floor(thetaPos / wedge) % 2 === 1) tf = wedge - tf;
              const [rv, gv, bv] = bilinearSample(srcData, W, H, cx + dist * Math.cos(tf), cy + dist * Math.sin(tf), false);
              const ki = (py * size + px) * 4;
              kd.data[ki] = rv; kd.data[ki+1] = gv; kd.data[ki+2] = bv; kd.data[ki+3] = 255;
            }
          }
          koc.getContext('2d')!.putImageData(kd, 0, 0);
          const angle = (rng() * 300 + 30) * Math.PI / 180;
          ctx.save();
          ctx.beginPath();
          ctx.arc(cx, cy, r, 0, Math.PI * 2);
          ctx.clip();
          ctx.translate(cx, cy);
          ctx.rotate(angle);
          ctx.drawImage(koc, -r, -r);
          ctx.restore();
        }
      }
      return [
        { canvas: ocToCanvas(oc), label: 'Color', mimeType: 'image/jpeg' },
        { canvas: otsuBinary(oc, W, H), label: 'BW', mimeType: 'image/png' },
      ];
    }

    function buildKaleidoscopeParams() {
      paramsEl.innerHTML = `
        <div class="pt-field">
          <label class="pt-label" for="kal-folds">Folds <span class="pt-val" id="kal-folds-val">6</span></label>
          <input class="pt-range" type="range" id="kal-folds" min="3" max="12" step="1" value="6" />
          <div class="pt-range-hints"><span>3</span><span>12</span></div>
        </div>`;
      enhanceSliders();
      const debounce = (fn: () => void, ms: number) => { let t: ReturnType<typeof setTimeout>; return () => { clearTimeout(t); t = setTimeout(fn, ms); }; };
      const dRender = debounce(() => doRender(), 200);
      document.getElementById('kal-folds')!.addEventListener('input', (e) => {
        document.getElementById('kal-folds-val')!.textContent = (e.target as HTMLInputElement).value;
        dRender();
      });
    }
    function getKaleidoscopeParams(): Record<string, any> {
      return { 'kal-folds': parseInt((document.getElementById('kal-folds') as HTMLInputElement).value, 10) };
    }
    function setKaleidoscopeParams(p: Record<string, any>) {
      if (p['kal-folds'] != null) { (document.getElementById('kal-folds') as HTMLInputElement).value = String(p['kal-folds']); document.getElementById('kal-folds-val')!.textContent = String(p['kal-folds']); }
    }

    // ─── Displacement ─────────────────────────────────────────────────────────

    function renderDisplacement(imgs: (HTMLImageElement | null)[], params: Record<string, any>, _rng: () => number): Output[] {
      if (!imgs[0] || !imgs[1] || !imgs[2]) return [];
      const W = imgs[0].naturalWidth, H = imgs[0].naturalHeight;
      const strength = params['disp-strength'] ?? 80;
      const blurSigma = params['disp-blur'] ?? 2;
      const { bias, contrast, invert } = getStencilParams();

      const pixelData = [imgs[0]!, imgs[1]!, imgs[2]!].map(img => {
        const tmp = new OffscreenCanvas(W, H);
        tmp.getContext('2d')!.drawImage(img, 0, 0, W, H);
        return tmp.getContext('2d')!.getImageData(0, 0, W, H).data;
      });

      const gradFields = pixelData.map(pd => {
        const blurred = blurSigma > 0 ? applyBlur(pd as Uint8ClampedArray, W, H, blurSigma) : pd as Uint8ClampedArray;
        const { gx, gy, mag } = sobelGradients(blurred, W, H);
        const magArr = Array.from(mag).sort((a, b) => a - b);
        const p99 = magArr[Math.floor(magArr.length * 0.99)] + 1e-6;
        const gxN = new Float32Array(W * H), gyN = new Float32Array(W * H);
        for (let i = 0; i < W * H; i++) { gxN[i] = gx[i] / p99; gyN[i] = gy[i] / p99; }
        return { gxN, gyN };
      });

      return STENCIL_PERMS.map(([s, a, b]) => {
        const { gxN, gyN } = gradFields[s];
        const sData = pixelData[s], aData = pixelData[a], bData = pixelData[b];
        // Warp stencil at 0.5× strength, apply contrast
        const dispGray = new Float32Array(W * H);
        for (let j = 0; j < W * H; j++) {
          const x = j % W, y = Math.floor(j / W);
          const [rv, gv, bv2] = bilinearSample(sData, W, H, x + gxN[j]*strength*0.5, y + gyN[j]*strength*0.5, false);
          const raw = 0.299*rv + 0.587*gv + 0.114*bv2;
          dispGray[j] = Math.max(0, Math.min(255, 128 + (raw - 128) * contrast));
        }
        // Inline Otsu on dispGray + bias shift
        const hist = new Float32Array(256);
        for (let j = 0; j < W * H; j++) hist[Math.round(dispGray[j])]++;
        const total = W * H;
        let sum = 0; for (let t = 0; t < 256; t++) sum += t * hist[t];
        let sumB = 0, wB = 0, thresh = 128, maxVar = 0;
        for (let t = 0; t < 256; t++) {
          wB += hist[t]; if (wB === 0) continue;
          const wF = total - wB; if (wF === 0) break;
          sumB += t * hist[t];
          const v = wB * wF * ((sumB / wB) - (sum - sumB) / wF) ** 2;
          if (v > maxVar) { maxVar = v; thresh = t; }
        }
        thresh = Math.max(0, Math.min(255, thresh + bias));
        // Composite fills displaced at 1.5× strength
        const oc = new OffscreenCanvas(W, H);
        const od = oc.getContext('2d')!.createImageData(W, H);
        for (let j = 0; j < W * H; j++) {
          const x = j % W, y = Math.floor(j / W);
          const sx = gxN[j]*strength*1.5, sy = gyN[j]*strength*1.5;
          const [rA, gA, bA] = bilinearSample(aData, W, H, x - sx, y - sy, false);
          const [rB, gB, bB] = bilinearSample(bData, W, H, x + sx, y + sy, false);
          const above = dispGray[j] >= thresh;
          const useFillA = invert ? !above : above;
          od.data[j*4]   = useFillA ? rA : rB;
          od.data[j*4+1] = useFillA ? gA : gB;
          od.data[j*4+2] = useFillA ? bA : bB;
          od.data[j*4+3] = 255;
        }
        oc.getContext('2d')!.putImageData(od, 0, 0);
        return { canvas: ocToCanvas(oc), label: `S${s}·A${a}·B${b}`, mimeType: 'image/jpeg' };
      });
    }

