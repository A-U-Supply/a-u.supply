---
import Admin from '../../../layouts/Admin.astro';
---

<Admin title="Spectralize" current="">
  <div class="page-header">
    <h1>Spectralize has moved</h1>
    <p class="page-subtitle">image → audio synthesis is now part of Photism</p>
  </div>
  <p style="color:var(--fg2,#888); margin-top:1rem; font-size:0.95rem;">
    Use the <strong style="color:var(--fg,#e8e8e8)">▦ Image</strong> tab in Photism's
    audio loader to synthesize audio from an image.
    <a
      href="/admin/atelier/photism"
      style="color:var(--accent,#e8c060); margin-left:0.5rem;"
      >Go to Photism →</a
    >
  </p>
</Admin>
