    });

    // Brush size
    document.getElementById('ph-brush-size')!.addEventListener('input', e => {
      brushSize = parseInt((e.target as HTMLInputElement).value);
      document.getElementById('ph-brush-val')!.textContent = String(brushSize);
    });

    // Reset edits
    document.getElementById('ph-paint-reset-btn')!.addEventListener('click', () => {
      editedFrames = null;
      scheduleRender();
    });

    // Canvas mouse paint
    canvas.addEventListener('mousedown', (e) => {
      if (!paintMode) return;
      isPainting = true;
      applyBrush(e.clientX, e.clientY);
    });
    canvas.addEventListener('mousemove', (e) => {
      if (!paintMode || !isPainting) return;
      applyBrush(e.clientX, e.clientY);
    });
    canvas.addEventListener('mouseup', () => { isPainting = false; });
    canvas.addEventListener('mouseleave', () => { isPainting = false; });

    // Canvas touch paint
    canvas.addEventListener('touchstart', (e) => {
      if (!paintMode) return;
      e.preventDefault();
      isPainting = true;
      applyBrush(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: false });
    canvas.addEventListener('touchmove', (e) => {
      if (!paintMode || !isPainting) return;
      e.preventDefault();
      applyBrush(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: false });
    canvas.addEventListener('touchend', () => { isPainting = false; });
  </script>
