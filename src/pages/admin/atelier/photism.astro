    // Drop zone
    const dropZone = document.getElementById('ph-drop-zone')!;
    const fileInput = document.getElementById(
      'ph-file-input',
    ) as HTMLInputElement;
    document.getElementById('ph-upload-btn')!.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });
    fileInput.addEventListener('change', () => {
      if (fileInput.files?.[0]) loadAudioFile(fileInput.files[0]);
    });
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('drag-over');
    });
    dropZone.addEventListener('dragleave', () =>
      dropZone.classList.remove('drag-over'),
    );
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('drag-over');
      const f = e.dataTransfer?.files[0];
      if (f && f.type.startsWith('audio/')) loadAudioFile(f);
    });
    document.getElementById('ph-change-btn')!.addEventListener('click', () => {
      document.getElementById('ph-drop-empty')!.style.display = '';
      document.getElementById('ph-loaded-zone')!.style.display = 'none';
