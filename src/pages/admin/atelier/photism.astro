      } catch (err: any) {
        (window as any).toast?.error(`Export failed: ${err.message}`);
      } finally {
        busyEl.style.display = 'none';
      }
    }

    // ─── Playback progress ────────────────────────────────────────────────────
    const playhead = document.getElementById('ph-playhead')!;
    const timeDisp = document.getElementById('ph-time-display')!;

    function fmtTime(secs: number): string {
      const m = Math.floor(secs / 60);
      const s = Math.floor(secs % 60);
      return `${m}:${String(s).padStart(2, '0')}`;
    }

    function stopProgress() {
      if (progressRaf !== null) {
        cancelAnimationFrame(progressRaf);
        progressRaf = null;
      }
      playhead.style.display = 'none';
      timeDisp.textContent = '0:00';
      if (spectrogramData) drawMiniWaveform(spectrogramData.waveform);
    }

    function tickProgress() {
      if (!playbackCtx || !spectrogramData) return;
      const dur = spectrogramData.duration;
      const elapsed = playbackCtx.currentTime - playbackStartTime;
      let audioTime: number;
      if (loopEnabled && playbackEndOffset > playbackStartOffset) {
        const loopDur = playbackEndOffset - playbackStartOffset;
        audioTime =
          playbackStartOffset + (((elapsed % loopDur) + loopDur) % loopDur);
      } else {
        audioTime = Math.min(playbackStartOffset + elapsed, playbackEndOffset);
      }
      const trimDur = playbackEndOffset - playbackStartOffset;
      const progressInTrim =
        trimDur > 0
          ? Math.max(
              0,
              Math.min(1, (audioTime - playbackStartOffset) / trimDur),
            )
          : 0;
      // Update time display (relative to full track)
      timeDisp.textContent = fmtTime(audioTime);
      // Move playhead on spectrogram canvas
      playhead.style.display = 'block';
      playhead.style.left = `${progressInTrim * 100}%`;
      // Update waveform cursor (position within full track)
      const trackFrac = dur > 0 ? audioTime / dur : 0;
      drawMiniWaveform(
        spectrogramData.waveform,
        Math.max(0, Math.min(1, trackFrac)),
      );
      progressRaf = requestAnimationFrame(tickProgress);
    }

    // ─── Paint mode ───────────────────────────────────────────────────────────
    function setPaintMode(on: boolean) {
      paintMode = on;
      if (!on) {
        isPainting = false;
        smearPrevCx = null;
        smearPrevCy = null;
      }
      const btn = document.getElementById('ph-paint-btn')!;
      const paintBar = document.getElementById('ph-paint-bar')!;
      const wrap = document.getElementById('ph-canvas-wrap')!;
      btn.classList.toggle('ph-paint-btn--active', on);
      paintBar.style.display = on ? 'flex' : 'none';
      wrap.classList.toggle('ph-canvas-wrap--paint', on);
    }

    function setTool(tool: BrushTool) {
      brushTool = tool;
      document.querySelectorAll('#ph-tool-group .ph-pill').forEach((b) => {
        b.classList.toggle(
          'ph-pill--on',
          (b as HTMLButtonElement).dataset.tool === tool,
        );
      });
      const gainRow = document.getElementById('ph-gain-row')!;
      gainRow.style.display = tool === 'gain' ? 'flex' : 'none';
    }

    // Map canvas y (0=top) → bin index, using mel scale for waterfall/glitch/hybrid modes
    function canvasYtoBin(cy: number): number {
      if (!spectrogramData) return 0;
      const { numBins, sampleRate } = spectrogramData;
      if (
        currentMode === 'waterfall' ||
        currentMode === 'glitch' ||
        currentMode === 'hybrid'
      ) {
        const freqMax = parseFloat(
          (document.getElementById('ph-freq-max') as HTMLInputElement).value,
        );
        const nyquist = sampleRate / 2;
        const melMin = hzToMel(20);
        const melMax = hzToMel(Math.min(freqMax, nyquist));
        const H = canvas.height;
        const melFrac = Math.max(0, Math.min(1, (H - 1 - cy) / (H - 1)));
        const hz = melToHz(melMin + melFrac * (melMax - melMin));
        return Math.max(
          0,
          Math.min(numBins - 1, Math.floor((hz / nyquist) * numBins)),
        );
      }
      // Radial: linear mapping
      return Math.max(
        0,
        Math.min(
          numBins - 1,
          numBins - 1 - Math.floor((cy / canvas.height) * numBins),
        ),
      );
    }

    function applyBrush(clientX: number, clientY: number) {
      if (!spectrogramData || stampMode) return;
      if (!editedFrames)
        editedFrames = spectrogramData.frames.map((fr) => fr.slice());

      const rect = canvas.getBoundingClientRect();
      const cx = ((clientX - rect.left) / rect.width) * canvas.width;
      const cy = ((clientY - rect.top) / rect.height) * canvas.height;
      const [t0, t1] = getTimeRange();
      const { numFrames, numBins } = spectrogramData;
      const fStart = Math.floor(t0 * numFrames);
      const fEnd = Math.ceil(t1 * numFrames);
      const numVis = Math.max(1, fEnd - fStart);
      const fCenter = Math.floor((cx / canvas.width) * numVis) + fStart;
      const fRadius = Math.max(1, Math.ceil((brushSize * numVis) / rect.width));
      const brushPxCanvas = (brushSize * canvas.height) / rect.height;
      const bHi = canvasYtoBin(Math.max(0, cy - brushPxCanvas));
      const bLo = canvasYtoBin(Math.min(canvas.height - 1, cy + brushPxCanvas));

      // Snapshot frames into strokeDiffs before first modification (for undo)
      const captureFrame = (f: number) => {
        if (strokeDiffs && !strokeDiffs.has(f))
          strokeDiffs.set(f, editedFrames![f].slice());
      };

      if (brushTool === 'smear') {
        const prevCx = smearPrevCx ?? cx;
        const prevCy = smearPrevCy ?? cy;
        const dFrames = Math.round(((cx - prevCx) / canvas.width) * numVis);
        const dBins = canvasYtoBin(cy) - canvasYtoBin(prevCy);
        smearPrevCx = cx;
        smearPrevCy = cy;
        if (dFrames === 0 && dBins === 0) {
          scheduleRender();
          return;
        }
        for (let df = -fRadius; df <= fRadius; df++) {
          const f = fCenter + df;
          if (f < 0 || f >= editedFrames.length) continue;
          captureFrame(f);
          const srcF = Math.max(
            0,
            Math.min(editedFrames.length - 1, f - dFrames),
          );
          for (let b = bLo; b <= bHi; b++) {
            if (b < 0 || b >= numBins) continue;
            const srcB = Math.max(0, Math.min(numBins - 1, b - dBins));
            editedFrames[f][b] =
              editedFrames[srcF][srcB] * 0.7 + editedFrames[f][b] * 0.3;
          }
        }
      } else if (brushTool === 'blur') {
        const kernel = [0.06, 0.24, 0.4, 0.24, 0.06];
        const kHalf = 2;
        for (let df = -fRadius; df <= fRadius; df++) {
          const f = fCenter + df;
          if (f < 0 || f >= editedFrames.length) continue;
          captureFrame(f);
          for (let b = bLo; b <= bHi; b++) {
            if (b < 0 || b >= numBins) continue;
            let sum = 0;
            for (let k = 0; k < kernel.length; k++) {
              sum +=
                editedFrames[f][
                  Math.max(0, Math.min(numBins - 1, b - kHalf + k))
                ] * kernel[k];
            }
            editedFrames[f][b] = sum;
          }
        }
      } else {
        for (let df = -fRadius; df <= fRadius; df++) {
          const f = fCenter + df;
          if (f < 0 || f >= editedFrames.length) continue;
          captureFrame(f);
          for (let b = bLo; b <= bHi; b++) {
            if (b < 0 || b >= numBins) continue;
            if (brushTool === 'gain') {
              editedFrames[f][b] = Math.max(
                0,
                Math.min(1, editedFrames[f][b] * gainAmount),
              );
            } else {
              editedFrames[f][b] = brushTool === 'draw' ? 1 : 0;
            }
          }
        }
      }
      scheduleRender();
    }

    // ─── Undo ─────────────────────────────────────────────────────────────────
    function updateUndoBtn() {
      const btn = document.getElementById('ph-undo-btn') as HTMLButtonElement;
      if (btn) btn.disabled = undoStack.length === 0;
    }

    function updatePlayModeUI() {
      const modeEl = document.getElementById('ph-play-mode')!;
      if (!editedFrames) {
        modeEl.style.display = 'none';
        playMode = 'original';
        document.getElementById('ph-mode-orig')!.classList.add('ph-pill--on');
        document
          .getElementById('ph-mode-edit')!
          .classList.remove('ph-pill--on');
      } else {
        modeEl.style.display = 'flex';
      }
      document
        .getElementById('ph-mode-edit')!
        .classList.toggle('ph-pill--stale', editedAudioStale);
    }

    function undo() {
      if (undoStack.length === 0) return;
      fxPreviewFrames = null;
      const entry = undoStack.pop()!;
      if (entry.kind === 'swap') {
        editedFrames = entry.prev;
      } else {
        if (!editedFrames && spectrogramData)
          editedFrames = spectrogramData.frames.map((fr) => fr.slice());
        if (editedFrames)
          for (const [f, fr] of entry.diffs) editedFrames[f] = fr;
      }
      editedAudioStale = true;
      scheduleRender();
      updateUndoBtn();
      updatePlayModeUI();
    }

