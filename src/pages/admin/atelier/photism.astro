  <script>
    // ─── Types ────────────────────────────────────────────────────────────────
    interface SpectrogramData {
      frames: Float32Array[];
      phases: Float32Array[]; // raw phase per bin per frame (atan2 of FFT output)
      maxMag: number; // raw magnitude peak before log normalization
      numFrames: number;
      numBins: number;
      sampleRate: number;
      duration: number;
      waveform: Float32Array;
    }

    // ─── State ────────────────────────────────────────────────────────────────
    let spectrogramData: SpectrogramData | null = null;
    let currentMode = 'waterfall';
    let currentPalette = 'hot';
    let paletteLUT: Uint8ClampedArray = buildPaletteLUT('hot');
    let renderPending = false;
    let lastArrayBuf: ArrayBuffer | null = null;
    let lastFileName = 'audio';
    let currentAudioBuffer: AudioBuffer | null = null;
    let playbackSource: AudioBufferSourceNode | null = null;
    let playbackCtx: AudioContext | null = null;
    type BrushTool = 'draw' | 'erase' | 'gain' | 'blur' | 'smear';
    let paintMode = false;
    let editedFrames: Float32Array[] | null = null;
    let brushSize = 8;
    let brushTool: BrushTool = 'draw';
    let gainAmount = 1.5;
    let smearPrevCx: number | null = null;
    let smearPrevCy: number | null = null;
    let isPainting = false;
    let stampMode = false;
    let shaderEffect = 'none';
    let fxPreviewFrames: Float32Array[] | null = null;
    let stampImageData: ImageData | null = null;
    type UndoEntry =
      | { kind: 'swap'; prev: Float32Array[] | null }
      | { kind: 'patch'; diffs: Map<number, Float32Array> };
    const undoStack: UndoEntry[] = [];
    const MAX_UNDO = 20;
    let strokeDiffs: Map<number, Float32Array> | null = null;
    let strokeWasNull = false;
    let loopEnabled = false;
    let playbackStartTime = 0;
    let playbackStartOffset = 0;
    let playbackEndOffset = 0;
    let progressRaf: number | null = null;
    let editedAudioBuffer: AudioBuffer | null = null;
    let editedAudioStale = false;
    let playMode: 'original' | 'edited' = 'original';

    const canvas = document.getElementById('ph-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;

    // ─── FFT (Cooley-Tukey radix-2, in-place) ────────────────────────────────
    function fft(re: Float64Array, im: Float64Array): void {
      const n = re.length;
      for (let i = 1, j = 0; i < n; i++) {
        let bit = n >> 1;
        for (; j & bit; bit >>= 1) j ^= bit;
        j ^= bit;
        if (i < j) {
          let t = re[i];
          re[i] = re[j];
          re[j] = t;
          t = im[i];
          im[i] = im[j];
          im[j] = t;
        }
      }
      for (let len = 2; len <= n; len <<= 1) {
        const ang = (-2 * Math.PI) / len;
        const wRe = Math.cos(ang),
          wIm = Math.sin(ang);
        for (let i = 0; i < n; i += len) {
          let curRe = 1,
            curIm = 0;
          const half = len >> 1;
          for (let j = 0; j < half; j++) {
            const uRe = re[i + j],
              uIm = im[i + j];
            const vRe = re[i + j + half] * curRe - im[i + j + half] * curIm;
            const vIm = re[i + j + half] * curIm + im[i + j + half] * curRe;
            re[i + j] = uRe + vRe;
            im[i + j] = uIm + vIm;
            re[i + j + half] = uRe - vRe;
            im[i + j + half] = uIm - vIm;
            const nr = curRe * wRe - curIm * wIm;
            curIm = curRe * wIm + curIm * wRe;
            curRe = nr;
          }
        }
      }
    }

    function hannWindow(n: number): Float32Array {
      const w = new Float32Array(n);
      for (let i = 0; i < n; i++)
        w[i] = 0.5 * (1 - Math.cos((2 * Math.PI * i) / (n - 1)));
      return w;
    }

    function hzToMel(hz: number): number {
      return 2595 * Math.log10(1 + hz / 700);
    }
    function melToHz(mel: number): number {
      return 700 * (Math.pow(10, mel / 2595) - 1);
    }

    // ─── Spectrogram computation ──────────────────────────────────────────────
    async function computeSpectrogram(
      audioBuffer: AudioBuffer,
      fftSize: number,
      progressCb: (p: number) => void,
    ): Promise<SpectrogramData> {
      const pcm = audioBuffer.getChannelData(0);
      const sampleRate = audioBuffer.sampleRate;
      const hop = fftSize >> 2;
      const hann = hannWindow(fftSize);
      const numBins = fftSize >> 1;
      const numFrames = Math.max(
        1,
        Math.floor((pcm.length - fftSize) / hop) + 1,
      );
      const frames: Float32Array[] = [];
      const phases: Float32Array[] = [];
      const re = new Float64Array(fftSize);
      const im = new Float64Array(fftSize);
      const CHUNK = 40;

      for (let f = 0; f < numFrames; f++) {
        const start = f * hop;
        re.fill(0);
        im.fill(0);
        for (let i = 0; i < fftSize; i++) {
          re[i] = (start + i < pcm.length ? pcm[start + i] : 0) * hann[i];
        }
        fft(re, im);
        const mag = new Float32Array(numBins);
        const phase = new Float32Array(numBins);
        for (let i = 0; i < numBins; i++) {
          mag[i] = Math.sqrt(re[i] * re[i] + im[i] * im[i]);
          phase[i] = Math.atan2(im[i], re[i]);
        }
        frames.push(mag);
        phases.push(phase);
        if (f % CHUNK === CHUNK - 1) {
          progressCb(f / numFrames);
          await yieldToUI();
        }
      }

      // Log-magnitude normalize — store raw peak before modifying frames
      let maxMag = 0;
      for (const fr of frames) for (const v of fr) if (v > maxMag) maxMag = v;
      if (maxMag > 0) {
        const scale = 1 / maxMag;
        for (const fr of frames)
          for (let i = 0; i < fr.length; i++) {
            fr[i] = Math.log1p(fr[i] * scale * 100) / Math.log(101);
          }
      }

      // Waveform: RMS per frame
      const waveform = new Float32Array(numFrames);
      for (let f = 0; f < numFrames; f++) {
        const start = f * hop;
        let rms = 0;
        const end = Math.min(start + hop, pcm.length);
        for (let i = start; i < end; i++) rms += pcm[i] * pcm[i];
        waveform[f] = Math.sqrt(rms / (end - start));
      }

      return {
        frames,
        phases,
        maxMag,
        numFrames,
        numBins,
        sampleRate,
        duration: audioBuffer.duration,
        waveform,
      };
    }

    function yieldToUI(): Promise<void> {
      return new Promise((r) => setTimeout(r, 0));
    }

    // ─── Palette builder ──────────────────────────────────────────────────────
    function buildPaletteLUT(name: string): Uint8ClampedArray {
      const lut = new Uint8ClampedArray(256 * 3);
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      const stops: Record<string, number[][]> = {
        hot: [
          [0, 0, 0],
          [0.33, 0, 0],
          [0.67, 0.35, 0],
          [0.9, 0.9, 0],
          [1, 1, 1],
        ],
        viridis: [
          [0.267, 0.005, 0.329],
          [0.229, 0.322, 0.545],
          [0.127, 0.566, 0.551],
          [0.369, 0.788, 0.384],
          [0.993, 0.906, 0.144],
        ],
        mono: [
          [0, 0, 0],
          [1, 1, 1],
        ],
        acid: [
          [0, 0, 0],
          [0.05, 0.9, 0.05],
          [0.5, 0.05, 0.85],
          [1, 1, 1],
        ],
      };
      const pal = stops[name] ?? stops.hot;
      for (let i = 0; i < 256; i++) {
        const t = i / 255;
        const seg = t * (pal.length - 1);
        const lo = Math.floor(seg),
          hi = Math.min(lo + 1, pal.length - 1);
        const f = seg - lo;
        lut[i * 3] = Math.round(lerp(pal[lo][0], pal[hi][0], f) * 255);
        lut[i * 3 + 1] = Math.round(lerp(pal[lo][1], pal[hi][1], f) * 255);
        lut[i * 3 + 2] = Math.round(lerp(pal[lo][2], pal[hi][2], f) * 255);
      }
      return lut;
    }

    // ─── Visualization modes ──────────────────────────────────────────────────
    function getTimeRange(): [number, number] {
      const s =
        parseInt(
          (document.getElementById('ph-time-start') as HTMLInputElement).value,
        ) / 100;
      const e =
        parseInt(
          (document.getElementById('ph-time-end') as HTMLInputElement).value,
        ) / 100;
      return [Math.min(s, e), Math.max(s, e + 0.001)];
    }

    function getParams() {
      const num = (id: string) =>
        parseFloat((document.getElementById(id) as HTMLInputElement).value);
      return {
        freqMax: num('ph-freq-max'),
        rotation: num('ph-rotation'),
        warpStrength: num('ph-warp'),
        noiseAmount: num('ph-noise'),
        split: num('ph-split'),
      };
    }

    function renderWaterfall(
      data: SpectrogramData,
      lut: Uint8ClampedArray,
      t0: number,
      t1: number,
      params: ReturnType<typeof getParams>,
    ) {
      const { frames, numBins, sampleRate } = data;
      const W = canvas.width,
        H = canvas.height;
      const fStart = Math.floor(t0 * data.numFrames);
      const fEnd = Math.ceil(t1 * data.numFrames);
      const numVis = Math.max(1, fEnd - fStart);
      const freqMax = Math.min(params.freqMax, sampleRate / 2);
      const nyquist = sampleRate / 2;
      const melMin = hzToMel(20),
        melMax = hzToMel(freqMax);

      const img = ctx.createImageData(W, H);
      const d = img.data;

      for (let y = 0; y < H; y++) {
        const melFrac = (H - 1 - y) / (H - 1);
        const bin = Math.floor(
          (melToHz(melMin + melFrac * (melMax - melMin)) / nyquist) * numBins,
        );
        if (bin < 0 || bin >= numBins) continue;
        for (let x = 0; x < W; x++) {
          const fi = Math.floor((x / W) * numVis) + fStart;
          if (fi < 0 || fi >= frames.length) continue;
          const mag = frames[fi][bin];
          const pi = Math.floor(mag * 255) * 3;
          const di = (y * W + x) * 4;
          d[di] = lut[pi];
          d[di + 1] = lut[pi + 1];
          d[di + 2] = lut[pi + 2];
          d[di + 3] = 255;
        }
      }
      ctx.putImageData(img, 0, 0);
    }

    function renderRadial(
      data: SpectrogramData,
      lut: Uint8ClampedArray,
      t0: number,
      t1: number,
      params: ReturnType<typeof getParams>,
    ) {
      const { frames, numBins } = data;
      const W = canvas.width,
        H = canvas.height;
      const cx = W / 2,
        cy = H / 2;
      const maxR = Math.min(cx, cy) * 0.96;
      const minR = maxR * 0.04;
      const fStart = Math.floor(t0 * data.numFrames);
      const fEnd = Math.ceil(t1 * data.numFrames);
      const numVis = Math.max(1, fEnd - fStart);
      const rotOff = (params.rotation * Math.PI) / 180;

      const img = ctx.createImageData(W, H);
      const d = img.data;

      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          const dx = x - cx,
            dy = y - cy;
          const r = Math.sqrt(dx * dx + dy * dy);
          if (r < minR || r > maxR) continue;
          let angle = Math.atan2(dy, dx) - rotOff;
          if (angle < 0) angle += 2 * Math.PI;
          const tAng = angle / (2 * Math.PI);
          const fi = Math.floor(tAng * numVis) + fStart;
          if (fi < 0 || fi >= frames.length) continue;
          const binFrac = (r - minR) / (maxR - minR);
          const bin = Math.floor(binFrac * numBins);
          if (bin >= numBins) continue;
          const mag = frames[fi][bin];
          const pi = Math.floor(mag * 255) * 3;
          const di = (y * W + x) * 4;
          d[di] = lut[pi];
          d[di + 1] = lut[pi + 1];
          d[di + 2] = lut[pi + 2];
          d[di + 3] = 255;
        }
      }
      ctx.putImageData(img, 0, 0);
    }

    function renderGlitch(
      data: SpectrogramData,
      lut: Uint8ClampedArray,
      t0: number,
      t1: number,
      params: ReturnType<typeof getParams>,
    ) {
      // Base: waterfall
      renderWaterfall(data, lut, t0, t1, params);

      const { frames, numBins } = data;
      const W = canvas.width,
        H = canvas.height;
      const fStart = Math.floor(t0 * data.numFrames);
      const fEnd = Math.ceil(t1 * data.numFrames);
      const numVis = Math.max(1, fEnd - fStart);
      const warp = params.warpStrength;
      const noise = params.noiseAmount;

      // Spectral flux per visible frame
      const flux = new Float32Array(numVis);
      for (let f = 1; f < numVis; f++) {
        const fi = f + fStart;
        if (fi >= frames.length || fi - 1 < 0 || fi - 1 >= frames.length)
          continue;
        let sum = 0;
        for (let b = 0; b < numBins; b++) {
          const d = frames[fi][b] - frames[fi - 1][b];
          if (d > 0) sum += d;
        }
        flux[f] = sum / numBins;
      }
      let maxFlux = 0;
      for (const v of flux) if (v > maxFlux) maxFlux = v;
      if (maxFlux > 0) for (let i = 0; i < flux.length; i++) flux[i] /= maxFlux;

      const src = ctx.getImageData(0, 0, W, H);
      const srcD = new Uint8ClampedArray(src.data);
      const dst = src.data;

      const hash = (v: number) =>
        Math.abs(Math.sin(v * 127.1 + v * 311.7) * 43758.5453) % 1;

      for (let y = 0; y < H; y++) {
        const fiIdx = Math.floor((1 - y / H) * numVis);
        const fl = flux[Math.max(0, Math.min(numVis - 1, fiIdx))] || 0;
        const shift = Math.round(fl * warp * (hash(y) > 0.5 ? 1 : -1));
        for (let x = 0; x < W; x++) {
          const sx = (((x - shift) % W) + W) % W;
          const si = (y * W + sx) * 4;
          const di = (y * W + x) * 4;
          let r = srcD[si],
            g = srcD[si + 1],
            b = srcD[si + 2];
          // Hue rotate on high-flux rows
          if (fl > 0.4) {
            const hue = ((fl - 0.4) * (1 / 0.6) * 120 * Math.PI) / 180;
            const cs = Math.cos(hue),
              sn = Math.sin(hue);
            const nr =
              r * (0.213 + cs * 0.787 - sn * 0.213) +
              g * (0.213 - cs * 0.213 + sn * 0.143) +
              b * (0.213 - cs * 0.213 - sn * 0.787);
            const ng =
              r * (0.715 - cs * 0.715 - sn * 0.715) +
              g * (0.715 + cs * 0.285 + sn * 0.14) +
              b * (0.715 - cs * 0.715 + sn * 0.14);
            const nb =
              r * (0.072 - cs * 0.072 + sn * 0.928) +
              g * (0.072 - cs * 0.072 - sn * 0.283) +
              b * (0.072 + cs * 0.928 + sn * 0.072);
            r = Math.min(255, Math.max(0, nr));
            g = Math.min(255, Math.max(0, ng));
            b = Math.min(255, Math.max(0, nb));
          }
          if (noise > 0) {
            const n =
              (hash(x * 0.3 + y * 0.71 + fl) - 0.5) * 2 * noise * 128 * fl;
            r = Math.min(255, Math.max(0, r + n));
            g = Math.min(255, Math.max(0, g + n));
            b = Math.min(255, Math.max(0, b + n));
          }
          dst[di] = r;
          dst[di + 1] = g;
          dst[di + 2] = b;
          dst[di + 3] = 255;
        }
      }
      ctx.putImageData(src, 0, 0);
    }

    function renderHybrid(
      data: SpectrogramData,
      lut: Uint8ClampedArray,
      t0: number,
      t1: number,
      params: ReturnType<typeof getParams>,
    ) {
      const { frames, numBins, sampleRate, waveform } = data;
      const W = canvas.width,
        H = canvas.height;
      const fStart = Math.floor(t0 * data.numFrames);
      const fEnd = Math.ceil(t1 * data.numFrames);
      const numVis = Math.max(1, fEnd - fStart);
      const split = params.split;
      const splitY = Math.floor(H * (1 - split));
      const freqMax = Math.min(params.freqMax, sampleRate / 2);
      const nyquist = sampleRate / 2;
      const melMin = hzToMel(20),
        melMax = hzToMel(freqMax);

      const img = ctx.createImageData(W, H);
      const d = img.data;

      // Top section: waveform
      for (let y = 0; y < splitY; y++) {
        const midY = splitY * 0.5;
        for (let x = 0; x < W; x++) {
          const fi = Math.floor((x / W) * numVis) + fStart;
          if (fi < 0 || fi >= waveform.length) continue;
          const amp = waveform[fi];
          if (Math.abs(y - midY) < amp * midY * 0.9) {
            const mag = amp;
            const pi = Math.floor(mag * 255) * 3;
            const di = (y * W + x) * 4;
            d[di] = lut[pi];
            d[di + 1] = lut[pi + 1];
            d[di + 2] = lut[pi + 2];
            d[di + 3] = 255;
          }
        }
      }

      // Bottom section: spectrogram
      const specH = H - splitY;
      for (let y = splitY; y < H; y++) {
        const melFrac = (specH - 1 - (y - splitY)) / (specH - 1);
        const bin = Math.floor(
          (melToHz(melMin + melFrac * (melMax - melMin)) / nyquist) * numBins,
        );
        if (bin < 0 || bin >= numBins) continue;
        for (let x = 0; x < W; x++) {
          const fi = Math.floor((x / W) * numVis) + fStart;
          if (fi < 0 || fi >= frames.length) continue;
          const mag = frames[fi][bin];
          const pi = Math.floor(mag * 255) * 3;
          const di = (y * W + x) * 4;
          d[di] = lut[pi];
          d[di + 1] = lut[pi + 1];
          d[di + 2] = lut[pi + 2];
          d[di + 3] = 255;
        }
      }

      // Seam interference
      const seamH = 3;
      for (
        let y = Math.max(0, splitY - seamH);
        y < Math.min(H, splitY + seamH);
        y++
      ) {
        for (let x = 0; x < W; x++) {
          const fi = Math.floor((x / W) * numVis) + fStart;
          const wv = fi >= 0 && fi < waveform.length ? waveform[fi] : 0;
          const t = Math.sin(x * 0.15 + wv * 8) * 0.5 + 0.5;
          const pi = Math.floor(t * 255) * 3;
          const di = (y * W + x) * 4;
          d[di] = lut[pi];
          d[di + 1] = lut[pi + 1];
          d[di + 2] = lut[pi + 2];
          d[di + 3] = 255;
        }
      }

      ctx.putImageData(img, 0, 0);
    }

    // ─── Main render dispatch ─────────────────────────────────────────────────
    function render(t0?: number, t1?: number) {
      if (!spectrogramData) return;
      const [a, b] = t0 !== undefined ? [t0, t1!] : getTimeRange();
      const params = getParams();
      const data = fxPreviewFrames
        ? { ...spectrogramData, frames: fxPreviewFrames }
        : editedFrames
          ? { ...spectrogramData, frames: editedFrames }
          : spectrogramData;
      switch (currentMode) {
        case 'waterfall':
          renderWaterfall(data, paletteLUT, a, b, params);
          break;
        case 'radial':
          renderRadial(data, paletteLUT, a, b, params);
          break;
        case 'glitch':
          renderGlitch(data, paletteLUT, a, b, params);
          break;
        case 'hybrid':
          renderHybrid(data, paletteLUT, a, b, params);
          break;
      }
    }

    function scheduleRender() {
      if (renderPending) return;
      renderPending = true;
      requestAnimationFrame(() => {
        renderPending = false;
        render();
      });
    }

    // ─── Mini waveform ────────────────────────────────────────────────────────
    function drawMiniWaveform(waveform: Float32Array, cursor?: number) {
      const wc = document.getElementById('ph-waveform') as HTMLCanvasElement;
      const wctx = wc.getContext('2d')!;
      const W = wc.width,
        H = wc.height;
      wctx.clearRect(0, 0, W, H);
      wctx.fillStyle = '#111';
      wctx.fillRect(0, 0, W, H);
      wctx.strokeStyle = '#666';
      wctx.lineWidth = 1;
      const mid = H / 2;
      wctx.beginPath();
      for (let x = 0; x < W; x++) {
        const fi = Math.floor((x / W) * waveform.length);
        const amp = waveform[fi] * mid * 0.9;
        if (x === 0) wctx.moveTo(x, mid - amp);
        else wctx.lineTo(x, mid - amp);
      }
      wctx.stroke();
      wctx.beginPath();
      for (let x = 0; x < W; x++) {
        const fi = Math.floor((x / W) * waveform.length);
        const amp = waveform[fi] * mid * 0.9;
        if (x === 0) wctx.moveTo(x, mid + amp);
        else wctx.lineTo(x, mid + amp);
      }
      wctx.stroke();
      // Playback cursor
      if (cursor !== undefined) {
        const cx = Math.round(cursor * W);
        wctx.strokeStyle = 'rgba(255,220,80,0.9)';
        wctx.lineWidth = 2;
        wctx.beginPath();
        wctx.moveTo(cx, 0);
        wctx.lineTo(cx, H);
        wctx.stroke();
      }
    }

    // ─── Audio loading ────────────────────────────────────────────────────────
    async function loadAudioData(arrayBuf: ArrayBuffer, name: string) {
      const busyEl = document.getElementById('ph-busy')!;
      const busyLabel = document.getElementById('ph-busy-label')!;
      const emptyEl = document.getElementById('ph-empty')!;
      const dropEmpty = document.getElementById('ph-drop-empty')!;
      const waveformCanvas = document.getElementById(
        'ph-waveform',
      ) as HTMLCanvasElement;
      const metaEl = document.getElementById('ph-audio-meta')!;
      const actionBar = document.getElementById('ph-action-bar')!;

      emptyEl.style.display = 'none';
      busyEl.style.display = 'flex';
      busyLabel.textContent = 'Decoding…';
      actionBar.style.display = 'none';
      editedFrames = null;
      undoStack.length = 0;
      editedAudioBuffer = null;
      editedAudioStale = false;
      playMode = 'original';
      updateUndoBtn();
      updatePlayModeUI();
      if (paintMode) setPaintMode(false);

      try {
        lastArrayBuf = arrayBuf.slice(0); // store a copy for FFT size recompute
        lastFileName = name;

        const audioCtx = new OfflineAudioContext(1, 1, 44100);
        const audioBuffer = await audioCtx.decodeAudioData(arrayBuf);
        currentAudioBuffer = audioBuffer;

        busyLabel.textContent = 'Analyzing…';
        const fftSize = parseInt(
          (document.getElementById('ph-fft') as HTMLSelectElement).value,
        );
        spectrogramData = await computeSpectrogram(
          audioBuffer,
          fftSize,
          (p) => {
            busyLabel.textContent = `Analyzing… ${Math.round(p * 100)}%`;
          },
        );

        drawMiniWaveform(spectrogramData.waveform);
        dropEmpty.style.display = 'none';
        const mins = Math.floor(audioBuffer.duration / 60);
        const secs = Math.floor(audioBuffer.duration % 60);
        metaEl.textContent = `${name} · ${mins}:${String(secs).padStart(2, '0')}`;
        document.getElementById('ph-loaded-zone')!.style.display = 'block';

        busyEl.style.display = 'none';
        actionBar.style.display = 'flex';
        render();
      } catch (err) {
        busyEl.style.display = 'none';
        dropEmpty.style.display = '';
        document.getElementById('ph-loaded-zone')!.style.display = 'none';
        emptyEl.style.display = 'flex';
        (emptyEl as HTMLElement).textContent = 'Failed to decode audio file';
        console.error(err);
      }
    }

    async function loadAudioFile(file: File) {
      loadAudioData(await file.arrayBuffer(), file.name);
    }

    // ─── CRC-32 ───────────────────────────────────────────────────────────────
    const CRC_TABLE = (() => {
      const t = new Uint32Array(256);
      for (let i = 0; i < 256; i++) {
        let c = i;
        for (let j = 0; j < 8; j++)
          c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
        t[i] = c;
      }
      return t;
    })();

    function crc32(data: Uint8Array): number {
      let crc = 0xffffffff;
      for (const byte of data)
        crc = CRC_TABLE[(crc ^ byte) & 0xff] ^ (crc >>> 8);
      return (crc ^ 0xffffffff) >>> 0;
    }

    // ─── ZIP builder (STORE, no compression) ─────────────────────────────────
    function buildZip(
      files: { name: string; data: Uint8Array }[],
    ): ArrayBuffer {
      const enc = new TextEncoder();
      type Entry = {
        header: Uint8Array;
        data: Uint8Array;
        nameB: Uint8Array;
        crc: number;
        off: number;
      };
      const entries: Entry[] = [];
      let off = 0;

      for (const f of files) {
        const nameB = enc.encode(f.name);
        const crc = crc32(f.data);
        const hdr = new Uint8Array(30 + nameB.length);
        const v = new DataView(hdr.buffer);
        v.setUint32(0, 0x04034b50, true);
        v.setUint16(4, 20, true);
        v.setUint16(8, 0, true); // method: STORE
        v.setUint32(14, crc, true);
        v.setUint32(18, f.data.length, true);
        v.setUint32(22, f.data.length, true);
        v.setUint16(26, nameB.length, true);
        hdr.set(nameB, 30);
        entries.push({ header: hdr, data: f.data, nameB, crc, off });
        off += hdr.length + f.data.length;
      }

      const cdParts: Uint8Array[] = [];
      let cdSize = 0;
      const cdOff = off;
      for (const e of entries) {
        const cd = new Uint8Array(46 + e.nameB.length);
        const v = new DataView(cd.buffer);
        v.setUint32(0, 0x02014b50, true);
        v.setUint16(4, 20, true);
        v.setUint16(6, 20, true);
        v.setUint32(16, e.crc, true);
        v.setUint32(20, e.data.length, true);
        v.setUint32(24, e.data.length, true);
        v.setUint16(28, e.nameB.length, true);
        v.setUint32(42, e.off, true);
        cd.set(e.nameB, 46);
        cdParts.push(cd);
        cdSize += cd.length;
      }

      const eocd = new Uint8Array(22);
      const ev = new DataView(eocd.buffer);
      ev.setUint32(0, 0x06054b50, true);
      ev.setUint16(8, entries.length, true);
      ev.setUint16(10, entries.length, true);
      ev.setUint32(12, cdSize, true);
      ev.setUint32(16, cdOff, true);

      const out = new Uint8Array(cdOff + cdSize + 22);
      let pos = 0;
      for (const e of entries) {
        out.set(e.header, pos);
        pos += e.header.length;
        out.set(e.data, pos);
        pos += e.data.length;
      }
      for (const cd of cdParts) {
        out.set(cd, pos);
        pos += cd.length;
      }
      out.set(eocd, pos);
      return out.buffer;
    }

    // ─── Output actions ───────────────────────────────────────────────────────
    async function saveImage() {
      if (!spectrogramData) return;
      const btn = document.getElementById('ph-save-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Saving…';
      try {
        const blob = await new Promise<Blob>((res) =>
          canvas.toBlob((b) => res(b!), 'image/png'),
        );
        const fd = new FormData();
        fd.append('file', blob, 'photism.png');
        fd.append('tags', 'photism,atelier');
        fd.append('output_index', 'outputs');
        const res = await fetch('/api/media/upload', {
          method: 'POST',
          body: fd,
          credentials: 'include',
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        (window as any).toast?.success('Saved to outputs');
      } catch (err: any) {
        (window as any).toast?.error(`Save failed: ${err.message}`);
      } finally {
        btn.disabled = false;
        btn.textContent = '☁ Save Image';
      }
    }

    async function recordWebM() {
      if (!spectrogramData) return;
      const btn = document.getElementById('ph-record-btn') as HTMLButtonElement;
      const fps = parseInt(
        (document.getElementById('ph-fps') as HTMLSelectElement).value,
      );
      const durationSec = 6;
      const totalFrames = fps * durationSec;
      btn.disabled = true;

      let stream: MediaStream;
      try {
        stream = (canvas as any).captureStream(fps);
      } catch {
        btn.disabled = false;
        return;
      }

      const mimeType = MediaRecorder.isTypeSupported('video/webm;codecs=vp9')
        ? 'video/webm;codecs=vp9'
        : 'video/webm';
      const recorder = new MediaRecorder(stream, { mimeType });
      const chunks: BlobPart[] = [];
      recorder.ondataavailable = (e) => {
        if (e.data.size > 0) chunks.push(e.data);
      };
      recorder.onstop = () => {
        const blob = new Blob(chunks, { type: 'video/webm' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'photism.webm';
        a.click();
        btn.disabled = false;
        btn.textContent = '⏺ Record WebM';
      };

      recorder.start(100);
      for (let i = 0; i <= totalFrames; i++) {
        const p = i / totalFrames;
        render(0, p);
        btn.textContent = `${Math.round(p * 100)}%`;
        await new Promise((r) => setTimeout(r, 1000 / fps));
      }
      recorder.stop();
      render(); // restore current view
    }

    async function saveFrames() {
      if (!spectrogramData) return;
      const btn = document.getElementById('ph-frames-btn') as HTMLButtonElement;
      btn.disabled = true;
      const N = 60;
      const pngFiles: { name: string; data: Uint8Array }[] = [];
      for (let i = 0; i < N; i++) {
        render(0, i / (N - 1));
        btn.textContent = `${i + 1}/${N}`;
        const blob = await new Promise<Blob>((res) =>
          canvas.toBlob((b) => res(b!), 'image/png'),
        );
        pngFiles.push({
          name: `photism-${String(i).padStart(4, '0')}.png`,
          data: new Uint8Array(await blob.arrayBuffer()),
        });
        await yieldToUI();
      }
      render(); // restore
      const zip = buildZip(pngFiles);
      const a = document.createElement('a');
      a.href = URL.createObjectURL(
        new Blob([zip], { type: 'application/zip' }),
      );
      a.download = 'photism-frames.zip';
      a.click();
      btn.disabled = false;
      btn.textContent = '⬇ Save Frames';
    }

    // ─── WAV encoding ─────────────────────────────────────────────────────────
    function encodeWAV(signal: Float32Array, sampleRate: number): ArrayBuffer {
      const numSamples = signal.length;
      const buf = new ArrayBuffer(44 + numSamples * 2);
      const v = new DataView(buf);
      const writeStr = (off: number, s: string) => {
        for (let i = 0; i < s.length; i++) v.setUint8(off + i, s.charCodeAt(i));
      };
      writeStr(0, 'RIFF');
      v.setUint32(4, 36 + numSamples * 2, true);
      writeStr(8, 'WAVE');
      writeStr(12, 'fmt ');
      v.setUint32(16, 16, true);
      v.setUint16(20, 1, true);
      v.setUint16(22, 1, true);
      v.setUint32(24, sampleRate, true);
      v.setUint32(28, sampleRate * 2, true);
      v.setUint16(32, 2, true);
      v.setUint16(34, 16, true);
      writeStr(36, 'data');
      v.setUint32(40, numSamples * 2, true);
      for (let i = 0; i < numSamples; i++) {
        v.setInt16(
          44 + i * 2,
          Math.max(-32768, Math.min(32767, Math.round(signal[i] * 32767))),
          true,
        );
      }
      return buf;
    }

    // ─── ISTFT with Overlap-Add (OLA) ────────────────────────────────────────
    // frames: log-normalized magnitudes (display space)
    // phases: raw atan2 phase per bin per frame
    // maxMag: raw peak magnitude stored during analysis (used to invert log)
    async function istftOLA(
      frames: Float32Array[],
      phases: Float32Array[],
      maxMag: number,
      fftSize: number,
      hopSamples: number,
      progressCb: (p: number) => void,
    ): Promise<Float32Array> {
      const numFrames = frames.length;
      const numBins = fftSize >> 1;
      const totalSamples = (numFrames - 1) * hopSamples + fftSize;
      const signal = new Float32Array(totalSamples);
      const norm = new Float32Array(totalSamples);
      const hann = hannWindow(fftSize);
      const re = new Float64Array(fftSize);
      const im = new Float64Array(fftSize);
      const CHUNK = 8;

      for (let f = 0; f < numFrames; f++) {
        const frame = frames[f];
        const phase = phases[f];

        // Reconstruct complex spectrum from log-normalized mag + raw phase
        // Inverse of: v = log1p(raw/maxMag * 100) / log(101)
        // → raw = maxMag * (101^v - 1) / 100
        re.fill(0);
        im.fill(0);
        for (let b = 0; b < numBins; b++) {
          const rawMag = (maxMag * (Math.pow(101, frame[b]) - 1)) / 100;
          re[b] = rawMag * Math.cos(phase[b]);
          im[b] = rawMag * Math.sin(phase[b]);
        }
        // Conjugate symmetry for real-valued IFFT output
        for (let b = 1; b < numBins; b++) {
          re[fftSize - b] = re[b];
          im[fftSize - b] = -im[b];
        }

        // IFFT: negate im, forward FFT, negate im, divide by N
        for (let i = 0; i < fftSize; i++) im[i] = -im[i];
        fft(re, im);
        const inv = 1 / fftSize;
        for (let i = 0; i < fftSize; i++) {
          re[i] *= inv;
          im[i] = -im[i] * inv;
        }
        // re[i] is the time-domain frame; im should be ~0 (conjugate symmetry ensures real output)

        // Overlap-add with Hann window + accumulate normalization
        const start = f * hopSamples;
        for (let i = 0; i < fftSize; i++) {
          const idx = start + i;
          if (idx >= totalSamples) break;
          const w = hann[i];
          signal[idx] += re[i] * w;
          norm[idx] += w * w;
        }

        if (f % CHUNK === CHUNK - 1) {
          progressCb(f / numFrames);
          await yieldToUI();
        }
      }

      // Normalize by accumulated window energy, then peak-normalize
      for (let i = 0; i < totalSamples; i++) {
        if (norm[i] > 1e-8) signal[i] /= norm[i];
      }
      let peak = 0;
      for (let i = 0; i < totalSamples; i++)
        if (Math.abs(signal[i]) > peak) peak = Math.abs(signal[i]);
      if (peak > 0) for (let i = 0; i < totalSamples; i++) signal[i] /= peak;
      return signal;
    }

    // ─── Spectral effects (operate directly on Float32 magnitude data) ────────
    // These modify editedFrames, so they affect both display AND audio export.

    function fxGaussianBlur(
      frames: Float32Array[],
      radius: number,
    ): Float32Array[] {
      const nF = frames.length,
        nB = frames[0].length;
      // Pre-compute Gaussian weights
      const weights: number[] = [];
      let wSum = 0;
      for (let k = -radius; k <= radius; k++) {
        const w = Math.exp((-k * k) / (2 * (radius / 2) * (radius / 2) + 1e-6));
        weights.push(w);
        wSum += w;
      }
      for (let i = 0; i < weights.length; i++) weights[i] /= wSum;
      // Frequency pass
      const tmp: Float32Array[] = frames.map((fr) => new Float32Array(nB));
      for (let f = 0; f < nF; f++) {
        for (let b = 0; b < nB; b++) {
          let v = 0;
          for (let k = 0; k < weights.length; k++) {
            const nb = Math.max(0, Math.min(nB - 1, b - radius + k));
            v += frames[f][nb] * weights[k];
          }
          tmp[f][b] = v;
        }
      }
      // Time pass
      const out: Float32Array[] = frames.map(() => new Float32Array(nB));
      for (let b = 0; b < nB; b++) {
        for (let f = 0; f < nF; f++) {
          let v = 0;
          for (let k = 0; k < weights.length; k++) {
            const nf = Math.max(0, Math.min(nF - 1, f - radius + k));
            v += tmp[nf][b] * weights[k];
          }
          out[f][b] = v;
        }
      }
      return out;
    }

    function fxSharpen(frames: Float32Array[], amount: number): Float32Array[] {
      const blurred = fxGaussianBlur(frames, 2);
      return frames.map((fr, f) => {
        const out = new Float32Array(fr.length);
        for (let b = 0; b < fr.length; b++) {
          out[b] = Math.max(
            0,
            Math.min(1, fr[b] + amount * (fr[b] - blurred[f][b])),
          );
        }
        return out;
      });
    }

    function fxPitchShift(
      frames: Float32Array[],
      semitones: number,
    ): Float32Array[] {
      const ratio = Math.pow(2, semitones / 12);
      return frames.map((fr) => {
        const out = new Float32Array(fr.length);
        for (let b = 0; b < fr.length; b++) {
          const srcB = b / ratio;
          const lo = Math.floor(srcB),
            hi = Math.ceil(srcB);
          const t = srcB - lo;
          const loV = lo >= 0 && lo < fr.length ? fr[lo] : 0;
          const hiV = hi >= 0 && hi < fr.length ? fr[hi] : 0;
          out[b] = loV * (1 - t) + hiV * t;
        }
        return out;
      });
    }

    function fxReverse(frames: Float32Array[]): Float32Array[] {
      return [...frames].reverse().map((fr) => fr.slice());
    }

    function fxPixelate(
      frames: Float32Array[],
      blockW: number,
      blockH: number,
    ): Float32Array[] {
      const nF = frames.length,
        nB = frames[0].length;
      // Pre-compute block averages
      const out = frames.map(() => new Float32Array(nB));
      for (let bf = 0; bf < Math.ceil(nF / blockW); bf++) {
        for (let bb = 0; bb < Math.ceil(nB / blockH); bb++) {
          let sum = 0,
            count = 0;
          for (let df = 0; df < blockW; df++) {
            const f = bf * blockW + df;
            if (f >= nF) continue;
            for (let db = 0; db < blockH; db++) {
              const b = bb * blockH + db;
              if (b >= nB) continue;
              sum += frames[f][b];
              count++;
            }
          }
          const avg = count > 0 ? sum / count : 0;
          for (let df = 0; df < blockW; df++) {
            const f = bf * blockW + df;
            if (f >= nF) continue;
            for (let db = 0; db < blockH; db++) {
              const b = bb * blockH + db;
              if (b >= nB) continue;
              out[f][b] = avg;
            }
          }
        }
      }
      return out;
    }

    // Map effect name + strength (1–20) → transformed frames for preview
    function computeFxPreview(
      effect: string,
      strength: number,
    ): Float32Array[] | null {
      if (!spectrogramData) return null;
      const src = editedFrames ?? spectrogramData.frames;
      switch (effect) {
        case 'blur':
          return fxGaussianBlur(src, Math.max(1, Math.round(strength / 2)));
        case 'sharpen':
          return fxSharpen(src, strength * 0.15);
        case 'pitch-up':
          return fxPitchShift(src, strength * 0.6);
        case 'pitch-dn':
          return fxPitchShift(src, -strength * 0.6);
        case 'reverse':
          return fxReverse(src);
        case 'pixelate':
          return fxPixelate(
            src,
            Math.max(2, strength),
            Math.max(2, Math.round(strength / 2)),
          );
        default:
          return null;
      }
    }

    async function exportAudio() {
      if (!spectrogramData) return;
      const busyEl = document.getElementById('ph-busy')!;
      const busyLabel = document.getElementById('ph-busy-label')!;
      busyEl.style.display = 'flex';
      exportMenu.style.display = 'none';

      const [t0, t1] = getTimeRange();
      const { sampleRate, numFrames, phases, maxMag } = spectrogramData;
      const frames = editedFrames ?? spectrogramData.frames;
      const fftSize = parseInt(
        (document.getElementById('ph-fft') as HTMLSelectElement).value,
      );
      const hopSamples = fftSize >> 2;
      const fStart = Math.floor(t0 * numFrames);
      const fEnd = Math.ceil(t1 * numFrames);
      const trimmedFrames = frames.slice(fStart, fEnd);
      const trimmedPhases = phases.slice(fStart, fEnd);

      try {
        const signal = await istftOLA(
          trimmedFrames,
          trimmedPhases,
          maxMag,
          fftSize,
          hopSamples,
          (p) => {
            busyLabel.textContent = `Synthesizing… ${Math.round(p * 100)}%`;
          },
        );
        const wav = encodeWAV(signal, sampleRate);
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([wav], { type: 'audio/wav' }));
        a.download = `${lastFileName.replace(/\.[^.]+$/, '')}-synth.wav`;
        a.click();
      } finally {
        busyEl.style.display = 'none';
      }
    }

    async function exportAudioToStacks() {
      if (!spectrogramData) return;
      const busyEl = document.getElementById('ph-busy')!;
      const busyLabel = document.getElementById('ph-busy-label')!;
      busyEl.style.display = 'flex';
      exportMenu.style.display = 'none';

      const [t0, t1] = getTimeRange();
      const { sampleRate, numFrames, phases, maxMag } = spectrogramData;
      const frames = editedFrames ?? spectrogramData.frames;
      const fftSize = parseInt(
        (document.getElementById('ph-fft') as HTMLSelectElement).value,
      );
      const hopSamples = fftSize >> 2;
      const fStart = Math.floor(t0 * numFrames);
      const fEnd = Math.ceil(t1 * numFrames);
      const trimmedFrames = frames.slice(fStart, fEnd);
      const trimmedPhases = phases.slice(fStart, fEnd);

      try {
        const signal = await istftOLA(
          trimmedFrames,
          trimmedPhases,
          maxMag,
          fftSize,
          hopSamples,
          (p) => {
            busyLabel.textContent = `Synthesizing… ${Math.round(p * 100)}%`;
          },
        );
        busyLabel.textContent = 'Uploading…';
        const wav = encodeWAV(signal, sampleRate);
        const filename = `${lastFileName.replace(/\.[^.]+$/, '')}-synth.wav`;
        const fd = new FormData();
        fd.append('file', new Blob([wav], { type: 'audio/wav' }), filename);
        fd.append('tags', 'photism,atelier,audio');
        fd.append('output_index', 'outputs');
        const res = await fetch('/api/media/upload', {
          method: 'POST',
