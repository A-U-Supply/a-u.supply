    async function loadImgLibItems(q: string) {
      imgModalGrid.innerHTML = '<div class="ph-modal__loading">Loading…</div>';
      try {
        const res = await fetch('/api/search', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            query: q,
            media_types: ['image'],
            sort: 'created_at:desc',
            page: 1,
            per_page: 48,
            filters: {
              output_index: [
                imgLibTab === 'inputs' ? '__inputs__' : '__outputs__',
              ],
            },
          }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const items: {
          id: string;
          filename?: string;
          original_filename?: string;
        }[] = data.results ?? data.hits ?? [];
        if (items.length === 0) {
          imgModalGrid.innerHTML =
            '<div class="ph-modal__loading">No images found</div>';
          return;
        }
        imgModalGrid.innerHTML = '';
        for (const item of items) {
          const name = item.filename || item.original_filename || item.id;
          const card = document.createElement('div');
          card.className = 'ph-audio-card';
          card.innerHTML = `<div class="ph-audio-card__icon">🖼</div>
            <div class="ph-audio-card__name" title="${name}">${name}</div>`;
          card.addEventListener('click', async () => {
            closeImgLibrary();
            try {
              const r = await fetch(`/api/media/${item.id}/file`, {
                credentials: 'include',
              });
              if (!r.ok) throw new Error(`HTTP ${r.status}`);
              const buf = await r.arrayBuffer();
              loadStampImageFromBuffer(buf, name);
            } catch (err: any) {
              (window as any).toast?.error(`Load failed: ${err.message}`);
            }
          });
          imgModalGrid.appendChild(card);
        }
      } catch {
        imgModalGrid.innerHTML =
          '<div class="ph-modal__loading">Failed to load</div>';
      }
    }

