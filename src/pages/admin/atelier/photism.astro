---
import Admin from '../../../layouts/Admin.astro';
---

<Admin title="Photism" current="photism">
  <div class="page-header">
    <h1>Photism</h1>
    <p class="page-subtitle">audio → image translation</p>
  </div>

  <div class="ph-shell">
    <!-- ── Controls ─────────────────────────────────────────── -->
    <div class="ph-controls">

      <!-- Upload zone -->
      <div class="ph-drop-zone" id="ph-drop-zone">
        <div class="ph-drop-empty" id="ph-drop-empty">
          <div class="ph-drop-icon">♫</div>
          <div class="ph-drop-hint">Drop audio or click to upload</div>
          <div class="ph-drop-sub">MP3 · WAV · OGG · FLAC · M4A</div>
        </div>
        <canvas id="ph-waveform" width="264" height="52" style="display:none"></canvas>
        <div id="ph-audio-meta" class="ph-audio-meta" style="display:none"></div>
        <input type="file" id="ph-file-input" accept="audio/*" style="display:none" />
      </div>
      <button class="btn btn--secondary ph-lib-btn" id="ph-lib-btn">Pick from Library</button>

      <div class="ph-divider"></div>

      <!-- Mode -->
      <div class="ph-label-row">Mode</div>
      <div class="ph-pill-group" id="ph-mode-group">
        <button class="ph-pill ph-pill--on" data-val="waterfall">Waterfall</button>
        <button class="ph-pill" data-val="radial">Radial</button>
        <button class="ph-pill" data-val="glitch">Glitch</button>
        <button class="ph-pill" data-val="hybrid">Hybrid</button>
      </div>

      <!-- Palette -->
      <div class="ph-label-row">Palette</div>
      <div class="ph-pill-group" id="ph-palette-group">
        <button class="ph-pill ph-pill--on" data-val="hot">Hot</button>
        <button class="ph-pill" data-val="viridis">Viridis</button>
        <button class="ph-pill" data-val="mono">Mono</button>
        <button class="ph-pill" data-val="acid">Acid</button>
      </div>

      <div class="ph-divider"></div>

      <!-- Shared params -->
      <div class="ph-field">
        <label class="ph-label" for="ph-fft">FFT Size</label>
        <select class="ph-select" id="ph-fft">
          <option value="512">512</option>
          <option value="1024" selected>1024</option>
          <option value="2048">2048</option>
          <option value="4096">4096</option>
        </select>
      </div>

      <div class="ph-field">
        <label class="ph-label" for="ph-time-start">Start <span class="ph-val" id="ph-ts-val">0%</span></label>
        <input class="ph-range" type="range" id="ph-time-start" min="0" max="100" value="0" />
      </div>
      <div class="ph-field">
        <label class="ph-label" for="ph-time-end">End <span class="ph-val" id="ph-te-val">100%</span></label>
        <input class="ph-range" type="range" id="ph-time-end" min="0" max="100" value="100" />
      </div>

      <div class="ph-divider"></div>

      <!-- Waterfall params -->
      <div class="ph-mode-params" data-ph-mode="waterfall">
        <div class="ph-field">
          <label class="ph-label" for="ph-freq-max">Max Freq <span class="ph-val" id="ph-fmax-val">8 kHz</span></label>
          <input class="ph-range" type="range" id="ph-freq-max" min="1000" max="22050" step="100" value="8000" />
        </div>
      </div>

      <!-- Radial params -->
      <div class="ph-mode-params" data-ph-mode="radial" style="display:none">
        <div class="ph-field">
          <label class="ph-label" for="ph-rotation">Rotation <span class="ph-val" id="ph-rot-val">0°</span></label>
          <input class="ph-range" type="range" id="ph-rotation" min="0" max="360" value="0" />
        </div>
      </div>

      <!-- Glitch params -->
      <div class="ph-mode-params" data-ph-mode="glitch" style="display:none">
        <div class="ph-field">
          <label class="ph-label" for="ph-warp">Warp <span class="ph-val" id="ph-warp-val">8</span></label>
          <input class="ph-range" type="range" id="ph-warp" min="0" max="20" step="0.5" value="8" />
        </div>
        <div class="ph-field">
          <label class="ph-label" for="ph-noise">Noise <span class="ph-val" id="ph-noise-val">0.30</span></label>
          <input class="ph-range" type="range" id="ph-noise" min="0" max="1" step="0.01" value="0.3" />
        </div>
      </div>

      <!-- Hybrid params -->
      <div class="ph-mode-params" data-ph-mode="hybrid" style="display:none">
        <div class="ph-field">
          <label class="ph-label" for="ph-split">Split <span class="ph-val" id="ph-split-val">0.50</span></label>
          <input class="ph-range" type="range" id="ph-split" min="0.2" max="0.8" step="0.01" value="0.5" />
        </div>
      </div>

      <div class="ph-divider"></div>

      <div class="ph-field">
        <label class="ph-label" for="ph-fps">Record FPS</label>
        <select class="ph-select" id="ph-fps">
          <option value="12">12 fps</option>
          <option value="24" selected>24 fps</option>
          <option value="30">30 fps</option>
        </select>
      </div>
    </div>

    <!-- ── Stage ──────────────────────────────────────────────── -->
    <div class="ph-stage">
      <div class="ph-canvas-wrap" id="ph-canvas-wrap">
        <canvas id="ph-canvas" width="900" height="600"></canvas>
        <div class="ph-empty" id="ph-empty">Upload an audio file to begin</div>
        <div class="ph-busy" id="ph-busy" style="display:none">
          <span id="ph-busy-label">Analyzing…</span>
        </div>
      </div>

      <div class="ph-action-bar" id="ph-action-bar" style="display:none">
        <button class="btn btn--secondary" id="ph-save-btn">☁ Save Image</button>
        <button class="btn btn--secondary" id="ph-record-btn">⏺ Record WebM</button>
        <button class="btn btn--secondary" id="ph-frames-btn">⬇ Save Frames</button>
      </div>
    </div>
  </div>

  <style>
    .ph-shell {
      display: flex;
      gap: 1.5rem;
      align-items: flex-start;
    }
    .ph-controls {
      width: 280px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .ph-stage {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    /* Drop zone */
    .ph-drop-zone {
      border: 1px solid var(--border, #333);
      border-radius: 4px;
      padding: 0.75rem;
      cursor: pointer;
      transition: border-color 0.15s;
      min-height: 90px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
    }
    .ph-drop-zone:hover,
    .ph-drop-zone.drag-over { border-color: var(--accent, #888); }
    .ph-drop-empty { text-align: center; }
    .ph-drop-icon { font-size: 1.4rem; opacity: 0.5; margin-bottom: 0.25rem; }
    .ph-drop-hint { font-size: 0.75rem; opacity: 0.7; }
    .ph-drop-sub  { font-size: 0.65rem; opacity: 0.4; margin-top: 0.15rem; }
    .ph-audio-meta { font-size: 0.65rem; opacity: 0.5; text-align: center; margin-top: 0.25rem; }
    #ph-waveform { width: 100%; border-radius: 2px; }

    /* Divider */
    .ph-divider { height: 1px; background: var(--border, #333); margin: 0.25rem 0; }

    /* Labels */
    .ph-label-row {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      opacity: 0.5;
      margin-bottom: 0.1rem;
    }

    /* Pill groups */
    .ph-pill-group { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-bottom: 0.5rem; }
    .ph-pill {
      font-size: 0.7rem;
      padding: 0.2rem 0.55rem;
      border: 1px solid var(--border, #444);
      border-radius: 3px;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: 0.55;
      transition: opacity 0.1s, border-color 0.1s;
    }
    .ph-pill:hover { opacity: 0.85; }
    .ph-pill--on { opacity: 1; border-color: var(--accent, #aaa); }

    /* Fields */
    .ph-field { display: flex; flex-direction: column; gap: 0.2rem; }
    .ph-label {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      opacity: 0.55;
      display: flex;
      justify-content: space-between;
    }
    .ph-val { opacity: 0.9; font-variant-numeric: tabular-nums; }
    .ph-select {
      font-size: 0.75rem;
      padding: 0.2rem 0.4rem;
      background: var(--bg2, #1a1a1a);
      border: 1px solid var(--border, #333);
      color: inherit;
      border-radius: 3px;
    }

    /* Canvas wrap */
    .ph-canvas-wrap {
      position: relative;
      background: #0a0a0a;
      border-radius: 4px;
      overflow: hidden;
    }
    #ph-canvas {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 3/2;
    }
    .ph-empty, .ph-busy {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      opacity: 0.35;
      pointer-events: none;
    }
    .ph-busy { opacity: 0.7; }

    /* Action bar */
    .ph-action-bar { display: flex; gap: 0.5rem; flex-wrap: wrap; }

    /* Library button */
    .ph-lib-btn { width: 100%; font-size: 0.75rem; }

    /* Library modal */
    .ph-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.78);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .ph-modal {
      background: var(--bg, #111);
      border: 1px solid var(--border, #333);
      border-radius: 6px;
      width: min(560px, 100%);
      max-height: 80vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .ph-modal__header {
      display: flex;
      align-items: center;
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--border, #333);
    }
    .ph-modal__title { font-size: 0.9rem; margin: 0; flex: 1; }
    .ph-modal__close {
      background: none; border: none; color: inherit; cursor: pointer;
      opacity: 0.5; font-size: 1rem; padding: 0.25rem 0.5rem;
    }
    .ph-modal__close:hover { opacity: 1; }
    .ph-modal__tabs { display: flex; border-bottom: 1px solid var(--border, #333); }
    .ph-modal__tab {
      flex: 1; padding: 0.5rem; font-size: 0.7rem;
      text-transform: uppercase; letter-spacing: 0.06em;
      background: none; border: none; color: inherit; cursor: pointer;
      opacity: 0.45; border-bottom: 2px solid transparent; transition: opacity 0.1s;
    }
    .ph-modal__tab:hover { opacity: 0.8; }
    .ph-modal__tab--active { opacity: 1; border-bottom-color: var(--accent, #888); }
    .ph-modal__toolbar { padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border, #222); }
    .ph-modal__search {
      width: 100%; box-sizing: border-box; font-size: 0.8rem; padding: 0.35rem 0.5rem;
      background: var(--bg2, #1a1a1a); border: 1px solid var(--border, #333);
      color: inherit; border-radius: 3px;
    }
    .ph-modal__grid {
      flex: 1; overflow-y: auto; padding: 0.5rem;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 0.4rem; align-content: start;
    }
    .ph-modal__loading {
      grid-column: 1/-1; text-align: center;
      padding: 2rem; font-size: 0.75rem; opacity: 0.4;
    }
    .ph-audio-card {
      border: 1px solid var(--border, #333); border-radius: 4px;
      padding: 0.6rem 0.7rem; cursor: pointer;
      transition: border-color 0.1s, background 0.1s;
      display: flex; flex-direction: column; gap: 0.2rem; min-width: 0;
    }
    .ph-audio-card:hover { border-color: var(--accent, #888); background: rgba(255,255,255,0.03); }
    .ph-audio-card__icon { font-size: 1.1rem; opacity: 0.35; }
    .ph-audio-card__name {
      font-size: 0.65rem; opacity: 0.8;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .ph-audio-card__meta { font-size: 0.6rem; opacity: 0.4; }

    /* Range touch target */
    .ph-range { width: 100%; accent-color: var(--accent, #888); cursor: pointer; }

    /* Responsive */
    @media (max-width: 700px) {
      .ph-shell { flex-direction: column; }
      .ph-controls { width: 100%; }
    }
    @media (max-width: 500px) {
      .ph-stage { order: -1; }
      #ph-canvas { aspect-ratio: 1 / 1; }
      .ph-pill { padding: 0.45rem 0.75rem; font-size: 0.8rem; }
      .ph-range { height: 2.75rem; }
      .ph-action-bar { flex-direction: column; }
      .ph-action-bar .btn { width: 100%; }
      .ph-label { font-size: 0.75rem; }
    }
  </style>

  <!-- ── Library modal ──────────────────────────────────────────── -->
  <div class="ph-modal-overlay" id="ph-modal-overlay" style="display:none">
    <div class="ph-modal">
      <div class="ph-modal__header">
        <h2 class="ph-modal__title">Pick Audio</h2>
        <button class="ph-modal__close" id="ph-modal-close">✕</button>
      </div>
      <div class="ph-modal__tabs" id="ph-modal-tabs">
        <button class="ph-modal__tab ph-modal__tab--active" data-tab="inputs">Inputs</button>
        <button class="ph-modal__tab" data-tab="outputs">Outputs</button>
        <button class="ph-modal__tab" data-tab="workspace">Workspace</button>
      </div>
      <div class="ph-modal__toolbar">
        <input class="ph-modal__search" type="text" id="ph-modal-search" placeholder="Search…" />
      </div>
      <div class="ph-modal__grid" id="ph-modal-grid">
        <div class="ph-modal__loading">Loading…</div>
      </div>
    </div>
  </div>

  <script>
    // ─── Types ────────────────────────────────────────────────────────────────
    interface SpectrogramData {
      frames: Float32Array[];
      numFrames: number;
      numBins: number;
      sampleRate: number;
      duration: number;
      waveform: Float32Array;
    }

    // ─── State ────────────────────────────────────────────────────────────────
    let spectrogramData: SpectrogramData | null = null;
    let currentMode = 'waterfall';
    let currentPalette = 'hot';
    let paletteLUT: Uint8ClampedArray = buildPaletteLUT('hot');
    let renderPending = false;
    let lastArrayBuf: ArrayBuffer | null = null;
    let lastFileName = 'audio';

    const canvas = document.getElementById('ph-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;

    // ─── FFT (Cooley-Tukey radix-2, in-place) ────────────────────────────────
    function fft(re: Float64Array, im: Float64Array): void {
      const n = re.length;
      for (let i = 1, j = 0; i < n; i++) {
        let bit = n >> 1;
        for (; j & bit; bit >>= 1) j ^= bit;
        j ^= bit;
        if (i < j) {
          let t = re[i]; re[i] = re[j]; re[j] = t;
          t = im[i]; im[i] = im[j]; im[j] = t;
        }
      }
      for (let len = 2; len <= n; len <<= 1) {
        const ang = -2 * Math.PI / len;
        const wRe = Math.cos(ang), wIm = Math.sin(ang);
        for (let i = 0; i < n; i += len) {
          let curRe = 1, curIm = 0;
          const half = len >> 1;
          for (let j = 0; j < half; j++) {
            const uRe = re[i + j], uIm = im[i + j];
            const vRe = re[i + j + half] * curRe - im[i + j + half] * curIm;
            const vIm = re[i + j + half] * curIm + im[i + j + half] * curRe;
            re[i + j]        = uRe + vRe; im[i + j]        = uIm + vIm;
            re[i + j + half] = uRe - vRe; im[i + j + half] = uIm - vIm;
            const nr = curRe * wRe - curIm * wIm;
            curIm = curRe * wIm + curIm * wRe; curRe = nr;
          }
        }
      }
    }

    function hannWindow(n: number): Float32Array {
      const w = new Float32Array(n);
      for (let i = 0; i < n; i++) w[i] = 0.5 * (1 - Math.cos(2 * Math.PI * i / (n - 1)));
      return w;
    }

    function hzToMel(hz: number): number { return 2595 * Math.log10(1 + hz / 700); }
    function melToHz(mel: number): number { return 700 * (Math.pow(10, mel / 2595) - 1); }

    // ─── Spectrogram computation ──────────────────────────────────────────────
    async function computeSpectrogram(audioBuffer: AudioBuffer, fftSize: number, progressCb: (p: number) => void): Promise<SpectrogramData> {
      const pcm = audioBuffer.getChannelData(0);
      const sampleRate = audioBuffer.sampleRate;
      const hop = fftSize >> 2;
      const hann = hannWindow(fftSize);
      const numBins = fftSize >> 1;
      const numFrames = Math.max(1, Math.floor((pcm.length - fftSize) / hop) + 1);
      const frames: Float32Array[] = [];
      const re = new Float64Array(fftSize);
      const im = new Float64Array(fftSize);
      const CHUNK = 40;

      for (let f = 0; f < numFrames; f++) {
        const start = f * hop;
        re.fill(0); im.fill(0);
        for (let i = 0; i < fftSize; i++) {
          re[i] = (start + i < pcm.length ? pcm[start + i] : 0) * hann[i];
        }
        fft(re, im);
        const mag = new Float32Array(numBins);
        for (let i = 0; i < numBins; i++) mag[i] = Math.sqrt(re[i] * re[i] + im[i] * im[i]);
        frames.push(mag);
        if (f % CHUNK === CHUNK - 1) { progressCb(f / numFrames); await yieldToUI(); }
      }

      // Log-magnitude normalize
      let maxMag = 0;
      for (const fr of frames) for (const v of fr) if (v > maxMag) maxMag = v;
      if (maxMag > 0) {
        const scale = 1 / maxMag;
        for (const fr of frames) for (let i = 0; i < fr.length; i++) {
          fr[i] = Math.log1p(fr[i] * scale * 100) / Math.log(101);
        }
      }

      // Waveform: RMS per frame
      const waveform = new Float32Array(numFrames);
      for (let f = 0; f < numFrames; f++) {
        const start = f * hop;
        let rms = 0;
        const end = Math.min(start + hop, pcm.length);
        for (let i = start; i < end; i++) rms += pcm[i] * pcm[i];
        waveform[f] = Math.sqrt(rms / (end - start));
      }

      return { frames, numFrames, numBins, sampleRate, duration: audioBuffer.duration, waveform };
    }

    function yieldToUI(): Promise<void> { return new Promise(r => setTimeout(r, 0)); }

    // ─── Palette builder ──────────────────────────────────────────────────────
    function buildPaletteLUT(name: string): Uint8ClampedArray {
      const lut = new Uint8ClampedArray(256 * 3);
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      const stops: Record<string, number[][]> = {
        hot:    [[0,0,0],[0.33,0,0],[0.67,0.35,0],[0.9,0.9,0],[1,1,1]],
        viridis:[[0.267,0.005,0.329],[0.229,0.322,0.545],[0.127,0.566,0.551],[0.369,0.788,0.384],[0.993,0.906,0.144]],
        mono:   [[0,0,0],[1,1,1]],
        acid:   [[0,0,0],[0.05,0.9,0.05],[0.5,0.05,0.85],[1,1,1]],
      };
      const pal = stops[name] ?? stops.hot;
      for (let i = 0; i < 256; i++) {
        const t = i / 255;
        const seg = t * (pal.length - 1);
        const lo = Math.floor(seg), hi = Math.min(lo + 1, pal.length - 1);
        const f = seg - lo;
        lut[i*3]   = Math.round(lerp(pal[lo][0], pal[hi][0], f) * 255);
        lut[i*3+1] = Math.round(lerp(pal[lo][1], pal[hi][1], f) * 255);
        lut[i*3+2] = Math.round(lerp(pal[lo][2], pal[hi][2], f) * 255);
      }
      return lut;
    }

    // ─── Visualization modes ──────────────────────────────────────────────────
    function getTimeRange(): [number, number] {
      const s = parseInt((document.getElementById('ph-time-start') as HTMLInputElement).value) / 100;
      const e = parseInt((document.getElementById('ph-time-end') as HTMLInputElement).value) / 100;
      return [Math.min(s, e), Math.max(s, e + 0.001)];
    }

    function getParams() {
      const num = (id: string) => parseFloat((document.getElementById(id) as HTMLInputElement).value);
      return {
        freqMax: num('ph-freq-max'),
        rotation: num('ph-rotation'),
        warpStrength: num('ph-warp'),
        noiseAmount: num('ph-noise'),
        split: num('ph-split'),
      };
    }

    function renderWaterfall(data: SpectrogramData, lut: Uint8ClampedArray, t0: number, t1: number, params: ReturnType<typeof getParams>) {
      const { frames, numBins, sampleRate } = data;
      const W = canvas.width, H = canvas.height;
      const fStart = Math.floor(t0 * data.numFrames);
      const fEnd   = Math.ceil(t1 * data.numFrames);
      const numVis = Math.max(1, fEnd - fStart);
      const freqMax = Math.min(params.freqMax, sampleRate / 2);
      const nyquist = sampleRate / 2;
      const melMin = hzToMel(20), melMax = hzToMel(freqMax);

      const img = ctx.createImageData(W, H);
      const d = img.data;

      for (let y = 0; y < H; y++) {
        const melFrac = (H - 1 - y) / (H - 1);
        const bin = Math.floor(melToHz(melMin + melFrac * (melMax - melMin)) / nyquist * numBins);
        if (bin < 0 || bin >= numBins) continue;
        for (let x = 0; x < W; x++) {
          const fi = Math.floor(x / W * numVis) + fStart;
          if (fi < 0 || fi >= frames.length) continue;
          const mag = frames[fi][bin];
          const pi = Math.floor(mag * 255) * 3;
          const di = (y * W + x) * 4;
          d[di] = lut[pi]; d[di+1] = lut[pi+1]; d[di+2] = lut[pi+2]; d[di+3] = 255;
        }
      }
      ctx.putImageData(img, 0, 0);
    }

    function renderRadial(data: SpectrogramData, lut: Uint8ClampedArray, t0: number, t1: number, params: ReturnType<typeof getParams>) {
      const { frames, numBins } = data;
      const W = canvas.width, H = canvas.height;
      const cx = W / 2, cy = H / 2;
      const maxR = Math.min(cx, cy) * 0.96;
      const minR = maxR * 0.04;
      const fStart = Math.floor(t0 * data.numFrames);
      const fEnd   = Math.ceil(t1 * data.numFrames);
      const numVis = Math.max(1, fEnd - fStart);
      const rotOff = params.rotation * Math.PI / 180;

      const img = ctx.createImageData(W, H);
      const d = img.data;

      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          const dx = x - cx, dy = y - cy;
          const r = Math.sqrt(dx * dx + dy * dy);
          if (r < minR || r > maxR) continue;
          let angle = Math.atan2(dy, dx) - rotOff;
          if (angle < 0) angle += 2 * Math.PI;
          const tAng = angle / (2 * Math.PI);
          const fi = Math.floor(tAng * numVis) + fStart;
          if (fi < 0 || fi >= frames.length) continue;
          const binFrac = (r - minR) / (maxR - minR);
          const bin = Math.floor(binFrac * numBins);
          if (bin >= numBins) continue;
          const mag = frames[fi][bin];
          const pi = Math.floor(mag * 255) * 3;
          const di = (y * W + x) * 4;
          d[di] = lut[pi]; d[di+1] = lut[pi+1]; d[di+2] = lut[pi+2]; d[di+3] = 255;
        }
      }
      ctx.putImageData(img, 0, 0);
    }

    function renderGlitch(data: SpectrogramData, lut: Uint8ClampedArray, t0: number, t1: number, params: ReturnType<typeof getParams>) {
      // Base: waterfall
      renderWaterfall(data, lut, t0, t1, params);

      const { frames, numBins } = data;
      const W = canvas.width, H = canvas.height;
      const fStart = Math.floor(t0 * data.numFrames);
      const fEnd   = Math.ceil(t1 * data.numFrames);
      const numVis = Math.max(1, fEnd - fStart);
      const warp = params.warpStrength;
      const noise = params.noiseAmount;

      // Spectral flux per visible frame
      const flux = new Float32Array(numVis);
      for (let f = 1; f < numVis; f++) {
        const fi = f + fStart;
        if (fi >= frames.length || fi - 1 < 0 || fi - 1 >= frames.length) continue;
        let sum = 0;
        for (let b = 0; b < numBins; b++) { const d = frames[fi][b] - frames[fi-1][b]; if (d > 0) sum += d; }
        flux[f] = sum / numBins;
      }
      let maxFlux = 0;
      for (const v of flux) if (v > maxFlux) maxFlux = v;
      if (maxFlux > 0) for (let i = 0; i < flux.length; i++) flux[i] /= maxFlux;

      const src = ctx.getImageData(0, 0, W, H);
      const srcD = new Uint8ClampedArray(src.data);
      const dst = src.data;

      const hash = (v: number) => Math.abs(Math.sin(v * 127.1 + v * 311.7) * 43758.5453) % 1;

      for (let y = 0; y < H; y++) {
        const fiIdx = Math.floor((1 - y / H) * numVis);
        const fl = flux[Math.max(0, Math.min(numVis - 1, fiIdx))] || 0;
        const shift = Math.round(fl * warp * (hash(y) > 0.5 ? 1 : -1));
        for (let x = 0; x < W; x++) {
          const sx = ((x - shift) % W + W) % W;
          const si = (y * W + sx) * 4;
          const di = (y * W + x) * 4;
          let r = srcD[si], g = srcD[si+1], b = srcD[si+2];
          // Hue rotate on high-flux rows
          if (fl > 0.4) {
            const hue = (fl - 0.4) * (1/0.6) * 120 * Math.PI / 180;
            const cs = Math.cos(hue), sn = Math.sin(hue);
            const nr = r*(0.213+cs*0.787-sn*0.213) + g*(0.213-cs*0.213+sn*0.143) + b*(0.213-cs*0.213-sn*0.787);
            const ng = r*(0.715-cs*0.715-sn*0.715) + g*(0.715+cs*0.285+sn*0.140) + b*(0.715-cs*0.715+sn*0.140);
            const nb = r*(0.072-cs*0.072+sn*0.928) + g*(0.072-cs*0.072-sn*0.283) + b*(0.072+cs*0.928+sn*0.072);
            r = Math.min(255, Math.max(0, nr));
            g = Math.min(255, Math.max(0, ng));
            b = Math.min(255, Math.max(0, nb));
          }
          if (noise > 0) {
            const n = (hash(x * 0.3 + y * 0.71 + fl) - 0.5) * 2 * noise * 128 * fl;
            r = Math.min(255, Math.max(0, r + n));
            g = Math.min(255, Math.max(0, g + n));
            b = Math.min(255, Math.max(0, b + n));
          }
          dst[di] = r; dst[di+1] = g; dst[di+2] = b; dst[di+3] = 255;
        }
      }
      ctx.putImageData(src, 0, 0);
    }

    function renderHybrid(data: SpectrogramData, lut: Uint8ClampedArray, t0: number, t1: number, params: ReturnType<typeof getParams>) {
      const { frames, numBins, sampleRate, waveform } = data;
      const W = canvas.width, H = canvas.height;
      const fStart = Math.floor(t0 * data.numFrames);
      const fEnd   = Math.ceil(t1 * data.numFrames);
      const numVis = Math.max(1, fEnd - fStart);
      const split = params.split;
      const splitY = Math.floor(H * (1 - split));
      const freqMax = Math.min(params.freqMax, sampleRate / 2);
      const nyquist = sampleRate / 2;
      const melMin = hzToMel(20), melMax = hzToMel(freqMax);

      const img = ctx.createImageData(W, H);
      const d = img.data;

      // Top section: waveform
      for (let y = 0; y < splitY; y++) {
        const midY = splitY * 0.5;
        for (let x = 0; x < W; x++) {
          const fi = Math.floor(x / W * numVis) + fStart;
          if (fi < 0 || fi >= waveform.length) continue;
          const amp = waveform[fi];
          if (Math.abs(y - midY) < amp * midY * 0.9) {
            const mag = amp;
            const pi = Math.floor(mag * 255) * 3;
            const di = (y * W + x) * 4;
            d[di] = lut[pi]; d[di+1] = lut[pi+1]; d[di+2] = lut[pi+2]; d[di+3] = 255;
          }
        }
      }

      // Bottom section: spectrogram
      const specH = H - splitY;
      for (let y = splitY; y < H; y++) {
        const melFrac = (specH - 1 - (y - splitY)) / (specH - 1);
        const bin = Math.floor(melToHz(melMin + melFrac * (melMax - melMin)) / nyquist * numBins);
        if (bin < 0 || bin >= numBins) continue;
        for (let x = 0; x < W; x++) {
          const fi = Math.floor(x / W * numVis) + fStart;
          if (fi < 0 || fi >= frames.length) continue;
          const mag = frames[fi][bin];
          const pi = Math.floor(mag * 255) * 3;
          const di = (y * W + x) * 4;
          d[di] = lut[pi]; d[di+1] = lut[pi+1]; d[di+2] = lut[pi+2]; d[di+3] = 255;
        }
      }

      // Seam interference
      const seamH = 3;
      for (let y = Math.max(0, splitY - seamH); y < Math.min(H, splitY + seamH); y++) {
        for (let x = 0; x < W; x++) {
          const fi = Math.floor(x / W * numVis) + fStart;
          const wv = fi >= 0 && fi < waveform.length ? waveform[fi] : 0;
          const t = (Math.sin(x * 0.15 + wv * 8) * 0.5 + 0.5);
          const pi = Math.floor(t * 255) * 3;
          const di = (y * W + x) * 4;
          d[di] = lut[pi]; d[di+1] = lut[pi+1]; d[di+2] = lut[pi+2]; d[di+3] = 255;
        }
      }

      ctx.putImageData(img, 0, 0);
    }

    // ─── Main render dispatch ─────────────────────────────────────────────────
    function render(t0?: number, t1?: number) {
      if (!spectrogramData) return;
      const [a, b] = t0 !== undefined ? [t0, t1!] : getTimeRange();
      const params = getParams();
      switch (currentMode) {
        case 'waterfall': renderWaterfall(spectrogramData, paletteLUT, a, b, params); break;
        case 'radial':    renderRadial(spectrogramData, paletteLUT, a, b, params); break;
        case 'glitch':    renderGlitch(spectrogramData, paletteLUT, a, b, params); break;
        case 'hybrid':    renderHybrid(spectrogramData, paletteLUT, a, b, params); break;
      }
    }

    function scheduleRender() {
      if (renderPending) return;
      renderPending = true;
      requestAnimationFrame(() => { renderPending = false; render(); });
    }

    // ─── Mini waveform ────────────────────────────────────────────────────────
    function drawMiniWaveform(waveform: Float32Array) {
      const wc = document.getElementById('ph-waveform') as HTMLCanvasElement;
      const wctx = wc.getContext('2d')!;
      const W = wc.width, H = wc.height;
      wctx.clearRect(0, 0, W, H);
      wctx.fillStyle = '#111';
      wctx.fillRect(0, 0, W, H);
      wctx.strokeStyle = '#666';
      wctx.lineWidth = 1;
      wctx.beginPath();
      const mid = H / 2;
      for (let x = 0; x < W; x++) {
        const fi = Math.floor(x / W * waveform.length);
        const amp = waveform[fi] * mid * 0.9;
        if (x === 0) wctx.moveTo(x, mid - amp);
        else wctx.lineTo(x, mid - amp);
      }
      wctx.stroke();
      // Mirror
      wctx.beginPath();
      for (let x = 0; x < W; x++) {
        const fi = Math.floor(x / W * waveform.length);
        const amp = waveform[fi] * mid * 0.9;
        if (x === 0) wctx.moveTo(x, mid + amp);
        else wctx.lineTo(x, mid + amp);
      }
      wctx.stroke();
    }

    // ─── Audio loading ────────────────────────────────────────────────────────
    async function loadAudioData(arrayBuf: ArrayBuffer, name: string) {
      const busyEl = document.getElementById('ph-busy')!;
      const busyLabel = document.getElementById('ph-busy-label')!;
      const emptyEl = document.getElementById('ph-empty')!;
      const dropEmpty = document.getElementById('ph-drop-empty')!;
      const waveformCanvas = document.getElementById('ph-waveform') as HTMLCanvasElement;
      const metaEl = document.getElementById('ph-audio-meta')!;
      const actionBar = document.getElementById('ph-action-bar')!;

      emptyEl.style.display = 'none';
      busyEl.style.display = 'flex';
      busyLabel.textContent = 'Decoding…';
      actionBar.style.display = 'none';

      try {
        lastArrayBuf = arrayBuf.slice(0); // store a copy for FFT size recompute
        lastFileName = name;

        const audioCtx = new OfflineAudioContext(1, 1, 44100);
        const audioBuffer = await audioCtx.decodeAudioData(arrayBuf);

        busyLabel.textContent = 'Analyzing…';
        const fftSize = parseInt((document.getElementById('ph-fft') as HTMLSelectElement).value);
        spectrogramData = await computeSpectrogram(audioBuffer, fftSize, (p) => {
          busyLabel.textContent = `Analyzing… ${Math.round(p * 100)}%`;
        });

        drawMiniWaveform(spectrogramData.waveform);
        dropEmpty.style.display = 'none';
        waveformCanvas.style.display = 'block';
        const mins = Math.floor(audioBuffer.duration / 60);
        const secs = Math.floor(audioBuffer.duration % 60);
        metaEl.textContent = `${name} · ${mins}:${String(secs).padStart(2,'0')}`;
        metaEl.style.display = 'block';

        busyEl.style.display = 'none';
        actionBar.style.display = 'flex';
        render();
      } catch (err) {
        busyEl.style.display = 'none';
        emptyEl.style.display = 'flex';
        (emptyEl as HTMLElement).textContent = 'Failed to decode audio file';
        console.error(err);
      }
    }

    async function loadAudioFile(file: File) {
      loadAudioData(await file.arrayBuffer(), file.name);
    }

    // ─── CRC-32 ───────────────────────────────────────────────────────────────
    const CRC_TABLE = (() => {
      const t = new Uint32Array(256);
      for (let i = 0; i < 256; i++) {
        let c = i;
        for (let j = 0; j < 8; j++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
        t[i] = c;
      }
      return t;
    })();

    function crc32(data: Uint8Array): number {
      let crc = 0xFFFFFFFF;
      for (const byte of data) crc = CRC_TABLE[(crc ^ byte) & 0xFF] ^ (crc >>> 8);
      return (crc ^ 0xFFFFFFFF) >>> 0;
    }

    // ─── ZIP builder (STORE, no compression) ─────────────────────────────────
    function buildZip(files: { name: string; data: Uint8Array }[]): ArrayBuffer {
      const enc = new TextEncoder();
      type Entry = { header: Uint8Array; data: Uint8Array; nameB: Uint8Array; crc: number; off: number };
      const entries: Entry[] = [];
      let off = 0;

      for (const f of files) {
        const nameB = enc.encode(f.name);
        const crc = crc32(f.data);
        const hdr = new Uint8Array(30 + nameB.length);
        const v = new DataView(hdr.buffer);
        v.setUint32(0, 0x04034b50, true);
        v.setUint16(4, 20, true);
        v.setUint16(8, 0, true);   // method: STORE
        v.setUint32(14, crc, true);
        v.setUint32(18, f.data.length, true);
        v.setUint32(22, f.data.length, true);
        v.setUint16(26, nameB.length, true);
        hdr.set(nameB, 30);
        entries.push({ header: hdr, data: f.data, nameB, crc, off });
        off += hdr.length + f.data.length;
      }

      const cdParts: Uint8Array[] = [];
      let cdSize = 0;
      const cdOff = off;
      for (const e of entries) {
        const cd = new Uint8Array(46 + e.nameB.length);
        const v = new DataView(cd.buffer);
        v.setUint32(0, 0x02014b50, true);
        v.setUint16(4, 20, true);
        v.setUint16(6, 20, true);
        v.setUint32(16, e.crc, true);
        v.setUint32(20, e.data.length, true);
        v.setUint32(24, e.data.length, true);
        v.setUint16(28, e.nameB.length, true);
        v.setUint32(42, e.off, true);
        cd.set(e.nameB, 46);
        cdParts.push(cd);
        cdSize += cd.length;
      }

      const eocd = new Uint8Array(22);
      const ev = new DataView(eocd.buffer);
      ev.setUint32(0, 0x06054b50, true);
      ev.setUint16(8, entries.length, true);
      ev.setUint16(10, entries.length, true);
      ev.setUint32(12, cdSize, true);
      ev.setUint32(16, cdOff, true);

      const out = new Uint8Array(cdOff + cdSize + 22);
      let pos = 0;
      for (const e of entries) { out.set(e.header, pos); pos += e.header.length; out.set(e.data, pos); pos += e.data.length; }
      for (const cd of cdParts) { out.set(cd, pos); pos += cd.length; }
      out.set(eocd, pos);
      return out.buffer;
    }

    // ─── Output actions ───────────────────────────────────────────────────────
    async function saveImage() {
      if (!spectrogramData) return;
      const btn = document.getElementById('ph-save-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Saving…';
      try {
        const blob = await new Promise<Blob>(res => canvas.toBlob(b => res(b!), 'image/png'));
        const fd = new FormData();
        fd.append('file', blob, 'photism.png');
        fd.append('tags', 'photism,atelier');
        fd.append('output_index', 'outputs');
        const res = await fetch('/api/media/upload', { method: 'POST', body: fd, credentials: 'include' });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        (window as any).toast?.success('Saved to outputs');
      } catch (err: any) {
        (window as any).toast?.error(`Save failed: ${err.message}`);
      } finally { btn.disabled = false; btn.textContent = '☁ Save Image'; }
    }

    async function recordWebM() {
      if (!spectrogramData) return;
      const btn = document.getElementById('ph-record-btn') as HTMLButtonElement;
      const fps = parseInt((document.getElementById('ph-fps') as HTMLSelectElement).value);
      const durationSec = 6;
      const totalFrames = fps * durationSec;
      btn.disabled = true;

      let stream: MediaStream;
      try { stream = (canvas as any).captureStream(fps); } catch { btn.disabled = false; return; }

      const mimeType = MediaRecorder.isTypeSupported('video/webm;codecs=vp9') ? 'video/webm;codecs=vp9' : 'video/webm';
      const recorder = new MediaRecorder(stream, { mimeType });
      const chunks: BlobPart[] = [];
      recorder.ondataavailable = e => { if (e.data.size > 0) chunks.push(e.data); };
      recorder.onstop = () => {
        const blob = new Blob(chunks, { type: 'video/webm' });
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'photism.webm'; a.click();
        btn.disabled = false; btn.textContent = '⏺ Record WebM';
      };

      recorder.start(100);
      for (let i = 0; i <= totalFrames; i++) {
        const p = i / totalFrames;
        render(0, p);
        btn.textContent = `${Math.round(p * 100)}%`;
        await new Promise(r => setTimeout(r, 1000 / fps));
      }
      recorder.stop();
      render(); // restore current view
    }

    async function saveFrames() {
      if (!spectrogramData) return;
      const btn = document.getElementById('ph-frames-btn') as HTMLButtonElement;
      btn.disabled = true;
      const N = 60;
      const pngFiles: { name: string; data: Uint8Array }[] = [];
      for (let i = 0; i < N; i++) {
        render(0, i / (N - 1));
        btn.textContent = `${i + 1}/${N}`;
        const blob = await new Promise<Blob>(res => canvas.toBlob(b => res(b!), 'image/png'));
        pngFiles.push({ name: `photism-${String(i).padStart(4,'0')}.png`, data: new Uint8Array(await blob.arrayBuffer()) });
        await yieldToUI();
      }
      render(); // restore
      const zip = buildZip(pngFiles);
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([zip], { type: 'application/zip' }));
      a.download = 'photism-frames.zip'; a.click();
      btn.disabled = false; btn.textContent = '⬇ Save Frames';
    }

    // ─── UI wiring ────────────────────────────────────────────────────────────

    // Drop zone
    const dropZone = document.getElementById('ph-drop-zone')!;
    const fileInput = document.getElementById('ph-file-input') as HTMLInputElement;
    dropZone.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', () => { if (fileInput.files?.[0]) loadAudioFile(fileInput.files[0]); });
    dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
    dropZone.addEventListener('drop', e => {
      e.preventDefault(); dropZone.classList.remove('drag-over');
      const f = e.dataTransfer?.files[0];
      if (f && f.type.startsWith('audio/')) loadAudioFile(f);
    });

    // ─── Library modal ────────────────────────────────────────────────────────
    type LibTab = 'inputs' | 'outputs' | 'workspace';
    let libCurrentTab: LibTab = 'inputs';
    let libSearchTimer: ReturnType<typeof setTimeout> | null = null;

    const modalOverlay  = document.getElementById('ph-modal-overlay')!;
    const modalGrid     = document.getElementById('ph-modal-grid')!;
    const modalSearch   = document.getElementById('ph-modal-search') as HTMLInputElement;

    function openLibrary() {
      modalOverlay.style.display = 'flex';
      modalSearch.value = '';
      setLibTab('inputs');
    }

    function closeLibrary() { modalOverlay.style.display = 'none'; }

    function setLibTab(tab: LibTab) {
      libCurrentTab = tab;
      document.querySelectorAll<HTMLElement>('.ph-modal__tab').forEach(b => {
        b.classList.toggle('ph-modal__tab--active', b.dataset.tab === tab);
      });
      loadLibItems('');
    }

    async function loadLibItems(q: string) {
      modalGrid.innerHTML = '<div class="ph-modal__loading">Loading…</div>';
      try {
        let items: { id: string; filename?: string; original_filename?: string; media_type?: string }[] = [];

        if (libCurrentTab === 'workspace') {
          // Fetch active workspace then its items
          const wsRes = await fetch('/api/workspaces/active', { credentials: 'include' });
          if (wsRes.ok) {
            const ws = await wsRes.json();
            const wsId = ws.id || ws.workspace_id;
            if (wsId) {
              const itemsRes = await fetch(`/api/workspaces/${wsId}/items?per_page=100`, { credentials: 'include' });
              if (itemsRes.ok) {
                const data = await itemsRes.json();
                items = (data.items || []).filter((i: any) => i.media_type === 'audio');
              }
            }
          }
        } else {
          const res = await fetch('/api/search', {
            method: 'POST', credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              query: q,
              media_types: ['audio'],
              sort: 'created_at:desc',
              page: 1, per_page: 48,
              filters: { output_index: libCurrentTab === 'inputs' ? '__inputs__' : '__outputs__' },
            }),
          });
          if (res.ok) {
            const data = await res.json();
            items = data.results ?? data.hits ?? [];
          }
        }

        renderLibGrid(items);
      } catch (err) {
        modalGrid.innerHTML = '<div class="ph-modal__loading">Failed to load</div>';
      }
    }

    function renderLibGrid(items: { id: string; filename?: string; original_filename?: string }[]) {
      if (items.length === 0) {
        modalGrid.innerHTML = '<div class="ph-modal__loading">No audio files found</div>';
        return;
      }
      modalGrid.innerHTML = '';
      for (const item of items) {
        const name = item.filename || item.original_filename || item.id;
        const card = document.createElement('div');
        card.className = 'ph-audio-card';
        card.innerHTML = `<div class="ph-audio-card__icon">♫</div>
          <div class="ph-audio-card__name" title="${name}">${name}</div>`;
        card.addEventListener('click', async () => {
          closeLibrary();
          const busyEl = document.getElementById('ph-busy')!;
          const busyLabel = document.getElementById('ph-busy-label')!;
          busyEl.style.display = 'flex';
          busyLabel.textContent = 'Fetching…';
          try {
            const res = await fetch(`/api/media/${item.id}/file`, { credentials: 'include' });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const arrayBuf = await res.arrayBuffer();
            await loadAudioData(arrayBuf, name);
          } catch (err: any) {
            busyEl.style.display = 'none';
            (window as any).toast?.error(`Load failed: ${err.message}`);
          }
        });
        modalGrid.appendChild(card);
      }
    }

    document.getElementById('ph-lib-btn')!.addEventListener('click', openLibrary);
    document.getElementById('ph-modal-close')!.addEventListener('click', closeLibrary);
    modalOverlay.addEventListener('click', e => { if (e.target === modalOverlay) closeLibrary(); });

    document.getElementById('ph-modal-tabs')!.addEventListener('click', e => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ph-modal__tab');
      if (btn?.dataset.tab) setLibTab(btn.dataset.tab as LibTab);
    });

    modalSearch.addEventListener('input', () => {
      if (libSearchTimer) clearTimeout(libSearchTimer);
      libSearchTimer = setTimeout(() => loadLibItems(modalSearch.value.trim()), 300);
    });

    // Mode buttons
    document.getElementById('ph-mode-group')!.addEventListener('click', e => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ph-pill');
      if (!btn) return;
      document.querySelectorAll('#ph-mode-group .ph-pill').forEach(b => b.classList.remove('ph-pill--on'));
      btn.classList.add('ph-pill--on');
      currentMode = btn.dataset.val!;
      document.querySelectorAll<HTMLElement>('.ph-mode-params').forEach(el => {
        el.style.display = el.dataset.phMode === currentMode ? '' : 'none';
      });
      scheduleRender();
    });

    // Palette buttons
    document.getElementById('ph-palette-group')!.addEventListener('click', e => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ph-pill');
      if (!btn) return;
      document.querySelectorAll('#ph-palette-group .ph-pill').forEach(b => b.classList.remove('ph-pill--on'));
      btn.classList.add('ph-pill--on');
      currentPalette = btn.dataset.val!;
      paletteLUT = buildPaletteLUT(currentPalette);
      scheduleRender();
    });

    // FFT size — recompute spectrogram
    document.getElementById('ph-fft')!.addEventListener('change', () => {
      if (!lastArrayBuf) return;
      loadAudioData(lastArrayBuf.slice(0), lastFileName);
    });

    // Sliders
    const sliderDefs: [string, string, (v: string) => string][] = [
      ['ph-time-start', 'ph-ts-val',   v => `${v}%`],
      ['ph-time-end',   'ph-te-val',   v => `${v}%`],
      ['ph-freq-max',   'ph-fmax-val', v => `${Math.round(parseInt(v) / 100) / 10} kHz`],
      ['ph-rotation',   'ph-rot-val',  v => `${v}°`],
      ['ph-warp',       'ph-warp-val', v => v],
      ['ph-noise',      'ph-noise-val',v => parseFloat(v).toFixed(2)],
      ['ph-split',      'ph-split-val',v => parseFloat(v).toFixed(2)],
    ];
    for (const [id, valId, fmt] of sliderDefs) {
      const el = document.getElementById(id) as HTMLInputElement;
      const valEl = document.getElementById(valId)!;
      el.addEventListener('input', () => { valEl.textContent = fmt(el.value); scheduleRender(); });
    }

    // Output actions
    document.getElementById('ph-save-btn')!.addEventListener('click', saveImage);
    document.getElementById('ph-record-btn')!.addEventListener('click', recordWebM);
    document.getElementById('ph-frames-btn')!.addEventListener('click', saveFrames);
  </script>
