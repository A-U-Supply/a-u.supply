    async function saveImage() {
      if (!spectrogramData) return;
      const btn = document.getElementById('ph-save-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Saving…';
      try {
        const blob = await new Promise<Blob>(res => canvas.toBlob(b => res(b!), 'image/png'));
        const fd = new FormData();
        fd.append('file', blob, 'photism.png');
        fd.append('tags', 'photism,atelier');
        fd.append('output_index', 'outputs');
        const res = await fetch('/api/media/upload', { method: 'POST', body: fd, credentials: 'include' });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        (window as any).toast?.success('Saved to outputs');
      } catch (err: any) {
        (window as any).toast?.error(`Save failed: ${err.message}`);
      } finally { btn.disabled = false; btn.textContent = '☁ Save Image'; }
    }

    async function recordWebM() {
      if (!spectrogramData) return;
      const btn = document.getElementById('ph-record-btn') as HTMLButtonElement;
      const fps = parseInt((document.getElementById('ph-fps') as HTMLSelectElement).value);
      const durationSec = 6;
      const totalFrames = fps * durationSec;
      btn.disabled = true;

      let stream: MediaStream;
      try { stream = (canvas as any).captureStream(fps); } catch { btn.disabled = false; return; }

      const mimeType = MediaRecorder.isTypeSupported('video/webm;codecs=vp9') ? 'video/webm;codecs=vp9' : 'video/webm';
      const recorder = new MediaRecorder(stream, { mimeType });
      const chunks: BlobPart[] = [];
      recorder.ondataavailable = e => { if (e.data.size > 0) chunks.push(e.data); };
      recorder.onstop = () => {
        const blob = new Blob(chunks, { type: 'video/webm' });
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'photism.webm'; a.click();
        btn.disabled = false; btn.textContent = '⏺ Record WebM';
      };

      recorder.start(100);
      for (let i = 0; i <= totalFrames; i++) {
        const p = i / totalFrames;
        render(0, p);
        btn.textContent = `${Math.round(p * 100)}%`;
        await new Promise(r => setTimeout(r, 1000 / fps));
      }
      recorder.stop();
      render(); // restore current view
    }

    async function saveFrames() {
      if (!spectrogramData) return;
      const btn = document.getElementById('ph-frames-btn') as HTMLButtonElement;
      btn.disabled = true;
      const N = 60;
      const pngFiles: { name: string; data: Uint8Array }[] = [];
      for (let i = 0; i < N; i++) {
        render(0, i / (N - 1));
        btn.textContent = `${i + 1}/${N}`;
        const blob = await new Promise<Blob>(res => canvas.toBlob(b => res(b!), 'image/png'));
        pngFiles.push({ name: `photism-${String(i).padStart(4,'0')}.png`, data: new Uint8Array(await blob.arrayBuffer()) });
        await yieldToUI();
      }
      render(); // restore
      const zip = buildZip(pngFiles);
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([zip], { type: 'application/zip' }));
      a.download = 'photism-frames.zip'; a.click();
      btn.disabled = false; btn.textContent = '⬇ Save Frames';
    }

    // ─── WAV encoding ─────────────────────────────────────────────────────────
    function encodeWAV(signal: Float32Array, sampleRate: number): ArrayBuffer {
      const numSamples = signal.length;
      const buf = new ArrayBuffer(44 + numSamples * 2);
      const v = new DataView(buf);
      const writeStr = (off: number, s: string) => { for (let i = 0; i < s.length; i++) v.setUint8(off + i, s.charCodeAt(i)); };
      writeStr(0, 'RIFF'); v.setUint32(4, 36 + numSamples * 2, true);
      writeStr(8, 'WAVE'); writeStr(12, 'fmt ');
      v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);
      v.setUint32(24, sampleRate, true); v.setUint32(28, sampleRate * 2, true);
      v.setUint16(32, 2, true); v.setUint16(34, 16, true);
      writeStr(36, 'data'); v.setUint32(40, numSamples * 2, true);
      for (let i = 0; i < numSamples; i++) {
        v.setInt16(44 + i * 2, Math.max(-32768, Math.min(32767, Math.round(signal[i] * 32767))), true);
      }
      return buf;
    }

    // ─── ISTFT with Overlap-Add (OLA) ────────────────────────────────────────
    // frames: log-normalized magnitudes (display space)
    // phases: raw atan2 phase per bin per frame
    // maxMag: raw peak magnitude stored during analysis (used to invert log)
    async function istftOLA(
      frames: Float32Array[], phases: Float32Array[], maxMag: number,
      fftSize: number, hopSamples: number, progressCb: (p: number) => void,
    ): Promise<Float32Array> {
      const numFrames = frames.length;
      const numBins = fftSize >> 1;
      const totalSamples = (numFrames - 1) * hopSamples + fftSize;
      const signal = new Float32Array(totalSamples);
      const norm   = new Float32Array(totalSamples);
      const hann   = hannWindow(fftSize);
      const re     = new Float64Array(fftSize);
      const im     = new Float64Array(fftSize);
      const CHUNK  = 8;

      for (let f = 0; f < numFrames; f++) {
        const frame = frames[f];
        const phase = phases[f];

        // Reconstruct complex spectrum from log-normalized mag + raw phase
        // Inverse of: v = log1p(raw/maxMag * 100) / log(101)
        // → raw = maxMag * (101^v - 1) / 100
        re.fill(0); im.fill(0);
        for (let b = 0; b < numBins; b++) {
          const rawMag = maxMag * (Math.pow(101, frame[b]) - 1) / 100;
          re[b] = rawMag * Math.cos(phase[b]);
          im[b] = rawMag * Math.sin(phase[b]);
        }
        // Conjugate symmetry for real-valued IFFT output
        for (let b = 1; b < numBins; b++) {
          re[fftSize - b] = re[b];
          im[fftSize - b] = -im[b];
        }

        // IFFT: negate im, forward FFT, negate im, divide by N
        for (let i = 0; i < fftSize; i++) im[i] = -im[i];
        fft(re, im);
        const inv = 1 / fftSize;
        for (let i = 0; i < fftSize; i++) { re[i] *= inv; im[i] = -im[i] * inv; }
        // re[i] is the time-domain frame; im should be ~0 (conjugate symmetry ensures real output)

        // Overlap-add with Hann window + accumulate normalization
        const start = f * hopSamples;
        for (let i = 0; i < fftSize; i++) {
          const idx = start + i;
          if (idx >= totalSamples) break;
          const w = hann[i];
          signal[idx] += re[i] * w;
          norm[idx]   += w * w;
        }

        if (f % CHUNK === CHUNK - 1) { progressCb(f / numFrames); await yieldToUI(); }
      }

      // Normalize by accumulated window energy, then peak-normalize
      for (let i = 0; i < totalSamples; i++) {
        if (norm[i] > 1e-8) signal[i] /= norm[i];
      }
      let peak = 0;
      for (let i = 0; i < totalSamples; i++) if (Math.abs(signal[i]) > peak) peak = Math.abs(signal[i]);
      if (peak > 0) for (let i = 0; i < totalSamples; i++) signal[i] /= peak;
      return signal;
    }

    async function exportAudio() {
      if (!spectrogramData) return;
      const busyEl = document.getElementById('ph-busy')!;
      const busyLabel = document.getElementById('ph-busy-label')!;
      busyEl.style.display = 'flex';
      exportMenu.style.display = 'none';

      const [t0, t1] = getTimeRange();
      const { sampleRate, numFrames, phases, maxMag } = spectrogramData;
      const frames = editedFrames ?? spectrogramData.frames;
      const fftSize = parseInt((document.getElementById('ph-fft') as HTMLSelectElement).value);
      const hopSamples = fftSize >> 2;
      const fStart = Math.floor(t0 * numFrames);
      const fEnd   = Math.ceil(t1 * numFrames);
      const trimmedFrames = frames.slice(fStart, fEnd);
      const trimmedPhases = phases.slice(fStart, fEnd);

      try {
        const signal = await istftOLA(trimmedFrames, trimmedPhases, maxMag, fftSize, hopSamples, p => {
          busyLabel.textContent = `Synthesizing… ${Math.round(p * 100)}%`;
        });
        const wav = encodeWAV(signal, sampleRate);
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([wav], { type: 'audio/wav' }));
        a.download = `${lastFileName.replace(/\.[^.]+$/, '')}-synth.wav`;
        a.click();
      } finally {
        busyEl.style.display = 'none';
      }
    }

    // ─── Playback progress ────────────────────────────────────────────────────
    const playhead  = document.getElementById('ph-playhead')!;
    const timeDisp  = document.getElementById('ph-time-display')!;

    function fmtTime(secs: number): string {
      const m = Math.floor(secs / 60);
      const s = Math.floor(secs % 60);
      return `${m}:${String(s).padStart(2, '0')}`;
    }

    function stopProgress() {
      if (progressRaf !== null) { cancelAnimationFrame(progressRaf); progressRaf = null; }
      playhead.style.display = 'none';
      timeDisp.textContent = '0:00';
      if (spectrogramData) drawMiniWaveform(spectrogramData.waveform);
    }

    function tickProgress() {
      if (!playbackCtx || !spectrogramData) return;
      const dur = spectrogramData.duration;
      const elapsed = playbackCtx.currentTime - playbackStartTime;
      let audioTime: number;
      if (loopEnabled && playbackEndOffset > playbackStartOffset) {
        const loopDur = playbackEndOffset - playbackStartOffset;
        audioTime = playbackStartOffset + ((elapsed % loopDur) + loopDur) % loopDur;
      } else {
        audioTime = Math.min(playbackStartOffset + elapsed, playbackEndOffset);
      }
      const trimDur = playbackEndOffset - playbackStartOffset;
      const progressInTrim = trimDur > 0 ? Math.max(0, Math.min(1, (audioTime - playbackStartOffset) / trimDur)) : 0;
      // Update time display (relative to full track)
      timeDisp.textContent = fmtTime(audioTime);
      // Move playhead on spectrogram canvas
      playhead.style.display = 'block';
      playhead.style.left = `${progressInTrim * 100}%`;
      // Update waveform cursor (position within full track)
      const trackFrac = dur > 0 ? audioTime / dur : 0;
      drawMiniWaveform(spectrogramData.waveform, Math.max(0, Math.min(1, trackFrac)));
      progressRaf = requestAnimationFrame(tickProgress);
    }

    // ─── Paint mode ───────────────────────────────────────────────────────────
    function setPaintMode(on: boolean) {
      paintMode = on;
      if (!on) { eraseMode = false; isPainting = false; }
      const btn = document.getElementById('ph-paint-btn')!;
      const paintBar = document.getElementById('ph-paint-bar')!;
      const wrap = document.getElementById('ph-canvas-wrap')!;
      const eraseBtn = document.getElementById('ph-erase-btn') as HTMLButtonElement;
      btn.classList.toggle('ph-paint-btn--active', on);
      paintBar.style.display = on ? 'flex' : 'none';
      wrap.classList.toggle('ph-canvas-wrap--paint', on);
      if (!on) { eraseBtn.textContent = '✏ Draw'; eraseBtn.classList.remove('ph-erase-btn--active'); }
    }

    function applyBrush(clientX: number, clientY: number) {
      if (!spectrogramData) return;
      if (!editedFrames) {
        editedFrames = spectrogramData.frames.map(fr => fr.slice());
      }
      const rect = canvas.getBoundingClientRect();
      const cx = (clientX - rect.left) / rect.width * canvas.width;
      const cy = (clientY - rect.top) / rect.height * canvas.height;
      const [t0, t1] = getTimeRange();
      const { numFrames, numBins } = spectrogramData;
      const fStart = Math.floor(t0 * numFrames);
      const fEnd   = Math.ceil(t1 * numFrames);
      const numVis = Math.max(1, fEnd - fStart);
      const fCenter = Math.floor(cx / canvas.width * numVis) + fStart;
      const bCenter = numBins - 1 - Math.floor(cy / canvas.height * numBins);
      const brushVal = eraseMode ? 0 : 1;
      // Scale brush radius from CSS pixels to frame/bin units
      const fRadius = Math.max(1, Math.ceil(brushSize * numVis / rect.width));
      const bRadius = Math.max(1, Math.ceil(brushSize * numBins / rect.height));
      for (let df = -fRadius; df <= fRadius; df++) {
        const f = fCenter + df;
        if (f < 0 || f >= editedFrames.length) continue;
        for (let db = -bRadius; db <= bRadius; db++) {
          const b = bCenter + db;
          if (b < 0 || b >= numBins) continue;
          editedFrames[f][b] = brushVal;
        }
      }
      scheduleRender();
    }

