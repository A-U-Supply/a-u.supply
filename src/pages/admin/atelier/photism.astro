      }
      if (!currentAudioBuffer) return;
      playbackCtx = new AudioContext();
      playbackSource = playbackCtx.createBufferSource();
      playbackSource.buffer = currentAudioBuffer;
      playbackSource.connect(playbackCtx.destination);
      const [t0, t1] = getTimeRange();
      const dur = currentAudioBuffer.duration;
      playbackStartOffset = t0 * dur;
      playbackEndOffset   = t1 * dur;
      playbackStartTime   = playbackCtx.currentTime;
      if (loopEnabled) {
        playbackSource.loop      = true;
        playbackSource.loopStart = playbackStartOffset;
        playbackSource.loopEnd   = playbackEndOffset;
        playbackSource.start(0, playbackStartOffset);
