    function stampImageToFrames() {
      if (!spectrogramData || !stampImageData) return;
      if (!editedFrames)
        editedFrames = spectrogramData.frames.map((fr) => fr.slice());

      const { numBins, sampleRate, numFrames } = spectrogramData;
      const nyquist = sampleRate / 2;
      const freqMax = parseFloat(
        (document.getElementById('ph-freq-max') as HTMLInputElement).value,
      );
      const melMin = hzToMel(20);
      const melMax = hzToMel(Math.min(freqMax, nyquist));

      const stampStart =
        parseInt(
          (document.getElementById('ph-stamp-start') as HTMLInputElement).value,
        ) / 100;
      const stampEnd =
        parseInt(
          (document.getElementById('ph-stamp-end') as HTMLInputElement).value,
        ) / 100;
      const opacity =
        parseInt(
          (document.getElementById('ph-stamp-opacity') as HTMLInputElement)
            .value,
        ) / 100;
      const blend = (
        document.getElementById('ph-stamp-blend') as HTMLSelectElement
      ).value;

      const fStart = Math.floor(stampStart * numFrames);
      const fEnd = Math.ceil(stampEnd * numFrames);
      const numStampFrames = Math.max(1, fEnd - fStart);

      // Snapshot affected frames for undo
      const stampDiffs = new Map<number, Float32Array>();
      for (let f = fStart; f < Math.min(fEnd, editedFrames.length); f++)
        stampDiffs.set(f, editedFrames[f].slice());
      undoStack.push({ kind: 'patch', diffs: stampDiffs });
      if (undoStack.length > MAX_UNDO) undoStack.shift();
      editedAudioStale = true;
      updateUndoBtn();
      updatePlayModeUI();

      const imgW = stampImageData.width;
      const imgH = stampImageData.height;
      const imgPx = stampImageData.data; // RGBA, row-major

      for (let b = 0; b < numBins; b++) {
        const freq = (b / numBins) * nyquist;
        const mel = hzToMel(Math.max(20, freq));
        const melFrac = Math.max(
          0,
          Math.min(1, (mel - melMin) / (melMax - melMin)),
        );
        // High mel → top of image row 0; low mel → bottom row imgH-1
        const imgRow = Math.min(
          imgH - 1,
          Math.round((1 - melFrac) * (imgH - 1)),
        );

        for (let df = 0; df < numStampFrames; df++) {
          const f = fStart + df;
          if (f < 0 || f >= editedFrames.length) continue;
          const imgCol = Math.min(
            imgW - 1,
            Math.round((df / Math.max(1, numStampFrames - 1)) * (imgW - 1)),
          );

          const pIdx = (imgRow * imgW + imgCol) * 4;
          const r = imgPx[pIdx],
            g = imgPx[pIdx + 1],
            bC = imgPx[pIdx + 2],
            a = imgPx[pIdx + 3];
          const stampVal =
            ((0.299 * r + 0.587 * g + 0.114 * bC) / 255) * (a / 255);

          const existing = editedFrames[f][b];
          let result: number;
          switch (blend) {
            case 'add':
              result = Math.min(1, existing + stampVal * opacity);
              break;
            case 'screen':
              result = 1 - (1 - existing) * (1 - stampVal * opacity);
              break;
            case 'multiply':
              result = existing * (stampVal * opacity + (1 - opacity));
              break;
            case 'replace':
              result = existing * (1 - opacity) + stampVal * opacity;
              break;
            default:
              result = Math.min(1, existing + stampVal * opacity);
          }
          editedFrames[f][b] = Math.max(0, Math.min(1, result));
        }
      }
      scheduleRender();
    }

    function loadStampImageData(file: File) {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        const oc = document.createElement('canvas');
        oc.width = img.naturalWidth;
        oc.height = img.naturalHeight;
        const octx = oc.getContext('2d')!;
        octx.drawImage(img, 0, 0);
        stampImageData = octx.getImageData(0, 0, oc.width, oc.height);
        URL.revokeObjectURL(url);
        const thumbEl = document.getElementById(
          'ph-stamp-thumb',
        ) as HTMLImageElement;
        const blobUrl = URL.createObjectURL(file);
        thumbEl.src = blobUrl;
        thumbEl.onload = () => URL.revokeObjectURL(blobUrl);
        document.getElementById('ph-stamp-img-name')!.textContent = file.name;
        document.getElementById('ph-stamp-preview-row')!.style.display = 'flex';
        (
          document.getElementById('ph-stamp-apply') as HTMLButtonElement
        ).disabled = false;
      };
      img.src = url;
    }

