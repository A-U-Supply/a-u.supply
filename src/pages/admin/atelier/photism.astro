    document
      .getElementById('ph-img-modal-close')!
      .addEventListener('click', closeImgLibrary);
    imgModalOverlay.addEventListener('click', (e) => {
      if (e.target === imgModalOverlay) closeImgLibrary();
    });
    document
      .getElementById('ph-img-modal-tabs')!
      .addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
          '.ph-modal__tab',
        );
        if (btn?.dataset.tab) setImgLibTab(btn.dataset.tab as ImgLibTab);
      });
    imgModalSearch.addEventListener('input', () => {
      if (imgLibSearchTimer) clearTimeout(imgLibSearchTimer);
      imgLibSearchTimer = setTimeout(
        () => loadImgLibItems(imgModalSearch.value.trim()),
        300,
      );
    });
  </script>
