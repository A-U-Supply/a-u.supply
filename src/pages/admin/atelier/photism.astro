---
import Admin from '../../../layouts/Admin.astro';
---

<Admin title="Photism" current="photism">
  <div class="page-header">
    <h1>Photism</h1>
    <p class="page-subtitle">audio → image translation</p>
  </div>

  <div class="ph-shell">
    <!-- ── Controls ─────────────────────────────────────────── -->
    <div class="ph-controls">
      <!-- Upload zone -->
      <div class="ph-drop-zone" id="ph-drop-zone">
        <div class="ph-drop-empty" id="ph-drop-empty">
          <div class="ph-drop-icon">♫</div>
          <div class="ph-drop-hint">Drop audio here</div>
          <div class="ph-drop-actions">
            <button class="ph-drop-btn" id="ph-upload-btn">↑ Upload File</button
            >
            <span class="ph-drop-or">or</span>
            <button class="ph-drop-btn ph-drop-btn--lib" id="ph-lib-btn"
              >From Library</button
            >
          </div>
          <div class="ph-drop-sub">MP3 · WAV · OGG · FLAC · M4A</div>
        </div>
        <div id="ph-loaded-zone" style="display:none">
          <div class="ph-waveform-row">
            <button class="ph-play-btn" id="ph-play-btn" title="Play / Stop"
              >▶</button
            >
            <button class="ph-loop-btn" id="ph-loop-btn" title="Toggle loop"
              >⟳</button
            >
            <div class="ph-play-mode" id="ph-play-mode" style="display:none">
              <button
                class="ph-pill ph-pill--on"
                id="ph-mode-orig"
                title="Play original audio">Orig</button
              >
              <button
                class="ph-pill"
                id="ph-mode-edit"
                title="Play with edits applied (synthesizes audio)">Edit</button
              >
            </div>
            <canvas id="ph-waveform" width="264" height="52"></canvas>
            <span class="ph-time-display" id="ph-time-display">0:00</span>
          </div>
          <div class="ph-loaded-footer">
            <div id="ph-audio-meta" class="ph-audio-meta"></div>
            <button class="ph-change-btn" id="ph-change-btn">Change</button>
          </div>
        </div>
        <input
          type="file"
          id="ph-file-input"
          accept="audio/*"
          style="display:none"
        />
      </div>

      <div class="ph-divider"></div>

      <!-- Mode -->
      <div class="ph-label-row">Mode</div>
      <div class="ph-pill-group" id="ph-mode-group">
        <button class="ph-pill ph-pill--on" data-val="waterfall"
          >Waterfall</button
        >
        <button class="ph-pill" data-val="radial">Radial</button>
        <button class="ph-pill" data-val="glitch">Glitch</button>
        <button class="ph-pill" data-val="hybrid">Hybrid</button>
      </div>

      <!-- Palette -->
      <div class="ph-label-row">Palette</div>
      <div class="ph-pill-group" id="ph-palette-group">
        <button class="ph-pill ph-pill--on" data-val="hot">Hot</button>
        <button class="ph-pill" data-val="viridis">Viridis</button>
        <button class="ph-pill" data-val="mono">Mono</button>
        <button class="ph-pill" data-val="acid">Acid</button>
      </div>

      <div class="ph-divider"></div>

      <!-- Shared params -->
      <div class="ph-field">
        <label class="ph-label" for="ph-fft">Detail</label>
        <select class="ph-select" id="ph-fft">
          <option value="512">Low</option>
          <option value="1024" selected>Med</option>
          <option value="2048">High</option>
          <option value="4096">Ultra</option>
        </select>
      </div>

      <div class="ph-field">
        <label class="ph-label">
          <span>Trim</span>
          <span class="ph-val"
            ><span id="ph-ts-val">0</span>–<span id="ph-te-val">100</span
            >%</span
          >
        </label>
        <div class="ph-dual-range">
          <input type="range" id="ph-time-start" min="0" max="100" value="0" />
          <input type="range" id="ph-time-end" min="0" max="100" value="100" />
        </div>
      </div>

      <div class="ph-divider"></div>

      <!-- Waterfall params -->
      <div class="ph-mode-params" data-ph-mode="waterfall">
        <div class="ph-field">
          <label class="ph-label" for="ph-freq-max"
            >Max Freq <span class="ph-val" id="ph-fmax-val">8 kHz</span></label
          >
          <input
            class="ph-range"
            type="range"
            id="ph-freq-max"
            min="1000"
            max="22050"
            step="100"
            value="8000"
          />
        </div>
      </div>

      <!-- Radial params -->
      <div class="ph-mode-params" data-ph-mode="radial" style="display:none">
        <div class="ph-field">
          <label class="ph-label" for="ph-rotation"
            >Rotation <span class="ph-val" id="ph-rot-val">0°</span></label
          >
          <input
            class="ph-range"
            type="range"
            id="ph-rotation"
            min="0"
            max="360"
            value="0"
          />
        </div>
      </div>

      <!-- Glitch params -->
      <div class="ph-mode-params" data-ph-mode="glitch" style="display:none">
        <div class="ph-field">
          <label class="ph-label" for="ph-warp"
            >Warp <span class="ph-val" id="ph-warp-val">8</span></label
          >
          <input
            class="ph-range"
            type="range"
            id="ph-warp"
            min="0"
            max="20"
            step="0.5"
            value="8"
          />
        </div>
        <div class="ph-field">
          <label class="ph-label" for="ph-noise"
            >Noise <span class="ph-val" id="ph-noise-val">0.30</span></label
          >
          <input
            class="ph-range"
            type="range"
            id="ph-noise"
            min="0"
            max="1"
            step="0.01"
            value="0.3"
          />
        </div>
      </div>

      <!-- Hybrid params -->
      <div class="ph-mode-params" data-ph-mode="hybrid" style="display:none">
        <div class="ph-field">
          <label class="ph-label" for="ph-split"
            >Split <span class="ph-val" id="ph-split-val">0.50</span></label
          >
          <input
            class="ph-range"
            type="range"
            id="ph-split"
            min="0.2"
            max="0.8"
            step="0.01"
            value="0.5"
          />
        </div>
      </div>
    </div>

    <!-- ── Stage ──────────────────────────────────────────────── -->
    <div class="ph-stage">
      <div class="ph-canvas-wrap" id="ph-canvas-wrap">
        <canvas id="ph-canvas" width="900" height="600"></canvas>
        <div class="ph-playhead" id="ph-playhead"></div>
        <div class="ph-empty" id="ph-empty">Upload an audio file to begin</div>
        <div class="ph-busy" id="ph-busy" style="display:none">
          <span id="ph-busy-label">Analyzing…</span>
        </div>
      </div>

      <div class="ph-action-bar" id="ph-action-bar" style="display:none">
        <button class="btn btn--primary ph-save-btn" id="ph-save-btn"
          >☁ Save Image</button
        >
        <div class="ph-export-wrap">
          <button class="btn btn--secondary ph-export-btn" id="ph-export-btn"
            >Export ▾</button
          >
          <div class="ph-export-menu" id="ph-export-menu" style="display:none">
            <button class="ph-export-item" id="ph-record-btn"
              >⏺ Record WebM</button
            >
            <div class="ph-export-fps">
              <span>FPS</span>
              <select class="ph-select" id="ph-fps">
                <option value="12">12</option>
                <option value="24" selected>24</option>
                <option value="30">30</option>
              </select>
            </div>
            <button class="ph-export-item" id="ph-frames-btn"
              >⬇ Save Frames</button
            >
            <button
              class="ph-export-item ph-export-item--primary"
              id="ph-audio-stacks-btn">♫ Send to Stacks</button
            >
            <button class="ph-export-item" id="ph-audio-btn"
              >⬇ Download WAV</button
            >
          </div>
        </div>
        <button class="btn btn--secondary ph-undo-btn" id="ph-undo-btn" disabled
          >↩ Undo</button
        >
        <button class="btn btn--secondary ph-paint-btn" id="ph-paint-btn"
          >✏ Paint</button
        >
        <button class="btn btn--secondary ph-stamp-btn" id="ph-stamp-btn"
          >⬛ Stamp</button
        >
        <button class="btn btn--secondary ph-fx-btn" id="ph-fx-btn">✦ FX</button
        >
      </div>
      <div class="ph-paint-bar" id="ph-paint-bar" style="display:none">
        <div class="ph-paint-tool-row">
          <span class="ph-paint-label">Tool</span>
          <div class="ph-pill-group ph-tool-group" id="ph-tool-group">
            <button class="ph-pill ph-pill--on" data-tool="draw">Draw</button>
            <button class="ph-pill" data-tool="erase">Erase</button>
            <button class="ph-pill" data-tool="gain">Gain</button>
            <button class="ph-pill" data-tool="blur">Blur</button>
            <button class="ph-pill" data-tool="smear">Smear</button>
          </div>
        </div>
        <div class="ph-paint-size-row">
          <span class="ph-paint-label"
            >Size <span id="ph-brush-val">8</span>px</span
          >
          <input
            type="range"
            class="ph-range ph-brush-slider"
            id="ph-brush-size"
            min="2"
            max="30"
            value="8"
          />
        </div>
        <div class="ph-gain-row" id="ph-gain-row" style="display:none">
          <span class="ph-paint-label"
            >Gain <span id="ph-gain-val">1.5×</span></span
          >
          <input
            type="range"
            class="ph-range ph-brush-slider"
            id="ph-gain-amount"
            min="0"
            max="200"
            value="150"
          />
        </div>
        <div class="ph-paint-bar-btns">
          <button class="btn ph-paint-reset-btn" id="ph-paint-reset-btn"
            >Reset Edits</button
          >
        </div>
      </div>
      <div class="ph-stamp-bar" id="ph-stamp-bar" style="display:none">
        <div class="ph-stamp-step">
          <span class="ph-stamp-step-num">1</span>
          <div class="ph-stamp-step-body">
            <div class="ph-stamp-pick-row">
              <button class="ph-drop-btn" id="ph-stamp-upload-btn"
                >↑ Upload Image</button
              >
              <span class="ph-drop-or">or</span>
              <button class="ph-drop-btn ph-drop-btn--lib" id="ph-stamp-lib-btn"
                >From Library</button
              >
              <input
                type="file"
                id="ph-stamp-file-input"
                accept="image/*"
                style="display:none"
              />
            </div>
            <div
              class="ph-stamp-preview-row"
              id="ph-stamp-preview-row"
              style="display:none"
            >
              <img id="ph-stamp-thumb" class="ph-stamp-thumb" alt="" />
              <span class="ph-stamp-img-name" id="ph-stamp-img-name"></span>
            </div>
          </div>
        </div>
        <div class="ph-stamp-step">
          <span class="ph-stamp-step-num">2</span>
          <div class="ph-stamp-step-body" style="flex:1">
            <div class="ph-field">
              <label class="ph-label">
                <span>Time range</span>
                <span class="ph-val"
                  ><span id="ph-stamp-ts-val">0</span>–<span
                    id="ph-stamp-te-val">100</span
                  >%</span
                >
              </label>
              <div class="ph-dual-range">
                <input
                  type="range"
                  id="ph-stamp-start"
                  min="0"
                  max="100"
                  value="0"
                />
                <input
                  type="range"
                  id="ph-stamp-end"
                  min="0"
                  max="100"
                  value="100"
                />
              </div>
            </div>
            <div class="ph-stamp-controls">
              <div class="ph-field">
                <label class="ph-label" for="ph-stamp-opacity"
                  >Opacity <span class="ph-val" id="ph-stamp-op-val">100%</span
                  ></label
                >
                <input
                  type="range"
                  class="ph-range"
                  id="ph-stamp-opacity"
                  min="0"
                  max="100"
                  value="100"
                />
              </div>
              <div class="ph-field">
                <label class="ph-label" for="ph-stamp-blend">Blend</label>
                <select class="ph-select" id="ph-stamp-blend">
                  <option value="add">Add</option>
                  <option value="screen">Screen</option>
                  <option value="multiply">Multiply</option>
                  <option value="replace">Replace</option>
                </select>
              </div>
            </div>
            <button
              class="btn btn--primary ph-stamp-apply"
              id="ph-stamp-apply"
              disabled>Apply Stamp</button
            >
          </div>
        </div>
      </div>
      <div class="ph-fx-bar" id="ph-fx-bar" style="display:none">
        <div class="ph-pill-group" id="ph-fx-group">
          <button class="ph-pill ph-pill--on" data-fx="none">None</button>
          <button class="ph-pill" data-fx="blur">Blur</button>
          <button class="ph-pill" data-fx="sharpen">Sharpen</button>
          <button class="ph-pill" data-fx="pitch-up">Pitch ▲</button>
          <button class="ph-pill" data-fx="pitch-dn">Pitch ▼</button>
          <button class="ph-pill" data-fx="reverse">Reverse</button>
          <button class="ph-pill" data-fx="pixelate">Pixelate</button>
        </div>
        <div
          class="ph-fx-strength-row"
          id="ph-fx-strength-row"
          style="display:none"
        >
          <span class="ph-paint-label"
            >Amount <span id="ph-fx-str-val">5</span></span
          >
          <input
            type="range"
            class="ph-range ph-brush-slider"
            id="ph-fx-strength"
            min="1"
            max="20"
            value="5"
          />
        </div>
        <button
          class="btn btn--primary ph-fx-apply"
          id="ph-fx-apply"
          style="display:none">Apply to Audio</button
        >
      </div>
      <button class="ph-settings-toggle" id="ph-settings-toggle"
        >Settings ▾</button
      >
    </div>
  </div>

  <style>
    .ph-shell {
      display: flex;
      gap: 1.5rem;
      align-items: flex-start;
      color: var(--fg, #e8e8e8);
    }
    .ph-controls {
      width: 280px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .ph-stage {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    /* Drop zone */
    .ph-drop-zone {
      border: 1px dashed var(--border, #444);
      border-radius: 6px;
      padding: 1.25rem 1rem;
      transition: border-color 0.15s;
      min-height: 150px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
    }
    .ph-drop-zone.drag-over {
      border-color: var(--accent, #888);
      border-style: solid;
    }
    .ph-drop-empty {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.15rem;
    }
    .ph-drop-icon {
      font-size: 1.6rem;
      opacity: 0.4;
      margin-bottom: 0.2rem;
    }
    .ph-drop-hint {
      font-size: 0.8rem;
      opacity: 0.6;
    }
    .ph-drop-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.65rem;
    }
    .ph-drop-btn {
      font-size: 0.75rem;
      padding: 0.3rem 0.8rem;
      border: 1px solid var(--border, #444);
      border-radius: 3px;
      background: var(--bg2, #1a1a1a);
      color: inherit;
      cursor: pointer;
      transition:
        border-color 0.1s,
        opacity 0.1s;
    }
    .ph-drop-btn:hover {
      border-color: var(--accent, #888);
    }
    .ph-drop-btn--lib {
      border-color: var(--accent, #777);
    }
    .ph-drop-or {
      font-size: 0.65rem;
      opacity: 0.5;
    }
    .ph-drop-sub {
      font-size: 0.65rem;
      opacity: 0.5;
      margin-top: 0.5rem;
    }
    .ph-loaded-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 0.3rem;
      width: 100%;
    }
    .ph-audio-meta {
      font-size: 0.65rem;
      opacity: 0.65;
    }
    .ph-change-btn {
      font-size: 0.65rem;
      opacity: 0.6;
      background: none;
      border: none;
      color: inherit;
      cursor: pointer;
      padding: 0;
      flex-shrink: 0;
    }
    .ph-change-btn:hover {
      opacity: 1;
    }
    #ph-waveform {
      width: 100%;
      border-radius: 2px;
      display: block;
    }

    /* Divider */
    .ph-divider {
      height: 1px;
      background: var(--border, #333);
      margin: 0.25rem 0;
    }

    /* Labels */
    .ph-label-row {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      opacity: 0.65;
      margin-bottom: 0.1rem;
    }

    /* Pill groups */
    .ph-pill-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
      margin-bottom: 0.5rem;
    }
    .ph-pill {
      font-size: 0.7rem;
      padding: 0.2rem 0.55rem;
      border: 1px solid var(--border, #444);
      border-radius: 3px;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: 0.65;
      transition:
        opacity 0.1s,
        border-color 0.1s;
    }
    .ph-pill:hover {
      opacity: 0.85;
    }
    .ph-pill--on {
      opacity: 1;
      border-color: var(--accent, #aaa);
    }

    /* Fields */
    .ph-field {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    .ph-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      opacity: 0.65;
      display: flex;
      justify-content: space-between;
    }
    .ph-val {
      opacity: 0.9;
      font-variant-numeric: tabular-nums;
    }
    .ph-select {
      font-size: 0.75rem;
      padding: 0.2rem 0.4rem;
      background: var(--bg2, #1a1a1a);
      border: 1px solid var(--border, #333);
      color: inherit;
      border-radius: 3px;
    }

    /* Canvas wrap */
    .ph-canvas-wrap {
      position: relative;
      background: #0a0a0a;
      border-radius: 4px;
      overflow: hidden;
    }
    #ph-canvas {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 3/2;
    }
    .ph-empty,
    .ph-busy {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      opacity: 0.55;
      pointer-events: none;
    }
    .ph-busy {
      opacity: 0.8;
    }

    /* Play / loop buttons */
    .ph-waveform-row {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      width: 100%;
    }
    .ph-waveform-row #ph-waveform {
      flex: 1;
      min-width: 0;
    }
    .ph-play-btn,
    .ph-loop-btn {
      flex-shrink: 0;
      width: 2rem;
      height: 2rem;
      background: var(--bg2, #1a1a1a);
      border: 1px solid var(--border, #444);
      border-radius: 50%;
      color: inherit;
      cursor: pointer;
      font-size: 0.65rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.1s;
    }
    .ph-play-btn:hover,
    .ph-loop-btn:hover {
      border-color: var(--accent, #888);
    }
    .ph-loop-btn--on {
      border-color: var(--accent, #aaa);
      color: var(--accent, #aaa);
    }
    .ph-time-display {
      font-size: 0.65rem;
      opacity: 0.65;
      font-variant-numeric: tabular-nums;
      flex-shrink: 0;
      white-space: nowrap;
    }
    /* Playhead overlay on spectrogram canvas */
    .ph-playhead {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 2px;
      background: rgba(255, 220, 80, 0.85);
      pointer-events: none;
      transform: translateX(-50%);
      display: none;
      box-shadow: 0 0 6px rgba(255, 220, 80, 0.4);
    }

    /* Dual range */
    .ph-dual-range {
      position: relative;
      height: 1.5rem;
      margin-top: 0.2rem;
    }
    .ph-dual-range input[type='range'] {
      position: absolute;
      inset: 0;
      width: 100%;
      appearance: none;
      -webkit-appearance: none;
      background: transparent;
      pointer-events: none;
      margin: 0;
      height: 100%;
    }
    .ph-dual-range input[type='range']::-webkit-slider-runnable-track {
      height: 3px;
      background: var(--border, #444);
      border-radius: 2px;
    }
    .ph-dual-range input[type='range']::-moz-range-track {
      height: 3px;
      background: var(--border, #444);
      border-radius: 2px;
    }
    .ph-dual-range input[type='range']::-webkit-slider-thumb {
      appearance: none;
      -webkit-appearance: none;
      pointer-events: all;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--accent, #888);
      cursor: pointer;
      margin-top: -5.5px;
    }
    .ph-dual-range input[type='range']::-moz-range-thumb {
      pointer-events: all;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--accent, #888);
      border: none;
      cursor: pointer;
    }

    /* Action bar */
    .ph-action-bar {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      align-items: center;
    }
    .ph-save-btn {
      flex-shrink: 0;
    }
    .ph-export-wrap {
      position: relative;
    }
    .ph-export-menu {
      position: absolute;
      top: calc(100% + 4px);
      right: 0;
      background: var(--bg, #111);
      border: 1px solid var(--border, #333);
      border-radius: 4px;
      min-width: 160px;
      z-index: 100;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .ph-export-item {
      padding: 0.5rem 0.75rem;
      font-size: 0.75rem;
      text-align: left;
      background: none;
      border: none;
