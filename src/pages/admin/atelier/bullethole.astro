---
// Redirect to Punctum with bot=bullethole, preserving any URL params
const url = new URL(Astro.request.url);
const dest = new URL('/admin/atelier/punctum', url.origin);
dest.searchParams.set('bot', 'bullethole');
// Forward known params (seed, autoexport, source → source0, etc.)
for (const [k, v] of url.searchParams.entries()) {
  if (k === 'source') dest.searchParams.set('source0', v);
  else if (k !== 'bot') dest.searchParams.set(k, v);
}
return Astro.redirect(dest.pathname + dest.search, 301);
---

<Admin title="Bullet Hole" current="bullethole-live">
  <div class="page-header">
    <h1>Bullet Hole</h1>
    <p class="page-subtitle">Live image editor</p>
  </div>

  <div class="bh-shell">
    <!-- Canvas stage -->
    <div class="bh-stage">
      <div class="bh-drop-zone" id="drop-zone">
        <canvas id="bh-canvas"></canvas>
        <div class="bh-empty" id="bh-empty">
          <div class="bh-empty__icon">⬡</div>
          <div>Drop an image here or click to upload</div>
          <div class="bh-empty__sub">or use Pick from Library below</div>
        </div>
        <input type="file" id="file-input" accept="image/*" style="display:none" />
      </div>
    </div>

    <!-- Controls -->
    <div class="bh-controls">
      <button class="btn btn--secondary bh-library-btn" id="library-btn">Pick from Library</button>

      <div class="bh-divider"></div>

      <div class="bh-field">
        <label class="bh-label" for="chaos">
          Chaos
          <span class="bh-val" id="chaos-val">0.50</span>
        </label>
        <input class="bh-range" type="range" id="chaos" min="0" max="1" step="0.01" value="0.5" />
        <div class="bh-range-hints"><span>few large</span><span>many small</span></div>
      </div>

      <div class="bh-field">
        <label class="bh-label" for="placement">Placement</label>
        <select class="bh-select" id="placement">
          <option value="random">Random</option>
          <option value="grid">Grid</option>
          <option value="hex">Hex</option>
          <option value="radial">Radial</option>
        </select>
      </div>

      <div class="bh-field">
        <label class="bh-label" for="effect">Effect</label>
        <select class="bh-select" id="effect">
          <option value="rotate">Rotate</option>
          <option value="invert">Invert</option>
          <option value="blur">Blur</option>
          <option value="grayscale">Grayscale</option>
          <option value="pixelate">Pixelate</option>
          <option value="fill_black">Fill Black</option>
          <option value="fill_white">Fill White</option>
        </select>
      </div>

      <div class="bh-field" id="jitter-field">
        <label class="bh-label" for="jitter">
          Jitter
          <span class="bh-val" id="jitter-val">0.00</span>
        </label>
        <input class="bh-range" type="range" id="jitter" min="0" max="1" step="0.01" value="0" />
      </div>

      <div class="bh-field bh-check-field">
        <label class="bh-check-label">
          <input type="checkbox" id="no-overlap" />
          No Overlap
        </label>
      </div>

      <div class="bh-divider"></div>

      <div class="bh-actions">
        <button class="btn btn--secondary" id="reroll-btn" disabled>⟳ Re-roll</button>
        <button class="btn btn--secondary" id="download-btn" disabled>↓ Download</button>
        <button class="btn btn--primary" id="save-btn" disabled>☁ Save to Outputs</button>
        <button class="btn btn--secondary" id="save-png-btn" disabled>☁ HD PNG</button>
      </div>
    </div>
  </div>

  <!-- Library picker modal -->
  <div class="bh-modal-overlay" id="library-overlay" style="display:none">
    <div class="bh-modal">
      <div class="bh-modal__header">
        <h2>Pick an Image</h2>
        <button class="bh-modal__close" id="library-close">✕</button>
      </div>
      <input class="bh-modal__search" type="text" id="library-search" placeholder="Search…" />
      <div class="bh-modal__grid" id="library-grid">
        <div class="bh-modal__loading loading-dots">Loading</div>
      </div>
    </div>
  </div>
</Admin>

