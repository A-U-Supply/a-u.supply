<script>
  document.addEventListener('astro:page-load', () => {
    // ─── Elements ──────────────────────────────────────────────────────────
    const canvas    = document.getElementById('bh-canvas') as HTMLCanvasElement;
    const dropZone  = document.getElementById('drop-zone') as HTMLDivElement;
    const emptyEl   = document.getElementById('bh-empty') as HTMLDivElement;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;

    const chaosEl       = document.getElementById('chaos') as HTMLInputElement;
    const chaosVal      = document.getElementById('chaos-val') as HTMLSpanElement;
    const placementEl   = document.getElementById('placement') as HTMLSelectElement;
    const effectEl      = document.getElementById('effect') as HTMLSelectElement;
    const jitterEl      = document.getElementById('jitter') as HTMLInputElement;
    const jitterVal     = document.getElementById('jitter-val') as HTMLSpanElement;
    const jitterField   = document.getElementById('jitter-field') as HTMLDivElement;
    const noOverlapEl   = document.getElementById('no-overlap') as HTMLInputElement;

    const rerollBtn   = document.getElementById('reroll-btn') as HTMLButtonElement;
    const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
    const saveBtn     = document.getElementById('save-btn') as HTMLButtonElement;
    const savePngBtn  = document.getElementById('save-png-btn') as HTMLButtonElement;
    const libraryBtn  = document.getElementById('library-btn') as HTMLButtonElement;

    const libraryOverlay = document.getElementById('library-overlay') as HTMLDivElement;
    const libraryClose   = document.getElementById('library-close') as HTMLButtonElement;
    const librarySearch  = document.getElementById('library-search') as HTMLInputElement;
    const libraryGrid    = document.getElementById('library-grid') as HTMLDivElement;

    // ─── Seeded PRNG (mulberry32) ───────────────────────────────────────────
    function mulberry32(seed: number) {
      return function() {
        seed |= 0; seed = seed + 0x6D2B79F5 | 0;
        let t = Math.imul(seed ^ seed >>> 15, 1 | seed);
        t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
        return ((t ^ t >>> 14) >>> 0) / 4294967296;
      };
    }

    let rng: () => number = Math.random.bind(Math);

    // ─── State ─────────────────────────────────────────────────────────────
    let sourceImg: HTMLImageElement | null = null;
    let currentSourceId: string | null = null;
    let currentSeed: number = 0;
    let state: { holes: {cx:number, cy:number, angle:number}[], radius: number } | null = null;

    // ─── Placement helpers (mirrors bullethole_bot.py) ─────────────────────

    function removeOverlap(centers: [number,number][], radius: number): [number,number][] {
      const kept: [number,number][] = [];
      const diam2 = (radius * 2) ** 2;
      for (const [cx, cy] of centers) {
        if (!kept.some(([ox,oy]) => (cx-ox)**2 + (cy-oy)**2 < diam2)) {
          kept.push([cx, cy]);
        }
      }
      return kept;
    }

    function placeRandom(n: number, w: number, h: number, radius: number, noOverlap: boolean): [number,number][] {
      const centers: [number,number][] = [];
      const diam2 = (radius * 2) ** 2;
      for (let i = 0; i < n; i++) {
        if (noOverlap) {
          for (let attempt = 0; attempt < 100; attempt++) {
            const cx = radius + rng() * (w - radius * 2);
            const cy = radius + rng() * (h - radius * 2);
            if (!centers.some(([ox,oy]) => (cx-ox)**2 + (cy-oy)**2 < diam2)) {
              centers.push([cx, cy]);
              break;
            }
          }
        } else {
          centers.push([
            radius + rng() * (w - radius * 2),
            radius + rng() * (h - radius * 2),
          ]);
        }
      }
      return centers;
    }

    function placeGrid(n: number, w: number, h: number, radius: number, jitter: number, hex: boolean): [number,number][] {
      const cols = Math.max(1, Math.round(Math.sqrt(n * w / h)));
      const rows = Math.max(1, Math.ceil(n / cols));
      const cellW = w / cols;
      const cellH = h / rows;
      const centers: [number,number][] = [];

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          if (centers.length >= n) break;
          let cx = cellW * (c + 0.5);
          let cy = cellH * (r + 0.5);
          if (hex && r % 2 === 1) cx += cellW * 0.5;
          if (jitter > 0) {
            cx += (rng() * 2 - 1) * cellW * jitter * 0.5;
            cy += (rng() * 2 - 1) * cellH * jitter * 0.5;
          }
          cx = Math.max(radius, Math.min(w - radius, cx));
          cy = Math.max(radius, Math.min(h - radius, cy));
          centers.push([cx, cy]);
        }
      }
      return centers;
    }

    function placeRadial(n: number, w: number, h: number, radius: number, jitter: number): [number,number][] {
      const cx0 = w / 2, cy0 = h / 2;
      const maxDist = Math.min(cx0, cy0) - radius;
      if (maxDist <= 0 || n <= 1) return Array(n).fill([cx0, cy0]);

      const numRings = Math.max(1, Math.round(Math.sqrt(n)));
      const ringRadii = Array.from({length: numRings}, (_, i) => maxDist * (i + 1) / numRings);
      const totalR = ringRadii.reduce((a,b) => a+b, 0);

      const counts: number[] = [];
      let remaining = n;
      for (let i = 0; i < numRings; i++) {
        if (i === numRings - 1) { counts.push(remaining); break; }
        const c = Math.max(1, Math.round(n * ringRadii[i] / totalR));
        counts.push(c);
        remaining -= c;
      }

      const centers: [number,number][] = [];
      for (let i = 0; i < numRings; i++) {
        for (let k = 0; k < counts[i]; k++) {
          let angle = 2 * Math.PI * k / counts[i];
          let dist = ringRadii[i];
          if (jitter > 0) {
            angle += (rng() * 2 - 1) * Math.PI / counts[i] * jitter;
            dist += (rng() * 2 - 1) * (maxDist / numRings) * jitter * 0.5;
            dist = Math.max(radius, Math.min(maxDist, dist));
          }
          const px = Math.max(radius, Math.min(w - radius, cx0 + dist * Math.cos(angle)));
          const py = Math.max(radius, Math.min(h - radius, cy0 + dist * Math.sin(angle)));
          centers.push([px, py]);
        }
      }
      return centers.slice(0, n);
    }

    function genHoles(w: number, h: number): typeof state {
      const chaos     = parseFloat(chaosEl.value);
      const placement = placementEl.value;
      const jitter    = parseFloat(jitterEl.value);
      const noOverlap = noOverlapEl.checked;

      const n = Math.max(2, Math.round(2 + chaos * 84 + (rng() * 2 - 1)));
      const frac = 0.33 + (0.05 - 0.33) * chaos;
      const maxR = Math.max(4, Math.round(w * frac));
      const minR = Math.max(2, Math.round(maxR * 0.6));
      const radius = minR + Math.floor(rng() * (maxR - minR + 1));

      let rawCenters: [number,number][];
      if (placement === 'grid')        rawCenters = placeGrid(n, w, h, radius, jitter, false);
      else if (placement === 'hex')    rawCenters = placeGrid(n, w, h, radius, jitter, true);
      else if (placement === 'radial') rawCenters = placeRadial(n, w, h, radius, jitter);
      else                             rawCenters = placeRandom(n, w, h, radius, noOverlap);

      if (noOverlap && placement !== 'random') rawCenters = removeOverlap(rawCenters, radius);

      const holes = rawCenters.map(([cx, cy]) => ({
        cx, cy,
        angle: rng() * 300 + 30,
      }));

      return { holes, radius };
    }

    // ─── Render ────────────────────────────────────────────────────────────

    function render() {
      if (!sourceImg || !state) return;
      const ctx = canvas.getContext('2d')!;
      const { holes, radius } = state;
      const effect = effectEl.value;
      const W = canvas.width, H = canvas.height;

      // Base image
      ctx.drawImage(sourceImg, 0, 0, W, H);

      for (const { cx, cy, angle } of holes) {
        ctx.save();
        ctx.beginPath();
        ctx.arc(cx, cy, radius, 0, Math.PI * 2);
        ctx.clip();

        switch (effect) {
          case 'rotate':
            ctx.translate(cx, cy);
            ctx.rotate(angle * Math.PI / 180);
            ctx.translate(-cx, -cy);
            ctx.drawImage(sourceImg, 0, 0, W, H);
            break;
          case 'invert':
            ctx.filter = 'invert(1)';
            ctx.drawImage(sourceImg, 0, 0, W, H);
            ctx.filter = 'none';
            break;
          case 'blur':
            ctx.filter = `blur(${Math.max(2, Math.floor(radius / 6))}px)`;
            ctx.drawImage(sourceImg, 0, 0, W, H);
            ctx.filter = 'none';
            break;
          case 'grayscale':
            ctx.filter = 'grayscale(1)';
            ctx.drawImage(sourceImg, 0, 0, W, H);
            ctx.filter = 'none';
            break;
          case 'pixelate': {
            const block = Math.max(4, Math.floor(radius / 8));
            const tw = Math.max(1, Math.floor(W / block));
            const th = Math.max(1, Math.floor(H / block));
            const tmp = document.createElement('canvas');
            tmp.width = tw; tmp.height = th;
            tmp.getContext('2d')!.drawImage(sourceImg, 0, 0, tw, th);
            ctx.imageSmoothingEnabled = false;
            ctx.drawImage(tmp, 0, 0, tw, th, 0, 0, W, H);
            ctx.imageSmoothingEnabled = true;
            break;
          }
          case 'fill_black':
            ctx.fillStyle = '#000';
            ctx.fill();
            break;
          case 'fill_white':
            ctx.fillStyle = '#fff';
            ctx.fill();
            break;
        }

        ctx.restore();
      }
    }

    function reroll(seed?: number) {
      if (!sourceImg) return;
      currentSeed = seed !== undefined ? seed : (Math.random() * 2**31 | 0) || 1;
      rng = mulberry32(currentSeed);
      state = genHoles(canvas.width, canvas.height);
      render();
    }

    // ─── Load image ────────────────────────────────────────────────────────

    function loadFromBlob(blob: Blob) {
      currentSourceId = null;
      const url = URL.createObjectURL(blob);
      const img = new Image();
      img.onload = () => {
        sourceImg = img;
        canvas.width  = img.naturalWidth;
        canvas.height = img.naturalHeight;
        canvas.style.display = 'block';
        emptyEl.style.display = 'none';
        rerollBtn.disabled   = false;
        downloadBtn.disabled = false;
        saveBtn.disabled     = false;
        savePngBtn.disabled  = false;
        reroll();
        URL.revokeObjectURL(url);
      };
      img.src = url;
    }

    function loadFromUrl(url: string, sourceId: string | null = null, seed?: number, onReady?: () => void) {
      currentSourceId = sourceId;
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        sourceImg = img;
        canvas.width  = img.naturalWidth;
        canvas.height = img.naturalHeight;
        canvas.style.display = 'block';
        emptyEl.style.display = 'none';
        rerollBtn.disabled   = false;
        downloadBtn.disabled = false;
        saveBtn.disabled     = false;
        savePngBtn.disabled  = false;
        reroll(seed);
        onReady?.();
      };
      img.onerror = () => {
        (window as any).toast?.error('Failed to load image');
      };
      img.src = url;
    }

    // ─── Controls ──────────────────────────────────────────────────────────

    function updateJitterState() {
      const disabled = placementEl.value === 'random';
      jitterField.classList.toggle('disabled', disabled);
      jitterEl.disabled = disabled;
    }

    chaosEl.addEventListener('input', () => {
      chaosVal.textContent = parseFloat(chaosEl.value).toFixed(2);
    });
    jitterEl.addEventListener('input', () => {
      jitterVal.textContent = parseFloat(jitterEl.value).toFixed(2);
    });

    // Changes that need re-roll
    let rerollTimer: ReturnType<typeof setTimeout>;
    function scheduleReroll() {
      clearTimeout(rerollTimer);
      rerollTimer = setTimeout(() => reroll(), 150);
    }

    chaosEl.addEventListener('input', scheduleReroll);
    placementEl.addEventListener('change', () => { updateJitterState(); reroll(); });
    jitterEl.addEventListener('input', scheduleReroll);
    noOverlapEl.addEventListener('change', () => reroll());

    // Effect only needs re-render (holes stay)
    effectEl.addEventListener('change', () => render());

    updateJitterState();

    // ─── File drop & click ─────────────────────────────────────────────────

    dropZone.addEventListener('click', (e) => {
      if ((e.target as Element).closest('#file-input')) return;
      fileInput.click();
    });
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) loadFromBlob(file);
    });
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('drag-over');
    });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('drag-over');
      const file = e.dataTransfer?.files[0];
      if (file && file.type.startsWith('image/')) loadFromBlob(file);
    });

    // ─── Action buttons ────────────────────────────────────────────────────

    rerollBtn.addEventListener('click', () => reroll());

    downloadBtn.addEventListener('click', () => {
      const link = document.createElement('a');
      link.download = 'bullethole.jpg';
      link.href = canvas.toDataURL('image/jpeg', 0.85);
      link.click();
    });

    function atelierMeta() {
      if (!currentSourceId) return '';
      return JSON.stringify({
        atelier: 'bullethole',
        v: 1,
        seed: currentSeed,
        source_id: currentSourceId,
        chaos: parseFloat(chaosEl.value),
        placement: placementEl.value,
        effect: effectEl.value,
        jitter: parseFloat(jitterEl.value),
        no_overlap: noOverlapEl.checked,
      });
    }

    async function saveToOutputs(mimeType: string, filename: string, btn: HTMLButtonElement, label: string): Promise<string | null> {
      btn.disabled = true;
      btn.textContent = 'Saving…';
      return new Promise((resolve) => {
        canvas.toBlob(async (blob) => {
          if (!blob) { (window as any).toast?.error('Failed to export canvas'); btn.disabled = false; btn.textContent = label; resolve(null); return; }
          try {
            const fd = new FormData();
            fd.append('file', blob, filename);
            fd.append('tags', 'bullethole,atelier');
            fd.append('output_index', 'outputs');
            const meta = atelierMeta();
            if (meta) fd.append('description', meta);
            const res = await fetch('/api/media/upload', {
              method: 'POST',
              body: fd,
              credentials: 'include',
            });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();
            (window as any).toast?.success('Saved to outputs');
            resolve(data.id || null);
          } catch (err: any) {
            (window as any).toast?.error(`Save failed: ${err.message}`);
            resolve(null);
          } finally {
            btn.disabled = false;
            btn.textContent = label;
          }
        }, mimeType, mimeType === 'image/jpeg' ? 0.85 : undefined);
      });
    }

    saveBtn.addEventListener('click', () => saveToOutputs('image/jpeg', 'bullethole.jpg', saveBtn, '☁ Save to Outputs'));
    savePngBtn.addEventListener('click', () => saveToOutputs('image/png', 'bullethole.png', savePngBtn, '☁ HD PNG'));

    // ─── URL param auto-export ──────────────────────────────────────────────
    const urlParams = new URLSearchParams(window.location.search);
    const autoExport = urlParams.get('autoexport');
    const autoSourceId = urlParams.get('source');
    const autoSeed = urlParams.get('seed');
    if (autoExport && autoSourceId && autoSeed) {
      if (urlParams.has('chaos'))     { chaosEl.value = urlParams.get('chaos')!; chaosVal.textContent = parseFloat(chaosEl.value).toFixed(2); }
      if (urlParams.has('placement')) placementEl.value = urlParams.get('placement')!;
      if (urlParams.has('effect'))    effectEl.value = urlParams.get('effect')!;
      if (urlParams.has('jitter'))    { jitterEl.value = urlParams.get('jitter')!; jitterVal.textContent = parseFloat(jitterEl.value).toFixed(2); }
      if (urlParams.get('no_overlap') === 'true') noOverlapEl.checked = true;
      updateJitterState();

      const mimeType = autoExport === 'png' ? 'image/png' : 'image/jpeg';
      const filename  = autoExport === 'png' ? 'bullethole.png' : 'bullethole.jpg';
      loadFromUrl(`/api/media/${autoSourceId}/file`, autoSourceId, parseInt(autoSeed, 10), async () => {
        const newId = await saveToOutputs(mimeType, filename, savePngBtn, '☁ HD PNG');
        if (newId) window.location.href = `/admin/search/detail?id=${newId}`;
      });
    }

    // ─── Library modal ─────────────────────────────────────────────────────

    let librarySearchTimer: ReturnType<typeof setTimeout>;

    async function loadLibrary(q = '') {
      libraryGrid.innerHTML = '<div class="bh-modal__loading loading-dots">Loading</div>';
      try {
        const res = await fetch('/api/search', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            query: q,
            media_types: ['image'],
            sort: 'created_at:desc',
            page: 1,
            per_page: 36,
            filters: {},
          }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const results: any[] = data.results || data.hits || [];

        if (results.length === 0) {
          libraryGrid.innerHTML = '<div class="bh-modal__loading">No images found</div>';
          return;
        }

        libraryGrid.innerHTML = '';
        for (const item of results) {
          const img = document.createElement('img');
          img.className = 'bh-thumb';
          img.src = `/api/media/${item.id}/thumbnail`;
          img.alt = item.filename || '';
          img.title = item.filename || '';
          img.loading = 'lazy';
          img.addEventListener('click', () => {
            libraryOverlay.style.display = 'none';
            loadFromUrl(`/api/media/${item.id}/file`, item.id);
          });
          libraryGrid.appendChild(img);
        }
      } catch (err: any) {
        libraryGrid.innerHTML = `<div class="bh-modal__loading">Error: ${err.message}</div>`;
      }
    }

    libraryBtn.addEventListener('click', () => {
      libraryOverlay.style.display = 'flex';
      loadLibrary();
    });

    libraryClose.addEventListener('click', () => {
      libraryOverlay.style.display = 'none';
    });

    libraryOverlay.addEventListener('click', (e) => {
      if (e.target === libraryOverlay) libraryOverlay.style.display = 'none';
    });

    librarySearch.addEventListener('input', () => {
      clearTimeout(librarySearchTimer);
      librarySearchTimer = setTimeout(() => loadLibrary(librarySearch.value), 300);
    });

    // Cleanup on page swap (Astro View Transitions)
    document.addEventListener('astro:before-swap', () => {
      clearTimeout(rerollTimer);
      clearTimeout(librarySearchTimer);
    }, { once: true });
  });
</script>
