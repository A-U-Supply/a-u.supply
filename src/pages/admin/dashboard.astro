---
import Admin from '../../layouts/Admin.astro';
---

<Admin title="Auspices" current="dashboard">
  <div class="page-header">
    <h1>Auspices</h1>
    <p class="auspices__subtitle" id="auspices-greeting">
      <span class="loading-dots">Reading the omens</span>
    </p>
  </div>

  <section class="stat-row" id="stat-row">
    <div class="stat-card">
      <div class="stat-card__num" data-stat="releases">—</div>
      <div class="stat-card__label">Canon</div>
      <div class="stat-card__hint">published releases</div>
    </div>
    <div class="stat-card">
      <div class="stat-card__num" data-stat="tracks">—</div>
      <div class="stat-card__label">Hymnals</div>
      <div class="stat-card__hint">tracks catalogued</div>
    </div>
    <div class="stat-card">
      <div class="stat-card__num" data-stat="media_items">—</div>
      <div class="stat-card__label">Stacks</div>
      <div class="stat-card__hint">items in the Stacks</div>
    </div>
    <div class="stat-card">
      <div class="stat-card__num" data-stat="jobs">—</div>
      <div class="stat-card__label">Offerings</div>
      <div class="stat-card__hint">jobs ever submitted</div>
    </div>
  </section>

  <section
    class="action-queue"
    id="action-queue"
    style="display:none;"
    aria-label="What needs attention"
  >
    <h2 class="section-heading">The Docket</h2>
    <div class="action-queue__row" id="action-queue-row"></div>
  </section>

  <section class="auspices-grid">
    <div class="auspices-panel">
      <h2 class="section-heading">Altar of the Day</h2>
      <p class="section-hint">
        Today's offering, drawn by lot from the Stacks. A new one tomorrow.
      </p>
      <div class="altar" id="altar">
        <div class="altar__loading">
          <span class="loading-dots">Drawing lots</span>
        </div>
      </div>
    </div>

    <div class="auspices-panel">
      <h2 class="section-heading">Quick Links</h2>
      <p class="section-hint">
        Shortcuts into the deeper apparatus. Pin your own with <kbd>+</kbd>.
      </p>
      <div class="quick-links" id="quick-links">
        <div class="quick-links__row" id="quick-links-builtin"></div>
        <div class="quick-links__row" id="quick-links-pinned"></div>
        <button class="quick-links__add" id="quick-links-add" type="button">
          + Pin a link
        </button>
      </div>
    </div>
  </section>

  <dialog class="quick-link-dialog" id="quick-link-dialog">
    <form method="dialog">
      <h3>Pin a link</h3>
      <div class="form-row">
        <div class="form-group">
          <label for="quick-link-label">Label</label>
          <input
            type="text"
            id="quick-link-label"
            class="brutal-input"
            placeholder="My favourite filter"
            required
          />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="quick-link-href">URL</label>
          <input
            type="text"
            id="quick-link-href"
            class="brutal-input"
            placeholder="/admin/search?sort=random"
            required
          />
        </div>
      </div>
      <div class="dialog-actions">
        <button type="button" class="btn-cancel" id="quick-link-cancel"
          >Cancel</button
        >
        <button type="submit" class="btn-primary" id="quick-link-save"
          >Pin</button
        >
      </div>
    </form>
  </dialog>
</Admin>

<style>
  .auspices__subtitle {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-style: italic;
    margin: 0;
  }

  .section-heading {
    font-size: var(--text-lg);
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
    border-bottom: 1px dotted var(--color-border);
    padding-bottom: var(--space-xs);
    letter-spacing: 0.04em;
  }
  .section-hint {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-style: italic;
    margin-bottom: var(--space-sm);
  }

  /* ── Stat cards (brutalist chrome, 2px + 4px shadow) ── */
  .stat-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-md);
  }
  .stat-card {
    border: 2px solid var(--color-fg);
    box-shadow: 4px 4px 0 var(--color-fg);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-surface);
    position: relative;
  }
  .stat-card__num {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .stat-card__label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-top: var(--space-xs);
  }
  .stat-card__hint {
    color: var(--color-muted);
    font-size: calc(var(--text-sm) * 0.9);
    margin-top: 2px;
  }

  /* ── Action queue ── */
  .action-queue {
    margin-top: var(--space-lg);
  }
  .action-queue__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-sm);
  }
  .action-card {
    display: block;
    border: 2px solid var(--color-fg);
    border-left-width: 6px;
    box-shadow: 4px 4px 0 var(--color-fg);
    padding: var(--space-sm) var(--space-md);
    text-decoration: none;
    color: var(--color-fg);
    background: var(--color-surface);
    transition:
      transform 60ms ease,
      box-shadow 60ms ease;
  }
  .action-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 var(--color-fg);
  }
  .action-card:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--color-fg);
  }
  .action-card__num {
    font-size: var(--text-xl);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  .action-card__verb {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-top: 2px;
  }
  .action-card__meta {
    margin-top: var(--space-xs);
    font-size: calc(var(--text-sm) * 0.9);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .action-card--urgent {
    border-color: var(--color-status-fail);
    box-shadow: 4px 4px 0 var(--color-status-fail);
  }
  .action-card--urgent:hover {
    box-shadow: 5px 5px 0 var(--color-status-fail);
  }
  .action-card--urgent:active {
    box-shadow: 2px 2px 0 var(--color-status-fail);
  }
  .action-card--urgent .action-card__meta {
    color: var(--color-status-fail);
  }

  /* ── Two-column lower grid ── */
  .auspices-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }
  @media (max-width: 900px) {
    .auspices-grid {
      grid-template-columns: 1fr;
    }
  }
  .auspices-panel {
    min-width: 0;
  }

  /* ── Altar — brutalist card chrome ── */
  .altar {
    border: 2px solid var(--color-fg);
    box-shadow: 4px 4px 0 var(--color-fg);
    background: var(--color-surface);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-height: 160px;
  }
  .altar__loading,
  .altar__empty {
    color: var(--color-muted);
    font-style: italic;
    margin: auto;
  }
  .altar__media {
    margin: 0;
    display: flex;
    justify-content: center;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    padding: var(--space-xs);
  }
  .altar__audio-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    width: 100%;
  }
  .altar__audio-cover {
    width: 160px;
    height: 160px;
    object-fit: cover;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .altar__audio,
  .altar__video {
    width: 100%;
    max-width: 100%;
    display: block;
  }
  .altar__video {
    max-height: 360px;
    background: var(--color-surface-2);
  }
  .altar__image {
    max-height: 360px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
    display: block;
    border: 1px solid var(--color-border);
  }
  .altar__image-link {
    display: block;
    line-height: 0;
  }
  .altar__meta {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .altar__meta a {
    color: var(--color-muted);
    border-bottom: 1px dotted var(--color-muted);
    text-decoration: none;
  }
  .altar__actions {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }
  .altar__btn {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--space-xs) var(--space-sm);
    border: 2px solid var(--color-fg);
    box-shadow: 2px 2px 0 var(--color-fg);
    background: var(--color-bg);
    color: var(--color-fg);
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition:
      transform 60ms ease,
      box-shadow 60ms ease;
  }
  .altar__btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--color-fg);
  }
  .altar__btn:active {
    transform: translate(2px, 2px);
    box-shadow: 0 0 0 var(--color-fg);
  }
  .altar__btn--primary {
    background: var(--color-fg);
    color: var(--color-bg);
  }

  /* ── Quick links ── */
  .quick-links {
    border: 2px solid var(--color-fg);
    box-shadow: 4px 4px 0 var(--color-fg);
    background: var(--color-surface);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-height: 160px;
  }
  .quick-links__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .quick-links__btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: 2px solid var(--color-fg);
    box-shadow: 2px 2px 0 var(--color-fg);
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 60ms ease,
      box-shadow 60ms ease;
  }
  .quick-links__btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--color-fg);
  }
  .quick-links__btn:active {
    transform: translate(2px, 2px);
    box-shadow: 0 0 0 var(--color-fg);
  }
  .quick-links__btn--user {
    border-color: var(--color-accent);
    box-shadow: 2px 2px 0 var(--color-accent);
    color: var(--color-fg);
  }
  .quick-links__btn--user:hover {
    box-shadow: 3px 3px 0 var(--color-accent);
  }
  /* Pinned entry = a brutalist anchor (the full clickable pill) + a
     small remove button next to it. The two are visually one cluster
     so the remove button is in a tight inline-flex wrapper, not a
     separate row. */
  .quick-links__pinned-item {
    display: inline-flex;
    align-items: stretch;
    gap: 4px;
  }
  .quick-links__btn-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
    box-shadow: 2px 2px 0 var(--color-accent);
    color: var(--color-muted);
    cursor: pointer;
    padding: 0 6px;
    font-size: 0.9rem;
    line-height: 1;
    transition:
      transform 60ms ease,
      box-shadow 60ms ease,
      color 80ms;
  }
  .quick-links__btn-remove:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--color-status-fail);
    border-color: var(--color-status-fail);
    color: var(--color-status-fail);
  }
  .quick-links__btn-remove:active {
    transform: translate(2px, 2px);
    box-shadow: 0 0 0 var(--color-status-fail);
  }
  .quick-links__add {
    align-self: flex-start;
    margin-top: auto;
    padding: 4px 8px;
    border: 1px dashed var(--color-border);
    background: transparent;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    cursor: pointer;
  }
  .quick-links__add:hover {
    color: var(--color-fg);
    border-color: var(--color-fg);
  }

  /* Quick-link dialog (HTML <dialog>) */
  .quick-link-dialog {
    border: 2px solid var(--color-fg);
    box-shadow: 4px 4px 0 var(--color-fg);
    background: var(--color-bg);
    color: var(--color-fg);
    padding: var(--space-md);
    width: min(420px, 90vw);
    font-family: var(--font-mono);
  }
  .quick-link-dialog::backdrop {
    background: var(--color-overlay-soft);
  }
  .quick-link-dialog h3 {
    margin: 0 0 var(--space-sm) 0;
    font-size: var(--text-base);
    text-transform: uppercase;
    letter-spacing: 1pt;
  }
  .quick-link-dialog .form-row {
    margin-bottom: var(--space-sm);
  }
  .quick-link-dialog .form-group label {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    color: var(--color-muted);
    margin-bottom: 4px;
  }
  .quick-link-dialog .brutal-input {
    width: 100%;
  }
</style>

<script>
  type Stats = {
    releases: number;
    tracks: number;
    media_items: number;
    jobs: number;
  };
  type ActionQueue = {
    awaiting_nomenclature: number;
    fallen: number;
    midden_rotting: number;
    next_purge_at: string | null;
  };
  type AltarItem = {
    id: string;
    filename: string;
    media_type: 'audio' | 'video' | 'image';
    duration_seconds: number;
    uploader_name: string | null;
    source_channel: string | null;
    stream_url: string;
    cover_url: string;
  };

  document.addEventListener('astro:page-load', () => {
    const greeting = document.getElementById('auspices-greeting');
    if (!greeting) return;

    (async () => {
      const user = await (window as any).__authReady;
      if (user && greeting) {
        greeting.textContent = `Welcome back, ${user.name}. The omens are below.`;
      }
    })();

    fetchStats();
    fetchActionQueue();
    fetchAltar();
    renderQuickLinks();
    wireQuickLinks();

    const countdownTimer = window.setInterval(updateMiddenCountdown, 30000);

    document.addEventListener(
      'astro:before-swap',
      () => {
        window.clearInterval(countdownTimer);
      },
      { once: true },
    );
  });

  async function apiGet<T>(path: string): Promise<T | null> {
    try {
      const res = await fetch(path, { credentials: 'include' });
      if (!res.ok) return null;
      return (await res.json()) as T;
    } catch {
      return null;
    }
  }

  function setText(selector: string, value: string) {
    const el = document.querySelector(selector);
    if (el) el.textContent = value;
  }

  function fmtNum(n: number): string {
    return n.toLocaleString();
  }

  // ───────── Stats ─────────
  async function fetchStats() {
    const data = await apiGet<Stats>('/api/admin/stats');
    if (!data) return;
    setText('[data-stat="releases"]', fmtNum(data.releases));
    setText('[data-stat="tracks"]', fmtNum(data.tracks));
    setText('[data-stat="media_items"]', fmtNum(data.media_items));
    setText('[data-stat="jobs"]', fmtNum(data.jobs));
  }

  // ───────── Action queue ─────────
  let nextPurgeAt: string | null = null;

  async function fetchActionQueue() {
    const data = await apiGet<ActionQueue>('/api/admin/action-queue');
    if (!data) return;
    const row = document.getElementById('action-queue-row');
    const section = document.getElementById('action-queue');
    if (!row || !section) return;

    const cards: string[] = [];
    if (data.awaiting_nomenclature > 0) {
      cards.push(
        `<a class="action-card" href="/admin/search/nomenclator">
          <div class="action-card__num">${fmtNum(data.awaiting_nomenclature)}</div>
          <div class="action-card__verb">awaiting nomenclature</div>
          <div class="action-card__meta">untagged offerings</div>
        </a>`,
      );
    }
    if (data.fallen > 0) {
      cards.push(
        `<a class="action-card" href="/admin/search/failures">
          <div class="action-card__num">${fmtNum(data.fallen)}</div>
          <div class="action-card__verb">fallen</div>
          <div class="action-card__meta">unresolved failures</div>
        </a>`,
      );
    }
    if (data.midden_rotting > 0) {
      nextPurgeAt = data.next_purge_at;
      cards.push(
        `<a class="action-card" id="midden-card" href="/admin/search/midden">
          <div class="action-card__num">${fmtNum(data.midden_rotting)}</div>
          <div class="action-card__verb">rotting in The Midden</div>
          <div class="action-card__meta" id="midden-countdown">next purge —</div>
        </a>`,
      );
    }

    if (cards.length === 0) {
      section.style.display = 'none';
      return;
    }
    row.innerHTML = cards.join('');
    section.style.display = '';
    updateMiddenCountdown();
  }

  function updateMiddenCountdown() {
    if (!nextPurgeAt) return;
    const el = document.getElementById('midden-countdown');
    const card = document.getElementById('midden-card');
    if (!el || !card) return;
    const ms = new Date(nextPurgeAt).getTime() - Date.now();
    const { label, urgent } = formatRemaining(ms);
    el.textContent = `next purge in ${label}`;
    card.classList.toggle('action-card--urgent', urgent);
  }

  function formatRemaining(ms: number): { label: string; urgent: boolean } {
    if (ms <= 0) return { label: 'moments', urgent: true };
    const totalMins = Math.floor(ms / 60000);
    const hours = Math.floor(totalMins / 60);
    const mins = totalMins % 60;
    const urgent = totalMins < 60;
    if (hours > 0) return { label: `${hours}h ${mins}m`, urgent };
    if (mins > 0) return { label: `${mins}m`, urgent };
    const secs = Math.max(0, Math.floor(ms / 1000));
    return { label: `${secs}s`, urgent: true };
  }

  // ───────── Altar ─────────
  async function fetchAltar() {
    const el = document.getElementById('altar');
    if (!el) return;
    el.innerHTML = `<div class="altar__loading"><span class="loading-dots">Drawing lots</span></div>`;
    const data = await apiGet<{ item: AltarItem | null }>('/api/admin/altar');
    if (!data || !data.item) {
      el.innerHTML = `<div class="altar__empty">No playable offerings in the depot yet.</div>`;
      return;
    }
    renderAltar(data.item);
  }

  function renderAltar(item: AltarItem) {
    const el = document.getElementById('altar');
    if (!el) return;

    const bits: string[] = [];
    if (item.uploader_name) {
      bits.push(`offered by ${escapeHtml(item.uploader_name)}`);
    }
    if (item.source_channel) {
      bits.push(`from #${escapeHtml(item.source_channel)}`);
    }
    if (item.duration_seconds > 0) {
      bits.push(formatDuration(item.duration_seconds));
    }
    bits.push(escapeHtml(item.media_type));
    const meta = bits.join(' · ');
    const detailLink = `/admin/search/detail?id=${encodeURIComponent(item.id)}`;
    const mediaBlock = renderAltarMedia(item, detailLink);

    el.innerHTML = `
      ${mediaBlock}
      <div class="altar__meta">
        ${meta} · <a href="${detailLink}">details</a>
      </div>
      <div class="altar__actions">
        <button class="altar__btn altar__btn--primary" data-altar-play>
          ▶ Consecrate to queue
        </button>
        <a class="altar__btn" href="${detailLink}">Open</a>
      </div>
    `;

    const playBtn = el.querySelector('[data-altar-play]');
    playBtn?.addEventListener('click', () => queueAltar(item));
  }

  function renderAltarMedia(item: AltarItem, detailLink: string): string {
    const stream = escapeAttr(item.stream_url);
    const cover = escapeAttr(item.cover_url);
    const alt = escapeAttr(item.filename);

    if (item.media_type === 'image') {
      return `
        <figure class="altar__media">
          <a class="altar__image-link" href="${escapeAttr(detailLink)}">
            <img class="altar__image" src="${cover}" alt="${alt}" loading="lazy" />
          </a>
        </figure>
      `;
    }

    if (item.media_type === 'video') {
      return `
        <figure class="altar__media">
          <video
            class="altar__video"
            controls
            preload="metadata"
            poster="${cover}"
            src="${stream}"
          ></video>
        </figure>
      `;
    }

    // audio
    return `
      <figure class="altar__media">
        <div class="altar__audio-wrap">
          <img class="altar__audio-cover" src="${cover}" alt="" loading="lazy"
            onerror="this.style.display='none';" />
          <audio class="altar__audio" controls preload="metadata" src="${stream}"></audio>
        </div>
      </figure>
    `;
  }

  function queueAltar(item: AltarItem) {
    document.dispatchEvent(
      new CustomEvent('player:queue', {
        detail: {
          tracks: [
            {
              track_id: item.id,
              title: item.filename,
              release_title: '',
              release_code: '',
              media_type: item.media_type,
              stream_url: item.stream_url,
              cover_url: item.cover_url,
              duration: item.duration_seconds,
              entity_name: item.uploader_name || '',
            },
          ],
          startIndex: 0,
        },
      }),
    );
  }

  // ───────── Quick Links ─────────
  // localStorage-only by design (the user explicitly didn't want a new
  // API surface). User-pinned set lives under `au.dashboardLinks`.
  const BUILTIN_LINKS: Array<{ label: string; href: string }> = [
    { label: 'Random search', href: '/admin/search?sort=random' },
    { label: 'Latest tributes', href: '/admin/search?sort=newest' },
    { label: 'Triage failures', href: '/admin/search/failures' },
    { label: 'Tag triage', href: '/admin/search/nomenclator' },
    { label: 'The Queue', href: '/admin/jobs' },
    { label: 'Hecatomb', href: '/admin/hecatomb' },
    { label: 'Latents in progress', href: '/admin/latents' },
  ];
  const LS_KEY = 'au.dashboardLinks';

  type UserLink = { label: string; href: string };

  function readUserLinks(): UserLink[] {
    try {
      const raw = localStorage.getItem(LS_KEY);
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];
      return parsed.filter(
        (l): l is UserLink =>
          l &&
          typeof l === 'object' &&
          typeof l.label === 'string' &&
          typeof l.href === 'string' &&
          // Only allow same-origin or path-relative — keeps a stray
          // localStorage value from rendering as a click-through to
          // anywhere weird.
          (l.href.startsWith('/') || l.href.startsWith(window.location.origin)),
      );
    } catch {
      return [];
    }
  }
  function writeUserLinks(links: UserLink[]) {
    try {
      localStorage.setItem(LS_KEY, JSON.stringify(links));
    } catch {}
  }

  function renderQuickLinks() {
    const builtin = document.getElementById('quick-links-builtin');
    const pinned = document.getElementById('quick-links-pinned');
    if (!builtin || !pinned) return;
    builtin.innerHTML = BUILTIN_LINKS.map(
      (l) =>
        `<a class="quick-links__btn" href="${escapeAttr(l.href)}">${escapeHtml(l.label)}</a>`,
    ).join('');
    const user = readUserLinks();
    // Each pinned entry is a brutalist <a> wearing the full button
    // chrome (so the entire visible pill is clickable for navigation),
    // followed by a separate remove <button>. Wrapping them in a span
    // means only the inner text was a navigation target — clicking the
    // pill's chrome did nothing, which is the bug.
    pinned.innerHTML = user
      .map(
        (l, idx) => `
        <span class="quick-links__pinned-item">
          <a
            class="quick-links__btn quick-links__btn--user"
            href="${escapeAttr(l.href)}"
          >${escapeHtml(l.label)}</a>
          <button
            class="quick-links__btn-remove"
            type="button"
            data-remove-idx="${idx}"
            aria-label="Remove pinned link"
            title="Remove pinned link"
          >×</button>
        </span>`,
      )
      .join('');
    pinned
      .querySelectorAll<HTMLButtonElement>('[data-remove-idx]')
      .forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const idx = parseInt(btn.dataset.removeIdx!, 10);
          if (!Number.isFinite(idx)) return;
          const current = readUserLinks();
          current.splice(idx, 1);
          writeUserLinks(current);
          renderQuickLinks();
        });
      });
  }

  function wireQuickLinks() {
    const addBtn = document.getElementById(
      'quick-links-add',
    ) as HTMLButtonElement | null;
    const dialog = document.getElementById(
      'quick-link-dialog',
    ) as HTMLDialogElement | null;
    if (!addBtn || !dialog) return;
    const labelInput = document.getElementById(
      'quick-link-label',
    ) as HTMLInputElement;
    const hrefInput = document.getElementById(
      'quick-link-href',
    ) as HTMLInputElement;
    const cancelBtn = document.getElementById(
      'quick-link-cancel',
    ) as HTMLButtonElement;
    const form = dialog.querySelector('form') as HTMLFormElement | null;
    if (!form) return;

    addBtn.addEventListener('click', () => {
      labelInput.value = '';
      hrefInput.value = '';
      // showModal() throws if called on an already-open dialog (eg. a
      // double-click), which would otherwise surface as "dialog stays
      // shut" because the exception aborts the rest of this handler.
      if (dialog.open) return;
      dialog.showModal();
      labelInput.focus();
    });
    cancelBtn.addEventListener('click', (e) => {
      e.preventDefault();
      dialog.close();
    });

    // The form has method="dialog", which closes the dialog on submit.
    // Doing the save in the `close` handler (and inferring "user cancelled
    // vs. submitted" from dialog.returnValue) was too fragile — Escape
    // and the form-validation path both fired close without us asking,
    // and the submit-button had no `value` attribute so returnValue
    // collisions with the cancel path were easy. Listening to submit
    // directly is unambiguous: only the Pin button gets us here.
    form.addEventListener('submit', (e) => {
      const label = labelInput.value.trim();
      const href = hrefInput.value.trim();
      if (!label || !href) return; // browser will surface the required-field UI
      // Restrict to same-origin / path-relative so a stray pin from
      // localStorage can't render as a phishy click-through.
      if (!(href.startsWith('/') || href.startsWith(window.location.origin))) {
        e.preventDefault();
        (window as any).toast?.error?.(
          'Pinned URLs must be paths (e.g. /admin/search) or same-origin.',
        );
        return;
      }
      const current = readUserLinks();
      current.push({ label, href });
      writeUserLinks(current);
      renderQuickLinks();
      // method="dialog" closes the dialog after this returns.
    });
  }

  // ───────── Helpers ─────────
  function relTime(iso: string): string {
    const t = new Date(iso).getTime();
    if (Number.isNaN(t)) return '';
    const diff = Math.max(0, Date.now() - t);
    const s = Math.floor(diff / 1000);
    if (s < 60) return `${s}s ago`;
    const m = Math.floor(s / 60);
    if (m < 60) return `${m}m ago`;
    const h = Math.floor(m / 60);
    if (h < 24) return `${h}h ago`;
    const d = Math.floor(h / 24);
    if (d < 30) return `${d}d ago`;
    const mo = Math.floor(d / 30);
    if (mo < 12) return `${mo}mo ago`;
    const y = Math.floor(d / 365);
    return `${y}y ago`;
  }

  function formatDuration(seconds: number): string {
    const s = Math.max(0, Math.floor(seconds));
    const mm = Math.floor(s / 60);
    const ss = s % 60;
    return `${mm}:${ss.toString().padStart(2, '0')}`;
  }

  function escapeHtml(raw: string): string {
    return raw.replace(
      /[&<>"']/g,
      (c) =>
        ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        })[c]!,
    );
  }

  function escapeAttr(raw: string): string {
    return escapeHtml(raw);
  }
</script>
