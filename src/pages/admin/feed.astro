---
import Admin from '../../layouts/Admin.astro';
---

<Admin title="Feed" current="feed">
  <div class="page-header">
    <h1>Feed</h1>
    <p class="page-subtitle">output feed</p>
  </div>

  <div class="ru-feed" id="ru-feed">
    <div id="ru-sentinel" style="height:1px"></div>
    <div class="ru-loading" id="ru-loading">Loading…</div>
  </div>

  <!-- Shared emoji picker (one instance, shared across all cards) -->
  <div id="ru-epicker" class="ru-epicker" style="display:none">
    <div class="ru-epicker__top">
      <div class="ru-epicker__cats" id="ru-epicker-cats"></div>
      <input class="ru-epicker__search" id="ru-epicker-search" type="text" placeholder="Search…" autocomplete="off" />
    </div>
    <div class="ru-epicker__grid" id="ru-epicker-grid"></div>
  </div>
  <div id="ru-epicker-backdrop" class="ru-epicker-backdrop" style="display:none"></div>

  <div id="ru-lightbox" class="ru-lightbox" style="display:none" role="dialog" aria-modal="true">
    <img id="ru-lightbox-img" src="" alt="" />
  </div>

  <style>
    .ru-feed {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      max-width: 680px;
      padding-bottom: 2rem;
    }

    /* ── Card ── */
    .ru-card {
      border: 1px solid var(--border, #2a2a2a);
      border-radius: 6px;
      overflow: hidden;
    }
    .ru-card__media {
      background: #0a0a0a;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 120px;
      max-height: 480px;
      overflow: hidden;
    }
    .ru-card__media img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 480px;
      object-fit: contain;
      cursor: zoom-in;
    }
    .ru-card__audio-placeholder {
      padding: 2rem;
      font-size: 2rem;
      opacity: 0.2;
    }
    .ru-card__body { padding: 0.75rem 1rem 0.6rem; }
    .ru-card__meta {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 0.4rem;
    }
    .ru-card__filename {
      font-size: 0.8rem;
      font-weight: 500;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 260px;
    }
    .ru-card__dot { opacity: 0.3; font-size: 0.7rem; }
    .ru-card__author { font-size: 0.75rem; opacity: 0.6; }
    .ru-card__time   { font-size: 0.7rem;  opacity: 0.4; }
    .ru-card__tags {
      display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 0.6rem;
    }
    .ru-tag {
      font-size: 0.6rem; padding: 0.1rem 0.4rem;
      border: 1px solid var(--border, #333); border-radius: 2px; opacity: 0.5;
    }

    /* ── Reactions ── */
    .ru-reactions {
      display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap;
      margin-bottom: 0.5rem;
    }
    .ru-react-btn {
      display: inline-flex; align-items: center; gap: 0.2rem;
      font-size: 0.85rem; padding: 0.15rem 0.45rem;
      border: 1px solid var(--border, #333); border-radius: 3px;
      background: transparent; color: inherit; cursor: pointer;
      transition: border-color 0.1s, background 0.1s;
    }
    .ru-react-btn:hover { border-color: var(--accent, #888); }
    .ru-react-btn--mine { border-color: var(--accent, #888); background: rgba(255,255,255,0.06); }
    .ru-react-count { font-size: 0.7rem; }
    .ru-react-add {
      font-size: 0.78rem; padding: 0.15rem 0.4rem;
      border: 1px dashed var(--border, #444); border-radius: 3px;
      background: transparent; color: inherit; cursor: pointer; opacity: 0.5;
      transition: opacity 0.1s;
    }
    .ru-react-add:hover { opacity: 1; }

    /* ── Emoji picker ── */
    .ru-epicker-backdrop {
      position: fixed; inset: 0; z-index: 490;
    }
    .ru-epicker {
      position: fixed; z-index: 500;
      top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: min(336px, 96vw);
      background: var(--bg, #111); border: 1px solid var(--border, #333);
      border-radius: 8px; overflow: hidden;
      display: flex; flex-direction: column;
      box-shadow: 0 8px 32px rgba(0,0,0,0.6);
    }
    .ru-epicker__top {
      display: flex; flex-direction: column; gap: 0;
      border-bottom: 1px solid var(--border, #2a2a2a);
    }
    .ru-epicker__cats {
      display: flex; overflow-x: auto; padding: 0.25rem 0.25rem 0;
      gap: 0.1rem;
      scrollbar-width: none;
    }
    .ru-epicker__cats::-webkit-scrollbar { display: none; }
    .ru-epicker__cat-btn {
      flex-shrink: 0; font-size: 1.1rem; padding: 0.25rem 0.4rem;
      background: none; border: none; cursor: pointer; border-radius: 4px;
      opacity: 0.5; transition: opacity 0.1s, background 0.1s;
    }
    .ru-epicker__cat-btn:hover { opacity: 0.9; background: rgba(255,255,255,0.06); }
    .ru-epicker__cat-btn--active { opacity: 1; background: rgba(255,255,255,0.1); }
    .ru-epicker__search {
      margin: 0.3rem 0.4rem; padding: 0.3rem 0.5rem;
      background: var(--bg2, #1a1a1a); border: 1px solid var(--border, #333);
      border-radius: 4px; color: inherit; font-size: 0.78rem; font-family: inherit;
    }
    .ru-epicker__search:focus { outline: none; border-color: var(--accent, #666); }
    .ru-epicker__grid {
      display: grid; grid-template-columns: repeat(9, 1fr);
      overflow-y: auto; max-height: 280px; padding: 0.25rem;
      gap: 1px;
    }
    .ru-epicker__emoji {
      font-size: 1.25rem; text-align: center; padding: 0.2rem;
      cursor: pointer; border-radius: 4px; border: none; background: none;
      transition: background 0.1s;
      line-height: 1.4;
    }
    .ru-epicker__emoji:hover { background: rgba(255,255,255,0.1); }
    .ru-epicker__emoji--mine { background: rgba(255,255,255,0.08); }

    /* ── Comments ── */
    .ru-comments-toggle {
      font-size: 0.7rem; background: none; border: none; color: inherit;
      cursor: pointer; opacity: 0.5; padding: 0; transition: opacity 0.1s;
      display: block; margin-bottom: 0.45rem;
    }
    .ru-comments-toggle:hover { opacity: 0.9; }
    .ru-comments {
      border-top: 1px solid var(--border, #222);
      padding: 0.75rem 1rem;
      display: flex; flex-direction: column; gap: 0.6rem;
    }
    .ru-comment { display: flex; flex-direction: column; gap: 0.2rem; }
    .ru-comment__header {
      display: flex; align-items: baseline; gap: 0.4rem;
    }
    .ru-comment__author { font-size: 0.72rem; font-weight: 500; }
    .ru-comment__time   { font-size: 0.65rem; opacity: 0.4; }
    .ru-comment__text   { font-size: 0.78rem; opacity: 0.85; line-height: 1.45; }
    .ru-comment__actions { display: flex; gap: 0.6rem; }
    .ru-comment__action-btn {
      font-size: 0.65rem; opacity: 0.4; background: none; border: none;
      color: inherit; cursor: pointer; padding: 0; transition: opacity 0.1s;
    }
    .ru-comment__action-btn:hover { opacity: 0.85; }
    .ru-replies {
      padding-left: 1rem; border-left: 1px solid var(--border, #2a2a2a);
      margin-top: 0.4rem; display: flex; flex-direction: column; gap: 0.5rem;
    }
    .ru-compose {
      display: flex; gap: 0.5rem; align-items: flex-end;
    }
    .ru-compose-input {
      flex: 1; font-size: 0.78rem; padding: 0.35rem 0.5rem;
      background: var(--bg2, #1a1a1a); border: 1px solid var(--border, #333);
      color: inherit; border-radius: 3px; resize: none; min-height: 34px;
      font-family: inherit;
    }
    .ru-compose-input:focus { outline: none; border-color: var(--accent, #666); }
    .ru-compose-send {
      font-size: 0.72rem; padding: 0.35rem 0.6rem;
      background: none; border: 1px solid var(--border, #444); border-radius: 3px;
      color: inherit; cursor: pointer; white-space: nowrap;
      transition: border-color 0.1s;
    }
    .ru-compose-send:hover { border-color: var(--accent, #888); }
    .ru-compose-send:disabled { opacity: 0.4; cursor: default; }

    /* ── Loading / end states ── */
    .ru-loading, .ru-end {
      text-align: center; padding: 2rem; font-size: 0.75rem; opacity: 0.35;
    }

    /* ── Lightbox ── */
    .ru-lightbox {
      position: fixed; inset: 0; z-index: 1000;
      background: rgba(0,0,0,0.92);
      display: flex; align-items: center; justify-content: center;
      cursor: zoom-out;
    }
    .ru-lightbox img {
      max-width: 95vw; max-height: 95vh;
      object-fit: contain; border-radius: 2px;
      cursor: default;
    }
  </style>

  <script>
    // ─── State ────────────────────────────────────────────────────────────────
    let currentPage = 1;
    let isLoading = false;
    let exhausted = false;
    let newestCreatedAt: string | null = null;
    const PER_PAGE = 20;

    // ─── Emoji data (categorised) ─────────────────────────────────────────────
    const EMOJI_CATS: { icon: string; label: string; emoji: string[] }[] = [
      { icon: '😀', label: 'Smileys', emoji: '😀 😃 😄 😁 😆 😅 🤣 😂 🙂 🙃 😉 😊 😇 🥰 😍 🤩 😘 😗 ☺ 😚 😙 🥲 😋 😛 😜 🤪 😝 🤑 🤗 🤭 🤫 🤔 🤐 🤨 😐 😑 😶 😶‍🌫️ 😏 😒 🙄 😬 🤥 😌 😔 😪 🤤 😴 😷 🤒 🤕 🤢 🤮 🤧 🥵 🥶 🥴 😵 😵‍💫 🤯 🤠 🥳 🥸 😎 🤓 🧐 😕 😟 🙁 ☹ 😮 😯 😲 😳 🥺 🥹 😦 😧 😨 😰 😥 😢 😭 😱 😖 😣 😞 😓 😩 😫 🥱 😤 😡 😠 🤬 😈 👿 💀 ☠ 💩 🤡 👹 👺 👻 👽 👾 🤖 😺 😸 😹 😻 😼 😽 🙀 😿 😾'.split(' ') },
      { icon: '🧑', label: 'People', emoji: '👋 🤚 🖐 ✋ 🖖 🫱 🫲 🫳 🫴 🫷 🫸 👌 🤌 🤏 ✌ 🤞 🫰 🤟 🤘 🤙 👈 👉 👆 🖕 👇 ☝ 🫵 👍 👎 ✊ 👊 🤛 🤜 👏 🙌 🫶 🤲 🤝 🙏 💅 🤳 💪 🦾 🦿 🦵 🦶 👂 🦻 👃 🫀 🫁 🧠 🦷 🦴 👀 👁 👅 🫦 💋 👶 🧒 👦 👧 🧑 👱 👨 🧔 🧔‍♂ 🧔‍♀ 👩 👴 👵 🧓 👮 👷 💂 🕵 🧑‍⚕ 👩‍⚕ 👨‍⚕ 🧑‍🌾 👩‍🌾 👨‍🌾 🧑‍🍳 👩‍🍳 👨‍🍳 🧑‍🎓 👩‍🎓 👨‍🎓 🧑‍🎤 👩‍🎤 👨‍🎤 🧑‍🏫 👩‍🏫 👨‍🏫 🧑‍🏭 👩‍🏭 👨‍🏭 🧑‍💻 👩‍💻 👨‍💻 🧑‍💼 👩‍💼 👨‍💼 🧑‍🔧 👩‍🔧 👨‍🔧 🧑‍🔬 👩‍🔬 👨‍🔬 🧑‍🎨 👩‍🎨 👨‍🎨 🧑‍🚒 👩‍🚒 👨‍🚒 🧑‍✈ 👩‍✈ 👨‍✈ 🧑‍🚀 👩‍🚀 👨‍🚀 🧑‍⚖ 👩‍⚖ 👨‍⚖ 🫅 🤴 👸 🤵 👰 🤰 🫃 🫄 🧙 🧝 🧛 🧟 🧌 🧞 🧜 🧚 🙋 🙍 🙎 🙅 🙆 💁 🤷 🤦 🧖 💆 💇 🛀 🧑‍🤝‍🧑 👫 👬 👭 💑 💏 👪 🗣 👤 👥'.split(' ') },
      { icon: '🐶', label: 'Animals', emoji: '🐶 🐱 🐭 🐹 🐰 🦊 🐻 🐼 🐻‍❄️ 🐨 🐯 🦁 🐮 🐷 🐽 🐸 🐵 🙈 🙉 🙊 🐒 🦆 🐔 🐧 🐦 🐤 🦅 🦉 🦇 🐺 🐗 🐴 🦄 🐝 🪱 🐛 🦋 🐌 🐞 🐜 🪲 🦟 🦗 🪳 🦂 🐢 🐍 🦎 🦖 🦕 🐙 🦑 🦐 🦞 🦀 🦈 🐡 🐠 🐟 🐬 🐳 🐋 🦭 🐊 🐅 🐆 🦓 🦍 🦧 🦣 🐘 🦛 🦏 🐪 🐫 🦒 🦘 🦬 🐃 🐂 🐄 🐎 🐖 🐏 🐑 🦙 🐐 🦌 🐕 🐩 🦮 🐕‍🦺 🐈 🐈‍⬛ 🐓 🦃 🦤 🦚 🦜 🦢 🦩 🕊 🐇 🦝 🦨 🦡 🦦 🦥 🐁 🐀 🐿 🦔 🌵 🌲 🌳 🌴 🌱 🌿 ☘ 🍀 🎍 🪴 🎋 🍃 🍂 🍁 🍄 🌾 💐 🌷 🌹 🥀 🌺 🌸 🌼 🌻 🌞 🪸 🪨 🪵'.split(' ') },
      { icon: '🍔', label: 'Food', emoji: '🍇 🍈 🍉 🍊 🍋 🍌 🍍 🥭 🍎 🍏 🍐 🍑 🍒 🍓 🫐 🥝 🍅 🫒 🥥 🥑 🍆 🥦 🥬 🥒 🌶 🫑 🧄 🧅 🥔 🍠 🫘 🌰 🥜 🍞 🥐 🧀 🥚 🍳 🥞 🧇 🥓 🥩 🍗 🍖 🌭 🍔 🍟 🍕 🫓 🌮 🌯 🫔 🧆 🧈 🥗 🥘 🫕 🍲 🍛 🍜 🍝 🍣 🍱 🥟 🦪 🍤 🍙 🍚 🍘 🍥 🥮 🍡 🧁 🍰 🎂 🍮 🍭 🍬 🍫 🍿 🍩 🍪 🍯 🧃 🥤 🧋 ☕ 🍵 🫖 🍺 🍻 🥂 🍷 🥃 🫗 🍸 🍹 🧉 🍾 🧊 🥄 🍴 🍽 🥢 🧂'.split(' ') },
      { icon: '🏠', label: 'Travel', emoji: '🌍 🌎 🌏 🌐 🗺 🧭 🏔 ⛰ 🌋 🏕 🏖 🏜 🏝 🏞 🏟 🏛 🏗 🧱 🛖 🏘 🏚 🏠 🏡 🏢 🏣 🏤 🏥 🏦 🏨 🏩 🏪 🏫 🏬 🏭 🏯 🏰 💒 🗼 🗽 ⛪ 🕌 🛕 🕍 ⛩ 🕋 ⛲ ⛺ 🌁 🌃 🏙 🌄 🌅 🌆 🌇 🌉 🌌 🌠 🎇 🎆 🌈 🚂 🚃 🚄 🚅 🚆 🚇 🚈 🚉 🚊 🚞 🚝 🚋 🚌 🚍 🚎 🏎 🚐 🚑 🚒 🚓 🚕 🚗 🚙 🛻 🚚 🚛 🚜 🏍 🛵 🛺 🚲 🛴 🛹 🛼 🚁 🛸 🚀 🛶 ⛵ 🚤 🛥 🛳 ⛴ 🚢 ✈ 🛩 🪂 🚁 🚠 🚡 🛰 🚧 ⛽ ⚓ 🚏 🗺 🛣 🛤'.split(' ') },
      { icon: '⚽', label: 'Activities', emoji: '⚽ 🏀 🏈 ⚾ 🥎 🎾 🏐 🏉 🥏 🎱 🏓 🏸 🏒 🏑 🥍 🏏 🪃 🥅 ⛳ 🪁 🏹 🎣 🤿 🥊 🥋 🎽 🛹 🛼 🛷 ⛸ 🥌 🎿 ⛷ 🏂 🪂 🏋 🤼 🤸 ⛹ 🤺 🤾 🏌 🏇 🧘 🏄 🏊 🤽 🚵 🧗 🤸 🎖 🏆 🥇 🥈 🥉 🏅 🎗 🎫 🎟 🎪 🤹 🎭 🩰 🎨 🎬 🎤 🎧 🎼 🎹 🪘 🥁 🪗 🎷 🎺 🎸 🪕 🎻 🎲 ♟ 🎯 🎳 🎮 🎰 🧩 🪀 🪁 🪅 🪆 🖼 🎭 🎪'.split(' ') },
