    ];

    const feed = document.getElementById('ru-feed')!;
    const loadingEl = document.getElementById('ru-loading')!;
    const sentinel = document.getElementById('ru-sentinel')!;

    // ─── Skeleton ─────────────────────────────────────────────────────────────
    let skeletons: HTMLElement[] = [];

    function buildSkeleton(): HTMLElement {
      const s = document.createElement('div');
      s.className = 'ru-skeleton';
      s.innerHTML = `<div class="ru-skel__avatar"></div>
        <div class="ru-skel__body">
          <div class="ru-skel__line ru-skel__line--header"></div>
          <div class="ru-skel__image"></div>
          <div class="ru-skel__line ru-skel__line--footer"></div>
        </div>`;
      return s;
    }

    function showSkeletons() {
      for (let i = 0; i < 4; i++) {
        const s = buildSkeleton();
        feed.appendChild(s);
        skeletons.push(s);
      }
    }

    function removeSkeletons() {
      for (const s of skeletons) s.remove();
      skeletons = [];
    }

    // ─── Time formatting ──────────────────────────────────────────────────────
    function timeAgo(iso: string): string {
      const diff = Date.now() - new Date(iso).getTime();
      const s = Math.floor(diff / 1000);
      if (s < 60) return `${s}s`;
      const m = Math.floor(s / 60);
      if (m < 60) return `${m}m`;
      const h = Math.floor(m / 60);
      if (h < 24) return `${h}h`;
      const d = Math.floor(h / 24);
      if (d < 30) return `${d}d`;
      return new Date(iso).toLocaleDateString();
    }

    // ─── Creator name ─────────────────────────────────────────────────────────
    function getCreatorName(item: any): string {
      for (const src of item.sources ?? []) {
        if (src.uploader_name) return src.uploader_name;
        if (src.source_metadata) {
          try {
            const m = JSON.parse(src.source_metadata);
            if (m.poster) return m.poster;
          } catch {}
        }
      }
      return 'unknown';
    }

    // ─── Avatar helpers ───────────────────────────────────────────────────────
    function authorColor(name: string): string {
      if (name === 'unknown') return '#2a2a2a';
      let h = 0;
      for (const c of name) h = (h * 31 + c.charCodeAt(0)) & 0xffffff;
      return `hsl(${h % 360}, 28%, 38%)`;
    }

    function authorInitials(name: string): string {
      if (name === 'unknown') return '?';
      const parts = name.trim().split(/\s+/);
      if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
      return name.slice(0, 2).toUpperCase();
    }

    // ─── Date separator ───────────────────────────────────────────────────────
    function buildDateSep(iso: string): HTMLElement {
      const d = new Date(iso);
      const sep = document.createElement('div');
      sep.className = 'ru-date-sep';
      sep.textContent = d.toLocaleDateString('en-US', {
        weekday: 'long', month: 'long', day: 'numeric',
      });
      return sep;
    }

    // ─── Lightbox ─────────────────────────────────────────────────────────────
    const lightbox = document.getElementById('ru-lightbox') as HTMLElement;
    const lightboxImg = document.getElementById('ru-lightbox-img') as HTMLImageElement;

    function openLightbox(url: string) {
      lightboxImg.src = url;
      lightbox.style.display = 'flex';
    }
    function closeLightbox() {
      lightbox.style.display = 'none';
      lightboxImg.src = '';
    }
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox.style.display !== 'none') {
        e.stopPropagation();
        closeLightbox();
      }
    });

    // ─── Inline audio player ──────────────────────────────────────────────────
    function fmtTime(s: number): string {
      if (!isFinite(s)) return '0:00';
      return Math.floor(s / 60) + ':' + String(Math.floor(s % 60)).padStart(2, '0');
    }

    function buildAudioPlayer(item: any): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'ru-audio';

      const bar = document.createElement('div');
      bar.className = 'ru-audio__bar';

      const playBtn = document.createElement('button');
      playBtn.className = 'ru-audio__play';
      playBtn.textContent = '▶';
      playBtn.title = 'Play';

      const scrubWrap = document.createElement('div');
      scrubWrap.className = 'ru-audio__scrub-wrap';

      const scrub = document.createElement('input');
      scrub.type = 'range';
      scrub.className = 'ru-audio__scrub';
      scrub.min = '0';
      scrub.max = '100';
      scrub.value = '0';
      scrub.step = '0.1';

      const times = document.createElement('div');
      times.className = 'ru-audio__times';
      const curEl = document.createElement('span');
      curEl.className = 'ru-audio__cur';
      curEl.textContent = '0:00';
      const durEl = document.createElement('span');
      durEl.className = 'ru-audio__dur';
      durEl.textContent = item.audio_meta?.duration_seconds
        ? fmtTime(item.audio_meta.duration_seconds)
        : '';
      times.appendChild(curEl);
      times.appendChild(durEl);

      scrubWrap.appendChild(scrub);
      scrubWrap.appendChild(times);
      bar.appendChild(playBtn);
      bar.appendChild(scrubWrap);
      wrap.appendChild(bar);

      const audio = new Audio();
      audio.preload = 'none';

      playBtn.addEventListener('click', () => {
        if (!audio.src) {
          audio.src = `/api/media/${item.id}/file`;
        }
        if (audio.paused) {
          audio.play();
          playBtn.textContent = '⏸';
          playBtn.title = 'Pause';
        } else {
          audio.pause();
          playBtn.textContent = '▶';
          playBtn.title = 'Play';
        }
      });

      audio.ontimeupdate = () => {
        if (audio.duration) {
          scrub.value = String((audio.currentTime / audio.duration) * 100);
          curEl.textContent = fmtTime(audio.currentTime);
        }
      };

      audio.onloadedmetadata = () => {
        if (!item.audio_meta?.duration_seconds) {
          durEl.textContent = fmtTime(audio.duration);
        }
      };

      audio.onended = () => {
        playBtn.textContent = '▶';
        playBtn.title = 'Play';
        scrub.value = '0';
        curEl.textContent = '0:00';
      };

      scrub.addEventListener('input', () => {
        if (audio.duration) {
          audio.currentTime = (Number(scrub.value) / 100) * audio.duration;
        }
      });

      return wrap;
    }

    // ─── Build a post ─────────────────────────────────────────────────────────
    function buildPost(item: any): HTMLElement {
      const creator = getCreatorName(item);
      const createdAt = item.sources?.[0]?.created_at ?? item.created_at;

      const post = document.createElement('div');
      post.className = 'ru-post';
      post.dataset.id = item.id;

      // Avatar
      const avatar = document.createElement('div');
      avatar.className = 'ru-post__avatar';
      avatar.style.background = authorColor(creator);
      avatar.textContent = authorInitials(creator);
      post.appendChild(avatar);

      // Body
      const body = document.createElement('div');
      body.className = 'ru-post__body';

      // Header: author | filename + tags | time
      const header = document.createElement('div');
      header.className = 'ru-post__header';

      const authorEl = document.createElement('span');
      authorEl.className = 'ru-post__author';
      authorEl.textContent = creator === 'unknown' ? '—' : creator;
      header.appendChild(authorEl);

      const metaEl = document.createElement('div');
      metaEl.className = 'ru-post__meta';
      const fname = document.createElement('span');
      fname.className = 'ru-post__filename';
      fname.textContent = item.filename ?? item.id;
      fname.title = item.filename ?? '';
      metaEl.appendChild(fname);

      const tags: string[] = item.tags ?? [];
      for (const t of tags.slice(0, 3)) {
        const dot = document.createElement('span');
        dot.className = 'ru-post__tag-dot';
        dot.textContent = '·';
        const tag = document.createElement('span');
        tag.className = 'ru-post__tag';
        tag.textContent = t;
        metaEl.appendChild(dot);
        metaEl.appendChild(tag);
      }
      header.appendChild(metaEl);

      if (createdAt) {
        const time = document.createElement('span');
        time.className = 'ru-post__time';
        time.textContent = timeAgo(createdAt);
        time.title = new Date(createdAt).toLocaleString();
        header.appendChild(time);
      }
      body.appendChild(header);

      // Media
      const mediaWrap = document.createElement('div');
      mediaWrap.className = 'ru-post__media';
      if (item.media_type === 'image') {
        const img = document.createElement('img');
        img.src = `/api/media/${item.id}/thumbnail`;
        img.alt = item.filename ?? '';
        img.loading = 'lazy';
        img.addEventListener('click', () => openLightbox(`/api/media/${item.id}/file`));
        mediaWrap.appendChild(img);
      } else if (item.media_type === 'audio') {
        mediaWrap.appendChild(buildAudioPlayer(item));
      } else {
        const icon = document.createElement('div');
        icon.style.cssText = 'padding:2rem;font-size:2rem;opacity:0.18;';
        icon.textContent = '▶';
        mediaWrap.appendChild(icon);
      }
      body.appendChild(mediaWrap);

      // Footer: reactions + action bar
      const footer = document.createElement('div');
      footer.className = 'ru-post__footer';
      const reactRow = buildReactRow(item.id);
      footer.appendChild(reactRow);
      const { actionsRow, threadBtn } = buildActionsRow(item, post, reactRow);
      footer.appendChild(actionsRow);
      body.appendChild(footer);

      post.appendChild(body);

      // Load comment count async
      loadCommentCount(item.id, threadBtn);

      return post;
    }

    // ─── Emoji picker ─────────────────────────────────────────────────────────
    const epicker = document.getElementById('ru-epicker') as HTMLElement;
    const epickerGrid = document.getElementById('ru-epicker-grid') as HTMLElement;
    const epickerCats = document.getElementById('ru-epicker-cats') as HTMLElement;
    const epickerSearch = document.getElementById('ru-epicker-search') as HTMLInputElement;
    const epickerBackdrop = document.getElementById('ru-epicker-backdrop') as HTMLElement;

    let epickerCallback: ((emoji: string) => void) | null = null;
    let epickerMine: string[] = [];
    let epickerActiveCat = 0;

    EMOJI_CATS.forEach((cat, i) => {
      const btn = document.createElement('button');
      btn.className = 'ru-epicker__cat-btn' + (i === 0 ? ' ru-epicker__cat-btn--active' : '');
      btn.textContent = cat.icon;
      btn.title = cat.label;
      btn.addEventListener('click', () => {
        epickerSearch.value = '';
        setEpickerCat(i);
      });
      epickerCats.appendChild(btn);
    });

    function setEpickerCat(i: number) {
      epickerActiveCat = i;
      epickerCats
        .querySelectorAll('.ru-epicker__cat-btn')
        .forEach((b, idx) => b.classList.toggle('ru-epicker__cat-btn--active', idx === i));
      renderEpickerGrid(EMOJI_CATS[i].emoji);
    }

    function renderEpickerGrid(emoji: string[]) {
      epickerGrid.innerHTML = '';
      for (const e of emoji) {
        if (!e.trim()) continue;
        const btn = document.createElement('button');
        btn.className =
          'ru-epicker__emoji' + (epickerMine.includes(e) ? ' ru-epicker__emoji--mine' : '');
        btn.textContent = e;
        btn.addEventListener('click', () => {
          epickerCallback?.(e);
          closeEpicker();
        });
        epickerGrid.appendChild(btn);
      }
    }

    epickerSearch.addEventListener('input', () => {
      const q = epickerSearch.value.trim().toLowerCase();
      if (!q) { setEpickerCat(epickerActiveCat); return; }
      const matched: string[] = [];
      for (const cat of EMOJI_CATS) {
        if (cat.label.toLowerCase().includes(q)) matched.push(...cat.emoji);
      }
      renderEpickerGrid(matched.length > 0 ? matched : EMOJI_CATS.flatMap((c) => c.emoji));
    });

    function openEpicker(mine: string[], onPick: (e: string) => void) {
      epickerMine = mine;
      epickerCallback = onPick;
      epickerSearch.value = '';
      setEpickerCat(epickerActiveCat);
      epicker.style.display = 'flex';
      epickerBackdrop.style.display = 'block';
      requestAnimationFrame(() => epickerSearch.focus());
    }

    function closeEpicker() {
      epicker.style.display = 'none';
      epickerBackdrop.style.display = 'none';
      epickerCallback = null;
    }

    epickerBackdrop.addEventListener('click', closeEpicker);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && epicker.style.display !== 'none') {
        e.stopPropagation();
        closeEpicker();
      }
    });

    // ─── Action bar ───────────────────────────────────────────────────────────
    function makeActionBtn(icon: string, label: string, title: string): HTMLButtonElement {
      const btn = document.createElement('button');
      btn.className = 'ru-action-btn';
      btn.title = title;
      btn.innerHTML = `<span class="ru-action-icon">${icon}</span>${label}`;
      return btn;
    }

    function buildActionsRow(
      item: any,
      post: HTMLElement,
      reactRow: HTMLElement,
    ): { actionsRow: HTMLElement; threadBtn: HTMLButtonElement } {
      const row = document.createElement('div');
      row.className = 'ru-post__actions';

      // React
      const reactBtn = makeActionBtn('🙂', '', 'Add reaction');
      reactBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const data = (reactRow as any).__lastData ?? { mine: [] };
        openEpicker(data.mine, async (emoji) => {
          await toggleReaction(item.id, emoji, reactRow);
        });
      });
      row.appendChild(reactBtn);

      // Comments / thread
      const threadBtn = document.createElement('button');
      threadBtn.className = 'ru-action-btn ru-action-thread';
      threadBtn.dataset.count = '0';
      threadBtn.dataset.open = 'false';
      threadBtn.title = 'Comments';
      threadBtn.innerHTML = `<span class="ru-action-icon">💬</span> <span class="ru-action-label">0</span>`;
      threadBtn.addEventListener('click', () => toggleThread(item.id, post, threadBtn));
      row.appendChild(threadBtn);

      // Download
      const dlBtn = document.createElement('a');
      dlBtn.className = 'ru-action-btn';
      dlBtn.href = `/api/media/${item.id}/file`;
      dlBtn.download = item.filename ?? '';
      dlBtn.title = 'Download file';
      dlBtn.innerHTML = `<span class="ru-action-icon">⬇</span>`;
      row.appendChild(dlBtn);

      // Copy link
      const linkBtn = makeActionBtn(`<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`, ' Copy link', 'Copy link to this item in The Stacks');
      linkBtn.addEventListener('click', async () => {
        const url = `${window.location.origin}/admin/search/detail?id=${item.id}`;
        try {
          await navigator.clipboard.writeText(url);
          (window as any).toast?.success('Link copied');
        } catch {
          (window as any).toast?.error('Could not copy link');
        }
      });
      row.appendChild(linkBtn);

      // Add to workspace
      const wsBtn = makeActionBtn('💼', '', 'Add to workspace');
      wsBtn.addEventListener('click', async () => {
        wsBtn.disabled = true;
        const result = await addItemsToWorkspace([item.id]);
        wsBtn.disabled = false;
        if (result) {
          (window as any).toast?.success(
            result.added > 0 ? 'Added to workspace' : 'Already in workspace',
          );
        } else {
          (window as any).toast?.error('Could not add to workspace');
        }
      });
      row.appendChild(wsBtn);

      return { actionsRow: row, threadBtn };
    }

    // ─── Reactions ────────────────────────────────────────────────────────────
    function buildReactRow(mediaId: string): HTMLElement {
      const row = document.createElement('div');
      row.className = 'ru-reactions';
      row.dataset.mediaId = mediaId;
      loadReactions(mediaId, row);
      return row;
    }

    async function loadReactions(mediaId: string, row: HTMLElement) {
      try {
        const res = await fetch(`/api/media/${mediaId}/reactions`, { credentials: 'include' });
        if (!res.ok) return;
        renderReactions(mediaId, row, await res.json());
      } catch {}
    }

    function renderReactions(
      mediaId: string,
      row: HTMLElement,
      data: { counts: Record<string, number>; mine: string[] },
    ) {
      (row as any).__lastData = data;
      row.innerHTML = '';
      for (const [emoji, count] of Object.entries(data.counts)) {
        if (count === 0) continue;
        const btn = document.createElement('button');
        btn.className =
          'ru-react-btn' + (data.mine.includes(emoji) ? ' ru-react-btn--mine' : '');
        btn.innerHTML = `${emoji} <span class="ru-react-count">${count}</span>`;
        btn.addEventListener('click', () => toggleReaction(mediaId, emoji, row));
        row.appendChild(btn);
      }
    }

    async function toggleReaction(mediaId: string, emoji: string, row: HTMLElement) {
      try {
        await fetch(`/api/media/${mediaId}/reactions`, {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ emoji }),
        });
        await loadReactions(mediaId, row);
      } catch {}
    }

    // ─── Comment count / thread button ───────────────────────────────────────
    function updateIndicatorText(indicator: HTMLButtonElement, open: boolean) {
      const n = parseInt(indicator.dataset.count ?? '0', 10);
      const labelEl = indicator.querySelector('.ru-action-label');
      if (labelEl) labelEl.textContent = String(n);
      indicator.classList.toggle('ru-action-btn--active', open);
    }

    async function loadCommentCount(mediaId: string, indicator: HTMLButtonElement) {
      try {
        const res = await fetch(`/api/media/${mediaId}/comments/count`, { credentials: 'include' });
        if (!res.ok) return;
        const { count } = await res.json();
        indicator.dataset.count = String(count);
        updateIndicatorText(indicator, indicator.dataset.open === 'true');
      } catch {}
    }

    // ─── Thread (comments) ────────────────────────────────────────────────────
    async function toggleThread(
      mediaId: string,
      post: HTMLElement,
      indicator: HTMLButtonElement,
    ) {
      const existing = post.querySelector('.ru-post__thread') as HTMLElement | null;
      if (existing) {
        existing.remove();
        indicator.dataset.open = 'false';
        updateIndicatorText(indicator, false);
        return;
      }
      indicator.dataset.open = 'true';
      indicator.disabled = true;
      try {
        const res = await fetch(`/api/media/${mediaId}/comments`, { credentials: 'include' });
        const comments: any[] = res.ok ? await res.json() : [];
        indicator.dataset.count = String(comments.length);
        updateIndicatorText(indicator, true);
        post.querySelector('.ru-post__body')!.appendChild(
          buildThreadSection(mediaId, comments),
        );
      } catch {
        indicator.dataset.open = 'false';
        updateIndicatorText(indicator, false);
      } finally {
        indicator.disabled = false;
      }
    }

    function buildThreadSection(mediaId: string, comments: any[]): HTMLElement {
      const section = document.createElement('div');
      section.className = 'ru-post__thread';
      for (const c of comments) {
        section.appendChild(buildCommentEl(mediaId, c, section));
      }
      section.appendChild(buildCompose(mediaId, null, section));
      return section;
    }

    function buildCommentEl(mediaId: string, c: any, section: HTMLElement): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'ru-comment';
      wrap.dataset.commentId = String(c.id);

      const header = document.createElement('div');
      header.className = 'ru-comment__header';
      const author = document.createElement('span');
      author.className = 'ru-comment__author';
      author.textContent = c.author_name ?? 'unknown';
      const time = document.createElement('span');
      time.className = 'ru-comment__time';
      time.textContent = timeAgo(c.created_at);
      time.title = new Date(c.created_at).toLocaleString();
      header.appendChild(author);
      header.appendChild(time);
      wrap.appendChild(header);

      const text = document.createElement('div');
      text.className = 'ru-comment__text';
      text.textContent = c.text;
      wrap.appendChild(text);

      const actions = document.createElement('div');
      actions.className = 'ru-comment__actions';

      const repliesWrap = document.createElement('div');
      repliesWrap.className = 'ru-replies';

      const replyBtn = document.createElement('button');
      replyBtn.className = 'ru-comment__action-btn';
      replyBtn.textContent = 'reply';
      let replyCompose: HTMLElement | null = null;
      replyBtn.addEventListener('click', () => {
        if (replyCompose) { replyCompose.remove(); replyCompose = null; return; }
        replyCompose = buildCompose(mediaId, c.id, section);
        repliesWrap.appendChild(replyCompose);
        replyCompose.querySelector<HTMLTextAreaElement>('textarea')?.focus();
      });
      actions.appendChild(replyBtn);

      if (c.is_mine) {
        const delBtn = document.createElement('button');
        delBtn.className = 'ru-comment__action-btn';
        delBtn.textContent = 'delete';
        delBtn.addEventListener('click', async () => {
          await fetch(`/api/media/${mediaId}/comments/${c.id}`, {
            method: 'DELETE', credentials: 'include',
          });
          wrap.remove();
          const indicator = section
            .closest<HTMLElement>('.ru-post')
            ?.querySelector<HTMLButtonElement>('.ru-action-thread');
          if (indicator) await loadCommentCount(mediaId, indicator);
        });
        actions.appendChild(delBtn);
      }
      wrap.appendChild(actions);

      for (const r of c.replies ?? []) {
        repliesWrap.appendChild(buildCommentEl(mediaId, r, section));
      }
      wrap.appendChild(repliesWrap);

      return wrap;
    }

    // ─── Compose ──────────────────────────────────────────────────────────────
    function buildCompose(
      mediaId: string,
      parentId: number | null,
      section: HTMLElement,
    ): HTMLElement {
      const row = document.createElement('div');
      row.className = 'ru-compose';
      const input = document.createElement('textarea');
      input.className = 'ru-compose-input';
      input.placeholder = parentId !== null ? 'Write a reply…' : 'Add a comment…';
      input.rows = 1;
      input.addEventListener('input', () => {
        input.style.height = 'auto';
        input.style.height = input.scrollHeight + 'px';
      });

      const sendBtn = document.createElement('button');
      sendBtn.className = 'ru-compose-send';
      sendBtn.textContent = 'Send';

      async function send() {
        const text = input.value.trim();
        if (!text) return;
        sendBtn.disabled = true;
        try {
          const res = await fetch(`/api/media/${mediaId}/comments`, {
            method: 'POST', credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text, parent_id: parentId }),
          });
          if (!res.ok) throw new Error();
          const newComment = await res.json();
          input.value = ''; input.style.height = '';

          if (parentId !== null) {
            row.before(buildCommentEl(mediaId, newComment, section));
            row.remove();
          } else {
            section.insertBefore(
              buildCommentEl(mediaId, newComment, section),
              row, // insert before compose row
            );
            const indicator = section
              .closest<HTMLElement>('.ru-post')
              ?.querySelector<HTMLButtonElement>('.ru-action-thread');
            if (indicator) await loadCommentCount(mediaId, indicator);
          }
        } catch {
          (window as any).toast?.error('Failed to post comment');
        } finally {
          sendBtn.disabled = false;
        }
      }

      input.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
        if (e.key === 'Escape') {
          e.stopPropagation();
          input.blur();
          if (parentId !== null) row.remove();
        }
      });
      sendBtn.addEventListener('click', send);
      row.appendChild(input);
      row.appendChild(sendBtn);
      return row;
    }

    // ─── Feed loading (bottom-up) ─────────────────────────────────────────────
    async function loadPage() {
      if (isLoading || exhausted) return;
      isLoading = true;
      loadingEl.style.display = 'block';
      try {
        const res = await fetch('/api/search', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            query: '', media_types: null,
            sort: 'created_at:desc',
            page: currentPage, per_page: PER_PAGE,
            filters: { output_index: '__outputs__' },
          }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const items: any[] = [...(data.results ?? data.hits ?? [])].reverse();

        loadingEl.style.display = 'none';

        if (currentPage === 1) {
          removeSkeletons();

          let batchDateKey = '';
          for (const item of items) {
            const at = item.sources?.[0]?.created_at ?? item.created_at;
            if (at) {
              const dk = new Date(at).toDateString();
              if (dk !== batchDateKey) { batchDateKey = dk; feed.appendChild(buildDateSep(at)); }
            }
            feed.appendChild(buildPost(item));
          }
          appendDateKey = batchDateKey;

          if (items.length > 0) {
            const newest = items[items.length - 1];
            newestCreatedAt = newest.sources?.[0]?.created_at ?? newest.created_at ?? null;
          }
          if (items.length < PER_PAGE) {
            exhausted = true;
            const end = document.createElement('div');
            end.className = 'ru-end';
            end.textContent = items.length === 0 ? '— no items yet —' : '— beginning of feed —';
            loadingEl.after(end);
          } else {
            currentPage++;
          }
          window.scrollTo(0, document.body.scrollHeight);
        } else {
          const prevScrollHeight = document.body.scrollHeight;
          const prevScrollTop = window.scrollY;

          let insertRef: Element = loadingEl;
          if (items.length < PER_PAGE) {
            exhausted = true;
            const end = document.createElement('div');
            end.className = 'ru-end';
            end.textContent = '— beginning of feed —';
            loadingEl.after(end);
            insertRef = end;
          } else {
            currentPage++;
          }

          let batchDateKey = '';
          for (const item of items) {
            const at = item.sources?.[0]?.created_at ?? item.created_at;
            if (at) {
              const dk = new Date(at).toDateString();
              if (dk !== batchDateKey) {
                batchDateKey = dk;
                const sep = buildDateSep(at);
                insertRef.after(sep);
                insertRef = sep;
              }
            }
            const post = buildPost(item);
            insertRef.after(post);
            insertRef = post;
          }

          window.scrollTo(0, prevScrollTop + (document.body.scrollHeight - prevScrollHeight));
        }
      } catch {
        removeSkeletons();
        loadingEl.textContent = 'Failed to load feed';
        loadingEl.style.display = 'block';
      } finally {
        isLoading = false;
      }
    }

    // ─── New item polling ─────────────────────────────────────────────────────
    async function pollForNew() {
      if (!newestCreatedAt) return;
      try {
        const res = await fetch('/api/search', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            query: '', media_types: null,
            sort: 'created_at:desc',
            page: 1, per_page: PER_PAGE,
            filters: { output_index: '__outputs__' },
          }),
        });
        if (!res.ok) return;
        const data = await res.json();
        const allItems: any[] = data.results ?? data.hits ?? [];
        const threshold = newestCreatedAt!;
        const newItems = allItems.filter((item) => {
          const t = item.sources?.[0]?.created_at ?? item.created_at;
          return t && t > threshold;
        });
        if (newItems.length === 0) return;

        const atBottom = window.scrollY + window.innerHeight >= document.body.scrollHeight - 150;

        newItems.reverse();
        for (const item of newItems) {
          const at = item.sources?.[0]?.created_at ?? item.created_at;
          if (at) {
            const dk = new Date(at).toDateString();
            if (dk !== appendDateKey) { appendDateKey = dk; feed.appendChild(buildDateSep(at)); }
          }
          feed.appendChild(buildPost(item));
        }

        const latest = allItems[0];
        newestCreatedAt = latest?.sources?.[0]?.created_at ?? latest?.created_at ?? newestCreatedAt;

        if (atBottom) window.scrollTo(0, document.body.scrollHeight);
      } catch {}
    }

    setInterval(pollForNew, 60_000);

    // ─── Infinite scroll (scroll UP) ─────────────────────────────────────────
    const observer = new IntersectionObserver(
      (entries) => { if (entries[0].isIntersecting) loadPage(); },
      { rootMargin: '300px' },
    );
    observer.observe(sentinel);

    showSkeletons();
    loadPage();
  </script>
</Admin>
