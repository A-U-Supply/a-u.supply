---
import Admin from '../../layouts/Admin.astro';
---

<Admin title="Feed" current="feed">
  <div class="page-header">
    <h1>Feed</h1>
    <p class="page-subtitle">output feed</p>
  </div>

  <div class="ru-feed" id="ru-feed">
    <div id="ru-sentinel" style="height:1px"></div>
    <div class="ru-loading" id="ru-loading" style="display:none"></div>
  </div>

  <!-- Shared emoji picker (one instance, shared across all cards) -->
  <div id="ru-epicker" class="ru-epicker" style="display:none">
    <div class="ru-epicker__top">
      <div class="ru-epicker__cats" id="ru-epicker-cats"></div>
      <input class="ru-epicker__search" id="ru-epicker-search" type="text" placeholder="Search…" autocomplete="off" />
    </div>
    <div class="ru-epicker__grid" id="ru-epicker-grid"></div>
  </div>
  <div id="ru-epicker-backdrop" class="ru-epicker-backdrop" style="display:none"></div>

  <div id="ru-lightbox" class="ru-lightbox" style="display:none" role="dialog" aria-modal="true">
    <img id="ru-lightbox-img" src="" alt="" />
  </div>

  <style>
    /* ── Feed stream ── */
    .ru-feed {
      display: flex;
      flex-direction: column;
      max-width: 740px;
      padding-bottom: 3rem;
    }

    /* ── Post ── */
    .ru-post {
      display: flex;
      gap: 0.75rem;
      padding: 1rem 0;
    }
    .ru-post + .ru-post {
      border-top: 1px solid var(--border, #1c1c1c);
    }

    /* ── Avatar ── */
    .ru-post__avatar {
      flex-shrink: 0;
      width: 36px; height: 36px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.7rem; font-weight: 600; color: #fff;
      letter-spacing: 0.02em;
      user-select: none;
    }

    /* ── Post body ── */
    .ru-post__body {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    /* ── Header row ── */
    .ru-post__header {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .ru-post__author {
      font-size: 0.88rem;
      font-weight: 600;
      white-space: nowrap;
    }
    .ru-post__meta {
      display: flex;
      align-items: baseline;
      gap: 0.2rem;
      flex: 1;
      min-width: 0;
      overflow: hidden;
    }
    .ru-post__filename {
      font-size: 0.7rem;
      font-family: monospace;
      opacity: 0.4;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .ru-post__tag-dot { font-size: 0.65rem; opacity: 0.2; }
    .ru-post__tag    { font-size: 0.65rem; opacity: 0.32; white-space: nowrap; }
    .ru-post__time {
      font-size: 0.65rem;
      opacity: 0.28;
      white-space: nowrap;
      flex-shrink: 0;
      margin-left: auto;
      cursor: default;
    }

    /* ── Media ── */
    .ru-post__media {
      background: #080808;
      border-radius: 4px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 80px;
    }
    .ru-post__media img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 460px;
      object-fit: contain;
      cursor: zoom-in;
    }
    /* ── Inline audio player ── */
    .ru-audio {
      width: 100%;
      padding: 0.6rem 0;
    }
    .ru-audio__bar {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .ru-audio__play {
      background: none;
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 50%;
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      cursor: pointer;
      font-size: 0.75rem;
      color: inherit;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.15s;
    }
    .ru-audio__play:hover { border-color: rgba(255,255,255,0.4); }
    .ru-audio__scrub-wrap {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .ru-audio__scrub {
      width: 100%;
      height: 3px;
      -webkit-appearance: none;
      appearance: none;
      background: rgba(255,255,255,0.1);
      border-radius: 2px;
      cursor: pointer;
      accent-color: rgba(255,255,255,0.5);
    }
    .ru-audio__times {
      display: flex;
      justify-content: space-between;
      font-size: 0.62rem;
      opacity: 0.3;
      font-variant-numeric: tabular-nums;
    }

    /* ── Footer ── */
    .ru-post__footer {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    /* ── Reactions ── */
    .ru-reactions {
      display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap;
    }
    .ru-react-btn {
      display: inline-flex; align-items: center; gap: 0.2rem;
      font-size: 0.85rem; padding: 0.15rem 0.45rem;
      border: 1px solid var(--border, #333); border-radius: 3px;
      background: transparent; color: inherit; cursor: pointer;
      transition: border-color 0.1s, background 0.1s;
    }
    .ru-react-btn:hover { border-color: var(--accent, #888); }
    .ru-react-btn--mine { border-color: var(--accent, #888); background: rgba(255,255,255,0.06); }
    .ru-react-count { font-size: 0.7rem; }
    /* ── Action bar ── */
    .ru-post__actions {
      display: flex;
      gap: 0.3rem;
      flex-wrap: wrap;
      align-items: center;
    }
    .ru-action-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.72rem;
      padding: 0.25rem 0.55rem;
      border: 1px solid rgba(0,0,0,0.15);
      border-radius: 3px;
      background: transparent;
      color: inherit;
      cursor: pointer;
      opacity: 0.5;
      white-space: nowrap;
      text-decoration: none;
      transition: opacity 0.1s, border-color 0.1s;
      line-height: 1;
    }
    .ru-action-btn:hover { opacity: 1; border-color: rgba(0,0,0,0.35); }
    .ru-action-btn--active { opacity: 1; background: rgba(0,0,0,0.07); border-color: rgba(0,0,0,0.3); }
    .ru-action-icon { font-size: 0.85rem; }
    .ru-thread-avatar {
      width: 16px; height: 16px; border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 0.45rem; font-weight: 600; color: #fff;
      margin-right: -4px; border: 1px solid var(--bg, #111);
    }

    /* ── Thread section (expanded comments) ── */
    .ru-post__thread {
      margin-top: 0.25rem;
      border-top: 1px solid var(--border, #1e1e1e);
      padding-top: 0.65rem;
      display: flex; flex-direction: column; gap: 0.55rem;
    }

    /* ── Comments ── */
    .ru-comment { display: flex; flex-direction: column; gap: 0.18rem; }
    .ru-comment__header {
      display: flex; align-items: baseline; gap: 0.4rem;
    }
    .ru-comment__author { font-size: 0.72rem; font-weight: 600; }
    .ru-comment__time   { font-size: 0.63rem; opacity: 0.35; }
    .ru-comment__text   { font-size: 0.78rem; opacity: 0.82; line-height: 1.45; }
    .ru-comment__actions { display: flex; gap: 0.6rem; margin-top: 0.1rem; }
    .ru-comment__action-btn {
      font-size: 0.63rem; opacity: 0.35; background: none; border: none;
      color: inherit; cursor: pointer; padding: 0; transition: opacity 0.1s;
    }
    .ru-comment__action-btn:hover { opacity: 0.85; }
    .ru-replies {
      padding-left: 0.85rem; border-left: 1px solid var(--border, #222);
      margin-top: 0.35rem; display: flex; flex-direction: column; gap: 0.45rem;
    }
    .ru-compose {
      display: flex; gap: 0.5rem; align-items: flex-end; margin-top: 0.1rem;
    }
    .ru-compose-input {
      flex: 1; font-size: 0.78rem; padding: 0.35rem 0.5rem;
      background: var(--bg2, #1a1a1a); border: 1px solid var(--border, #2a2a2a);
      color: inherit; border-radius: 3px; resize: none; min-height: 34px;
      font-family: inherit;
    }
    .ru-compose-input:focus { outline: none; border-color: var(--accent, #555); }
    .ru-compose-send {
      font-size: 0.72rem; padding: 0.35rem 0.6rem;
      background: none; border: 1px solid var(--border, #333); border-radius: 3px;
      color: inherit; cursor: pointer; white-space: nowrap;
      transition: border-color 0.1s;
    }
    .ru-compose-send:hover { border-color: var(--accent, #888); }
    .ru-compose-send:disabled { opacity: 0.4; cursor: default; }

    /* ── Date separator ── */
    .ru-date-sep {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.75rem 0; font-size: 0.65rem;
      opacity: 0.25; letter-spacing: 0.06em; text-transform: uppercase;
    }
    .ru-date-sep::before, .ru-date-sep::after {
      content: ''; flex: 1; height: 1px;
      background: var(--border, #222);
    }

    /* ── Loading skeleton ── */
    @keyframes ru-shimmer {
      0%   { background-position: -600px 0; }
      100% { background-position:  600px 0; }
    }
    .ru-skeleton {
      display: flex; gap: 0.75rem; padding: 1rem 0;
    }
    .ru-skeleton + .ru-skeleton {
      border-top: 1px solid var(--border, #1c1c1c);
    }
    .ru-skel__avatar,
    .ru-skel__image,
    .ru-skel__line {
      background: linear-gradient(90deg, #191919 25%, #222 50%, #191919 75%);
      background-size: 600px 100%;
      animation: ru-shimmer 1.5s infinite linear;
      border-radius: 3px;
    }
    .ru-skel__avatar { width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0; }
    .ru-skel__body   { flex: 1; display: flex; flex-direction: column; gap: 0.55rem; }
    .ru-skel__line--header { height: 13px; width: 45%; }
    .ru-skel__image  { height: 200px; border-radius: 4px; }
    .ru-skel__line--footer { height: 10px; width: 22%; }

    /* ── End states ── */
    .ru-end {
      text-align: center; padding: 2rem; font-size: 0.7rem; opacity: 0.25;
      letter-spacing: 0.04em;
    }

    /* ── Emoji picker ── */
    .ru-epicker-backdrop {
      position: fixed; inset: 0; z-index: 490;
    }
    .ru-epicker {
      position: fixed; z-index: 500;
      top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: min(360px, 96vw);
      background: var(--bg, #111); border: 1px solid var(--border, #333);
      border-radius: 8px; overflow: hidden;
      display: flex; flex-direction: column;
      box-shadow: 0 8px 32px rgba(0,0,0,0.6);
      color: rgba(255,255,255,0.85);
    }
    .ru-epicker__top {
      display: flex; flex-direction: column;
      border-bottom: 1px solid var(--border, #2a2a2a);
    }
    .ru-epicker__cats {
      display: flex; overflow-x: auto; padding: 0.25rem 0.25rem 0;
      gap: 0.1rem; scrollbar-width: none;
    }
    .ru-epicker__cats::-webkit-scrollbar { display: none; }
    .ru-epicker__cat-btn {
      flex-shrink: 0; font-size: 1.1rem; padding: 0.25rem 0.4rem;
      background: none; border: none; cursor: pointer; border-radius: 4px;
      opacity: 0.5; transition: opacity 0.1s, background 0.1s;
    }
    .ru-epicker__cat-btn:hover { opacity: 0.9; background: rgba(255,255,255,0.06); }
    .ru-epicker__cat-btn--active { opacity: 1; background: rgba(255,255,255,0.1); }
    .ru-epicker__search {
      margin: 0.3rem 0.4rem; padding: 0.3rem 0.5rem;
      background: var(--bg2, #1a1a1a); border: 1px solid var(--border, #333);
      border-radius: 4px; color: rgba(255,255,255,0.85); font-size: 0.78rem; font-family: inherit;
    }
    .ru-epicker__search:focus { outline: none; border-color: var(--accent, #666); }
    .ru-epicker__grid {
      display: grid; grid-template-columns: repeat(7, 1fr);
      overflow-y: auto; max-height: 300px; padding: 0.25rem; gap: 1px;
    }
    .ru-epicker__emoji {
      font-size: 1.6rem; text-align: center; padding: 0.3rem;
      cursor: pointer; border-radius: 4px; border: none; background: none;
      transition: background 0.1s; line-height: 1.4;
    }
    .ru-epicker__emoji:hover { background: rgba(255,255,255,0.1); }
    .ru-epicker__emoji--mine { background: rgba(255,255,255,0.08); }

    /* ── Lightbox ── */
    .ru-lightbox {
      position: fixed; inset: 0; z-index: 1000;
      background: rgba(0,0,0,0.92);
      display: flex; align-items: center; justify-content: center;
      cursor: zoom-out;
    }
    .ru-lightbox img {
      max-width: 95vw; max-height: 95vh;
      object-fit: contain; border-radius: 2px; cursor: default;
    }
  </style>

  <script>
    import { addItemsToWorkspace } from '../../lib/workspace.ts';

    // ─── State ────────────────────────────────────────────────────────────────
    let currentPage = 1;
    let isLoading = false;
    let exhausted = false;
    let newestCreatedAt: string | null = null;
    let appendDateKey = '';   // tracks date boundary for appended items
    const PER_PAGE = 20;

    // ─── Emoji data (categorised) ─────────────────────────────────────────────
