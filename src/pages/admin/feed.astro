    const feed = document.getElementById('ru-feed')!;
    const loadingEl = document.getElementById('ru-loading')!;
    const sentinel = document.getElementById('ru-sentinel')!;

    // ─── Time formatting ──────────────────────────────────────────────────────
    function timeAgo(iso: string): string {
      const diff = Date.now() - new Date(iso).getTime();
      const s = Math.floor(diff / 1000);
      if (s < 60) return `${s}s ago`;
      const m = Math.floor(s / 60);
      if (m < 60) return `${m}m ago`;
      const h = Math.floor(m / 60);
      if (h < 24) return `${h}h ago`;
      const d = Math.floor(h / 24);
      if (d < 30) return `${d}d ago`;
      return new Date(iso).toLocaleDateString();
    }

    // ─── Creator name ─────────────────────────────────────────────────────────
    function getCreatorName(item: any): string {
      for (const src of item.sources ?? []) {
        if (src.uploader_name) return src.uploader_name;
        if (src.source_metadata) {
          try {
            const m = JSON.parse(src.source_metadata);
            if (m.poster) return m.poster;
          } catch {}
        }
      }
      return 'unknown';
    }

    // ─── Comment toggle helpers ───────────────────────────────────────────────
    function commentLabel(n: number): string {
      if (n === 0) return '💬 comment';
      if (n === 1) return '💬 1 comment';
      return `💬 ${n} comments`;
    }

    function updateToggleText(btn: HTMLButtonElement, open: boolean) {
      const n = parseInt(btn.dataset.count ?? '0', 10);
      btn.textContent = commentLabel(n) + (open ? ' ▾' : ' ▸');
    }

    // ─── Lightbox ─────────────────────────────────────────────────────────────
    const lightbox = document.getElementById('ru-lightbox') as HTMLElement;
    const lightboxImg = document.getElementById('ru-lightbox-img') as HTMLImageElement;

    function openLightbox(url: string) {
      lightboxImg.src = url;
      lightbox.style.display = 'flex';
    }
    function closeLightbox() {
      lightbox.style.display = 'none';
      lightboxImg.src = '';
    }
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox.style.display !== 'none') {
        e.stopPropagation();
        closeLightbox();
      }
    });

    // ─── Build a card ─────────────────────────────────────────────────────────
    function buildCard(item: any): HTMLElement {
      const card = document.createElement('div');
      card.className = 'ru-card';
      card.dataset.id = item.id;

      // Media preview
      const mediaWrap = document.createElement('div');
      mediaWrap.className = 'ru-card__media';
      if (item.media_type === 'image') {
        const img = document.createElement('img');
        img.src = `/api/media/${item.id}/thumbnail`;
        img.alt = item.filename ?? '';
        img.loading = 'lazy';
        img.addEventListener('click', () => openLightbox(`/api/media/${item.id}/file`));
        mediaWrap.appendChild(img);
      } else {
        const icon = document.createElement('div');
        icon.className = 'ru-card__audio-placeholder';
        icon.textContent = item.media_type === 'audio' ? '♫' : '▶';
        mediaWrap.appendChild(icon);
      }
      card.appendChild(mediaWrap);

      // Body
      const body = document.createElement('div');
      body.className = 'ru-card__body';

      // Meta row
      const meta = document.createElement('div');
      meta.className = 'ru-card__meta';
      const fname = document.createElement('span');
      fname.className = 'ru-card__filename';
      fname.textContent = item.filename ?? item.id;
      fname.title = item.filename ?? '';
      meta.appendChild(fname);

      const creator = getCreatorName(item);
      const createdAt = item.sources?.[0]?.created_at ?? item.created_at;
      if (creator !== 'unknown' || createdAt) {
        const dot1 = document.createElement('span');
        dot1.className = 'ru-card__dot';
        dot1.textContent = '·';
        meta.appendChild(dot1);
        if (creator !== 'unknown') {
          const auth = document.createElement('span');
          auth.className = 'ru-card__author';
          auth.textContent = creator;
          meta.appendChild(auth);
        }
        if (createdAt) {
          const dot2 = document.createElement('span');
          dot2.className = 'ru-card__dot';
          dot2.textContent = '·';
          const time = document.createElement('span');
          time.className = 'ru-card__time';
          time.textContent = timeAgo(createdAt);
          meta.appendChild(dot2);
          meta.appendChild(time);
        }
      }
      body.appendChild(meta);

      // Tags
      const tags: string[] = item.tags ?? [];
      if (tags.length > 0) {
        const tagRow = document.createElement('div');
        tagRow.className = 'ru-card__tags';
        for (const t of tags.slice(0, 6)) {
          const tag = document.createElement('span');
          tag.className = 'ru-tag';
          tag.textContent = t;
          tagRow.appendChild(tag);
        }
        body.appendChild(tagRow);
      }

      // Always-visible reaction strip
      body.appendChild(buildReactRow(item.id));

      // Comments toggle (count loads async)
      const commentsToggle = document.createElement('button');
      commentsToggle.className = 'ru-comments-toggle';
      commentsToggle.dataset.count = '0';
      commentsToggle.dataset.open = 'false';
      updateToggleText(commentsToggle, false);
      commentsToggle.addEventListener('click', () =>
        toggleComments(item.id, card, commentsToggle),
      );
      body.appendChild(commentsToggle);

      // Inline compose (always visible — for top-level comments)
      body.appendChild(buildCompose(item.id, null, null, card, commentsToggle));

      card.appendChild(body);

      // Load comment count alongside reactions (fire-and-forget)
      loadCommentCount(item.id, commentsToggle);

      return card;
    }

    // ─── Emoji picker ─────────────────────────────────────────────────────────
    const epicker = document.getElementById('ru-epicker') as HTMLElement;
    const epickerGrid = document.getElementById('ru-epicker-grid') as HTMLElement;
    const epickerCats = document.getElementById('ru-epicker-cats') as HTMLElement;
    const epickerSearch = document.getElementById('ru-epicker-search') as HTMLInputElement;
    const epickerBackdrop = document.getElementById('ru-epicker-backdrop') as HTMLElement;

    let epickerCallback: ((emoji: string) => void) | null = null;
    let epickerMine: string[] = [];
    let epickerActiveCat = 0;

    EMOJI_CATS.forEach((cat, i) => {
      const btn = document.createElement('button');
      btn.className = 'ru-epicker__cat-btn' + (i === 0 ? ' ru-epicker__cat-btn--active' : '');
      btn.textContent = cat.icon;
      btn.title = cat.label;
      btn.addEventListener('click', () => {
        epickerSearch.value = '';
        setEpickerCat(i);
      });
      epickerCats.appendChild(btn);
    });

    function setEpickerCat(i: number) {
      epickerActiveCat = i;
      epickerCats
        .querySelectorAll('.ru-epicker__cat-btn')
        .forEach((b, idx) => b.classList.toggle('ru-epicker__cat-btn--active', idx === i));
      renderEpickerGrid(EMOJI_CATS[i].emoji);
    }

    function renderEpickerGrid(emoji: string[]) {
      epickerGrid.innerHTML = '';
      for (const e of emoji) {
        if (!e.trim()) continue;
        const btn = document.createElement('button');
        btn.className =
          'ru-epicker__emoji' + (epickerMine.includes(e) ? ' ru-epicker__emoji--mine' : '');
        btn.textContent = e;
        btn.addEventListener('click', () => {
          epickerCallback?.(e);
          closeEpicker();
        });
        epickerGrid.appendChild(btn);
      }
    }

    epickerSearch.addEventListener('input', () => {
      const q = epickerSearch.value.trim().toLowerCase();
      if (!q) {
        setEpickerCat(epickerActiveCat);
        return;
      }
      // Show emoji from categories whose label matches, or all if no match
      const matched: string[] = [];
      for (const cat of EMOJI_CATS) {
        if (cat.label.toLowerCase().includes(q)) matched.push(...cat.emoji);
      }
      renderEpickerGrid(matched.length > 0 ? matched : EMOJI_CATS.flatMap((c) => c.emoji));
    });

    function openEpicker(mine: string[], onPick: (e: string) => void) {
      epickerMine = mine;
      epickerCallback = onPick;
      epickerSearch.value = '';
      setEpickerCat(epickerActiveCat);
      epicker.style.display = 'flex';
      epickerBackdrop.style.display = 'block';
      requestAnimationFrame(() => epickerSearch.focus());
    }

    function closeEpicker() {
      epicker.style.display = 'none';
      epickerBackdrop.style.display = 'none';
      epickerCallback = null;
    }

    epickerBackdrop.addEventListener('click', closeEpicker);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && epicker.style.display !== 'none') {
        e.stopPropagation();
        closeEpicker();
      }
    });

    // ─── Reactions ────────────────────────────────────────────────────────────
    function buildReactRow(mediaId: string): HTMLElement {
      const row = document.createElement('div');
      row.className = 'ru-reactions';
      row.dataset.mediaId = mediaId;
      loadReactions(mediaId, row);
      return row;
    }

    async function loadReactions(mediaId: string, row: HTMLElement) {
      try {
        const res = await fetch(`/api/media/${mediaId}/reactions`, { credentials: 'include' });
        if (!res.ok) return;
        renderReactions(mediaId, row, await res.json());
      } catch {}
    }

    function renderReactions(
      mediaId: string,
      row: HTMLElement,
      data: { counts: Record<string, number>; mine: string[] },
    ) {
      row.innerHTML = '';
      for (const [emoji, count] of Object.entries(data.counts)) {
        if (count === 0) continue;
        const btn = document.createElement('button');
        btn.className =
          'ru-react-btn' + (data.mine.includes(emoji) ? ' ru-react-btn--mine' : '');
        btn.innerHTML = `${emoji} <span class="ru-react-count">${count}</span>`;
        btn.addEventListener('click', () => toggleReaction(mediaId, emoji, row));
        row.appendChild(btn);
      }
      const addBtn = document.createElement('button');
      addBtn.className = 'ru-react-add';
      addBtn.textContent = '＋';
      addBtn.title = 'Add reaction';
      addBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        openEpicker(data.mine, async (emoji) => {
          await toggleReaction(mediaId, emoji, row);
        });
      });
      row.appendChild(addBtn);
    }

    async function toggleReaction(mediaId: string, emoji: string, row: HTMLElement) {
      try {
        await fetch(`/api/media/${mediaId}/reactions`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ emoji }),
        });
        await loadReactions(mediaId, row);
      } catch {}
    }

    // ─── Comment count ────────────────────────────────────────────────────────
    async function loadCommentCount(mediaId: string, toggleBtn: HTMLButtonElement) {
      try {
        const res = await fetch(`/api/media/${mediaId}/comments/count`, {
          credentials: 'include',
        });
        if (!res.ok) return;
        const { count } = await res.json();
        toggleBtn.dataset.count = String(count);
        updateToggleText(toggleBtn, toggleBtn.dataset.open === 'true');
      } catch {}
    }

    // ─── Comments ─────────────────────────────────────────────────────────────
    async function toggleComments(
      mediaId: string,
      card: HTMLElement,
      toggleBtn: HTMLButtonElement,
    ) {
      const existing = card.querySelector('.ru-comments') as HTMLElement | null;
      if (existing) {
        existing.remove();
        toggleBtn.dataset.open = 'false';
        updateToggleText(toggleBtn, false);
        return;
      }
      toggleBtn.dataset.open = 'true';
      const prevText = toggleBtn.textContent;
      toggleBtn.textContent = 'loading…';
      try {
        const res = await fetch(`/api/media/${mediaId}/comments`, { credentials: 'include' });
        const comments: any[] = res.ok ? await res.json() : [];
        toggleBtn.dataset.count = String(comments.length);
        updateToggleText(toggleBtn, true);
        card.appendChild(buildCommentsSection(mediaId, comments));
      } catch {
        toggleBtn.dataset.open = 'false';
        toggleBtn.textContent = prevText ?? '';
      }
    }

    function buildCommentsSection(mediaId: string, comments: any[]): HTMLElement {
      const section = document.createElement('div');
      section.className = 'ru-comments';
      for (const c of comments) {
        section.appendChild(buildCommentEl(mediaId, c, section));
      }
      // No compose here — the always-visible inline compose handles top-level comments
      return section;
    }

    function buildCommentEl(
      mediaId: string,
      c: any,
      section: HTMLElement,
    ): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'ru-comment';
      wrap.dataset.commentId = String(c.id);

      const header = document.createElement('div');
      header.className = 'ru-comment__header';
      const author = document.createElement('span');
      author.className = 'ru-comment__author';
      author.textContent = c.author_name ?? 'unknown';
      const time = document.createElement('span');
      time.className = 'ru-comment__time';
      time.textContent = timeAgo(c.created_at);
      header.appendChild(author);
      header.appendChild(time);
      wrap.appendChild(header);

      const text = document.createElement('div');
      text.className = 'ru-comment__text';
      text.textContent = c.text;
      wrap.appendChild(text);

      // Actions + replies
      const actions = document.createElement('div');
      actions.className = 'ru-comment__actions';

      const repliesWrap = document.createElement('div');
      repliesWrap.className = 'ru-replies';

      const replyBtn = document.createElement('button');
      replyBtn.className = 'ru-comment__action-btn';
      replyBtn.textContent = 'reply';
      let replyCompose: HTMLElement | null = null;
      replyBtn.addEventListener('click', () => {
        if (replyCompose) {
          replyCompose.remove();
          replyCompose = null;
          return;
        }
        replyCompose = buildCompose(mediaId, c.id, section, null, null);
        repliesWrap.appendChild(replyCompose);
        replyCompose.querySelector<HTMLTextAreaElement>('textarea')?.focus();
      });
      actions.appendChild(replyBtn);

      if (c.is_mine) {
        const delBtn = document.createElement('button');
        delBtn.className = 'ru-comment__action-btn';
        delBtn.textContent = 'delete';
        delBtn.addEventListener('click', async () => {
          await fetch(`/api/media/${mediaId}/comments/${c.id}`, {
            method: 'DELETE',
            credentials: 'include',
          });
          wrap.remove();
          const parentCard = section.closest<HTMLElement>('.ru-card');
          const toggle = parentCard?.querySelector<HTMLButtonElement>('.ru-comments-toggle');
          if (toggle) await loadCommentCount(mediaId, toggle);
        });
        actions.appendChild(delBtn);
      }
      wrap.appendChild(actions);

      for (const r of c.replies ?? []) {
        repliesWrap.appendChild(buildCommentEl(mediaId, r, section));
      }
      wrap.appendChild(repliesWrap);

      return wrap;
    }

    // ─── Compose (inline top-level + reply) ───────────────────────────────────
    function buildCompose(
      mediaId: string,
      parentId: number | null,
      section: HTMLElement | null,
      card: HTMLElement | null,
      toggleBtn: HTMLButtonElement | null,
    ): HTMLElement {
      const row = document.createElement('div');
      row.className = 'ru-compose';
      const input = document.createElement('textarea');
      input.className = 'ru-compose-input';
      input.placeholder = parentId !== null ? 'Write a reply…' : 'Add a comment…';
      input.rows = 1;
      input.addEventListener('input', () => {
        input.style.height = 'auto';
        input.style.height = input.scrollHeight + 'px';
      });

      const sendBtn = document.createElement('button');
      sendBtn.className = 'ru-compose-send';
      sendBtn.textContent = 'Send';

      async function send() {
        const text = input.value.trim();
        if (!text) return;
        sendBtn.disabled = true;
        try {
          const res = await fetch(`/api/media/${mediaId}/comments`, {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text, parent_id: parentId }),
          });
          if (!res.ok) throw new Error();
          const newComment = await res.json();
          input.value = '';
          input.style.height = '';

          if (parentId !== null) {
            // Reply: insert before this compose row, then dismiss compose
            row.before(buildCommentEl(mediaId, newComment, section!));
            row.remove();
          } else {
            // Top-level: append to open comments section if visible
            const openSection = card
              ? card.querySelector<HTMLElement>('.ru-comments')
              : section;
            if (openSection) {
              openSection.appendChild(buildCommentEl(mediaId, newComment, openSection));
            }
            // Refresh count
            const btn =
              toggleBtn ??
              card?.querySelector<HTMLButtonElement>('.ru-comments-toggle');
            if (btn) await loadCommentCount(mediaId, btn);
          }
        } catch {
          (window as any).toast?.error('Failed to post comment');
        } finally {
          sendBtn.disabled = false;
        }
      }

      input.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          send();
        }
        if (e.key === 'Escape') {
          e.stopPropagation();
          input.blur();
          if (parentId !== null) row.remove();
        }
      });
      sendBtn.addEventListener('click', send);

      row.appendChild(input);
      row.appendChild(sendBtn);
      return row;
    }

    // ─── Feed loading (bottom-up) ─────────────────────────────────────────────
    async function loadPage() {
      if (isLoading || exhausted) return;
      isLoading = true;
      loadingEl.style.display = 'block';
      try {
        const res = await fetch('/api/search', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            query: '',
            media_types: null,
            sort: 'created_at:desc',
            page: currentPage,
            per_page: PER_PAGE,
            filters: { output_index: '__outputs__' },
          }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        // items arrive newest-first; reverse so oldest-of-batch renders at top
        const items: any[] = [...(data.results ?? data.hits ?? [])].reverse();

        loadingEl.style.display = 'none';

        if (currentPage === 1) {
          // First page: append to feed, then scroll to bottom
          for (const item of items) {
            feed.appendChild(buildCard(item));
          }
          if (items.length > 0) {
            // Last item after reversing is the most recent
            const newest = items[items.length - 1];
            newestCreatedAt =
              newest.sources?.[0]?.created_at ?? newest.created_at ?? null;
          }
          if (items.length < PER_PAGE) {
            exhausted = true;
            const end = document.createElement('div');
            end.className = 'ru-end';
            end.textContent = items.length === 0 ? '— no items yet —' : '— beginning of feed —';
            loadingEl.after(end);
          } else {
            currentPage++;
          }
          window.scrollTo(0, document.body.scrollHeight);
        } else {
          // Subsequent pages: prepend older items above existing content
          const prevScrollHeight = document.body.scrollHeight;
          const prevScrollTop = window.scrollY;

          // Insert items right after loadingEl (above existing cards)
          let insertRef: Element = loadingEl;

          if (items.length < PER_PAGE) {
            exhausted = true;
            const end = document.createElement('div');
            end.className = 'ru-end';
            end.textContent = '— beginning of feed —';
            loadingEl.after(end);
            insertRef = end;
          } else {
            currentPage++;
          }

          for (const item of items) {
            const card = buildCard(item);
            insertRef.after(card);
            insertRef = card;
          }

          // Restore scroll so viewport stays in the same position
          window.scrollTo(0, prevScrollTop + (document.body.scrollHeight - prevScrollHeight));
        }
      } catch {
        loadingEl.textContent = 'Failed to load feed';
        loadingEl.style.display = 'block';
      } finally {
        isLoading = false;
      }
    }

    // ─── New item polling ──────────────────────────────────────────────────────
    async function pollForNew() {
      if (!newestCreatedAt) return;
      try {
        const res = await fetch('/api/search', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            query: '',
            media_types: null,
            sort: 'created_at:desc',
            page: 1,
            per_page: PER_PAGE,
            filters: { output_index: '__outputs__' },
          }),
        });
        if (!res.ok) return;
        const data = await res.json();
        const allItems: any[] = data.results ?? data.hits ?? [];
        const threshold = newestCreatedAt!;
        const newItems = allItems.filter((item) => {
          const t = item.sources?.[0]?.created_at ?? item.created_at;
          return t && t > threshold;
        });
        if (newItems.length === 0) return;

        const atBottom =
          window.scrollY + window.innerHeight >= document.body.scrollHeight - 150;

        // newItems arrives newest-first; reverse to append oldest-of-batch first
        newItems.reverse();
        for (const item of newItems) {
          feed.appendChild(buildCard(item));
        }

        // Update newest timestamp
        const latest = allItems[0];
        newestCreatedAt =
          latest?.sources?.[0]?.created_at ?? latest?.created_at ?? newestCreatedAt;

        if (atBottom) {
          window.scrollTo(0, document.body.scrollHeight);
        }
      } catch {}
    }

    setInterval(pollForNew, 60_000);

    // ─── Infinite scroll (scroll UP triggers older pages) ────────────────────
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) loadPage();
      },
      { rootMargin: '300px' },
    );
    observer.observe(sentinel);

    loadPage();
  </script>
