---
import Admin from '../../../layouts/Admin.astro';
---

<Admin title="Media Detail" current="search">
  <div id="detail-loading" style="color: var(--color-muted);">
    <span class="loading-dots">Loading</span>
  </div>
  <div id="detail-error" class="login-error" style="display:none;"></div>

  <div id="detail-content" style="display:none;">
    <div class="detail-header">
      <h1 id="detail-title">Media Detail</h1>
      <button
        class="bm-star"
        id="detail-bm-star"
        style="display:none;"
        title="Bookmark"></button>
      <a href="/admin/search" class="action-btn">Back to Search</a>
    </div>

    <!--
      Section labels live INSIDE each card's head bar (not floating above
      as h2s with underlines). Discussion is the one card where the head
      already carries the thread's own editable title; the section
      identity reads from the card's content + position. The Threads
      empty-state head shows `{defaultTitle}` ("Discussion: <filename>")
      so empty and populated states have the same title shape.
    -->

    <!-- PREVIEW + METADATA: no head bar — the file is the section. -->
    <section
      class="brutal-card preview-meta-card"
      aria-labelledby="preview-meta-h"
    >
      <h2 id="preview-meta-h" class="visually-hidden">
        Preview and metadata
      </h2>
      <div class="preview-meta-grid">
        <div class="preview-area" id="detail-preview"></div>
        <div class="metadata-area" id="metadata-body"></div>
      </div>
      <details class="disclosure">
        <summary>File chrome</summary>
        <div class="disclosure__body" id="metadata-chrome-body"></div>
      </details>
    </section>

    <!-- CURATION -->
    <section class="brutal-card curation-card" aria-labelledby="cur-h">
      <div class="brutal-card__head">
        <h2 id="cur-h">Curation</h2>
      </div>
      <div class="brutal-card__body curation-body">
        <div class="curation-vote">
          <div id="vote-chip-island" class="vote-chip-island"></div>
        </div>
        <div class="curation-tags">
          <div class="tags-list" id="tags-list"></div>
          <div class="tag-add">
            <input
              type="text"
              id="tag-input"
              placeholder="Add tag..."
              autocomplete="off"
              aria-label="Add tag"
            />
            <div
              class="tag-suggestions"
              id="tag-suggestions"
              style="display:none;"
            >
            </div>
            <button class="action-btn" id="add-tag-btn">Add</button>
          </div>
        </div>
      </div>
    </section>

    <!-- COMMENTS / Discussion: the Threads `.single` brutal-card carries
         the thread's own editable title in its head ("Discussion:
         <filename>" by default). No outer wrapper card here — that
         already exists as the .single chrome itself. -->
    <div id="threads-island"></div>

    <!-- PROVENANCE -->
    <section class="brutal-card provenance-card" aria-labelledby="prov-h">
      <div class="brutal-card__head">
        <h2 id="prov-h">Provenance</h2>
      </div>
      <div class="brutal-card__body">
        <div id="provenance-rows"></div>
        <div class="field-row">
          <div class="field-row__label">Linked</div>
          <div class="field-row__value">
            <div id="latent-links-island"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- EXTRACTED TEXT (OCR caption or whisper transcript) -->
    <section
      class="brutal-card extracted-text-card"
      id="extracted-text-section"
      aria-labelledby="et-h"
      style="display:none;"
    >
      <div class="brutal-card__head">
        <h2 id="et-h">
          <span id="extracted-text-heading">Extracted Text</span>
        </h2>
        <span class="brutal-card__head-meta" id="extracted-text-stats"></span>
        <button
          class="brutal-card__head-action"
          id="extracted-text-copy"
          type="button"
          style="display:none;"
        >
          Copy
        </button>
      </div>
      <div class="brutal-card__body" id="extracted-text-body"></div>
      <button
        class="extracted-text-toggle"
        id="extracted-text-toggle"
        type="button"
        style="display:none;"
      >
        Show all
      </button>
    </section>

    <!-- ACTIONS -->
    <div class="detail-actions">
      <button
        class="action-btn"
        id="add-to-workspace-btn"
        type="button">Add to workspace</button
      >
      <a
        class="action-btn"
        id="download-btn"
        href="#"
        download
        style="display:none;">Download</a
      >
      <button
        class="action-btn"
        id="slack-share-btn"
        type="button"
        style="display:none;"
        ><svg
          width="14"
          height="14"
          viewBox="0 0 122.8 122.8"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          style="vertical-align:-2px;margin-right:5px;flex-shrink:0;"
          ><path
            d="M25.8 77.6c0 7.1-5.8 12.9-12.9 12.9S0 84.7 0 77.6s5.8-12.9 12.9-12.9h12.9v12.9zm6.5 0c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9v32.3c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9V77.6z"
            fill="#e01e5a"></path><path
            d="M45.2 25.8c-7.1 0-12.9-5.8-12.9-12.9S38.1 0 45.2 0s12.9 5.8 12.9 12.9v12.9H45.2zm0 6.5c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9H12.9C5.8 58.1 0 52.3 0 45.2s5.8-12.9 12.9-12.9h32.3z"
            fill="#ecb22e"></path><path
            d="M97 45.2c0-7.1 5.8-12.9 12.9-12.9s12.9 5.8 12.9 12.9-5.8 12.9-12.9 12.9H97V45.2zm-6.5 0c0 7.1-5.8 12.9-12.9 12.9s-12.9-5.8-12.9-12.9V12.9C64.7 5.8 70.5 0 77.6 0s12.9 5.8 12.9 12.9v32.3z"
            fill="#2eb67d"></path><path
            d="M77.6 97c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9-12.9-5.8-12.9-12.9V97h12.9zm0-6.5c-7.1 0-12.9-5.8-12.9-12.9s5.8-12.9 12.9-12.9h32.3c7.1 0 12.9 5.8 12.9 12.9s-5.8 12.9-12.9 12.9H77.6z"
            fill="#36c5f0"></path></svg
        ><span id="slack-share-label"></span></button
      >
      <a
        class="action-btn"
        id="hd-png-btn"
        href="#"
        style="display:none;text-decoration:none;"
        title="Re-render this Atelier image at full resolution and export as PNG"
        >HD PNG</a
      >
      <button
        class="action-btn"
        id="re-extract-btn"
        type="button">Re-extract</button
      >
      <button
        class="action-btn action-btn--danger"
        id="delete-btn"
        type="button">Delete</button
      >
    </div>
  </div>

  <!-- Delete confirmation dialog -->
  <div class="dialog-overlay" id="delete-dialog" style="display:none;">
    <div class="dialog">
      <p>Delete this media item?</p>
      <p
        style="color: var(--color-muted); font-size: var(--text-sm); margin-top: var(--space-xs);"
      >
        This action cannot be undone.
      </p>
      <div class="dialog-actions">
        <button class="btn-cancel" id="delete-cancel">Cancel</button>
        <button class="btn-danger" id="delete-confirm">Delete</button>
      </div>
    </div>
  </div>
</Admin>

<!--
  These styles must be global (not Astro-scoped) because many of the elements
  they target are built at runtime via `innerHTML` (tag chips, source rows,
  the transcript <pre>, etc.). Scoped Astro CSS adds `data-astro-cid-*`
  attributes to selectors, and runtime-built nodes can't inherit those, so
  scoping silently breaks the styling for half this page. Card chrome itself
  comes from `.brutal-card` in admin.css; this block only owns page-specific
  arrangement + the look of content rendered into card bodies.
-->
<style is:global>

  /* All sections (brutal-cards + the threads-island wrapper + action
     row) are spaced via the page container's flex gap. Section labels
     live INSIDE each card's head bar; there are no external h2s above
     cards. */
  #detail-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  .detail-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .detail-header h1 {
    margin-bottom: 0;
    border-bottom: none;
    padding-bottom: 0;
    /* Page title can wrap long filenames on mobile without forcing
       overflow. */
    word-break: break-word;
    min-width: 0;
    flex: 1 1 auto;
  }

  /* Visually-hidden h2 — keeps the card aria-labelledby a real heading
     without putting a redundant "Preview and metadata" label on screen
     (the image IS the label). */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Preview + metadata laid out side-by-side inside a single brutal-card.
     Both columns start-aligned so the row never stretches to match the
     taller side — a 220px preview no longer leaves a 200px void next to
     a tall metadata column. */
  .preview-meta-grid {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) 1fr;
    gap: var(--space-md);
    padding: var(--space-sm);
    align-items: start;
  }
  @media (max-width: 720px) {
    .preview-meta-grid {
      grid-template-columns: 1fr;
    }
  }
  .preview-area {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-width: 0;
  }
  .preview-area img,
  .preview-area video {
    max-width: 100%;
    max-height: 320px;
    object-fit: contain;
  }
  .preview-area audio,
  .preview-area video {
    width: 100%;
  }
  .metadata-area {
    min-width: 0;
  }
  .preview-meta-card .field-row__label {
    /* Tighter label column inside the metadata pane; we're working
       with less horizontal real estate when sharing a row with the
       preview. */
    flex: 0 0 72px;
  }
  .preview-meta-card .disclosure {
    /* The disclosure sits as a full-width footer of the unified card.
       Override its default top border with the card's chrome 2px so it
       reads as a section divider, not a hairline. */
    border-top-width: 2px;
    border-top-color: var(--color-text);
  }

  /* Curation card — vote block above tags, divided by a thin rule. */
  .curation-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .curation-vote {
    /* Vote chip is loud by default (lg buttons + Acclaimed/Disavowed
       voter lists). The buttons + counts are what matters at-a-glance;
       hide the voter rows here so the card stays compact. Voter detail
       is still visible elsewhere (e.g. the search-result chip island). */
    min-height: 32px;
  }
  /* `!important` overrides VoteChip's component-scoped `.svelte-*`
     selector — equal specificity would otherwise depend on stylesheet
     order, which is brittle across builds. */
  .curation-card .vote-block__voters {
    display: none !important;
  }
  .curation-tags {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-top: var(--space-sm);
    border-top: 1px dotted var(--color-border);
  }
  .vote-chip-island {
    display: block;
  }
  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .tags-list:empty {
    display: none;
  }
  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border: 1px solid var(--color-border);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .tag-chip a {
    color: inherit;
    text-decoration: none;
  }
  .tag-chip button {
    background: none;
    border: none;
    color: #c00;
    cursor: pointer;
    font-size: 1rem;
    padding: 0 2px;
    line-height: 1;
    /* iOS tap target */
    min-width: 24px;
    min-height: 24px;
  }
  .tag-chip button:hover {
    color: #a00;
  }
  .tag-add {
    display: flex;
    gap: var(--space-xs);
    position: relative;
  }
  .tag-add input {
    flex: 1;
    min-width: 0;
    padding: 6px 10px;
    font-family: var(--font-mono);
    /* iOS Safari zooms in on focus when input font-size < 16px. */
    font-size: 16px;
    border: 2px solid var(--color-text);
    background: var(--color-bg);
    color: var(--color-text);
    min-height: 36px;
  }
  .tag-add input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
  .tag-suggestions {
    position: absolute;
    top: 100%;
    left: 0;
    right: 60px;
    background: var(--color-bg);
    border: 2px solid var(--color-text);
    border-top: none;
    max-height: 150px;
    overflow-y: auto;
    z-index: 10;
  }
  .tag-suggestion {
    padding: 6px 10px;
    font-size: var(--text-sm);
    cursor: pointer;
    min-height: 36px;
  }
  .tag-suggestion:hover,
  .tag-suggestion:focus-visible {
    background: var(--color-surface-2);
  }

  /* Provenance card */
  .provenance-card .field-row__value a {
    color: var(--color-accent);
  }
  .provenance-card .field-row__value a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .inputs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--space-xs);
    margin-top: 4px;
  }
  .input-card {
    border: 1px solid var(--color-border);
    padding: var(--space-xs);
    font-size: var(--text-sm);
  }
  .input-thumb {
    width: 100%;
    max-height: 120px;
    object-fit: contain;
    display: block;
    margin-bottom: 4px;
  }
  .input-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .input-info a {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Extracted-text card collapse + Show all toggle */
  .extracted-text-card .brutal-card__body {
    position: relative;
    max-height: 240px;
    overflow: hidden;
  }
  .extracted-text-card .brutal-card__body[data-expanded='true'] {
    max-height: 600px;
    overflow: auto;
  }
  .extracted-text-card pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--color-text);
  }
  .extracted-text-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-surface)
    );
    pointer-events: none;
  }
  .extracted-text-card
    .brutal-card__body[data-expanded='true']
    .extracted-text-fade {
    display: none;
  }
  .extracted-text-toggle {
    display: block;
    width: 100%;
    padding: 8px;
    border: none;
    border-top: 2px solid var(--color-text);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    cursor: pointer;
    min-height: 36px;
  }
  .extracted-text-toggle:hover {
    background: var(--color-surface-2);
  }
  .extracted-text-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  /* Action bar — primary commands cluster left, Delete pushes right.
     No `margin-top` needed; the page container's flex gap handles
     spacing between every section. */
  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 2px solid var(--color-text);
    align-items: center;
  }
  .detail-actions .action-btn--danger {
    margin-left: auto;
  }
  @media (max-width: 720px) {
    /* On narrow viewports `margin-left: auto` still aligns danger right
       within the row, which keeps it visually demoted from primary
       commands while every button stays tap-friendly. */
    .detail-actions .action-btn {
      min-height: 40px;
    }
  }
</style>


<script>
  import { addItemsToWorkspace } from '../../../lib/workspace';
  import { mount, unmount } from 'svelte';
  import Threads from '../../../components/Threads.svelte';
  import LatentLinks from '../../../components/LatentLinks.svelte';
  import VoteChip from '../../../components/VoteChip.svelte';

  let threadsInstance: any = null;
  let latentLinksInstance: any = null;
  let voteChipInstance: any = null;

  document.addEventListener('astro:before-swap', () => {
    if (threadsInstance) {
      try {
        unmount(threadsInstance);
      } catch {}
      threadsInstance = null;
    }
    if (latentLinksInstance) {
      try {
        unmount(latentLinksInstance);
      } catch {}
      latentLinksInstance = null;
    }
    if (voteChipInstance) {
      try {
        unmount(voteChipInstance);
      } catch {}
      voteChipInstance = null;
    }
  });

  document.addEventListener('astro:page-load', async () => {
    const contentEl = document.getElementById('detail-content');
    if (!contentEl) return;

    const user = await (window as any).__authReady;
    if (!user) return;

    const loadingEl = document.getElementById('detail-loading')!;
    const errorEl = document.getElementById('detail-error')!;

    const params = new URLSearchParams(window.location.search);
    const mediaId = params.get('id');
    if (!mediaId) {
      loadingEl.style.display = 'none';
      errorEl.textContent = 'No media ID provided';
      errorEl.style.display = 'block';
      return;
    }

    // Threads island is mounted AFTER media loads so we can pass the
    // filename through as `defaultTitle` (used when the user starts the
    // discussion with no prior thread — auto-titled "Discussion: <filename>").
    function mountThreads(filename: string) {
      const threadsTarget = document.getElementById('threads-island');
      if (!threadsTarget) return;
      if (threadsInstance) {
        try {
          unmount(threadsInstance);
        } catch {}
        threadsInstance = null;
      }
      threadsTarget.innerHTML = '';
      threadsInstance = mount(Threads, {
        target: threadsTarget,
        props: {
          anchorType: 'media_item',
          anchorId: mediaId,
          title: 'Discussion',
          singleThread: true,
          defaultTitle: `Discussion: ${filename || 'untitled'}`,
          currentUserId: user?.id ?? null,
        },
      });
    }

    async function mountVoteChip(item: any) {
      const target = document.getElementById('vote-chip-island');
      if (!target) return;
      if (voteChipInstance) {
        try {
          unmount(voteChipInstance);
        } catch {}
        voteChipInstance = null;
      }
      target.innerHTML = '';
      // Detail-page payload doesn't carry vote fields yet (server only puts
      // them in the search doc); fetch the voters + the caller's own vote
      // state in parallel before mounting so the chip lands populated.
      const [votersRes, mineRes] = await Promise.all([
        fetch(`/api/search/${encodeURIComponent(mediaId)}/voters`, {
          credentials: 'include',
        }).then((r) => (r.ok ? r.json() : { upvoters: [], downvoters: [] })),
        fetch('/api/search/votes/mine', { credentials: 'include' }).then((r) =>
          r.ok ? r.json() : { up: [], down: [] },
        ),
      ]);
      const myVote: -1 | 0 | 1 = mineRes.up?.includes(mediaId)
        ? 1
        : mineRes.down?.includes(mediaId)
          ? -1
          : 0;
      voteChipInstance = mount(VoteChip, {
        target,
        props: {
          mediaId,
          upCount: (votersRes.upvoters || []).length,
          downCount: (votersRes.downvoters || []).length,
          upvoters: votersRes.upvoters || [],
          downvoters: votersRes.downvoters || [],
          myVote,
          currentUserId: user?.id ?? null,
          size: 'lg',
        },
      });
    }

    // Mount the cross-Latent links island for this media item
    const linksTarget = document.getElementById('latent-links-island');
    if (linksTarget) {
      if (latentLinksInstance) {
        try {
          unmount(latentLinksInstance);
        } catch {}
        latentLinksInstance = null;
      }
      linksTarget.innerHTML = '';
      latentLinksInstance = mount(LatentLinks, {
        target: linksTarget,
        props: { mediaItemId: mediaId, readOnly: true },
      });
    }

    let currentItem: any = null;

    async function loadMedia() {
      try {
        const res = await fetch(`/api/media/${mediaId}`, {
          credentials: 'include',
        });
        if (!res.ok) throw new Error('Failed to load media');
        currentItem = await res.json();
        loadingEl.style.display = 'none';
        contentEl.style.display = 'block';
        renderDetail();
        mountThreads(currentItem.filename || 'untitled');
        mountVoteChip(currentItem);
        // Bookmark star
        const bm = (window as any).__bookmarks;
        const starEl = document.getElementById('detail-bm-star');
        if (bm && starEl) {
          starEl.dataset.bmType = 'media_item';
          starEl.dataset.bmId = mediaId;
          starEl.style.display = '';
          bm.check('media_item', [mediaId]).then((set: Set<string>) => {
            if (set.has(mediaId)) {
              starEl.classList.add('bookmarked');
              starEl.setAttribute('title', 'Remove bookmark');
            }
          });
          starEl.addEventListener('click', () => {
            bm.toggle('media_item', mediaId);
          });
        }
      } catch (err: any) {
        loadingEl.style.display = 'none';
        errorEl.textContent = err.message;
        errorEl.style.display = 'block';
      }
    }

    function formatSize(bytes: number): string {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function renderRelatedCard(r: any): string {
      const thumbUrl =
        r.media_type === 'image' ? `/api/media/${r.id}/thumbnail` : null;
      return `
      <div class="input-card">
        ${thumbUrl ? `<a href="/admin/search/detail?id=${r.id}"><img class="input-thumb" src="${thumbUrl}" alt="${r.filename}"></a>` : ''}
        <div class="input-info">
          <a href="/admin/search/detail?id=${r.id}" style="color: var(--color-accent); font-weight: bold;">${r.filename}</a>
          <span style="color: var(--color-muted); font-size: 0.65rem;">${r.media_type || ''}</span>
          ${r.slack_link ? `<a href="${r.slack_link}" target="_blank" style="color: var(--color-muted); font-size: 0.65rem;">Slack</a>` : ''}
        </div>
      </div>`;
    }

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function fieldRow(label: string, valueHtml: string): string {
      return `<div class="field-row"><div class="field-row__label">${label}</div><div class="field-row__value">${valueHtml}</div></div>`;
    }

    // Color-bucket classifier preserved from the legacy metadata renderer —
    // groups a hex into one of ~12 named buckets for the color-filter
    // search links.
    function hexToColorGroup(c: string): string {
      const hex = c.replace('#', '');
      const r = parseInt(hex.substring(0, 2), 16);
      const g = parseInt(hex.substring(2, 4), 16);
      const b = parseInt(hex.substring(4, 6), 16);
      const max = Math.max(r, g, b);
      const min = Math.min(r, g, b);
      const l = (r + g + b) / (3 * 255);
      const sat = max > 0 ? (max - min) / max : 0;
      if (l < 0.1) return 'black';
      if (l > 0.9) return 'white';
      if (sat < 0.1) return 'gray';
      let h = 0;
      if (max !== min) {
        if (max === r) h = 60 * (((g - b) / (max - min)) % 6);
        else if (max === g) h = 60 * ((b - r) / (max - min) + 2);
        else h = 60 * ((r - g) / (max - min) + 4);
      }
      if (h < 0) h += 360;
      if (sat < 0.3 && h > 10 && h < 50) return l < 0.45 ? 'brown' : 'beige';
      if (sat < 0.2) return 'gray';
      if (h < 10 || h >= 350) return 'red';
      if (h < 35) return 'orange';
      if (h < 55) return 'yellow';
      if (h < 160) return 'green';
      if (h < 195) return 'teal';
      if (h < 260) return 'blue';
      if (h < 300) return 'purple';
      return 'pink';
    }

    // Build the visible-by-default Metadata field list, plus the chrome
    // (hash / MIME / description / timestamps) tucked behind a <details>.
    // Includes an Extraction row that surfaces failures inline.
    function renderMetadata(item: any, atelierLabel: string | null) {
      const bodyEl = document.getElementById('metadata-body')!;
      const chromeBodyEl = document.getElementById('metadata-chrome-body')!;

      const rows: string[] = [];

      rows.push(fieldRow('Type', escapeHtml(item.media_type || '--')));

      // Size + duration combined into one terse row when both are known.
      const sizeStr = item.file_size_bytes ? formatSize(item.file_size_bytes) : null;
      const durSec =
        item.video_meta?.duration_seconds ??
        item.audio_meta?.duration_seconds ??
        null;
      const durStr = durSec != null ? `${durSec.toFixed(1)}s` : null;
      const sizeRow = [sizeStr, durStr].filter(Boolean).join(' · ');
      if (sizeRow) rows.push(fieldRow('Size', escapeHtml(sizeRow)));

      // Dimensions for visual media.
      const w = item.image_meta?.width ?? item.video_meta?.width;
      const h = item.image_meta?.height ?? item.video_meta?.height;
      if (w || h) rows.push(fieldRow('Dim', `${w ?? '?'} × ${h ?? '?'}`));

      // Audio specifics — sample rate / channels / bit depth combined
      // into one line; bit_depth is rarely interesting so it tags onto
      // the same row instead of getting its own.
      if (item.audio_meta) {
        const a = item.audio_meta;
        const audioBits = [
          a.sample_rate ? `${a.sample_rate} Hz` : null,
          a.channels ? `${a.channels}ch` : null,
          a.bit_depth ? `${a.bit_depth}-bit` : null,
        ]
          .filter(Boolean)
          .join(' · ');
        if (audioBits) rows.push(fieldRow('Audio', escapeHtml(audioBits)));
      }
      if (item.video_meta?.fps) {
        rows.push(fieldRow('FPS', String(item.video_meta.fps)));
      }
      if (item.image_meta?.format) {
        rows.push(fieldRow('Format', escapeHtml(item.image_meta.format)));
      }

      // Palette — swatches + clickable color-group chips. Atelier outputs
      // often skip color extraction so guard for that.
      const dc = item.image_meta?.dominant_colors;
      if (dc) {
        try {
          const colors: string[] =
            typeof dc === 'string' ? JSON.parse(dc) : dc || [];
          if (colors.length > 0) {
            const swatches = colors
              .map(
                (c) =>
                  `<span style="display:inline-block;width:24px;height:24px;background:${escapeHtml(c)};border:1px solid var(--color-border);"></span>`,
              )
              .join(' ');
            rows.push(
              fieldRow(
                'Palette',
                `<div style="display:flex;gap:4px;align-items:center;flex-wrap:wrap;">${swatches}</div>`,
              ),
            );
            const groups = [...new Set(colors.map(hexToColorGroup))];
            const groupLinks = groups
              .map(
                (g) =>
                  `<a href="/admin/search?colorgroup=${encodeURIComponent(g)}" class="tag-chip">${escapeHtml(g)}</a>`,
              )
              .join(' ');
            rows.push(
              fieldRow(
                'Colors',
                `<div style="display:flex;gap:4px;flex-wrap:wrap;">${groupLinks}</div>`,
              ),
            );
          }
        } catch {}
      }

      if (item.created_at) {
        rows.push(
          fieldRow(
            'Created',
            escapeHtml(new Date(item.created_at).toLocaleDateString()),
          ),
        );
      }

      // Extraction row — folded in from the old separate section. 95% of
      // items have no failures, so most renders just show OK in green.
      const failures = item.extraction_failures || [];
      const unresolved = failures.filter((f: any) => !f.resolved);
      if (failures.length === 0) {
        rows.push(
          fieldRow('Extraction', `<span class="status-pill status-pill--ok">OK</span>`),
        );
      } else if (unresolved.length === 0) {
        rows.push(
          fieldRow(
            'Extraction',
            `<span class="status-pill status-pill--ok">OK</span> <span style="color:var(--color-muted);font-size:0.7rem;">(${failures.length} resolved)</span>`,
          ),
        );
      } else {
        const detail = unresolved
          .map(
            (f: any) =>
              `<div style="font-size:0.7rem;margin-top:2px;"><strong>${escapeHtml(f.extraction_type || '?')}:</strong> ${escapeHtml(f.error_message || `failed after ${f.attempts} attempt${f.attempts === 1 ? '' : 's'}`)}</div>`,
          )
          .join('');
        rows.push(
          fieldRow(
            'Extraction',
            `<span class="status-pill status-pill--fail">${unresolved.length} failed</span>${detail}`,
          ),
        );
      }

      bodyEl.innerHTML = rows.join('');

      // ── File chrome (collapsed disclosure): the boring data you almost
      // never need but still want one click away.
      const chromeRows: string[] = [];
      chromeRows.push(
        fieldRow('Filename', escapeHtml(item.filename || '--')),
      );
      chromeRows.push(fieldRow('MIME', escapeHtml(item.mime_type || '--')));
      chromeRows.push(
        fieldRow(
          'Bytes',
          item.file_size_bytes
            ? escapeHtml(String(item.file_size_bytes))
            : '--',
        ),
      );
      chromeRows.push(
        fieldRow(
          'Description',
          atelierLabel ||
            (item.description ? escapeHtml(item.description) : '--'),
        ),
      );
      if (item.updated_at && item.updated_at !== item.created_at) {
        chromeRows.push(
          fieldRow(
            'Modified',
            escapeHtml(new Date(item.updated_at).toLocaleString()),
          ),
        );
      }
      chromeRows.push(
        fieldRow(
          'Created',
          escapeHtml(
            item.created_at
              ? new Date(item.created_at).toLocaleString()
              : '--',
          ),
        ),
      );
      chromeRows.push(
        fieldRow(
          'SHA-256',
          `<code style="font-size:0.65rem;color:var(--color-muted);word-break:break-all;">${escapeHtml(item.sha256 || '--')}</code>`,
        ),
      );
      chromeBodyEl.innerHTML = chromeRows.join('');
    }

    // Build the Provenance card: Origin (sources) + Lineage
    // (inputs/outputs). Linked latents are mounted as a Svelte island and
    // stay outside this function.
    async function renderProvenance(item: any) {
      const rowsEl = document.getElementById('provenance-rows')!;
      const rows: string[] = [];

      const sources = item.sources || [];
      if (sources.length === 0) {
        rows.push(fieldRow('Origin', '<em style="color:var(--color-muted);">unknown</em>'));
      } else {
        rows.push(
          fieldRow(
            'Origin',
            sources
              .map((s: any) => {
                const kindLabel =
                  ({
                    slack_file: 'Slack',
                    slack_link: 'Slack',
                    upload: 'Upload',
                    job_output: 'Job',
                  } as Record<string, string>)[s.source_type] ||
                  s.source_type ||
                  'Source';
                let meta: any = null;
                try {
                  meta = s.source_metadata
                    ? JSON.parse(s.source_metadata)
                    : null;
                } catch {}
                const parts: string[] = [];
                parts.push(escapeHtml(kindLabel));
                if (s.source_channel)
                  parts.push(`#${escapeHtml(s.source_channel)}`);
                if (meta?.poster) parts.push(`@${escapeHtml(meta.poster)}`);
                if (s.created_at)
                  parts.push(
                    escapeHtml(
                      new Date(s.created_at).toLocaleDateString(),
                    ),
                  );
                // Slack reactions are sometimes the *reason* an item got
                // pulled into the archive — surface them inline rather
                // than hiding the count in a sub-field.
                if (s.reaction_count) {
                  parts.push(`${s.reaction_count} reaction${s.reaction_count === 1 ? '' : 's'}`);
                }
                let line = parts.join(' · ');
                if (s.slack_link) {
                  line += ` · <a href="${escapeHtml(s.slack_link)}" target="_blank" rel="noopener">↗ Slack</a>`;
                }
                if (s.source_url) {
                  line += ` · <a href="${escapeHtml(s.source_url)}" target="_blank" rel="noopener">↗ link</a>`;
                }
                if (meta?.job_id) {
                  const jobLabel = `${meta.app_name || 'job'}${meta.recipe ? ' / ' + meta.recipe : ''}`;
                  line += ` · <a href="/admin/jobs/detail?id=${encodeURIComponent(meta.job_id)}">${escapeHtml(jobLabel)}</a>`;
                }
                if (s.slack_message_text) {
                  line += `<div style="font-size:0.7rem;color:var(--color-muted);margin-top:2px;">${escapeHtml(s.slack_message_text)}</div>`;
                }
                return `<div>${line}</div>`;
              })
              .join(''),
          ),
        );
      }

      // Lineage — pulled from /api/media/{id}/related, async. Render a
      // placeholder first so the row reserves space, then fill in once
      // the fetch resolves.
      rows.push(
        fieldRow(
          'Lineage',
          '<span id="provenance-lineage" style="color:var(--color-muted);font-style:italic;">checking…</span>',
        ),
      );
      rowsEl.innerHTML = rows.join('');

      try {
        const relResp = await fetch(`/api/media/${mediaId}/related`, {
          credentials: 'include',
        });
        if (!relResp.ok) {
          document.getElementById('provenance-lineage')!.innerHTML =
            '<em style="color:var(--color-muted);">none</em>';
          return;
        }
        const related = await relResp.json();
        const ins: any[] = related.inputs || [];
        const outs: any[] = related.outputs || [];
        const lineageEl = document.getElementById('provenance-lineage')!;
        if (ins.length === 0 && outs.length === 0) {
          lineageEl.innerHTML =
            '<em style="color:var(--color-muted);">none</em>';
          return;
        }
        const sections: string[] = [];
        if (ins.length > 0) {
          sections.push(
            `<div><strong style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.5pt;color:var(--color-muted);">Inputs (${ins.length})</strong><div class="inputs-grid">${ins.map(renderRelatedCard).join('')}</div></div>`,
          );
        }
        if (outs.length > 0) {
          sections.push(
            `<div style="margin-top:6px;"><strong style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.5pt;color:var(--color-muted);">Outputs (${outs.length})</strong><div class="inputs-grid">${outs.map(renderRelatedCard).join('')}</div></div>`,
          );
        }
        lineageEl.outerHTML = `<div>${sections.join('')}</div>`;
      } catch {
        const el = document.getElementById('provenance-lineage');
        if (el)
          el.innerHTML = '<em style="color:var(--color-muted);">none</em>';
      }
    }

    async function renderDetail() {
      const item = currentItem;
      document.getElementById('detail-title')!.textContent =
        item.filename || 'Untitled';

      // Parse atelier metadata from description (JSON blob stored on save).
      // The pretty label flows into both the file-chrome Description row
      // and the HD PNG button visibility check.
      let atelierMeta: any = null;
      try {
        if (item.description?.startsWith('{"atelier":')) {
          const parsed = JSON.parse(item.description);
          if (parsed.atelier === 'bullethole' || parsed.atelier === 'punctum') {
            atelierMeta = parsed;
          }
        }
      } catch {}
      const botLabel = atelierMeta?.bot
        ? (
            {
              bullethole: 'Bullet Hole',
              stencil: 'Stencil',
              bw: 'BW',
              cyanotype: 'Cyanotype',
              wobbleeye: 'Wobble Eye',
            } as Record<string, string>
          )[atelierMeta.bot] || atelierMeta.bot
        : atelierMeta?.atelier === 'bullethole'
          ? 'Bullet Hole'
          : null;
      const atelierLabel = atelierMeta
        ? `${botLabel || 'Punctum'}${atelierMeta.seed ? ' · seed ' + atelierMeta.seed : ''}`
        : null;

      // HD PNG button — only for Atelier images with a known source
      const hdPngBtn = document.getElementById(
        'hd-png-btn',
      ) as HTMLAnchorElement;
      if (atelierMeta?.atelier === 'bullethole' && atelierMeta.source_id) {
        const p = new URLSearchParams({
          autoexport: 'png',
          bot: 'bullethole',
          source0: atelierMeta.source_id,
          seed: String(atelierMeta.seed ?? 0),
          chaos: String(atelierMeta.chaos ?? 0.5),
          placement: atelierMeta.placement ?? 'random',
          effect: atelierMeta.effect ?? 'rotate',
          jitter: String(atelierMeta.jitter ?? 0),
          no_overlap: String(atelierMeta.no_overlap ?? false),
        });
        hdPngBtn.href = `/admin/atelier/punctum?${p}`;
        hdPngBtn.style.display = '';
      } else if (atelierMeta?.atelier === 'punctum') {
        const sourceIds: string[] = atelierMeta.source_ids || [];
        if (sourceIds.length > 0 && sourceIds[0]) {
          const p = new URLSearchParams({
            autoexport: 'png',
            bot: atelierMeta.bot || 'bullethole',
          });
          sourceIds.forEach((id: string, i: number) => {
            if (id) p.set(`source${i}`, id);
          });
          if (atelierMeta.seed) p.set('seed', String(atelierMeta.seed));
          if (atelierMeta.output_idx)
            p.set('output_idx', String(atelierMeta.output_idx));
          const params = atelierMeta.params || {};
          Object.entries(params).forEach(([k, v]) => p.set(k, String(v)));
          hdPngBtn.href = `/admin/atelier/punctum?${p}`;
          hdPngBtn.style.display = '';
        }
      }

      // Slack share button (image / audio only)
      const slackBtn = document.getElementById(
        'slack-share-btn',
      ) as HTMLButtonElement;
      const slackLabel = document.getElementById(
        'slack-share-label',
      ) as HTMLSpanElement;
      if (item.media_type === 'image' || item.media_type === 'audio') {
        const slackChannel =
          item.media_type === 'image' ? 'img-junkyard' : 'sample-sale';
        slackLabel.textContent = `#${slackChannel}`;
        slackBtn.style.display = '';
        slackBtn.addEventListener('click', async () => {
          slackBtn.disabled = true;
          slackLabel.textContent = 'Sending…';
          try {
            const res = await fetch(`/api/media/${mediaId}/slack-share`, {
              method: 'POST',
              credentials: 'include',
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.detail ?? 'Share failed');
            slackBtn.innerHTML = 'Sent ✓';
            (window as any).toast?.success(
              data.already_shared
                ? `Already in #${data.channel}`
                : `Sent to #${data.channel}`,
            );
          } catch (e: any) {
            slackBtn.disabled = false;
            slackLabel.textContent = `#${slackChannel}`;
            (window as any).toast?.error(
              'Share failed: ' + (e?.message ?? String(e)),
            );
          }
        });
      }

      // Download button
      const downloadBtn = document.getElementById(
        'download-btn',
      ) as HTMLAnchorElement;
      const fileUrl = `/api/media/${mediaId}/file`;
      downloadBtn.href = fileUrl;
      downloadBtn.style.display = '';

      // Preview
      const previewEl = document.getElementById('detail-preview')!;
      const thumbUrl = `/api/media/${mediaId}/thumbnail`;
      if (item.media_type === 'image') {
        previewEl.innerHTML = `<img src="${fileUrl}" alt="${escapeHtml(item.filename || '')}" />`;
      } else if (item.media_type === 'audio') {
        previewEl.innerHTML = `<audio controls src="${fileUrl}"></audio>`;
      } else if (item.media_type === 'video') {
        previewEl.innerHTML = `<video controls src="${fileUrl}" poster="${thumbUrl}" style="max-height:400px;"></video>`;
      } else {
        previewEl.innerHTML = `<span style="color: var(--color-muted); text-transform: uppercase;">No preview available</span>`;
      }

      renderMetadata(item, atelierLabel);
      renderTags();
      renderExtractedText(item);
      renderProvenance(item);
    }

    // Render OCR text / whisper transcript into the static extracted-text
    // card. Behaviour:
    //  - null/undefined field → hide section entirely (extraction hasn't run)
    //  - empty string → show "no text/speech detected" so it's clear that
    //    whisper/OCR ran but found nothing
    //  - non-empty → show with stats, Copy button, and collapse + Show all
    //    when over 400 chars
    function renderExtractedText(item: any) {
      const sectionEl = document.getElementById(
        'extracted-text-section',
      )! as HTMLElement;
      const headingEl = document.getElementById('extracted-text-heading')!;
      const statsEl = document.getElementById('extracted-text-stats')!;
      const copyBtn = document.getElementById(
        'extracted-text-copy',
      ) as HTMLButtonElement;
      const bodyEl = document.getElementById(
        'extracted-text-body',
      ) as HTMLElement;
      const toggleBtn = document.getElementById(
        'extracted-text-toggle',
      ) as HTMLButtonElement;

      let raw: string | null | undefined;
      let sectionHeading = 'Extracted Text';

      if (item.media_type === 'image' && item.image_meta) {
        raw = item.image_meta.caption;
        sectionHeading = 'OCR Text';
      } else if (item.media_type === 'audio' && item.audio_meta) {
        raw = item.audio_meta.transcript;
        sectionHeading = 'Transcript';
      } else if (item.media_type === 'video' && item.video_meta) {
        raw = item.video_meta.audio_transcript;
        sectionHeading = 'Transcript';
      }

      // Hide the card entirely when there's nothing to show — null/undefined
      // (extraction hasn't run) or empty string (it ran but found nothing).
      // Either way, no transcript = no card; we don't surface that as UI noise.
      const trimmed =
        raw === null || raw === undefined ? '' : String(raw).trim();
      if (trimmed.length === 0) {
        sectionEl.style.display = 'none';
        return;
      }

      sectionEl.style.display = '';
      headingEl.textContent = sectionHeading;

      const wordCount = trimmed.split(/\s+/).filter(Boolean).length;
      const charCount = trimmed.length;
      const isLong = charCount > 400;

      statsEl.textContent = `${wordCount} word${wordCount === 1 ? '' : 's'} · ${charCount} char${charCount === 1 ? '' : 's'}`;
      bodyEl.removeAttribute('data-empty');
      bodyEl.setAttribute('data-expanded', isLong ? 'false' : 'true');
      bodyEl.innerHTML = `<pre>${escapeHtml(trimmed)}</pre>${isLong ? '<div class="extracted-text-fade"></div>' : ''}`;

      copyBtn.style.display = '';
      copyBtn.onclick = async () => {
        try {
          await navigator.clipboard.writeText(trimmed);
          const original = copyBtn.textContent;
          copyBtn.textContent = 'Copied ✓';
          setTimeout(() => {
            copyBtn.textContent = original;
          }, 1500);
        } catch {
          (window as any).toast?.error('Copy failed');
        }
      };

      if (isLong) {
        toggleBtn.style.display = '';
        toggleBtn.textContent = 'Show all';
        toggleBtn.onclick = () => {
          const expanded = bodyEl.getAttribute('data-expanded') === 'true';
          bodyEl.setAttribute('data-expanded', String(!expanded));
          toggleBtn.textContent = expanded ? 'Show all' : 'Collapse';
        };
      } else {
        toggleBtn.style.display = 'none';
      }
    }

    function renderTags() {
      const tagsEl = document.getElementById('tags-list')!;
      const tags: string[] = currentItem.tags || [];
      // Empty state styled via `.tags-list:empty::before` in CSS, so an
      // empty innerHTML is sufficient here.
      tagsEl.innerHTML = tags
        .map(
          (tag) =>
            `<span class="tag-chip"><a href="/admin/search?tag=${encodeURIComponent(tag)}">${escapeHtml(tag)}</a><button data-remove-tag="${escapeHtml(tag)}" aria-label="Remove tag ${escapeHtml(tag)}">&times;</button></span>`,
        )
        .join('');
    }

    // Tag autocomplete
    let suggestTimeout: ReturnType<typeof setTimeout>;
    const tagInput = document.getElementById('tag-input') as HTMLInputElement;
    const suggestionsEl = document.getElementById('tag-suggestions')!;

    tagInput?.addEventListener('input', () => {
      clearTimeout(suggestTimeout);
      const q = tagInput.value.trim();
      if (q.length < 1) {
        suggestionsEl.style.display = 'none';
        return;
      }
      suggestTimeout = setTimeout(async () => {
        try {
          const res = await fetch(
            `/api/tags/suggest?q=${encodeURIComponent(q)}`,
            { credentials: 'include' },
          );
          if (res.ok) {
            const suggestions: any[] = await res.json();
            if (suggestions.length > 0) {
              suggestionsEl.innerHTML = suggestions
                .map(
                  (s) =>
                    `<div class="tag-suggestion" data-tag="${s.tag}">${s.tag} (${s.usage_count})</div>`,
                )
                .join('');
              suggestionsEl.style.display = 'block';
            } else {
              suggestionsEl.style.display = 'none';
            }
          }
        } catch {
          suggestionsEl.style.display = 'none';
        }
      }, 200);
    });

    suggestionsEl?.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest(
        '.tag-suggestion',
      ) as HTMLElement | null;
      if (el) {
        addTag(el.dataset.tag!);
        suggestionsEl.style.display = 'none';
        tagInput.value = '';
      }
    });

    document.getElementById('add-tag-btn')?.addEventListener('click', () => {
      const tag = tagInput.value.trim();
      if (tag) {
        addTag(tag);
        tagInput.value = '';
        suggestionsEl.style.display = 'none';
      }
    });

    tagInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const tag = tagInput.value.trim();
        if (tag) {
          addTag(tag);
          tagInput.value = '';
          suggestionsEl.style.display = 'none';
        }
      }
    });

    async function addTag(tag: string) {
      try {
        await fetch(`/api/media/${mediaId}/tags`, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tags: [tag] }),
        });
        if (!currentItem.tags) currentItem.tags = [];
        if (!currentItem.tags.includes(tag)) currentItem.tags.push(tag);
        renderTags();
      } catch {
        (window as any).toast.error('Failed to add tag');
      }
    }

    // Remove tag
    document
      .getElementById('tags-list')
      ?.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest(
          '[data-remove-tag]',
        ) as HTMLElement | null;
        if (!btn) return;
        const tag = btn.dataset.removeTag!;
        try {
          await fetch(`/api/media/${mediaId}/tags/${encodeURIComponent(tag)}`, {
            method: 'DELETE',
            credentials: 'include',
          });
          currentItem.tags = (currentItem.tags || []).filter(
            (t: string) => t !== tag,
          );
          renderTags();
        } catch {
          (window as any).toast.error('Failed to remove tag');
        }
      });

    // Add to workspace
    document
      .getElementById('add-to-workspace-btn')
      ?.addEventListener('click', async () => {
        const data = await addItemsToWorkspace([mediaId]);
        if (data) {
          (window as any).toast.success(
            data.already_present > 0
              ? 'Already in workspace'
              : 'Added to workspace',
          );
        } else {
          (window as any).toast.error('Failed to add to workspace');
        }
      });

    // Re-extract
    document
      .getElementById('re-extract-btn')
      ?.addEventListener('click', async () => {
        try {
          await fetch('/api/media/batch/re-extract', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ media_ids: [mediaId] }),
          });
          (window as any).toast.success('Re-extraction queued');
          loadMedia();
        } catch {
          (window as any).toast.error('Re-extraction failed');
        }
      });

    // Delete
    document.getElementById('delete-btn')?.addEventListener('click', () => {
      document.getElementById('delete-dialog')!.style.display = 'flex';
    });
    document.getElementById('delete-cancel')?.addEventListener('click', () => {
      document.getElementById('delete-dialog')!.style.display = 'none';
    });
    document
      .getElementById('delete-confirm')
      ?.addEventListener('click', async () => {
        try {
          const res = await fetch(`/api/media/${mediaId}`, {
            method: 'DELETE',
            credentials: 'include',
          });
          if (res.ok) {
            window.location.href = '/admin/search';
          } else {
            (window as any).toast.error('Delete failed');
          }
        } catch {
          (window as any).toast.error('Delete failed');
        }
        document.getElementById('delete-dialog')!.style.display = 'none';
      });

    loadMedia();
  });
</script>
