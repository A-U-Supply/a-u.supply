---
import Admin from '../../../layouts/Admin.astro';
import BrutalSelect from '../../../components/BrutalSelect.astro';
---

<Admin title="Slop Bucket" current="slop">
  <div class="page-header">
    <h1>Slop Bucket</h1>
    <div class="slop-summary" id="slop-summary"></div>
  </div>

  <div id="slop-batch-banner" class="slop-batch-banner" style="display:none;">
    <span>Filtered to batch <code id="slop-batch-id"></code></span>
    <a
      class="action-btn"
      href="/admin/search/slop"
      style="text-decoration:none;">Clear filter</a
    >
  </div>

  <div class="slop-controls">
    <BrutalSelect id="filter-type" ariaLabel="Filter by media type">
      <option value="">All Types</option>
      <option value="image">Image</option>
      <option value="audio">Audio</option>
      <option value="video">Video</option>
    </BrutalSelect>
    <BrutalSelect id="filter-app" ariaLabel="Filter by app">
      <option value="">All Apps</option>
    </BrutalSelect>
    <button
      class="action-btn"
      id="btn-group-toggle"
      aria-pressed="false"
      title="Toggle group by job">Group by job</button
    >
    <button class="action-btn" id="btn-refresh">Refresh</button>
  </div>

  <div class="selection-bar" id="selection-bar" style="display:none;">
    <label
      class="selection-toggle"
      title="Apply bulk actions to every page that matches the current filter, not just this page."
    >
      <input type="checkbox" id="bulk-all-pages" />
      <span class="selection-toggle__label">Across all pages</span>
    </label>
    <span class="selection-count" id="selection-count"></span>
    <div class="selection-actions" id="selection-actions">
      <button class="action-btn" id="btn-play-all" style="display:none;"
        >Play All</button
      >
      <button class="action-btn" id="btn-index-all" style="display:none;"
        >Index All</button
      >
      <button
        class="action-btn action-btn--danger"
        id="btn-discard-all"
        style="display:none;">Discard All</button
      >
    </div>
  </div>

  <div
    id="slop-pagination"
    class="pagination"
    style="display:none;"
    aria-label="Slop pagination"
  >
  </div>

  <div id="slop-loading" style="color: var(--color-muted);">
    <span class="loading-dots">Loading</span>
  </div>
  <div id="slop-error" class="login-error" style="display:none;"></div>
  <div
    id="slop-empty"
    style="display:none; color: var(--color-muted); padding: var(--space-lg) 0; text-align: center;"
  >
    No unindexed outputs. The bucket is empty.
  </div>

  <div id="slop-grid" class="slop-grid" style="display:none;"></div>

  <!-- Index metadata dialog -->
  <div class="dialog-overlay" id="index-dialog" style="display:none;">
    <div
      class="dialog"
      style="max-width: 560px; max-height: 90vh; overflow-y: auto;"
    >
      <h3>Index to Search</h3>
      <div id="idx-info" class="idx-info"></div>
      <input id="idx-output-index" type="hidden" />
      <div class="idx-field">
        <label>Title</label>
        <input
          id="idx-description"
          type="text"
          placeholder="Editable — auto-generated from job context"
        />
        <div class="idx-hint">
          Searchable title for these outputs. Edit freely.
        </div>
      </div>
      <div class="idx-field">
        <label>Notes</label>
        <textarea id="idx-notes" rows="2" placeholder="Optional freeform notes"
        ></textarea>
      </div>
      <div class="idx-field">
        <label>Additional Tags</label>
        <input id="idx-tags" type="text" placeholder="comma-separated" />
      </div>
      <div
        id="idx-auto-tags"
        class="idx-info"
        style="margin-top: var(--space-xs);"
      >
      </div>
      <div class="dialog-actions">
        <button class="btn-cancel" id="idx-cancel">Cancel</button>
        <button class="action-btn" id="idx-confirm">Index</button>
      </div>
    </div>
  </div>
</Admin>

<style>
  .page-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
  .slop-summary {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .slop-controls {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    flex-wrap: wrap;
  }
  .slop-batch-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 2px solid var(--color-fg);
    border-left-width: 6px;
    background: var(--color-surface);
    box-shadow: 2px 2px 0 var(--color-fg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .slop-batch-banner code {
    font-family: var(--font-mono);
    padding: 1px 6px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }

  /* Selection bar — adopts the brutalist look so the bulk actions are
     visually anchored above the grid. Same shape as failures /
     bookmarks / search. */
  .selection-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    padding: var(--space-xs) var(--space-sm);
    margin-top: var(--space-sm);
    border: 2px solid var(--color-fg);
    background: var(--color-surface);
    box-shadow: 2px 2px 0 var(--color-fg);
    font-family: var(--font-mono);
  }
  .selection-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    color: var(--color-muted);
    user-select: none;
  }
  .selection-toggle input[type='checkbox'] {
    width: 16px;
    height: 16px;
    accent-color: var(--color-fg);
    cursor: pointer;
  }
  .selection-count {
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .selection-actions {
    display: flex;
    gap: var(--space-xs);
    margin-left: auto;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .slop-batch-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }
    .selection-actions {
      margin-left: 0;
    }
    .slop-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    }
  }

  .slop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-md);
  }
  .slop-job-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }
  .slop-job-group summary {
    cursor: pointer;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-fg);
    color: var(--color-bg);
    border: 2px solid var(--color-fg);
    box-shadow: 2px 2px 0 var(--color-fg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .slop-job-group summary::-webkit-details-marker {
    display: none;
  }
  .slop-job-group .slop-grid {
    margin-top: var(--space-xs);
  }
  .slop-card {
    border: 2px solid var(--color-fg);
    background: var(--color-surface);
    box-shadow: 2px 2px 0 var(--color-fg);
    padding: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .slop-preview {
    width: 100%;
    height: auto;
    max-height: 320px;
    object-fit: contain;
    display: block;
    margin-bottom: var(--space-xs);
    background: var(--color-surface-2);
  }
  .slop-preview-btn {
    all: unset;
    display: block;
    width: 100%;
    cursor: zoom-in;
  }
  .slop-preview-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  video.slop-preview {
    max-height: 240px;
  }
  @media (max-width: 640px) {
    .slop-preview {
      max-height: 220px;
    }
    video.slop-preview {
      max-height: 180px;
    }
  }
  .slop-card .slop-name {
    font-weight: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .slop-card .slop-meta {
    color: var(--color-muted);
    font-size: 0.65rem;
    margin-top: 2px;
  }
  .slop-card .slop-job {
    font-size: 0.65rem;
    margin-top: 4px;
  }
  .slop-card .slop-job a {
    color: var(--color-fg);
    text-decoration: underline;
  }
  .slop-card .slop-actions {
    margin-top: var(--space-xs);
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }
  /* Status badges — token-driven so colors flip with the page theme. */
  .status-badge {
    display: inline-block;
    padding: 1px 6px;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    border: 1px solid currentColor;
  }
  .status-completed {
    color: var(--color-status-ok);
  }
  .status-failed {
    color: var(--color-status-fail);
  }
  .status-running {
    color: var(--color-accent);
  }
  .status-pending {
    color: var(--color-status-warn);
  }
  .status-cancelled {
    color: var(--color-muted);
    text-decoration: line-through;
  }
  .idx-info {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
    border-left: 2px solid var(--color-border);
    padding: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-sm);
    line-height: 1.5;
    white-space: pre-line;
  }
  .idx-field {
    margin-top: var(--space-sm);
  }
  .idx-field label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    margin-bottom: 2px;
  }
  .idx-field input,
  .idx-field textarea {
    width: 100%;
    padding: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    border: 2px solid var(--color-fg);
    box-shadow: 2px 2px 0 var(--color-fg);
    background: var(--color-bg);
    color: var(--color-fg);
    box-sizing: border-box;
  }
  .idx-field textarea {
    resize: vertical;
  }
  .idx-hint {
    color: var(--color-muted);
    font-size: 0.65rem;
    margin-top: 2px;
  }
</style>

<script>
  import {
    openImageViewer,
    jobOutputToViewerItem,
    triggerIndexDialogFor,
  } from '../../../lib/admin-viewer';
  import { renderPagination, wirePagination } from '../../../lib/pagination';

  document.addEventListener('astro:page-load', async () => {
    await (window as any).__authReady;

    let allOutputs: any[] = [];
    let pendingIndexIds: string[] = [];
    let pendingIndexJobId: string | null = null;
    let groupByJob = false;

    let currentPage = 1;
    const pageSize = 50;
    let totalOutputs = 0;

    const slopUrlParams = new URLSearchParams(window.location.search);
    const slopBatchId = slopUrlParams.get('batch_id');
    if (slopBatchId) {
      const banner = document.getElementById('slop-batch-banner')!;
      const idEl = document.getElementById('slop-batch-id')!;
      idEl.textContent = slopBatchId.slice(0, 8);
      banner.style.display = '';
    }

    // Group-by-job toggle (visual rendering only — bulk actions still
    // apply to the full filter / page / "across all pages" union).
    const groupBtn = document.getElementById(
      'btn-group-toggle',
    ) as HTMLButtonElement | null;
    groupBtn?.addEventListener('click', () => {
      groupByJob = !groupByJob;
      groupBtn.setAttribute('aria-pressed', groupByJob ? 'true' : 'false');
      renderGrid();
    });

    function formatSize(bytes: number): string {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function isPlayable(o: any): boolean {
      return o.media_type === 'audio' || o.media_type === 'video';
    }

    function downloadUrl(o: any): string {
      return `/api/jobs/${o.job_id}/outputs/${o.id}/download`;
    }

    function renderSlopPagination() {
      const pagEl = document.getElementById('slop-pagination') as HTMLElement;
      const totalPages = Math.max(1, Math.ceil(totalOutputs / pageSize));
      if (totalOutputs <= pageSize) {
        pagEl.style.display = 'none';
        return;
      }
      pagEl.style.display = '';
      pagEl.innerHTML = renderPagination({
        current: currentPage,
        total: totalPages,
        windowSize: 2,
        hrefFor: () => '#',
      });
    }

    // Wire pagination click → page change (replaces the prev/next listeners
    // that no longer exist with the BrutalPagination markup).
    const slopPagEl = document.getElementById('slop-pagination') as HTMLElement;
    wirePagination(slopPagEl, (page) => {
      currentPage = page;
      loadOutputs();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Fetch every output ID matching the current filter. Used by bulk actions
    // when "Across all pages" is checked, so we can index/discard/play beyond
    // just the currently rendered page.
    async function fetchAllMatchingIds(): Promise<string[]> {
      const mediaType = (
        document.getElementById('filter-type') as HTMLSelectElement
      ).value;
      const appName = (
        document.getElementById('filter-app') as HTMLSelectElement
      ).value;
      const params = new URLSearchParams();
      if (mediaType) params.set('media_type', mediaType);
      if (appName) params.set('app_name', appName);
      if (slopBatchId) params.set('batch_id', slopBatchId);
      const res = await fetch(`/api/jobs/outputs/unindexed/ids?${params}`, {
        credentials: 'include',
      });
      if (!res.ok) return [];
      const data = await res.json();
      return data.ids || [];
    }

    function isAllPages(): boolean {
      return (document.getElementById('bulk-all-pages') as HTMLInputElement)
        .checked;
    }

    // ---- Load outputs ----
    async function loadOutputs() {
      const loadingEl = document.getElementById('slop-loading')!;
      const errorEl = document.getElementById('slop-error')!;
      const emptyEl = document.getElementById('slop-empty')!;
      const gridEl = document.getElementById('slop-grid')!;
      const summaryEl = document.getElementById('slop-summary')!;

      loadingEl.style.display = '';
      errorEl.style.display = 'none';
      emptyEl.style.display = 'none';
      gridEl.style.display = 'none';

      const mediaType = (
        document.getElementById('filter-type') as HTMLSelectElement
      ).value;
      const appName = (
        document.getElementById('filter-app') as HTMLSelectElement
      ).value;

      const params = new URLSearchParams();
      if (mediaType) params.set('media_type', mediaType);
      if (appName) params.set('app_name', appName);
      if (slopBatchId) params.set('batch_id', slopBatchId);
      params.set('page', String(currentPage));
      params.set('per_page', String(pageSize));

      const res = await fetch(`/api/jobs/outputs/unindexed?${params}`, {
        credentials: 'include',
      });
      loadingEl.style.display = 'none';

      if (!res.ok) {
        errorEl.textContent = 'Failed to load outputs.';
        errorEl.style.display = '';
        return;
      }

      const data = await res.json();
      allOutputs = data.outputs;
      totalOutputs = data.total || 0;

      // Populate app filter dropdown (preserve selection)
      const appSelect = document.getElementById(
        'filter-app',
      ) as HTMLSelectElement;
      const currentApp = appSelect.value;
      appSelect.innerHTML = '<option value="">All Apps</option>';
      for (const name of data.app_names) {
        const opt = document.createElement('option');
        opt.value = name;
        opt.textContent = name;
        if (name === currentApp) opt.selected = true;
        appSelect.appendChild(opt);
      }

      renderSlopPagination();

      const selectionBar = document.getElementById('selection-bar')!;

      if (allOutputs.length === 0) {
        summaryEl.textContent =
          totalOutputs === 0
            ? ''
            : `Page ${currentPage} is empty. Go back a page.`;
        emptyEl.style.display = totalOutputs === 0 ? '' : 'none';
        selectionBar.style.display = 'none';
        document.getElementById('btn-index-all')!.style.display = 'none';
        document.getElementById('btn-discard-all')!.style.display = 'none';
        document.getElementById('btn-play-all')!.style.display = 'none';
        return;
      }

      // Stats strip: count + job_count + oldest age.
      const totalPages = Math.max(1, Math.ceil(totalOutputs / pageSize));
      const pageLabel =
        totalPages > 1 ? ` · page ${currentPage}/${totalPages}` : '';
      const oldestTs = allOutputs.reduce(
        (min: number, o: any) =>
          Math.min(min, Number(o.created_at_ts || Infinity)),
        Infinity,
      );
      let ageLabel = '';
      if (Number.isFinite(oldestTs)) {
        const ageDays = Math.floor((Date.now() / 1000 - oldestTs) / 86400);
        ageLabel =
          ageDays >= 1 ? ` · oldest ${ageDays}d ago` : ' · oldest <1d ago';
      }
      summaryEl.textContent = `${totalOutputs} output${totalOutputs !== 1 ? 's' : ''} across ${data.job_count} job${data.job_count !== 1 ? 's' : ''}${ageLabel}${pageLabel}`;

      // Show selection bar + bulk actions.
      selectionBar.style.display = '';
      document.getElementById('btn-index-all')!.style.display = '';
      document.getElementById('btn-discard-all')!.style.display = '';
      const playable = allOutputs.filter(isPlayable);
      document.getElementById('btn-play-all')!.style.display =
        playable.length > 0 ? '' : 'none';

      const sCount = document.getElementById('selection-count');
      if (sCount) {
        sCount.textContent = `${allOutputs.length} on this page`;
      }

      renderGrid();
    }

    function renderCard(o: any): string {
      const dlUrl = downloadUrl(o);
      const thumbUrl = `/api/jobs/${o.job_id}/outputs/${o.id}/thumbnail`;
      const thumbUrlSm = `${thumbUrl}?size=sm`;
      let preview = '';
      if (o.media_type === 'image') {
        preview = `<button class="slop-preview-btn" data-viewer-id="${o.id}" title="View" type="button"><img class="slop-preview" src="${thumbUrl}" srcset="${thumbUrlSm} 128w, ${thumbUrl} 400w" sizes="(max-width: 480px) 128px, 220px" alt="${o.filename}" loading="lazy" decoding="async"></button>`;
      } else if (o.media_type === 'video') {
        preview = `<video class="slop-preview" controls preload="none" src="${dlUrl}"></video>`;
      } else if (o.media_type === 'audio') {
        preview = `<audio controls preload="none" src="${dlUrl}" style="width:100%;margin-top:var(--space-xs);"></audio>`;
      }
      return `
        <div class="slop-card" data-output-id="${o.id}">
          ${preview}
          <div class="slop-name" title="${o.filename}">${o.filename}</div>
          <div class="slop-meta">
            ${o.media_type || 'unknown'} &middot; ${o.file_size_bytes ? formatSize(o.file_size_bytes) : '?'}
          </div>
          <div class="slop-job">
            <span class="status-badge status-${o.job_status}">${o.job_status}</span>
            ${o.job_app_name} &middot;
            <a href="/admin/jobs/detail?id=${o.job_id}">view job</a>
          </div>
          <div class="slop-actions">
            ${isPlayable(o) ? `<button class="action-btn" data-play="${o.id}">Play</button>` : ''}
            <a href="${dlUrl}" download="${o.filename}" class="action-btn" style="text-decoration:none;">Download</a>
            <button class="action-btn" data-index="${o.id}" data-job="${o.job_id}">Index</button>
            <button class="action-btn action-btn--danger" data-discard="${o.id}" data-job="${o.job_id}">Discard</button>
          </div>
        </div>`;
    }

    function renderGrid() {
      const gridEl = document.getElementById('slop-grid')!;
      if (groupByJob) {
        const groups = new Map<string, any[]>();
        for (const o of allOutputs) {
          const arr = groups.get(o.job_id) || [];
          arr.push(o);
          groups.set(o.job_id, arr);
        }
        const html: string[] = [];
        for (const [jobId, outs] of groups) {
          const sample = outs[0];
          html.push(`
            <details class="slop-job-group" open data-job-id="${jobId}">
              <summary>
                <span class="status-badge status-${sample.job_status}">${sample.job_status}</span>
                <span>${sample.job_app_name}</span>
                <span style="margin-left:auto;">${outs.length} output${outs.length !== 1 ? 's' : ''}</span>
              </summary>
              <div class="slop-grid">${outs.map(renderCard).join('')}</div>
            </details>
          `);
        }
        gridEl.innerHTML = html.join('');
      } else {
        gridEl.innerHTML = allOutputs.map(renderCard).join('');
      }
      gridEl.style.display = '';
      wireCardHandlers(gridEl);
    }

    function wireCardHandlers(gridEl: HTMLElement) {
      // Image preview click → viewer (with index / discard / details actions)
      gridEl.querySelectorAll('.slop-preview-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const startId = (btn as HTMLElement).dataset.viewerId;
          if (!startId) return;
          const viewable = (allOutputs as any[]).filter(
            (x) => x.media_type === 'image',
          );
          const startIndex = Math.max(
            0,
            viewable.findIndex((x: any) => x.id === startId),
          );
          const items = viewable.map(jobOutputToViewerItem);
          openImageViewer(items, startIndex, {
            // Defer to the page's existing metadata dialog (title/notes/
            // auto-tags) — consistent with clicking the tile's Index button.
            onIndex: async (item) => {
              triggerIndexDialogFor(item.id);
            },
            onDiscard: async (item) => {
              const res = await fetch('/api/jobs/outputs/bulk-discard', {
                method: 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ output_ids: [item.id] }),
              });
              if (!res.ok) {
                (window as any).toast?.error('Failed to discard output');
                return false;
              }
              (window as any).toast?.success('Discarded to midden');
              loadOutputs();
              return true;
            },
            onDetails: (item) => {
              window.location.href = `/admin/jobs/detail?id=${item.job_id}`;
            },
          });
        });
      });

      // Wire up play buttons
      gridEl.querySelectorAll('[data-play]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const oid = (btn as HTMLElement).dataset.play;
          const o = allOutputs.find((x: any) => x.id === oid);
          if (!o) return;
          document.dispatchEvent(
            new CustomEvent('player:queue', {
              detail: {
                tracks: [
                  {
                    track_id: o.id,
                    title: o.filename,
                    release_title: '',
                    release_code: '',
                    media_type: o.media_type,
                    stream_url: downloadUrl(o),
                    cover_url: '',
                    duration: 0,
                    entity_name: o.job_app_name,
                  },
                ],
                startIndex: 0,
              },
            }),
          );
        });
      });

      // Wire up single index buttons
      gridEl.querySelectorAll('[data-index]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const oid = (btn as HTMLElement).dataset.index!;
          const jobId = (btn as HTMLElement).dataset.job!;
          openIndexDialog([oid], jobId);
        });
      });

      // Wire up single discard buttons
      gridEl.querySelectorAll('[data-discard]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const oid = (btn as HTMLElement).dataset.discard!;
          const jobId = (btn as HTMLElement).dataset.job!;
          if (
            !(await (window as any).confirmDialog(
              'Discard this output? The file will be deleted.',
              'Discard',
            ))
          )
            return;
          const res = await fetch(`/api/jobs/${jobId}/outputs/${oid}`, {
            method: 'DELETE',
            credentials: 'include',
          });
          if (res.ok) {
            (window as any).toast.success('Output discarded');
            loadOutputs();
          } else {
            (window as any).toast.error('Failed to discard output');
          }
        });
      });
    }

    // ---- Index dialog ----
    function openIndexDialog(outputIds: string[], singleJobId: string | null) {
      pendingIndexIds = outputIds;

      // Determine if all outputs are from the same job
      const jobIds = new Set<string>();
      for (const oid of outputIds) {
        const o = allOutputs.find((x: any) => x.id === oid);
        if (o) jobIds.add(o.job_id);
      }
      const isSingleJob = jobIds.size === 1;
      pendingIndexJobId = isSingleJob ? [...jobIds][0] : null;

      const infoEl = document.getElementById('idx-info')!;
      const autoTagsEl = document.getElementById('idx-auto-tags')!;
      const descInput = document.getElementById(
        'idx-description',
      ) as HTMLInputElement;
      const notesInput = document.getElementById(
        'idx-notes',
      ) as HTMLTextAreaElement;
      const tagsInput = document.getElementById('idx-tags') as HTMLInputElement;
      const outputIndexInput = document.getElementById(
        'idx-output-index',
      ) as HTMLInputElement;

      // Reset fields
      descInput.value = '';
      notesInput.value = '';
      tagsInput.value = '';
      outputIndexInput.value = '';

      if (isSingleJob) {
        const sample = allOutputs.find(
          (x: any) => x.job_id === pendingIndexJobId,
        );
        if (sample) {
          const params = sample.job_params || {};

          // Auto description
          const parts = [sample.job_app_name];
          if (params.recipe) parts.push(params.recipe);
          else if (params.model) parts.push(params.model);
          if (params.input_combination && params.input_combination !== 'splice')
            parts.push(params.input_combination);
          descInput.value = parts.join(' / ');

          // Info
          const infoLines = [`App: ${sample.job_app_name}`];
          if (params.processing_mode)
            infoLines.push(`Mode: ${params.processing_mode}`);
          if (params.recipe) infoLines.push(`Recipe: ${params.recipe}`);
          if (params.model) infoLines.push(`Model: ${params.model}`);
          infoLines.push(`Outputs: ${outputIds.length}`);
          infoEl.textContent = infoLines.join('\n');

          // Auto-tags preview
          const autoTags = [`app:${sample.job_app_name}`];
          if (params.recipe) autoTags.push(`recipe:${params.recipe}`);
          if (params.model) autoTags.push(`model:${params.model}`);
          autoTagsEl.textContent = `Auto-tags: ${autoTags.join(', ')}`;
        }
      } else {
        infoEl.textContent = `Indexing ${outputIds.length} outputs from ${jobIds.size} jobs`;
        autoTagsEl.textContent = 'Auto-tags will be generated per-job';
      }

      document.getElementById('index-dialog')!.style.display = 'flex';
    }

    document.getElementById('idx-cancel')?.addEventListener('click', () => {
      document.getElementById('index-dialog')!.style.display = 'none';
      pendingIndexIds = [];
    });

    document
      .getElementById('idx-confirm')
      ?.addEventListener('click', async () => {
        const title = (
          document.getElementById('idx-description') as HTMLInputElement
        ).value.trim();
        const notes = (
          document.getElementById('idx-notes') as HTMLTextAreaElement
        ).value.trim();
        const description =
          [title, notes].filter(Boolean).join('\n\n') || undefined;
        const outputIndex =
          (
            document.getElementById('idx-output-index') as HTMLInputElement
          ).value.trim() || undefined;
        const tagsStr = (
          document.getElementById('idx-tags') as HTMLInputElement
        ).value.trim();
        const tags = tagsStr
          ? tagsStr
              .split(',')
              .map((t) => t.trim())
              .filter(Boolean)
          : [];

        const meta = { description, tags, output_index: outputIndex };

        let ok = true;

        if (pendingIndexIds.length === 1 && pendingIndexJobId) {
          // Single output, single job — use per-job endpoint
          const res = await fetch(
            `/api/jobs/${pendingIndexJobId}/outputs/${pendingIndexIds[0]}/index`,
            {
              method: 'POST',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(meta),
            },
          );
          ok = res.ok;
        } else if (pendingIndexJobId) {
          // Multiple outputs, same job — use per-job bulk endpoint
          const res = await fetch(
            `/api/jobs/${pendingIndexJobId}/outputs/index`,
            {
              method: 'POST',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ output_ids: pendingIndexIds, ...meta }),
            },
          );
          ok = res.ok;
        } else {
          // Cross-job — use bulk endpoint
          const res = await fetch('/api/jobs/outputs/bulk-index', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ output_ids: pendingIndexIds, ...meta }),
          });
          ok = res.ok;
        }

        document.getElementById('index-dialog')!.style.display = 'none';
        pendingIndexIds = [];
        pendingIndexJobId = null;

        if (ok) {
          (window as any).toast.success('Indexed successfully');
          loadOutputs();
        } else {
          (window as any).toast.error('Indexing failed');
        }
      });

    // ---- Bulk actions ----
    document
      .getElementById('btn-index-all')
      ?.addEventListener('click', async () => {
        let ids: string[];
        if (isAllPages()) {
          ids = await fetchAllMatchingIds();
          if (ids.length === 0) {
            (window as any).toast.error('Nothing to index');
            return;
          }
        } else {
          if (allOutputs.length === 0) return;
          ids = allOutputs.map((o) => o.id);
        }
        openIndexDialog(ids, null);
      });

    document
      .getElementById('btn-discard-all')
      ?.addEventListener('click', async () => {
        let ids: string[];
        if (isAllPages()) {
          ids = await fetchAllMatchingIds();
          if (ids.length === 0) {
            (window as any).toast.error('Nothing to discard');
            return;
          }
        } else {
          if (allOutputs.length === 0) return;
          ids = allOutputs.map((o) => o.id);
        }
        if (
          !(await (window as any).confirmDialog(
            `Discard ${ids.length} unindexed output${ids.length !== 1 ? 's' : ''}? Files will be permanently deleted.`,
            'Discard',
          ))
        )
          return;

        const res = await fetch('/api/jobs/outputs/bulk-discard', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ output_ids: ids }),
        });
        if (res.ok) {
          (window as any).toast.success(`${ids.length} outputs discarded`);
          currentPage = 1;
          loadOutputs();
        } else {
          (window as any).toast.error('Failed to discard outputs');
        }
      });

    document
      .getElementById('btn-play-all')
      ?.addEventListener('click', async () => {
        // "Play All" across pages would need to fetch full output metadata
        // for every page to build the queue; keep it page-scoped for now.
        // The user still sees the warning in the label tooltip.
        const playable = allOutputs.filter(isPlayable);
        if (playable.length === 0) return;
        const tracks = playable.map((o) => ({
          track_id: o.id,
          title: o.filename,
          release_title: '',
          release_code: '',
          media_type: o.media_type,
          stream_url: downloadUrl(o),
          cover_url: '',
          duration: 0,
          entity_name: o.job_app_name,
        }));
        document.dispatchEvent(
          new CustomEvent('player:queue', {
            detail: { tracks, startIndex: 0 },
          }),
        );
      });

    // ---- Filters (reset to page 1 on any filter change) ----
    function resetAndLoad() {
      currentPage = 1;
      loadOutputs();
    }
    document
      .getElementById('filter-type')
      ?.addEventListener('change', resetAndLoad);
    document
      .getElementById('filter-app')
      ?.addEventListener('change', resetAndLoad);
    document
      .getElementById('btn-refresh')
      ?.addEventListener('click', loadOutputs);

    // Pagination wiring is set up via wirePagination() near the top of
    // this script — clicks fire `pagination:go` and call loadOutputs().

    // Initial load
    loadOutputs();
  });
</script>
