<script>
  import { addItemsToWorkspace } from '../../../lib/workspace';
  import { openImageViewer, type ViewerItem } from '../../../lib/image-viewer';

  document.addEventListener('astro:page-load', async () => {
    const searchForm = document.getElementById(
      'search-form',
    ) as HTMLFormElement | null;
    if (!searchForm) return;

    const user = await (window as any).__authReady;
    if (!user) return;

    // Sync Now button
    const syncBtn = document.getElementById(
      'sync-now-btn',
    ) as HTMLButtonElement | null;
    const syncStatus = document.getElementById('sync-status');
    syncBtn?.addEventListener('click', async () => {
      if (syncBtn.disabled) return;
      syncBtn.disabled = true;
      syncBtn.classList.add('syncing');
      syncBtn.textContent = 'Syncing...';
      if (syncStatus) syncStatus.textContent = '';

      try {
        const res = await fetch('/api/ingest/slack/sync', {
          method: 'POST',
          credentials: 'include',
        });
        const data = await res.json();
        if (data.ok) {
          const reactionsUpdated = data.reactions?.updated || 0;
          if (syncStatus)
            syncStatus.textContent = `Reactions: ${reactionsUpdated} updated. Scrape: ${data.scrape?.status || 'started'}`;
          // Poll for scrape completion, then refresh results
          if (data.scrape?.status === 'started') {
            pollScrapeStatus();
          } else {
            doSearch();
          }
        } else {
          if (syncStatus) syncStatus.textContent = data.detail || 'Sync failed';
        }
      } catch {
        if (syncStatus) syncStatus.textContent = 'Sync request failed';
      } finally {
        syncBtn.disabled = false;
        syncBtn.classList.remove('syncing');
        syncBtn.textContent = 'Sync Now';
      }
    });

    async function pollScrapeStatus() {
      const poll = async () => {
        try {
          const res = await fetch('/api/ingest/slack/status', {
            credentials: 'include',
          });
          const data = await res.json();
          if (data.ok && data.status?.running) {
            if (syncStatus)
              syncStatus.textContent = `Scraping: ${data.status.current_channel || '...'}`;
            setTimeout(poll, 3000);
          } else {
            if (syncStatus) syncStatus.textContent = 'Sync complete';
            doSearch();
            setTimeout(() => {
              if (syncStatus) syncStatus.textContent = '';
            }, 5000);
          }
        } catch {
          if (syncStatus) syncStatus.textContent = '';
        }
      };
      setTimeout(poll, 2000);
    }

    // Default view: feed on mobile, grid on desktop. User's explicit
    // choice (saved in localStorage) wins over both defaults.
    type ViewMode = 'grid' | 'feed' | 'list';
    function pickInitialView(): ViewMode {
      try {
        const saved = localStorage.getItem('au.searchView');
        if (saved === 'grid' || saved === 'feed' || saved === 'list')
          return saved;
      } catch {}
      return window.matchMedia('(max-width: 640px)').matches ? 'feed' : 'grid';
    }
    let currentView: ViewMode = pickInitialView();
    let currentPage = 1;
    const pageSize = 24;
    let totalResults = 0;
    let allResults: any[] = [];
    let selectedIds = new Set<string>();

    const searchInput = document.getElementById(
      'search-input',
    ) as HTMLInputElement;
    const loadingEl = document.getElementById('loading')!;
    const errorEl = document.getElementById('error')!;
    const emptyEl = document.getElementById('empty')!;
    const gridEl = document.getElementById('results-grid')!;
    const feedEl = document.getElementById('results-feed')!;
    const tableEl = document.getElementById('results-table')!;
    const tbodyEl = document.getElementById('results-tbody')!;
    const footerEl = document.getElementById('results-footer')!;
    const progressEl = document.getElementById('results-progress')!;
    const sentinelEl = document.getElementById('load-more-sentinel')!;
    const selectionBar = document.getElementById('selection-bar')!;
    const selectionActions = document.getElementById('selection-actions')!;
    const selectionCount = document.getElementById('selected-count')!;
    const selectionExpand = document.getElementById(
      'select-all-matching',
    ) as HTMLAnchorElement;
    const selectToggle = document.getElementById(
      'select-toggle',
    ) as HTMLInputElement;
    const selectToggleLabel = document.getElementById('select-toggle-label')!;
    let isLoadingMore = false;

    // View toggle. Choice persists in localStorage (long-lived) so users
    // don't have to re-pick on every visit. Mobile vs desktop default is
    // handled in pickInitialView() above.
    function syncViewButtons() {
      for (const v of ['grid', 'feed', 'list'] as ViewMode[]) {
        const btn = document.getElementById(`${v}-view-btn`);
        if (!btn) continue;
        btn.classList.toggle('active', currentView === v);
      }
    }
    function setView(next: ViewMode) {
      if (currentView === next) return;
      const wasFeed = currentView === 'feed';
      currentView = next;
      try {
        localStorage.setItem('au.searchView', next);
      } catch {}
      syncViewButtons();
      // Switching out of feed (which accumulates pages 1..N) into a
      // paginated view: drop the accumulated buffer and re-fetch just the
      // current page so the grid/list shows one page at a time.
      if (wasFeed && next !== 'feed' && allResults.length > pageSize) {
        doSearch();
      } else {
        renderResults();
      }
    }
    syncViewButtons();
    document
      .getElementById('grid-view-btn')
      ?.addEventListener('click', () => setView('grid'));
    document
      .getElementById('feed-view-btn')
      ?.addEventListener('click', () => setView('feed'));
    document
      .getElementById('list-view-btn')
      ?.addEventListener('click', () => setView('list'));

    // Filter toggle — collapsed by default on every viewport. Persisted
    // across in-tab navigations via sessionStorage so a user who opens it
    // doesn't have to re-open after every page change.
    const filterToggleEl = document.getElementById(
      'filter-toggle',
    ) as HTMLButtonElement | null;
    const filterBodyEl = document.getElementById('filter-body');
    function setFilterPanelOpen(open: boolean) {
      if (!filterBodyEl || !filterToggleEl) return;
      filterBodyEl.classList.toggle('open', open);
      filterToggleEl.setAttribute('aria-expanded', open ? 'true' : 'false');
      try {
        sessionStorage.setItem('au.filterPanelOpen', open ? '1' : '0');
      } catch {}
    }
    filterToggleEl?.addEventListener('click', () => {
      setFilterPanelOpen(!filterBodyEl?.classList.contains('open'));
    });
    // Restore state on load (default = closed).
    try {
      if (sessionStorage.getItem('au.filterPanelOpen') === '1') {
        setFilterPanelOpen(true);
      }
    } catch {}

    // Insights toggle
    document
      .getElementById('insights-toggle')
      ?.addEventListener('click', () => {
        document.getElementById('insights-body')?.classList.toggle('collapsed');
      });

    // Reset scroll + page state when the user changes any filter.
    // Without scrolling back up, switching filters from deep in an
    // infinite-scroll list leaves them stranded in empty space.
    //
    // We also clear the selection on filter change. A stale "5,000 selected"
    // from a previous query is a footgun for batch operations — the IDs may
    // not match the user's current intent, and the per-tile checkmarks would
    // be misleading. Selection within a single query (paging, scrolling,
    // view switching) is preserved as expected.
    function applyAndSearch() {
      currentPage = 1;
      selectedIds.clear();
      doSearch();
      window.scrollTo({ top: 0, behavior: 'auto' });
    }

    // Apply filters button
    document.getElementById('apply-filters')?.addEventListener('click', () => {
      applyAndSearch();
    });

    // SearchFilterBar island owns every filter control. It writes the
    // consolidated state to `data-filters` on its wrapper and dispatches
    // `filters-change` on every change. We re-fire `applyAndSearch()` so
    // the result set updates without a manual Apply.
    document
      .getElementById('filter-bar-host')
      ?.addEventListener('filters-change', () => {
        applyAndSearch();
      });

    // Search form
    searchForm.addEventListener('submit', (e) => {
      e.preventDefault();
      applyAndSearch();
    });

    // Prev/next pagination — only used by grid + list views (feed has
    // its own scroll-driven loader). Replaces results with the new page
    // and scrolls to the top so the user sees what they navigated to.
    document.getElementById('prev-page')?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        doSearch();
        window.scrollTo({ top: 0, behavior: 'auto' });
      }
    });
    document.getElementById('next-page')?.addEventListener('click', () => {
      if (currentPage * pageSize < totalResults) {
        currentPage++;
        doSearch();
        window.scrollTo({ top: 0, behavior: 'auto' });
      }
    });

    // Tri-state "Select" toggle in the selection bar. Cycles:
    //   unchecked → adds every loaded item to the selection
    //   indeterminate or checked → clears the entire selection
    // "Loaded" means the items currently in `allResults` (the page in grid/list,
    // or everything scrolled-into-view in feed). To go beyond loaded items —
    // typical in feed with thousands of matches — use the "Select all N
    // matching" link that appears next to the toggle.
    selectToggle?.addEventListener('change', () => {
      if (selectToggle.checked) {
        allResults.forEach((r) => selectedIds.add(r.id));
      } else {
        selectedIds.clear();
      }
      updateSelection();
    });

    // "Select all N matching" — expand selection to every server-side hit
    // for the current query/filters. Single round-trip; capped at 10k.
    selectionExpand?.addEventListener('click', async (e) => {
      e.preventDefault();
      const original = selectionExpand.textContent;
      selectionExpand.textContent = 'Loading…';
      try {
        const res = await fetch('/api/search/ids', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(buildSearchBody()),
        });
        if (!res.ok) throw new Error('Select-all request failed');
        const data = await res.json();
        selectedIds = new Set<string>(data.ids || []);
        if (data.capped) {
          (window as any).toast?.info?.(
            `Selected ${selectedIds.size.toLocaleString()} items (capped — query matches more than 10,000)`,
          );
        }
        updateSelection();
      } catch (err) {
        selectionExpand.textContent = original;
        (window as any).toast?.error?.('Failed to select all matching');
      }
    });

    // Batch actions
    document.querySelectorAll('[data-batch]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const action = (btn as HTMLElement).dataset.batch;
        if (action === 'tag') {
          document.getElementById('batch-tag-dialog')!.style.display = 'flex';
        } else if (action === 'workspace') {
          addToWorkspace();
        } else if (action === 'delete') {
          document.getElementById('delete-count')!.textContent = String(
            selectedIds.size,
          );
          document.getElementById('delete-dialog')!.style.display = 'flex';
        } else if (action === 're-extract') {
          batchReExtract();
        } else if (action === 'export') {
          batchExport();
        }
      });
    });

    document
      .getElementById('clear-selection')
      ?.addEventListener('click', () => {
        selectedIds.clear();
        updateSelection();
        renderResults();
      });

    // Batch tag dialog
    document
      .getElementById('batch-tag-cancel')
      ?.addEventListener('click', () => {
        document.getElementById('batch-tag-dialog')!.style.display = 'none';
      });
    document
      .getElementById('batch-tag-confirm')
      ?.addEventListener('click', async () => {
        const input = document.getElementById(
          'batch-tag-input',
        ) as HTMLInputElement;
        const tags = input.value
          .split(',')
          .map((t) => t.trim())
          .filter(Boolean);
        if (tags.length === 0) return;
        try {
          await fetch('/api/media/batch/tags', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ media_ids: Array.from(selectedIds), tags }),
          });
          document.getElementById('batch-tag-dialog')!.style.display = 'none';
          input.value = '';
          doSearch();
        } catch {
          (window as any).toast.error('Failed to apply tags');
        }
      });

    // Delete dialog
    document.getElementById('delete-cancel')?.addEventListener('click', () => {
      document.getElementById('delete-dialog')!.style.display = 'none';
    });
    document
      .getElementById('delete-confirm')
      ?.addEventListener('click', async () => {
        const btn = document.getElementById(
          'delete-confirm',
        ) as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'Deleting…';
        // Snapshot the IDs we're asking the server to delete. We optimistically
        // remove them from the rendered list once the server confirms — see
        // the comment further down on why we can't just re-fetch.
        const targetIds = Array.from(selectedIds);
        try {
          const res = await fetch('/api/media/batch/delete', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ media_ids: targetIds }),
          });
          // Previously this fell through on any non-2xx status — a silent
          // success on 401/413/500 looked exactly like "Delete doesn't work"
          // from the user's seat. Surface the real failure now.
          if (!res.ok) {
            let detail = `${res.status} ${res.statusText}`;
            try {
              const body = await res.json();
              if (body?.detail) detail = body.detail;
            } catch {}
            throw new Error(detail);
          }
          const data = await res.json().catch(() => ({}));
          const deleted: string[] = data.deleted || [];
          const notFound: string[] = data.not_found || [];
          document.getElementById('delete-dialog')!.style.display = 'none';

          // Optimistic local removal. Meilisearch indexes deletes
          // asynchronously — re-fetching `/api/search` right away typically
          // returns the just-deleted items, which looks identical to "delete
          // didn't work" from the user's seat. Drop the rows in-place from
          // `allResults` + the rendered DOM, decrement totals, and only
          // re-fetch later (below) once Meili has likely caught up.
          const removed = new Set<string>([...deleted, ...notFound]);
          allResults = allResults.filter((r) => !removed.has(r.id));
          totalResults = Math.max(0, totalResults - removed.size);
          for (const id of removed) selectedIds.delete(id);
          renderResults();

          let msg = `Deleted ${deleted.length} item${
            deleted.length === 1 ? '' : 's'
          }`;
          if (notFound.length) msg += ` (${notFound.length} already gone)`;
          (window as any).toast?.success?.(msg);

          // Background re-sync after Meili has had a moment to process the
          // delete tasks. Refreshes facet counts + picks up the "next" page's
          // worth of items where the deleted ones used to be.
          setTimeout(() => doSearch(), 1500);
        } catch (err: any) {
          (window as any).toast?.error?.(
            'Delete failed: ' + (err?.message || 'unknown error'),
          );
        } finally {
          btn.disabled = false;
          btn.textContent = 'Delete';
        }
      });

    async function batchReExtract() {
      try {
        await fetch('/api/media/batch/re-extract', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ media_ids: Array.from(selectedIds) }),
        });
        (window as any).toast.success(
          'Re-extraction queued for ' + selectedIds.size + ' items',
        );
      } catch {
        (window as any).toast.error('Re-extraction failed');
      }
    }

    async function batchExport() {
      try {
        const res = await fetch('/api/media/batch/export', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ media_ids: Array.from(selectedIds) }),
        });
        if (res.ok) {
          const blob = await res.blob();
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'media-export.zip';
          a.click();
          URL.revokeObjectURL(url);
        }
      } catch {
        (window as any).toast.error('Export failed');
      }
    }

    // --- Workspace (helpers live in src/lib/workspace.ts) ---

    async function refreshWorkspaceBadge() {
      const wsId = localStorage.getItem('active_workspace_id');
      const badge = document.getElementById('workspace-badge')!;
      const countEl = document.getElementById('workspace-count')!;
      if (!wsId) {
        badge.style.display = 'none';
        return;
      }
      try {
        const res = await fetch(`/api/workspaces/${wsId}`, {
          credentials: 'include',
        });
        if (!res.ok) {
          badge.style.display = 'none';
          return;
        }
        const data = await res.json();
        countEl.textContent = String(data.item_count);
        badge.style.display = data.item_count > 0 ? '' : 'none';
      } catch {
        badge.style.display = 'none';
      }
    }

    async function addToWorkspace() {
      const data = await addItemsToWorkspace(Array.from(selectedIds));
      if (data) {
        (window as any).toast.success(
          `Added ${data.added} item(s) to workspace`,
        );
        refreshWorkspaceBadge();
      } else {
        (window as any).toast.error('Failed to add to workspace');
      }
    }

    refreshWorkspaceBadge();

    // Filter state is owned by SearchFilterBar (Svelte island). It mirrors
    // the consolidated state into data-filters JSON on its wrapper and
    // dispatches filters-change CustomEvents. We read it synchronously here.
    type BarFilters = {
      types: string[];
      outputIndexes: string[];
      channels: string[];
      poster: string;
      jobApp: string;
      colorGroups: string[];
      preservedMultiColors: string[];
      dateFrom: string;
      dateTo: string;
      tagsText: string;
      reactionsMin: number;
      tagsMin: number;
      hasTranscript: '' | 'yes' | 'no';
      hasText: '' | 'yes' | 'no';
      sortBy: string;
      includeEmulsion: boolean;
      voteScoreMin: number | null;
      upMin: number | null;
      downMax: number | null;
      myVotes: '' | 'up' | 'down' | 'any' | 'none';
    };

    // The SearchFilterBar Svelte island renders its own `<div class="filter-bar"
    // data-filters>` *inside* #filter-bar-host's <astro-island>. data-filters
    // and the filters-set/filters-reset listeners live on that inner element,
    // not on the wrapper — so reads + dispatches have to target it directly.
    // (filters-change still bubbles up to the wrapper, which is where
    // applyAndSearch is attached.)
    function filterBarEl(): HTMLElement | null {
      return document.querySelector(
        '#filter-bar-host [data-filters]',
      ) as HTMLElement | null;
    }

    function readBarFilters(): BarFilters {
      const raw = filterBarEl()?.dataset.filters;
      if (raw) {
        try {
          return JSON.parse(raw) as BarFilters;
        } catch {
          // fall through to defaults
        }
      }
      return {
        types: ['image', 'audio', 'video'],
        outputIndexes: ['__inputs__'],
        channels: [],
        poster: '',
        jobApp: '',
        colorGroups: [],
        preservedMultiColors: [],
        dateFrom: '',
        dateTo: '',
        tagsText: '',
        reactionsMin: 0,
        tagsMin: 0,
        hasTranscript: '',
        hasText: '',
        sortBy: 'newest',
        includeEmulsion: false,
        voteScoreMin: null,
        upMin: null,
        downMax: null,
        myVotes: '',
      };
    }

    function getFilters() {
      const f = readBarFilters();
      const colorGroups = f.colorGroups.length
        ? f.colorGroups
        : f.preservedMultiColors.slice();
      return {
        types: f.types,
        channels: f.channels,
        poster: f.poster,
        outputIndexes: f.outputIndexes,
        colorGroups,
        dateFrom: f.dateFrom,
        dateTo: f.dateTo,
        tags: f.tagsText,
        reactionsMin: f.reactionsMin,
        tagsMin: f.tagsMin,
        sortBy: f.sortBy,
        jobApp: f.jobApp,
        hasTranscript: f.hasTranscript,
        hasText: f.hasText,
        includeEmulsion: f.includeEmulsion,
        voteScoreMin: f.voteScoreMin,
        upMin: f.upMin,
        downMax: f.downMax,
        myVotes: f.myVotes,
      };
    }

    // Build the search request body from the current filters. Used by both
    // doSearch (paginated, sets page/per_page) and selectAllMatching (via
    // /api/search/ids, which ignores page/per_page).
    function buildSearchBody(): any {
      const filters = getFilters();
      const sortMap: Record<string, string> = {
        newest: 'created_at:desc',
        oldest: 'created_at:asc',
        random: 'random',
        most_reactions: 'total_reaction_count:desc',
        acclaim: 'vote_score:desc',
        largest: 'file_size_bytes:desc',
        longest: 'duration_seconds:desc',
      };
      const body: any = {
        query: searchInput.value,
        media_types: filters.types,
        sort: sortMap[filters.sortBy] || null,
        filters: {},
      };
      if (filters.includeEmulsion) body.include_emulsion = true;
      if (filters.channels.length)
        body.filters.source_channels = filters.channels;
      if (filters.poster) body.filters.poster = filters.poster;
      if (filters.outputIndexes.length)
        body.filters.output_index = filters.outputIndexes;
      if (filters.colorGroups.length)
        body.filters.color_group = filters.colorGroups;
      if (filters.dateFrom || filters.dateTo)
        body.filters.date_range = {
          from: filters.dateFrom || undefined,
          to: filters.dateTo || undefined,
        };
      if (filters.tags)
        body.filters.tags = filters.tags
          .split(',')
          .map((t: string) => t.trim())
          .filter(Boolean);
      if (filters.reactionsMin > 0)
        body.filters.reaction_count = { min: filters.reactionsMin };
      if (filters.tagsMin > 0)
        body.filters.tag_count = { min: filters.tagsMin };
      if (filters.jobApp) body.filters.job_app = filters.jobApp;
      if (filters.hasTranscript)
        body.filters.has_transcript = filters.hasTranscript === 'yes';
      if (filters.hasText) body.filters.has_text = filters.hasText === 'yes';
      if (filters.voteScoreMin !== null)
        body.filters.vote_score = { min: filters.voteScoreMin };
      if (filters.upMin !== null)
        body.filters.up_count = { min: filters.upMin };
      if (filters.downMax !== null)
        body.filters.down_count = { max: filters.downMax };
      if (filters.myVotes) body.filters.my_votes = filters.myVotes;
      return body;
    }

    async function doSearch({ append = false }: { append?: boolean } = {}) {
      if (append) {
        // Background load — keep existing results visible, show the
        // bottom "Loading more…" indicator.
        const moreEl = document.getElementById('results-loading-more');
        if (moreEl) moreEl.removeAttribute('hidden');
      } else {
        loadingEl.style.display = 'block';
        errorEl.style.display = 'none';
        emptyEl.style.display = 'none';
        gridEl.style.display = 'none';
        feedEl.style.display = 'none';
        tableEl.style.display = 'none';
        selectionBar.style.display = 'none';
      }
      footerEl.style.display = 'none';

      const filters = getFilters();
      const body = buildSearchBody();
      // Snapshot the page we're fetching for. `currentPage` is shared state:
      // the scroll handler also mutates it to track the visible page, and can
      // race with us during `await fetch(...)`. If we read currentPage after
      // the await to label the returned items, a scroll-handler tick that
      // fires mid-fetch will silently mislabel them — items the server
      // returned for page N+1 end up tagged `_page: N`, their data-page-start
      // marker never gets emitted, the URL never advances past page N, and
      // the saved-spot anchor for that section restores to the wrong page on
      // back-nav (the itemId isn't in page N's actual results).
      const fetchPage = currentPage;
      body.page = fetchPage;
      body.per_page = pageSize;

      // Update URL to reflect current search state (shareable, back/forward friendly)
      const stateParams = new URLSearchParams();
      if (searchInput.value) stateParams.set('q', searchInput.value);
      if (filters.poster) stateParams.set('poster', filters.poster);
      if (filters.colorGroups.length)
        stateParams.set('colorgroup', filters.colorGroups.join(','));
      if (filters.channels.length)
        stateParams.set('channel', filters.channels.join(','));
      if (filters.tags) stateParams.set('tags', filters.tags);
      if (filters.dateFrom) stateParams.set('from', filters.dateFrom);
      if (filters.dateTo) stateParams.set('to', filters.dateTo);
      if (filters.reactionsMin > 0)
        stateParams.set('rxn', String(filters.reactionsMin));
      if (filters.tagsMin > 0)
        stateParams.set('mintags', String(filters.tagsMin));
      // Default = exactly ['__inputs__'] → omit param so URLs stay tidy.
      const indexIsDefault =
        filters.outputIndexes.length === 1 &&
        filters.outputIndexes[0] === '__inputs__';
      if (!indexIsDefault && filters.outputIndexes.length)
        stateParams.set('output_index', filters.outputIndexes.join(','));
      if (filters.jobApp) stateParams.set('app', filters.jobApp);
      if (filters.hasTranscript)
        stateParams.set('transcript', filters.hasTranscript);
      if (filters.hasText) stateParams.set('ocr', filters.hasText);
      if (filters.voteScoreMin !== null)
        stateParams.set('vscore', String(filters.voteScoreMin));
      if (filters.upMin !== null)
        stateParams.set('upmin', String(filters.upMin));
      if (filters.downMax !== null)
        stateParams.set('downmax', String(filters.downMax));
      if (filters.myVotes) stateParams.set('myvotes', filters.myVotes);
      if (filters.sortBy !== 'newest') stateParams.set('sort', filters.sortBy);
      if (filters.types.length < 3 && filters.types.length > 0)
        stateParams.set('types', filters.types.join(','));
      if (fetchPage > 1) stateParams.set('page', String(fetchPage));
      const qs = stateParams.toString();
      const newUrl = window.location.pathname + (qs ? '?' + qs : '');
      // Preserve history.state (Astro ClientRouter stores scrollX/Y there for
      // back-nav restoration — passing null wipes it and breaks "go back to
      // your spot" on mobile).
      //
      // For an *append* fetch (infinite-scroll loadNextPage), don't rewrite
      // the URL here. The scroll-driven detector is already responsible for
      // syncing `?page=N` to the visible page, and writing the fetched page
      // here causes the URL to flash between the visible page and the
      // about-to-be-appended page during every page-boundary load.
      if (!append) {
        history.replaceState(history.state, '', newUrl);
      }

      try {
        const res = await fetch('/api/search', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!res.ok) throw new Error('Search failed');
        const data = await res.json();
        const newItems = (data.results || data.hits || []).map((r: any) => ({
          ...r,
          _page: fetchPage,
        }));
        const prevLen = allResults.length;
        if (append) {
          allResults = [...allResults, ...newItems];
        } else {
          allResults = newItems;
        }
        totalResults = data.total || allResults.length;
        loadingEl.style.display = 'none';
        renderResults({ append, prevLen });
        renderStatsBar(data.counts_by_type || {}, totalResults);
        // Stats only depend on filters, not page — only fetch on the
        // initial / replacing search, not on every appended page.
        if (!append) fetchStats(body);
      } catch (err: any) {
        loadingEl.style.display = 'none';
        errorEl.textContent = err.message;
        errorEl.style.display = 'block';
      } finally {
        const moreEl = document.getElementById('results-loading-more');
        if (moreEl) moreEl.setAttribute('hidden', '');
        isLoadingMore = false;
      }

      showActiveFilters();
    }

    // Single source of truth for selection UI state. Call after any change
    // to `selectedIds` or `allResults`. Updates:
    //   - tri-state of the master toggle (reflects loaded coverage)
    //   - counter + actions visibility
    //   - "Select all N matching" link visibility
    //   - per-item checkbox + `.selected` class on already-rendered tiles
    //     (cheap — avoids re-rendering the whole list on a checkbox tick)
    function updateSelection() {
      const totalSelected = selectedIds.size;
      // Loaded coverage drives the tri-state. Counting via the Set is O(loaded)
      // and avoids allocating an intermediate array.
      let loadedSelected = 0;
      for (const r of allResults) if (selectedIds.has(r.id)) loadedSelected++;
      const loadedCount = allResults.length;

      // Tri-state. `indeterminate` must be set as a property, not attribute.
      if (loadedCount === 0) {
        selectToggle.checked = false;
        selectToggle.indeterminate = false;
      } else if (loadedSelected === 0) {
        selectToggle.checked = false;
        selectToggle.indeterminate = false;
      } else if (loadedSelected === loadedCount) {
        selectToggle.checked = true;
        selectToggle.indeterminate = false;
      } else {
        selectToggle.checked = false;
        selectToggle.indeterminate = true;
      }

      // Bar is visible whenever there are results to act on. Hidden during
      // loading / empty state via doSearch + renderResults.
      selectionBar.style.display = loadedCount > 0 ? 'flex' : 'none';

      if (totalSelected > 0) {
        selectionCount.textContent =
          totalSelected.toLocaleString() + ' selected';
        selectionCount.hidden = false;
        selectionActions.hidden = false;
        selectToggleLabel.textContent = 'Clear';
      } else {
        selectionCount.hidden = true;
        selectionActions.hidden = true;
        selectToggleLabel.textContent = 'Select';
      }

      // "Select all N matching" expansion link. Show only when there's more
      // to select than we have loaded, and at least one is already picked
      // (so the link is contextually relevant, not a cold-state CTA).
      if (totalSelected > 0 && totalSelected < totalResults) {
        selectionExpand.textContent = `Select all ${totalResults.toLocaleString()} matching`;
        selectionExpand.hidden = false;
      } else {
        selectionExpand.hidden = true;
      }

      // Sync per-item checkboxes + .selected class on already-rendered tiles.
      document
        .querySelectorAll<HTMLInputElement>('[data-select]')
        .forEach((cb) => {
          const id = cb.dataset.select;
          if (id) cb.checked = selectedIds.has(id);
        });
      document
        .querySelectorAll<HTMLElement>('.grid-item, .feed-item, tr[data-id]')
        .forEach((el) => {
          const id = el.dataset.id;
          if (id) el.classList.toggle('selected', selectedIds.has(id));
        });
    }

    function formatSize(bytes: number): string {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    // ---- Acclaim/Disavow chip (issue #318) --------------------------------
    // Vanilla HTML chip injected into every grid/list/feed row. A single
    // delegated click handler (wired further down) handles the actual vote
    // POST and per-row re-render. Voter identities for the tooltip ride
    // along in the Meilisearch document (denormalized `upvoters` /
    // `downvoters` arrays).
    function escapeHtmlAttr(s: string): string {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }
    function voterNames(voters: any[] | undefined): string {
      if (!voters || voters.length === 0) return '—';
      const names = voters
        .slice(0, 12)
        .map((v: any) => v.name)
        .filter(Boolean);
      const more = voters.length > 12 ? `, +${voters.length - 12} more` : '';
      return escapeHtmlAttr(names.join(', ') + more);
    }
    function voteChipHtml(item: any, currentUserId: number | null): string {
      const up = item.up_count ?? 0;
      const down = item.down_count ?? 0;
      const upIds: number[] = item.upvoter_user_ids || [];
      const downIds: number[] = item.downvoter_user_ids || [];
      const myVote: -1 | 0 | 1 =
        currentUserId == null
          ? 0
          : upIds.includes(currentUserId)
            ? 1
            : downIds.includes(currentUserId)
              ? -1
              : 0;
      const upActive = myVote === 1 ? ' is-active' : '';
      const downActive = myVote === -1 ? ' is-active' : '';
      const upZero = up === 0 ? ' is-zero' : '';
      const downZero = down === 0 ? ' is-zero' : '';
      const upTitle = escapeHtmlAttr(`Acclaim — ${voterNames(item.upvoters)}`);
      const downTitle = escapeHtmlAttr(
        `Disavow — ${voterNames(item.downvoters)}`,
      );
      // Inline styles intentionally — bypass any potential CSS-bundling
      // or scoped-style issue so the chip is unconditionally visible.
      const btnBase =
        'display:inline-flex;align-items:center;gap:4px;padding:4px 8px;background:var(--color-bg,#fff);color:var(--color-fg,var(--color-text,#111));border:2px solid var(--color-fg,var(--color-text,#111));box-shadow:2px 2px 0 var(--color-fg,var(--color-text,#111));font-family:var(--font-mono,monospace);font-size:0.78rem;font-weight:700;text-transform:uppercase;letter-spacing:0.5pt;cursor:pointer;line-height:1';
      const btnActive =
        ';background:var(--color-fg,var(--color-text,#111));color:var(--color-bg,#fff)';
      const upStyle = btnBase + (myVote === 1 ? btnActive : '');
      const downStyle = btnBase + (myVote === -1 ? btnActive : '');
      return `<span class="vote-chip" data-vote-media-id="${item.id}" data-vote-mine="${myVote}" style="display:inline-flex;align-items:stretch;gap:4px;font-variant-numeric:tabular-nums;line-height:1;">
        <button type="button" class="vote-chip__arrow vote-chip__arrow--up${upActive}" data-vote-id="${item.id}" data-vote-dir="1" aria-label="Acclaim" title="${upTitle}" style="${upStyle}">▲ <span class="vote-chip__count${upZero}" style="margin-left:4px;">${up}</span></button>
        <button type="button" class="vote-chip__arrow vote-chip__arrow--down${downActive}" data-vote-id="${item.id}" data-vote-dir="-1" aria-label="Disavow" title="${downTitle}" style="${downStyle}"><span class="vote-chip__count${downZero}" style="margin-right:4px;">${down}</span> ▼</button>
      </span>`;
    }
    function updateChipFor(mediaId: string) {
      const item = allResults.find((r) => r.id === mediaId);
      if (!item) return;
      const html = voteChipHtml(item, user?.id ?? null);
      document
        .querySelectorAll<HTMLElement>(
          `.vote-chip[data-vote-media-id="${CSS.escape(mediaId)}"]`,
        )
        .forEach((el) => {
          const wrap = document.createElement('div');
          wrap.innerHTML = html;
          const next = wrap.firstElementChild as HTMLElement | null;
          if (next) el.replaceWith(next);
        });
    }
    async function castVote(mediaId: string, target: 1 | -1) {
      const item = allResults.find((r) => r.id === mediaId);
      if (!item) return;
      const uid: number | null = user?.id ?? null;
      const myUp: number[] = item.upvoter_user_ids || [];
      const myDown: number[] = item.downvoter_user_ids || [];
      const mine: -1 | 0 | 1 =
        uid == null
          ? 0
          : myUp.includes(uid)
            ? 1
            : myDown.includes(uid)
              ? -1
              : 0;
      // Click same arrow → retract.
      const next: -1 | 0 | 1 = mine === target ? 0 : target;
      try {
        const r = await fetch(
          `/api/search/${encodeURIComponent(mediaId)}/vote`,
          {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value: next }),
          },
        );
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        const body = await r.json();
        item.up_count = body.up_count;
        item.down_count = body.down_count;
        item.vote_score = body.vote_score;
        if (uid != null) {
          item.upvoter_user_ids = (item.upvoter_user_ids || []).filter(
            (id: number) => id !== uid,
          );
          item.downvoter_user_ids = (item.downvoter_user_ids || []).filter(
            (id: number) => id !== uid,
          );
          item.upvoters = (item.upvoters || []).filter(
            (v: any) => v.user_id !== uid,
          );
          item.downvoters = (item.downvoters || []).filter(
            (v: any) => v.user_id !== uid,
          );
          if (body.my_vote === 1) {
            item.upvoter_user_ids.push(uid);
            item.upvoters.push({ user_id: uid, name: user?.name || 'you' });
          } else if (body.my_vote === -1) {
            item.downvoter_user_ids.push(uid);
            item.downvoters.push({ user_id: uid, name: user?.name || 'you' });
          }
        }
        updateChipFor(mediaId);
      } catch {
        /* leave the chip as-is; the next search refresh will reconcile */
      }
    }
    document.addEventListener('click', (ev) => {
      const target = ev.target as HTMLElement;
      const btn = target.closest<HTMLElement>('.vote-chip__arrow');
      if (!btn) return;
      const id = btn.dataset.voteId;
      const dir = parseInt(btn.dataset.voteDir || '0', 10);
      if (!id || (dir !== 1 && dir !== -1)) return;
      ev.preventDefault();
      ev.stopPropagation();
      void castVote(id, dir as 1 | -1);
    });

    // Infinite-scroll wiring (feed view only):
    //   - `loadMoreObserver` is an IntersectionObserver on the sentinel
    //     below the results. When it scrolls into view, we fetch the next
    //     page. IO works fine for this — we only need a single boolean
    //     "is this thing visible".
    //   - URL page tracking uses a scroll event listener (NOT IntersectionObserver).
    //     iOS Safari's IO has known glitches where elements report
    //     isIntersecting:false during fast scroll, which manifested here as
    //     the URL flickering back to ?page=1 mid-scroll. Reading scrollY +
    //     measuring marker positions is deterministic on every browser.
    let loadMoreObserver: IntersectionObserver | null = null;
    let scrollPageDetectHandler: (() => void) | null = null;

    function maxLoadedPage(): number {
      // Highest page we've already fetched. allResults is in fetch order.
      return allResults.length
        ? allResults[allResults.length - 1]._page || 1
        : 1;
    }

    function hasMoreToLoad(): boolean {
      // Count remaining PAGES, not items. On a resume-from-?page=N load we
      // hold only page N in allResults — an item-based check would still
      // say "more to load" even when N is the final page, and the sentinel
      // observer would loop firing empty fetches that re-paint the feed
      // (white flash + scroll-to-top).
      const totalPages = Math.max(1, Math.ceil(totalResults / pageSize));
      return maxLoadedPage() < totalPages;
    }

    async function loadNextPage() {
      if (isLoadingMore || !hasMoreToLoad()) return;
      isLoadingMore = true;
      currentPage = maxLoadedPage() + 1;
      await doSearch({ append: true });
    }

    function updateUrlPage(page: number) {
      const params = new URLSearchParams(window.location.search);
      if (page > 1) params.set('page', String(page));
      else params.delete('page');
      const qs = params.toString();
      const newUrl = window.location.pathname + (qs ? '?' + qs : '');
      if (newUrl !== window.location.pathname + window.location.search) {
        // Preserve existing history.state — Astro ClientRouter relies on
        // scrollX/Y/index living there for back-nav restoration. Passing
        // null wipes it and breaks "go back to your spot" on mobile.
        history.replaceState(history.state, '', newUrl);
      }
    }

    // Pick the page whose start-marker is currently closest to (but not
    // below) the top of the viewport. Stable on every browser — no
    // IntersectionObserver state-machine quirks to worry about.
    function detectVisiblePageFromScroll(): number {
      const markers =
        document.querySelectorAll<HTMLElement>('[data-page-start]');
      if (!markers.length) return 1;
      // Threshold is a quarter of the viewport from the top. As soon as a
      // marker passes that line on the way up, that page becomes "current".
      const threshold = window.innerHeight * 0.25;
      let topPage = +(markers[0].dataset.pageStart || '1');
      for (const m of markers) {
        const rect = m.getBoundingClientRect();
        if (rect.top <= threshold) {
          topPage = +(m.dataset.pageStart || '1');
        } else {
          break; // markers are in DOM order; once we pass the threshold we're done
        }
      }
      return topPage;
    }

    function setupInfiniteScrollObservers() {
      loadMoreObserver?.disconnect();
      if (scrollPageDetectHandler) {
        window.removeEventListener('scroll', scrollPageDetectHandler);
        scrollPageDetectHandler = null;
      }

      // Infinite scroll is feed-only. Grid + List use prev/next pagination
      // because tile density makes scroll-driven loading feel chaotic on
      // those views.
      if (currentView !== 'feed') return;

      if (hasMoreToLoad()) {
        loadMoreObserver = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) loadNextPage();
          },
          // Pre-fetch a screenful before the user reaches the bottom so the
          // feed feels continuous instead of stalling.
          { rootMargin: '600px 0px' },
        );
        loadMoreObserver.observe(sentinelEl);
      }

      // Scroll listener for URL <-> page sync. Throttled with rAF so it
      // costs ~one DOM read per frame at most. `passive: true` so it never
      // blocks scroll on mobile.
      let scrollPending = false;
      scrollPageDetectHandler = () => {
        if (scrollPending) return;
        scrollPending = true;
        requestAnimationFrame(() => {
          scrollPending = false;
          const page = detectVisiblePageFromScroll();
          if (page !== currentPage) {
            currentPage = page;
            updateUrlPage(page);
          }
        });
      };
      window.addEventListener('scroll', scrollPageDetectHandler, {
        passive: true,
      });
      // Run once now so the URL reflects the post-render page even before
      // the user starts scrolling (e.g., after a load-more append).
      scrollPageDetectHandler();
    }

    // Cached preview metadata per item — used by the feed inline-reply
    // composer so it can post into the right thread (and auto-create it if
    // none exists). Populated by enrichDiscussionCounts.
    type DiscussPreview = {
      count: number;
      thread_id?: string;
      lemmy_post_id?: number;
      lemmy_url?: string;
      title?: string;
      comment_count?: number;
      community_name?: string;
      community_url?: string;
    };
    const discussPreview = new Map<string, DiscussPreview>();

    function renderChipMarkup(id: string, p: DiscussPreview): string {
      const count = p.count || 0;
      const replies = p.comment_count;
      const replyTxt = replies != null ? ` · ${replies}` : '';
      const labelText = `💬 ${count}${replyTxt}`;
      const tooltip = `${count} thread${count === 1 ? '' : 's'}${replies != null ? `, ${replies} repl${replies === 1 ? 'y' : 'ies'}` : ''}`;
      // count==1 → link to Lemmy post directly. count>1 (legacy duplicates)
      // or count==0 (no thread) → link to detail page anchor.
      const href =
        count === 1 && p.lemmy_url
          ? p.lemmy_url
          : `/admin/search/detail?id=${encodeURIComponent(id)}#threads-island`;
      const targetAttr =
        count === 1 && p.lemmy_url ? ' target="_blank" rel="noopener"' : '';
      return `<a class="discuss-chip" href="${href}"${targetAttr} title="${tooltip}">${labelText}</a>`;
    }

    async function enrichDiscussionCounts(ids: string[]) {
      if (!ids.length) return;
      try {
        const res = await fetch(
          `/api/threads/counts?anchor_type=media_item&anchor_ids=${encodeURIComponent(ids.join(','))}`,
          { credentials: 'include' },
        );
        if (!res.ok) return;
        const body = await res.json();
        const counts: Record<string, DiscussPreview> = body.counts || {};
        for (const [id, raw] of Object.entries(counts)) {
          // Backward compat: counts used to be `{anchor_id: int}`.
          const p: DiscussPreview =
            typeof raw === 'number' ? { count: raw } : raw;
          if (!p.count) continue;
          discussPreview.set(id, p);
          // Grid + list chip (link out to Lemmy).
          const selector =
            `.grid-item[data-id="${CSS.escape(id)}"] .grid-item__meta, ` +
            `tr[data-id="${CSS.escape(id)}"] .discuss-cell`;
          document.querySelectorAll(selector).forEach((tile) => {
            if (tile.querySelector('.discuss-chip')) return;
            tile.insertAdjacentHTML('beforeend', renderChipMarkup(id, p));
          });
          // Feed view: just update the toggle label with the count.
          updateCommentsToggleLabel(id, p.comment_count ?? null);
        }
      } catch {
        // Silent — discussion is a nice-to-have surface
      }
    }

    function updateCommentsToggleLabel(id: string, count: number | null) {
      const btn = document.querySelector(
        `.feed-item[data-id="${CSS.escape(id)}"] .feed-item__discuss-toggle`,
      ) as HTMLElement | null;
      if (!btn) return;
      if (count == null || count === 0) {
        btn.textContent = '💬 Comments';
      } else {
        btn.textContent = `💬 ${count} comment${count === 1 ? '' : 's'}`;
      }
    }

    // Per-tile HTML builders. Pulled out of renderResults so we can also
    // call them on append (insertAdjacentHTML) without rebuilding tiles
    // that are already in the DOM.
    const GRID_PLAY_SVG = `<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>`;
    const GRID_BRIEFCASE_SVG = `<svg viewBox="0 0 24 24"><path d="M20 7h-4V5c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V9c0-1.1-.9-2-2-2zM10 5h4v2h-4V5z"/></svg>`;

    function renderGridTile(item: any, prev: any | null): string {
      const isPageStart = !prev || prev._page !== item._page;
      const pageStartAttr = isPageStart
        ? ` data-page-start="${item._page}"`
        : '';
      const checked = selectedIds.has(item.id) ? 'checked' : '';
      const selectedClass = selectedIds.has(item.id) ? ' selected' : '';
      const thumbSrc = `/api/media/${item.id}/thumbnail`;
      const thumbSrcSm = `/api/media/${item.id}/thumbnail?size=sm`;
      // srcset lets the browser pick the 128px variant on small grids
      // and the 400px one on wider / retina grids. sizes reflects the
      // actual displayed width of a tile (~160-220px, 128px on mobile).
      const thumb =
        item.media_type === 'image' || item.media_type === 'video'
          ? `<img src="${thumbSrc}" srcset="${thumbSrcSm} 128w, ${thumbSrc} 400w" sizes="(max-width: 480px) 128px, 220px" alt="" loading="lazy" decoding="async" width="400" height="400" />`
          : `<img src="/assets/default-cover.jpg" alt="${item.media_type || '?'}" loading="lazy" style="image-rendering: pixelated;" />`;
      const canPlay =
        item.media_type === 'audio' || item.media_type === 'video';
      const dlBtn = `<a class="grid-item__dl" href="/api/media/${item.id}/file" download title="Download">&#8615;</a>`;
      const wsBtn = `<button class="grid-item__ws" data-ws-id="${item.id}" title="Add to workspace">${GRID_BRIEFCASE_SVG}</button>`;
      // Audio: play queues it in the persistent Player; "+" adds to queue.
      // Video: play opens the viewer for inline playback; no queue button.
      let playBtn = dlBtn;
      if (canPlay) {
        const playTag = `<button class="grid-item__play" data-play-id="${item.id}" data-play-type="${item.media_type}" title="Play">${GRID_PLAY_SVG}</button>`;
        const addTag =
          item.media_type === 'audio'
            ? `<button class="grid-item__add" data-play-id="${item.id}" data-play-type="${item.media_type}" title="Add to queue">+</button>`
            : '';
        playBtn = `${playTag}${addTag}${dlBtn}`;
      }
      const poster =
        (item.sources || []).map((s: any) => s.uploader).filter(Boolean)[0] ||
        '';
      const rxn = item.total_reaction_count ?? 0;
      return `<div class="grid-item${selectedClass}" data-id="${item.id}"${pageStartAttr}>
            <input type="checkbox" class="grid-item__check" data-select="${item.id}" ${checked} />
            <div class="grid-item__thumb">${thumb}${playBtn}${wsBtn}</div>
            <div class="grid-item__info">
              <div class="grid-item__name" title="${item.filename || ''}">
                <button class="bm-star bm-star--sm" data-bm-type="media_item" data-bm-id="${item.id}" title="Bookmark"></button>
                <a class="grid-item__name-link" href="/admin/search/detail?id=${encodeURIComponent(item.id)}">${item.filename || 'Untitled'}</a>
              </div>
              <div class="grid-item__meta">
                ${poster ? `<span>${poster}</span>` : ''}
                ${rxn > 0 ? `<span>${rxn} rxn</span>` : ''}
                <span>${item.tag_count ?? 0} tags</span>
                ${voteChipHtml(item, user?.id ?? null)}
              </div>
            </div>
          </div>`;
    }

    function renderFeedTile(item: any, prev: any | null): string {
      const isPageStart = !prev || prev._page !== item._page;
      const pageStartAttr = isPageStart
        ? ` data-page-start="${item._page}"`
        : '';
      const checked = selectedIds.has(item.id) ? 'checked' : '';
      const selectedClass = selectedIds.has(item.id) ? ' selected' : '';

      // Media element. Images render their full thumbnail. Audio
      // shows a small placeholder card (the persistent Player owns
      // playback). Video plays inline via a controls element.
      let media = '';
      const thumbSrc = `/api/media/${item.id}/thumbnail`;
      const fileSrc = `/api/media/${item.id}/file`;
      if (item.media_type === 'image') {
        media = `<img src="${thumbSrc}" alt="" loading="lazy" decoding="async" />`;
      } else if (item.media_type === 'video') {
        media = `<video src="${fileSrc}" poster="${thumbSrc}" controls preload="metadata" playsinline></video>`;
      } else if (item.media_type === 'audio') {
        media = `<div class="feed-item__placeholder">audio</div>`;
      } else {
        media = `<div class="feed-item__placeholder">${item.media_type || 'file'}</div>`;
      }

      const canPlay =
        item.media_type === 'audio' || item.media_type === 'video';
      const poster =
        (item.sources || []).map((s: any) => s.uploader).filter(Boolean)[0] ||
        '';
      const rxn = item.total_reaction_count ?? 0;
      const date = item.created_at
        ? new Date(item.created_at * 1000).toLocaleDateString()
        : '';

      // Action row mirrors what the grid hides behind hover overlays,
      // but visible. Class names parallel `grid-item__*` so the existing
      // delegated click handlers (broadened to match both views) work
      // without a separate listener wiring per view.
      const actions: string[] = [];
      if (canPlay) {
        actions.push(
          `<button class="action-btn feed-item__play" data-play-id="${item.id}" data-play-type="${item.media_type}">Play</button>`,
        );
        if (item.media_type === 'audio') {
          actions.push(
            `<button class="action-btn feed-item__add" data-play-id="${item.id}" data-play-type="${item.media_type}">+ Queue</button>`,
          );
        }
      }
      actions.push(
        `<a class="action-btn feed-item__dl" href="${fileSrc}" download>Download</a>`,
      );
      actions.push(
        `<button class="action-btn feed-item__ws" data-ws-id="${item.id}">+ Workspace</button>`,
      );
      actions.push(
        `<a class="action-btn" href="/admin/search/detail?id=${item.id}">Details</a>`,
      );

      // Comments toggle is rendered eagerly so it works even when the
      // item has zero comments yet — the first comment auto-creates a
      // backing Lemmy thread server-side. enrichDiscussionCounts swaps
      // "Comments" → "N comments" once counts are known.
      const commentsToggle = `<div class="feed-item__discuss" data-id="${item.id}">
              <button class="feed-item__discuss-toggle" type="button" data-comments-id="${item.id}">💬 Comments</button>
            </div>`;

      return `<article class="feed-item${selectedClass}" data-id="${item.id}"${pageStartAttr}>
              <input type="checkbox" class="feed-item__check" data-select="${item.id}" ${checked} aria-label="Select" />
              <div class="feed-item__media">${media}</div>
              <div class="feed-item__body">
                <div class="feed-item__title-row">
                  <button class="bm-star bm-star--sm" data-bm-type="media_item" data-bm-id="${item.id}" title="Bookmark"></button>
                  <span class="feed-item__name" title="${item.filename || ''}"
                    ><a href="/admin/search/detail?id=${item.id}">${item.filename || 'Untitled'}</a></span>
                </div>
                <div class="feed-item__meta">
                  ${poster ? `<span>${poster}</span>` : ''}
                  ${rxn > 0 ? `<span>${rxn} rxn</span>` : ''}
                  <span>${item.tag_count ?? 0} tags</span>
                  ${date ? `<span>${date}</span>` : ''}
                  ${voteChipHtml(item, user?.id ?? null)}
                </div>
                ${commentsToggle}
                <div class="feed-item__actions">${actions.join('')}</div>
              </div>
            </article>`;
    }

    function renderListRow(item: any, prev: any | null): string {
      const isPageStart = !prev || prev._page !== item._page;
      const pageStartAttr = isPageStart
        ? ` data-page-start="${item._page}"`
        : '';
      const checked = selectedIds.has(item.id) ? 'checked' : '';
      const tags = (item.tags || []).join(', ') || '--';
      const date = item.created_at
        ? new Date(item.created_at * 1000).toLocaleDateString()
        : '--';
      const poster =
        (item.sources || []).map((s: any) => s.uploader).filter(Boolean)[0] ||
        '--';
      const channel = (item.source_channels || [])[0] || '--';
      const rxn = item.total_reaction_count ?? 0;
      return `<tr${pageStartAttr} data-id="${item.id}">
            <td><input type="checkbox" data-select="${item.id}" ${checked} /></td>
            <td><a href="/admin/search/detail?id=${item.id}" style="color: var(--color-text); text-decoration: underline;">${item.filename || 'Untitled'}</a></td>
            <td>${item.media_type || '--'}</td>
            <td>${poster}</td>
            <td>${channel}</td>
            <td style="white-space:nowrap;">${item.file_size_bytes ? formatSize(item.file_size_bytes) : '--'}</td>
            <td>${rxn}</td>
            <td>${voteChipHtml(item, user?.id ?? null)}</td>
            <td>${tags}</td>
            <td style="white-space:nowrap;">${date}</td>
            <td class="discuss-cell"></td>
          </tr>`;
    }

    function buildTileHTML(
      tileFn: (item: any, prev: any | null) => string,
      append: boolean,
      prevLen: number,
    ): string {
      const items = append ? allResults.slice(prevLen) : allResults;
      let html = '';
      for (let i = 0; i < items.length; i++) {
        const item = items[i];
        const prev =
          i === 0
            ? append && prevLen > 0
              ? allResults[prevLen - 1]
              : null
            : items[i - 1];
        html += tileFn(item, prev);
      }
      return html;
    }

    function renderResults(opts: { append?: boolean; prevLen?: number } = {}) {
      const { append = false, prevLen = 0 } = opts;

      if (allResults.length === 0) {
        emptyEl.style.display = 'block';
        footerEl.style.display = 'none';
        selectionBar.style.display = 'none';
        loadMoreObserver?.disconnect();
        if (scrollPageDetectHandler) {
          window.removeEventListener('scroll', scrollPageDetectHandler);
          scrollPageDetectHandler = null;
        }
        return;
      }
      emptyEl.style.display = 'none';

      // Hide non-active views; only touch the active view's display if
      // it isn't already set. Toggling the active view none → flex/grid
      // mid-render collapses document height and clamps window.scrollY
      // to 0 — that was the "page snaps to top on every appended page"
      // bug, and the reason users couldn't tap a tile on page 2+ before
      // the scroll bounced them back.
      const setDisplay = (el: HTMLElement, target: string) => {
        if (el.style.display !== target) el.style.display = target;
      };
      if (currentView !== 'grid') setDisplay(gridEl, 'none');
      if (currentView !== 'feed') setDisplay(feedEl, 'none');
      if (currentView !== 'list') setDisplay(tableEl, 'none');

      if (currentView === 'grid') {
        setDisplay(gridEl, 'grid');
        const html = buildTileHTML(renderGridTile, append, prevLen);
        if (append) gridEl.insertAdjacentHTML('beforeend', html);
        else gridEl.innerHTML = html;
      } else if (currentView === 'feed') {
        setDisplay(feedEl, 'flex');
        const html = buildTileHTML(renderFeedTile, append, prevLen);
        if (append) feedEl.insertAdjacentHTML('beforeend', html);
        else feedEl.innerHTML = html;
      } else {
        setDisplay(tableEl, 'block');
        const html = buildTileHTML(renderListRow, append, prevLen);
        if (append) tbodyEl.insertAdjacentHTML('beforeend', html);
        else tbodyEl.innerHTML = html;
      }

      // Async-enrich rendered tiles with discussion-thread counts.
      // For append, only ping for the newly-added ids. Proxy degrades
      // silently if Lemmy isn't configured.
      const enrichIds = (append ? allResults.slice(prevLen) : allResults).map(
        (it) => it.id,
      );
      enrichDiscussionCounts(enrichIds);

      // Pagination vs infinite-scroll progress footer — feed gets the
      // continuous "1–48 of 230" footer + scroll loader; grid and list get
      // classic prev/next buttons because tile density makes scroll-driven
      // loading feel chaotic on those views.
      const paginationEl = document.getElementById(
        'pagination',
      ) as HTMLElement | null;
      const totalPages = Math.max(1, Math.ceil(totalResults / pageSize));

      if (currentView === 'feed') {
        if (paginationEl) paginationEl.style.display = 'none';
        const loadedLast = allResults.length;
        footerEl.style.display = totalResults > 0 ? 'flex' : 'none';
        progressEl.textContent =
          loadedLast >= totalResults
            ? `${totalResults.toLocaleString()} of ${totalResults.toLocaleString()}`
            : `1–${loadedLast.toLocaleString()} of ${totalResults.toLocaleString()}`;
      } else {
        // Paginated view: hide the infinite-scroll footer, show prev/next.
        footerEl.style.display = 'none';
        if (paginationEl) {
          if (totalPages > 1) {
            paginationEl.style.display = 'flex';
            const pageInfo = document.getElementById('page-info');
            if (pageInfo)
              pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
            const prev = document.getElementById(
              'prev-page',
            ) as HTMLButtonElement | null;
            const next = document.getElementById(
              'next-page',
            ) as HTMLButtonElement | null;
            if (prev) prev.disabled = currentPage <= 1;
            if (next) next.disabled = currentPage >= totalPages;
          } else {
            paginationEl.style.display = 'none';
          }
        }
      }

      setupInfiniteScrollObservers();

      updateSelection();

      // Check bookmarks for visible items
      const bm = (window as any).__bookmarks;
      if (bm) {
        const ids = allResults.map((i: any) => i.id);
        bm.check('media_item', ids).then((set: Set<string>) => {
          document
            .querySelectorAll('.bm-star[data-bm-type="media_item"]')
            .forEach((el: Element) => {
              const id = (el as HTMLElement).dataset.bmId!;
              if (set.has(id)) {
                el.classList.add('bookmarked');
                el.setAttribute('title', 'Remove bookmark');
              }
            });
        });
      }
    }

    // Delegate click for grid items and checkboxes
    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;

      // Bookmark star click
      const starBtn = target.closest('.bm-star') as HTMLElement | null;
      if (starBtn) {
        e.stopPropagation();
        e.preventDefault();
        const bm = (window as any).__bookmarks;
        if (bm) bm.toggle(starBtn.dataset.bmType!, starBtn.dataset.bmId!);
        return;
      }

      // Play button click
      // Video → open viewer for inline playback (handles the full reel).
      // Audio → queue in the persistent Player.
      const playBtn = target.closest(
        '.grid-item__play, .feed-item__play',
      ) as HTMLElement | null;
      if (playBtn) {
        e.stopPropagation();
        e.preventDefault();
        const mediaId = playBtn.dataset.playId!;
        const mediaType = playBtn.dataset.playType!;
        const item = allResults.find((i: any) => i.id === mediaId);
        if (!item) return;
        if (mediaType === 'video') {
          openViewerForMedia(mediaId);
          return;
        }
        document.dispatchEvent(
          new CustomEvent('player:queue', {
            detail: {
              tracks: [
                {
                  track_id: mediaId,
                  title: item.filename || 'Untitled',
                  release_title: '',
                  release_code: '',
                  media_type: mediaType,
                  stream_url: `/api/media/${mediaId}/file`,
                  cover_url:
                    mediaType === 'image' || mediaType === 'video'
                      ? `/api/media/${mediaId}/thumbnail`
                      : '/assets/default-cover.jpg',
                  duration: 0,
                  entity_name: '',
                },
              ],
              startIndex: 0,
            },
          }),
        );
        return;
      }

      // Add to queue button click
      const addBtn = target.closest(
        '.grid-item__add, .feed-item__add',
      ) as HTMLElement | null;
      if (addBtn) {
        e.stopPropagation();
        e.preventDefault();
        const mediaId = addBtn.dataset.playId!;
        const mediaType = addBtn.dataset.playType!;
        const item = allResults.find((i: any) => i.id === mediaId);
        if (!item) return;
        document.dispatchEvent(
          new CustomEvent('player:add', {
            detail: {
              tracks: [
                {
                  track_id: mediaId,
                  title: item.filename || 'Untitled',
                  release_title: '',
                  release_code: '',
                  media_type: mediaType,
                  stream_url: `/api/media/${mediaId}/file`,
                  cover_url:
                    mediaType === 'image' || mediaType === 'video'
                      ? `/api/media/${mediaId}/thumbnail`
                      : '/assets/default-cover.jpg',
                  duration: 0,
                  entity_name: '',
                },
              ],
            },
          }),
        );
        return;
      }

      // Feed-view 💬 Comments toggle. Lazy-renders + populates an inline
      // panel with the comments list and a composer. Reuses the panel on
      // subsequent toggles so drafts and the scroll position survive.
      const commentsToggle = target.closest(
        '.feed-item__discuss-toggle',
      ) as HTMLElement | null;
      if (commentsToggle) {
        e.stopPropagation();
        e.preventDefault();
        const itemId = commentsToggle.dataset.commentsId!;
        // Re-query the discuss row from the live document instead of
        // walking up from the tapped button. The button can already be
        // detached if a feed re-render landed between the tap and this
        // handler (filter-bar mount, scroll-append, applyAndSearch). In
        // that case `commentsToggle.closest(...)` still resolves — but to
        // a node in the *old* subtree, and the panel gets inserted into
        // detached DOM so nothing appears. This was the intermittent
        // "click does nothing" bug on both mobile and desktop.
        const discussRow = document.querySelector(
          `.feed-item__discuss[data-id="${CSS.escape(itemId)}"]`,
        ) as HTMLElement | null;
        if (!discussRow) return;
        let panel = discussRow.nextElementSibling as HTMLElement | null;
        if (panel && panel.classList.contains('feed-item__discuss-panel')) {
          const isHidden = panel.style.display === 'none';
          panel.style.display = isHidden ? 'flex' : 'none';
          if (isHidden)
            (
              panel.querySelector(
                '[data-reply-text]',
              ) as HTMLTextAreaElement | null
            )?.focus();
        } else {
          panel = buildCommentsPanel(itemId);
          discussRow.insertAdjacentElement('afterend', panel);
          loadCommentsIntoPanel(itemId, panel);
          (
            panel.querySelector(
              '[data-reply-text]',
            ) as HTMLTextAreaElement | null
          )?.focus();
        }
        return;
      }

      // Reply-to-comment link inside an open panel.
      const inlineReply = target.closest(
        '.feed-item__comment-reply',
      ) as HTMLElement | null;
      if (inlineReply) {
        e.stopPropagation();
        e.preventDefault();
        const panel = inlineReply.closest(
          '.feed-item__discuss-panel',
        ) as HTMLElement | null;
        if (!panel) return;
        const parentId = inlineReply.dataset.parentId!;
        panel.dataset.replyParent = parentId;
        const indicator = panel.querySelector(
          '[data-reply-parent-indicator]',
        ) as HTMLElement | null;
        if (indicator) {
          indicator.textContent = `Replying to comment #${parentId} — `;
          const cancel = document.createElement('button');
          cancel.type = 'button';
          cancel.className = 'feed-item__cancel-reply';
          cancel.textContent = 'cancel';
          cancel.dataset.cancelReply = '';
          indicator.appendChild(cancel);
          indicator.style.display = '';
        }
        (
          panel.querySelector('[data-reply-text]') as HTMLTextAreaElement | null
        )?.focus();
        return;
      }

      // Cancel the "replying to comment #X" pin.
      const cancelReply = target.closest(
        '[data-cancel-reply]',
      ) as HTMLElement | null;
      if (cancelReply) {
        e.stopPropagation();
        e.preventDefault();
        const panel = cancelReply.closest(
          '.feed-item__discuss-panel',
        ) as HTMLElement | null;
        if (panel) {
          delete panel.dataset.replyParent;
          const indicator = panel.querySelector(
            '[data-reply-parent-indicator]',
          ) as HTMLElement | null;
          if (indicator) {
            indicator.textContent = '';
            indicator.style.display = 'none';
          }
        }
        return;
      }

      // Post button inside the inline panel — pure click handler (no <form>
      // → no default submit → no page-refresh-via-stray-Enter risk).
      const postBtn = target.closest(
        '[data-reply-submit]',
      ) as HTMLButtonElement | null;
      if (postBtn) {
        e.stopPropagation();
        e.preventDefault();
        await submitInlineComment(postBtn);
        return;
      }

      // Add to workspace button click
      const wsBtn = target.closest(
        '.grid-item__ws, .feed-item__ws',
      ) as HTMLElement | null;
      if (wsBtn) {
        e.stopPropagation();
        e.preventDefault();
        const mediaId = wsBtn.dataset.wsId!;
        const data = await addItemsToWorkspace([mediaId]);
        if (data) {
          if (data.already_present > 0)
            (window as any).toast.success('Already in workspace');
          else (window as any).toast.success('Added to workspace');
          refreshWorkspaceBadge();
        } else {
          (window as any).toast.error('Failed to add to workspace');
        }
        return;
      }

      // Checkbox selection
      const checkbox = target.closest(
        '[data-select]',
      ) as HTMLInputElement | null;
      if (checkbox) {
        e.stopPropagation();
        const id = checkbox.dataset.select!;
        if (checkbox.checked) selectedIds.add(id);
        else selectedIds.delete(id);
        updateSelection();
        return;
      }

      // Block grid-item navigation when clicking inside the new filename
      // link — the link's own href handles it, and the parent grid click
      // would otherwise also fire openViewerForMedia / a second navigation.
      if (target.closest('.grid-item__name-link')) {
        return;
      }

      // Grid item click — image or video tiles open the viewer; audio still
      // navigates to detail (audio is better consumed in the persistent
      // Player via its play button).
      const gridItem = target.closest('.grid-item') as HTMLElement | null;
      if (
        gridItem &&
        !target.closest('.grid-item__check') &&
        !target.closest('.grid-item__play') &&
        !target.closest('.grid-item__add') &&
        !target.closest('.grid-item__dl') &&
        !target.closest('.grid-item__ws') &&
        !target.closest('.bm-star')
      ) {
        const id = gridItem.dataset.id;
        if (!id) return;
        const clicked = allResults.find((r: any) => r.id === id);
        if (
          clicked &&
          (clicked.media_type === 'image' || clicked.media_type === 'video')
        ) {
          openViewerForMedia(id);
        } else if (id) {
          window.location.href = `/admin/search/detail?id=${id}`;
        }
      }
    });

    // ------------------------------------------------------------------
    // Inline comments panel (feed view)
    // ------------------------------------------------------------------

    function buildCommentsPanel(itemId: string): HTMLDivElement {
      const panel = document.createElement('div');
      panel.className = 'feed-item__discuss-panel';
      panel.dataset.id = itemId;
      panel.innerHTML = `
        <div class="feed-item__discuss-panel-head">
          <span class="feed-item__discuss-panel-title">Comments</span>
          <span class="feed-item__discuss-panel-fold" data-fold-link></span>
        </div>
        <ul class="feed-item__comments" data-comments-list></ul>
        <div class="feed-item__composer">
          <div class="feed-item__composer-help" data-reply-parent-indicator style="display:none"></div>
          <textarea rows="2" placeholder="Add a comment…" data-reply-text></textarea>
          <div class="feed-item__composer-row">
            <span class="feed-item__composer-help">Posts to fold (c/stacks) as you.</span>
            <button class="action-btn" type="button" data-reply-submit data-item-id="${itemId}">Post</button>
          </div>
        </div>
      `;
      // Render the fold link if we already know about the thread.
      updateFoldLink(itemId, panel);
      return panel;
    }

    function updateFoldLink(itemId: string, panel: HTMLElement) {
      const slot = panel.querySelector(
        '[data-fold-link]',
      ) as HTMLElement | null;
      if (!slot) return;
      const preview = discussPreview.get(itemId);
      if (preview?.lemmy_url) {
        slot.innerHTML = `<a href="${preview.lemmy_url}" target="_blank" rel="noopener">↗ view on fold</a>`;
      } else if (preview?.community_url) {
        slot.innerHTML = `<a href="${preview.community_url}" target="_blank" rel="noopener">↗ c/${preview.community_name || 'stacks'}</a>`;
      } else {
        slot.innerHTML = '';
      }
    }

    async function loadCommentsIntoPanel(itemId: string, panel: HTMLElement) {
      const list = panel.querySelector(
        '[data-comments-list]',
      ) as HTMLElement | null;
      if (!list) return;
      list.innerHTML = `<li class="feed-item__comments-empty muted">Loading…</li>`;
      const preview = discussPreview.get(itemId);
      // No thread yet → show empty-state and let the post-button kick off
      // create-then-comment in one shot.
      if (!preview?.thread_id) {
        list.innerHTML = `<li class="feed-item__comments-empty muted">No comments yet. Be the first.</li>`;
        return;
      }
      try {
        const res = await fetch(
          `/api/threads/${encodeURIComponent(preview.thread_id)}`,
          { credentials: 'include' },
        );
        if (!res.ok) {
          list.innerHTML = `<li class="feed-item__comments-empty muted">Failed to load comments.</li>`;
          return;
        }
        const body = await res.json();
        renderCommentsList(list, body.comments || []);
      } catch {
        list.innerHTML = `<li class="feed-item__comments-empty muted">Failed to load comments.</li>`;
      }
    }

    function renderCommentsList(list: HTMLElement, comments: any[]) {
      if (!comments.length) {
        list.innerHTML = `<li class="feed-item__comments-empty muted">No comments yet. Be the first.</li>`;
        return;
      }
      // Sort by Lemmy comment path (lexicographic preserves parent/child order)
      // and infer depth from path segment count.
      const sorted = [...comments].sort((a, b) =>
        (a.path || '').localeCompare(b.path || ''),
      );
      list.innerHTML = sorted
        .map((c) => {
          const path = String(c.path || '');
          const depth = Math.max(0, path.split('.').filter(Boolean).length - 2);
          const indent = Math.min(depth, 6) * 16;
          const body = c.deleted ? '(deleted)' : escapeHtml(c.content || '');
          const author = escapeHtml(
            c.creator_display_name || c.creator_name || `user #${c.creator_id}`,
          );
          return `<li class="feed-item__comment" style="margin-left: ${indent}px">
            <div class="feed-item__comment-meta">
              <span>${author}</span>
              <span>${c.published ? new Date(c.published).toLocaleString() : ''}</span>
              <button type="button" class="feed-item__comment-reply" data-parent-id="${c.id}">Reply</button>
            </div>
            <div class="feed-item__comment-body">${body}</div>
          </li>`;
        })
        .join('');
    }

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    async function submitInlineComment(postBtn: HTMLButtonElement) {
      const itemId = postBtn.dataset.itemId!;
      const panel = postBtn.closest(
        '.feed-item__discuss-panel',
      ) as HTMLElement | null;
      if (!panel) return;
      const textarea = panel.querySelector(
        '[data-reply-text]',
      ) as HTMLTextAreaElement | null;
      if (!textarea) return;
      const body = textarea.value.trim();
      if (!body) return;
      const parentRaw = panel.dataset.replyParent;
      const parentId = parentRaw ? Number(parentRaw) : null;
      postBtn.disabled = true;
      postBtn.textContent = 'Posting…';
      try {
        let preview = discussPreview.get(itemId) || { count: 0 };
        let threadId = preview.thread_id;
        if (!threadId) {
          // No thread yet — create one silently (POST is upsert for media_item).
          const item = allResults.find((r: any) => r.id === itemId);
          const filename = item?.filename || 'untitled';
          const createRes = await fetch('/api/threads', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              anchor_type: 'media_item',
              anchor_id: itemId,
              title: `Discussion: ${filename}`,
            }),
          });
          if (!createRes.ok) {
            const err = await createRes.json().catch(() => ({}));
            throw new Error(
              err?.detail?.message || err?.detail || 'Failed to start thread',
            );
          }
          const t = await createRes.json();
          threadId = t.id;
          preview = {
            count: 1,
            thread_id: t.id,
            lemmy_post_id: t.lemmy_post_id,
            lemmy_url: t.lemmy_url,
            title: t.title,
            community_name: t.community_name,
            community_url: t.community_url,
            comment_count: 0,
          };
          discussPreview.set(itemId, preview);
        }
        const commentRes = await fetch(
          `/api/threads/${encodeURIComponent(threadId!)}/comments`,
          {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ body, parent_comment_id: parentId }),
          },
        );
        if (!commentRes.ok) {
          const err = await commentRes.json().catch(() => ({}));
          throw new Error(
            err?.detail?.message || err?.detail || 'Failed to post',
          );
        }
        // Bump local cache, refresh the panel's comment list, clear textarea.
        preview.comment_count = (preview.comment_count || 0) + 1;
        discussPreview.set(itemId, preview);
        updateCommentsToggleLabel(itemId, preview.comment_count);
        textarea.value = '';
        delete panel.dataset.replyParent;
        const indicator = panel.querySelector(
          '[data-reply-parent-indicator]',
        ) as HTMLElement | null;
        if (indicator) {
          indicator.textContent = '';
          indicator.style.display = 'none';
        }
        await loadCommentsIntoPanel(itemId, panel);
        // After a possible first-post that minted the thread, the fold link
        // becomes available — refresh the panel header so it shows up.
        updateFoldLink(itemId, panel);
        // Refresh chips in grid + list views too (mirror the count).
        document
          .querySelectorAll(
            `.grid-item[data-id="${CSS.escape(itemId)}"] .discuss-chip, tr[data-id="${CSS.escape(itemId)}"] .discuss-chip`,
          )
          .forEach((c) => c.remove());
        document
          .querySelectorAll(
            `.grid-item[data-id="${CSS.escape(itemId)}"] .grid-item__meta, tr[data-id="${CSS.escape(itemId)}"] .discuss-cell`,
          )
          .forEach((tile) =>
            tile.insertAdjacentHTML(
              'beforeend',
              renderChipMarkup(itemId, preview),
            ),
          );
      } catch (err: any) {
        const toast = (window as any).toast;
        toast?.error?.(err?.message || 'Failed to post');
      } finally {
        postBtn.disabled = false;
        postBtn.textContent = 'Post';
      }
    }

    function openViewerForMedia(startId: string) {
      // Build a list of all image/video items on the current page —
      // they become the reel for prev/next navigation inside the viewer.
      const viewable = (allResults as any[]).filter(
        (r) => r.media_type === 'image' || r.media_type === 'video',
      );
      if (viewable.length === 0) return;
      const startIndex = Math.max(
        0,
        viewable.findIndex((r) => r.id === startId),
      );
      const items: ViewerItem[] = viewable.map((r: any) => ({
        id: r.id,
        kind: 'media_item' as const,
        media_kind:
          r.media_type === 'video' ? ('video' as const) : ('image' as const),
        large_url: `/api/media/${r.id}/thumbnail?size=lg`,
        thumbnail_url: `/api/media/${r.id}/thumbnail?size=sm`,
        download_url: `/api/media/${r.id}/file`,
        stream_url: `/api/media/${r.id}/file`,
        filename: r.filename,
        width: r.image_meta?.width,
        height: r.image_meta?.height,
        dominant_colors: r.dominant_colors,
        media_type: r.media_type,
      }));
      openImageViewer(items, startIndex, {
        onBookmark: async (item) => {
          const bm = (window as any).__bookmarks;
          if (!bm) return false;
          const on = await bm.toggle('media_item', item.id);
          return !!on;
        },
        isBookmarked: async (item) => {
          const bm = (window as any).__bookmarks;
          if (!bm) return false;
          const set = await bm.check(
            'media_item',
            viewable.map((r: any) => r.id),
          );
          return set.has(item.id);
        },
        onAddToWorkspace: async (item) => {
          const data = await addItemsToWorkspace([item.id]);
          if (data) {
            (window as any).toast?.success(
              data.already_present > 0
                ? 'Already in workspace'
                : 'Added to workspace',
            );
          } else {
            (window as any).toast?.error('Failed to add to workspace');
          }
        },
        onDetails: (item) => {
          window.location.href = `/admin/search/detail?id=${item.id}`;
        },
      });
    }

    // Facets, cross-filter logic, and the per-control DOM-restore from URL
    // all live in SearchFilterBar now. The page only handles q + page here.
    const initParams = new URLSearchParams(window.location.search);
    function restoreFromUrl() {
      const si = document.getElementById('search-input') as HTMLInputElement;
      if (initParams.get('q') && si) si.value = initParams.get('q')!;
      if (initParams.get('page'))
        currentPage = parseInt(initParams.get('page')!) || 1;
    }

    function clearFilter(filterName: string) {
      // q lives outside the bar; reset it directly.
      if (filterName === 'q') {
        searchInput.value = '';
        applyAndSearch();
        return;
      }
      // Map active-chip filter names → SearchFilterBar Filters keys.
      const KEY_MAP: Record<string, string> = {
        poster: 'poster',
        tags: 'tagsText',
        colorgroup: 'colorGroups',
        app: 'jobApp',
        transcript: 'hasTranscript',
        ocr: 'hasText',
        channel: 'channels',
        dateFrom: 'dateFrom',
        dateTo: 'dateTo',
        rxn: 'reactionsMin',
        mintags: 'tagsMin',
        types: 'types',
        output_index: 'outputIndexes',
      };
      const key = KEY_MAP[filterName];
      const bar = filterBarEl();
      if (key && bar) {
        bar.dispatchEvent(
          new CustomEvent('filters-reset', { detail: { key } }),
        );
        // The bar emits filters-change after applying the reset, which
        // triggers applyAndSearch via the wrapper listener. No call here.
        return;
      }
      // Legacy 'color' chip — no-op (hex color filter removed long ago).
      if (filterName === 'color') return;
    }
    // Expose for inline onclick
    (window as any).__clearFilter = clearFilter;

    function showActiveFilters() {
      const el = document.getElementById('active-filters')!;
      const filters = getFilters();
      const chips: string[] = [];

      if (searchInput.value) {
        chips.push(
          `<span class="active-filter">Query: "${searchInput.value}" <button class="active-filter__remove" onclick="__clearFilter('q')">&times;</button></span>`,
        );
      }
      if (filters.colorGroups.length) {
        chips.push(
          `<span class="active-filter">Colors: ${filters.colorGroups.join(', ')} <button class="active-filter__remove" onclick="__clearFilter('colorgroup')">&times;</button></span>`,
        );
      }
      if (filters.tags) {
        chips.push(
          `<span class="active-filter">Tags: ${filters.tags} <button class="active-filter__remove" onclick="__clearFilter('tags')">&times;</button></span>`,
        );
      }
      if (filters.poster) {
        chips.push(
          `<span class="active-filter">Posted by: ${filters.poster} <button class="active-filter__remove" onclick="__clearFilter('poster')">&times;</button></span>`,
        );
      }
      if (filters.channels.length) {
        chips.push(
          `<span class="active-filter">Channel: ${filters.channels.join(', ')} <button class="active-filter__remove" onclick="__clearFilter('channel')">&times;</button></span>`,
        );
      }
      if (filters.dateFrom) {
        chips.push(
          `<span class="active-filter">From: ${filters.dateFrom} <button class="active-filter__remove" onclick="__clearFilter('dateFrom')">&times;</button></span>`,
        );
      }
      if (filters.dateTo) {
        chips.push(
          `<span class="active-filter">To: ${filters.dateTo} <button class="active-filter__remove" onclick="__clearFilter('dateTo')">&times;</button></span>`,
        );
      }
      if (filters.reactionsMin > 0) {
        chips.push(
          `<span class="active-filter">Min reactions: ${filters.reactionsMin} <button class="active-filter__remove" onclick="__clearFilter('rxn')">&times;</button></span>`,
        );
      }
      if (filters.tagsMin > 0) {
        chips.push(
          `<span class="active-filter">Min tags: ${filters.tagsMin} <button class="active-filter__remove" onclick="__clearFilter('mintags')">&times;</button></span>`,
        );
      }
      if (filters.types.length < 3 && filters.types.length > 0) {
        chips.push(
          `<span class="active-filter">Types: ${filters.types.join(', ')} <button class="active-filter__remove" onclick="__clearFilter('types')">&times;</button></span>`,
        );
      }
      if (filters.jobApp) {
        chips.push(
          `<span class="active-filter">App: ${filters.jobApp} <button class="active-filter__remove" onclick="__clearFilter('app')">&times;</button></span>`,
        );
      }
      const indexIsDefaultChip =
        filters.outputIndexes.length === 1 &&
        filters.outputIndexes[0] === '__inputs__';
      if (filters.outputIndexes.length && !indexIsDefaultChip) {
        const labels = filters.outputIndexes.map((v) =>
          v === '__inputs__' ? 'Inputs' : v,
        );
        chips.push(
          `<span class="active-filter">Index: ${labels.join(', ')} <button class="active-filter__remove" onclick="__clearFilter('output_index')">&times;</button></span>`,
        );
      }
      if (filters.hasTranscript) {
        const label =
          filters.hasTranscript === 'yes' ? 'has transcript' : 'no transcript';
        chips.push(
          `<span class="active-filter">${label} <button class="active-filter__remove" onclick="__clearFilter('transcript')">&times;</button></span>`,
        );
      }
      if (filters.hasText) {
        const label =
          filters.hasText === 'yes' ? 'has OCR text' : 'no OCR text';
        chips.push(
          `<span class="active-filter">${label} <button class="active-filter__remove" onclick="__clearFilter('ocr')">&times;</button></span>`,
        );
      }

      // Active-filter count drives the badge on the Filters toggle button.
      const activeCount = chips.length;
      const countEl = document.getElementById('filter-toggle-count');
      if (countEl) {
        if (activeCount > 0) {
          countEl.textContent = String(activeCount);
          countEl.removeAttribute('hidden');
        } else {
          countEl.setAttribute('hidden', '');
        }
      }
      if (chips.length > 0) {
        chips.push(
          `<button class="action-btn" onclick="location.href='/admin/search'" style="margin-left:auto;">Clear All</button>`,
        );
        el.innerHTML = chips.join('');
        el.style.display = 'flex';
      } else {
        el.innerHTML = '';
        el.style.display = 'none';
      }
    }

    // --- Stats bar & Insights rendering ---

    function renderStatsBar(
      countsByType: Record<string, number>,
      total: number,
    ) {
      const statsBar = document.getElementById('stats-bar')!;
      if (total === 0) {
        statsBar.style.display = 'none';
        return;
      }

      const parts: string[] = [
        `<span class="stat-total">${total.toLocaleString()} results</span>`,
      ];
      const typeLabels: Record<string, string> = {
        image: 'images',
        audio: 'audio',
        video: 'videos',
      };
      for (const [type, label] of Object.entries(typeLabels)) {
        const count = countsByType[type];
        if (count > 0) {
          parts.push(`<span class="stat-sep">/</span>`);
          parts.push(
            `<span class="stat-type" data-type-filter="${type}">${count} ${label}</span>`,
          );
        }
      }
      statsBar.innerHTML = parts.join(' ');
      statsBar.style.display = 'flex';

      // Click type counts to filter — push a single-type selection into the bar.
      statsBar.querySelectorAll('.stat-type').forEach((el) => {
        el.addEventListener('click', () => {
          const type = (el as HTMLElement).dataset.typeFilter!;
          patchFilterBar({ types: [type] });
        });
      });
    }

    // Helper: dispatch a partial-state patch into SearchFilterBar. The bar
    // applies it and re-emits filters-change, which triggers applyAndSearch
    // via the wrapper-level listener — so callers don't call it themselves.
    function patchFilterBar(patch: Record<string, unknown>) {
      const bar = filterBarEl();
      if (!bar) return;
      bar.dispatchEvent(new CustomEvent('filters-set', { detail: { patch } }));
    }

    async function fetchStats(searchBody: any) {
      try {
        const res = await fetch('/api/search/stats', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(searchBody),
        });
        if (!res.ok) return;
        const stats = await res.json();
        renderInsights(stats);
      } catch {}
    }

    function renderInsights(stats: any) {
      const section = document.getElementById('insights-section')!;
      section.style.display = 'block';

      renderBarChart(
        'insight-uploaders',
        'Top Posters',
        stats.top_uploaders || [],
        'uploader',
        'count',
      );
      renderBarChart(
        'insight-tags',
        'Top Tags',
        stats.top_tags || [],
        'tag',
        'count',
      );
      renderReactionChart(stats.reaction_buckets || []);
      renderTimeline(stats.date_histogram || []);
      renderColorChart(stats.color_groups || {});
    }

    function renderBarChart(
      containerId: string,
      title: string,
      items: any[],
      labelKey: string,
      countKey: string,
    ) {
      const el = document.getElementById(containerId)!;
      if (!items.length) {
        el.innerHTML = '';
        return;
      }
      const max = Math.max(...items.map((i) => i[countKey]), 1);
      const rows = items
        .slice(0, 10)
        .map((item) => {
          const pct = Math.round((item[countKey] / max) * 100);
          const label = item[labelKey];
          return `<div class="insight-bar-row insight-clickable" data-insight-type="${labelKey}" data-insight-value="${label}" title="${label}: ${item[countKey]}">
          <span class="insight-bar-label">${label}</span>
          <span class="insight-bar-track"><span class="insight-bar-fill" style="width:${pct}%"></span></span>
          <span class="insight-bar-count">${item[countKey]}</span>
        </div>`;
        })
        .join('');
      el.innerHTML = `<div class="insight-title">${title}</div>${rows}`;

      // Click to filter — patch the bar with the new tag list or poster.
      el.querySelectorAll('.insight-clickable').forEach((row) => {
        row.addEventListener('click', () => {
          const type = (row as HTMLElement).dataset.insightType!;
          const value = (row as HTMLElement).dataset.insightValue!;
          if (type === 'tag') {
            const current = getFilters().tags;
            const existing = current
              .split(',')
              .map((t: string) => t.trim())
              .filter(Boolean);
            if (!existing.includes(value)) existing.push(value);
            patchFilterBar({ tagsText: existing.join(', ') });
          } else if (type === 'uploader') {
            patchFilterBar({ poster: value });
          }
        });
      });
    }

    function renderReactionChart(buckets: any[]) {
      const el = document.getElementById('insight-reactions')!;
      if (!buckets.length) {
        el.innerHTML = '';
        return;
      }
      const max = Math.max(...buckets.map((b) => b.count), 1);
      const rows = buckets
        .map((b) => {
          // Extract minimum value from label (e.g. "3-5" → 3, "26+" → 26, "0" → 0)
          const minVal = parseInt(b.label.replace('+', ''));
          const pct = Math.round((b.count / max) * 100);
          return `<div class="insight-bar-row insight-clickable" data-reaction-min="${minVal}" title="${b.label} reactions: ${b.count} items">
          <span class="insight-bar-label">${b.label}</span>
          <span class="insight-bar-track"><span class="insight-bar-fill" style="width:${pct}%"></span></span>
          <span class="insight-bar-count">${b.count}</span>
        </div>`;
        })
        .join('');
      el.innerHTML = `<div class="insight-title">Reactions</div>${rows}`;

      el.querySelectorAll('.insight-clickable').forEach((row) => {
        row.addEventListener('click', () => {
          const minVal = (row as HTMLElement).dataset.reactionMin!;
          patchFilterBar({ reactionsMin: parseInt(minVal, 10) || 0 });
        });
      });
    }

    function renderTimeline(histogram: any[]) {
      const el = document.getElementById('insight-timeline')!;
      if (!histogram.length) {
        el.innerHTML = '';
        return;
      }
      const max = Math.max(...histogram.map((h) => h.count), 1);
      // Show last 12 months max
      const recent = histogram.slice(-12);
      const rows = recent
        .map((h) => {
          const pct = Math.round((h.count / max) * 100);
          return `<div class="insight-bar-row insight-clickable" data-month="${h.month}" title="${h.month}: ${h.count} items">
          <span class="insight-bar-label">${h.month}</span>
          <span class="insight-bar-track"><span class="insight-bar-fill" style="width:${pct}%"></span></span>
          <span class="insight-bar-count">${h.count}</span>
        </div>`;
        })
        .join('');
      el.innerHTML = `<div class="insight-title">Timeline</div>${rows}`;

      el.querySelectorAll('.insight-clickable').forEach((row) => {
        row.addEventListener('click', () => {
          const month = (row as HTMLElement).dataset.month!; // "YYYY-MM"
          const [year, mon] = month.split('-').map(Number);
          const lastDay = new Date(year, mon, 0).getDate();
          patchFilterBar({
            dateFrom: `${month}-01`,
            dateTo: `${month}-${String(lastDay).padStart(2, '0')}`,
          });
        });
      });
    }

    function renderColorChart(colorGroups: Record<string, number>) {
      const el = document.getElementById('insight-colors')!;
      const entries = Object.entries(colorGroups).sort((a, b) => b[1] - a[1]);
      if (!entries.length) {
        el.innerHTML = '';
        return;
      }
      const max = Math.max(...entries.map((e) => e[1]), 1);
      const colorMap: Record<string, string> = {
        red: '#e53935',
        orange: '#fb8c00',
        yellow: '#fdd835',
        green: '#43a047',
        teal: '#00897b',
        blue: '#1e88e5',
        purple: '#8e24aa',
        pink: '#d81b60',
        brown: '#6d4c41',
        beige: '#d7ccc8',
        gray: '#9e9e9e',
        black: '#212121',
        white: '#f5f5f5',
      };
      const rows = entries
        .map(([color, count]) => {
          const pct = Math.round((count / max) * 100);
          const hex = colorMap[color] || '#999';
          return `<div class="insight-bar-row" title="${color}: ${count} items" data-color-filter="${color}">
          <span class="insight-bar-label" style="display:flex;align-items:center;justify-content:flex-end;gap:4px;">
            <span style="display:inline-block;width:10px;height:10px;background:${hex};border:1px solid #ccc;flex-shrink:0;"></span>
            ${color}
          </span>
          <span class="insight-bar-track"><span class="insight-bar-fill" style="width:${pct}%;background:${hex}"></span></span>
          <span class="insight-bar-count">${count}</span>
        </div>`;
        })
        .join('');
      el.innerHTML = `<div class="insight-title">Colors</div>${rows}`;

      // Click to filter by color — single-color selection overrides any
      // URL-preserved multi-color state inside the bar.
      el.querySelectorAll('[data-color-filter]').forEach((row) => {
        row.addEventListener('click', () => {
          const color = (row as HTMLElement).dataset.colorFilter!;
          patchFilterBar({
            colorGroups: [color],
            preservedMultiColors: [],
          });
        });
      });
    }

    // Scroll restoration: when the user taps a search result and comes back
    // (or hits refresh), put them back on the exact tile they were looking at.
    //
    // We anchor to a result tile's `data-id` + its viewport offset, NOT to a
    // pixel scrollY. Two reasons:
    //   1. Pixel scrollY only makes sense if the DOM is exactly as tall as it
    //      was on save. On return we deliberately load only the saved page —
    //      reloading the whole feed buffer to rebuild scroll height is slow
    //      and wasteful when all we need is to land on one tile.
    //   2. Feed-view thumbnails are lazy with no intrinsic dimensions, so the
    //      DOM grows asynchronously as images decode. A scrollY-target gets
    //      clamped on a short DOM and stops short. An element-target moves
    //      with the layout, so we can re-anchor each frame until it settles.
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    const SCROLL_KEY = 'au.searchScroll';
    type SavedScroll = {
      search: string;
      // Anchor (preferred): id of the topmost in-viewport tile + the offset
      // (px) from viewport top to that tile's top at save time.
      itemId?: string;
      offset?: number;
      // Legacy entries written by the old scrollY-based code. Used as a
      // best-effort fallback; replaced on the next nav-away.
      scrollY?: number;
    };

    function readSavedScroll(): SavedScroll | null {
      try {
        const raw = sessionStorage.getItem(SCROLL_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw) as SavedScroll;
        return parsed.search === window.location.search ? parsed : null;
      } catch {
        return null;
      }
    }

    // Topmost visible result tile (across all three views). DOM order is
    // visual order, so we can stop once a tile is fully below the viewport.
    // Tiles entirely above the viewport are skipped so that abs(rect.top)
    // can't pick a just-scrolled-past tile over the actually-visible one.
    function findTopAnchorItem(): {
      id: string;
      offset: number;
      page: number;
    } | null {
      const tiles = document.querySelectorAll<HTMLElement>(
        '.grid-item[data-id], .feed-item[data-id], tr[data-id]',
      );
      let best: { id: string; offset: number; page: number } | null = null;
      for (const el of tiles) {
        const rect = el.getBoundingClientRect();
        if (rect.bottom <= 0) continue;
        if (rect.top > window.innerHeight) break;
        if (best === null || Math.abs(rect.top) < Math.abs(best.offset)) {
          const id = el.dataset.id!;
          const item = allResults.find((r) => r.id === id);
          best = { id, offset: rect.top, page: item?._page || 1 };
        }
      }
      return best;
    }

    // Astro view-transitions reuse the document across pages, so the
    // pagehide / astro:before-preparation / visibilitychange / click
    // listeners we registered here keep firing while the user is on the
    // detail page (and any other page in the SPA). On those pages there
    // are no result tiles, so findTopAnchorItem returns null AND
    // window.location.search is the detail URL — which would corrupt
    // sessionStorage with a key that never matches `?page=N` on return.
    // Hard-guard: this function is a no-op anywhere but the search index.
    function onSearchIndex(): boolean {
      const p = window.location.pathname;
      return p === '/admin/search' || p === '/admin/search/';
    }

    function saveScrollState() {
      if (!onSearchIndex()) return;
      try {
        const anchor = findTopAnchorItem();
        // Nothing meaningful to anchor to (no results, scrolled past the
        // end, or the listener fired in a transient render state). Don't
        // clobber a previously-saved good entry with a half-formed one.
        if (!anchor) return;
        // The feed-view scroll-driven `?page=` updater runs in rAF, so the URL
        // can lag the actual visible page by a frame. Click-capture fires
        // synchronously, between frames — pin the URL to the anchor's true
        // page before snapshotting `search`, so restore loads the right page.
        const params = new URLSearchParams(window.location.search);
        if (anchor.page > 1) params.set('page', String(anchor.page));
        else params.delete('page');
        const qs = params.toString();
        const newUrl = window.location.pathname + (qs ? '?' + qs : '');
        if (newUrl !== window.location.pathname + window.location.search) {
          history.replaceState(history.state, '', newUrl);
        }
        sessionStorage.setItem(
          SCROLL_KEY,
          JSON.stringify({
            search: window.location.search,
            itemId: anchor.id,
            offset: anchor.offset,
          }),
        );
      } catch {}
    }

    // Save on every nav-away path we know about. Belt-and-suspenders:
    //  - capture-phase click on result links: synchronous save before the
    //    handler that triggers navigation gets a chance to schedule things;
    //  - pagehide: full nav (window.location.href = ...) + tab close;
    //  - astro:before-preparation: Astro VT in-tab nav;
    //  - visibilitychange: covers mobile tab-switch + some refresh paths.
    document.addEventListener(
      'click',
      (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        // Any link that navigates away from the search results page should
        // capture state. Match links inside grid/feed/list tiles + the
        // filename links specifically.
        const navLink = target.closest(
          'a[href^="/admin/search/detail"], .grid-item__name-link, .feed-item__title-row a, .results-grid a, .results-feed a, .results-table a',
        );
        if (navLink) saveScrollState();
      },
      true, // capture phase — fire before delegated handlers cancel anything
    );
    window.addEventListener('pagehide', saveScrollState);
    document.addEventListener('astro:before-preparation', saveScrollState);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') saveScrollState();
    });

    // Restore the page-owned bits (q, page) from URL. SearchFilterBar
    // self-restores its own state and loads facets on mount.
    restoreFromUrl();

    const savedScroll = readSavedScroll();
    if (savedScroll) {
      // One fetch is enough: restoreFromUrl set currentPage from `?page=N`,
      // which is the page that contains the saved anchor. Reloading earlier
      // pages is unnecessary because we scroll to an element, not a pixel Y.
      await doSearch();
      if (savedScroll.itemId) {
        await scrollToAnchor(savedScroll.itemId, savedScroll.offset ?? 0);
      } else if (typeof savedScroll.scrollY === 'number') {
        // Legacy entry — best-effort one-shot. Replaced on next nav-away.
        window.scrollTo(0, savedScroll.scrollY);
      }
    } else {
      doSearch();
    }

    // Re-anchor to the saved tile after results render. We can't just scroll
    // once: feed thumbnails are lazy with no intrinsic dimensions, so the
    // element's position drifts over the next few frames as images decode
    // (and discussion chips arrive). The loop corrects each frame against
    // the element's live rect, then bails as soon as the position is stable
    // — or 1.5s passes, whichever comes first.
    async function scrollToAnchor(itemId: string, offset: number) {
      // Tile-only — `.feed-item__discuss` carries a matching data-id too.
      const id = CSS.escape(itemId);
      const el = document.querySelector(
        `.grid-item[data-id="${id}"], .feed-item[data-id="${id}"], tr[data-id="${id}"]`,
      ) as HTMLElement | null;
      if (!el) return;
      el.scrollIntoView({ block: 'start' });
      window.scrollBy(0, -offset);
      await new Promise<void>((resolve) => {
        const deadline = performance.now() + 1500;
        let stable = 0;
        const tick = () => {
          const drift = el.getBoundingClientRect().top - offset;
          if (Math.abs(drift) > 0.5) {
            window.scrollBy(0, drift);
            stable = 0;
          } else {
            stable++;
          }
          if (stable >= 5 || performance.now() > deadline) {
            resolve();
            return;
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }
  });
</script>
