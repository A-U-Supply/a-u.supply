---
import Admin from '../../../layouts/Admin.astro';
import SearchFilterBar from '../../../components/SearchFilterBar.svelte';
---

<Admin title="The Stacks" current="search">
  <div class="page-header">
    <h1>The Stacks</h1>
    <div class="header-actions">
      <a
        class="workspace-badge"
        id="workspace-badge"
        href="/admin/search/workspace"
        style="display:none;"
        title="View workspace">Workspace: <span id="workspace-count">0</span></a
      >
      <button
        class="sync-btn"
        id="sync-now-btn"
        title="Sync new media from Slack">Sync Now</button
      >
      <span class="sync-status" id="sync-status"></span>
      <div class="view-toggle">
        <button class="toggle-btn" id="grid-view-btn" title="Grid view"
          >Grid</button
        >
        <button class="toggle-btn active" id="feed-view-btn" title="Feed view"
          >Feed</button
        >
        <button class="toggle-btn" id="list-view-btn" title="List view"
          >List</button
        >
      </div>
    </div>
  </div>

  <div class="search-row">
    <button
      class="filter-toggle"
      id="filter-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="filter-body"
    >
      <span>Filters</span>
      <span class="filter-toggle__count" id="filter-toggle-count" hidden>0</span
      >
    </button>
    <form id="search-form" class="search-bar">
      <input
        type="text"
        id="search-input"
        placeholder="Search media..."
        autocomplete="off"
      />
      <button type="submit" class="search-submit">Search</button>
    </form>
  </div>

  <div class="filter-body" id="filter-body">
    <div id="filter-bar-host">
      <SearchFilterBar client:load syncUrl={true} />
    </div>

    <button
      class="action-btn"
      id="apply-filters"
      style="width:100%; margin-top: var(--space-xs);">Apply Filters</button
    >

    <div class="insights-section" id="insights-section" style="display:none;">
      <button class="insights-toggle" id="insights-toggle">Insights</button>
      <div class="insights-body" id="insights-body">
        <div class="insight-group" id="insight-uploaders"></div>
        <div class="insight-group" id="insight-tags"></div>
        <div class="insight-group" id="insight-reactions"></div>
        <div class="insight-group" id="insight-timeline"></div>
        <div class="insight-group" id="insight-colors"></div>
      </div>
    </div>
  </div>

  <div class="results-area">
    <div class="stats-bar" id="stats-bar" style="display:none;"></div>
    <div id="active-filters" class="active-filters" style="display:none;"></div>
    <!-- Selection bar — visible whenever results exist. The tri-state
         "Select" checkbox tracks loaded items (unchecked / indeterminate /
         all-loaded). Action buttons and the "Select all N matching" link
         appear only when at least one item is selected. -->
    <div class="selection-bar" id="selection-bar" style="display:none;">
      <label class="selection-toggle" title="Select all loaded items">
        <input type="checkbox" id="select-toggle" />
        <span class="selection-toggle__label" id="select-toggle-label"
          >Select</span
        >
      </label>
      <span class="selection-count" id="selected-count" hidden>0 selected</span>
      <a
        class="selection-expand"
        id="select-all-matching"
        href="#"
        role="button"
        hidden></a>
      <div class="selection-actions" id="selection-actions" hidden>
        <button class="action-btn" data-batch="tag">Tag</button>
        <button class="action-btn" data-batch="workspace">+ Workspace</button>
        <button class="action-btn" data-batch="re-extract">Re-extract</button>
        <button class="action-btn" data-batch="export">Export</button>
        <button class="action-btn action-btn--danger" data-batch="delete"
          >Delete</button
        >
        <button class="action-btn" id="clear-selection">Clear</button>
      </div>
    </div>

    <div id="loading" style="color: var(--color-muted);">
      <span class="loading-dots">Loading</span>
    </div>
    <div id="error" class="login-error" style="display:none;"></div>
    <div id="empty" class="empty-state" style="display:none;">
      <div class="empty-state__icon">&#128269;</div>
      No media found.
    </div>

    <div id="results-grid" class="results-grid" style="display:none;"></div>
    <div id="results-feed" class="results-feed" style="display:none;"></div>

    <div class="table-wrap" id="results-table" style="display:none;">
      <table class="release-table">
        <thead>
          <tr>
            <th aria-label="Select"></th>
            <th>Filename</th>
            <th>Type</th>
            <th>Posted By</th>
            <th>Channel</th>
            <th>Size</th>
            <th>Reactions</th>
            <th>Acclaim</th>
            <th>Tags</th>
            <th>Created</th>
            <th>Discussion</th>
          </tr>
        </thead>
        <tbody id="results-tbody"></tbody>
      </table>
    </div>

    <div id="load-more-sentinel" class="load-more-sentinel" aria-hidden="true">
    </div>
    <div class="pagination" id="pagination" style="display:none;">
      <button class="action-btn" id="prev-page" type="button">Prev</button>
      <span id="page-info">Page 1</span>
      <button class="action-btn" id="next-page" type="button">Next</button>
    </div>
    <div class="results-footer" id="results-footer" style="display:none;">
      <span id="results-progress">0 of 0</span>
      <span id="results-loading-more" hidden>Loading more…</span>
    </div>
  </div>

  <!-- Batch tag dialog -->
  <div class="dialog-overlay" id="batch-tag-dialog" style="display:none;">
    <div class="dialog">
      <p>Add tags to selected items</p>
      <input
        type="text"
        id="batch-tag-input"
        placeholder="Comma-separated tags"
        style="width:100%; margin-top: var(--space-sm); padding: var(--space-xs); font-family: var(--font-mono); font-size: var(--text-sm); border: 1px solid var(--color-border);"
      />
      <div class="dialog-actions">
        <button class="btn-cancel" id="batch-tag-cancel">Cancel</button>
        <button class="action-btn" id="batch-tag-confirm">Apply Tags</button>
      </div>
    </div>
  </div>

  <!-- Delete confirmation dialog -->
  <div class="dialog-overlay" id="delete-dialog" style="display:none;">
    <div class="dialog">
      <p>Delete <strong id="delete-count">0</strong> selected items?</p>
      <p
        style="color: var(--color-muted); font-size: var(--text-sm); margin-top: var(--space-xs);"
      >
        This action cannot be undone.
      </p>
      <div class="dialog-actions">
        <button class="btn-cancel" id="delete-cancel">Cancel</button>
        <button class="btn-danger" id="delete-confirm">Delete</button>
      </div>
    </div>
  </div>
</Admin>

<style>
  .workspace-badge {
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
    background: none;
    border: 1px solid var(--color-border);
    text-decoration: none;
  }
  .workspace-badge:hover {
    border-color: var(--color-text);
  }
  .sync-btn {
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    background: var(--color-fg);
    color: var(--color-bg);
    border: 2px solid #1a1a1a;
    cursor: pointer;
  }
  .sync-btn:hover {
    background: color-mix(in srgb, var(--color-fg) 80%, var(--color-bg));
    border-color: color-mix(in srgb, var(--color-fg) 80%, var(--color-bg));
  }
  .sync-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .sync-btn.syncing {
    background: none;
    color: var(--color-text);
    border-color: var(--color-border);
  }
  .sync-status {
    font-size: 0.65rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .view-toggle {
    display: flex;
    gap: 0;
  }
  .toggle-btn {
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    background: none;
    border: 1px solid var(--color-border);
    cursor: pointer;
    color: var(--color-muted);
  }
  .toggle-btn:first-child {
    border-right: none;
  }
  .toggle-btn.active {
    color: var(--color-text);
    font-weight: bold;
    background: var(--color-bg);
    border-color: var(--color-text);
  }

  .search-bar {
    display: flex;
    gap: 0;
    margin: var(--space-md) 0;
  }
  .search-bar input {
    flex: 1;
    padding: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    border: 2px solid var(--color-text);
    border-right: none;
    background: var(--color-bg);
    color: var(--color-text);
  }
  .search-bar input:focus {
    outline: none;
    border-color: var(--color-accent);
  }
  .search-submit {
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1pt;
    background: var(--color-fg);
    color: var(--color-bg);
    border: 2px solid #1a1a1a;
    cursor: pointer;
  }
  .search-submit:hover {
    background: color-mix(in srgb, var(--color-fg) 80%, var(--color-bg));
    border-color: color-mix(in srgb, var(--color-fg) 80%, var(--color-bg));
  }

  /* Search row: filter toggle button + search bar, side by side.
     The filter body collapses inline below this row when toggled. */
  .search-row {
    display: flex;
    gap: var(--space-sm);
    margin: var(--space-md) 0;
    align-items: stretch;
  }
  .filter-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 0 var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: 1pt;
    text-transform: uppercase;
    background: var(--color-bg);
    border: 2px solid var(--color-text);
    cursor: pointer;
    color: var(--color-text);
    transition:
      background 80ms,
      color 80ms;
  }
  .filter-toggle:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .filter-toggle[aria-expanded='true'] {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .filter-toggle .filter-toggle__count {
    color: var(--color-bg);
    background: var(--color-accent);
    padding: 1px 6px;
    font-size: 0.65rem;
  }
  .filter-toggle:hover .filter-toggle__count,
  .filter-toggle[aria-expanded='true'] .filter-toggle__count {
    color: var(--color-text);
    background: var(--color-bg);
  }
  .filter-toggle .filter-toggle__count[hidden] {
    display: none;
  }
  /* The search-bar inside .search-row: remove its old top margin since
     .search-row owns spacing now. */
  .search-row .search-bar {
    flex: 1;
    margin: 0;
    min-width: 0;
  }
  /* Filter body: hidden by default, expands inline (pushes results down)
     when the toggle is opened. Two-column on wide screens, stacked on
     narrow ones, so the form fields don't get cramped. */
  .filter-body {
    display: none;
    border: 1px solid var(--color-border);
    padding: var(--space-md);
    margin-bottom: var(--space-md);
  }
  .filter-body.open {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-sm) var(--space-md);
    align-items: start;
  }
  .filter-body.open #apply-filters {
    grid-column: 1 / -1;
  }
  .filter-body.open .insights-section {
    grid-column: 1 / -1;
  }

  .active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: var(--space-xs) 0;
    margin-bottom: var(--space-xs);
    font-size: 0.7rem;
  }
  .active-filter {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .active-filter__remove {
    background: none;
    border: none;
    color: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }
  .active-filter__color {
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 1px solid #ccc;
    vertical-align: middle;
  }

  /* Stats bar */
  .stats-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    font-size: 0.65rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-xs);
    flex-wrap: wrap;
  }
  .stats-bar .stat-total {
    color: var(--color-text);
    font-weight: bold;
  }
  .stats-bar .stat-type {
    cursor: pointer;
  }
  .stats-bar .stat-type:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
  .stats-bar .stat-sep {
    color: var(--color-border);
  }

  /* Insights panel */
  .insights-section {
    margin-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-sm);
  }
  .insights-toggle {
    width: 100%;
    padding: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    background: none;
    border: 1px solid var(--color-border);
    cursor: pointer;
    color: var(--color-text);
  }
  .insights-toggle:hover {
    border-color: var(--color-text);
  }
  .insights-body {
    margin-top: var(--space-sm);
  }
  .insights-body.collapsed {
    display: none;
  }
  .insight-group {
    margin-bottom: var(--space-md);
  }
  .insight-group:empty {
    display: none;
  }
  .insight-title {
    font-size: 0.6rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    margin-bottom: var(--space-xs);
  }
  .insight-bar-row {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 2px;
    font-size: 0.6rem;
    cursor: pointer;
  }
  .insight-bar-row:hover {
    color: var(--color-accent);
  }
  .insight-bar-label {
    flex: 0 0 70px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: right;
  }
  .insight-bar-track {
    flex: 1;
    height: 10px;
    background: var(--color-surface-2);
    position: relative;
  }
  .insight-bar-fill {
    height: 100%;
    background: var(--color-text);
    transition: width 0.3s;
  }
  .insight-bar-row:hover .insight-bar-fill {
    background: var(--color-accent);
  }
  .insight-bar-count {
    flex: 0 0 30px;
    text-align: right;
    color: var(--color-muted);
    font-size: 0.55rem;
  }

  .selection-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }
  .selection-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    user-select: none;
  }
  .selection-toggle input[type='checkbox'] {
    width: 16px;
    height: 16px;
    cursor: pointer;
    accent-color: var(--color-text);
  }
  .selection-count {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .selection-expand {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }
  .selection-expand:hover {
    color: var(--color-accent, var(--color-text));
  }
  .selection-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-left: auto;
    flex-wrap: wrap;
  }

  .load-more-sentinel {
    height: 1px;
    width: 100%;
    pointer-events: none;
  }
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .pagination .action-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .results-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm);
    margin-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .results-footer #results-loading-more {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .page-header {
      flex-direction: column;
      align-items: stretch;
    }
    .header-actions {
      flex-wrap: wrap;
    }
    .search-bar input {
      font-size: 16px;
    } /* prevent iOS zoom */
    .search-row {
      flex-direction: column;
    }
    .filter-toggle {
      padding: var(--space-xs) var(--space-md);
      justify-content: space-between;
    }
    .stats-bar {
      font-size: 0.6rem;
      gap: var(--space-xs);
    }
  }
</style>

<!-- Global styles for dynamically rendered grid items (innerHTML) -->
<style is:global>
  .discuss-chip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0 5px;
    margin-left: 4px;
    text-decoration: none;
    cursor: pointer;
  }
  .discuss-chip:hover {
    color: var(--color-text);
    border-color: var(--color-text);
  }
  .grid-item__name-link {
    color: inherit;
    text-decoration: none;
  }
  .grid-item__name-link:hover {
    text-decoration: underline;
  }
  .feed-item__discuss {
    padding: 4px 0;
    border-top: 1px dashed var(--color-border);
    font-size: var(--text-sm);
  }
  .feed-item__discuss-toggle {
    background: transparent;
    border: 0;
    padding: 4px 8px;
    margin: 0;
    cursor: pointer;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    text-align: left;
  }
  .feed-item__discuss-toggle:hover {
    text-decoration: underline;
  }
  .feed-item__discuss-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-sm);
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .feed-item__discuss-panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    color: var(--color-muted);
  }
  .feed-item__discuss-panel-fold a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .feed-item__discuss-panel-fold a:hover {
    text-decoration: underline;
  }
  .feed-item__comments {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 320px;
    overflow-y: auto;
  }
  .feed-item__comments-empty {
    padding: 4px 0;
  }
  .feed-item__comment {
    border-left: 2px solid var(--color-border);
    padding: 4px 8px;
    background: var(--color-bg);
  }
  [data-theme='dark'] .feed-item__comment {
    background: var(--color-surface-2);
  }
  .feed-item__comment-meta {
    color: var(--color-muted);
    font-size: 0.65rem;
    display: flex;
    gap: 8px;
    align-items: center;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .feed-item__comment-meta .feed-item__comment-reply,
  .feed-item__cancel-reply {
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    color: var(--color-accent);
    text-decoration: none;
    cursor: pointer;
    font: inherit;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .feed-item__comment-meta .feed-item__comment-reply:hover,
  .feed-item__cancel-reply:hover {
    text-decoration: underline;
  }
  .feed-item__comment-body {
    white-space: pre-wrap;
    font-size: var(--text-sm);
    margin-top: 2px;
  }
  .feed-item__composer {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .feed-item__composer textarea {
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: 6px 10px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    resize: vertical;
  }
  @media (max-width: 640px) {
    /* iOS Safari zooms the viewport when a focused input's computed
       font-size is below 16px. The composer auto-focuses on open, so
       this prevents the jarring zoom-in on tap. */
    .feed-item__composer textarea {
      font-size: 16px;
    }
  }
