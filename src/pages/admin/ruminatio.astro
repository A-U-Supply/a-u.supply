---
import Admin from '../../layouts/Admin.astro';
---

<Admin title="Ruminatio" current="ruminatio">
  <div class="page-header">
    <h1>Ruminatio</h1>
    <p class="page-subtitle">output feed</p>
  </div>

  <div class="ru-feed" id="ru-feed">
    <div class="ru-loading" id="ru-loading">Loading…</div>
  </div>
  <div id="ru-sentinel" style="height:1px"></div>

  <style>
    .ru-feed {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      max-width: 680px;
    }

    /* ── Card ── */
    .ru-card {
      border: 1px solid var(--border, #2a2a2a);
      border-radius: 6px;
      overflow: hidden;
    }
    .ru-card__media {
      background: #0a0a0a;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 120px;
      max-height: 480px;
      overflow: hidden;
    }
    .ru-card__media img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 480px;
      object-fit: contain;
    }
    .ru-card__audio-placeholder {
      padding: 2rem;
      font-size: 2rem;
      opacity: 0.2;
    }
    .ru-card__body { padding: 0.75rem 1rem; }
    .ru-card__meta {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 0.4rem;
    }
    .ru-card__filename {
      font-size: 0.8rem;
      font-weight: 500;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 260px;
    }
    .ru-card__dot { opacity: 0.3; font-size: 0.7rem; }
    .ru-card__author { font-size: 0.75rem; opacity: 0.6; }
    .ru-card__time   { font-size: 0.7rem;  opacity: 0.4; }
    .ru-card__tags {
      display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 0.6rem;
    }
    .ru-tag {
      font-size: 0.6rem; padding: 0.1rem 0.4rem;
      border: 1px solid var(--border, #333); border-radius: 2px; opacity: 0.5;
    }

    /* ── Reactions ── */
    .ru-reactions {
      display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;
      margin-bottom: 0.6rem;
    }
    .ru-react-btn {
      display: inline-flex; align-items: center; gap: 0.2rem;
      font-size: 0.8rem; padding: 0.15rem 0.45rem;
      border: 1px solid var(--border, #333); border-radius: 3px;
      background: transparent; color: inherit; cursor: pointer;
      transition: border-color 0.1s, background 0.1s;
    }
    .ru-react-btn:hover { border-color: var(--accent, #888); }
    .ru-react-btn--mine { border-color: var(--accent, #888); background: rgba(255,255,255,0.05); }
    .ru-react-btn--mine .ru-react-count { opacity: 1; }
    .ru-react-count { font-size: 0.7rem; opacity: 0.7; }
    .ru-react-add {
      font-size: 0.7rem; padding: 0.15rem 0.4rem;
      border: 1px dashed var(--border, #333); border-radius: 3px;
      background: transparent; color: inherit; cursor: pointer; opacity: 0.45;
      transition: opacity 0.1s;
      position: relative;
    }
    .ru-react-add:hover { opacity: 0.85; }
    .ru-emoji-picker {
      position: absolute; bottom: calc(100% + 4px); left: 0;
      background: var(--bg, #111); border: 1px solid var(--border, #333);
      border-radius: 4px; padding: 0.3rem; display: flex; gap: 0.2rem;
      z-index: 10;
    }
    .ru-emoji-opt {
      font-size: 1.1rem; cursor: pointer; padding: 0.1rem 0.2rem;
      border-radius: 3px; transition: background 0.1s;
    }
    .ru-emoji-opt:hover { background: rgba(255,255,255,0.1); }

    /* ── Comments ── */
    .ru-comments-toggle {
      font-size: 0.7rem; background: none; border: none; color: inherit;
      cursor: pointer; opacity: 0.5; padding: 0; transition: opacity 0.1s;
    }
    .ru-comments-toggle:hover { opacity: 0.9; }
    .ru-comments {
      border-top: 1px solid var(--border, #222);
      padding: 0.75rem 1rem;
      display: flex; flex-direction: column; gap: 0.6rem;
    }
    .ru-comment { display: flex; flex-direction: column; gap: 0.2rem; }
    .ru-comment__header {
      display: flex; align-items: baseline; gap: 0.4rem;
    }
    .ru-comment__author { font-size: 0.72rem; font-weight: 500; }
    .ru-comment__time   { font-size: 0.65rem; opacity: 0.4; }
    .ru-comment__text   { font-size: 0.78rem; opacity: 0.85; line-height: 1.45; }
    .ru-comment__actions { display: flex; gap: 0.6rem; }
    .ru-comment__action-btn {
      font-size: 0.65rem; opacity: 0.4; background: none; border: none;
      color: inherit; cursor: pointer; padding: 0; transition: opacity 0.1s;
    }
    .ru-comment__action-btn:hover { opacity: 0.85; }
    .ru-replies { padding-left: 1rem; border-left: 1px solid var(--border, #2a2a2a); margin-top: 0.4rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .ru-compose {
      display: flex; gap: 0.5rem; align-items: flex-end; margin-top: 0.25rem;
    }
    .ru-compose-input {
      flex: 1; font-size: 0.78rem; padding: 0.35rem 0.5rem;
      background: var(--bg2, #1a1a1a); border: 1px solid var(--border, #333);
      color: inherit; border-radius: 3px; resize: none; min-height: 34px;
      font-family: inherit;
    }
    .ru-compose-input:focus { outline: none; border-color: var(--accent, #666); }
    .ru-compose-send {
      font-size: 0.72rem; padding: 0.35rem 0.6rem;
      background: none; border: 1px solid var(--border, #444); border-radius: 3px;
      color: inherit; cursor: pointer; white-space: nowrap;
      transition: border-color 0.1s;
    }
    .ru-compose-send:hover { border-color: var(--accent, #888); }

    /* ── Loading / end states ── */
    .ru-loading, .ru-end {
      text-align: center; padding: 2rem; font-size: 0.75rem; opacity: 0.35;
    }
  </style>

  <script>
    // ─── State ────────────────────────────────────────────────────────────────
    let currentPage = 1;
    let isLoading = false;
    let exhausted = false;
    const PER_PAGE = 20;
    const ALLOWED_EMOJI = ['🔥', '👀', '✨', '💀', '🎲', '❤️'];

    const feed = document.getElementById('ru-feed')!;
    const loadingEl = document.getElementById('ru-loading')!;
    const sentinel = document.getElementById('ru-sentinel')!;

    // ─── Time formatting ──────────────────────────────────────────────────────
    function timeAgo(iso: string): string {
      const diff = Date.now() - new Date(iso).getTime();
      const s = Math.floor(diff / 1000);
      if (s < 60) return `${s}s ago`;
      const m = Math.floor(s / 60);
      if (m < 60) return `${m}m ago`;
      const h = Math.floor(m / 60);
      if (h < 24) return `${h}h ago`;
      const d = Math.floor(h / 24);
      if (d < 30) return `${d}d ago`;
      return new Date(iso).toLocaleDateString();
    }

    // ─── Creator name from item ───────────────────────────────────────────────
    function getCreatorName(item: any): string {
      for (const src of item.sources ?? []) {
        if (src.uploader_name) return src.uploader_name;
        if (src.source_metadata) {
          try {
            const m = JSON.parse(src.source_metadata);
            if (m.poster) return m.poster;
          } catch {}
        }
      }
      return 'unknown';
    }

    // ─── Build a card ─────────────────────────────────────────────────────────
    function buildCard(item: any): HTMLElement {
      const card = document.createElement('div');
      card.className = 'ru-card';
      card.dataset.id = item.id;

      // Media preview
      const mediaWrap = document.createElement('div');
      mediaWrap.className = 'ru-card__media';
      if (item.media_type === 'image') {
        const img = document.createElement('img');
        img.src = `/api/media/${item.id}/thumbnail`;
        img.alt = item.filename ?? '';
        img.loading = 'lazy';
        mediaWrap.appendChild(img);
      } else {
        const icon = document.createElement('div');
        icon.className = 'ru-card__audio-placeholder';
        icon.textContent = item.media_type === 'audio' ? '♫' : '▶';
        mediaWrap.appendChild(icon);
      }
      card.appendChild(mediaWrap);

      // Body
      const body = document.createElement('div');
      body.className = 'ru-card__body';

      // Meta row
      const meta = document.createElement('div');
      meta.className = 'ru-card__meta';
      const fname = document.createElement('span');
      fname.className = 'ru-card__filename';
      fname.textContent = item.filename ?? item.id;
      fname.title = item.filename ?? '';
      meta.appendChild(fname);

      const creator = getCreatorName(item);
      const createdAt = item.sources?.[0]?.created_at ?? item.created_at;
      if (creator !== 'unknown' || createdAt) {
        const dot1 = document.createElement('span'); dot1.className = 'ru-card__dot'; dot1.textContent = '·';
        meta.appendChild(dot1);
        if (creator !== 'unknown') {
          const auth = document.createElement('span');
          auth.className = 'ru-card__author';
          auth.textContent = creator;
          meta.appendChild(auth);
        }
        if (createdAt) {
          const dot2 = document.createElement('span'); dot2.className = 'ru-card__dot'; dot2.textContent = '·';
          const time = document.createElement('span');
          time.className = 'ru-card__time';
          time.textContent = timeAgo(createdAt);
          meta.appendChild(dot2);
          meta.appendChild(time);
        }
      }
      body.appendChild(meta);

      // Tags
      const tags: string[] = item.tags ?? [];
      if (tags.length > 0) {
        const tagRow = document.createElement('div');
        tagRow.className = 'ru-card__tags';
        for (const t of tags.slice(0, 6)) {
          const tag = document.createElement('span');
          tag.className = 'ru-tag';
          tag.textContent = t;
          tagRow.appendChild(tag);
        }
        body.appendChild(tagRow);
      }

      // Reactions
      const reactRow = buildReactRow(item.id);
      body.appendChild(reactRow);

      // Comments toggle
      const commentsToggle = document.createElement('button');
      commentsToggle.className = 'ru-comments-toggle';
      commentsToggle.dataset.open = 'false';
      commentsToggle.textContent = 'comments ▸';
      commentsToggle.addEventListener('click', () => toggleComments(item.id, card, commentsToggle));
      body.appendChild(commentsToggle);

      card.appendChild(body);
      return card;
    }

    // ─── Reactions ────────────────────────────────────────────────────────────
    function buildReactRow(mediaId: string): HTMLElement {
      const row = document.createElement('div');
      row.className = 'ru-reactions';
      row.dataset.mediaId = mediaId;
      // Load reactions lazily via IntersectionObserver after card is in DOM
      loadReactions(mediaId, row);
      return row;
    }

    async function loadReactions(mediaId: string, row: HTMLElement) {
      try {
        const res = await fetch(`/api/media/${mediaId}/reactions`, { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json();
        renderReactions(mediaId, row, data);
      } catch {}
    }

    function renderReactions(mediaId: string, row: HTMLElement, data: { counts: Record<string, number>; mine: string[]; allowed: string[] }) {
      row.innerHTML = '';
      for (const [emoji, count] of Object.entries(data.counts)) {
        const btn = document.createElement('button');
        btn.className = 'ru-react-btn' + (data.mine.includes(emoji) ? ' ru-react-btn--mine' : '');
        btn.innerHTML = `${emoji} <span class="ru-react-count">${count}</span>`;
        btn.addEventListener('click', async () => {
          await toggleReaction(mediaId, emoji, row);
        });
        row.appendChild(btn);
      }
      // Add reaction button
      const addBtn = document.createElement('button');
      addBtn.className = 'ru-react-add';
      addBtn.textContent = '+ react';
      const picker = document.createElement('div');
      picker.className = 'ru-emoji-picker';
      picker.style.display = 'none';
      for (const e of ALLOWED_EMOJI) {
        const opt = document.createElement('span');
        opt.className = 'ru-emoji-opt';
        opt.textContent = e;
        opt.addEventListener('click', async (ev) => {
          ev.stopPropagation();
          picker.style.display = 'none';
          await toggleReaction(mediaId, e, row);
        });
        picker.appendChild(opt);
      }
      addBtn.appendChild(picker);
      addBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        picker.style.display = picker.style.display === 'none' ? 'flex' : 'none';
      });
      row.appendChild(addBtn);
    }

    async function toggleReaction(mediaId: string, emoji: string, row: HTMLElement) {
      try {
        await fetch(`/api/media/${mediaId}/reactions`, {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ emoji }),
        });
        await loadReactions(mediaId, row);
      } catch {}
    }

    document.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.ru-emoji-picker').forEach(p => p.style.display = 'none');
    });

    // ─── Comments ─────────────────────────────────────────────────────────────
    async function toggleComments(mediaId: string, card: HTMLElement, toggleBtn: HTMLButtonElement) {
      const existing = card.querySelector('.ru-comments') as HTMLElement | null;
      if (existing) {
        existing.remove();
        toggleBtn.dataset.open = 'false';
        toggleBtn.textContent = 'comments ▸';
        return;
      }
      toggleBtn.dataset.open = 'true';
      toggleBtn.textContent = 'loading…';
      try {
        const res = await fetch(`/api/media/${mediaId}/comments`, { credentials: 'include' });
        const comments = res.ok ? await res.json() : [];
        const section = buildCommentsSection(mediaId, comments);
        card.appendChild(section);
        toggleBtn.textContent = `comments (${comments.length}) ▾`;
      } catch {
        toggleBtn.textContent = 'comments ▸';
      }
    }

    function buildCommentsSection(mediaId: string, comments: any[]): HTMLElement {
      const section = document.createElement('div');
      section.className = 'ru-comments';

      for (const c of comments) {
        section.appendChild(buildCommentEl(mediaId, c, section));
      }

      // Top-level compose
      section.appendChild(buildCompose(mediaId, null, section));
      return section;
    }

    function buildCommentEl(mediaId: string, c: any, section: HTMLElement): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'ru-comment';
      wrap.dataset.commentId = String(c.id);

      const header = document.createElement('div');
      header.className = 'ru-comment__header';
      const author = document.createElement('span');
      author.className = 'ru-comment__author';
      author.textContent = c.author_name ?? 'unknown';
      const time = document.createElement('span');
      time.className = 'ru-comment__time';
      time.textContent = timeAgo(c.created_at);
      header.appendChild(author);
      header.appendChild(time);
      wrap.appendChild(header);

      const text = document.createElement('div');
      text.className = 'ru-comment__text';
      text.textContent = c.text;
      wrap.appendChild(text);

      // Actions (reply + delete if mine)
      const actions = document.createElement('div');
      actions.className = 'ru-comment__actions';
      const replyBtn = document.createElement('button');
      replyBtn.className = 'ru-comment__action-btn';
      replyBtn.textContent = 'reply';
      let replyCompose: HTMLElement | null = null;
      replyBtn.addEventListener('click', () => {
        if (replyCompose) { replyCompose.remove(); replyCompose = null; return; }
        replyCompose = buildCompose(mediaId, c.id, section);
        repliesWrap.appendChild(replyCompose);
      });
      actions.appendChild(replyBtn);
      if (c.is_mine) {
        const delBtn = document.createElement('button');
        delBtn.className = 'ru-comment__action-btn';
        delBtn.textContent = 'delete';
        delBtn.addEventListener('click', async () => {
          await fetch(`/api/media/${mediaId}/comments/${c.id}`, { method: 'DELETE', credentials: 'include' });
          wrap.remove();
        });
        actions.appendChild(delBtn);
      }
      wrap.appendChild(actions);

      // Replies
      const repliesWrap = document.createElement('div');
      repliesWrap.className = 'ru-replies';
      for (const r of c.replies ?? []) {
        repliesWrap.appendChild(buildCommentEl(mediaId, r, section));
      }
      if (repliesWrap.children.length > 0) wrap.appendChild(repliesWrap);
      else wrap.appendChild(repliesWrap); // always append so reply compose has a home

      return wrap;
    }

    function buildCompose(mediaId: string, parentId: number | null, section: HTMLElement): HTMLElement {
      const row = document.createElement('div');
      row.className = 'ru-compose';
      const input = document.createElement('textarea');
      input.className = 'ru-compose-input';
      input.placeholder = parentId ? 'Write a reply…' : 'Add a comment…';
      input.rows = 1;
      input.addEventListener('input', () => {
        input.style.height = 'auto';
        input.style.height = input.scrollHeight + 'px';
      });
      const sendBtn = document.createElement('button');
      sendBtn.className = 'ru-compose-send';
      sendBtn.textContent = 'Send';
      sendBtn.addEventListener('click', async () => {
        const text = input.value.trim();
        if (!text) return;
        sendBtn.disabled = true;
        try {
          const res = await fetch(`/api/media/${mediaId}/comments`, {
            method: 'POST', credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text, parent_id: parentId }),
          });
          if (!res.ok) throw new Error();
          const newComment = await res.json();
          const newEl = buildCommentEl(mediaId, newComment, section);
          if (parentId) {
            // insert before the compose row in the replies wrap
            row.before(newEl);
          } else {
            section.insertBefore(newEl, row);
          }
          input.value = ''; input.style.height = '';
          // Update toggle button count
          const card = section.closest('.ru-card')!;
          const toggle = card.querySelector<HTMLButtonElement>('.ru-comments-toggle')!;
          const existing = card.querySelectorAll('.ru-comment').length;
          toggle.textContent = `comments (${existing}) ▾`;
        } catch {
          (window as any).toast?.error('Failed to post comment');
        } finally { sendBtn.disabled = false; }
      });
      row.appendChild(input);
      row.appendChild(sendBtn);
      return row;
    }

    // ─── Feed loading ─────────────────────────────────────────────────────────
    async function loadPage() {
      if (isLoading || exhausted) return;
      isLoading = true;
      loadingEl.style.display = 'block';
      try {
        const res = await fetch('/api/search', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            query: '',
            media_types: null,
            sort: 'created_at:desc',
            page: currentPage,
            per_page: PER_PAGE,
            filters: { output_index: '__outputs__' },
          }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const items: any[] = data.results ?? data.hits ?? [];

        if (currentPage === 1) loadingEl.remove();

        for (const item of items) {
          feed.appendChild(buildCard(item));
        }

        if (items.length < PER_PAGE) {
          exhausted = true;
          loadingEl.style.display = 'none';
          const end = document.createElement('div');
          end.className = 'ru-end';
          end.textContent = '— end of feed —';
          feed.appendChild(end);
        } else {
          currentPage++;
          loadingEl.style.display = 'none';
        }
      } catch (err) {
        loadingEl.textContent = 'Failed to load feed';
      } finally {
        isLoading = false;
      }
    }

    // ─── Infinite scroll ──────────────────────────────────────────────────────
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) loadPage();
    }, { rootMargin: '300px' });
    observer.observe(sentinel);

    // Initial load
    loadPage();
  </script>
</Admin>
