---
import Admin from '../../layouts/Admin.astro';
import BrutalCard from '../../components/BrutalCard.astro';
import BrutalSelect from '../../components/BrutalSelect.astro';
import SearchFilterBar from '../../components/SearchFilterBar.svelte';
---

<Admin title="Hecatomb" current="hecatomb">
  <div class="page-header">
    <h1>Hecatomb</h1>
    <p class="hecatomb-subtitle">
      Sacrifice of random inputs, to the queue, in quantity.
    </p>
  </div>

  <div class="hecatomb-form">
    <!-- Recipe card: which app, which recipe, how many. -->
    <BrutalCard title="Recipe" class="config-card">
      <div class="config-row-label" for="hec-app">App</div>
      <BrutalSelect
        id="hec-app"
        ariaLabel="App"
        wrapClass="config-card__select-wrap"
      >
        <option value="">Select an app…</option>
      </BrutalSelect>

      <div id="hec-recipe-label" class="config-row-label" style="display:none;">
        Recipe
      </div>
      <div id="hec-recipe-row" class="hec-recipe-row" style="display:none;">
        <BrutalSelect
          id="hec-recipe"
          ariaLabel="Recipe"
          wrapClass="config-card__select-wrap"
        />
        <label class="hec-inline-check">
          <input type="checkbox" id="hec-random-recipe" />
          <span>Random recipe per job</span>
        </label>
      </div>

      <div class="config-row-label" for="hec-count">Count</div>
      <div class="hec-count-cell">
        <input
          type="number"
          id="hec-count"
          class="brutal-input"
          min="1"
          max="100"
          value="10"
        />
        <span class="hec-hint">1&ndash;100 jobs per offering.</span>
      </div>
    </BrutalCard>

    <!-- Filters card: candidate pool. Always visible (no <details>). -->
    <BrutalCard title="Filters" class="config-card">
      <Fragment slot="meta">
        <span id="hec-candidates" class="hec-candidates">
          Estimating candidates…
        </span>
      </Fragment>

      <div class="config-row-label" for="sf-query">Search</div>
      <input
        type="text"
        id="sf-query"
        class="brutal-input"
        placeholder="Text search…"
      />

      <!-- Single source of truth: the same SearchFilterBar that powers
           /admin/search. Any group it grows automatically appears here.
           The Filters → BatchShuffleSpec translator in the script below
           consumes the fields the batch endpoint understands and silently
           drops the rest (e.g. AI / votes / dates aren't pool-side filters
           today). -->
      <div id="hec-filter-host" class="hec-filter-host">
        <SearchFilterBar client:load syncUrl={false} />
      </div>

      <div class="config-row-full hec-exclude-row">
        <label class="hec-inline-check">
          <input type="checkbox" id="hec-exclude-app" />
          <span>Exclude items already processed by this app</span>
        </label>
        <label class="hec-inline-check">
          <input
            type="checkbox"
            id="hec-exclude-recipe"
            disabled
            aria-disabled="true"
          />
          <span>Exclude items already processed with this recipe</span>
          <span
            class="hec-exclude-hint"
            id="hec-exclude-recipe-hint"
            aria-live="polite"
            >— applies once a specific recipe is selected</span
          >
        </label>
      </div>
    </BrutalCard>

    <div class="hec-actions">
      <button class="brutalist-control hec-submit" id="hec-submit" disabled
        >Submit offering</button
      >
    </div>

    <div class="hec-status" id="hec-status"></div>
  </div>
</Admin>

<style>
  .hecatomb-subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-top: 0;
  }
  .hecatomb-form {
    margin-top: var(--space-lg);
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .config-card__select-wrap {
    display: flex;
    width: 100%;
  }
  .config-card__select-wrap select {
    flex: 1;
  }
  .hec-recipe-row {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    align-items: center;
  }
  .hec-count-cell {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .hec-count-cell .brutal-input {
    width: 100px;
  }
  .hec-hint {
    color: var(--color-muted);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .hec-input--narrow {
    width: 100px;
  }
  /* SearchFilterBar island host — give the embedded bar room to breathe
     inside the Filters BrutalCard. The bar styles itself internally. */
  .hec-filter-host {
    margin-top: var(--space-xs);
  }
  .hec-exclude-hint {
    color: var(--color-muted);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  /* Toggle the hint visibility off when the recipe-exclude checkbox isn't
     disabled — JS flips a data- attribute. */
  .hec-exclude-row:not([data-recipe-locked='1']) .hec-exclude-hint {
    display: none;
  }
  .hec-exclude-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-top: var(--space-xs);
    border-top: 1px dotted var(--color-border);
    margin-top: var(--space-xs);
  }
  .hec-inline-check {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .hec-inline-check input[type='checkbox'] {
    width: 14px;
    height: 14px;
    accent-color: var(--color-fg);
  }
  /* Live candidate count: sits in the Filters card head's `meta` slot, so
     the user sees the impact of every filter change as they edit. */
  .hec-candidates {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .hec-candidates.has-many {
    color: var(--color-status-ok);
  }
  .hec-candidates.has-none {
    color: var(--color-status-fail);
  }
  .hec-actions {
    margin-top: var(--space-sm);
    display: flex;
    justify-content: flex-end;
  }
  .hec-submit {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .hec-submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    /* Lock the brutal chrome in place when disabled — no hover/active travel. */
    transform: none;
    box-shadow: 2px 2px 0 var(--color-fg);
  }
  .hec-submit:disabled:hover {
    transform: none;
    box-shadow: 2px 2px 0 var(--color-fg);
  }
  @media (max-width: 640px) {
    .hec-actions {
      justify-content: stretch;
    }
    .hec-submit {
      flex: 1;
      padding: var(--space-sm);
      font-size: var(--text-base);
    }
  }
  .hec-status {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    min-height: 1.2em;
  }
  .hec-status.hec-err {
    color: var(--color-status-fail);
  }
</style>

<script>
  document.addEventListener('astro:page-load', async () => {
    await (window as any).__authReady;

    const appSelect = document.getElementById('hec-app') as HTMLSelectElement;
    const recipeRow = document.getElementById('hec-recipe-row')!;
    const recipeLabel = document.getElementById('hec-recipe-label')!;
    const recipeSelect = document.getElementById(
      'hec-recipe',
    ) as HTMLSelectElement;
    const randomRecipeCb = document.getElementById(
      'hec-random-recipe',
    ) as HTMLInputElement;
    const countInput = document.getElementById('hec-count') as HTMLInputElement;
    const submitBtn = document.getElementById(
      'hec-submit',
    ) as HTMLButtonElement;
    const statusEl = document.getElementById('hec-status')!;
    const candidatesEl = document.getElementById('hec-candidates')!;
    const excludeRecipeCb = document.getElementById(
      'hec-exclude-recipe',
    ) as HTMLInputElement;
    const excludeRow = document.querySelector(
      '.hec-exclude-row',
    ) as HTMLElement | null;

    let apps: any[] = [];

    // Collect flat list of recipe options (values only) across option_groups + options
    function collectRecipeOptions(
      manifest: any,
    ): Array<{ value: string; label: string; group?: string }> {
      const recipeSpec = manifest?.params?.recipe;
      if (!recipeSpec) return [];
      const flat: Array<{ value: string; label: string; group?: string }> = [];
      for (const opt of recipeSpec.options || []) {
        if (opt && typeof opt === 'object' && opt.value) {
          flat.push({ value: opt.value, label: opt.label || opt.value });
        }
      }
      for (const group of recipeSpec.option_groups || []) {
        for (const opt of group.options || []) {
          if (opt && typeof opt === 'object' && opt.value) {
            flat.push({
              value: opt.value,
              label: opt.label || opt.value,
              group: group.label || group.name,
            });
          }
        }
      }
      return flat;
    }

    function renderRecipes(manifest: any) {
      recipeSelect.innerHTML = '';
      const opts = collectRecipeOptions(manifest);
      if (opts.length === 0) {
        recipeRow.style.display = 'none';
        recipeLabel.style.display = 'none';
        return;
      }
      recipeRow.style.display = '';
      recipeLabel.style.display = '';

      // Group options if we have group labels
      const groups = new Map<string, typeof opts>();
      for (const o of opts) {
        const g = o.group || '';
        if (!groups.has(g)) groups.set(g, []);
        groups.get(g)!.push(o);
      }
      for (const [groupLabel, items] of groups) {
        if (groupLabel) {
          const og = document.createElement('optgroup');
          og.label = groupLabel;
          for (const it of items) {
            const o = document.createElement('option');
            o.value = it.value;
            o.textContent = it.label;
            og.appendChild(o);
          }
          recipeSelect.appendChild(og);
        } else {
          for (const it of items) {
            const o = document.createElement('option');
            o.value = it.value;
            o.textContent = it.label;
            recipeSelect.appendChild(o);
          }
        }
      }
    }

    // Load apps
    try {
      const res = await fetch('/api/apps', { credentials: 'include' });
      if (res.ok) {
        apps = await res.json();
        for (const app of apps) {
          const opt = document.createElement('option');
          opt.value = app.name;
          opt.textContent = app.display_name || app.name;
          appSelect.appendChild(opt);
        }
      }
    } catch {}

    function selectedApp(): any | null {
      return apps.find((a) => a.name === appSelect.value) || null;
    }

    function updateSubmitLabel() {
      const n = parseInt(countInput.value) || 0;
      if (n <= 0) {
        submitBtn.textContent = 'Submit offering';
      } else if (n === 1) {
        submitBtn.textContent = 'Submit 1 offering';
      } else {
        submitBtn.textContent = `Submit ${n} offerings`;
      }
    }

    function updateSubmitEnabled() {
      const app = selectedApp();
      const n = parseInt(countInput.value);
      const valid =
        !!app &&
        Number.isFinite(n) &&
        n >= 1 &&
        n <= 100 &&
        (randomRecipeCb.checked ||
          recipeRow.style.display === 'none' ||
          !!recipeSelect.value);
      submitBtn.disabled = !valid;
    }

    // The recipe-exclude checkbox can only meaningfully apply when a specific
    // recipe is selected — the backend silently ignores it under random-recipe
    // or when no recipe is picked, which made the toggle feel dead. Lock it
    // and show a hint when it can't apply; clear the checked state too so
    // the count preview matches what submit will actually do.
    function updateExcludeRecipeState() {
      const recipeAvailable = recipeRow.style.display !== 'none';
      const recipeChosen = !!recipeSelect.value;
      const canApply =
        recipeAvailable && !randomRecipeCb.checked && recipeChosen;
      excludeRecipeCb.disabled = !canApply;
      excludeRecipeCb.setAttribute('aria-disabled', String(!canApply));
      if (!canApply && excludeRecipeCb.checked) {
        excludeRecipeCb.checked = false;
      }
      if (excludeRow) {
        excludeRow.dataset.recipeLocked = canApply ? '0' : '1';
      }
    }

    appSelect.addEventListener('change', () => {
      const app = selectedApp();
      if (app) {
        renderRecipes(app.manifest || {});
      } else {
        recipeRow.style.display = 'none';
        recipeLabel.style.display = 'none';
      }
      updateSubmitEnabled();
      updateExcludeRecipeState();
      schedulePreview();
    });

    randomRecipeCb.addEventListener('change', () => {
      recipeSelect.disabled = randomRecipeCb.checked;
      updateSubmitEnabled();
      updateExcludeRecipeState();
      schedulePreview();
    });

    recipeSelect.addEventListener('change', () => {
      updateSubmitEnabled();
      updateExcludeRecipeState();
      schedulePreview();
    });

    countInput.addEventListener('input', () => {
      updateSubmitLabel();
      updateSubmitEnabled();
    });

    // SearchFilterBar (Svelte island) is the single source of truth for the
    // structured filter state. It mirrors its consolidated state into
    // `data-filters` JSON on its inner wrapper and dispatches `filters-change`
    // CustomEvents that bubble up to #hec-filter-host. We read it on demand.
    function filterBarEl(): HTMLElement | null {
      return document.querySelector(
        '#hec-filter-host [data-filters]',
      ) as HTMLElement | null;
    }

    function readBarFilters(): any {
      const raw = filterBarEl()?.dataset.filters;
      if (!raw) return null;
      try {
        return JSON.parse(raw);
      } catch {
        return null;
      }
    }

    // Translate the bar's `Filters` shape into BatchShuffleSpec. The bar
    // grows new filter groups over time; this translator consumes the
    // fields the /api/jobs/batch endpoint understands today and silently
    // drops the rest. When the batch endpoint grows (e.g. learns AI
    // filters), extend this and `BatchShuffleSpec` together.
    //
    // Mapped today:  tagsText, channels, outputIndexes, reactionsMin, tagsMin
    // Ignored:       types (manifest's allowed_media_types wins), dates,
    //                colors, posters, sortBy, hasTranscript, hasText, votes,
    //                AI fields, jobApp (batch is per-app already).
    function buildShufflePayload() {
      const query = (
        document.getElementById('sf-query') as HTMLInputElement
      ).value.trim();
      const f = readBarFilters() || {};
      const tagsText: string = typeof f.tagsText === 'string' ? f.tagsText : '';
      const channels: string[] = Array.isArray(f.channels) ? f.channels : [];
      const outputIndexes: string[] = Array.isArray(f.outputIndexes)
        ? f.outputIndexes
        : [];
      const reactionsMin =
        typeof f.reactionsMin === 'number' && f.reactionsMin > 0
          ? f.reactionsMin
          : 0;
      const tagsMin =
        typeof f.tagsMin === 'number' && f.tagsMin > 0 ? f.tagsMin : 0;

      const payload: any = {
        query,
        source_channels: channels,
        tags: tagsText
          ? tagsText
              .split(',')
              .map((t: string) => t.trim())
              .filter(Boolean)
          : [],
        // BatchShuffleSpec.output_index is a single string. The bar can carry
        // multiple — for now we take the first (PullFromIndex makes the same
        // simplification). Extending the schema is a future call.
        output_index: outputIndexes[0] || null,
        reaction_count_min: reactionsMin > 0 ? reactionsMin : null,
        tag_count_min: tagsMin > 0 ? tagsMin : null,
        exclude_processed_by_app: (
          document.getElementById('hec-exclude-app') as HTMLInputElement
        ).checked,
        exclude_processed_by_recipe: excludeRecipeCb.checked,
      };
      return payload;
    }

    // Live candidate count via POST /api/jobs/batch/preview — runs the same
    // _build_batch_pool the submit endpoint uses, so the count honors the
    // app's allowed_media_types AND the exclude_processed_* toggles. Debounced
    // so typing in the search box doesn't spam.
    let previewTimer: number | null = null;
    let previewSeq = 0;
    function schedulePreview() {
      if (previewTimer !== null) window.clearTimeout(previewTimer);
      previewTimer = window.setTimeout(runPreview, 300);
    }
    async function runPreview() {
      const app = selectedApp();
      candidatesEl.classList.remove('has-many', 'has-none');
      if (!app) {
        candidatesEl.textContent = 'Pick an app to count candidates';
        return;
      }

      const randomRecipe = randomRecipeCb.checked;
      const params = buildJobParams(
        app.manifest,
        recipeSelect.value,
        randomRecipe,
      );
      const body = {
        app_name: app.name,
        shuffle: buildShufflePayload(),
        params,
        random_recipe: randomRecipe,
      };

      const mySeq = ++previewSeq;
      candidatesEl.textContent = 'Counting…';

      try {
        const res = await fetch('/api/jobs/batch/preview', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (mySeq !== previewSeq) return;
        if (!res.ok) {
          candidatesEl.textContent = 'Count unavailable';
          return;
        }
        const data = await res.json();
        const total = data.count ?? 0;
        if (total === 0) {
          candidatesEl.textContent = '0 candidates — relax filters';
          candidatesEl.classList.add('has-none');
        } else {
          candidatesEl.textContent = `${total} candidate${total === 1 ? '' : 's'}`;
          if (total >= 10) candidatesEl.classList.add('has-many');
        }
      } catch {
        if (mySeq !== previewSeq) return;
        candidatesEl.textContent = 'Count unavailable';
      }
    }

    // Wire local controls (query + the two exclude checkboxes) directly,
    // and the SearchFilterBar island via its bubbling `filters-change` event.
    const sfQueryEl = document.getElementById('sf-query');
    sfQueryEl?.addEventListener('input', schedulePreview);
    document
      .getElementById('hec-exclude-app')
      ?.addEventListener('change', schedulePreview);
    excludeRecipeCb.addEventListener('change', schedulePreview);
    document
      .getElementById('hec-filter-host')
      ?.addEventListener('filters-change', () => schedulePreview());
    // Initial preview after a beat (gives the bar a chance to render its
    // data-filters attribute on first mount).
    setTimeout(runPreview, 100);

    // Build params from the app manifest: start with every param's default
    // (so required-with-default params like processing_mode / model are
    // covered), then force processing_mode to "recipe" if the app offers it
    // (otherwise an app like rottengenizdat that defaults to "single_pass"
    // would silently ignore the recipe choice), and finally overlay the user's
    // recipe pick. Params with unmet depends_on are skipped server-side by
    // _validate_job_input, so extra defaults are harmless.
    function buildJobParams(
      manifest: any,
      userRecipe: string,
      randomRecipe: boolean,
    ): Record<string, any> {
      const out: Record<string, any> = {};
      const specs = manifest?.params || {};
      for (const [name, spec] of Object.entries(specs) as [string, any][]) {
        if (spec && typeof spec === 'object' && 'default' in spec) {
          out[name] = spec.default;
        }
      }
      const pm = specs.processing_mode;
      if (pm && Array.isArray(pm.options) && pm.options.includes('recipe')) {
        out.processing_mode = 'recipe';
      }
      if (randomRecipe) {
        delete out.recipe;
      } else if (userRecipe) {
        out.recipe = userRecipe;
      }
      return out;
    }

    submitBtn.addEventListener('click', async () => {
      const app = selectedApp();
      if (!app) return;
      const count = parseInt(countInput.value);
      if (!Number.isFinite(count) || count < 1 || count > 100) return;

      const randomRecipe = randomRecipeCb.checked;
      const params = buildJobParams(
        app.manifest,
        recipeSelect.value,
        randomRecipe,
      );

      statusEl.textContent = `Offering ${count} jobs…`;
      statusEl.className = 'hec-status';
      submitBtn.disabled = true;

      try {
        const res = await fetch('/api/jobs/batch', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            app_name: app.name,
            count,
            shuffle: buildShufflePayload(),
            params,
            random_recipe: randomRecipe,
          }),
        });

        if (res.ok) {
          const data = await res.json();
          (window as any).toast.success(
            `Submitted ${data.job_count} jobs. The queue accepts your offering.`,
          );
          window.location.href = `/admin/jobs?batch_id=${encodeURIComponent(data.batch_id)}`;
          return;
        }

        // Error path
        let msg = `Batch submission failed (HTTP ${res.status})`;
        try {
          const err = await res.json();
          const detail = err.detail;
          if (detail?.errors && Array.isArray(detail.errors)) {
            msg = detail.errors
              .map((e: any) => e.message || `${e.field}: unknown error`)
              .join(' | ');
          } else if (typeof detail === 'string') {
            msg = detail;
          } else if (detail?.detail) {
            msg = detail.detail;
          }
        } catch {}
        statusEl.textContent = msg;
        statusEl.className = 'hec-status hec-err';
        (window as any).toast.error(msg, 10000);
      } catch (e) {
        const msg = 'Failed to submit batch: ' + (e as Error).message;
        statusEl.textContent = msg;
        statusEl.className = 'hec-status hec-err';
      } finally {
        updateSubmitEnabled();
      }
    });

    updateSubmitLabel();
    updateSubmitEnabled();
    updateExcludeRecipeState();
  });
</script>
