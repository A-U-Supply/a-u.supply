---
import Admin from '../../layouts/Admin.astro';
import BrutalCard from '../../components/BrutalCard.astro';
import BrutalSelect from '../../components/BrutalSelect.astro';
import SearchFilterBar from '../../components/SearchFilterBar.svelte';
---

<Admin title="Hecatomb" current="hecatomb">
  <div class="page-header">
    <h1>Hecatomb</h1>
    <p class="hecatomb-subtitle">
      Sacrifice of random inputs, to the queue, in quantity.
    </p>
  </div>

  <div class="hecatomb-form">
    <BrutalCard title="Recipe" class="config-card">
      <div class="config-row-label" for="hec-app">App</div>
      <BrutalSelect
        id="hec-app"
        ariaLabel="App"
        wrapClass="config-card__select-wrap"
      >
        <option value="">Select an app…</option>
      </BrutalSelect>

      <div id="hec-recipe-label" class="config-row-label" style="display:none;">
        Recipe
      </div>
      <div id="hec-recipe-row" class="hec-recipe-row" style="display:none;">
        <BrutalSelect
          id="hec-recipe"
          ariaLabel="Recipe"
          wrapClass="config-card__select-wrap"
        />
        <label class="hec-inline-check">
          <input type="checkbox" id="hec-random-recipe" />
          <span>Random recipe per job</span>
        </label>
      </div>

      <div class="config-row-label" for="hec-count">Count</div>
      <div class="hec-count-cell">
        <input
          type="number"
          id="hec-count"
          class="brutal-input"
          min="1"
          max="100"
          value="10"
        />
        <span class="hec-hint">1&ndash;100 jobs per offering.</span>
      </div>
    </BrutalCard>

    <BrutalCard title="Filters" class="config-card">
      <Fragment slot="meta">
        <span id="hec-candidates" class="hec-candidates">
          Estimating candidates…
        </span>
      </Fragment>

      <div class="config-row-label" for="sf-query">Search</div>
      <input
        type="text"
        id="sf-query"
        class="brutal-input"
        placeholder="Text search…"
      />

      <div id="hec-filter-host" class="config-row-full hec-filter-host">
        <SearchFilterBar client:load syncUrl={false} hide={['sort']} />
      </div>

      <div class="config-row-full hec-exclude-row">
        <label class="hec-inline-check">
          <input type="checkbox" id="hec-exclude-app" />
          <span>Exclude items already processed by this app</span>
        </label>
        <label class="hec-inline-check">
          <input
            type="checkbox"
            id="hec-exclude-recipe"
            disabled
            aria-disabled="true"
          />
          <span>Exclude items already processed with this recipe</span>
          <span
            class="hec-exclude-hint"
            id="hec-exclude-recipe-hint"
            aria-live="polite"
            >&mdash; applies once a specific recipe is selected</span
          >
        </label>
      </div>
    </BrutalCard>

    <!-- Preview: shows up to 20 matching candidates so the user can
         see what the filters will select before submitting. -->
    <div id="hec-preview-wrapper" style="display:none;">
      <BrutalCard title="Preview" hideHead={true} flush id="hec-preview-card">
        <div class="hec-preview-grid" id="hec-preview-grid"></div>
      </BrutalCard>
    </div>

    <div class="hec-actions">
      <button class="brutalist-control hec-submit" id="hec-submit" disabled
        >Submit offering</button
      >
    </div>

    <div class="hec-status" id="hec-status"></div>
  </div>
</Admin>

<style>
  .hecatomb-subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-top: 0;
  }
  .hecatomb-form {
    margin-top: var(--space-lg);
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .config-card__select-wrap {
    display: flex;
    width: 100%;
  }
  .config-card__select-wrap select {
    flex: 1;
  }
  .hec-recipe-row {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    align-items: center;
  }
  .hec-count-cell {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .hec-count-cell .brutal-input {
    width: 100px;
  }
  .hec-hint {
    color: var(--color-muted);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .hec-input--narrow {
    width: 100px;
  }
  /* Constrain the embedded filter-bar so it doesn't overflow the card.
     The bar uses a 2-col grid; min-width:0 keeps grid cells from bursting. */
  .hec-filter-host {
    margin-top: var(--space-xs);
    min-width: 0;
  }
  .hec-exclude-hint {
    color: var(--color-muted);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .hec-exclude-row:not([data-recipe-locked='1']) .hec-exclude-hint {
    display: none;
  }
  .hec-exclude-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-top: var(--space-xs);
    border-top: 1px dotted var(--color-border);
    margin-top: var(--space-xs);
  }
  .hec-inline-check {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .hec-inline-check input[type='checkbox'] {
    width: 14px;
    height: 14px;
    accent-color: var(--color-fg);
  }
  .hec-candidates {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.5pt;
  }
  .hec-candidates.has-many {
    color: var(--color-status-ok);
  }
  .hec-candidates.has-none {
    color: var(--color-status-fail);
  }
  .hec-actions {
    margin-top: var(--space-sm);
    display: flex;
    justify-content: flex-end;
  }
  .hec-submit {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .hec-submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
    box-shadow: 2px 2px 0 var(--color-fg);
  }
  .hec-submit:disabled:hover {
    transform: none;
    box-shadow: 2px 2px 0 var(--color-fg);
  }
  @media (max-width: 640px) {
    .hec-actions {
      justify-content: stretch;
    }
    .hec-submit {
      flex: 1;
      padding: var(--space-sm);
      font-size: var(--text-base);
    }
  }
  .hec-status {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    min-height: 1.2em;
  }
  .hec-status.hec-err {
    color: var(--color-status-fail);
  }

  /* Preview grid — compact 4-col tile strip that mirrors the Stacks grid
     aesthetic. Tiles are square, monochrome, and link to the detail page. */
  .hec-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 6px;
  }
  .hec-preview-tile {
    border: 1px solid var(--color-border);
    overflow: hidden;
    position: relative;
    min-width: 0;
    background: var(--color-surface-2);
  }
  .hec-preview-tile a {
    display: block;
    aspect-ratio: 1;
  }
  .hec-preview-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hec-preview-tile__label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: color-mix(in srgb, var(--color-text) 75%, transparent);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    padding: 3px 5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    line-height: 1.3;
  }
  .hec-preview-empty {
    grid-column: 1 / -1;
    padding: var(--space-md);
    text-align: center;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>

<style is:global>
  /* hecatomb: keep filter-bar grid cells from bursting out of the card.
     Must be global because .brutal-card__body is rendered by BrutalCard.astro
     which has its own scoped styles. */
  #hec-filter-host .filter-bar {
    min-width: 0;
  }
</style>

<script>
  document.addEventListener('astro:page-load', async () => {
    await (window as any).__authReady;

    // ── Inlined from src/lib/filterTranslator.ts ──────────────────────────
    // (imports in inline <script type="module"> aren't bundled by Astro in
    // production, so the two translation helpers are reproduced here.)

    function filtersToBatchShuffle(
      filters: any,
      query: string,
      opts: {
        excludeProcessedByApp: boolean;
        excludeProcessedByRecipe: boolean;
      },
    ) {
      const payload: any = {
        query,
        source_channels: filters.channels,
        tags: filters.tagsText
          ? filters.tagsText
              .split(',')
              .map((t: string) => t.trim())
              .filter(Boolean)
          : [],
        output_index: filters.outputIndexes?.[0] || null,
        reaction_count_min:
          filters.reactionsMin > 0 ? filters.reactionsMin : null,
        tag_count_min: filters.tagsMin > 0 ? filters.tagsMin : null,
        exclude_processed_by_app: opts.excludeProcessedByApp,
        exclude_processed_by_recipe: opts.excludeProcessedByRecipe,
      };
      if (filters.dateFrom || filters.dateTo) {
        payload.date_range = {
          from: filters.dateFrom || undefined,
          to: filters.dateTo || undefined,
        };
      }
      if (filters.poster) payload.poster = filters.poster;
      if (filters.colorGroups?.length)
        payload.color_group = filters.colorGroups;
      if (filters.reactionsMax !== null && filters.reactionsMax !== undefined)
        payload.reaction_count_max = filters.reactionsMax;
      if (filters.tagsMax !== null && filters.tagsMax !== undefined)
        payload.tag_count_max = filters.tagsMax;
      if (filters.hasTranscript)
        payload.has_transcript = filters.hasTranscript === 'yes';
      if (filters.hasText) payload.has_text = filters.hasText === 'yes';
      return payload;
    }

    function filtersToSearchBody(
      filters: any,
      query: string,
      opts?: { perPage?: number },
    ) {
      const body: any = {
        query,
        media_types: filters.types,
        sort: null,
        filters: {} as any,
      };
      if (filters.includeEmulsion) body.include_emulsion = true;
      if (filters.channels?.length)
        body.filters.source_channels = filters.channels;
      if (filters.poster) body.filters.poster = filters.poster;
      if (filters.outputIndexes?.length)
        body.filters.output_index = filters.outputIndexes;
      if (filters.colorGroups?.length)
        body.filters.color_group = filters.colorGroups;
      if (filters.dateFrom || filters.dateTo) {
        body.filters.date_range = {
          from: filters.dateFrom || undefined,
          to: filters.dateTo || undefined,
        };
      }
      if (filters.tagsText) {
        body.filters.tags = filters.tagsText
          .split(',')
          .map((t: string) => t.trim())
          .filter(Boolean);
      }
      const rxnRange: any = {};
      if (filters.reactionsMin > 0) rxnRange.min = filters.reactionsMin;
      if (filters.reactionsMax !== null && filters.reactionsMax !== undefined)
        rxnRange.max = filters.reactionsMax;
      if (Object.keys(rxnRange).length) body.filters.reaction_count = rxnRange;
      const tagRange: any = {};
      if (filters.tagsMin > 0) tagRange.min = filters.tagsMin;
      if (filters.tagsMax !== null && filters.tagsMax !== undefined)
        tagRange.max = filters.tagsMax;
      if (Object.keys(tagRange).length) body.filters.tag_count = tagRange;
      if (filters.jobApp) body.filters.job_app = filters.jobApp;
      if (filters.hasTranscript)
        body.filters.has_transcript = filters.hasTranscript === 'yes';
      if (filters.hasText) body.filters.has_text = filters.hasText === 'yes';
      if (opts?.perPage) body.per_page = opts.perPage;
      return body;
    }

    // ── End inlined filter translator ─────────────────────────────────────

    const appSelect = document.getElementById('hec-app') as HTMLSelectElement;
    const recipeRow = document.getElementById('hec-recipe-row')!;
    const recipeLabel = document.getElementById('hec-recipe-label')!;
    const recipeSelect = document.getElementById(
      'hec-recipe',
    ) as HTMLSelectElement;
    const randomRecipeCb = document.getElementById(
      'hec-random-recipe',
    ) as HTMLInputElement;
    const countInput = document.getElementById('hec-count') as HTMLInputElement;
    const submitBtn = document.getElementById(
      'hec-submit',
    ) as HTMLButtonElement;
    const statusEl = document.getElementById('hec-status')!;
    const candidatesEl = document.getElementById('hec-candidates')!;
    const excludeRecipeCb = document.getElementById(
      'hec-exclude-recipe',
    ) as HTMLInputElement;
    const excludeRow = document.querySelector(
      '.hec-exclude-row',
    ) as HTMLElement | null;
    const previewWrapper = document.getElementById('hec-preview-wrapper')!;
    const previewGrid = document.getElementById('hec-preview-grid')!;

    let apps: any[] = [];

    function collectRecipeOptions(
      manifest: any,
    ): Array<{ value: string; label: string; group?: string }> {
      const recipeSpec = manifest?.params?.recipe;
      if (!recipeSpec) return [];
      const flat: Array<{ value: string; label: string; group?: string }> = [];
      for (const opt of recipeSpec.options || []) {
        if (opt && typeof opt === 'object' && opt.value) {
          flat.push({ value: opt.value, label: opt.label || opt.value });
        }
      }
      for (const group of recipeSpec.option_groups || []) {
        for (const opt of group.options || []) {
          if (opt && typeof opt === 'object' && opt.value) {
            flat.push({
              value: opt.value,
              label: opt.label || opt.value,
              group: group.label || group.name,
            });
          }
        }
      }
      return flat;
    }

    function renderRecipes(manifest: any) {
      recipeSelect.innerHTML = '';
      const opts = collectRecipeOptions(manifest);
      if (opts.length === 0) {
        recipeRow.style.display = 'none';
        recipeLabel.style.display = 'none';
        return;
      }
      recipeRow.style.display = '';
      recipeLabel.style.display = '';

      const groups = new Map<string, typeof opts>();
      for (const o of opts) {
        const g = o.group || '';
        if (!groups.has(g)) groups.set(g, []);
        groups.get(g)!.push(o);
      }
      for (const [groupLabel, items] of groups) {
        if (groupLabel) {
          const og = document.createElement('optgroup');
          og.label = groupLabel;
          for (const it of items) {
            const o = document.createElement('option');
            o.value = it.value;
            o.textContent = it.label;
            og.appendChild(o);
          }
          recipeSelect.appendChild(og);
        } else {
          for (const it of items) {
            const o = document.createElement('option');
            o.value = it.value;
            o.textContent = it.label;
            recipeSelect.appendChild(o);
          }
        }
      }
    }

    try {
      const res = await fetch('/api/apps', { credentials: 'include' });
      if (res.ok) {
        apps = await res.json();
        for (const app of apps) {
          const opt = document.createElement('option');
          opt.value = app.name;
          opt.textContent = app.display_name || app.name;
          appSelect.appendChild(opt);
        }
      }
    } catch {}

    function selectedApp(): any | null {
      return apps.find((a) => a.name === appSelect.value) || null;
    }

    function updateSubmitLabel() {
      const n = parseInt(countInput.value) || 0;
      if (n <= 0) {
        submitBtn.textContent = 'Submit offering';
      } else if (n === 1) {
        submitBtn.textContent = 'Submit 1 offering';
      } else {
        submitBtn.textContent = `Submit ${n} offerings`;
      }
    }

    function updateSubmitEnabled() {
      const app = selectedApp();
      const n = parseInt(countInput.value);
      const valid =
        !!app &&
        Number.isFinite(n) &&
        n >= 1 &&
        n <= 100 &&
        (randomRecipeCb.checked ||
          recipeRow.style.display === 'none' ||
          !!recipeSelect.value);
      submitBtn.disabled = !valid;
    }

    function updateExcludeRecipeState() {
      const recipeAvailable = recipeRow.style.display !== 'none';
      const recipeChosen = !!recipeSelect.value;
      const canApply =
        recipeAvailable && !randomRecipeCb.checked && recipeChosen;
      excludeRecipeCb.disabled = !canApply;
      excludeRecipeCb.setAttribute('aria-disabled', String(!canApply));
      if (!canApply && excludeRecipeCb.checked) {
        excludeRecipeCb.checked = false;
      }
      if (excludeRow) {
        excludeRow.dataset.recipeLocked = canApply ? '0' : '1';
      }
    }

    appSelect.addEventListener('change', () => {
      const app = selectedApp();
      if (app) {
        renderRecipes(app.manifest || {});
      } else {
        recipeRow.style.display = 'none';
        recipeLabel.style.display = 'none';
      }
      updateSubmitEnabled();
      updateExcludeRecipeState();
      schedulePreview();
    });

    randomRecipeCb.addEventListener('change', () => {
      recipeSelect.disabled = randomRecipeCb.checked;
      updateSubmitEnabled();
      updateExcludeRecipeState();
      schedulePreview();
    });

    recipeSelect.addEventListener('change', () => {
      updateSubmitEnabled();
      updateExcludeRecipeState();
      schedulePreview();
    });

    countInput.addEventListener('input', () => {
      updateSubmitLabel();
      updateSubmitEnabled();
    });

    function filterBarEl(): HTMLElement | null {
      return document.querySelector(
        '#hec-filter-host [data-filters]',
      ) as HTMLElement | null;
    }

    function readBarFilters(): any {
      const raw = filterBarEl()?.dataset.filters;
      if (!raw) return null;
      try {
        return JSON.parse(raw);
      } catch {
        return null;
      }
    }

    function buildShufflePayload() {
      const query = (
        document.getElementById('sf-query') as HTMLInputElement
      ).value.trim();
      const f = readBarFilters() || {};
      return filtersToBatchShuffle(f, query, {
        excludeProcessedByApp: (
          document.getElementById('hec-exclude-app') as HTMLInputElement
        ).checked,
        excludeProcessedByRecipe: excludeRecipeCb.checked,
      });
    }

    // ── Live candidate count ──────────────────────────────────────────────

    let previewTimer: number | null = null;
    let previewSeq = 0;
    function schedulePreview() {
      if (previewTimer !== null) window.clearTimeout(previewTimer);
      previewTimer = window.setTimeout(runPreview, 300);
    }
    async function runPreview() {
      const app = selectedApp();
      candidatesEl.classList.remove('has-many', 'has-none');
      if (!app) {
        candidatesEl.textContent = 'Pick an app to count candidates';
        return;
      }

      const randomRecipe = randomRecipeCb.checked;
      const params = buildJobParams(
        app.manifest,
        recipeSelect.value,
        randomRecipe,
      );
      const body = {
        app_name: app.name,
        shuffle: buildShufflePayload(),
        params,
        random_recipe: randomRecipe,
      };

      const mySeq = ++previewSeq;
      candidatesEl.textContent = 'Counting…';

      try {
        const res = await fetch('/api/jobs/batch/preview', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (mySeq !== previewSeq) return;
        if (!res.ok) {
          candidatesEl.textContent = 'Count unavailable';
          return;
        }
        const data = await res.json();
        const count = data.count ?? 0;
        const meiliTotal = data.total ?? count;
        if (count === 0) {
          candidatesEl.textContent = '0 candidates — relax filters';
          candidatesEl.classList.add('has-none');
        } else if (meiliTotal > count) {
          candidatesEl.textContent = `${count}+ / ${meiliTotal} candidate${meiliTotal === 1 ? '' : 's'}`;
          candidatesEl.classList.add('has-many');
        } else {
          candidatesEl.textContent = `${count} candidate${count === 1 ? '' : 's'}`;
          if (count >= 10) candidatesEl.classList.add('has-many');
        }
      } catch {
        if (mySeq !== previewSeq) return;
        candidatesEl.textContent = 'Count unavailable';
      }
    }

    // ── Search preview ────────────────────────────────────────────────────

    let searchPreviewTimer: number | null = null;
    let searchPreviewSeq = 0;
    function scheduleSearchPreview() {
      if (searchPreviewTimer !== null) window.clearTimeout(searchPreviewTimer);
      searchPreviewTimer = window.setTimeout(runSearchPreview, 350);
    }
    async function runSearchPreview() {
      const f = readBarFilters();
      if (!f) {
        previewWrapper.style.display = 'none';
        return;
      }
      const query = (
        document.getElementById('sf-query') as HTMLInputElement
      ).value.trim();
      const body = filtersToSearchBody(f, query, { perPage: 20 });

      const mySeq = ++searchPreviewSeq;
      try {
        const res = await fetch('/api/search', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (mySeq !== searchPreviewSeq) return;

        previewWrapper.style.display = '';

        if (!res.ok) {
          previewGrid.innerHTML =
            '<div class="hec-preview-empty">Search unavailable</div>';
          return;
        }
        const data = await res.json();
        const hits = data.results || data.hits || [];
        if (!hits.length) {
          previewGrid.innerHTML =
            '<div class="hec-preview-empty">No matching items</div>';
          return;
        }
        previewGrid.innerHTML = hits
          .map((item: any) => {
            const thumbSrc = `/api/media/${item.id}/thumbnail?size=sm`;
            const detailUrl = `/admin/search/detail?id=${encodeURIComponent(item.id)}`;
            return `<div class="hec-preview-tile">
            <a href="${detailUrl}" target="_blank" rel="noopener">
              <img src="${thumbSrc}" alt="${(item.filename || '').replace(/"/g, '')}" loading="lazy" />
            </a>
            <div class="hec-preview-tile__label">${item.media_type || '?'} &middot; ${item.tag_count ?? 0} tags</div>
          </div>`;
          })
          .join('');
      } catch {
        if (mySeq !== searchPreviewSeq) return;
        previewGrid.innerHTML =
          '<div class="hec-preview-empty">Preview unavailable</div>';
      }
    }

    // ── Wiring ───────────────────────────────────────────────────────────

    const sfQueryEl = document.getElementById('sf-query');
    sfQueryEl?.addEventListener('input', () => {
      schedulePreview();
      scheduleSearchPreview();
    });
    document
      .getElementById('hec-exclude-app')
      ?.addEventListener('change', schedulePreview);
    excludeRecipeCb.addEventListener('change', schedulePreview);
    document
      .getElementById('hec-filter-host')
      ?.addEventListener('filters-change', () => {
        schedulePreview();
        scheduleSearchPreview();
      });

    function waitForBar(maxTries: number = 30) {
      const f = readBarFilters();
      if (f) {
        schedulePreview();
        scheduleSearchPreview();
        return;
      }
      if (maxTries <= 0) return;
      setTimeout(() => waitForBar(maxTries - 1), 100);
    }
    setTimeout(() => waitForBar(), 50);

    // ── Submit ───────────────────────────────────────────────────────────

    function buildJobParams(
      manifest: any,
      userRecipe: string,
      randomRecipe: boolean,
    ): Record<string, any> {
      const out: Record<string, any> = {};
      const specs = manifest?.params || {};
      for (const [name, spec] of Object.entries(specs) as [string, any][]) {
        if (spec && typeof spec === 'object' && 'default' in spec) {
          out[name] = spec.default;
        }
      }
      const pm = specs.processing_mode;
      if (pm && Array.isArray(pm.options) && pm.options.includes('recipe')) {
        out.processing_mode = 'recipe';
      }
      if (randomRecipe) {
        delete out.recipe;
      } else if (userRecipe) {
        out.recipe = userRecipe;
      }
      return out;
    }

    submitBtn.addEventListener('click', async () => {
      const app = selectedApp();
      if (!app) return;
      const count = parseInt(countInput.value);
      if (!Number.isFinite(count) || count < 1 || count > 100) return;

      const randomRecipe = randomRecipeCb.checked;
      const params = buildJobParams(
        app.manifest,
        recipeSelect.value,
        randomRecipe,
      );

      statusEl.textContent = `Offering ${count} jobs…`;
      statusEl.className = 'hec-status';
      submitBtn.disabled = true;

      try {
        const res = await fetch('/api/jobs/batch', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            app_name: app.name,
            count,
            shuffle: buildShufflePayload(),
            params,
            random_recipe: randomRecipe,
          }),
        });

        if (res.ok) {
          const data = await res.json();
          (window as any).toast.success(
            `Submitted ${data.job_count} jobs. The queue accepts your offering.`,
          );
          window.location.href = `/admin/jobs?batch_id=${encodeURIComponent(data.batch_id)}`;
          return;
        }

        let msg = `Batch submission failed (HTTP ${res.status})`;
        try {
          const err = await res.json();
          const detail = err.detail;
          if (detail?.errors && Array.isArray(detail.errors)) {
            msg = detail.errors
              .map((e: any) => e.message || `${e.field}: unknown error`)
              .join(' | ');
          } else if (typeof detail === 'string') {
            msg = detail;
          } else if (detail?.detail) {
            msg = detail.detail;
          }
        } catch {}
        statusEl.textContent = msg;
        statusEl.className = 'hec-status hec-err';
        (window as any).toast.error(msg, 10000);
      } catch (e) {
        const msg = 'Failed to submit batch: ' + (e as Error).message;
        statusEl.textContent = msg;
        statusEl.className = 'hec-status hec-err';
      } finally {
        updateSubmitEnabled();
      }
    });

    updateSubmitLabel();
    updateSubmitEnabled();
    updateExcludeRecipeState();
  });
</script>
