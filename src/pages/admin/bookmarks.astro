---
import Admin from '../../layouts/Admin.astro';
---

<Admin title="Dog-ears" current="bookmarks">
  <div class="page-header">
    <h1>Dog-ears</h1>
    <div class="header-actions">
      <input
        type="search"
        class="filter-input"
        id="search-input"
        placeholder="Search name…"
        autocomplete="off"
      />
      <select class="filter-select" id="sort-select">
        <option value="newest">Newest</option>
        <option value="oldest">Oldest</option>
        <option value="name">A–Z</option>
      </select>
      <select class="filter-select" id="type-filter">
        <option value="">All Types</option>
        <option value="media_item">Media Items</option>
        <option value="release">Releases</option>
        <option value="track">Tracks</option>
      </select>
    </div>
  </div>

  <div id="batch-bar" class="batch-bar" style="display:none;">
    <span id="selected-count">0 selected</span>
    <button class="action-btn" data-batch="workspace">+ Workspace</button>
    <button class="action-btn action-btn--danger" data-batch="remove"
      >Remove</button
    >
    <button class="action-btn" id="clear-selection">Clear</button>
  </div>

  <div id="loading" class="page-loading">
    <span class="loading-dots">Loading</span>
  </div>
  <div id="empty" class="empty-state" style="display:none;">
    <div class="empty-state__icon">&#9734;</div>
    <span id="empty-text"
      >No dog-ears yet. Star items from Search, Workspace, or Releases.</span
    >
  </div>

  <div id="bookmarks-grid" class="bm-grid" style="display:none;"></div>

  <div class="pagination" id="pagination" style="display:none;">
    <button class="action-btn" id="prev-page">Prev</button>
    <span id="page-info">Page 1</span>
    <button class="action-btn" id="next-page">Next</button>
    <label class="page-jump">
      Page
      <input
        type="number"
        id="page-jump-input"
        min="1"
        step="1"
        inputmode="numeric"
      />
    </label>
    <span class="page-count" id="page-count"></span>
  </div>
</Admin>

<!-- Global styles for dynamically rendered grid items -->
<style is:global>
  .bm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  .bm-card {
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
    min-width: 0;
    transition: border-color 0.15s;
    cursor: pointer;
  }
  .bm-card:hover {
    border-color: var(--color-text);
  }
  .bm-card.selected {
    border-color: var(--color-accent);
    border-width: 2px;
  }
  .bm-card__check {
    position: absolute;
    top: 4px;
    left: 4px;
    z-index: 1;
  }
  .bm-card__thumb {
    width: 100%;
    aspect-ratio: 1;
    background: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }
  .bm-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bm-card__type-badge {
    position: absolute;
    top: 3px;
    right: 4px;
    font-size: 0.55rem;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    padding: 1px 4px;
    text-transform: uppercase;
    font-family: var(--font-mono);
  }
  .bm-card__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.35);
    opacity: 0;
    transition: opacity 0.15s;
    cursor: pointer;
    border: none;
    padding: 0;
  }
  .bm-card__thumb:hover .bm-card__play {
    opacity: 1;
  }
  .bm-card__play svg {
    width: 32px;
    height: 32px;
    fill: #fff;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.5));
  }
  .bm-card__add {
    position: absolute;
    bottom: 4px;
    right: 4px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: bold;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s;
    padding: 0;
    z-index: 1;
  }
  .bm-card__thumb:hover .bm-card__add {
    opacity: 1;
  }
  .bm-card__add:hover {
    background: rgba(184, 134, 11, 0.8);
    border-color: #b8860b;
  }
  .bm-card__ws {
    position: absolute;
    top: 4px;
    right: 4px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-size: 0.65rem;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s;
    padding: 0;
    z-index: 1;
  }
  .bm-card__thumb:hover .bm-card__ws {
    opacity: 1;
  }
  .bm-card__ws:hover {
    background: rgba(184, 134, 11, 0.8);
    border-color: #b8860b;
  }
  .bm-card__ws svg {
    width: 14px;
    height: 14px;
    fill: #fff;
  }
  .bm-card__info {
    padding: 4px 6px;
    border-top: 1px solid var(--color-border);
    min-width: 0;
    font-size: 0.65rem;
    font-family: var(--font-mono);
  }
  .bm-card__name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: flex;
    align-items: center;
    gap: 3px;
  }
  .bm-card__sub {
    color: var(--color-muted);
    font-size: 0.55rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Touch devices: always show bookmark card actions */
  @media (hover: none) {
    .bm-card__play,
    .bm-card__add,
    .bm-card__ws {
      opacity: 1;
    }
    .bm-card__play {
      background: rgba(0, 0, 0, 0.15);
    }
  }
  @media (max-width: 640px) {
    .bm-grid {
      grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
      gap: 4px;
    }
  }
</style>

<style>
  .batch-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .batch-bar span {
    color: var(--color-muted);
    margin-right: auto;
  }
  .page-jump {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-left: var(--space-sm);
  }
  .page-jump input {
    width: 4em;
    padding: 2px 4px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-align: right;
  }
  .page-count {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    margin-left: auto;
  }
</style>

<script>
  import { addItemsToWorkspace } from '../../lib/workspace';
  import { openImageViewer, type ViewerItem } from '../../lib/image-viewer';

  document.addEventListener('astro:page-load', async () => {
    const gridEl = document.getElementById('bookmarks-grid');
    if (!gridEl) return;

    await (window as any).__authReady;

    const loadingEl = document.getElementById('loading')!;
    const emptyEl = document.getElementById('empty')!;
    const emptyText = document.getElementById('empty-text')!;
    const paginationEl = document.getElementById('pagination')!;
    const pageInfo = document.getElementById('page-info')!;
    const pageCount = document.getElementById('page-count')!;
    const pageJumpInput = document.getElementById(
      'page-jump-input',
    ) as HTMLInputElement;
    const batchBar = document.getElementById('batch-bar')!;
    const selectedCount = document.getElementById('selected-count')!;
    const typeFilter = document.getElementById(
      'type-filter',
    ) as HTMLSelectElement;
    const sortSelect = document.getElementById(
      'sort-select',
    ) as HTMLSelectElement;
    const searchInput = document.getElementById(
      'search-input',
    ) as HTMLInputElement;

    let currentPage = 1;
    const pageSize = 48;
    let totalItems = 0;
    let allItems: any[] = [];
    let selectedIds = new Set<string>();
    let requestSeq = 0;

    const playSvg = `<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>`;
    const briefcaseSvg = `<svg viewBox="0 0 24 24"><path d="M20 7h-4V5c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V9c0-1.1-.9-2-2-2zM10 5h4v2h-4V5z"/></svg>`;

    async function loadBookmarks() {
      const mySeq = ++requestSeq;
      loadingEl.style.display = 'block';
      emptyEl.style.display = 'none';
      gridEl.style.display = 'none';
      paginationEl.style.display = 'none';

      const params = new URLSearchParams({
        page: String(currentPage),
        per_page: String(pageSize),
        sort: sortSelect.value || 'newest',
      });
      if (typeFilter.value) params.set('target_type', typeFilter.value);
      const q = searchInput.value.trim();
      if (q) params.set('q', q);

      let data: any;
      try {
        const res = await fetch(`/api/bookmarks?${params}`, {
          credentials: 'include',
        });
        // A newer request started — discard.
        if (mySeq !== requestSeq) return;
        if (!res.ok) {
          loadingEl.style.display = 'none';
          emptyText.textContent = 'Failed to load.';
          emptyEl.style.display = '';
          return;
        }
        data = await res.json();
      } catch {
        if (mySeq === requestSeq) {
          loadingEl.style.display = 'none';
          emptyText.textContent = 'Failed to load.';
          emptyEl.style.display = '';
        }
        return;
      }

      if (mySeq !== requestSeq) return;

      totalItems = data.total;
      loadingEl.style.display = 'none';

      // If the user landed past the last page (eg. deleted enough to drop a
      // page), snap back to 1 and re-fetch.
      const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));
      if (currentPage > totalPages) {
        currentPage = totalPages;
        loadBookmarks();
        return;
      }

      if (totalItems === 0) {
        allItems = [];
        emptyText.textContent = q
          ? 'No dog-ears match that search.'
          : 'No dog-ears yet. Star items from Search, Workspace, or Releases.';
        emptyEl.style.display = '';
        return;
      }

      allItems = data.items.map((b: any) => ({
        ...b,
        meta: b.meta
          ? { ...b.meta, thumb: b.meta.thumb || '/assets/default-cover.jpg' }
          : {
              name: b.target_id,
              sub: b.target_type,
              media_type: b.target_type,
              thumb: '/assets/default-cover.jpg',
              href: '#',
              playable: false,
            },
      }));
      renderGrid();

      // Always show the pagination bar when there are results, even on a
      // single page — the total count is useful info on its own.
      const start = (currentPage - 1) * pageSize + 1;
      const end = Math.min(currentPage * pageSize, totalItems);
      paginationEl.style.display = 'flex';
      pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
      pageCount.textContent = `(${start}–${end} of ${totalItems})`;
      pageJumpInput.max = String(totalPages);
      pageJumpInput.value = String(currentPage);
      pageJumpInput.style.display = totalPages > 1 ? '' : 'none';
      (document.getElementById('prev-page') as HTMLButtonElement).disabled =
        currentPage <= 1;
      (document.getElementById('next-page') as HTMLButtonElement).disabled =
        currentPage >= totalPages;
    }

    function renderCard(item: any, idx: number) {
      const m = item.meta;
      const checked = selectedIds.has(item.target_id) ? 'checked' : '';
      const selectedClass = selectedIds.has(item.target_id) ? ' selected' : '';
      const thumbStyle =
        m.thumb === '/assets/default-cover.jpg'
          ? ' style="image-rendering: pixelated;"'
          : '';
      // First two rows (~12 cards on desktop) load eagerly so above-the-fold
      // thumbnails don't wait for the next browser tick.
      const loadingAttr = idx < 12 ? 'eager' : 'lazy';
      // Audio gets play + queue buttons (routes to persistent Player).
      // Video gets play only (routes to the inline viewer).
      let playBtn = '';
      if (m.playable) {
        const play = `<button class="bm-card__play" data-play-id="${item.target_id}" data-play-type="${m.media_type}" data-target-type="${item.target_type}" title="Play">${playSvg}</button>`;
        const add =
          m.media_type === 'audio'
            ? `<button class="bm-card__add" data-play-id="${item.target_id}" data-play-type="${m.media_type}" data-target-type="${item.target_type}" title="Add to queue">+</button>`
            : '';
        playBtn = `${play}${add}`;
      }
      // Default to the small thumbnail; let srcset upgrade for wider columns
      // and high-DPI displays. Cuts bytes/card by ~10x vs. the full-size thumb.
      const primarySrc = m.thumb_sm || m.thumb;
      const srcset = m.thumb_sm
        ? `${m.thumb_sm} 128w, ${m.thumb} 400w`
        : '';
      return `<div class="bm-card${selectedClass}" data-target-type="${item.target_type}" data-target-id="${item.target_id}" data-href="${m.href}">
          <input type="checkbox" class="bm-card__check" data-select="${item.target_id}" ${checked} />
          <div class="bm-card__thumb">
            <span class="bm-card__type-badge">${item.target_type.replace('_', ' ')}</span>
            <img src="${primarySrc}" ${srcset ? `srcset="${srcset}" sizes="(max-width: 480px) 128px, 220px"` : ''} alt="" loading="${loadingAttr}" decoding="async"${thumbStyle} />
            ${playBtn}
            ${item.target_type === 'media_item' ? `<button class="bm-card__ws" data-ws-id="${item.target_id}" title="Add to workspace">${briefcaseSvg}</button>` : ''}
          </div>
          <div class="bm-card__info">
            <div class="bm-card__name">
              <button class="bm-star bm-star--sm bookmarked" data-bm-type="${item.target_type}" data-bm-id="${item.target_id}" title="Remove bookmark"></button>
              ${m.name}
            </div>
            ${m.sub ? `<div class="bm-card__sub">${m.sub}</div>` : ''}
          </div>
        </div>`;
    }

    function renderGrid() {
      gridEl.style.display = 'grid';
      gridEl.innerHTML = allItems.map((it, i) => renderCard(it, i)).join('');
    }

    function updateSelection() {
      if (selectedIds.size > 0) {
        batchBar.style.display = 'flex';
        selectedCount.textContent = selectedIds.size + ' selected';
      } else {
        batchBar.style.display = 'none';
      }
    }

    // Delegated click handling
    gridEl.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;

      // Star click — remove bookmark
      const star = target.closest('.bm-star') as HTMLElement | null;
      if (star) {
        e.stopPropagation();
        const bm = (window as any).__bookmarks;
        if (bm) {
          bm.toggle(star.dataset.bmType!, star.dataset.bmId!).then(
            (bookmarked: boolean) => {
              if (!bookmarked) {
                // Cheap optimistic update: drop from view + decrement total.
                // If the page becomes empty we re-fetch — loadBookmarks() will
                // pull the next page's items in if there are any.
                allItems = allItems.filter(
                  (i) =>
                    !(
                      i.target_type === star.dataset.bmType &&
                      i.target_id === star.dataset.bmId
                    ),
                );
                totalItems = Math.max(0, totalItems - 1);
                if (allItems.length === 0) {
                  if (currentPage > 1) currentPage--;
                  loadBookmarks();
                } else {
                  renderGrid();
                }
              }
            },
          );
        }
        return;
      }

      // Play button.
      // Video → open viewer for inline playback.
      // Audio → queue in the persistent Player.
      const playBtn = target.closest('.bm-card__play') as HTMLElement | null;
      if (playBtn) {
        e.stopPropagation();
        const id = playBtn.dataset.playId!;
        const mediaType = playBtn.dataset.playType!;
        const targetType = playBtn.dataset.targetType!;
        if (targetType === 'media_item' && mediaType === 'video') {
          openViewerForBookmarkedMedia(id);
          return;
        }
        const item = allItems.find(
          (i: any) => i.target_id === id && i.target_type === targetType,
        );
        if (!item) return;
        const m = item.meta;
        if (!m) return;
        document.dispatchEvent(
          new CustomEvent('player:queue', {
            detail: {
              tracks: [
                {
                  track_id: id,
                  title: m.name,
                  release_title: m.sub || '',
                  release_code: '',
                  media_type: mediaType,
                  stream_url: m.stream_url || `/api/media/${id}/file`,
                  cover_url: m.thumb,
                  duration: 0,
                  entity_name: '',
                },
              ],
              startIndex: 0,
            },
          }),
        );
        return;
      }

      // Add to queue button
      const addBtn = target.closest('.bm-card__add') as HTMLElement | null;
      if (addBtn) {
        e.stopPropagation();
        const id = addBtn.dataset.playId!;
        const mediaType = addBtn.dataset.playType!;
        const targetType = addBtn.dataset.targetType!;
        const item = allItems.find(
          (i: any) => i.target_id === id && i.target_type === targetType,
        );
        if (!item) return;
        const m = item.meta;
        document.dispatchEvent(
          new CustomEvent('player:add', {
            detail: {
              tracks: [
                {
                  track_id: id,
                  title: m.name,
                  release_title: m.sub || '',
                  release_code: '',
                  media_type: mediaType,
                  stream_url: m.stream_url || `/api/media/${id}/file`,
                  cover_url: m.thumb,
                  duration: 0,
                  entity_name: '',
                },
              ],
            },
          }),
        );
        return;
      }

      // Workspace button
      const wsBtn = target.closest('.bm-card__ws') as HTMLElement | null;
      if (wsBtn) {
        e.stopPropagation();
        const mediaId = wsBtn.dataset.wsId!;
        const data = await addItemsToWorkspace([mediaId]);
        if (data) {
          (window as any).toast.success(
            data.already_present > 0
              ? 'Already in workspace'
              : 'Added to workspace',
          );
        } else {
          (window as any).toast.error('Failed to add to workspace');
        }
        return;
      }

      // Checkbox
      const checkbox = target.closest(
        '.bm-card__check',
      ) as HTMLInputElement | null;
      if (checkbox) {
        e.stopPropagation();
        const id = checkbox.dataset.select!;
        if (checkbox.checked) selectedIds.add(id);
        else selectedIds.delete(id);
        updateSelection();
        return;
      }

      // Card click — images open viewer, others navigate to detail
      const card = target.closest('.bm-card') as HTMLElement | null;
      if (
        card &&
        !target.closest('.bm-card__check') &&
        !target.closest('.bm-card__ws') &&
        !target.closest('.bm-card__play') &&
        !target.closest('.bm-card__add') &&
        !target.closest('.bm-star')
      ) {
        const targetType = card.dataset.targetType;
        const targetId = card.dataset.targetId;
        const item = allItems.find(
          (i: any) => i.target_type === targetType && i.target_id === targetId,
        );
        const meta = item ? item.meta : null;
        if (
          meta &&
          targetType === 'media_item' &&
          (meta.media_type === 'image' || meta.media_type === 'video')
        ) {
          openViewerForBookmarkedMedia(targetId!);
          return;
        }
        const href = card.dataset.href;
        if (href && href !== '#') window.location.href = href;
      }
    });

    function openViewerForBookmarkedMedia(startId: string) {
      // Every bookmarked media_item whose meta says it's image or video.
      const viewableBookmarks = (allItems as any[]).filter((i) => {
        if (i.target_type !== 'media_item') return false;
        const m = i.meta;
        return m && (m.media_type === 'image' || m.media_type === 'video');
      });
      if (viewableBookmarks.length === 0) return;
      const startIndex = Math.max(
        0,
        viewableBookmarks.findIndex((i: any) => i.target_id === startId),
      );
      const items: ViewerItem[] = viewableBookmarks.map((i: any) => {
        const id = i.target_id;
        const m = i.meta;
        const kind = m?.media_type === 'video' ? 'video' : 'image';
        return {
          id,
          kind: 'media_item' as const,
          media_kind: kind as 'image' | 'video',
          large_url: `/api/media/${id}/thumbnail?size=lg`,
          thumbnail_url: `/api/media/${id}/thumbnail?size=sm`,
          download_url: `/api/media/${id}/file`,
          stream_url: `/api/media/${id}/file`,
          filename: m?.name,
          media_type: m?.media_type,
        };
      });
      openImageViewer(items, startIndex, {
        onBookmark: async (item) => {
          const bm = (window as any).__bookmarks;
          if (!bm) return true;
          const on = await bm.toggle('media_item', item.id);
          return !!on;
        },
        isBookmarked: async () => true,
        onAddToWorkspace: async (item) => {
          const data = await addItemsToWorkspace([item.id]);
          if (data)
            (window as any).toast?.success(
              data.already_present > 0
                ? 'Already in workspace'
                : 'Added to workspace',
            );
          else (window as any).toast?.error('Failed to add to workspace');
        },
        onDetails: (item) => {
          window.location.href = `/admin/search/detail?id=${item.id}`;
        },
      });
    }

    // Batch actions
    document.querySelectorAll('[data-batch]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = (btn as HTMLElement).dataset.batch;
        if (action === 'workspace') {
          // Only add media_items to workspace
          const mediaIds = allItems
            .filter(
              (i) =>
                selectedIds.has(i.target_id) && i.target_type === 'media_item',
            )
            .map((i) => i.target_id);
          if (mediaIds.length === 0) {
            (window as any).toast.error(
              'Only media items can be added to workspace',
            );
            return;
          }
          let wsId = localStorage.getItem('active_workspace_id');
          if (!wsId) {
            const res = await fetch('/api/workspaces', {
              method: 'POST',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ name: 'My Workspace' }),
            });
            const ws = await res.json();
            wsId = ws.id;
            localStorage.setItem('active_workspace_id', wsId!);
          }
          try {
            const res = await fetch(`/api/workspaces/${wsId}/items`, {
              method: 'POST',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ media_item_ids: mediaIds }),
            });
            const data = await res.json();
            if (data.ok)
              (window as any).toast.success(
                `Added ${data.added} item(s) to workspace`,
              );
          } catch {
            (window as any).toast.error('Failed to add to workspace');
          }
        } else if (action === 'remove') {
          const bm = (window as any).__bookmarks;
          if (!bm) return;
          for (const id of selectedIds) {
            const item = allItems.find((i: any) => i.target_id === id);
            if (item) await bm.toggle(item.target_type, item.target_id);
          }
          selectedIds.clear();
          updateSelection();
          loadBookmarks();
        }
      });
    });

    document
      .getElementById('clear-selection')
      ?.addEventListener('click', () => {
        selectedIds.clear();
        updateSelection();
        renderGrid();
      });

    typeFilter.addEventListener('change', () => {
      currentPage = 1;
      loadBookmarks();
    });
    sortSelect.addEventListener('change', () => {
      currentPage = 1;
      loadBookmarks();
    });

    let searchTimer: ReturnType<typeof setTimeout> | null = null;
    searchInput.addEventListener('input', () => {
      if (searchTimer) clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        currentPage = 1;
        loadBookmarks();
      }, 250);
    });

    document.getElementById('prev-page')?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        loadBookmarks();
      }
    });
    document.getElementById('next-page')?.addEventListener('click', () => {
      if (currentPage * pageSize < totalItems) {
        currentPage++;
        loadBookmarks();
      }
    });

    const goToJumpPage = () => {
      const target = parseInt(pageJumpInput.value, 10);
      if (!Number.isFinite(target) || target < 1) return;
      const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));
      const clamped = Math.min(Math.max(1, target), totalPages);
      if (clamped !== currentPage) {
        currentPage = clamped;
        loadBookmarks();
      } else {
        pageJumpInput.value = String(currentPage);
      }
    };
    pageJumpInput.addEventListener('change', goToJumpPage);
    pageJumpInput.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        e.preventDefault();
        goToJumpPage();
      }
    });

    loadBookmarks();
  });
</script>
