---
import Admin from '../../../layouts/Admin.astro';
---

<Admin title="Latents" current="latents">
  <div class="page-header">
    <h1>Latents</h1>
    <div class="header-actions">
      <a class="btn-primary" href="/admin/latents/new">+ New Latent</a>
    </div>
  </div>
  <p class="page-subtitle">
    Pre-release workspace. Each latent gathers files, slots, notes and
    discussion for an in-progress work.
  </p>

  <div class="filter-bar">
    <div class="filter-group">
      <span class="filter-group__label">Status</span>
      <div class="chip-row" id="status-chips">
        <button class="chip active" data-status="">all</button>
        <button class="chip" data-status="forming">forming</button>
        <button class="chip" data-status="developing">developing</button>
        <button class="chip" data-status="fixing">fixing</button>
        <button class="chip" data-status="abandoned">abandoned</button>
      </div>
    </div>
    <div class="filter-group">
      <span class="filter-group__label">Kind</span>
      <div class="chip-row" id="kind-chips">
        <button class="chip active" data-kind="">all</button>
        <button class="chip" data-kind="album">album</button>
        <button class="chip" data-kind="video">video</button>
        <button class="chip" data-kind="zine">zine</button>
        <button class="chip" data-kind="session">session</button>
        <button class="chip" data-kind="other">other</button>
      </div>
    </div>
  </div>

  <div id="latents-error" class="latent-error" role="status" aria-live="polite">
  </div>

  <div id="latents-list" class="latent-grid" aria-busy="true">
    <div class="latent-skeleton"></div>
    <div class="latent-skeleton"></div>
    <div class="latent-skeleton"></div>
  </div>
</Admin>

<style>
  .page-subtitle {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-xs);
    max-width: 60ch;
  }
  .filter-bar {
    display: flex;
    gap: var(--space-md);
    margin: var(--space-md) 0;
    flex-wrap: wrap;
    border-top: 1px dotted var(--color-border);
    border-bottom: 1px dotted var(--color-border);
    padding: var(--space-sm) 0;
  }
  .filter-group {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .filter-group__label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
    color: var(--color-muted);
  }
  .chip-row {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .chip {
    padding: 3px 10px;
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: lowercase;
    transition:
      background 80ms,
      color 80ms,
      border-color 80ms;
  }
  .chip:hover {
    border-color: var(--color-text);
  }
  .chip.active {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }
  .latent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-sm);
  }
  .latent-skeleton {
    border: 1px solid var(--color-border);
    height: 92px;
    background: linear-gradient(
      90deg,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-fg) 6%, transparent) 50%,
      var(--color-bg) 100%
    );
    background-size: 200% 100%;
    animation: shimmer 1.6s linear infinite;
  }
  @keyframes shimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }
  :global(.latent-grid .card) {
    position: relative;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    padding: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 80ms,
      transform 80ms,
      box-shadow 80ms;
  }
  :global(.latent-grid .card:hover) {
    border-color: var(--color-text);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 var(--color-text);
  }
  :global(.latent-grid .card__title) {
    font-weight: 700;
    font-size: var(--text-base);
    line-height: 1.25;
    word-break: break-word;
  }
  :global(.latent-grid .card__sub) {
    color: var(--color-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
  }
  :global(.latent-grid .card__meta) {
    display: flex;
    gap: var(--space-sm);
    color: var(--color-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
    flex-wrap: wrap;
    align-items: center;
    margin-top: auto;
  }
  :global(.latent-grid .status-pill) {
    padding: 1px 8px;
    border: 1px solid var(--c, var(--color-muted));
    color: var(--c, var(--color-muted));
    background: var(--color-bg);
  }
  /* Hero cards — everything below is scoped under .card--hero (or a
     treatment class that only appears with it) so the hero-less branch
     renders byte-identical to the plain card above. */
  :global(.latent-grid .card--hero) {
    min-height: 148px;
    isolation: isolate;
    border-color: color-mix(
      in srgb,
      var(--latent-accent, var(--color-border)) 55%,
      var(--color-border)
    );
  }
  :global(.latent-grid .card--hero:hover) {
    border-color: var(--latent-accent, var(--color-text));
    box-shadow: 2px 2px 0 var(--latent-accent, var(--color-text));
  }
  :global(.latent-grid .card__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  :global(.latent-grid .card__veil) {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  :global(.latent-grid .card__content) {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: auto;
  }
  /* scrim (default): bottom-up veil; overlay tokens stay dark in both themes */
  :global(.latent-grid .card--scrim .card__veil) {
    background: linear-gradient(to top, var(--color-overlay), transparent 70%);
  }
  /* treat: per-latent duotone — grayscale image under an accent color-blend.
     The brightness clamp guarantees a dark field for on-overlay text. */
  :global(.latent-grid .card--treat .card__bg) {
    filter: grayscale(1) brightness(0.45);
  }
  :global(.latent-grid .card--treat .card__veil) {
    background: var(--latent-accent, var(--color-overlay-soft));
    mix-blend-mode: color;
    opacity: 0.55;
  }
  :global(.latent-grid .card--scrim .card__title),
  :global(.latent-grid .card--treat .card__title) {
    color: var(--color-on-overlay);
  }
  :global(.latent-grid .card--scrim .card__sub),
  :global(.latent-grid .card--treat .card__sub),
  :global(.latent-grid .card--scrim .card__meta),
  :global(.latent-grid .card--treat .card__meta) {
    color: color-mix(in srgb, var(--color-on-overlay) 75%, transparent);
  }
  /* The status pill keeps its semantic color (must stay comparable across
     cards); over imagery it gains a soft backing so the 1px border reads. */
  :global(.latent-grid .card--scrim .status-pill),
  :global(.latent-grid .card--treat .status-pill) {
    background: var(--color-overlay-soft);
  }
  /* plate: theme-native strip pinned to the bottom — legible on any image.
     Negative margins counteract the card padding so the strip runs edge
     to edge. */
  :global(.latent-grid .card--plate .card__content) {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    margin: auto calc(-1 * var(--space-sm)) calc(-1 * var(--space-sm));
    padding: var(--space-sm);
  }
  /* --- Manual order: grip, stretched link, drop indicator ----------------
     The card is a <div> so the grip can be a real <button>; the whole card
     stays one click target through this link, which sits above the hero
     layers (bg 0, veil 1, content 2) but below the grip. It must be a DIRECT
     child of .card — .card__content is position:relative, so a link nested
     inside it would only cover the plate strip. */
  :global(.latent-grid .card__link) {
    position: absolute;
    inset: 0;
    z-index: 3;
  }
  /* The link's text is its accessible name; the visible title is a sibling.
     There is no sr-only utility in this repo, so the rule lives here. */
  :global(.latent-grid .card__linktext) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  /* The link is invisible, so the focus ring belongs on the card. */
  :global(.latent-grid .card__link:focus-visible) {
    outline: none;
  }
  :global(.latent-grid .card:has(.card__link:focus-visible)) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  /* The grip is the one piece of card chrome that lives OUTSIDE
     .card__content, so it cannot inherit the treatment's text color. Two
     explicit rules, one per background it can land on — and deliberately no
     third: hoisting `color` onto .card--hero would push on-overlay white into
     plate's theme-native bottom strip and white out its title. This bug class
     (a child declaring its own color under a faced head) has recurred four
     times in Latents; it gets a comment, not a shrug. */
  :global(.latent-grid .card__grip) {
    position: absolute;
    top: 2px;
    right: 2px;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    min-height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font-family: inherit;
    font-size: 0.9rem;
    line-height: 1;
    cursor: grab;
    /* On the handle ALONE — anything wider kills scrolling past the grid.
       See src/lib/dragOptions.ts. */
    touch-action: none;
  }
  /* Hero cards: the TOP of the card is bare photograph under every treatment
     — scrim's gradient is transparent by 70% and plate's opaque strip is
     pinned to the BOTTOM. So the grip needs on-overlay ink plus its own
     backing; nothing else guarantees a ground up here.

     --color-overlay, NOT --color-overlay-soft. The soft token (35% black in
     light mode) composites to rgb(166) over a white photograph, where white
     ink lands at 2.44:1 — under AA, and genuinely hard to see on a pale
     image. --color-overlay is 0.6/0.7, which holds 5.7:1 over the same
     worst case. `.status-pill` beside it does use the soft token, but it is
     larger, has a border in its own semantic colour, and is not a control
     you have to hit. tests/browser/index_order.mjs measures this against
     both a white and a black ground. */
  :global(.latent-grid .card--hero .card__grip) {
    color: var(--color-on-overlay);
    background: var(--color-overlay);
  }
  :global(.latent-grid .card__grip:active) {
    cursor: grabbing;
  }
  :global(.latent-grid .card__grip:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  /* The plain card's title starts top-left on the same line as the grip. */
  :global(.latent-grid .card:not(.card--hero) .card__title) {
    padding-inline-end: 30px;
  }
  /* Drop indicator: the gap that opens up IS the indicator. Sortable's ghost
     sits at the drop position, so blanking its contents turns it into an
     outlined empty slot — unambiguous in the wrapping desktop grid, where a
     drawn line between two cards has no honest place at a row break. */
  :global(.latent-grid .card--landing) {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }
  :global(.latent-grid .card--landing > *) {
    visibility: hidden;
  }
  /* DRAG_OPTS sets chosenClass: 'drag-chosen', but that class is only styled
     inside LatentSlots/LatentPlaylists/LatentSlideshows' :global blocks — it
     does NOT ship in a global stylesheet. Without restating it here, a touch
     long-press on this page reads as a dead tap. */
  :global(.drag-chosen) {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
  .latent-error {
    border: 1px solid var(--color-status-fail);
    color: var(--color-text);
    padding: var(--space-sm);
    margin-bottom: var(--space-sm);
    font-size: var(--text-sm);
  }
  .latent-error:empty {
    display: none;
  }
  :global(.latent-grid .empty) {
    grid-column: 1 / -1;
    border: 1px dashed var(--color-border);
    padding: var(--space-lg);
    text-align: center;
    color: var(--color-muted);
  }
  :global(.latent-grid .empty strong) {
    display: block;
    color: var(--color-text);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 1pt;
    font-size: var(--text-sm);
  }
  @media (max-width: 640px) {
    .latent-grid {
      grid-template-columns: 1fr;
    }
    .filter-bar {
      flex-direction: column;
      gap: var(--space-sm);
    }
  }
</style>

<script>
  import Sortable from 'sortablejs';
  import { thumbUrl } from '../../../lib/mediaThumb.ts';
  import { DRAG_OPTS } from '../../../lib/dragOptions.ts';

  let initialized = false;
  let activeStatus = '';
  let activeKind = '';
  let listEl: HTMLElement | null = null;
  let errEl: HTMLElement | null = null;
  let sortable: Sortable | null = null;
  // Bumped by every refresh(). A rollback carries the generation it was taken
  // in, so a late failure can't reorder a grid a filter change already rebuilt.
  let generation = 0;
  // Bumped by every drag. Drops responses that a later drag has superseded.
  let reqToken = 0;
  let preDragOrder: HTMLElement[] = [];

  function escapeHtml(s: string): string {
    return (s || '').replace(
      /[&<>"']/g,
      (c) =>
        (
          ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;',
          }) as Record<string, string>
        )[c],
    );
  }

  // Status colors map to CSS vars so they flip in dark mode. The
  // `forming`/`abandoned` shades stay as the muted token; developing
  // uses the accent (gold); fixing maps to the status-ok green.
  function statusColor(s: string): string {
    return (
      (
        {
          forming: 'var(--color-muted)',
          developing: 'var(--color-accent)',
          fixing: 'var(--color-status-ok)',
          abandoned: 'var(--color-muted)',
        } as Record<string, string>
      )[s] || 'var(--color-muted)'
    );
  }

  function fmtCount(n: number, unit: string): string {
    return `${n} ${unit}${n === 1 ? '' : 's'}`;
  }

  function showError(msg: string) {
    if (errEl) errEl.textContent = msg;
  }

  function clearError() {
    if (errEl) errEl.textContent = '';
  }

  /** The cards currently in the DOM, in render order. */
  function cardEls(): HTMLElement[] {
    if (!listEl) return [];
    return Array.from(listEl.querySelectorAll<HTMLElement>('.card'));
  }

  /**
   * Put the cards back the way they were before a failed drag.
   *
   * DOM-only, deliberately — NOT a refresh(). The usual reason a reorder
   * fails is that the network is down, and refresh() on a dead network
   * replaces the whole grid with "Network error", so the card you just
   * dragged vanishes instead of snapping back. This page's state IS the DOM.
   */
  function restoreOrder(snapshot: HTMLElement[]) {
    if (!listEl) return;
    const frag = document.createDocumentFragment();
    snapshot.forEach((el) => frag.appendChild(el));
    listEl.appendChild(frag);
  }

  async function onDragEnd(evt: Sortable.SortableEvent) {
    if (evt.oldIndex === evt.newIndex) return;
    const item = evt.item as HTMLElement;
    const movedId = item.dataset.projectId;
    if (!movedId) return;
    // The anchors are the card's VISIBLE neighbours — which is exactly what
    // the server needs to place it when a filter is hiding some of the grid.
    const prevId =
      (item.previousElementSibling as HTMLElement | null)?.dataset.projectId ??
      null;
    const nextId =
      (item.nextElementSibling as HTMLElement | null)?.dataset.projectId ??
      null;

    const snapshot = preDragOrder;
    const gen = generation;
    const token = ++reqToken;
    clearError();
    try {
      const res = await fetch('/api/projects/reorder', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          moved_id: movedId,
          prev_id: prevId,
          next_id: nextId,
        }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const body = await res.json();
      if (token !== reqToken) return; // a later drag already won
      // The server's order is authoritative. If what's on screen disagrees
      // with it (another admin dragged the same grid), resync.
      const visible = cardEls().map((el) => el.dataset.projectId);
      const serverVisible = (body.order || []).filter((id: string) =>
        visible.includes(id),
      );
      if (serverVisible.join() !== visible.join()) refresh();
    } catch {
      if (generation === gen) {
        restoreOrder(snapshot);
        showError(
          'Could not save the new order — the cards have been put back.',
        );
      } else {
        // The grid was rebuilt under us (filter change), so there is nothing
        // coherent to roll back to. Say what happened, don't claim a restore.
        showError('Could not save the new order.');
      }
    }
  }

  function ensureSortable() {
    if (sortable || !listEl) return;
    sortable = Sortable.create(listEl, {
      ...DRAG_OPTS,
      handle: '.card__grip',
      // Skeletons and the empty-state block are children of the grid too.
      draggable: '.card',
      ghostClass: 'card--landing',
      // `direction` is deliberately unset: Sortable's default reads
      // gridTemplateColumns per drag, so the 640px collapse to one column is
      // detected for free.
      onStart: () => {
        preDragOrder = cardEls();
      },
      onEnd: onDragEnd,
    });
  }

  async function refresh() {
    if (!listEl) return;
    generation += 1;
    clearError();
    const params = new URLSearchParams();
    if (activeStatus) params.set('status', activeStatus);
    if (activeKind) params.set('kind', activeKind);
    listEl.setAttribute('aria-busy', 'true');
    let res: Response;
    try {
      res = await fetch('/api/projects?' + params.toString(), {
        credentials: 'include',
      });
    } catch (e) {
      listEl.innerHTML =
        '<div class="empty"><strong>Network error</strong>Could not reach the API.</div>';
      listEl.setAttribute('aria-busy', 'false');
      return;
    }
    if (!res.ok) {
      listEl.innerHTML = `<div class="empty"><strong>Failed to load</strong>HTTP ${res.status}</div>`;
      listEl.setAttribute('aria-busy', 'false');
      return;
    }
    const body = await res.json();
    const projects = body.projects || [];
    if (projects.length === 0) {
      listEl.innerHTML = `<div class="empty">
          <strong>No latents yet</strong>
          A latent is a pre-release workspace. Create one to start gathering
          files, slots and discussion.
          <div style="margin-top: var(--space-sm);">
            <a class="btn-primary" href="/admin/latents/new">+ New Latent</a>
          </div>
        </div>`;
      listEl.setAttribute('aria-busy', 'false');
      return;
    }
    listEl.innerHTML = projects
      .map((p: any) => {
        const c = statusColor(p.status);
        const updated = p.updated_at
          ? new Date(p.updated_at).toLocaleDateString()
          : '';
        const href = p.slug
          ? `/admin/latents/${encodeURIComponent(p.slug)}`
          : `/admin/latents/detail?id=${encodeURIComponent(p.id)}`;
        // The card is a <div>, not an <a>: the reorder grip has to be a real
        // button, and a button cannot live inside a link. The whole card is
        // still one click target via the stretched `.card__link` below.
        const grip = `<button class="card__grip" type="button" title="Drag to reorder" aria-label="Reorder ${escapeHtml(p.name)}">⠿</button>`;
        const link = `<a class="card__link" href="${href}"><span class="card__linktext">${escapeHtml(p.name)}</span></a>`;
        if (!p.hero_media_item_id) {
          return `<div class="card" data-project-id="${escapeHtml(p.id)}">
            ${grip}
            <div class="card__title">${escapeHtml(p.name)}</div>
            <div class="card__sub">${escapeHtml(p.kind)}</div>
            <div class="card__meta">
              <span class="status-pill" style="--c:${c}">${escapeHtml(p.status)}</span>
              <span>updated ${escapeHtml(updated)}</span>
            </div>
            ${link}
          </div>`;
        }
        // Both interpolations below land in class/style attributes, so they
        // are re-validated here even though the server already whitelists
        // the style and enforces the accent's #rrggbb grammar.
        const heroStyle = ['scrim', 'plate', 'treat'].includes(p.hero_style)
          ? p.hero_style
          : 'scrim';
        const accent = /^#[0-9a-f]{6}$/i.test(p.hero_accent || '')
          ? p.hero_accent
          : '';
        const thumb = (size: 'sm' | 'md') =>
          thumbUrl(p.hero_media_item_id, size);
        return `<div class="card card--hero card--${heroStyle}" data-project-id="${escapeHtml(p.id)}"${
          accent ? ` style="--latent-accent:${accent}"` : ''
        }>
            ${grip}
            <img class="card__bg" src="${thumb('md')}" srcset="${thumb('sm')} 128w, ${thumb('md')} 400w" sizes="(max-width: 640px) 100vw, 260px" alt="" loading="lazy" onerror="this.remove()" />
            <div class="card__veil"></div>
            <div class="card__content">
              <div class="card__title">${escapeHtml(p.name)}</div>
              <div class="card__sub">${escapeHtml(p.kind)}</div>
              <div class="card__meta">
                <span class="status-pill" style="--c:${c}">${escapeHtml(p.status)}</span>
                <span>updated ${escapeHtml(updated)}</span>
              </div>
            </div>
            ${link}
          </div>`;
      })
      .join('');
    listEl.setAttribute('aria-busy', 'false');
    // Bind once, after there are real cards to drag. Sortable resolves its
    // target at drag start rather than tagging children up front, so it
    // survives refresh() replacing the grid's innerHTML underneath it.
    ensureSortable();
  }

  function wireChips(rowId: string, on: (val: string) => void) {
    const row = document.getElementById(rowId);
    if (!row) return;
    row.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest(
        'button[data-status],button[data-kind]',
      ) as HTMLButtonElement | null;
      if (!t) return;
      row
        .querySelectorAll('.chip')
        .forEach((b) => b.classList.remove('active'));
      t.classList.add('active');
      on((t.dataset.status ?? t.dataset.kind) || '');
    });
  }

  async function init() {
    listEl = document.getElementById('latents-list');
    errEl = document.getElementById('latents-error');
    if (!listEl) return;
    const user = await (window as any).__authReady;
    if (!user) return;
    if (initialized) return;
    initialized = true;
    wireChips('status-chips', (v) => {
      activeStatus = v;
      refresh();
    });
    wireChips('kind-chips', (v) => {
      activeKind = v;
      refresh();
    });
    refresh();
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:after-swap', () => {
    initialized = false;
    // The old grid node is detached after a swap; an undestroyed instance
    // keeps document-level listeners bound to it. init() re-grabs the fresh
    // node and refresh() re-binds.
    sortable?.destroy();
    sortable = null;
    listEl = null;
    errEl = null;
  });
  init();
</script>
