---
import Admin from '../../../layouts/Admin.astro';
---

<Admin title="Latents" current="latents">
  <div class="page-header">
    <h1>Latents</h1>
    <div class="header-actions">
      <a class="btn-primary" href="/admin/latents/new">+ New latent</a>
    </div>
  </div>
  <p class="page-subtitle">
    Pre-release workspace. Each latent gathers files, slots, notes, and
    discussion for an in-progress work.
  </p>

  <div class="filters">
    <label class="filter">
      <span>Status</span>
      <select id="filter-status">
        <option value="">all</option>
        <option value="forming">forming</option>
        <option value="developing">developing</option>
        <option value="fixing">fixing</option>
        <option value="abandoned">abandoned</option>
      </select>
    </label>
    <label class="filter">
      <span>Kind</span>
      <select id="filter-kind">
        <option value="">all</option>
        <option value="album">album</option>
        <option value="video">video</option>
        <option value="zine">zine</option>
        <option value="other">other</option>
      </select>
    </label>
  </div>

  <div id="latents-list" class="latent-cards">Loading…</div>
</Admin>

<style>
  .page-subtitle {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-xs);
  }
  .filters {
    display: flex;
    gap: var(--space-md);
    margin: var(--space-md) 0;
    flex-wrap: wrap;
  }
  .filter {
    display: flex;
    gap: 6px;
    align-items: center;
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 1pt;
  }
  .filter select {
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .latent-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-sm);
  }
  :global(.latent-cards .card) {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    padding: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: inherit;
    transition: border-color 80ms;
  }
  :global(.latent-cards .card:hover) {
    border-color: var(--color-accent);
  }
  :global(.latent-cards .card__title) {
    font-weight: bold;
    font-size: var(--text-base);
  }
  :global(.latent-cards .card__meta) {
    display: flex;
    gap: var(--space-sm);
    color: var(--color-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
    flex-wrap: wrap;
    align-items: center;
  }
  :global(.latent-cards .status-pill) {
    padding: 2px 8px;
    border: 1px solid var(--c, var(--color-muted));
    color: var(--c, var(--color-muted));
  }
  @media (max-width: 640px) {
    .latent-cards {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', async () => {
    const list = document.getElementById('latents-list');
    if (!list) return;

    const user = await (window as any).__authReady;
    if (!user) return;

    const statusSel = document.getElementById(
      'filter-status',
    ) as HTMLSelectElement;
    const kindSel = document.getElementById('filter-kind') as HTMLSelectElement;

    function statusColor(s: string): string {
      return (
        (
          {
            forming: '#9ca3af',
            developing: '#b8860b',
            fixing: '#080',
            abandoned: '#6b7280',
          } as Record<string, string>
        )[s] || '#888'
      );
    }

    async function refresh() {
      const params = new URLSearchParams();
      if (statusSel.value) params.set('status', statusSel.value);
      if (kindSel.value) params.set('kind', kindSel.value);
      const res = await fetch('/api/projects?' + params.toString(), {
        credentials: 'include',
      });
      if (!res.ok) {
        list!.innerHTML = '<p>Failed to load.</p>';
        return;
      }
      const body = await res.json();
      const projects = body.projects || [];
      if (projects.length === 0) {
        list!.innerHTML = '<p class="muted">No latents yet.</p>';
        return;
      }
      list!.innerHTML = projects
        .map((p: any) => {
          const c = statusColor(p.status);
          const updated = p.updated_at
            ? new Date(p.updated_at).toLocaleDateString()
            : '';
          return `<a class="card" href="/admin/latents/detail?id=${encodeURIComponent(p.id)}">
              <div class="card__title">${escapeHtml(p.name)}</div>
              <div class="card__meta">
                <span>${escapeHtml(p.kind)}</span>
                <span class="status-pill" style="--c:${c}">${escapeHtml(p.status)}</span>
                <span>updated ${updated}</span>
              </div>
            </a>`;
        })
        .join('');
    }

    function escapeHtml(s: string): string {
      return (s || '').replace(
        /[&<>"']/g,
        (c) =>
          (
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            }) as Record<string, string>
          )[c],
      );
    }

    statusSel.addEventListener('change', refresh);
    kindSel.addEventListener('change', refresh);
    refresh();
  });
</script>
