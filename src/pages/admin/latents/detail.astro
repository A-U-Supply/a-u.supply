---
import Admin from '../../../layouts/Admin.astro';
---

<Admin title="Latent" current="latents">
  <div id="header" class="latent-header">
    <div class="header-skeleton"></div>
  </div>

  <div id="islands" class="islands" hidden>
    <section id="repo-island"></section>
    <section id="links-island"></section>
    <section id="docs-island"></section>
    <section id="slots-island"></section>
    <section id="loose-island"></section>
    <section id="threads-island"></section>
  </div>
</Admin>

<style>
  .latent-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .header-skeleton {
    height: 64px;
    border: 1px solid var(--color-border);
    background: linear-gradient(
      90deg,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-fg) 6%, transparent) 50%,
      var(--color-bg) 100%
    );
    background-size: 200% 100%;
    animation: hdr-shimmer 1.6s linear infinite;
  }
  @keyframes hdr-shimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }
  .islands {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-top: var(--space-md);
  }
  :global(.latent-header .header-row) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  :global(.latent-header .name-input) {
    background: var(--color-bg);
    color: var(--color-text);
    border: 2px solid var(--color-text);
    box-shadow: 2px 2px 0 var(--color-text);
    padding: 8px 12px;
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 700;
    flex: 1;
    min-width: 220px;
  }
  :global(.latent-header .kind-select) {
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: 6px 10px;
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  :global(.latent-header .status-row) {
    display: flex;
    gap: 4px;
  }
  :global(.latent-header .status-btn) {
    background: transparent;
    color: var(--c, var(--color-muted));
    border: 1px solid var(--c, var(--color-muted));
    padding: 2px 8px;
    font: inherit;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
    cursor: pointer;
  }
  :global(.latent-header .status-btn.active) {
    background: var(--c, var(--color-muted));
    color: var(--color-bg);
  }
  :global(.latent-header .summary) {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  :global(.latent-header .slug-input) {
    background: var(--color-bg);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    flex: 0 0 200px;
  }
  :global(.latent-header .desc-input) {
    width: 100%;
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-md);
    line-height: 1.55;
    resize: vertical;
    margin-top: 4px;
    min-height: 7.5em;
    /* Autosize sets `height` directly via JS; this caps runaway growth on
       very long descriptions so the page stays usable. */
    max-height: 70vh;
    overflow-y: auto;
    box-sizing: border-box;
  }
  :global(.latent-header .desc-input:focus) {
    outline: none;
    border-color: var(--color-accent, var(--color-text));
    box-shadow: 2px 2px 0 var(--color-text);
  }
  :global(.latent-header .desc-saved) {
    display: block;
    color: var(--color-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
    padding: 2px 0;
  }
  :global(.latent-header .meta-details) {
    border: 1px dashed var(--color-border);
    padding: var(--space-sm);
    background: var(--color-surface);
  }
  :global(.latent-header .meta-details summary) {
    cursor: pointer;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
    color: var(--color-muted);
  }
  :global(.latent-header .meta-details summary .muted) {
    color: var(--color-muted);
  }
  :global(.latent-header .meta-list) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: var(--space-sm);
  }
  :global(.latent-header .meta-row) {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    gap: 6px;
  }
  :global(.latent-header .meta-row input) {
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  :global(.latent-header .meta-row .meta-del) {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 1.1rem;
    cursor: pointer;
    line-height: 1;
    padding: 0 8px;
  }
  :global(.latent-header .meta-actions) {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }
  :global(.latent-header .meta-saved) {
    color: var(--color-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
  }
  @media (max-width: 640px) {
    :global(.latent-header .name-input) {
      min-width: 0;
      width: 100%;
    }
  }
</style>

<script>
  import { mount, unmount } from 'svelte';
  import LatentSlots from '../../../components/LatentSlots.svelte';
  import LatentDocuments from '../../../components/LatentDocuments.svelte';
  import LatentLooseFiles from '../../../components/LatentLooseFiles.svelte';
  import LatentRepoStrip from '../../../components/LatentRepoStrip.svelte';
  import LatentLinks from '../../../components/LatentLinks.svelte';
  import Threads from '../../../components/Threads.svelte';

  let mounted: any[] = [];
  let initialized = false;

  function statusColor(s: string): string {
    return (
      (
        {
          forming: 'var(--color-muted)',
          developing: 'var(--color-accent)',
          fixing: 'var(--color-status-ok)',
          abandoned: 'var(--color-muted)',
        } as Record<string, string>
      )[s] || 'var(--color-muted)'
    );
  }

  function escapeHtml(s: string): string {
    return (s || '').replace(
      /[&<>"']/g,
      (c) =>
        (
          ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;',
          }) as Record<string, string>
        )[c],
    );
  }

  async function resolveProjectId(
    headerEl: HTMLElement,
  ): Promise<string | null> {
    const params = new URLSearchParams(window.location.search);
    let id = params.get('id');
    if (id) return id;
    // Pretty URL form: /admin/latents/<slug> (or /admin/latents/<slug>/)
    const m = window.location.pathname.match(/^\/admin\/latents\/([^/]+)\/?$/);
    if (!m || m[1] === 'detail' || m[1] === 'new') return null;
    const slug = m[1];
    try {
      const r = await fetch(
        `/api/projects/by-slug/${encodeURIComponent(slug)}`,
        { credentials: 'include' },
      );
      if (!r.ok) {
        headerEl.innerHTML = `<p style="color: var(--color-status-fail);">No latent with slug <code>${slug}</code>.</p>`;
        return null;
      }
      const j = await r.json();
      return j.id;
    } catch {
      headerEl.innerHTML =
        '<p style="color: var(--color-status-fail);">Network error resolving slug.</p>';
      return null;
    }
  }

  async function init() {
    if (initialized) return;
    const headerEl = document.getElementById('header');
    const islandsEl = document.getElementById('islands');
    if (!headerEl || !islandsEl) return;

    const user = await (window as any).__authReady;
    if (!user) return;
    if (initialized) return;

    const id = await resolveProjectId(headerEl);
    if (!id) return;
    initialized = true;

    let res: Response;
    try {
      res = await fetch(`/api/projects/${encodeURIComponent(id)}`, {
        credentials: 'include',
      });
    } catch (e) {
      headerEl.innerHTML =
        '<p style="color: var(--color-status-fail);">Network error loading Latent.</p>';
      return;
    }
    if (!res.ok) {
      headerEl.innerHTML = `<p style="color: var(--color-status-fail);">Not found (HTTP ${res.status}).</p>`;
      return;
    }
    const p = await res.json();

    // If we resolved by id (query-string entry) and the project has a slug,
    // upgrade the URL to the pretty form so bookmarks + share links work.
    if (p.slug && window.location.pathname !== `/admin/latents/${p.slug}`) {
      try {
        history.replaceState(history.state, '', `/admin/latents/${p.slug}`);
      } catch {}
    }

    const metadataRows = Object.entries(p.metadata || {})
      .map(
        ([k, v]) =>
          `<div class="meta-row">
            <input class="meta-key" type="text" value="${escapeHtml(k)}" />
            <input class="meta-val" type="text" value="${escapeHtml(String(v ?? ''))}" />
            <button class="meta-del" type="button" title="Remove">×</button>
          </div>`,
      )
      .join('');

    headerEl.innerHTML = `
      <div class="header-row">
        <input class="name-input" id="name-input" type="text" value="${escapeHtml(p.name)}" />
        <input class="slug-input" id="slug-input" type="text" value="${escapeHtml(p.slug || '')}" title="URL slug" />
        <select class="kind-select" id="kind-select">
          ${['album', 'video', 'zine', 'other']
            .map(
              (k) =>
                `<option value="${k}" ${k === p.kind ? 'selected' : ''}>${k}</option>`,
            )
            .join('')}
        </select>
        <div class="status-row" id="status-row">
          ${['forming', 'developing', 'fixing', 'abandoned']
            .map((s) => {
              const c = statusColor(s);
              return `<button class="status-btn ${s === p.status ? 'active' : ''}" data-status="${s}" style="--c:${c}">${s}</button>`;
            })
            .join('')}
        </div>
        <a class="action-btn" href="/admin/latents">All latents</a>
      </div>
      <p class="summary">${escapeHtml(p.kind)} latent · ${p.item_count} files · ${p.documents.length} document${p.documents.length === 1 ? '' : 's'} · ${p.slots.length} slot${p.slots.length === 1 ? '' : 's'}${p.thread_count ? ' · ' + p.thread_count + ' thread' + (p.thread_count === 1 ? '' : 's') : ''}</p>

      <textarea
        class="desc-input"
        id="desc-input"
        rows="5"
        placeholder="Description / synopsis (markdown). Autosaves. Grows as you type."
      >${escapeHtml(p.description || '')}</textarea>

      <details class="meta-details" id="meta-details" ${Object.keys(p.metadata || {}).length ? 'open' : ''}>
        <summary>Metadata <span class="muted">(${Object.keys(p.metadata || {}).length})</span></summary>
        <div class="meta-list" id="meta-list">${metadataRows}</div>
        <div class="meta-actions">
          <button class="action-btn" id="meta-add" type="button">+ Add field</button>
          <span class="meta-saved" id="meta-saved"></span>
        </div>
      </details>
    `;

    const nameInput = document.getElementById('name-input') as HTMLInputElement;
    const kindSelect = document.getElementById(
      'kind-select',
    ) as HTMLSelectElement;
    const statusRow = document.getElementById('status-row')!;

    let nameTimer: any = null;
    nameInput.addEventListener('input', () => {
      if (nameTimer) clearTimeout(nameTimer);
      nameTimer = setTimeout(() => {
        fetch(`/api/projects/${encodeURIComponent(id)}`, {
          method: 'PATCH',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: nameInput.value }),
        });
      }, 1200);
    });
    kindSelect.addEventListener('change', () => {
      fetch(`/api/projects/${encodeURIComponent(id)}`, {
        method: 'PATCH',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kind: kindSelect.value }),
      });
    });
    statusRow
      .querySelectorAll<HTMLButtonElement>('[data-status]')
      .forEach((btn) => {
        btn.addEventListener('click', async () => {
          const s = btn.dataset.status!;
          await fetch(`/api/projects/${encodeURIComponent(id)}`, {
            method: 'PATCH',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: s }),
          });
          statusRow
            .querySelectorAll<HTMLButtonElement>('[data-status]')
            .forEach((b) => {
              b.classList.toggle('active', b.dataset.status === s);
            });
        });
      });

    // Slug change — autosave + replaceState to keep the URL pretty
    const slugInput = document.getElementById('slug-input') as HTMLInputElement;
    let slugTimer: any = null;
    slugInput.addEventListener('input', () => {
      if (slugTimer) clearTimeout(slugTimer);
      slugTimer = setTimeout(async () => {
        const trimmed = slugInput.value.trim();
        if (!trimmed || trimmed === p.slug) return;
        const r = await fetch(`/api/projects/${encodeURIComponent(id)}`, {
          method: 'PATCH',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: trimmed }),
        });
        if (r.ok) {
          const updated = await r.json();
          p.slug = updated.slug;
          slugInput.value = updated.slug;
          try {
            history.replaceState(
              history.state,
              '',
              `/admin/latents/${updated.slug}`,
            );
          } catch {}
        } else {
          const err = await r.json().catch(() => ({}));
          alert(err?.detail || 'Slug change failed');
          slugInput.value = p.slug || '';
        }
      }, 1200);
    });

    // Description — autosave + autosize. The textarea grows with the
    // content (capped via max-height in CSS), so long synopses don't get
    // crammed into a 3-line slot.
    const descInput = document.getElementById(
      'desc-input',
    ) as HTMLTextAreaElement;
    const descSaved = document.createElement('span');
    descSaved.className = 'desc-saved';
    descInput.insertAdjacentElement('afterend', descSaved);
    function autosizeDesc() {
      descInput.style.height = 'auto';
      descInput.style.height = descInput.scrollHeight + 'px';
    }
    // Initial sizing — wait for the element to be laid out so scrollHeight
    // is meaningful.
    requestAnimationFrame(autosizeDesc);
    let descTimer: any = null;
    descInput.addEventListener('input', () => {
      autosizeDesc();
      descSaved.textContent = 'unsaved';
      if (descTimer) clearTimeout(descTimer);
      descTimer = setTimeout(async () => {
        descSaved.textContent = 'saving…';
        const r = await fetch(`/api/projects/${encodeURIComponent(id)}`, {
          method: 'PATCH',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ description: descInput.value }),
        });
        descSaved.textContent = r.ok ? 'saved' : 'save failed';
      }, 1500);
    });

    // Metadata key/value editor
    const metaList = document.getElementById('meta-list')!;
    const metaSaved = document.getElementById('meta-saved') as HTMLSpanElement;
    let metaSaveTimer: any = null;

    function collectMetadata(): Record<string, string> {
      const out: Record<string, string> = {};
      metaList.querySelectorAll<HTMLDivElement>('.meta-row').forEach((row) => {
        const k = (
          row.querySelector('.meta-key') as HTMLInputElement
        ).value.trim();
        const v = (row.querySelector('.meta-val') as HTMLInputElement).value;
        if (k) out[k] = v;
      });
      return out;
    }

    function scheduleMetadataSave() {
      metaSaved.textContent = 'unsaved';
      if (metaSaveTimer) clearTimeout(metaSaveTimer);
      metaSaveTimer = setTimeout(async () => {
        metaSaved.textContent = 'saving…';
        const r = await fetch(`/api/projects/${encodeURIComponent(id)}`, {
          method: 'PATCH',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ metadata: collectMetadata() }),
        });
        metaSaved.textContent = r.ok ? 'saved' : 'save failed';
      }, 1200);
    }

    function makeRow(key = '', value = ''): HTMLDivElement {
      const row = document.createElement('div');
      row.className = 'meta-row';
      row.innerHTML = `
        <input class="meta-key" type="text" value="${escapeHtml(key)}" placeholder="key" />
        <input class="meta-val" type="text" value="${escapeHtml(value)}" placeholder="value" />
        <button class="meta-del" type="button" title="Remove">×</button>
      `;
      row
        .querySelectorAll('input')
        .forEach((i) => i.addEventListener('input', scheduleMetadataSave));
      row.querySelector('.meta-del')!.addEventListener('click', () => {
        row.remove();
        scheduleMetadataSave();
      });
      return row;
    }
    // Wire any pre-rendered rows
    metaList.querySelectorAll<HTMLDivElement>('.meta-row').forEach((row) => {
      row
        .querySelectorAll('input')
        .forEach((i) => i.addEventListener('input', scheduleMetadataSave));
      row.querySelector('.meta-del')!.addEventListener('click', () => {
        row.remove();
        scheduleMetadataSave();
      });
    });
    document.getElementById('meta-add')!.addEventListener('click', () => {
      metaList.appendChild(makeRow());
      (
        metaList.lastElementChild!.querySelector(
          '.meta-key',
        ) as HTMLInputElement
      ).focus();
    });

    for (const m of mounted) {
      try {
        unmount(m);
      } catch {}
    }
    mounted = [];

    islandsEl.hidden = false;
    mounted.push(
      mount(LatentRepoStrip, {
        target: document.getElementById('repo-island')!,
        props: { projectId: id },
      }),
    );
    mounted.push(
      mount(LatentLinks, {
        target: document.getElementById('links-island')!,
        props: { projectId: id, title: 'Links' },
      }),
    );
    mounted.push(
      mount(LatentDocuments, {
        target: document.getElementById('docs-island')!,
        props: { projectId: id },
      }),
    );
    mounted.push(
      mount(LatentSlots, {
        target: document.getElementById('slots-island')!,
        props: { projectId: id, projectKind: p.kind },
      }),
    );
    mounted.push(
      mount(LatentLooseFiles, {
        target: document.getElementById('loose-island')!,
        props: { projectId: id },
      }),
    );
    mounted.push(
      mount(Threads, {
        target: document.getElementById('threads-island')!,
        props: {
          anchorType: 'project',
          anchorId: id,
          title: 'Latent threads',
        },
      }),
    );
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    for (const m of mounted) {
      try {
        unmount(m);
      } catch {}
    }
    mounted = [];
    initialized = false;
  });
  init();
</script>
