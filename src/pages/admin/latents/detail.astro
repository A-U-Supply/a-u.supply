---
import Admin from '../../../layouts/Admin.astro';
---

<Admin title="Latent" current="latents">
  <div id="header" class="latent-header">
    <div class="header-skeleton"></div>
  </div>

  <div id="map-island"></div>

  <div id="islands" class="islands" hidden>
    <section id="repo-island" class="latent-section" data-section="repo">
    </section>
    <section id="links-island" class="latent-section" data-section="links">
    </section>
    <section id="docs-island" class="latent-section" data-section="docs">
    </section>
    <section id="slots-island" class="latent-section" data-section="slots">
    </section>
    <section
      id="playlists-island"
      class="latent-section"
      data-section="playlists"
    >
    </section>
    <section
      id="slideshow-island"
      class="latent-section"
      data-section="slideshow"
    >
    </section>
    <section id="loose-island" class="latent-section" data-section="loose">
    </section>
    <section id="threads-island" class="latent-section" data-section="threads">
    </section>
    <section
      id="marginalia-island"
      class="latent-section"
      data-section="marginalia"
    >
    </section>
  </div>

  <div id="style-panel-island"></div>

  {
    /*
    Native <dialog>, in the STATIC markup rather than in the header's
    innerHTML — built once, listeners bound once, and immune to the header
    re-rendering under it.

    Native is the point, not a detail: showModal() puts the dialog in the
    browser's top layer, so it needs no `position: fixed` and no z-index, and
    `.latent-header--backdrop`'s `isolation: isolate` cannot swallow it. That
    exact trap cost four separate fixes (#573/#574/#575/#581). Focus trapping
    and Escape come free. Precedent: .quick-link-dialog in admin/dashboard.astro.
  */
  }
  <dialog class="delete-dialog" id="delete-dialog">
    <h3>Delete latent</h3>
    <p class="delete-dialog__lede">
      You are about to permanently delete
      <strong id="delete-name"></strong>
    </p>
    <ul class="delete-dialog__ledger" id="delete-ledger"></ul>
    <p class="delete-dialog__final">This cannot be undone.</p>
    <label class="delete-dialog__label" for="delete-confirm">
      Type the latent's name to confirm
    </label>
    <input
      class="delete-dialog__input"
      id="delete-confirm"
      type="text"
      autocomplete="off"
      spellcheck="false"
    />
    <p class="delete-dialog__error" id="delete-error" hidden></p>
    <div class="delete-dialog__actions">
      <button class="action-btn" id="delete-cancel" type="button">Cancel</button
      >
      <button
        class="action-btn action-btn--danger latent-danger"
        id="delete-confirm-btn"
        type="button"
        disabled
      >
        Delete latent
      </button>
    </div>
  </dialog>
</Admin>

<style>
  .latent-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .header-skeleton {
    height: 64px;
    border: 1px solid var(--color-border);
    background: linear-gradient(
      90deg,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-fg) 6%, transparent) 50%,
      var(--color-bg) 100%
    );
    background-size: 200% 100%;
    animation: hdr-shimmer 1.6s linear infinite;
  }
  @keyframes hdr-shimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }
  .islands {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-top: var(--space-md);
  }
  /* Section faces (2026-07-18-latent-faces): every fixed section wears an
     accent spine in its palette default; per-latent overrides land as
     inline vars via applySectionStyles(), which also builds the full-card
     face layers (index-card recipe). The head-band class the islands opt
     into (.latent-band) lives in global.css. */
  .latent-section {
    position: relative;
    isolation: isolate;
    border-left: 4px solid var(--sec-accent);
    padding-left: var(--space-sm);
    color: var(--sec-text, inherit);
  }
  .latent-section[data-section='repo'] {
    --sec-accent: var(--latent-sec-repo);
  }
  .latent-section[data-section='links'] {
    --sec-accent: var(--latent-sec-links);
  }
  .latent-section[data-section='docs'] {
    --sec-accent: var(--latent-sec-docs);
  }
  .latent-section[data-section='slots'] {
    --sec-accent: var(--latent-sec-slots);
  }
  .latent-section[data-section='playlists'] {
    --sec-accent: var(--latent-sec-playlists);
  }
  .latent-section[data-section='slideshow'] {
    --sec-accent: var(--latent-sec-slideshow);
  }
  .latent-section[data-section='loose'] {
    --sec-accent: var(--latent-sec-loose);
  }
  .latent-section[data-section='threads'] {
    --sec-accent: var(--latent-sec-threads);
  }
  /* Marginalia is not a styleable section (not in the server's
     VALID_SECTION_KEYS) — it borrows the threads accent and is skipped by
     applySectionStyles(), which only iterates SECTION_KEYS. */
  .latent-section[data-section='marginalia'] {
    --sec-accent: var(--latent-sec-threads);
  }
  /* Faced sections get a full card frame — the section IS the card. */
  .latent-section--faced {
    border: 1px solid
      color-mix(
        in srgb,
        var(--sec-accent, var(--color-border)) 55%,
        var(--color-border)
      );
    border-left: 4px solid var(--sec-accent);
    padding: var(--space-sm);
  }
  /* The face layers sit on NEGATIVE z-indexes, behind the section's in-flow
     content, rather than at 0/1 with every sibling pushed to 2. See the note
     where that rule used to be, below. `isolation: isolate` on .latent-section
     is what keeps them from sinking behind the page itself — without a
     stacking context, a negative z-index child escapes its parent. */
  .latent-section :global(.sec-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .latent-section :global(.sec-veil) {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  /* scrim — top-anchored (section headers sit at the top; the index cards
     anchor bottom). */
  .latent-section--face-scrim :global(.sec-veil) {
    background: linear-gradient(
      to bottom,
      var(--color-overlay),
      transparent 70%
    );
  }
  .latent-section--face-scrim :global(.latent-band),
  .latent-section--face-scrim :global(.latent-band h2),
  .latent-section--face-scrim :global(.latent-band h3) {
    color: var(--sec-text, var(--color-on-overlay));
  }
  /* treat — whole-section duotone. */
  .latent-section--face-treat :global(.sec-bg) {
    filter: grayscale(1) brightness(0.45);
  }
  .latent-section--face-treat :global(.sec-veil) {
    background: var(--sec-accent, var(--color-overlay-soft));
    mix-blend-mode: color;
    opacity: 0.55;
  }
  .latent-section--face-treat :global(.latent-band),
  .latent-section--face-treat :global(.latent-band h2),
  .latent-section--face-treat :global(.latent-band h3) {
    color: var(--sec-text, var(--color-on-overlay));
  }
  /* plate — face at full strength, header band on an opaque theme plate. */
  .latent-section--face-plate :global(.latent-band) {
    background: var(--color-bg);
  }
  /* solid — full-strength color, auto-contrast text on the band. */
  .latent-section--face-solid {
    background: var(--sec-bg-color);
  }
  .latent-section--face-solid :global(.latent-band),
  .latent-section--face-solid :global(.latent-band h2),
  .latent-section--face-solid :global(.latent-band h3) {
    color: var(--sec-text, var(--sec-face-text, inherit));
  }
  /* There used to be a rule here:
   *
   *   .latent-section > :global(:not(.sec-bg):not(.sec-veil)) {
   *     position: relative; z-index: 2;
   *   }
   *
   * It lifted content above the face layers, and it was a booby trap. It
   * matches every direct child at specificity (0,3,0); a Svelte component's
   * scoped `.sheet`/`.panel`/`.modal` rule is (0,2,0), so any overlay an
   * island rendered at its top level silently lost `position: fixed` and
   * rendered in page flow at the bottom of its section — often below the
   * fold, with nothing to scroll to. Nothing errored. It cost four separate
   * fixes (#573, #574, #575, #581).
   *
   * Negative z-indexes on the face layers achieve the same stacking with no
   * rule on the content at all, so DON'T REINTRODUCE THIS. If content ever
   * appears behind a face again, the layers' z-index is the thing to look at.
   */
  /* Title on its own line; entry/options underneath — both breakpoints. */
  :global(.latent-header .header-title-row) {
    display: flex;
  }
  :global(.latent-header .header-controls-row) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  :global(.latent-header .name-input) {
    background: var(--color-bg);
    color: var(--color-text);
    border: 2px solid var(--color-text);
    box-shadow: 2px 2px 0 var(--color-text);
    padding: 8px 12px;
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 700;
    width: 100%;
  }
  :global(.latent-header .kind-select) {
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: 6px 10px;
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  :global(.latent-header .status-row) {
    display: flex;
    gap: 4px;
  }
  :global(.latent-header .status-btn) {
    background: transparent;
    color: var(--c, var(--color-muted));
    border: 1px solid var(--c, var(--color-muted));
    padding: 2px 8px;
    font: inherit;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
    cursor: pointer;
  }
  :global(.latent-header .status-btn.active) {
    background: var(--c, var(--color-muted));
    color: var(--color-bg);
  }
  :global(.latent-header .summary) {
    color: var(--color-muted);
    font-size: var(--text-sm);
    /* The counts stay left; DELETE LATENT rides the right edge of this line,
       which is the last thing above #hero-island. */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }
  /* Destructive buttons that must stay legible, wherever they land.
     `.action-btn--danger` hardcodes a red tuned for a light page, and it has
     two problems here.

     One: this header can carry the latent's cover art
     (.latent-header--backdrop below), and that ground composites to a MID
     tone in light mode — art at 15% under a --color-overlay-soft veil, which
     is black in BOTH themes — where the hardcoded red falls under AA. The
     answer is not --color-danger-on-overlay; that token is built for the dark
     slot faces and reads worse still on a mid ground. A face is not always
     dark. The header already solves this for its inputs ("Inputs sit on
     opaque grounds", further down), so the button takes an opaque plate too.

     Two: the hardcoded red is under AA on the dark theme's page background
     regardless of artwork. --color-status-fail is the token that already
     flips per theme, and it clears AA on --color-bg in both.

     Specificity is deliberate — .action-btn.latent-danger beats
     .action-btn--danger, and the :hover pair beats .action-btn--danger:hover.
     Matching specificity here would leave the winner up to stylesheet order. */
  :global(.action-btn.latent-danger) {
    background: var(--color-bg);
    border-color: var(--color-status-fail);
    color: var(--color-status-fail);
    /* On a phone the summary text is long enough to squeeze the button into
       two stacked words. Let the counts wrap instead. */
    flex: none;
    white-space: nowrap;
  }
  :global(.action-btn.latent-danger:hover:not(:disabled)) {
    background: var(--color-status-fail);
    color: var(--color-bg);
  }
  :global(.action-btn.latent-danger:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }
  :global(.latent-header .slug-input) {
    background: var(--color-bg);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    flex: 0 0 200px;
  }
  :global(.latent-header .desc-input) {
    width: 100%;
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-md);
    line-height: 1.55;
    resize: vertical;
    margin-top: 4px;
    min-height: 7.5em;
    /* Autosize sets `height` directly via JS; this caps runaway growth on
       very long descriptions so the page stays usable. */
    max-height: 70vh;
    overflow-y: auto;
    box-sizing: border-box;
  }
  :global(.latent-header .desc-input:focus) {
    outline: none;
    border-color: var(--color-accent, var(--color-text));
    box-shadow: 2px 2px 0 var(--color-text);
  }
  :global(.latent-header .desc-saved) {
    display: block;
    color: var(--color-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
    padding: 2px 0;
  }
  :global(.latent-header .meta-details) {
    border: 1px dashed var(--color-border);
    padding: var(--space-sm);
    background: var(--color-surface);
  }
  :global(.latent-header .meta-details summary) {
    cursor: pointer;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
    color: var(--color-muted);
  }
  :global(.latent-header .meta-details summary .muted) {
    color: var(--color-muted);
  }
  :global(.latent-header .meta-list) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: var(--space-sm);
  }
  :global(.latent-header .meta-row) {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    gap: 6px;
  }
  :global(.latent-header .meta-row input) {
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  :global(.latent-header .meta-row .meta-del) {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 1.1rem;
    cursor: pointer;
    line-height: 1;
    padding: 0 8px;
  }
  :global(.latent-header .meta-actions) {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }
  :global(.latent-header .meta-saved) {
    color: var(--color-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
  }
  /* Header hero backdrop (phase 3b): the latent's cover art, faint, under
     an overlay wash, confined to the header. Inputs sit on opaque grounds
     so text stays fully legible. Kept on mobile — it anchors "which latent
     am I in". */
  :global(.latent-header--backdrop) {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  /* Negative z-index, same as the section faces — see the note in the
     .latent-section block. `isolation: isolate` on .latent-header--backdrop
     above is what keeps these from sinking behind the page. */
  :global(.latent-header .header-backdrop) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.15;
    z-index: -2;
  }
  :global(.latent-header .header-backdrop-veil) {
    position: absolute;
    inset: 0;
    background: var(--color-overlay-soft);
    z-index: -1;
    pointer-events: none;
  }
  /* The third copy of the rule removed in #584 lived here:
   *
   *   .latent-header--backdrop > :not(.header-backdrop):not(.header-backdrop-veil) {
   *     position: relative; z-index: 2;
   *   }
   *
   * Same trap, same reason not to bring it back. It covers the header, which
   * hosts #hero-island — so an overlay rendered at LatentHero's top level
   * would have lost `position: fixed` exactly like the section ones did. */
  /* Hero accent carry — identity learned on the grid persists inside.
     Applied only when the Latent has an effective accent. */
  :global(.latent-header--accent) {
    border-left: 4px solid var(--latent-accent);
    padding-left: var(--space-sm);
  }
  :global(.latent-header--accent .name-input:focus) {
    outline: none;
    border-color: var(--latent-accent);
    box-shadow: 2px 2px 0 var(--latent-accent);
  }
  :global(.latent-header--accent .desc-input:focus) {
    border-color: var(--latent-accent);
    box-shadow: 2px 2px 0 var(--latent-accent);
  }

  /* Delete confirmation. Follows .quick-link-dialog in admin/dashboard.astro:
     an opaque brutalist plate on a washed backdrop. No position/z-index of
     its own — showModal() handles that in the browser's top layer. */
  .delete-dialog {
    border: 2px solid var(--color-fg);
    box-shadow: 4px 4px 0 var(--color-fg);
    background: var(--color-bg);
    color: var(--color-fg);
    padding: var(--space-md);
    width: min(480px, 90vw);
    font-family: var(--font-mono);
    /* The site's reset zeroes margin on everything, which takes out the UA's
       `margin: auto` and drops an open dialog into the top-left corner. */
    margin: auto;
  }
  .delete-dialog::backdrop {
    background: var(--color-overlay);
  }
  .delete-dialog h3 {
    margin: 0 0 var(--space-sm) 0;
    font-size: var(--text-base);
    text-transform: uppercase;
    letter-spacing: 1pt;
  }
  .delete-dialog__lede {
    margin: 0 0 var(--space-sm) 0;
    font-size: var(--text-sm);
  }
  .delete-dialog__lede strong {
    display: block;
    margin-top: 4px;
    font-size: var(--text-base);
  }
  .delete-dialog__ledger {
    margin: 0 0 var(--space-sm) 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    /* dvh, not vh — vh is the LARGEST viewport, so a long ledger on a phone
       would sit under the URL bar with nothing to scroll. */
    max-height: 40dvh;
    overflow-y: auto;
  }
  /* :global — the rows are written with innerHTML at open time, so they never
     carry Astro's scope attribute and a scoped `li` rule silently misses them:
     the labels render, un-columned, run straight into the text, and nothing
     errors. Scoped rules only reach markup Astro compiled. */
  .delete-dialog__ledger :global(li) {
    display: flex;
    gap: var(--space-xs);
    padding: 3px 0;
    border-top: 1px solid var(--color-border);
  }
  /* A flex item's default `min-width: auto` is its MIN-CONTENT width, so on a
     phone the ledger's text refuses to shrink and runs out past the dialog's
     right edge — wrapped, but clipped. */
  .delete-dialog__ledger :global(span) {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .delete-dialog__ledger :global(b) {
    flex: 0 0 4.5em;
    text-transform: uppercase;
    font-size: 0.65rem;
    letter-spacing: 1pt;
    color: var(--color-muted);
    padding-top: 3px;
  }
  .delete-dialog__final {
    margin: 0 0 var(--space-sm) 0;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-status-fail);
  }
  .delete-dialog__label {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    color: var(--color-muted);
    margin-bottom: 4px;
  }
  .delete-dialog__input {
    width: 100%;
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    padding: 6px 8px;
    font: inherit;
    font-size: var(--text-sm);
  }
  .delete-dialog__error {
    margin: var(--space-xs) 0 0 0;
    font-size: var(--text-sm);
    color: var(--color-status-fail);
  }
  .delete-dialog__actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }
</style>

<script>
  import { mount, unmount } from 'svelte';
  import {
    SECTION_KEYS,
    safeHex,
    effectiveAccent,
    autoTextColor,
    currentTheme,
    watchTheme,
  } from '../../../lib/latentStyles.ts';
  import { thumbUrl } from '../../../lib/mediaThumb.ts';
  import LatentHero from '../../../components/LatentHero.svelte';
  import LatentSectionMap from '../../../components/LatentSectionMap.svelte';
  import LatentSlots from '../../../components/LatentSlots.svelte';
  import LatentPlaylists from '../../../components/LatentPlaylists.svelte';
  import LatentDocuments from '../../../components/LatentDocuments.svelte';
  import LatentSlideshows from '../../../components/LatentSlideshows.svelte';
  import LatentLooseFiles from '../../../components/LatentLooseFiles.svelte';
  import LatentRepoStrip from '../../../components/LatentRepoStrip.svelte';
  import LatentLinks from '../../../components/LatentLinks.svelte';
  import LatentStylePanel from '../../../components/LatentStylePanel.svelte';
  import Threads from '../../../components/Threads.svelte';
  import MarginaliaRecent from '../../../components/MarginaliaRecent.svelte';

  let mounted: any[] = [];
  let initialized = false;
  let styleListener: ((e: Event) => void) | null = null;
  let heroListener: ((e: Event) => void) | null = null;
  let stopThemeWatch: (() => void) | null = null;

  function statusColor(s: string): string {
    return (
      (
        {
          forming: 'var(--color-muted)',
          developing: 'var(--color-accent)',
          fixing: 'var(--color-status-ok)',
          abandoned: 'var(--color-muted)',
        } as Record<string, string>
      )[s] || 'var(--color-muted)'
    );
  }

  function escapeHtml(s: string): string {
    return (s || '').replace(
      /[&<>"']/g,
      (c) =>
        (
          ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;',
          }) as Record<string, string>
        )[c],
    );
  }

  // --- Delete a latent -----------------------------------------------------
  // The dialog lives in the page's static markup, so its listeners bind ONCE
  // (`deleteWired`) while the header button — which innerHTML rebuilds on every
  // render — is re-bound each time. `deleteCtx` is what the two halves share.
  let deleteCtx: { id: string; name: string } | null = null;
  let deleteWired = false;

  function deleteLedger(p: any): string {
    const n = (c: number, one: string, many = one + 's') =>
      `${c} ${c === 1 ? one : many}`;
    // Only slots and documents come back with the project; playlists,
    // slideshows, links and the repo are fetched by their own islands. So the
    // counted part is conditional and the rest is named as categories — a
    // ledger that opened with "0 slots · 0 documents" on an empty latent would
    // read like a bug and teach the admin to skim past it.
    const counted = [
      p.slots?.length ? n(p.slots.length, 'slot') : '',
      p.documents?.length
        ? `${n(p.documents.length, 'document')} (and every revision)`
        : '',
    ].filter(Boolean);
    const rest =
      'its running orders, slideshows, pinned links and repo attachment';
    const goes = counted.length
      ? `${counted.join(' · ')} · plus ${rest}`
      : rest;
    const files = p.item_count || 0;
    const rows = [
      `<li><b>Goes</b><span>${escapeHtml(goes)}</span></li>`,
      `<li><b>Stays</b><span>${
        files
          ? `all ${n(files, 'file')}, in Emulsion and in the search index`
          : 'nothing is removed from Emulsion or the search index'
      }</span></li>`,
    ];
    if (p.thread_count) {
      rows.push(
        `<li><b>Stays</b><span>${n(p.thread_count, 'discussion')} — they live on the fold, not here</span></li>`,
      );
    }
    return rows.join('');
  }

  function wireDelete(id: string, p: any) {
    deleteCtx = { id, name: p.name || '' };

    const dialog = document.getElementById(
      'delete-dialog',
    ) as HTMLDialogElement | null;
    const openBtn = document.getElementById(
      'delete-latent',
    ) as HTMLButtonElement | null;
    if (!dialog || !openBtn) return;

    const nameEl = document.getElementById('delete-name')!;
    const ledgerEl = document.getElementById('delete-ledger')!;
    const input = document.getElementById('delete-confirm') as HTMLInputElement;
    const errorEl = document.getElementById('delete-error') as HTMLElement;
    const confirmBtn = document.getElementById(
      'delete-confirm-btn',
    ) as HTMLButtonElement;
    const cancelBtn = document.getElementById(
      'delete-cancel',
    ) as HTMLButtonElement;

    openBtn.addEventListener('click', () => {
      nameEl.textContent = deleteCtx?.name || '';
      ledgerEl.innerHTML = deleteLedger(p);
      input.value = '';
      confirmBtn.disabled = true;
      errorEl.hidden = true;
      // showModal() throws on an already-open dialog (eg. a double-click),
      // and the exception would abort the rest of this handler silently.
      if (dialog.open) return;
      dialog.showModal();
      input.focus();
    });

    if (deleteWired) return;
    deleteWired = true;

    // Trimmed and case-insensitive on purpose. The gate is there to make you
    // stop and read, not to test your typing — names like
    // "2019 SF [TUBE,BDO,DWF]" are punishing enough once.
    const matches = () =>
      input.value.trim().toLowerCase() ===
      (deleteCtx?.name || '').trim().toLowerCase();
    input.addEventListener('input', () => {
      confirmBtn.disabled = !matches();
    });

    cancelBtn.addEventListener('click', () => dialog.close());

    confirmBtn.addEventListener('click', async () => {
      if (!deleteCtx || !matches()) return;
      confirmBtn.disabled = true;
      errorEl.hidden = true;
      try {
        const res = await fetch(
          `/api/projects/${encodeURIComponent(deleteCtx.id)}`,
          { method: 'DELETE', credentials: 'include' },
        );
        if (!res.ok) throw new Error(`Failed (HTTP ${res.status})`);
        window.location.href = '/admin/latents';
      } catch (e: any) {
        // Stay open. Closing would drop the admin back onto a detail page
        // that may or may not still describe a latent that exists.
        errorEl.textContent = e?.message || 'Could not delete the latent.';
        errorEl.hidden = false;
        confirmBtn.disabled = !matches();
      }
    });
  }

  async function resolveProjectId(
    headerEl: HTMLElement,
  ): Promise<string | null> {
    const params = new URLSearchParams(window.location.search);
    let id = params.get('id');
    if (id) return id;
    // Pretty URL form: /admin/latents/<slug> (or /admin/latents/<slug>/)
    const m = window.location.pathname.match(/^\/admin\/latents\/([^/]+)\/?$/);
    if (!m || m[1] === 'detail' || m[1] === 'new') return null;
    const slug = m[1];
    try {
      const r = await fetch(
        `/api/projects/by-slug/${encodeURIComponent(slug)}`,
        { credentials: 'include' },
      );
      if (!r.ok) {
        headerEl.innerHTML = `<p style="color: var(--color-status-fail);">No latent with slug <code>${slug}</code>.</p>`;
        return null;
      }
      const j = await r.json();
      return j.id;
    } catch {
      headerEl.innerHTML =
        '<p style="color: var(--color-status-fail);">Network error resolving slug.</p>';
      return null;
    }
  }

  async function init() {
    if (initialized) return;
    const headerEl = document.getElementById('header');
    const islandsEl = document.getElementById('islands');
    if (!headerEl || !islandsEl) return;

    const user = await (window as any).__authReady;
    if (!user) return;
    if (initialized) return;

    const id = await resolveProjectId(headerEl);
    if (!id) return;
    initialized = true;

    let res: Response;
    try {
      res = await fetch(`/api/projects/${encodeURIComponent(id)}`, {
        credentials: 'include',
      });
    } catch (e) {
      headerEl.innerHTML =
        '<p style="color: var(--color-status-fail);">Network error loading Latent.</p>';
      return;
    }
    if (!res.ok) {
      headerEl.innerHTML = `<p style="color: var(--color-status-fail);">Not found (HTTP ${res.status}).</p>`;
      return;
    }
    const p = await res.json();

    // If we resolved by id (query-string entry) and the project has a slug,
    // upgrade the URL to the pretty form so bookmarks + share links work.
    if (p.slug && window.location.pathname !== `/admin/latents/${p.slug}`) {
      try {
        history.replaceState(history.state, '', `/admin/latents/${p.slug}`);
      } catch {}
    }

    const metadataRows = Object.entries(p.metadata || {})
      .map(
        ([k, v]) =>
          `<div class="meta-row">
            <input class="meta-key" type="text" value="${escapeHtml(k)}" />
            <input class="meta-val" type="text" value="${escapeHtml(String(v ?? ''))}" />
            <button class="meta-del" type="button" title="Remove">×</button>
          </div>`,
      )
      .join('');

    headerEl.innerHTML = `
      <div class="header-title-row">
        <input class="name-input" id="name-input" type="text" value="${escapeHtml(p.name)}" />
      </div>
      <div class="header-controls-row">
        <input class="slug-input" id="slug-input" type="text" value="${escapeHtml(p.slug || '')}" title="URL slug" />
        <select class="kind-select" id="kind-select">
          ${['album', 'video', 'zine', 'session', 'other']
            .map(
              (k) =>
                `<option value="${k}" ${k === p.kind ? 'selected' : ''}>${k}</option>`,
            )
            .join('')}
        </select>
        <div class="status-row" id="status-row">
          ${['forming', 'developing', 'fixing', 'abandoned']
            .map((s) => {
              const c = statusColor(s);
              return `<button class="status-btn ${s === p.status ? 'active' : ''}" data-status="${s}" style="--c:${c}">${s}</button>`;
            })
            .join('')}
        </div>
        <a class="action-btn" href="/admin/latents">All latents</a>
      </div>
      <p class="summary"><span>${escapeHtml(p.kind)} latent · ${p.item_count} files · ${p.documents.length} document${p.documents.length === 1 ? '' : 's'} · ${p.slots.length} slot${p.slots.length === 1 ? '' : 's'}${p.thread_count ? ' · ' + p.thread_count + ' thread' + (p.thread_count === 1 ? '' : 's') : ''}</span><button class="action-btn action-btn--danger latent-danger" id="delete-latent" type="button">Delete latent</button></p>

      <div id="hero-island"></div>

      <textarea
        class="desc-input"
        id="desc-input"
        rows="5"
        placeholder="Description / synopsis (markdown). Autosaves. Grows as you type."
      >${escapeHtml(p.description || '')}</textarea>

      <details class="meta-details" id="meta-details" ${Object.keys(p.metadata || {}).length ? 'open' : ''}>
        <summary>Metadata <span class="muted">(${Object.keys(p.metadata || {}).length})</span></summary>
        <div class="meta-list" id="meta-list">${metadataRows}</div>
        <div class="meta-actions">
          <button class="action-btn" id="meta-add" type="button">+ Add field</button>
          <span class="meta-saved" id="meta-saved"></span>
        </div>
      </details>
    `;

    const nameInput = document.getElementById('name-input') as HTMLInputElement;
    const kindSelect = document.getElementById(
      'kind-select',
    ) as HTMLSelectElement;
    const statusRow = document.getElementById('status-row')!;

    let nameTimer: any = null;
    nameInput.addEventListener('input', () => {
      if (nameTimer) clearTimeout(nameTimer);
      nameTimer = setTimeout(() => {
        fetch(`/api/projects/${encodeURIComponent(id)}`, {
          method: 'PATCH',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: nameInput.value }),
        });
      }, 1200);
    });
    kindSelect.addEventListener('change', () => {
      fetch(`/api/projects/${encodeURIComponent(id)}`, {
        method: 'PATCH',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kind: kindSelect.value }),
      });
    });
    statusRow
      .querySelectorAll<HTMLButtonElement>('[data-status]')
      .forEach((btn) => {
        btn.addEventListener('click', async () => {
          const s = btn.dataset.status!;
          await fetch(`/api/projects/${encodeURIComponent(id)}`, {
            method: 'PATCH',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: s }),
          });
          statusRow
            .querySelectorAll<HTMLButtonElement>('[data-status]')
            .forEach((b) => {
              b.classList.toggle('active', b.dataset.status === s);
            });
        });
      });

    wireDelete(id, p);

    // Slug change — autosave + replaceState to keep the URL pretty
    const slugInput = document.getElementById('slug-input') as HTMLInputElement;
    let slugTimer: any = null;
    slugInput.addEventListener('input', () => {
      if (slugTimer) clearTimeout(slugTimer);
      slugTimer = setTimeout(async () => {
        const trimmed = slugInput.value.trim();
        if (!trimmed || trimmed === p.slug) return;
        const r = await fetch(`/api/projects/${encodeURIComponent(id)}`, {
          method: 'PATCH',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: trimmed }),
        });
        if (r.ok) {
          const updated = await r.json();
          p.slug = updated.slug;
          slugInput.value = updated.slug;
          try {
            history.replaceState(
              history.state,
              '',
              `/admin/latents/${updated.slug}`,
            );
          } catch {}
        } else {
          const err = await r.json().catch(() => ({}));
          alert(err?.detail || 'Slug change failed');
          slugInput.value = p.slug || '';
        }
      }, 1200);
    });

    // Description — autosave + autosize. The textarea grows with the
    // content (capped via max-height in CSS), so long synopses don't get
    // crammed into a 3-line slot.
    const descInput = document.getElementById(
      'desc-input',
    ) as HTMLTextAreaElement;
    const descSaved = document.createElement('span');
    descSaved.className = 'desc-saved';
    descInput.insertAdjacentElement('afterend', descSaved);
    function autosizeDesc() {
      descInput.style.height = 'auto';
      descInput.style.height = descInput.scrollHeight + 'px';
    }
    // Initial sizing — wait for the element to be laid out so scrollHeight
    // is meaningful.
    requestAnimationFrame(autosizeDesc);
    let descTimer: any = null;
    descInput.addEventListener('input', () => {
      autosizeDesc();
      descSaved.textContent = 'unsaved';
      if (descTimer) clearTimeout(descTimer);
      descTimer = setTimeout(async () => {
        descSaved.textContent = 'saving…';
        const r = await fetch(`/api/projects/${encodeURIComponent(id)}`, {
          method: 'PATCH',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ description: descInput.value }),
        });
        descSaved.textContent = r.ok ? 'saved' : 'save failed';
      }, 1500);
    });

    // Metadata key/value editor
    const metaList = document.getElementById('meta-list')!;
    const metaSaved = document.getElementById('meta-saved') as HTMLSpanElement;
    let metaSaveTimer: any = null;

    function collectMetadata(): Record<string, string> {
      const out: Record<string, string> = {};
      metaList.querySelectorAll<HTMLDivElement>('.meta-row').forEach((row) => {
        const k = (
          row.querySelector('.meta-key') as HTMLInputElement
        ).value.trim();
        const v = (row.querySelector('.meta-val') as HTMLInputElement).value;
        if (k) out[k] = v;
      });
      return out;
    }

    function scheduleMetadataSave() {
      metaSaved.textContent = 'unsaved';
      if (metaSaveTimer) clearTimeout(metaSaveTimer);
      metaSaveTimer = setTimeout(async () => {
        metaSaved.textContent = 'saving…';
        const r = await fetch(`/api/projects/${encodeURIComponent(id)}`, {
          method: 'PATCH',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ metadata: collectMetadata() }),
        });
        metaSaved.textContent = r.ok ? 'saved' : 'save failed';
      }, 1200);
    }

    function makeRow(key = '', value = ''): HTMLDivElement {
      const row = document.createElement('div');
      row.className = 'meta-row';
      row.innerHTML = `
        <input class="meta-key" type="text" value="${escapeHtml(key)}" placeholder="key" />
        <input class="meta-val" type="text" value="${escapeHtml(value)}" placeholder="value" />
        <button class="meta-del" type="button" title="Remove">×</button>
      `;
      row
        .querySelectorAll('input')
        .forEach((i) => i.addEventListener('input', scheduleMetadataSave));
      row.querySelector('.meta-del')!.addEventListener('click', () => {
        row.remove();
        scheduleMetadataSave();
      });
      return row;
    }
    // Wire any pre-rendered rows
    metaList.querySelectorAll<HTMLDivElement>('.meta-row').forEach((row) => {
      row
        .querySelectorAll('input')
        .forEach((i) => i.addEventListener('input', scheduleMetadataSave));
      row.querySelector('.meta-del')!.addEventListener('click', () => {
        row.remove();
        scheduleMetadataSave();
      });
    });
    document.getElementById('meta-add')!.addEventListener('click', () => {
      metaList.appendChild(makeRow());
      (
        metaList.lastElementChild!.querySelector(
          '.meta-key',
        ) as HTMLInputElement
      ).focus();
    });

    for (const m of mounted) {
      try {
        unmount(m);
      } catch {}
    }
    mounted = [];

    // Hero accent carry — the accent is server-validated #rrggbb, and the
    // LatentHero island keeps it fresh as the hero/override changes.
    const applyAccent = (accent: string | null) => {
      if (accent) {
        headerEl.style.setProperty('--latent-accent', accent);
        headerEl.classList.add('latent-header--accent');
      } else {
        headerEl.style.removeProperty('--latent-accent');
        headerEl.classList.remove('latent-header--accent');
      }
    };
    applyAccent(p.hero_accent || null);

    // Fixed-section face carry (2026-07-18-latent-faces). Palette defaults
    // come from CSS; per-latent overrides land here as inline custom
    // properties + full-strength face layers. Every hex is re-validated
    // before touching a style attribute — the server regex plus this check
    // is the whole injection defense.
    const FACE_CLASSES = [
      'latent-section--faced',
      'latent-section--face-scrim',
      'latent-section--face-plate',
      'latent-section--face-treat',
      'latent-section--face-solid',
    ];
    let lastSectionStyles: Record<string, Record<string, string>> | null =
      p.section_styles || null;
    const applySectionStyles = (
      styles: Record<string, Record<string, string>> | null | undefined,
    ) => {
      lastSectionStyles = styles || null;
      for (const key of SECTION_KEYS) {
        const el = islandsEl.querySelector<HTMLElement>(
          `.latent-section[data-section="${key}"]`,
        );
        if (!el) continue;
        const st = (styles || {})[key] || {};
        const varMap: Record<string, string | null> = {
          '--sec-accent': effectiveAccent(st),
          // Redefining the border TOKEN recolors every line inside the
          // section — and cascades into slot cards until a card sets its
          // own. Intended: the section's linework is one pick.
          '--color-border': safeHex(st.border),
          '--sec-text': safeHex(st.text),
        };
        for (const [cssVar, val] of Object.entries(varMap)) {
          if (val) el.style.setProperty(cssVar, val);
          else el.style.removeProperty(cssVar);
        }
        // Face layers. Sections have no `auto` mode; default is none.
        el.querySelectorAll(':scope > .sec-bg, :scope > .sec-veil').forEach(
          (n) => n.remove(),
        );
        el.classList.remove(...FACE_CLASSES);
        el.style.removeProperty('--sec-bg-color');
        el.style.removeProperty('--sec-face-text');
        const bgColor = safeHex(st.bg_color);
        const treatment = ['scrim', 'plate', 'treat'].includes(st.bg_style)
          ? st.bg_style
          : 'scrim';
        if (st.bg_mode === 'solid' && bgColor) {
          el.style.setProperty('--sec-bg-color', bgColor);
          el.style.setProperty(
            '--sec-face-text',
            safeHex(st.text) || autoTextColor(bgColor, currentTheme()),
          );
          el.classList.add(
            'latent-section--faced',
            'latent-section--face-solid',
          );
        } else if (st.bg_mode === 'image' && st.bg_media_item_id) {
          const img = document.createElement('img');
          img.className = 'sec-bg';
          img.alt = '';
          img.loading = 'lazy';
          img.src = thumbUrl(st.bg_media_item_id, 'md');
          img.onerror = () => {
            veil.remove();
            img.remove();
            el.classList.remove(...FACE_CLASSES);
          };
          const veil = document.createElement('div');
          veil.className = 'sec-veil';
          el.prepend(img, veil);
          el.classList.add(
            'latent-section--faced',
            `latent-section--face-${treatment}`,
          );
        }
      }
    };
    applySectionStyles(p.section_styles);
    // Solid-face text is computed for the active theme — recompute when the
    // viewer toggles it.
    stopThemeWatch = watchTheme(() => applySectionStyles(lastSectionStyles));

    // Header hero backdrop (phase 3b). Rebuilt whenever the hero changes —
    // LatentHero and the loose-files quick action both broadcast
    // `latent-hero-changed` with the fresh summary.
    const applyHeaderBackdrop = (mediaId: string | null) => {
      headerEl
        .querySelectorAll(
          ':scope > .header-backdrop, :scope > .header-backdrop-veil',
        )
        .forEach((n) => n.remove());
      headerEl.classList.toggle('latent-header--backdrop', !!mediaId);
      if (!mediaId) return;
      const img = document.createElement('img');
      img.className = 'header-backdrop';
      img.alt = '';
      img.loading = 'lazy';
      img.src = thumbUrl(mediaId, 'md');
      img.onerror = () => {
        veil.remove();
        img.remove();
        headerEl.classList.remove('latent-header--backdrop');
      };
      const veil = document.createElement('div');
      veil.className = 'header-backdrop-veil';
      headerEl.prepend(img, veil);
    };
    applyHeaderBackdrop(p.hero_media_item_id || null);
    heroListener = (e: Event) => {
      const s = (e as CustomEvent).detail;
      if (s?.id === id) applyHeaderBackdrop(s.hero_media_item_id || null);
    };
    window.addEventListener('latent-hero-changed', heroListener);

    // Section map — between header and sections; chips live-update via
    // latent-style-changed + latent-slots-updated.
    mounted.push(
      mount(LatentSectionMap, {
        target: document.getElementById('map-island')!,
        props: {
          projectId: id,
          sectionStyles: p.section_styles || {},
          initialSlots: (p.slots || []).map((s: any) => ({
            id: s.id,
            label: s.label,
            position: s.position,
            accent: s.accent || null,
          })),
        },
      }),
    );

    // Live sync: the Style panel (and any future control) broadcasts
    // `latent-style-changed` with {projectId, scope, summary} — scope
    // 'section' carries a fresh project summary.
    styleListener = (e: Event) => {
      const d = (e as CustomEvent).detail;
      if (!d || d.projectId !== id) return;
      if (d.scope === 'section' && d.summary?.section_styles !== undefined) {
        applySectionStyles(d.summary.section_styles);
      }
    };
    window.addEventListener('latent-style-changed', styleListener);

    mounted.push(
      mount(LatentHero, {
        target: document.getElementById('hero-island')!,
        props: {
          projectId: id,
          heroMediaItemId: p.hero_media_item_id,
          heroStyle: p.hero_style,
          heroAccentAuto: p.hero_accent_auto,
          heroAccentOverride: p.hero_accent_override,
          onAccentChange: applyAccent,
        },
      }),
    );

    islandsEl.hidden = false;
    mounted.push(
      mount(LatentRepoStrip, {
        target: document.getElementById('repo-island')!,
        props: { projectId: id, styleKey: 'repo' },
      }),
    );
    mounted.push(
      mount(LatentLinks, {
        target: document.getElementById('links-island')!,
        props: { projectId: id, title: 'Links', styleKey: 'links' },
      }),
    );
    mounted.push(
      mount(LatentDocuments, {
        target: document.getElementById('docs-island')!,
        props: { projectId: id, styleKey: 'docs' },
      }),
    );
    mounted.push(
      mount(LatentSlots, {
        target: document.getElementById('slots-island')!,
        props: { projectId: id, projectKind: p.kind, styleKey: 'slots' },
      }),
    );
    mounted.push(
      mount(LatentPlaylists, {
        target: document.getElementById('playlists-island')!,
        props: { projectId: id, styleKey: 'playlists' },
      }),
    );
    mounted.push(
      mount(LatentSlideshows, {
        target: document.getElementById('slideshow-island')!,
        props: { projectId: id, styleKey: 'slideshow' },
      }),
    );
    mounted.push(
      mount(LatentLooseFiles, {
        target: document.getElementById('loose-island')!,
        props: { projectId: id, styleKey: 'loose' },
      }),
    );
    mounted.push(
      mount(Threads, {
        target: document.getElementById('threads-island')!,
        props: {
          anchorType: 'project',
          anchorId: id,
          title: 'Latent threads',
          styleKey: 'threads',
        },
      }),
    );
    mounted.push(
      mount(MarginaliaRecent, {
        target: document.getElementById('marginalia-island')!,
        props: { projectId: id },
      }),
    );
    // Single style-settings host for every Style button on the page.
    // Mounted OUTSIDE the .latent-section wrappers — their isolation:
    // isolate stacking contexts would trap the fixed panel underneath
    // later sections.
    mounted.push(
      mount(LatentStylePanel, {
        target: document.getElementById('style-panel-island')!,
        props: { projectId: id },
      }),
    );
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    for (const m of mounted) {
      try {
        unmount(m);
      } catch {}
    }
    mounted = [];
    if (styleListener) {
      window.removeEventListener('latent-style-changed', styleListener);
      styleListener = null;
    }
    if (heroListener) {
      window.removeEventListener('latent-hero-changed', heroListener);
      heroListener = null;
    }
    if (stopThemeWatch) {
      stopThemeWatch();
      stopThemeWatch = null;
    }
    // The delete dialog is static markup, so a swap replaces the element the
    // once-only listeners were bound to. Without this the next page's dialog
    // opens with a DELETE button that can never enable.
    deleteWired = false;
    deleteCtx = null;
    initialized = false;
  });
  init();
</script>
