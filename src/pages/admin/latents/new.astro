---
import Admin from '../../../layouts/Admin.astro';
---

<Admin title="New Latent" current="latents">
  <div class="page-header">
    <h1>New Latent</h1>
    <div class="header-actions">
      <a class="action-btn" href="/admin/latents">All latents</a>
    </div>
  </div>
  <p class="page-subtitle">
    Fresh pre-release workspace. Files, slots, threads and documents land on the
    next screen.
  </p>

  <form id="new-form" class="form">
    <label class="field">
      <span class="field__label">Name</span>
      <input
        type="text"
        name="name"
        required
        maxlength="200"
        placeholder="e.g. regular expression"
        autocomplete="off"
      />
    </label>
    <label class="field">
      <span class="field__label">Kind</span>
      <div class="kind-row" id="kind-row">
        <button type="button" class="kind-pill active" data-kind="album"
          >album</button
        >
        <button type="button" class="kind-pill" data-kind="video">video</button>
        <button type="button" class="kind-pill" data-kind="zine">zine</button>
        <button type="button" class="kind-pill" data-kind="session"
          >session</button
        >
        <button type="button" class="kind-pill" data-kind="other">other</button>
      </div>
      <input type="hidden" name="kind" id="kind-hidden" value="album" />
    </label>
    <div class="actions">
      <button type="submit" class="btn-primary" id="submit-btn">Create</button>
      <a class="action-btn" href="/admin/latents">Cancel</a>
    </div>
    <p id="error" class="error" hidden></p>
  </form>
</Admin>

<style>
  .page-subtitle {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-xs);
    max-width: 60ch;
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 560px;
    margin-top: var(--space-md);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field__label {
    color: var(--color-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1pt;
  }
  .field input[type='text'] {
    background: var(--color-bg);
    color: var(--color-text);
    border: 2px solid var(--color-border);
    padding: 8px 12px;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    box-shadow: 2px 2px 0 var(--color-text);
  }
  .field input[type='text']:focus {
    border-color: var(--color-text);
    outline: 0;
  }
  .kind-row {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .kind-pill {
    padding: 4px 12px;
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: lowercase;
  }
  .kind-pill:hover {
    border-color: var(--color-text);
  }
  .kind-pill.active {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }
  .actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .error {
    color: var(--color-status-fail);
    margin: 0;
    font-size: var(--text-sm);
    border: 1px solid var(--color-status-fail);
    padding: 6px 10px;
  }
</style>

<script>
  let bound = false;
  function init() {
    if (bound) return;
    const form = document.getElementById('new-form') as HTMLFormElement | null;
    const err = document.getElementById('error') as HTMLParagraphElement | null;
    if (!form || !err) return;
    bound = true;

    const kindRow = document.getElementById('kind-row')!;
    const kindHidden = document.getElementById(
      'kind-hidden',
    ) as HTMLInputElement;
    kindRow.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest(
        'button[data-kind]',
      ) as HTMLButtonElement | null;
      if (!t) return;
      kindRow
        .querySelectorAll('.kind-pill')
        .forEach((b) => b.classList.remove('active'));
      t.classList.add('active');
      kindHidden.value = t.dataset.kind || 'other';
    });

    const submitBtn = document.getElementById(
      'submit-btn',
    ) as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creating…';
      const fd = new FormData(form);
      const payload = {
        name: String(fd.get('name') || ''),
        kind: String(fd.get('kind') || 'other'),
      };
      try {
        const res = await fetch('/api/projects', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          err.textContent = body?.detail || `Failed (${res.status})`;
          err.hidden = false;
          submitBtn.disabled = false;
          submitBtn.textContent = 'Create';
          return;
        }
        const body = await res.json();
        const target = body.slug
          ? `/admin/latents/${encodeURIComponent(body.slug)}`
          : `/admin/latents/detail?id=${encodeURIComponent(body.id)}`;
        window.location.href = target;
      } catch (e: any) {
        err.textContent = e?.message || 'Network error';
        err.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create';
      }
    });
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:after-swap', () => {
    bound = false;
  });
  init();
</script>
