---
/*
 * BrutalCard — the canonical card primitive for admin pages.
 * Wraps a section in `.brutal-card` chrome (2px border, 4px hard shadow)
 * with an optional header bar (.brutal-card__head) and a body slot.
 *
 * Slots:
 *   - default — body content
 *   - action  — single button or link rendered on the right of the header
 *   - meta    — small uppercase muted text in the header (e.g. counts)
 *
 * Props:
 *   - title       — required when the header is shown
 *   - level       — h-tag level for the title (2 by default; use 3 inside sections)
 *   - hideHead    — render only the body (when the card carries a different chrome)
 *   - inverted    — paint the header bar fg-on-bg-inverted (selection states)
 *   - flush       — body has no padding (the slot owns spacing)
 *   - collapsible — the head becomes a toggle: renders <details>/<summary> instead
 *                   of divs, so the section opens and closes with no JS and is
 *                   operable from the keyboard for free. For long reference pages
 *                   where a reader wants one section, not a wall of them.
 *   - open        — a collapsible card starts open (default: closed)
 *   - id          — passed to the wrapper
 *   - class       — extra class names appended to the wrapper
 *
 * `collapsible` deliberately reuses this card's own chrome rather than the
 * `.disclosure` primitive in admin.css: that one is a small muted reveal for file
 * chrome, sized and coloured for a footnote. A page section needs its heading to
 * still read as a heading when closed.
 */
interface Props {
  title?: string;
  level?: 2 | 3;
  hideHead?: boolean;
  inverted?: boolean;
  flush?: boolean;
  collapsible?: boolean;
  open?: boolean;
  id?: string;
  class?: string;
}
const {
  title,
  level = 2,
  hideHead = false,
  inverted = false,
  flush = false,
  collapsible = false,
  open = false,
  id,
  class: className,
} = Astro.props;
const HeadingTag = `h${level}` as 'h2' | 'h3';
const wrapperClass = [
  'brutal-card',
  collapsible ? 'brutal-card--collapsible' : null,
  className,
].filter(Boolean).join(' ');
const headClass = [
  'brutal-card__head',
  inverted ? 'brutal-card__head--inverted' : null,
]
  .filter(Boolean)
  .join(' ');
const bodyClass = [
  'brutal-card__body',
  flush ? 'brutal-card__body--flush' : null,
]
  .filter(Boolean)
  .join(' ');
const hasMeta = Astro.slots.has('meta');
const hasAction = Astro.slots.has('action');
---

{
  collapsible ? (
    <details class={wrapperClass} id={id} open={open}>
      <summary class={headClass}>
        {title && <HeadingTag>{title}</HeadingTag>}
        {hasMeta && (
          <span class="brutal-card__head-meta">
            <slot name="meta" />
          </span>
        )}
        {hasAction && <slot name="action" />}
      </summary>
      <div class={bodyClass}>
        <slot />
      </div>
    </details>
  ) : (
    <div class={wrapperClass} id={id}>
      {!hideHead && (title || hasMeta || hasAction) && (
        <div class={headClass}>
          {title && <HeadingTag>{title}</HeadingTag>}
          {hasMeta && (
            <span class="brutal-card__head-meta">
              <slot name="meta" />
            </span>
          )}
          {hasAction && <slot name="action" />}
        </div>
      )}
      <div class={bodyClass}>
        <slot />
      </div>
    </div>
  )
}
