---
import { ViewTransitions } from 'astro:transitions';
import Player from '../components/Player.svelte';

interface Props {
  title: string;
  current?: string;
}
const { title, current } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <title>{title} — A-U.SUPPLY Admin</title>
    <ViewTransitions />
    <script is:inline>
      // Resolve theme pre-paint so there's no flash. localStorage.adminTheme
      // is "light" | "dark" | "auto"; auto follows prefers-color-scheme.
      (function () {
        try {
          var pref = localStorage.getItem('adminTheme') || 'auto';
          var dark =
            pref === 'dark' ||
            (pref === 'auto' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          var root = document.documentElement;
          root.setAttribute('data-theme', dark ? 'dark' : 'light');
          root.setAttribute('data-theme-pref', pref);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <button
      class="sidebar__toggle"
      id="sidebar-toggle"
      aria-label="Toggle menu"
      aria-controls="sidebar"
      aria-expanded="false">|||</button
    >
    <div class="sidebar__backdrop" id="sidebar-backdrop"></div>

    <div class="admin-shell">
      <aside class="sidebar" id="sidebar">
        <div class="sidebar__brand">
          <a href="/">A-U.SUPPLY</a>
        </div>

        <div class="sidebar__section">
          Overture<span class="sidebar__section-hint"
            >dashboard + bookmarks</span
          >
        </div>
        <ul class="sidebar__nav">
          <li>
            <a
              href="/admin/dashboard"
              aria-current={current === 'dashboard' ? 'page' : undefined}
              >Auspices</a
            >
          </li>
          <li>
            <a
              href="/admin/bookmarks"
              aria-current={current === 'bookmarks' ? 'page' : undefined}
              >Dog-ears</a
            >
          </li>
          <li>
            <a
              href="/admin/notifications"
              aria-current={current === 'notifications' ? 'page' : undefined}
              class="sidebar__nav-with-badge"
              ><span>Inbox</span><span
                class="sidebar__badge"
                id="inbox-badge"
                data-count="0"
                hidden>0</span
              ></a
            >
          </li>
          <li>
            <a
              href="https://fold.a-u.supply/"
              target="_blank"
              rel="noopener noreferrer"
              class="sidebar__nav-external"
              ><span>The Fold</span><span
                class="sidebar__ext-glyph"
                aria-hidden="true">&#x2197;</span
              ></a
            >
          </li>
        </ul>

        <div class="sidebar__section">
          The Canon<span class="sidebar__section-hint">releases catalog</span>
        </div>
        <ul class="sidebar__nav">
          <li>
            <a
              href="/admin/catalog"
              aria-current={current === 'catalog' ? 'page' : undefined}
              >Releases</a
            >
          </li>
          <li>
            <a
              href="/admin/catalog/new"
              aria-current={current === 'catalog-new' ? 'page' : undefined}
              >New Release</a
            >
          </li>
        </ul>

        <div class="sidebar__section">
          The Larder<span class="sidebar__section-hint">media library</span>
        </div>
        <ul class="sidebar__nav">
          <li>
            <a
              href="/admin/search"
              aria-current={current === 'search' ? 'page' : undefined}
              >The Stacks</a
            >
          </li>
          <li>
            <a
              href="/admin/search/upload"
              aria-current={current === 'upload' ? 'page' : undefined}
              >Tribute</a
            >
          </li>
          <li>
            <a
              href="/admin/search/nomenclator"
              aria-current={current === 'nomenclator' ? 'page' : undefined}
              >Nomenclator</a
            >
          </li>
        </ul>

        <div class="sidebar__section">
          The Winnowing<span class="sidebar__section-hint"
            >rejected + flagged media</span
          >
        </div>
        <ul class="sidebar__nav">
          <li>
            <a
              href="/admin/search/failures"
              aria-current={current === 'failures' ? 'page' : undefined}
              >The Fallen</a
            >
          </li>
          <li>
            <a
              href="/admin/search/slop"
              aria-current={current === 'slop' ? 'page' : undefined}
              >Slop Bucket</a
            >
          </li>
          <li>
            <a
              href="/admin/search/midden"
              aria-current={current === 'midden' ? 'page' : undefined}
              >The Midden</a
            >
          </li>
        </ul>

        <div class="sidebar__section">
          The Altar<span class="sidebar__section-hint"
            >workspace, jobs, bulk ops</span
          >
        </div>
        <ul class="sidebar__nav">
          <li>
            <a
              href="/admin/search/workspace"
              aria-current={current === 'workspace' ? 'page' : undefined}
              >Workspace</a
            >
          </li>
          <li>
            <a
              href="/admin/hecatomb"
              aria-current={current === 'hecatomb' ? 'page' : undefined}
              >Hecatomb</a
            >
          </li>
          <li>
            <a
              href="/admin/jobs"
              aria-current={current === 'jobs' ? 'page' : undefined}
              >The Queue</a
            >
          </li>
        </ul>

        <div class="sidebar__section">
          The Darkroom<span class="sidebar__section-hint"
            >pre-release workspace</span
          >
        </div>
        <ul class="sidebar__nav">
          <li>
            <a
              href="/admin/latents"
              aria-current={current === 'latents' ? 'page' : undefined}
              >Latents</a
            >
          </li>
        </ul>

        <div class="sidebar__section">
          The Atelier<span class="sidebar__section-hint"
            >browser-side creative tools</span
          >
        </div>
        <ul class="sidebar__nav">
          <li>
            <a
              href="/admin/atelier/punctum"
              aria-current={current === 'punctum' ? 'page' : undefined}
              >Punctum</a
            >
          </li>
          <li>
            <a
              href="/admin/atelier/photism"
              aria-current={current === 'photism' ? 'page' : undefined}
              >Photism</a
            >
          </li>
          <li>
            <a
              href="/admin/atelier/litany"
              aria-current={current === 'litany' ? 'page' : undefined}>Litany</a
            >
          </li>
          <li>
            <a
              href="/admin/atelier/litany-exp"
              aria-current={current === 'litany-exp' ? 'page' : undefined}
              >Litany-exp</a
            >
          </li>
        </ul>

        <div class="sidebar__section">
          The Sacristy<span class="sidebar__section-hint">keys, settings</span>
        </div>
        <ul class="sidebar__nav">
          <li>
            <a
              href="/admin/api-keys"
              aria-current={current === 'api-keys' ? 'page' : undefined}>Keys</a
            >
          </li>
          <li>
            <a
              href="/admin/settings"
              aria-current={current === 'settings' ? 'page' : undefined}
              >Settings</a
            >
          </li>
        </ul>

        <div class="sidebar__footer">
          <div class="sidebar__user" id="sidebar-user"></div>
          <div class="theme-toggle" id="theme-toggle" aria-label="Theme">
            <button
              type="button"
              class="theme-toggle__btn"
              data-pref="light"
              title="Light">☀</button
            ><button
              type="button"
              class="theme-toggle__btn"
              data-pref="auto"
              title="System">◐</button
            ><button
              type="button"
              class="theme-toggle__btn"
              data-pref="dark"
              title="Dark">☾</button
            >
          </div>
          <button class="sidebar__logout" id="logout-btn">Log Out</button>
        </div>
      </aside>

      <main class="admin-main">
        <div class="page-loading" id="page-loading" style="display:none;">
          <span class="loading-dots">Loading</span>
        </div>
        <slot />
      </main>
    </div>
    <div class="player-slot" transition:persist="audio-player">
      <Player client:only="svelte" />
    </div>
    <div class="toast-container" id="toast-container"></div>

    <script is:inline>
      // Theme toggle — pure JS in <script is:inline> so it can't be broken by
      // any Astro/TS transform quirk. Pre-paint resolver in <head> handles
      // initial data-theme; this wires the buttons and re-applies on every
      // navigation. Persists state on window.__themeWired so the inline script
      // re-running on each ViewTransition doesn't stack listeners.
      (function () {
        if (window.__themeWired) {
          // Already wired in a previous page parse. Re-run wire() so the
          // buttons in the freshly-swapped body get their click handlers.
          window.__themeWired.wire();
          return;
        }
        function readPref() {
          var v = localStorage.getItem('adminTheme');
          return v === 'light' || v === 'dark' || v === 'auto' ? v : 'auto';
        }
        function applyTheme(pref) {
          var dark =
            pref === 'dark' ||
            (pref === 'auto' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          var root = document.documentElement;
          root.setAttribute('data-theme', dark ? 'dark' : 'light');
          root.setAttribute('data-theme-pref', pref);
          var btns = document.querySelectorAll('.theme-toggle__btn');
          for (var i = 0; i < btns.length; i++) {
            btns[i].setAttribute(
              'aria-pressed',
              btns[i].getAttribute('data-pref') === pref ? 'true' : 'false',
            );
          }
        }
        function wire() {
          applyTheme(readPref());
          // ViewTransitions swap the body, so the buttons we see now are
          // fresh DOM nodes with no listeners — attach directly. (The old
          // body's listeners go with the old body.)
          var btns = document.querySelectorAll('.theme-toggle__btn');
          for (var i = 0; i < btns.length; i++) {
            (function (el) {
              if (el.__themeClickWired) return;
              el.__themeClickWired = true;
              el.addEventListener('click', function () {
                var next = el.getAttribute('data-pref') || 'auto';
                localStorage.setItem('adminTheme', next);
                applyTheme(next);
              });
            })(btns[i]);
          }
        }
        window.__themeWired = { wire: wire, applyTheme: applyTheme };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', wire);
        } else {
          wire();
        }
        // After every Astro view transition: re-apply theme (defensive —
        // <html> attrs *should* persist, but if anything overwrites them we
        // restore them here) and re-wire the new body's buttons.
        document.addEventListener('astro:after-swap', function () {
          applyTheme(readPref());
        });
        document.addEventListener('astro:page-load', wire);
        // React to OS preference change in auto mode.
        window
          .matchMedia('(prefers-color-scheme: dark)')
          .addEventListener('change', function () {
            if (readPref() === 'auto') applyTheme('auto');
          });
      })();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/tailwind.css';
  @import '../styles/global.css';
  @import '../styles/admin.css';
</style>

<script>
  // Show loading indicator during ViewTransition navigations
  document.addEventListener('astro:before-preparation', () => {
    const loader = document.getElementById('page-loading');
    if (loader) loader.style.display = 'block';
  });

  // Page-specific body backgrounds: astro:after-swap covers ViewTransitions,
  // astro:page-load covers initial load and hard refresh
  function applyPageBackground() {
    if (window.location.pathname === '/admin/atelier/punctum') {
      document.body.style.background = '#221c00';
    } else if (window.location.pathname === '/admin/atelier/photism') {
      document.body.style.background = '#1a1200';
    } else if (window.location.pathname === '/admin/atelier/litany') {
      document.body.style.background = '#0a0e0f';
    } else if (window.location.pathname === '/admin/atelier/litany-exp') {
      document.body.style.background = '#0a0e0f';
    } else {
      document.body.style.removeProperty('background');
    }
  }
  document.addEventListener('astro:after-swap', applyPageBackground);
  document.addEventListener('astro:page-load', applyPageBackground);

  document.addEventListener('astro:page-load', () => {
    const loader = document.getElementById('page-loading');
    if (loader) loader.style.display = 'none';

    // Auth check — redirect to login if not authenticated
    // Expose as a promise on window so page scripts can await it
    // regardless of script loading order (no race condition)
    let resolveAuth: (user: any) => void;
    (window as any).__authReady = new Promise((r) => {
      resolveAuth = r;
    });

    async function checkAuth() {
      try {
        const res = await fetch('/api/me', { credentials: 'include' });
        if (!res.ok) {
          window.location.href = '/login';
          return;
        }
        const user = await res.json();
        const userEl = document.getElementById('sidebar-user');
        if (userEl) userEl.textContent = user.name;
        resolveAuth!(user);
      } catch {
        window.location.href = '/login';
      }
    }
    checkAuth();

    // Inbox badge — fetches unread count on each page load. The endpoint
    // also triggers source materialization, so any new fold/fallen/etc.
    // events get materialized as a side-effect of nav. Soft-fails on auth
    // race or network blip; checkAuth() already handles the hard logout.
    async function refreshInboxBadge() {
      const badge = document.getElementById('inbox-badge');
      if (!badge) return;
      try {
        const res = await fetch('/api/admin/notifications/count', {
          credentials: 'include',
        });
        if (!res.ok) return;
        const data = await res.json();
        const n = Math.max(0, Number(data.unread) || 0);
        badge.dataset.count = String(n);
        if (n === 0) {
          badge.setAttribute('hidden', '');
          badge.textContent = '0';
        } else {
          badge.removeAttribute('hidden');
          badge.textContent = n > 99 ? '99+' : String(n);
        }
      } catch {
        /* leave previous badge state alone */
      }
    }
    refreshInboxBadge();
    (window as any).__inbox = { refresh: refreshInboxBadge };

    // Bookmarks helper — shared across all admin pages
    const bmCache = new Map<string, Set<string>>();
    async function bmCheck(
      targetType: string,
      ids: string[],
    ): Promise<Set<string>> {
      if (ids.length === 0) return new Set();
      const cached = bmCache.get(targetType);
      if (cached) return cached;
      try {
        const res = await fetch('/api/bookmarks/check', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target_type: targetType, target_ids: ids }),
        });
        if (!res.ok) return new Set();
        const data = await res.json();
        const set = new Set<string>(data.bookmarked_ids);
        bmCache.set(targetType, set);
        return set;
      } catch {
        return new Set();
      }
    }
    async function bmToggle(
      targetType: string,
      targetId: string,
    ): Promise<boolean> {
      try {
        const res = await fetch('/api/bookmarks', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            target_type: targetType,
            target_id: targetId,
          }),
        });
        if (!res.ok) return false;
        const data = await res.json();
        const set = bmCache.get(targetType) || new Set<string>();
        if (data.bookmarked) set.add(targetId);
        else set.delete(targetId);
        bmCache.set(targetType, set);
        // Update all star elements on the page
        document
          .querySelectorAll(
            `[data-bm-type="${targetType}"][data-bm-id="${targetId}"]`,
          )
          .forEach((el) => {
            el.classList.toggle('bookmarked', data.bookmarked);
            el.setAttribute(
              'title',
              data.bookmarked ? 'Remove bookmark' : 'Bookmark',
            );
          });
        return data.bookmarked;
      } catch {
        return false;
      }
    }
    (window as any).__bookmarks = {
      check: bmCheck,
      toggle: bmToggle,
      cache: bmCache,
    };

    // Logout
    document
      .getElementById('logout-btn')
      ?.addEventListener('click', async () => {
        await fetch('/api/logout', { method: 'POST', credentials: 'include' });
        window.location.href = '/login';
      });

    // Mobile sidebar toggle
    const setSidebarOpen = (open: boolean) => {
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const toggle = document.getElementById('sidebar-toggle');
      sidebar?.classList.toggle('open', open);
      backdrop?.classList.toggle('open', open);
      toggle?.setAttribute('aria-expanded', String(open));
    };
    document.getElementById('sidebar-toggle')?.addEventListener('click', () => {
      const sidebar = document.getElementById('sidebar');
      setSidebarOpen(!sidebar?.classList.contains('open'));
    });

    // Close sidebar when tapping the backdrop
    document
      .getElementById('sidebar-backdrop')
      ?.addEventListener('click', () => setSidebarOpen(false));

    // Close sidebar after tapping a nav link (mobile)
    document
      .getElementById('sidebar')
      ?.querySelectorAll('.sidebar__nav a')
      .forEach((a) => {
        a.addEventListener('click', () => setSidebarOpen(false));
      });

    // Dialog dismiss: Escape key and click-outside
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const open = document.querySelector(
          '.dialog-overlay[style*="flex"]',
        ) as HTMLElement | null;
        if (open) {
          open.style.display = 'none';
          e.preventDefault();
        }
      }
    });
    document.addEventListener('click', (e) => {
      const overlay = (e.target as HTMLElement).closest('.dialog-overlay');
      if (overlay && e.target === overlay) {
        (overlay as HTMLElement).style.display = 'none';
      }
    });

    // Toast notification system
    const toastContainer = document.getElementById('toast-container')!;
    function showToast(
      message: string,
      type: 'success' | 'error' = 'success',
      duration = 4000,
    ) {
      const toast = document.createElement('div');
      toast.className = `toast toast--${type}`;
      toast.innerHTML = `<span>${message}</span><button class="toast__close">&times;</button>`;
      toast
        .querySelector('.toast__close')!
        .addEventListener('click', () => removeToast(toast));
      toastContainer.appendChild(toast);
      setTimeout(() => removeToast(toast), duration);
    }
    function removeToast(toast: HTMLElement) {
      if (toast.classList.contains('removing')) return;
      toast.classList.add('removing');
      toast.addEventListener('animationend', () => toast.remove());
    }
    (window as any).toast = {
      success: (msg: string, ms?: number) =>
        showToast(msg, 'success', ms ?? 4000),
      error: (msg: string, ms?: number) => showToast(msg, 'error', ms ?? 6000),
    };

    // Confirm dialog: returns a Promise<boolean>
    (window as any).confirmDialog = (
      message: string,
      dangerLabel = 'Confirm',
    ) => {
      return new Promise<boolean>((resolve) => {
        let overlay = document.getElementById('shared-confirm-dialog');
        if (!overlay) {
          overlay = document.createElement('div');
          overlay.id = 'shared-confirm-dialog';
          overlay.className = 'dialog-overlay';
          overlay.innerHTML = `<div class="dialog">
            <p id="confirm-message"></p>
            <div class="dialog-actions">
              <button class="btn-cancel" id="confirm-no">Cancel</button>
              <button class="btn-danger" id="confirm-yes"></button>
            </div>
          </div>`;
          document.body.appendChild(overlay);
        }
        document.getElementById('confirm-message')!.textContent = message;
        document.getElementById('confirm-yes')!.textContent = dangerLabel;
        overlay.style.display = 'flex';

        const cleanup = (result: boolean) => {
          overlay!.style.display = 'none';
          resolve(result);
        };
        document.getElementById('confirm-no')!.onclick = () => cleanup(false);
        document.getElementById('confirm-yes')!.onclick = () => cleanup(true);
      });
    };
  });
</script>
