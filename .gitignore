# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv/

# Node / Astro
# No trailing slash: `node_modules/` matches a DIRECTORY only, so a worktree's
# `node_modules` SYMLINK slipped past it and got committed on 2026-07-25 —
# pointing at the main checkout's own node_modules, which then replaced the
# real directory on checkout. tests/test_tracked_symlinks.py guards the class.
node_modules
.astro/

# Claude Code (settings.json is committed, personal config is not)
.claude/settings.local.json
.claude/worktrees/

# App data
# Bare `data`, same reasoning as `node_modules` above: a worktree needs a
# `data` SYMLINK into the main checkout, and every rule below is a path INSIDE
# the directory, so none of them match the link itself. Nothing under data/ is
# tracked, so ignoring the whole thing costs nothing and closes the hole that
# swept node_modules in. tests/test_tracked_symlinks.py is the backstop.
data
data/*.db
data/*.db-wal
data/*.db-shm
# Seeded media for local dev/audits (SEARCH_MEDIA_DIR). Only the *.db globs
# were listed here, so fixture images and audio sat untracked and one
# `git add -A` away from the repo — which has happened once already.
data/search-media/
data/media/
.env
